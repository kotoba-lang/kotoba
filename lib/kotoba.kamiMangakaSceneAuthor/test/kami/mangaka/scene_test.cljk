(ns kami.mangaka.scene-test
  (:require [kotoba.test :refer [deftest is testing]]
            [kotoba.lang.text :as str]
            #?(:clj [json.data-json :as json])
            [kami.mangaka.scene :as s]))

;; Two existing assertions changed with the 2026-08-18 `.clj` -> `.cljc`
;; conversion, and only these two. Both are JVM spellings of a portable
;; question, not behaviour:
;;
;;   - `Exception` is a Java class name. `ex-info` raises
;;     `clojure.lang.ExceptionInfo` on the JVM and `cljs.core/ExceptionInfo`
;;     under ClojureScript, whose parent is `js/Error`. The conditional is
;;     written INSIDE each `thrown?` because `thrown?` resolves its first
;;     argument as a class name at macroexpansion and will not take a var --
;;     measured: hoisting it to `(def error-type …)` fails to compile with
;;     "Unable to resolve classname". Same assertion, either way.
;;   - `json.data-json/read-str` has no ClojureScript build, so the
;;     round-trip parse goes through `js/JSON.parse` there. Same round trip.

(defn- parse-json [txt]
  #?(:clj  (json/read-str txt)
     :cljs (js->clj (js/JSON.parse txt))))

(deftest expression-of-test
  (is (= "Happy" (s/expression-of "joy")))
  (is (= "Happy" (s/expression-of "SMILE")))
  (is (= "Determined" (s/expression-of "resolve")))
  (is (= "Neutral" (s/expression-of "whatever"))))

(deftest transform-defaults
  (is (= {:translation [0.0 0.0 0.0] :rotation [0.0 0.0 0.0 1.0] :scale [1.0 1.0 1.0]}
         (s/transform)))
  (is (= [1.0 2.0 3.0] (:translation (s/transform [1 2 3])))))

(deftest normalize3-test
  (is (= [0.0 1.0 0.0] (s/normalize3 [0 5 0])))
  (let [[x y z] (s/normalize3 [3 4 0])]
    (is (< (abs (- x 0.6)) 1e-9))
    (is (< (abs (- y 0.8)) 1e-9))
    (is (= 0.0 z))))

(deftest enum-validation
  (is (thrown? #?(:clj Exception :cljs js/Error) (s/camera {:eye [0 0 5] :target [0 0 0] :shot "Bogus"})))
  (is (thrown? #?(:clj Exception :cljs js/Error) (s/light {:role "Nope" :direction [0 -1 0]})))
  (testing "an unknown expression word is lenient → Neutral (mirrors Rust expression_preset)"
    (is (= "Neutral" (-> (s/add-character (s/scene) {:id 1 :rkey "x" :expression "Glee"})
                         :characters first :expression)))))

(deftest three-point-presets
  (is (= 3 (count s/three-point)))
  (is (= "Key" (:role s/three-point-key)))
  (is (= [1.0 0.96 0.92] (:colour s/three-point-key)))
  (testing "direction is normalized"
    (let [[x y z] (:direction s/three-point-key)]
      (is (< (abs (- 1.0 (Math/sqrt (+ (* x x) (* y y) (* z z))))) 1e-9)))))

(deftest scene-build-and-jsonld-roundtrips-shape
  (let [sc (-> (s/scene)
               (s/add-character {:id 0 :rkey "nei" :expression "joy"
                                 :pose-label "action.reach"})
               (s/set-camera (s/camera {:eye [0 1.4 3] :target [0 1.4 0]
                                        :shot "Closeup"
                                        :dof (s/dof 3.0 1.8)}))
               (s/set-lights s/three-point)
               (s/set-environment (s/environment {:biome "water-city" :weather "clear"
                                                  :seed 42 :ground-size-m 80
                                                  :layout-anchors [(s/anchor "bench" (s/transform [2 0 1]))]})))
        jl (s/->jsonld sc)]
    (testing "JSON-LD has the exact keys the Rust from_jsonld reads"
      (is (= s/context (get jl "@context")))
      (is (= 1 (count (get jl "characters"))))
      (let [c (first (get jl "characters"))]
        (is (= 0 (get c "id")))
        (is (= "nei" (get c "rkey")))
        (is (= "Happy" (get c "expression")))          ; normalized from "joy"
        (is (= "action.reach" (get c "pose_label")))
        (is (contains? (get c "root_xform") "translation")))
      (let [cam (get jl "camera")]
        (is (= "Closeup" (get cam "shot")))
        (is (= 35.0 (get cam "fov_deg")))
        (is (= {"focus_distance_m" 3.0 "aperture" 1.8} (get cam "dof"))))
      (is (= 3 (count (get jl "lights"))))
      (is (= "Key" (get-in jl ["lights" 0 "role"])))
      (let [env (get jl "environment")]
        (is (= "water-city" (get env "biome")))
        (is (= 42 (get env "seed")))
        (is (= "bench" (get-in env ["layout_anchors" 0 "name"])))))
    (testing "serializes to JSON without error"
      (is (string? (s/->json sc)))
      (is (= "water-city" (get-in (parse-json (s/->json sc)) ["environment" "biome"]))))))

;; ---------------------------------------------------------------------------
;; Added 2026-08-18 with the `.clj` -> `.cljc` conversion. The suite that was
;; here exercised `->json` with exactly two assertions ("it is a string" and
;; "one key survives the round trip"), which is not enough to notice a JSON
;; branch going wrong on a runtime the suite had never been run on.
;; ---------------------------------------------------------------------------

(defn- full-scene []
  (-> (s/scene)
      (s/add-character {:id 0 :rkey "nei" :expression "joy"
                        :pose-label "action.reach"})
      (s/add-prop 3 (s/transform [1 0 0]))
      (s/set-camera (s/camera {:eye [0 1.4 3] :target [0 1.4 0]
                               :shot "Closeup" :dof (s/dof 3.0 1.8)}))
      (s/set-lights s/three-point)
      (s/set-environment (s/environment {:biome "water-city" :weather "clear"
                                         :seed 42 :ground-size-m 80
                                         :layout-anchors [(s/anchor "bench" (s/transform [2 0 1]))]}))))

(deftest json-round-trips-the-whole-projection-not-one-key
  ;; The `->json` reader conditional is the ONLY runtime-specific line in the
  ;; library, so it is the one thing this conversion could have broken. A
  ;; single-key spot check would pass against a serializer that dropped
  ;; nested vectors, mangled nulls, or reordered nothing but lost the
  ;; characters array. Compare the whole parsed value instead.
  (let [sc (full-scene)
        parsed (parse-json (s/->json sc))
        direct (s/->jsonld sc)]
    (is (= (get direct "@context") (get parsed "@context")))
    (is (= 1 (count (get parsed "characters"))))
    (is (= "Happy" (get-in parsed ["characters" 0 "expression"])))
    (is (= [2.0 0.0 1.0]
           (mapv double (get-in parsed ["environment" "layout_anchors" 0 "xform" "translation"])))
        "a vector nested four deep survives serialization")
    (is (= 3 (count (get parsed "lights"))))
    (is (= [3] (mapv #(get % "id") (get parsed "props")))
        "props project only their id, per ->jsonld")))

(deftest json-writes-null-for-an-absent-camera-not-an-empty-object
  ;; `->jsonld` deliberately emits `nil` for a scene with no camera; the Rust
  ;; side reads that as `Option::None`. `{}` would deserialize as a camera
  ;; with every field missing, which is a different and much worse answer.
  (let [parsed (parse-json (s/->json (s/scene)))]
    (is (nil? (get parsed "camera")))
    (is (nil? (get parsed "environment")))
    (is (= [] (get parsed "characters")))))

(deftest json-escapes-a-string-that-would-otherwise-break-the-document
  ;; Two different serializers, one per runtime. Quoting and escaping is the
  ;; thing they are each trusted to get right, so ask.
  (let [sc (-> (s/scene)
               (s/set-environment (s/environment {:biome "a\"b\\c\nd" :weather nil})))
        parsed (parse-json (s/->json sc))]
    (is (= "a\"b\\c\nd" (get-in parsed ["environment" "biome"])))))

(deftest json-text-differs-between-runtimes-on-whole-doubles
  ;; Documented divergence, asserted in BOTH directions so it cannot rot into
  ;; a surprise. ClojureScript has no distinct double type -- `1.0` and `1`
  ;; are one `js/Number` -- so no serializer running there can emit `35.0`.
  ;; The parsed NUMBER is identical either way, which is what the Rust
  ;; consumer sees; only the text differs, which is what a digest would see.
  (let [txt (s/->json (-> (s/scene)
                          (s/set-camera (s/camera {:eye [0 0 5] :target [0 0 0]}))))
        parsed (parse-json txt)]
    (is (= 35.0 (double (get-in parsed ["camera" "fov_deg"])))
        "the VALUE is the same on both runtimes")
    #?(:clj  (is (str/includes? txt "\"fov_deg\":35.0")
                 "data.json keeps the double marker")
       :cljs (is (str/includes? txt "\"fov_deg\":35")
                 "JSON.stringify cannot know it was a double"))))

(deftest expression-of-normalizes-case-and-falls-back
  ;; `case` over string literals is not the same construct on both runtimes
  ;; (JVM `case` hashes; cljs compiles to a switch on strings). Ask both.
  (is (= "Angry" (s/expression-of "RAGE")))
  (is (= "Pained" (s/expression-of 'hurt)) "a non-string is str'd first")
  ;; ...and `str` on a KEYWORD keeps the colon, so `:hurt` becomes ":hurt",
  ;; matches nothing, and falls back. Recorded as the behaviour it is rather
  ;; than fixed: the docstring's contract is "an emotion word", callers pass
  ;; strings, and silently accepting `:hurt` here would be a change to what
  ;; `expression-of` means, not a portability fix.
  (is (= "Neutral" (s/expression-of :hurt)) "a keyword strs to \":hurt\"")
  (is (= "Neutral" (s/expression-of nil)) "nil is a word this table does not know"))

(deftest check-reports-the-offending-value
  ;; `ex-info` data, not just the throw: a validator that threw a bare
  ;; message would leave a caller unable to say WHICH shot grammar was wrong.
  (let [e (try (s/camera {:eye [0 0 1] :target [0 0 0] :shot "Bogus"})
               nil
               (catch #?(:clj clojure.lang.ExceptionInfo :cljs :default) ex ex))]
    (is (some? e) "an invalid enum must throw")
    (is (= {:value "Bogus"} (ex-data e)))
    (is (str/includes? (ex-message e) "shot-grammar"))))

(deftest numeric-coercions-hold-on-both-runtimes
  ;; `long`/`double` exist in cljs.core but are coercions over one numeric
  ;; type, so the JVM's guarantees are not automatically the cljs ones.
  (is (= 42 (:seed (s/environment {:biome "x" :weather nil :seed 42.9})))
      "seed truncates toward zero")
  (is (= [1.0 2.0 3.0] (s/vec3 1 2 3)))
  (is (= [0.0 0.0 0.0] (s/normalize3 [0 0 0])) "a zero vector normalizes to zero, not NaN"))

;; ---------------------------------------------------------------------------
;; Added after the first blind mutation run, which produced two survivors.
;; Both were real gaps, and both were the same shape: a value that exists only
;; to mirror something in another repository, spot-checked on one field and
;; therefore free to drift on every other one.
;;
;;   :the-key-light-keeps-the-rust-intensity      — three-point-presets
;;     asserted the role and the colour of the key light and never its
;;     intensity, so `4.0` could become anything.
;;   :jsonld-nests-the-environment-under-snake-case-too — the JSON-LD shape
;;     test named five keys out of fourteen, and `ground_size_m` was not one
;;     of them. Renaming it to camelCase broke nothing here and would have
;;     broken `MangakaScene::from_jsonld`.
;;
;; The fix for the second is a key-SET assertion rather than another spot
;; check: a test that names the keys individually is a test that will have
;; the same gap again the next time a field is added.
;; ---------------------------------------------------------------------------

(deftest three-point-presets-carry-every-mirrored-number
  ;; These constants exist only to equal `LightSpec::three_point_*` in the
  ;; Rust crate. Nothing in this repository can check that they still do —
  ;; there is no cross-repo fixture — so the least this suite can do is
  ;; notice when they change HERE.
  (is (= {:role "Key" :colour [1.0 0.96 0.92] :intensity 4.0
          :direction (s/normalize3 [-0.6 -0.8 -0.4])}
         s/three-point-key))
  (is (= {:role "Fill" :colour [0.86 0.92 1.0] :intensity 1.4
          :direction (s/normalize3 [0.7 -0.4 -0.2])}
         s/three-point-fill))
  (is (= {:role "Rim" :colour [1.0 1.0 1.0] :intensity 2.0
          :direction (s/normalize3 [0.1 -0.2 0.95])}
         s/three-point-rim))
  (is (= [s/three-point-key s/three-point-fill s/three-point-rim] s/three-point)))

(deftest jsonld-emits-exactly-the-keys-from-jsonld-reads
  ;; Key SETS, not a sample of keys. Every one of these spellings is a wire
  ;; contract with serde on the Rust side, where a renamed field is a missing
  ;; field, and the previous test named five of them.
  (let [jl (s/->jsonld (full-scene))]
    (is (= #{"@context" "characters" "props" "camera" "lights" "environment"}
           (set (keys jl))))
    (is (= #{"id" "rkey" "pose_label" "expression" "root_xform"}
           (set (keys (first (get jl "characters"))))))
    (is (= #{"translation" "rotation" "scale"}
           (set (keys (get-in jl ["characters" 0 "root_xform"])))))
    (is (= #{"id"} (set (keys (first (get jl "props"))))))
    (is (= #{"eye" "target" "up" "fov_deg" "roll_deg" "dof" "shot"}
           (set (keys (get jl "camera")))))
    (is (= #{"focus_distance_m" "aperture"}
           (set (keys (get-in jl ["camera" "dof"])))))
    (is (= #{"role" "direction" "colour" "intensity"}
           (set (keys (first (get jl "lights"))))))
    (is (= #{"biome" "weather" "seed" "ground_size_m" "layout_anchors"}
           (set (keys (get jl "environment")))))
    (is (= #{"name" "xform"}
           (set (keys (get-in jl ["environment" "layout_anchors" 0])))))
    (is (= 80.0 (get-in jl ["environment" "ground_size_m"]))
        "and the value under the key, not only the key")))
