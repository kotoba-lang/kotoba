#!/usr/bin/env kbb
;; The scene-authoring suite on nbb — no JVM, no build step.
;;
;; This file is the point of the `.cljc` conversion. A reader conditional
;; whose `:cljs` branch nothing ever evaluates is the APPEARANCE of
;; portability: renaming a file to `.cljc` and running only `kbb -M:test`
;; proves the case that already worked. `->json` has exactly one such branch,
;; so if it is never executed the conversion has demonstrated nothing.
;;
;;   kbb --backend sci --classpath src:test test/run_portable.cljk
;;
;; and, because a run from the repo root cannot detect a working-directory
;; assumption, also from somewhere else:
;;
;;   cd /tmp && kbb --backend sci --classpath /path/to/repo/src:/path/to/repo/test \
;;                  /path/to/repo/test/run_portable.cljk
;;
;; There is no third-party dependency on this path: `json.data-json` is
;; the `:clj` branch only, and nothing else here leaves clojure.core.
;;
;; Every `deftest`-bearing portable namespace must be named BOTH in the
;; require and in `run-tests`: requiring interns the vars, only `run-tests`
;; runs them, and a runner naming a subset prints the same `Ran N tests`
;; shape as one naming all of them.
(require '[cljs.test :as t]
         '[kami.mangaka.scene-test])

(defmethod t/report [:cljs.test/default :end-run-tests] [m]
  (when-not (t/successful? m) (set! (.-exitCode js/process) 1)))

(t/run-tests 'kami.mangaka.scene-test)
