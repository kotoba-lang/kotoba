#!/usr/bin/env kbb
;; Run the suite on the ClojureScript side.
;;
;; Not a formality, the same way it isn't for `org-modbus`. `dnp3.crc` shifts
;; and masks throughout, and JavaScript's bitwise operators are 32-bit and
;; signed where the JVM's are 64-bit — the 16-bit CRC never notices, but
;; `dnp3.objects`'s 32-bit analog values and the CROB on/off timers do, and
;; that boundary is exactly where `read-i32-le`/`read-u32-le` earn their
;; platform-specific-looking-but-actually-portable sign-extension comments.
;;
;;   kbb --backend sci --classpath "$(kbb -A:cljs -Spath)" scripts/verify-cljs.cljk
(ns verify-cljs
  (:require [kotoba.test :as t]
            [dnp3.core-test]))

(defmethod t/report [:cljs.test/default :end-run-tests] [m]
  (println)
  (if (t/successful? m)
    (println "all checks passed on the ClojureScript path")
    (do (println "FAILED on the ClojureScript path")
        (js/process.exit 1))))

(t/run-tests 'dnp3.core-test)
