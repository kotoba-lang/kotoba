;; No dependencies. DNP3's data link and transport layers are integer
;; framing and a CRC; the application layer is a handful of TLVs over that.
;; A leaf that dragged an IO or serial stack behind it would defeat the
;; point, which is proving this workspace can hold a real SCADA codec.
{:paths ["src"]
 :deps {
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}}
 :aliases
 {:test {:extra-paths ["test"]}
  :cljs {:extra-paths ["test"]}}}
