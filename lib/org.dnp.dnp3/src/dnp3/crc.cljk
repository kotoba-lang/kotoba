(ns dnp3.crc
  "CRC-16/DNP — IEEE Std 1815-2012 (DNP3) §9.2.6, the data-link-layer frame
  check sequence.

  Two implementations live here on purpose, the same way `org-modbus`'s
  `crc.cljc` does. `crc16-bitwise` is the definition — shift and
  conditionally xor, eight times per byte — and `crc16` is the nibble-table
  form. The test suite asserts they agree over every two-byte input, which is
  a stronger statement than either one matching a constant somebody
  remembered.

  Parameters (CRC RevEng catalogue, CRC-16/DNP): width 16, polynomial 0x3D65,
  init 0x0000, input and output both reflected, final xor 0xFFFF. The check
  value for the ASCII string \"123456789\" is 0xEA82.

  DNP3 does not use this as a single whole-message CRC the way Modbus does:
  the data link layer runs it once per 16-byte block (see `dnp3.dl`), with a
  fresh init of 0x0000 for every block — there is no running CRC carried
  across blocks."
  )

(def polynomial
  "0xA6BC — the bit-reversal of the catalogue's 0x3D65, because DNP3 feeds
  the message least-significant-bit first, same convention as Modbus's
  0xA001 from 0x8005. Writing 0x3D65 here and shifting the other way
  produces a CRC that is self-consistent and wrong."
  0xA6BC)

(defn crc16-bitwise
  "The definition, one bit at a time, before the final complement. Slow, and
  the thing the table form is checked against."
  [bs]
  (reduce (fn [crc b]
            (loop [crc (bit-xor crc (bit-and b 0xFF)) i 0]
              (if (= i 8)
                crc
                (recur (if (odd? crc)
                         (bit-xor (unsigned-bit-shift-right crc 1) polynomial)
                         (unsigned-bit-shift-right crc 1))
                       (inc i)))))
          0x0000
          bs))

(def ^:private nibble-table
  (mapv (fn [n]
          (loop [crc n i 0]
            (if (= i 4)
              crc
              (recur (if (odd? crc)
                       (bit-xor (unsigned-bit-shift-right crc 1) polynomial)
                       (unsigned-bit-shift-right crc 1))
                     (inc i)))))
        (range 16)))

(defn- table-form
  "Nibble-table CRC before the final complement — the shared inner loop of
  `crc16` and `crc16-bitwise`'s table cousin."
  [bs]
  (reduce (fn [crc b]
            (let [crc (bit-xor crc (bit-and b 0xFF))
                  crc (bit-xor (unsigned-bit-shift-right crc 4)
                               (nth nibble-table (bit-and crc 0x0F)))]
              (bit-xor (unsigned-bit-shift-right crc 4)
                       (nth nibble-table (bit-and crc 0x0F)))))
          0x0000
          bs))

(defn crc16
  "CRC-16/DNP of `bs`, as an integer 0..65535. Unlike CRC-16/MODBUS, the
  result is complemented (`xorout` 0xFFFF) before it goes on the wire."
  [bs]
  (bit-and 0xFFFF (bit-xor 0xFFFF (table-form bs))))

(defn crc16-bitwise-complemented
  "`crc16-bitwise` with the final complement applied — the value to compare
  against `crc16` for cross-checking."
  [bs]
  (bit-and 0xFFFF (bit-xor 0xFFFF (crc16-bitwise bs))))

(defn crc16-bytes
  "The CRC as it goes on the wire: **low byte first**, same convention as
  Modbus RTU."
  [bs]
  (let [c (crc16 bs)]
    [(bit-and c 0xFF) (bit-and (unsigned-bit-shift-right c 8) 0xFF)]))
