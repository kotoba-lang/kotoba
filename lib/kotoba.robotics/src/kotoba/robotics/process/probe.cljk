(ns kotoba.robotics.process.probe
  "Entry point a vertical names as its `:physics` alias:

    :physics {:main-opts [\"-m\" \"kotoba.robotics.process.probe\"]}

  Reads `physics.edn` (or the path given as the first argument) from the
  working directory, runs it, prints ONE `itonami.physical-ai.probe.v1` EDN
  map. Exit 0 when every declared run produced a result; exit 2 when the
  spec is missing, unreadable, invalid, or any run's solver threw -- the
  answer is then 'could not measure', never 'within tolerance'."
  (:require [kotoba.lang.edn :as edn]
            [kotoba.robotics.process :as process]))

(defn read-spec [file]
  (let [text #?(:cljs (let [fs (js/require "node:fs")]
                        (when (.existsSync fs file) (.readFileSync fs file "utf8")))
                :default (let [f (java.io.File. ^String file)] (when (.exists f) (slurp f))))]
    (when text (edn/read-string text))))

(defn- exit! [code]
  #?(:cljs (set! (.-exitCode js/process) code)
     :default (when (pos? code) (System/exit code))))

(defn -main [& [file]]
  (let [file (or file "physics.edn")
        spec (try (read-spec file) (catch #?(:cljs :default :default Throwable) e {:read-error (ex-message e)}))]
    (cond
      (nil? spec)
      (do (prn {:physics-probe/schema process/probe-schema :problems [(str file " not found")] :count 0 :expected 0})
          (exit! 2))

      (:read-error spec)
      (do (prn {:physics-probe/schema process/probe-schema :problems [(str file ": " (:read-error spec))] :count 0 :expected 0})
          (exit! 2))

      :else
      (let [p (process/probe spec)]
        (prn p)
        (exit! (if (and (pos? (:expected p)) (= (:count p) (:expected p))) 0 2))))))
