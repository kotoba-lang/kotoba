(ns kotoba.robotics.process.fluid
  "Two fluid processes a robot fills, drains, doses or pumps.

  `tank-drain`: a tank of cross-section `:tank-area-m2` holding `:h0-m`
  drains through an orifice (`:orifice-area-m2`, discharge coefficient
  `:cd`) while an optional inflow `:q-in-m3s` is pumped in; time-stepped
  (RK2) on Torricelli's law `A dh/dt = q_in - Cd a sqrt(2 g h)`. Reports the
  time to fall to `:h-target-m` (nil when the inflow holds the level above
  it) and the equilibrium level `(q_in / (Cd a))^2 / 2g`.
  Held to: with no inflow the drain time equals the closed form
  `(A / (Cd a)) sqrt(2/g) (sqrt h0 - sqrt h_target)`.

  `pipe-flow`: steady flow `:q-m3s` through a pipe (diameter, length,
  roughness) of a fluid (density, viscosity): Reynolds number, Darcy
  friction factor (laminar 64/Re, else the Colebrook equation solved by
  fixed-point iteration), pressure drop, and the pump shaft power at
  efficiency `:pump-efficiency`. Held to: laminar f = 64/Re exactly;
  turbulent f within 2 % of Haaland's explicit fit.")

(def g 9.80665)

(def tank-defaults
  {:tank-area-m2 1.0 :h0-m 2.0 :h-target-m 0.1 :orifice-area-m2 0.002 :cd 0.62
   :q-in-m3s 0.0 :dt-s 0.5 :max-time-s 86400.0})

(defn tank-drain [params]
  (let [{:keys [tank-area-m2 h0-m h-target-m orifice-area-m2 cd q-in-m3s dt-s max-time-s]}
        (merge tank-defaults params)
        dhdt (fn [h] (/ (- q-in-m3s (* cd orifice-area-m2 (Math/sqrt (* 2.0 g (max h 0.0))))) tank-area-m2))
        h-eq (/ (Math/pow (/ q-in-m3s (* cd orifice-area-m2)) 2) (* 2.0 g))
        steps-max (long (/ max-time-s dt-s))]
    (loop [i 0 h (double h0-m) cross nil]
      (let [cross (or cross (when (<= h h-target-m) (* i dt-s)))]
        (if (or cross (>= i steps-max))
          {:time-to-target-s cross :reached-target? (boolean cross)
           :equilibrium-level-m h-eq :final-level-m h :steps i}
          (let [k1 (dhdt h) k2 (dhdt (+ h (* dt-s k1)))]
            (recur (inc i) (+ h (* 0.5 dt-s (+ k1 k2))) nil)))))))

(defn drain-time-closed-form [{:keys [tank-area-m2 h0-m h-target-m orifice-area-m2 cd]}]
  (* (/ tank-area-m2 (* cd orifice-area-m2)) (Math/sqrt (/ 2.0 g)) (- (Math/sqrt h0-m) (Math/sqrt h-target-m))))

(def pipe-defaults
  {:q-m3s 0.005 :diameter-m 0.05 :length-m 50.0 :roughness-m 4.5e-5
   :density-kg-m3 998.0 :viscosity-pa-s 1.0e-3 :pump-efficiency 0.65 :elevation-m 0.0})

(defn colebrook [re rel-rough]
  (loop [f 0.02 i 0]
    (let [f' (/ 1.0 (Math/pow (* -2.0 (/ (Math/log (+ (/ rel-rough 3.7) (/ 2.51 (* re (Math/sqrt f))))) (Math/log 10.0))) 2))]
      (if (or (< (Math/abs (- f' f)) 1e-12) (> i 100)) f' (recur f' (inc i))))))

(defn haaland [re rel-rough]
  (/ 1.0 (Math/pow (* -1.8 (/ (Math/log (+ (Math/pow (/ rel-rough 3.7) 1.11) (/ 6.9 re))) (Math/log 10.0))) 2)))

(defn pipe-flow [params]
  (let [{:keys [q-m3s diameter-m length-m roughness-m density-kg-m3 viscosity-pa-s pump-efficiency elevation-m]}
        (merge pipe-defaults params)
        area (* Math/PI 0.25 diameter-m diameter-m)
        v (/ q-m3s area)
        re (/ (* density-kg-m3 v diameter-m) viscosity-pa-s)
        f (if (< re 2300.0) (/ 64.0 re) (colebrook re (/ roughness-m diameter-m)))
        dp-friction (* f (/ length-m diameter-m) 0.5 density-kg-m3 v v)
        dp (+ dp-friction (* density-kg-m3 g elevation-m))]
    {:velocity-mps v :reynolds re :laminar? (< re 2300.0) :friction-factor f
     :pressure-drop-pa dp :head-m (/ dp (* density-kg-m3 g))
     :pump-power-w (/ (* q-m3s dp) pump-efficiency)}))
