(ns kotoba.robotics.process.manipulator
  "A two-link planar arm in a VERTICAL plane moving a payload from `:from` to
  `:to` (metres, base at the origin, +y up) in `:duration-s`, time-stepped.

  Inverse kinematics (elbow-down), a quintic joint-space trajectory (zero
  velocity and acceleration at both ends), and the rigid-body inverse
  dynamics of the arm: links are uniform rods (`:m1-kg :l1-m`,
  `:m2-kg :l2-m`), the payload a point mass at the tip. Joint torques are
  `tau = M(q) qdd + C(q, qd) qd + G(q)` at every step.

  What the tests hold it to, exactly rather than visually: the static torque
  of a horizontal arm equals the moment of its weights, and the work the
  joints do over a move equals the change in potential energy (kinetic is
  zero at both ends) -- the work-energy theorem, which a wrong Coriolis or
  inertia term breaks.")

(def g 9.80665)

(def defaults
  {:l1-m 0.40 :l2-m 0.35 :m1-kg 4.0 :m2-kg 3.0 :payload-kg 1.0
   :from [0.45 0.10] :to [0.10 0.55] :duration-s 2.0 :steps 400
   :tau1-limit-nm nil :tau2-limit-nm nil})

(defn ik
  "Elbow-down joint angles [q1 q2] for tip (x, y), or nil when unreachable."
  [l1 l2 [x y]]
  (let [c2 (/ (- (+ (* x x) (* y y)) (* l1 l1) (* l2 l2)) (* 2.0 l1 l2))]
    (when (<= -1.0 c2 1.0)
      (let [q2 (Math/acos c2)
            q1 (- (Math/atan2 y x) (Math/atan2 (* l2 (Math/sin q2)) (+ l1 (* l2 (Math/cos q2)))))]
        [q1 q2]))))

(defn- link2-with-payload
  "Link 2 and the tip payload lumped into one body: mass, CoM distance from
  joint 2, inertia about that CoM."
  [m2 l2 mp]
  (let [lc2 (/ l2 2.0)
        i2 (/ (* m2 l2 l2) 12.0)
        m (+ m2 mp)
        lc (/ (+ (* m2 lc2) (* mp l2)) m)]
    {:m m :lc lc :i (+ i2 (* m2 (Math/pow (- lc2 lc) 2)) (* mp (Math/pow (- l2 lc) 2)))}))

(defn torques
  "Joint torques [tau1 tau2] at state q, qd, qdd."
  [{:keys [l1-m m1-kg m2-kg l2-m payload-kg]} [q1 q2] [qd1 qd2] [qdd1 qdd2]]
  (let [l1 (double l1-m) m1 (double m1-kg)
        lc1 (/ l1 2.0) i1 (/ (* m1 l1 l1) 12.0)
        {m2 :m lc2 :lc i2 :i} (link2-with-payload m2-kg l2-m payload-kg)
        c2 (Math/cos q2) s2 (Math/sin q2)
        m11 (+ i1 i2 (* m1 lc1 lc1) (* m2 (+ (* l1 l1) (* lc2 lc2) (* 2.0 l1 lc2 c2))))
        m12 (+ i2 (* m2 (+ (* lc2 lc2) (* l1 lc2 c2))))
        m22 (+ i2 (* m2 lc2 lc2))
        h (* m2 l1 lc2 s2)
        g1 (+ (* (+ (* m1 lc1) (* m2 l1)) g (Math/cos q1)) (* m2 lc2 g (Math/cos (+ q1 q2))))
        g2 (* m2 lc2 g (Math/cos (+ q1 q2)))]
    [(+ (* m11 qdd1) (* m12 qdd2) (- (* h (+ (* 2.0 qd1 qd2) (* qd2 qd2)))) g1)
     (+ (* m12 qdd1) (* m22 qdd2) (* h qd1 qd1) g2)]))

(defn- quintic [tau] ; s, s', s'' for tau in [0,1]
  [(+ (* 10 (Math/pow tau 3)) (* -15 (Math/pow tau 4)) (* 6 (Math/pow tau 5)))
   (+ (* 30 (Math/pow tau 2)) (* -60 (Math/pow tau 3)) (* 30 (Math/pow tau 4)))
   (+ (* 60 tau) (* -180 (Math/pow tau 2)) (* 120 (Math/pow tau 3)))])

(defn potential-energy
  "Gravitational potential of the arm + payload at q (zero at the base height)."
  [{:keys [l1-m m1-kg m2-kg l2-m payload-kg]} [q1 q2]]
  (let [{m2 :m lc2 :lc} (link2-with-payload m2-kg l2-m payload-kg)
        y1 (* (/ l1-m 2.0) (Math/sin q1))
        y2 (+ (* l1-m (Math/sin q1)) (* lc2 (Math/sin (+ q1 q2))))]
    (* g (+ (* m1-kg y1) (* m2 y2)))))

(defn pick-place
  "Run the move. Returns scalar quantities; `:reachable? false` when either
  end is outside the workspace (no torques are invented for it)."
  [params]
  (let [p (merge defaults params)
        {:keys [l1-m l2-m from to duration-s steps tau1-limit-nm tau2-limit-nm]} p
        qa (ik l1-m l2-m from) qb (ik l1-m l2-m to)]
    (if-not (and qa qb)
      {:reachable? false}
      (let [T (double duration-s) n (long steps) dt (/ T n)
            dq (mapv - qb qa)
            rows (for [i (range (inc n))]
                   (let [[s sd sdd] (quintic (/ i (double n)))
                         q (mapv #(+ %1 (* %2 s)) qa dq)
                         qd (mapv #(/ (* % sd) T) dq)
                         qdd (mapv #(/ (* % sdd) (* T T)) dq)
                         tau (torques p q qd qdd)]
                     {:q q :qd qd :tau tau}))
            power (map (fn [{:keys [qd tau]}] (+ (* (first tau) (first qd)) (* (second tau) (second qd)))) rows)
            ;; trapezoidal integral of joint power = mechanical work done by the joints
            work (* dt (- (reduce + power) (/ (+ (first power) (last power)) 2.0)))
            abs-energy (* dt (reduce + (map #(Math/abs (double %)) power)))
            peak1 (reduce max (map #(Math/abs (double (first (:tau %)))) rows))
            peak2 (reduce max (map #(Math/abs (double (second (:tau %)))) rows))]
        {:reachable? true
         :cycle-time-s T
         :peak-tau1-nm peak1 :peak-tau2-nm peak2
         :joint-work-j work
         :delta-potential-j (- (potential-energy p qb) (potential-energy p qa))
         :actuator-energy-j abs-energy
         :within-torque-limits? (and (or (nil? tau1-limit-nm) (<= peak1 tau1-limit-nm))
                                     (or (nil? tau2-limit-nm) (<= peak2 tau2-limit-nm)))
         :steps n}))))
