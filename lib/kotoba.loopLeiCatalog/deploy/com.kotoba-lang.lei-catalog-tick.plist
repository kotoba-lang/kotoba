<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.kotoba-lang.lei-catalog-tick</string>
  <!-- One bounded cycle of kotoba-lang/loop-lei-catalog. The tick script wraps
       the cycle in `tamaki exec` itself (so the AgentRun records the real argv
       and exit code) and publishes the ledger line afterwards; launchd only
       needs to fire it. Mirrors com.kotoba-lang.toshokan-patents-tick.

       Install:
         cp deploy/com.kotoba-lang.lei-catalog-tick.plist ~/Library/LaunchAgents/
         launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.kotoba-lang.lei-catalog-tick.plist

       ProgramArguments points at the checked-out script rather than a copy under
       ~/.gftd, so there is ONE runner. Two copies of a scheduler drift, and the
       one that drifts is always the one actually firing. -->
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/nbb</string>
    <string>/Users/junkawasaki/github/com-junkawasaki/orgs/kotoba-lang/loop-lei-catalog/deploy/run-lei-catalog-tick.cljk</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>LEI_LOOP_ROOT</key>
    <string>/Users/junkawasaki/github/com-junkawasaki</string>
  </dict>
  <!-- 6h, matching the other gftd/kotoba-lang ticks. A cycle does ONE bounded
       step (40 contact fetches, or one acquisition pass over the candidate
       file), so a shorter interval would re-observe far more often than the
       catalog can actually move. -->
  <key>StartInterval</key>
  <integer>21600</integer>
  <!-- False: the first run is triggered by hand after loading, so a login does
       not fire a network-heavy crawl before the operator is watching. -->
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>/Users/junkawasaki/.gftd/lei-catalog-tick.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/junkawasaki/.gftd/lei-catalog-tick.stdout.log</string>
</dict>
</plist>
