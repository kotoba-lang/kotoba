;; The portable `.cljc` suite under a real ClojureScript host.
;;
;; AGENTS.md's runtime priority puts ClojureScript above the JVM, and every
;; namespace in this library except `marketplace.edge` is `.cljc` -- but for
;; a while the only thing that ever ran the suite was `kbb -M:test` on
;; the JVM, so "portable" was an assertion rather than a fact. This build
;; makes it checkable: `npm run test:cljs`.
;;
;; :node-test discovers `*-test` namespaces from :test-paths. `marketplace.edge`
;; is deliberately not exercised here -- it is the host half (kotobase over
;; the network) and has no test namespace to discover.
;;
;; The `:demo` build is the buy-box demo GENERATOR. It runs the library and
;; writes `docs/buy-box.html` from what it returned, so the page cannot drift
;; from the code the way a hand-drawn mock-up does. Its sources are in
;; `tools/`, off the library's own :paths -- the `:demo` alias adds them.
{:deps {:aliases [:cljs-test :demo]}
 :builds
 {:test
  {:target    :node-test
   :output-to "out/node-tests.js"
   :ns-regexp "-test$"
   :compiler-options {:output-feature-set :es2020}}

  :demo
  {:target    :node-script
   :main      marketplace-demo.buy-box/main
   :output-to "out/gen-buy-box-demo.js"
   :compiler-options {:output-feature-set :es2020}}}}
