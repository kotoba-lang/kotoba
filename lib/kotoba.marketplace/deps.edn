{:paths ["src"]
 ;; Every dep is an existing kotoba-lang capability library this repo
 ;; COMPOSES rather than reimplements (ADR-2607264000 D2). All are
 ;; portable `.cljc` with no network I/O, so this library stays pure.
 ;; Pinned by git coordinate, not :local/root. CI checks out this repo alone,
 ;; so a sibling path never resolves there -- the classpath failed to build
 ;; before any test ran ("Local lib io.github.kotoba-lang/pay not found").
 :deps {
        io.github.kotoba-lang/edn {:local/root "../kotoba.edn"}
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}
        io.github.kotoba-lang/ekyc {:local/root "../kotoba.ekyc"}
        io.github.kotoba-lang/aml {:local/root "../kotoba.aml"}
        io.github.kotoba-lang/pay {:local/root "../kotoba.pay"}
        io.github.kotoba-lang/product-party {:local/root "../kotoba.productParty"}
        io.github.kotoba-lang/search {:local/root "../kotoba.search"}
        io.github.kotoba-lang/okaimono {:local/root "../kotoba.okaimono"}
        io.github.kotoba-lang/robotics {:local/root "../kotoba.robotics"}
        io.github.kotoba-lang/kotobase-client {:local/root "../kotoba.kotobaseClient"}}
 :aliases
 {:test {:extra-paths ["test"]}}}
