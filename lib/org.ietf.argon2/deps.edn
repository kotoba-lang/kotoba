;; One dependency, and it is a workspace leaf: BLAKE2b, which Argon2 uses for
;; H0 and for the variable-length H'. Reimplementing it here to stay
;; dependency-free would be the worse trade -- two copies of a hash function
;; is how they drift.
;;
;; Nothing else. In particular no arbitrary-precision integer library: the
;; 64-bit arithmetic is done in `argon2.u32` over pairs of 32-bit lanes,
;; because the BigInt representation that suits BLAKE2b's inputs would make a
;; memory-hard function unusable on the ClojureScript side.
{:paths ["src"]
 :deps {
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/org-ietf-blake2 {:local/root "../org.ietf.blake2"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  ;; classpath only, no :main-opts -- `kbb -A:cljs -Spath` resolves deps
  ;; for nbb without the deprecation warning `-A` prints when the alias
  ;; carries a main.
  :cljs {:extra-paths ["test"]}

  ;; The differential oracle. BouncyCastle is test-scoped and never reaches
  ;; :deps: it is what this implementation is CHECKED AGAINST, not something
  ;; it builds on. `kotoba-lang/pqh` scopes its Argon2 fixture the same way.
  :oracle {:extra-paths ["test" "oracle"]
           :extra-deps {org.bouncycastle/bcprov-jdk18on {:mvn/version "1.78.1"}
                        io.github.cognitect-labs/test-runner
                        {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
           ;; Both -d directories are named explicitly. The runner defaults to
           ;; `test` alone, so without this it exits 0 having never loaded the
           ;; differential suite -- a green that means "not run".
           :main-opts ["-m" "cognitect.test-runner" "-d" "test" "-d" "oracle"]}

  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
