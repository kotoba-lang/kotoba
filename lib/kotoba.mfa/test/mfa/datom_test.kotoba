;; Test for mfa.datom. main returns the number of failed cases.
(ns mfa.datom-test
  (:export [main])
  (:require [mfa.datom :as d]))

(defn- gv [m :document k :keyword] :document
  (option-value-of [:option :document] (document-get m k) (document-null)))
(defn- elem [xs :document i :i64] :document
  (option-value-of [:option :document] (document-vector-at xs i) (document-null)))
(defn- str-of [m :document k :keyword] :string
  (option-value-of [:option :string] (document-string-value (gv m k)) "<none>"))
(defn- bool-of [m :document k :keyword] :bool
  (option-value-of [:option :bool] (document-bool-value (gv m k)) false))
(defn- chk-i64 [got :i64 want :i64] :i64
  (if (= got want) 0 1))
(defn- chk-str [got :string want :string] :i64
  (if (string=? got want) 0 1))
(defn- chk-bool [got :bool want :bool] :i64
  (if (= got want) 0 1))

(defn main [] :i64
  (let [policy (document-map :mfa.policy/id (document-string "p1")
                             :mfa.policy/required (document-bool true)
                             :mfa.policy/phishing-resistant? (document-bool true)
                             :mfa.policy/purpose (document-string "login"))
        out (d/policy-datoms policy)
        row (elem out 0)
        c1 (chk-i64 (document-count out) 1)
        c2 (chk-str (str-of row :db/id) "p1")
        c3 (chk-bool (bool-of row :mfa.policy/required) true)
        c4 (chk-bool (bool-of row :mfa.policy/phishing-resistant?) true)
        c5 (chk-str (str-of row :mfa.policy/purpose) "login")
        c6 (chk-bool (= (document-kind (gv row :mfa.policy/fallbacks)) :null) true)
        result (document-map :mfa.result/policy-id (document-string "p1")
                             :mfa.result/factors (document-vector
                                                  (document-map :authn.factor/type (document-string "totp"))
                                                  (document-map :authn.factor/type (document-string "webauthn")))
                             :mfa.result/ok? (document-bool false))
        rr (elem (d/result-datoms result) 0)
        ft (gv rr :mfa.result/factor-types)
        c7 (chk-str (str-of rr :mfa.result/policy-id) "p1")
        c8 (chk-i64 (document-count ft) 2)
        c9 (chk-str (option-value-of [:option :string] (document-string-value (elem ft 0)) "<none>") "totp")
        c10 (chk-bool (bool-of rr :mfa.result/ok?) false)
        empty (elem (d/result-datoms (document-map :mfa.result/policy-id (document-string "p2"))) 0)
        c11 (chk-i64 (document-count (gv empty :mfa.result/factor-types)) 0)]
    (+ c1 (+ c2 (+ c3 (+ c4 (+ c5 (+ c6 (+ c7 (+ c8 (+ c9 (+ c10 c11))))))))))))
