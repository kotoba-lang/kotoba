;; Port of mfa.datom (datom.cljk), Kotoba-native.
;; Maps are :document values. An absent key reads as null (the source reads
;; nil). mapv over the factors is a loop; a non-sequence factors value gives
;; an empty factor-types vector.
(ns mfa.datom
  (:export [policy-datoms result-datoms]))

(defn- gv [m :document k :keyword] :document
  (option-value-of [:option :document] (document-get m k) (document-null)))

(defn- elem [xs :document i :i64] :document
  (option-value-of [:option :document] (document-vector-at xs i) (document-null)))

(defn- factor-type-loop [factors :document i :i64 acc :document] :document
  (if (>= i (document-count factors))
    acc
    (factor-type-loop factors (+ i 1)
                      (document-vector-conj acc (gv (elem factors i) :authn.factor/type)))))

(defn- factor-types [factors :document] :document
  (let [k (document-kind factors)]
    (if (or (= k :vector) (= k :list))
      (factor-type-loop factors 0 (document-vector))
      (document-vector))))

(defn policy-datoms [policy :document] :document
  (document-vector
   (document-map :db/id (gv policy :mfa.policy/id)
                 :mfa.policy/required (gv policy :mfa.policy/required)
                 :mfa.policy/phishing-resistant? (gv policy :mfa.policy/phishing-resistant?)
                 :mfa.policy/purpose (gv policy :mfa.policy/purpose)
                 :mfa.policy/preferences (gv policy :mfa.policy/preferences)
                 :mfa.policy/fallbacks (gv policy :mfa.policy/fallbacks)
                 :mfa.policy/fallback-for (gv policy :mfa.policy/fallback-for))))

(defn result-datoms [result :document] :document
  (document-vector
   (document-map :db/id (gv result :mfa.result/policy-id)
                 :mfa.result/policy-id (gv result :mfa.result/policy-id)
                 :mfa.result/factor-types (factor-types (gv result :mfa.result/factors))
                 :mfa.result/ok? (gv result :mfa.result/ok?))))
