(ns run-tests
  (:require [kotoba.test :as t]
            [kaiyu.core-test]
            [kaiyu.diagnose-test]
            [kaiyu.session-test]))

(defn -main [& _]
  (let [{:keys [fail error]} (t/run-tests 'kaiyu.core-test 'kaiyu.diagnose-test 'kaiyu.session-test)]
    (System/exit (if (pos? (+ fail error)) 1 0))))
