{
  "@context": {
    "etzhayyim": "https://resources.etzhayyim.com/etzhayyim-project-resources/id/",
    "schema": "https://schema.org/",
    "dodaf": "https://resources.etzhayyim.com/etzhayyim-project-resources/id/DM2/"
  },
  "@type": "etzhayyim:Project",
  "@id": "https://resources.etzhayyim.com/etzhayyim-project-external-service-adapter/id/Project/etzhayyim-project-external-service-adapter",
  "schema:name": "etzhayyim-project-external-service-adapter",
  "schema:description": "External service adapters for Microsoft 365 (Outlook, OneDrive, Calendar, Contacts) and Google Workspace (Gmail, Google Drive, Google Calendar, People) via OAuth2-authenticated MCP components",
  "dodaf:capability": [
    {
      "@type": "dodaf:Capability",
      "schema:name": "Outlook Mail Automation",
      "schema:description": "Send, receive, search, reply, and delete emails via Microsoft Graph API"
    },
    {
      "@type": "dodaf:Capability",
      "schema:name": "Outlook Calendar Management",
      "schema:description": "Create, update, delete, and list calendar events via Microsoft Graph API"
    },
    {
      "@type": "dodaf:Capability",
      "schema:name": "Outlook Contacts Management",
      "schema:description": "List, get, and create contacts via Microsoft Graph API"
    },
    {
      "@type": "dodaf:Capability",
      "schema:name": "OneDrive File Management",
      "schema:description": "List, search, upload, and manage files on OneDrive via Microsoft Graph API"
    },
    {
      "@type": "dodaf:Capability",
      "schema:name": "Gmail Mail Automation",
      "schema:description": "Send, receive, search, reply, and trash emails via Gmail API"
    },
    {
      "@type": "dodaf:Capability",
      "schema:name": "Google Calendar Management",
      "schema:description": "Create, update, delete, and list calendar events via Google Calendar API"
    },
    {
      "@type": "dodaf:Capability",
      "schema:name": "Google Contacts Management",
      "schema:description": "List, get, and create contacts via Google People API"
    },
    {
      "@type": "dodaf:Capability",
      "schema:name": "Google Drive File Management",
      "schema:description": "List, search, upload, and manage files on Google Drive via Drive API"
    },
    {
      "@type": "dodaf:Capability",
      "schema:name": "OAuth2 Token Management",
      "schema:description": "OAuth2 authorization code flow with PKCE, token refresh, and per-user token persistence via sql graph/sql graph"
    }
  ],
  "dodaf:performer": [
    {
      "@type": "dodaf:Performer",
      "schema:name": "outlook-adapter-component",
      "schema:description": "SpinApp MCP component for Microsoft 365 integration via Graph API (mail, calendar, contacts, OneDrive)"
    },
    {
      "@type": "dodaf:Performer",
      "schema:name": "gmail-adapter-component",
      "schema:description": "SpinApp MCP component for Google Workspace integration (Gmail, Calendar, People, Drive)"
    }
  ]
}
