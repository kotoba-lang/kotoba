{:paths ["src"]
 ;; pay's core stays pure and dependency-free; this is for `pay.rail.base-l2`,
 ;; the ERC-4337 adapter the README has always named as the rail's intended
 ;; backing. base-l2 performs no I/O of its own either -- it is pure over an
 ;; injected transport and an injected bundler -- so "zero network I/O, zero
 ;; key custody" still holds.
 :deps {
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}
        io.github.kotoba-lang/eth-crypto {:local/root "../kotoba.ethCrypto"}
        io.github.kotoba-lang/base-l2 {:local/root "../kotoba.baseL2"}}
 :aliases {:test {:extra-paths ["test"]}}}
