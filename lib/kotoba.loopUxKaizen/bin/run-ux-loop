#!/usr/bin/env bash
set -euo pipefail

usage() {
  echo "usage: run-ux-loop --root DIR --html FILE --url URL --artifacts DIR [--scope ORG/REPO] [--width N] [--height N]" >&2
}

app_root=""
html_path=""
app_url=""
artifact_dir=""
scope=""
width="393"
height="852"
journey_click=""
journey_return=""
journey_expect=""

while [ "$#" -gt 0 ]; do
  case "$1" in
    --root) app_root="$2"; shift 2 ;;
    --html) html_path="$2"; shift 2 ;;
    --url) app_url="$2"; shift 2 ;;
    --artifacts) artifact_dir="$2"; shift 2 ;;
    --scope) scope="$2"; shift 2 ;;
    --width) width="$2"; shift 2 ;;
    --height) height="$2"; shift 2 ;;
    --journey-click) journey_click="$2"; shift 2 ;;
    --journey-return) journey_return="$2"; shift 2 ;;
    --journey-expect) journey_expect="$2"; shift 2 ;;
    *) usage; exit 2 ;;
  esac
done

if [ -z "$app_root" ] || [ -z "$html_path" ] || [ -z "$app_url" ] || [ -z "$artifact_dir" ]; then
  usage
  exit 2
fi

loop_root="$(cd "$(dirname "$0")/.." && pwd)"
quality_root="${KOTOBA_DESIGN_QUALITY_DIR:-$loop_root/../design-quality}"
port="${UX_LOOP_PORT:-4173}"
session="ux-kaizen-${UX_LOOP_SESSION_SUFFIX:-local}"
mkdir -p "$artifact_dir"

kbb --classpath "$quality_root/src" -m design-quality.cli score "$html_path" --min 95 --edn \
  > "$artifact_dir/deterministic.edn"

python3 -m http.server "$port" --bind 127.0.0.1 --directory "$app_root" \
  > "$artifact_dir/server.log" 2>&1 &
server_pid=$!
cleanup() {
  agent-browser --session "$session" close >/dev/null 2>&1 || true
  kill "$server_pid" >/dev/null 2>&1 || true
}
trap cleanup EXIT

target_url="$app_url"
if [ -n "$scope" ]; then
  case "$target_url" in
    *\?*) target_url="$target_url&scope=$scope" ;;
    *) target_url="$target_url?scope=$scope" ;;
  esac
fi

agent-browser --session "$session" open "$target_url"
agent-browser --session "$session" set viewport "$width" "$height"
agent-browser --session "$session" wait 1500
agent-browser --session "$session" snapshot -i > "$artifact_dir/snapshot.txt"
agent-browser --session "$session" screenshot "$artifact_dir/first-view.png"
agent-browser --session "$session" eval \
  'document.documentElement.scrollWidth === document.documentElement.clientWidth' \
  > "$artifact_dir/viewport.json"

if ! rg -q '^true$' "$artifact_dir/viewport.json"; then
  echo "UX gate failed: horizontal overflow detected" >&2
  exit 1
fi

if [ -n "$journey_click" ]; then
  agent-browser --session "$session" find text "$journey_click" click
  agent-browser --session "$session" wait 300
  agent-browser --session "$session" snapshot -i > "$artifact_dir/journey-target.txt"
  agent-browser --session "$session" screenshot "$artifact_dir/journey-target.png"
fi

if [ -n "$journey_return" ]; then
  agent-browser --session "$session" find text "$journey_return" click
  agent-browser --session "$session" wait 300
  agent-browser --session "$session" snapshot -i > "$artifact_dir/journey-return.txt"
fi

if [ -n "$journey_expect" ] && ! rg -q "$journey_expect" "$artifact_dir/journey-return.txt"; then
  echo "UX gate failed: journey expectation was not observed" >&2
  exit 1
fi

echo "UX loop evidence: $artifact_dir"
