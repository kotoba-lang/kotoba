(ns kagitaba.wifi-runtime (:require [kagitaba.wifi :as wifi] [kagitaba.item :as item]))
(def n {:id "random-profile-id" :principal "fixture-principal" :ssid "家のWi-Fi"
        :password "fixture-password" :security :wpa2-personal})
(def p (wifi/profile n))
(assert (item/valid? p))
(assert (= (select-keys n [:principal :ssid :password :security]) (wifi/network p)))
(assert (= #{:id :ssid :security} (set (keys (wifi/summary p)))))
(assert (= 3 (count (item/sensitive-fields p))))
(doseq [bad [(assoc n :ssid (apply str (repeat 11 "家")))
             (assoc n :password "short") (assoc n :security :open)
             (assoc n :ssid "home\n")]]
  (try (wifi/profile bad) (throw (ex-info "invalid profile accepted" {:test true}))
       (catch :default e (assert (empty? (ex-data e))))))
(println "Wi-Fi profile: round trip, summary and validation passed")
