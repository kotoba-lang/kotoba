;; Test for kagitaba.field. main returns the number of failed cases.
(ns kagitaba.field-test
  (:export [main])
  (:require [kagitaba.field :as f]))

(defn- chk-bool [got :bool want :bool] :i64
  (if (= got want) 0 1))
(defn- chk-kw [got :keyword want :keyword] :i64
  (if (= got want) 0 1))

(defn- cases-sensitive [] :i64
  (let [c1 (chk-bool (f/sensitive? :concealed) true)
        c2 (chk-bool (f/sensitive? :string) false)
        c3 (chk-bool (f/sensitive? :menu) false)
        c4 (chk-bool (f/sensitive? :bogus) true)
        c5 (chk-bool (f/sensitive? :unknown) true)]
    (+ c1 (+ c2 (+ c3 (+ c4 c5))))))

(defn- cases-classification [] :i64
  (let [c1 (chk-kw (f/classification :concealed) :restricted)
        c2 (chk-kw (f/classification :string) :internal)
        c3 (chk-kw (f/classification :bogus) :restricted)]
    (+ c1 (+ c2 c3))))

(defn- cases-value-type [] :i64
  (let [c1 (chk-kw (f/value-type (document-map (document-string "concealed") (document-string "x"))) :concealed)
        c2 (chk-kw (f/value-type (document-map (document-string "monthYear") (document-string "x"))) :month-year)
        c3 (chk-kw (f/value-type (document-map (document-string "bogus") (document-string "x"))) :unknown)
        c4 (chk-kw (f/value-type (document-map :url (document-string "x"))) :url)
        c5 (chk-kw (f/value-type (document-map (document-string "string") (document-string "x")
                                               (document-string "url") (document-string "y"))) :unknown)
        c6 (chk-kw (f/value-type (document-string "string")) :unknown)]
    (+ c1 (+ c2 (+ c3 (+ c4 (+ c5 c6)))))))

(defn- cases-sets [] :i64
  (let [c1 (chk-bool (document-set-contains? (f/value-types) (document-keyword :sso-login)) true)
        c2 (chk-bool (document-set-contains? (f/sensitive-types) (document-keyword :string)) false)
        c3 (chk-bool (document-set-contains? (f/login-field-designations) (document-keyword :password)) true)]
    (+ c1 (+ c2 c3))))

(defn main [] :i64
  (+ (cases-sensitive) (+ (cases-classification) (+ (cases-value-type) (cases-sets)))))
