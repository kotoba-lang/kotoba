{:paths ["src"]
 ;; kagitaba is a data-model library: category/field/item shapes + 1Password
 ;; import are pure .cljc (portable to JVM / SCI / ClojureScript). The only
 ;; JVM-only piece is `kagitaba.import.onepux-file` (zip + JSON IO), which
 ;; needs org.clojure/data.json — everything else is dependency-free.
 :deps {
        io.github.kotoba-lang/error {:local/root "../kotoba.error"}
        io.github.kotoba-lang/io {:local/root "../kotoba.io"}
        io.github.kotoba-lang/bytes {:local/root "../kotoba.bytes"}
        io.github.kotoba-lang/edn {:local/root "../kotoba.edn"}
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}
        io.github.kotoba-lang/json {:local/root "../kotoba.json"}
        io.github.kotoba-lang/security {:local/root "../kotoba.security"}}
 :aliases
 {:test {:extra-paths ["test"]}}}
