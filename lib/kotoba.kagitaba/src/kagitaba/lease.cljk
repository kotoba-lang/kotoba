(ns kagitaba.lease
  "credential request(agent が頼む形)と lease(発行記録)(ADR-0002)。

  ```clojure
  {:request/id \"req-…\" :request/principal \"did:key:z6Mk…\"
   :request/capability {…} :request/ttl-sec 3600
   :request/purpose \"hermes-cron:physai-isic-0111\"}

  {:lease/id \"lease-…\" :lease/request-id \"req-…\"
   :lease/issuer \"github-app: kotoba-fleet\" :lease/principal \"did:key:z6Mk…\"
   :lease/capability {…}                 ; 実際に発行した範囲(要求以下)
   :lease/issued-at 1791600000           ; unix 秒
   :lease/expires-at 1791603600
   :lease/approval {:by :policy :rule 0}
   :lease/state :active}                 ; :active | :revoked(:expired は導出)
  ```

  **lease は値を持たない。** 値は kagi が要求者の公開鍵へ封入して別に返す。だから
  lease 記録は台帳にも MCP の返り値にもそのまま出せる。

  時刻は unix 秒の整数で持ち、`now` は呼び出し側が渡す(時計を持たない)。"
  (:require [kotoba.lang.text :as str]
            [kagitaba.capability :as cap]))

(def max-ttl-sec
  "どの request もこれを超えない(GitHub installation token の上限と同じ 1 時間)。"
  3600)

(defn request-errors
  "request の構造上の誤り(空なら妥当)。"
  [req]
  (cond-> []
    (not (and (string? (:request/id req)) (not (str/blank? (:request/id req)))))
    (conj :request/id)
    (not (and (string? (:request/principal req)) (not (str/blank? (:request/principal req)))))
    (conj :request/principal)
    (not (cap/valid? (:request/capability req)))
    (conj :request/capability)
    (not (and (int? (:request/ttl-sec req)) (< 0 (:request/ttl-sec req) (inc max-ttl-sec))))
    (conj :request/ttl-sec)
    (not (and (string? (:request/purpose req)) (not (str/blank? (:request/purpose req)))))
    (conj :request/purpose)))

(defn valid-request? [req] (empty? (request-errors req)))

(defn lease
  "request から lease 記録を作る。`issued-at` は発行時刻(unix 秒)、`ttl-sec` は
  実際に与えた期限(request 以下)。"
  [{:keys [id request issuer issued-at ttl-sec approval capability]}]
  (let [granted (or capability (:request/capability request))]
    (when-not (valid-request? request)
      (throw (ex-info "cannot construct a lease from an invalid request"
                      {:request-errors (request-errors request)})))
    (when-not (and (integer? ttl-sec) (pos? ttl-sec))
      (throw (ex-info "granted lease duration must be a positive integer" {:ttl-sec ttl-sec})))
    (when-not (and (cap/valid? granted)
                   (cap/covers? (:request/capability request) granted))
      (throw (ex-info "granted capability exceeds or invalidates the request"
                      {:requested (:request/capability request) :granted granted})))
    {:lease/id id
     :lease/request-id (:request/id request)
     :lease/issuer issuer
     :lease/principal (:request/principal request)
     :lease/purpose (:request/purpose request)
     :lease/capability granted
     :lease/issued-at issued-at
     :lease/expires-at (+ issued-at (min ttl-sec (:request/ttl-sec request) max-ttl-sec))
     :lease/approval approval
     :lease/state :active}))

(defn lease-state
  "now(unix 秒)時点の状態。取り消しは記録、期限切れは導出。"
  [lease now]
  (cond
    (= :revoked (:lease/state lease)) :revoked
    (and (= :active (:lease/state lease)) (>= now (:lease/expires-at lease))) :expired
    (= :active (:lease/state lease)) :active
    :else :unknown))

(defn active? [lease now] (= :active (lease-state lease now)))

(defn revoke [lease at]
  (assoc lease :lease/state :revoked :lease/revoked-at at))

(defn remaining-sec [lease now]
  (max 0 (- (:lease/expires-at lease) now)))
