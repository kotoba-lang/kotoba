(ns kagitaba.issuer
  "発行能力を持つ item(category `:issuer`、ADR-0002)。

  ```clojure
  {:item/category :issuer
   :item/title    \"github-app: kotoba-fleet\"
   :issuer/kind   :github-app
   :issuer/public {:app-id 123456 :slug \"kotoba-fleet\"
                   :installations [{:id 789 :account \"cloud-itonami\"}]
                   :permissions {:contents :read :metadata :read}}
   :item/sections [{:section/fields [{:field/id \"private-key\" :field/type :concealed …}]}]}
  ```

  `:issuer/public` は秘密を含まない(App ID、インストール先、権限の上限)。policy の
  検証と MCP の issuer 一覧はこれだけで足りる。秘密鍵は既存の `:concealed` field に
  入り、`kagitaba.field/sensitive-types` の判定がそのまま効く。

  1Password に対応する categoryUuid は無いので kagitaba 固有の正準 keyword。1PUX
  export では `:category/issuer` として保持する(データを落とさない原則)。"
  (:require [kotoba.lang.text :as str]
            [kagitaba.capability :as cap]))

(def category :issuer)

(def issuer-schemas
  "kind → `:issuer/public` の必須キー。"
  {:github-app #{:app-id :installations :permissions}})

(def provider-of
  "kind → capability の provider。"
  {:github-app :github})

(defn public-errors
  "issuer item の `:issuer/public` に欠けている必須キー。未知の kind は
  `[:unknown-kind]`(保持はするが発行には使えない)。"
  [item]
  (if-let [required (issuer-schemas (:issuer/kind item))]
    (let [public (:issuer/public item)
          installations (:installations public)
          permissions (:permissions public)]
      (vec
       (sort
        (cond-> (remove #(contains? public %) required)
          (and (contains? public :app-id)
               (not (and (integer? (:app-id public)) (pos? (:app-id public)))))
          (conj :invalid-app-id)
          (and (contains? public :installations)
               (not (and (sequential? installations) (seq installations)
                         (every? (fn [installation]
                                   (and (map? installation)
                                        (integer? (:id installation)) (pos? (:id installation))
                                        (string? (:account installation))
                                        (not (str/blank? (:account installation)))))
                                 installations))))
          (conj :invalid-installations)
          (and (contains? public :permissions)
               (not (and (map? permissions) (seq permissions)
                         (every? keyword? (keys permissions))
                         (every? cap/level? (vals permissions)))))
          (conj :invalid-permissions)))))
    [:unknown-kind]))

(defn issuer? [item]
  (and (= category (:item/category item)) (empty? (public-errors item))))

(defn ceiling
  "issuer が発行できる最大の capability。GitHub App ならインストール先 account
  直下の全 repo × App の権限。"
  [item]
  (case (:issuer/kind item)
    :github-app {:capability/provider :github
                 :capability/access (get-in item [:issuer/public :permissions])
                 :capability/resources (vec (for [inst (get-in item [:issuer/public :installations])]
                                              (str (:account inst) "/*")))}
    nil))

(defn can-issue?
  "この issuer で request の capability を発行できるか。"
  [item capability]
  (and (issuer? item)
       (cap/valid? capability)
       (let [accounts (set (for [resource (:capability/resources capability [])]
                             (first (str/split resource #"/"))))]
         (and (= 1 (count accounts))
              (boolean (some-> (ceiling item) (cap/covers? capability)))))))

(defn installation-for
  "repo(`org/name`)を含むインストール。GitHub の installation token は
  インストール単位なので、1 回の発行は 1 account の repo に限られる。"
  [item repo]
  (let [account (first (str/split repo #"/"))]
    (some #(when (= account (:account %)) %) (get-in item [:issuer/public :installations]))))
