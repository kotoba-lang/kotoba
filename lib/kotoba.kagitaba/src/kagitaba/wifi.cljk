(ns kagitaba.wifi
  "Portable Wi-Fi profile model. Plaintext values must go directly to kagi
  sealing; neither this library nor its display summaries persist them."
  (:require [kagitaba.item :as item]))
(defn- utf8-size [s]
  #?(:cljs (.-length (.encode (js/TextEncoder.) s))
     :clj (alength (.getBytes ^String s "UTF-8"))))
(defn valid-network? [{:keys [ssid password security]}]
  (and (string? ssid) (<= 1 (utf8-size ssid) 32)
       (not (re-find #"[\x00-\x1f\x7f]" ssid))
       (contains? #{:wpa2-personal :wpa3-personal} security)
       (string? password) (boolean (re-matches #"[\x20-\x7e]{8,63}" password))))
(defn profile
  [{:keys [id principal ssid password security] :as network}]
  (when-not (and (string? id) (seq id) (string? principal) (seq principal)
                 (valid-network? network))
    (throw (ex-info "Invalid Wi-Fi profile" {})))
  (assoc (item/item* {:id id :category :wireless-router :title "Wi-Fi profile"
                     :sections [{:id "wifi" :title "Wi-Fi" :fields
                                 [{:id "ssid" :title "SSID" :type :concealed :value ssid}
                                  {:id "password" :title "Password" :type :concealed :value password}
                                  {:id "security" :title "Security" :type :menu :value security}
                                  {:id "principal" :title "Account" :type :concealed :value principal}]}]})
         :wifi/schema "kagitaba.wifi.v1"))
(defn network [profile]
  (let [fields (into {} (for [s (:item/sections profile) f (:section/fields s)]
                         [(:field/id f) (:field/value f)]))
        n {:ssid (get fields "ssid") :password (get fields "password")
           :security (get fields "security")}]
    (when-not (and (= "kagitaba.wifi.v1" (:wifi/schema profile))
                   (= :wireless-router (:item/category profile))
                   (= :active (:item/state profile))
                   (string? (get fields "principal")) (seq (get fields "principal"))
                   (valid-network? n))
      (throw (ex-info "Invalid Wi-Fi profile" {})))
    (assoc n :principal (get fields "principal"))))
(defn summary
  "Call only after vault unlock. Excludes password, principal and item fields."
  [profile]
  (let [n (network profile)]
    {:id (:item/id profile) :ssid (:ssid n) :security (:security n)}))
