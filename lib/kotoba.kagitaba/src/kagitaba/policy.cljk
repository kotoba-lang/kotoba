(ns kagitaba.policy
  "自動発行・承認・拒否の判定(ADR-0002)。

  ```clojure
  {:policy/principal \"did:key:z6Mk…\"      ; または agent の label
   :policy/issuer    :github-app
   :policy/allow     [{:capability {…} :max-ttl-sec 3600}]
   :policy/approve   [{:capability {…} :max-ttl-sec 3600 :by :passkey}]}
  ```

  `decide` は純粋関数。allow のどれかが request を覆い TTL が上限内なら `:allow`、
  approve に当たれば `:approve`、どれでもなければ `:deny` と理由。理由は
  capability/excess の形で、agent が範囲を絞り直すのに使う。通知や承認 UI は kagi 側。"
  (:require [kagitaba.capability :as cap]))

(defn- rule-fit
  "rule が request を通すなら nil、通さないなら理由。"
  [rule request]
  (let [reasons (cap/excess (:capability rule) (:request/capability request))
        max-ttl (:max-ttl-sec rule 3600)]
    (cond-> reasons
      (> (:request/ttl-sec request) max-ttl)
      (conj {:reason :ttl :wanted (:request/ttl-sec request) :granted max-ttl}))))

(defn- first-fit [rules request]
  (first (keep-indexed (fn [i rule] (when (empty? (rule-fit rule request)) [i rule])) rules)))

(defn applies?
  "この policy が request の要求者と issuer に当てはまるか。`principal-ids` は要求者を
  指す名前の集合(did と label の両方で書けるように)。"
  [policy principal-ids issuer-kind]
  (and (contains? principal-ids (:policy/principal policy))
       (= issuer-kind (:policy/issuer policy))))

(defn decide
  "policy(1 つ)と request から判定。"
  [policy request]
  (if-let [[i _] (first-fit (:policy/allow policy) request)]
    {:decision :allow :rule i}
    (if-let [[i rule] (first-fit (:policy/approve policy) request)]
      {:decision :approve :rule i :by (:by rule :passkey)}
      {:decision :deny
       :reasons (or (some->> (concat (:policy/allow policy) (:policy/approve policy))
                             seq
                             (map #(rule-fit % request))
                             (apply min-key count))
                    [{:reason :no-rule}])})))

(defn decide-in
  "policy の集合から、要求者と issuer に当てはまるもので判定。当てはまるものが
  無ければ deny(既定は閉じる)。複数あれば最も寛容な判定(allow > approve > deny)。"
  [policies principal-ids issuer-kind request]
  (if-not (contains? (set principal-ids) (:request/principal request))
    {:decision :deny :reasons [{:reason :principal-mismatch}]}
    (let [ds (for [p policies :when (applies? p principal-ids issuer-kind)] (decide p request))
          order {:allow 0 :approve 1 :deny 2}]
      (if (seq ds)
        (first (sort-by (comp order :decision) ds))
        {:decision :deny :reasons [{:reason :no-policy}]}))))
