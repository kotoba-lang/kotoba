;; Port of kagitaba.field (field.cljk), Kotoba-native.
;; Named divergences:
;;   - value-types, sensitive-types and login-field-designations are sets (defs)
;;     in the source. A def cannot be exported (E2005), so they are zero-argument
;;     fns returning :document sets of keywords.
;;   - value-type reads a :document tagged-union map. Its single key may be a
;;     string or a keyword; the key's name is its text ("url" for :url).
(ns kagitaba.field
  (:export [value-types sensitive-types login-field-designations
            sensitive? classification value-type]))

(defn value-types [] :document
  (document-set (document-keyword :string) (document-keyword :concealed)
                (document-keyword :email) (document-keyword :url)
                (document-keyword :totp) (document-keyword :phone)
                (document-keyword :date) (document-keyword :month-year)
                (document-keyword :gender) (document-keyword :menu)
                (document-keyword :address) (document-keyword :credit-card-type)
                (document-keyword :credit-card-number) (document-keyword :reference)
                (document-keyword :file) (document-keyword :ssh-key)
                (document-keyword :sso-login) (document-keyword :unknown)))

(defn sensitive-types [] :document
  (document-set (document-keyword :concealed) (document-keyword :totp)
                (document-keyword :credit-card-number) (document-keyword :ssh-key)
                (document-keyword :unknown)))

(defn login-field-designations [] :document
  (document-set (document-keyword :username) (document-keyword :password)))

(defn- in-set [s :document t :keyword] :bool
  (document-set-contains? s (document-keyword t)))

(defn sensitive? [field-type :keyword] :bool
  (or (in-set (sensitive-types) field-type)
      (not (in-set (value-types) field-type))))

(defn classification [field-type :keyword] :keyword
  (cond
    (in-set (sensitive-types) field-type) :restricted
    (in-set (value-types) field-type) :internal
    :else :restricted))

(defn- type-of-name-a [n :string] :keyword
  (cond
    (string=? n "string") :string
    (string=? n "concealed") :concealed
    (string=? n "email") :email
    (string=? n "url") :url
    (string=? n "totp") :totp
    (string=? n "phone") :phone
    (string=? n "date") :date
    (string=? n "monthYear") :month-year
    (string=? n "gender") :gender
    (string=? n "menu") :menu
    :else :unknown))

(defn- type-of-name-b [n :string] :keyword
  (cond
    (string=? n "address") :address
    (string=? n "creditCardType") :credit-card-type
    (string=? n "creditCardNumber") :credit-card-number
    (string=? n "reference") :reference
    (string=? n "file") :file
    (string=? n "sshKey") :ssh-key
    (string=? n "ssoLogin") :sso-login
    :else :unknown))

(defn- type-of-name [n :string] :keyword
  (let [t (type-of-name-a n)]
    (if (= t :unknown) (type-of-name-b n) t)))

(defn- key-text [k :document] :string
  (if (= (document-kind k) :string)
    (option-value-of [:option :string] (document-string-value k) "")
    (if (= (document-kind k) :keyword)
      (let [text (document-edn-print k)]
        (string-substring text 1 (string-length text)))
      "")))

(defn value-type [vm :document] :keyword
  (if (and (= (document-kind vm) :map) (= (document-count vm) 1))
    (let [entry (option-value-of [:option :document] (document-map-entry-at vm 0) (document-vector))
          k (option-value-of [:option :document] (document-vector-at entry 0) (document-null))]
      (type-of-name (key-text k)))
    :unknown))
