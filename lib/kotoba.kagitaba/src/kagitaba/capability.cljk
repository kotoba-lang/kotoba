(ns kagitaba.capability
  "provider 中立の「何をしたいか」(ADR-0002)。

  ```clojure
  {:capability/provider  :github
   :capability/access    {:contents :read :metadata :read}  ; 権限 → 水準
   :capability/resources [\"cloud-itonami/*\"]}               ; repo 等のパターン
  ```

  水準は全順序 `:none < :read < :write < :admin`。権限名は provider の語彙を
  そのまま使い、kagitaba は翻訳しない(GitHub の `contents` `pull_requests` …)。

  resource パターン: `*` は全て、`org/*` は org 直下の全て、それ以外は完全一致。
  resource が空の capability は「その provider の範囲全部」を意味するので、
  それを覆えるのは `*` を持つ capability だけ。

  時計・IO を持たない純 `.cljc`。"
  (:require [kotoba.lang.text :as str]))

(def levels
  "低い順。"
  [:none :read :write :admin])

(def ^:private rank (zipmap levels (range)))

(defn level? [x] (contains? rank x))

(defn level-covers?
  "granted の水準が wanted 以上か。未知の水準は覆わない(黙って通さない)。"
  [granted wanted]
  (and (level? granted) (level? wanted) (>= (rank granted) (rank wanted))))

(defn resource-matches?
  "パターン `*` / `org/*` / 完全一致。"
  [pattern resource]
  (cond
    (not (and (string? pattern) (string? resource))) false
    (= pattern "*") true
    (str/ends-with? pattern "/*") (let [prefix (subs pattern 0 (dec (count pattern)))]
                                    (and (str/starts-with? resource prefix)
                                         (not (str/blank? (subs resource (count prefix))))
                                         (not (str/includes? (subs resource (count prefix)) "/"))))
    :else (= pattern resource)))

(defn- valid-resource? [resource]
  (and (string? resource)
       (not (str/blank? resource))
       (not (str/starts-with? resource "/"))
       (not (str/ends-with? resource "/"))
       (not (str/includes? resource "//"))
       (or (= "*" resource)
           (let [parts (str/split resource #"/")
                 account (first parts)
                 repo (second parts)]
             (and (= 2 (count parts))
                  (not (str/blank? account))
                  (not (str/blank? repo))
                  (not (str/includes? account "*"))
                  (or (= "*" repo)
                      (not (str/includes? repo "*"))))))))

(defn- resource-covered? [granted-patterns resource]
  (some #(resource-matches? % resource) granted-patterns))

(defn excess
  "wanted のうち granted に覆われない部分を理由のベクタで返す(空なら覆われる)。
  理由は agent が範囲を絞り直せるよう具体的に書く。"
  [granted wanted]
  (let [g-access (:capability/access granted {})
        g-res (:capability/resources granted [])
        w-res (:capability/resources wanted [])]
    (vec
     (concat
      (when (not= (:capability/provider granted) (:capability/provider wanted))
        [{:reason :provider :wanted (:capability/provider wanted)
          :granted (:capability/provider granted)}])
      (for [[perm level] (sort-by key (:capability/access wanted {}))
            :let [have (get g-access perm :none)]
            :when (not (level-covers? have level))]
        {:reason :permission :permission perm :wanted level :granted have})
      (if (empty? w-res)
        (when-not (some #{"*"} g-res)
          [{:reason :resource :wanted :all :granted (vec g-res)}])
        (for [r w-res :when (not (resource-covered? g-res r))]
          {:reason :resource :wanted r :granted (vec g-res)}))))))

(defn covers?
  "granted が wanted を完全に覆うか。"
  [granted wanted]
  (empty? (excess granted wanted)))

(defn valid?
  [cap]
  (and (map? cap)
       (keyword? (:capability/provider cap))
       (map? (:capability/access cap {}))
       (seq (:capability/access cap))
       (every? keyword? (keys (:capability/access cap)))
       (every? level? (vals (:capability/access cap)))
       (sequential? (:capability/resources cap []))
       (every? valid-resource? (:capability/resources cap []))))
