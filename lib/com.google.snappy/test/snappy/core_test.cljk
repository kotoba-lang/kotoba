(ns snappy.core-test
  "Structure and round-trips. What these cannot tell you is whether the bytes
  are snappy -- a compressor and a decompressor that share a misunderstanding
  round-trip perfectly, and snappy makes that quiet because a stream with a
  wrong copy offset still decodes, into different bytes.

  `test/fixtures/verify_with_cramjam.py` is the oracle that answers that, in
  both directions. It has been shown to fail: adding one to every copy offset
  makes cramjam reject five of the nine cases outright."
  (:require [clojure.test :refer [deftest is testing]]
            [snappy.core :as s]))

(defn- roundtrip [v] (s/decompress (s/compress v)))

(deftest empty-input-is-a-length-and-nothing-else
  (is (= [0] (s/compress [])))
  (is (= [] (s/decompress (s/compress [])))))

(deftest round-trips
  (testing "the shapes that exercise different element encodings"
    (doseq [[nm v] [["one byte" [120]]
                    ["short literal" (mapv int "hello")]
                    ["literal needing a 1-byte length" (vec (range 100))]
                    ["literal needing a 2-byte length" (vec (repeatedly 400 #(rand-int 256)))]
                    ["long run" (vec (repeat 500 65))]
                    ["overlapping run" (vec (take 600 (cycle [97 98])))]
                    ["copy over 64 bytes" (vec (concat (range 200) (range 200)))]]]
      (is (= v (roundtrip v)) nm))))

(deftest it-actually-compresses
  (testing "a stream of literals is valid, decodes, and is worthless"
    (let [run (vec (repeat 500 65))
          text (vec (mapcat #(map int %) (repeat 40 "the quick brown fox ")))]
      (is (< (count (s/compress run)) (/ (count run) 10)))
      (is (< (count (s/compress text)) (/ (count text) 5))))))

(deftest incompressible-input-grows-only-by-the-tags
  (let [v (vec (repeatedly 2000 #(rand-int 256)))
        c (s/compress v)]
    (is (< (count c) (+ (count v) 20)))))

(deftest the-preamble-is-the-uncompressed-length
  (doseq [n [0 1 127 128 300 100000]]
    (let [v (vec (repeat n 7))
          c (s/compress v)]
      (is (= n (count (s/decompress c))) (str "length " n)))))

(deftest a-declared-length-that-disagrees-is-refused
  (testing "the stream and the caller's metadata describing different things"
    (let [c (s/compress (vec (repeat 10 1)))]
      (is (thrown? #?(:clj Exception :cljs js/Error)
                   (s/decompress c 0 (count c) 999))))))

(deftest a-copy-offset-outside-the-output-is-refused
  (testing "rather than reading whatever is at a negative index"
    ;; length 5, then a 2-byte-offset copy naming offset 99 with nothing behind it
    (is (thrown? #?(:clj Exception :cljs js/Error)
                 (s/decompress [5 (bit-or 2 (bit-shift-left 4 2)) 99 0])))))

(deftest output-is-unsigned-bytes
  (let [v (vec (repeat 300 255))]
    (is (every? #(<= 0 % 255) (s/compress v)))
    (is (every? #(<= 0 % 255) (roundtrip v)))))
