;; This repository's entry in the kotoba.repository-role-rules taxonomy.
;; Authority for the vocabulary is the superproject's
;; manifest/repository-rules.edn (ADR-2607299000).
{:schema "kotoba.repository-role-rules.v0"
 :this-repo
 {:name "torihiki-terminal"
  ;; Role suffix rather than a prefix: the short name `torihiki` is taken by
  ;; the engine, and AGENTS.md's naming rule says to add a role
  ;; (cf. kami-engine-guest) rather than a language or a generic word.
  :prefix nil
  :role :application
  :execution :none
  :must [:read-a-live-node :state-that-it-is-a-sequencer :show-when-disconnected]
  :must-not [:mock-market-data :reimplement-engine-logic :render-twice
             :require-liquid-glass-directly]
  :depends-on ["kotoba-lang/kotoba-ui" "kotoba-lang/torihiki-node"]}}
