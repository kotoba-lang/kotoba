;; The suite's driver: `driver E|B PATTERN` reads one line on standard input
;; and prints what /usr/bin/grep -ob would print for its first match --
;; `offset:match` -- then a second line, `M` or `-`, for whether the line
;; matched at all (grep -o skips empty matches; the exit status does not).
;; A match the literal prefilter would have skipped exits 3 by name.
(ns driver.core (:export [main]) (:require [regex.core :as rx]))

(defn arg [i :string] :string (typed-cap-call :cli/args :string :string i))
(defn emit [s :string] :string (typed-cap-call :io/write :string :string s))
(defn stdin [n :string] :string (typed-cap-call :io/read :string :string n))
(defn nl [] :string "\n")

(defn digit-text [d :i64] :string (string-substring "0123456789" d (+ d 1)))
(defn decimal-of [n :i64] :string
  (if (< n 10) (digit-text n) (string-concat (decimal-of (quot n 10)) (digit-text (- n (* 10 (quot n 10)))))))

;; `driver EC|BC PATTERN` prints the groups of the first match instead:
;; ten `start:end;` tokens (byte offsets into the line), or `-` for no
;; match, or `!` when the span could not be re-walked.
(defn- captures-mode [] :i64
  (let [prog (rx/compile-pattern (arg "1") (= (string-code-point-at (arg "0") 0) 69))]
    (if (rx/error? prog)
      (do (emit prog) (emit (nl)) 2)
      (let [text (stdin "")
            n (string-byte-length text)
            hi (let [k (string-find-byte text 10 0)] (if (< k 0) n k))
            r (rx/find prog text 0 0 hi)]
        (if (< r 0)
          (do (emit "-") (emit (nl)) 1)
          (do (emit (rx/captures prog text 0 hi r)) (emit (nl)) 0))))))

(defn main [] :i64
  (if (= 2 (string-byte-length (arg "0")))
    (captures-mode)
    (main-find)))

(defn- main-find [] :i64
  (let [prog (rx/compile-pattern (arg "1") (string=? (arg "0") "E"))]
    (if (rx/error? prog)
      (do (emit prog) (emit (nl)) 2)
      (let [text (stdin "")
            n (string-byte-length text)
            hi (let [k (string-find-byte text 10 0)] (if (< k 0) n k))
            r (rx/find prog text 0 0 hi)]
        (if (< r 0)
          (do (emit "-") (emit (nl)) 1)
          ;; A matching line the prefilter would have skipped is the one
          ;; unsoundness the prefilter can have; named, exit 3.
          (if (unsound? (rx/prefilter (arg "1") (string=? (arg "0") "E")) (string-substring text 0 hi))
            (do (emit "PREFILTER-UNSOUND") (emit (nl)) 3)
            (do (first-nonempty prog text 0 hi)
                (emit "M") (emit (nl))
                0)))))))

(defn- unsound? [runs :string line :string] :bool
  (if (= 0 (string-byte-length runs)) false (not (rx/holds-run? line runs 0))))

;; As grep -o: the first NON-EMPTY match, searching on past an empty one.
(defn- cp-width [c :i64] :i64
  (if (< c 128) 1 (if (< c 2048) 2 (if (< c 65536) 3 4))))

(defn- first-nonempty [prog :string text :string from :i64 hi :i64] :i64
  (if (> from hi)
    0
    (let [r (rx/find prog text 0 from hi)]
      (if (< r 0)
        0
        (let [s (quot r 4294967296)
              e (- r (* 4294967296 (quot r 4294967296)))]
          (if (> e s)
            (do (emit (decimal-of s)) (emit ":") (emit (string-substring text s e)) (emit (nl)) 0)
            (if (>= s hi)
              0
              (first-nonempty prog text (+ s (cp-width (string-code-point-at text s))) hi))))))))
