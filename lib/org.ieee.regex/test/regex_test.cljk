;; test/regex_test.cljk -- compile the driver (which links regex.core),
;; package it, and compare its first match on each (pattern, line) against
;; /usr/bin/grep -ob (POSIX leftmost-longest, byte offsets).
;;
;;   AMU_HOME=<amu checkout> kbb --backend sci test/regex_test.cljk
(ns regex-test
  (:require [clojure.string :as str] ["fs" :as fs] ["path" :as path] ["os" :as os]))

(def cp (js/require "node:child_process"))

(defn- run [cmd args opts]
  (let [r (.spawnSync cp cmd (clj->js args) (clj->js (merge {:encoding "utf8"} opts)))]
    {:status (.-status r) :out (or (.-stdout r) "") :err (or (.-stderr r) "")}))

(defn- refuse [message]
  (println (pr-str {:ok false :phase :setup :message message}))
  (.exit js/process 2))

(def amu-home
  (or (.-AMU_HOME js/process.env)
      (let [guess (.resolve path (.cwd js/process) ".." ".." "kotoba-lang" "amu")]
        (when (.existsSync fs (.join path guess "bin" "amu")) guess))))

;; [dialect pattern line]. The measured shapes first (alternation of words,
;; anchored alternation, +, ., *, ?, intervals, [:space:]), then each
;; construct's edges.
(def cases
  [["E" "foo|bar" "xx bar foo"] ["E" "^foo |bar" "foo bar"] ["E" "^(foo|bar)" "barfoo"] ["E" "^(foo|bar)" "xbar"]
   ["E" "a|ab" "ab"] ["E" "ab|a" "ab"] ["E" "(a|ab)(c|bcd)" "abcd"] ["E" "x+" "axxxb"] ["E" "x+" "ab"]
   ["E" "a.c" "abc"] ["E" "a.c" "a日c"] ["E" "a.*c" "abcabc"]
   ["E" "colou?r" "the color"] ["E" "colou?r" "the colour"] ["E" "ab*c" "ac"] ["E" "ab*c" "abbbc"]
   ["E" "a{2}" "caaab"] ["E" "a{2,}" "caaab"] ["E" "a{1,2}" "caaab"] ["E" "a{0,1}b" "b"]
   ["E" "[0-9]+" "abc 123 45"] ["E" "[^0-9]+" "123 abc"] ["E" "[a-c]" "xxbx"] ["E" "[]a]" "x]"] ["E" "[^]a]" "]a b"]
   ["E" "[[:space:]]+" "a  \tb"] ["E" "[[:digit:][:alpha:]]+" "-- ab12 --"] ["E" "[[:upper:]]" "abcDef"]
   ["E" "^$" "\n"] ["E" "^$" "x"] ["E" "^abc$" "abc"] ["E" "^abc$" "abcd"] ["E" "c$" "abc"] ["E" "^" "abc"]
   ["E" "\\." "a.b"] ["E" "a\\|b" "a|b"] ["E" "\\(x\\)" "(x)"] ["E" "\\$" "a$b"] ["E" "\\\\" "a\\b"]
   ["E" "\\d+" "ab 42"] ["E" "\\w+" "  hello_1 "] ["E" "\\s+" "a  b"] ["E" "\\bis\\b" "this is it"] ["E" "\\Bis" "this is"]
   ["E" "(a|b)*c" "ababc"] ["E" "(ab)+" "xababx"] ["E" "(a*)*b" "aaab"] ["E" "(a*)*b" "aaaa"]
   ["E" "日本" "x日本語"] ["E" "[あ-ん]+" "abあいうc"] ["E" "." "日"]
   ["E" "()" "abc"]
   ;; BRE: * is a quantifier; + ? ( ) { } | are literals unless escaped.
   ["B" "a*b" "caab"] ["B" "a+b" "a+b"] ["B" "a+b" "aab"] ["B" "a\\+b" "aab"] ["B" "(x)" "(x)"] ["B" "\\(x\\)" "x"]
   ["B" "a\\|b" "b"] ["B" "a|b" "a|b"] ["B" "a\\{2\\}" "aaa"] ["B" "a{2}" "a{2}"] ["B" "a\\?b" "b"]
   ["B" "^foo" "foo"] ["B" "foo$" "xfoo"] ["B" "[0-9]*" "abc12"] ["B" "\\." "a.b"]
   ;; BRE context (2026-09-17): `^` `$` `*` literal where they cannot anchor
   ;; or repeat, an anchor after `\(` / `\|` and before `\)`; `\t` a tab.
   ["B" "a^b" "xa^b"] ["B" "a$b" "xa$b"] ["B" "*b" "a*b"] ["B" "^*b" "**b"] ["B" "^*b" "*b"] ["B" "\\(*b\\)" "a*b"]
   ["B" "\\(^b\\)" "b"] ["B" "\\(^b\\)" "xb"] ["B" "a\\|^b" "xb"] ["B" "a\\|^b" "b"]
   ["B" "b$\\|x" "ab$"] ["B" "x\\|b$" "ab"] ["B" "\\(b$\\)" "ab"] ["B" "\\(b$\\)" "ab$"]
   ["B" "a\\tb" "a\tb"] ["B" "a\\tb" "atb"] ["B" "ab\\{0,1\\}c" "ac"] ["E" "ab?c" "ac"] ["E" "ab{0,1}c" "ac"] ["E" "(ab|cd)e" "xcde"] ["E" "a\\tb" "a\tb"] ["E" "a^b" "a^b"] ["E" "a$b" "a$b"]])

;; Capture groups (2026-09-17): the groups of the first match as byte
;; offsets, each expectation measured on /usr/bin/sed -E (BRE: sed) with
;; `s/RE/[\1][\2]/` -- macOS libc regex's greedy-first answers, which the
;; backtracking walk reproduces: `(a|ab)(c|bcd)` over abcd is [a][bcd].
(def capture-cases
  [["EC" "(a|ab)(c|bcd)" "abcd" "0:4;0:1;1:4;"]
   ["EC" "(x*)(.*)" "xyz" "0:3;0:1;1:3;"]
   ["EC" "(a*)(a*)" "aaa" "0:3;0:3;3:3;"]
   ["EC" "(a)|(b)" "ab" "0:1;0:1;-1:-1;"]
   ["EC" "(a)|(b)" "b" "0:1;-1:-1;0:1;"]
   ["EC" "(a)(b)?" "ab" "0:2;0:1;1:2;"]
   ["EC" "(a)(b)?" "ac" "0:1;0:1;-1:-1;"]
   ["EC" "(ab)*" "abab" "0:4;2:4;"]
   ["EC" "((a)b)" "ab" "0:2;0:2;0:1;"]
   ["EC" "(a)+" "aa" "0:2;1:2;"]
   ["EC" "^(FAIL|ERROR) in \\(([^)]*)\\) \\(([^:]*):.*" "FAIL in (x) (f:1) rest" "0:22;0:4;9:10;13:14;"]
   ["EC" "(sk_live_|sk_test_)[A-Za-z0-9_]+" "sk_live_abcdef123" "0:17;0:8;"]
   ["EC" "([a-z0-9])([A-Z])" "fooBarBaz" "2:4;2:3;3:4;"]
   ["EC" "[(]a(b)" "(ab" "0:3;2:3;"]
   ["EC" "(日)(本)" "x日本" "1:7;1:4;4:7;"]
   ["EC" "b" "abc" "1:2;"]
   ["BC" ".*\"\\(.*\\)\"" "foo \"bar\" baz" "0:9;5:8;"]
   ["BC" ".*:offset \\([0-9]*\\).*" ":offset 42 x" "0:12;8:10;"]
   ["BC" "\\(a\\)\\(b\\)" "ab" "0:2;0:1;1:2;"]
   ["EC" "(a*)*b" "aaab" "0:4;0:3;"]])

;; Patterns that must be refused (grep's own message differs; the exit 2 is
;; what is compared, the message is ours).
(def refusals
  [["E" "(" "x"] ["E" "a)" "x"] ["E" "a||b" "x"] ["E" "|b" "x"] ["E" "a|" "x"] ["E" "[a" "x"] ["E" "*a" "x"] ["E" "a{3,1}" "x"] ["E" "[[:nope:]]" "x"] ["E" "a\\" "x"]])

(when-not amu-home (refuse "set AMU_HOME to an amu checkout"))
(let [amu (.join path amu-home "bin" "amu")
      packager (.join path amu-home "scripts" "package-command.cljk")
      kbb (.join path amu-home "bin" "kbb")
      root (.resolve path (.cwd js/process))]
  (when-not (.existsSync fs amu) (refuse (str "no amu at " amu)))
  (let [tmp (.mkdtempSync fs (.join path (.tmpdir os) "org-ieee-regex-"))
        src (.join path root "test" "driver.kotoba")
        policy (.join path tmp "policy.edn")
        kexe (.join path tmp "driver.kexe")
        blob (.join path tmp "driver.bin")
        exe (.join path tmp "driver")]
    (.writeFileSync fs policy "{:allow #{[:cap/call 37] [:cap/call 38] [:cap/call 41]}}" "utf8")
    (let [c (run "node" [amu "compile" src "--source-path" root "--source-path" (.join path root "test")
                         "--target" "aarch64-macos" "--jvm-free" "--policy" policy "--output" kexe] {})]
      (when (not= 0 (:status c)) (refuse (str "compile failed: " (:err c) (:out c)))))
    (let [e (run "node" [amu "extract-native" kexe "--symbol" "main" "--output" blob] {})
          _ (when (not= 0 (:status e)) (refuse (str "extract failed: " (:err e))))
          offset (second (re-find #":offset (\d+)" (:out e)))]
      (when-not offset (refuse "no :offset in the extract report"))
      (let [p (run "node" [kbb "--backend" "sci" packager "--code" blob "--offset" offset "--isa" "aarch64"
                           "--allow" "37,38,41" "--fuel" "4000000000" "--pairs" "4000000" "--string-pool" "64000000"
                           "--output" exe] {})]
        (when (not= 0 (:status p)) (refuse (str "package failed: " (:err p))))))
    (let [results
          (for [[d pat line] cases]
            (let [k (run exe [d pat] {:input line})
                  flag (if (= d "E") "-E" "-G")
                  g (run "/usr/bin/grep" [flag "-ob" "--" pat] {:input line})
                  gm (run "/usr/bin/grep" [flag "-c" "--" pat] {:input line})
                  want (str (first (str/split-lines (:out g))) "\n" (if (= 0 (:status gm)) "M" "-") "\n")
                  want (if (str/starts-with? want "\n") (subs want 1) want)
                  same? (and (= (:out k) want) (= (:status k) (if (= 0 (:status gm)) 0 1)))]
              {:case [d pat line] :ok same? :kotoba (:out k) :system want :exit [(:status k) (:status gm)]}))
          refusal-results
          (for [[d pat line] refusals]
            (let [k (run exe [d pat] {:input line})
                  ok? (and (= 2 (:status k)) (str/starts-with? (:out k) "!"))]
              {:case [d pat line :refused] :ok ok? :kotoba (:out k) :system "(exit 2, ! message)" :exit [(:status k) 2]}))
          capture-results
          (for [[d pat line want] capture-cases]
            (let [k (run exe [d pat] {:input line})
                  ;; the expectation lists the groups the pattern has; the
                  ;; driver pads to ten with -1:-1
                  want-full (str want (apply str (repeat (- 10 (count (re-seq #";" want))) "-1:-1;")) "\n")
                  ok? (and (= 0 (:status k)) (= (:out k) want-full))]
              {:case [d pat line] :ok ok? :kotoba (:out k) :system want-full :exit [(:status k) 0]}))
          all (concat results refusal-results capture-results)
          bad (remove :ok all)]
      (doseq [r all]
        (println (str (if (:ok r) "  ok   " "  FAIL ") (pr-str (:case r)) " -> " (pr-str (:kotoba r))
                      (when-not (:ok r) (str " but grep says " (pr-str (:system r)) " exits " (pr-str (:exit r)))))))
      (println (pr-str {:ok (empty? bad) :cases (count all) :failed (count bad)}))
      (.exit js/process (if (seq bad) 1 0)))))
