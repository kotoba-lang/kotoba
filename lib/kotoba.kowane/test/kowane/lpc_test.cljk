(ns kowane.lpc-test
  (:require [kotoba.test :refer [deftest is testing]]
            [kowane.lpc :as lpc]))

(defn- vowel
  "A synthetic vowel: a 125 Hz glottal pulse train through two formant
  resonators (≈700 Hz and ≈1200 Hz, an /a/), at 8 kHz."
  [n]
  (let [res (fn [xs f bw]
              (let [r (Math/exp (/ (* -1 Math/PI bw) 8000))
                    c (* 2 r (Math/cos (/ (* 2 Math/PI f) 8000)))]
                (loop [i 0 y1 0.0 y2 0.0 out []]
                  (if (= i (count xs)) out
                      (let [y (+ (nth xs i) (* c y1) (* -1 r r y2))]
                        (recur (inc i) y y1 (conj out y)))))))
        pulses (mapv #(if (zero? (rem % 64)) 2000.0 0.0) (range n))]
    (-> pulses (res 700 90) (res 1200 110))))

(defn- noise [n] (let [s (atom 7)] (vec (repeatedly n #(- (rem (swap! s (fn [x] (rem (+ (* x 1103515245) 12345) 2147483648))) 2000) 1000)))))

(defn- rms [xs] (Math/sqrt (/ (reduce + (map #(* % %) xs)) (max 1 (count xs)))))

(deftest levinson-test
  (testing "an AR(1) process with coefficient 0.8 has k1 ≈ 0.8"
    (let [r (mapv #(Math/pow 0.8 %) (range 11))
          {:keys [k]} (lpc/levinson r 10)]
      (is (< 0.79 (first k) 0.81))
      (is (every? #(< (Math/abs %) 1e-6) (rest k))))))

(deftest bitrate-test
  (let [x (vowel 1600)]
    (is (= 60 (count (lpc/encode :lpc-2400 x))) "10 frames × 6 bytes = 2400 bit/s over 0.2 s")
    (is (= 30 (count (lpc/encode :lpc-1200 x))) "5 frames × 6 bytes = 1200 bit/s")))

(deftest pack-test
  (let [q {:pitch 45 :gain 17 :k [1 30 7 8 15 3 4 5 1 2]}]
    (is (= q (lpc/unpack (lpc/pack q))))
    (is (= 6 (count (lpc/pack q))))))

(deftest analysis-test
  (let [p (lpc/analyse (subvec (vowel 480) 160 320))]
    (testing "a 125 Hz vowel is voiced with a 64-sample period"
      (is (some? (:pitch p)))
      (is (<= 62 (:pitch p) 66)))
    (testing "noise is unvoiced"
      (is (nil? (:pitch (lpc/analyse (noise 160))))))))

(deftest round-trip-test
  (let [x (vowel 1600)
        [_ y] (lpc/decode :lpc-2400 (lpc/encode :lpc-2400 x))]
    (is (= 1600 (count y)))
    (testing "the decoded vowel keeps its loudness within a factor of three"
      (let [ratio (/ (rms (drop 320 y)) (rms (drop 320 x)))]
        (is (< 0.33 ratio 3.0) (str "ratio " ratio))))
    (testing "silence decodes to near silence"
      (let [[_ s] (lpc/decode :lpc-2400 (lpc/encode :lpc-2400 (vec (repeat 320 0))))]
        (is (< (rms s) 5))))))
