;; No dependencies. A CoAP message is a 4-byte header, a token, a run of
;; delta-encoded options, and an optional payload — none of it needs
;; anything beyond core Clojure, and pulling in a CoAP client/server
;; library to write a codec would defeat the point, which is a codec this
;; workspace's other runtimes (cljs, nbb) can load without a JVM.
{:deps {
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}}
 :paths ["src"]
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  :cljs {:extra-paths ["test"]}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
