;; Port of coap.code (code.cljk), Kotoba-native, :document values.
;;
;; Named divergences from code.cljk:
;;   - code-names is the table as a :document vector of [class detail name]
;;     triples (canonical EDN text), not a map.
;;   - name->code is a lookup function returning the [class detail] vector,
;;     or document-null for an unknown name (the source's inverse map).
;;   - class-detail and decode use quot for the 8-bit byte. The source's
;;     unsigned shift differs only for negative inputs, which are outside the
;;     wire byte range (0..255) and are not modelled.
;;   - decode's :name is document-null for an unnamed class.detail (as nil).

(ns coap.code
  (:export [code-names name->code class-detail ->byte encode decode]))

(defn- null-doc? [d :document] :bool
  (string=? (document-edn-print d) (document-edn-print (document-null))))

(defn code-names [] :document
  (document-edn-read "[[0 0 :empty] [0 1 :get] [0 2 :post] [0 3 :put] [0 4 :delete] [2 1 :created] [2 2 :deleted] [2 3 :valid] [2 4 :changed] [2 5 :content] [4 0 :bad-request] [4 1 :unauthorized] [4 2 :bad-option] [4 3 :forbidden] [4 4 :not-found] [4 5 :method-not-allowed] [4 6 :not-acceptable] [4 12 :precondition-failed] [4 13 :request-entity-too-large] [4 15 :unsupported-content-format] [5 0 :internal-server-error] [5 1 :not-implemented] [5 2 :bad-gateway] [5 3 :service-unavailable] [5 4 :gateway-timeout] [5 5 :proxying-not-supported]]"))

(defn- entry-at [i :i64] :document
  (option-value-of [:option :document] (document-vector-at (code-names) i) (document-null)))

(defn- entry-part [e :document j :i64] :document
  (option-value-of [:option :document] (document-vector-at e j) (document-null)))

(defn- entry-int [e :document j :i64] :i64
  (option-value-of [:option :i64] (document-i64-value (entry-part e j)) 0))

(defn- find-entry [c :i64 d :i64] :document
  (loop [i 0]
    (if (< i (document-count (code-names)))
      (if (and (= (entry-int (entry-at i) 0) c) (= (entry-int (entry-at i) 1) d))
        (entry-at i)
        (recur (+ i 1)))
      (document-null))))

(defn- find-name [kw :document] :document
  (loop [i 0]
    (if (< i (document-count (code-names)))
      (if (document-equal? (entry-part (entry-at i) 2) kw)
        (document-vector (document-i64 (entry-int (entry-at i) 0))
                         (document-i64 (entry-int (entry-at i) 1)))
        (recur (+ i 1)))
      (document-null))))

(defn name->code [kw :document] :document
  (find-name kw))

(defn class-detail [byte :i64] :document
  (document-vector (document-i64 (bit-and (quot byte 32) 7))
                   (document-i64 (bit-and byte 31))))

(defn ->byte [c :i64 d :i64] :i64
  (+ (* (bit-and c 7) 32) (bit-and d 31)))

(defn encode [kw :document] :document
  (let [cd (name->code kw)]
    (if (null-doc? cd)
      (document-map :status (document-keyword :error)
                    :reason (document-keyword :unknown-code-name)
                    :name kw)
      (document-map :status (document-keyword :ok)
                    :byte (document-i64 (->byte (entry-int cd 0) (entry-int cd 1)))))))

(defn decode [byte :i64] :document
  (let [c (bit-and (quot byte 32) 7)
        d (bit-and byte 31)
        e (find-entry c d)]
    (document-map :status (document-keyword :ok)
                  :class (document-i64 c)
                  :detail (document-i64 d)
                  :name (if (null-doc? e) (document-null) (entry-part e 2)))))
