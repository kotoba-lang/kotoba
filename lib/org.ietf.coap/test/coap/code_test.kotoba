(ns coap.code-test (:export [main]) (:require [coap.code :as p]))

(defn- fedn [d :document k :keyword] :string
  (document-edn-print (option-or (document-get d k) (document-null))))

(defn- fint [d :document k :keyword] :i64
  (option-value-of [:option :i64] (document-i64-value (option-or (document-get d k) (document-null))) -1))

(defn- byte-of [kw :document] :i64
  (fint (p/encode kw) :byte))

(defn main [] :i64
  (+ (if (= (byte-of (document-keyword :get)) 1) 0 1)
     (if (= (byte-of (document-keyword :created)) 65) 0 1)
     (if (= (byte-of (document-keyword :content)) 69) 0 1)
     (if (= (byte-of (document-keyword :internal-server-error)) 160) 0 1)
     (if (= (byte-of (document-keyword :empty)) 0) 0 1)
     (if (string=? (fedn (p/encode (document-keyword :bogus)) :status) ":error") 0 1)
     (if (string=? (fedn (p/decode 69) :name) ":content") 0 1)
     (if (string=? (fedn (p/decode 69) :status) ":ok") 0 1)
     (if (= (fint (p/decode 69) :class) 2) 0 1)
     (if (= (fint (p/decode 69) :detail) 5) 0 1)
     (if (string=? (fedn (p/decode 0) :name) ":empty") 0 1)
     (if (string=? (fedn (p/decode 31) :name) "nil") 0 1)
     (if (string=? (fedn (p/decode 32) :name) "nil") 0 1)
     (if (= (fint (p/decode 32) :class) 1) 0 1)
     (if (= (p/->byte 5 0) 160) 0 1)
     (if (= (document-count (p/code-names)) 26) 0 1)
     (if (document-equal? (p/name->code (document-keyword :bogus)) (document-null)) 0 1)))
