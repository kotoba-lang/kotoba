{:schema "kotoba.connector.repository.v1",
 :connector/docs-url "https://learn.microsoft.com/graph/api/overview",
 :connector/origin-domain "microsoft.com",
 :connector/base-scopes ["openid" "email" "profile" "offline_access"],
 :connector/id "com.microsoft.graph",
 :connector/var "provider",
 :connector/scopes
 ["Calendars.Read"
  "Mail.Read"
  "Mail.Send"
  "User.Read"
  "email"
  "offline_access"
  "openid"
  "profile"],
 :authority
 "90-docs/adr/2608097000-connector-plane-one-repo-per-connector.edn",
 :connector/namespace "microsoft-graph.connector",
 :connector/auth-kind :oauth2,
 :connector/auth-pkce? true,
 :connector/summary
 "Mail and calendar on Microsoft 365, through Microsoft Graph.",
 :connector/name "Microsoft 365",
 :connector/client-id-env "M365_CLIENT_ID",
 :connector/tools
 [{:connector/name "microsoft_graph_get_message",
   :connector/effect :read,
   :connector/scopes ["Mail.Read"],
   :connector/description "One message, with its body."}
  {:connector/name "microsoft_graph_get_profile",
   :connector/effect :read,
   :connector/scopes ["User.Read"],
   :connector/description
   "The signed-in account: display name, mail address, time zone."}
  {:connector/name "microsoft_graph_get_schedule",
   :connector/effect :read,
   :connector/scopes ["Calendars.Read"],
   :connector/description
   "Free/busy for one or more addresses. Returns availability only — no titles or attendees."}
  {:connector/name "microsoft_graph_list_events",
   :connector/effect :read,
   :connector/scopes ["Calendars.Read"],
   :connector/description "Calendar events in a time window."}
  {:connector/name "microsoft_graph_list_messages",
   :connector/effect :read,
   :connector/scopes ["Mail.Read"],
   :connector/description
   "Messages in the mailbox, newest first. `search` uses Graph's $search."}
  {:connector/name "microsoft_graph_send_mail",
   :connector/effect :write,
   :connector/scopes ["Mail.Send"],
   :connector/description "Send a message as the signed-in account."}]}
