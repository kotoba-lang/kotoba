;; Port of kotoba.fmt.emit-scalar (emit_scalar.cljk), Kotoba-native.
;;
;; The input is a :document value; the result is its EDN text. nil prints
;; "nil", a string prints quoted, a keyword prints ":ns/name", a number or
;; boolean prints as itself, as the source's pr-str / str branches do.
;;
;; Named divergences from emit_scalar.cljk:
;;   - there is no char value in :document, so the char branch does not exist.
;;   - a non-scalar document (vector, map) prints as EDN, not as the Clojure str.

(ns kotoba.fmt.emit-scalar
  (:export [emit-scalar]))

(defn emit-scalar [x :document] :string
  (document-edn-print x))
