(ns kotoba.fmt.format
  "format -- addressed on its own.

  Split out of kotoba.lang.fmt on 2026-09-09 (ADR-2609091200). The unit
  here is the DEFINITION, and this repo's deps.edn names exactly the
  definitions it reaches -- nothing else.
"
  (:refer-clojure :exclude [format])
  (:require [kotoba.lang.edn :as edn]
            [kotoba.fmt.default-opts :refer [default-opts]]
            [kotoba.fmt.format-str :refer [format-str]])
)

(defn format
  "Format an EDN *string* `s`: parse it then re-emit canonically. Returns the
  canonical EDN string. Throws if `s` is not valid EDN."
  ([s] (format s default-opts))
  ([s opts]
   (let [data (edn/read-string {:default (fn [_t v] v)} s)]
     (format-str data opts))))
