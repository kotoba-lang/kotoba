(ns kotoba.fmt.format-str
  "format-str -- addressed on its own.

  Split out of kotoba.lang.fmt on 2026-09-09 (ADR-2609091200). The unit
  here is the DEFINITION, and this repo's deps.edn names exactly the
  definitions it reaches -- nothing else.
"
  (:require [kotoba.fmt.default-opts :refer [default-opts]]
            [kotoba.fmt.emit :refer [emit]])
)

(defn format-str
  "Format Clojure data `x` as canonical EDN. Options: `:indent` (default 2),
  `:margin` (default 80)."
  ([x] (format-str x default-opts))
  ([x opts] (emit x 0 (merge default-opts opts))))
