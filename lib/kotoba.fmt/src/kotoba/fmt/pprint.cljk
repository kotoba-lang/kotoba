(ns kotoba.fmt.pprint
  "pprint -- addressed on its own.

  Split out of kotoba.lang.fmt on 2026-09-09 (ADR-2609091200). The unit
  here is the DEFINITION, and this repo's deps.edn names exactly the
  definitions it reaches -- nothing else.
"
  (:require [kotoba.fmt.default-opts :refer [default-opts]]
            [kotoba.fmt.pprint-str :refer [pprint-str]])
)

(defn pprint
  "Pretty-print `x` to stdout, followed by a newline. See `pprint-str` for the
  string-returning form and options."
  ([x] (pprint x default-opts))
  ([x opts] (println (pprint-str x opts))))
