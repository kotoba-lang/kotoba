(ns kotoba.fmt.default-opts
  (:export [default-opts default-indent default-margin]))

;; Kotoba port of lib/kotoba.fmt/src/kotoba/fmt/default_opts.cljk.
;; Named divergences:
;;   * the map {:indent 2 :margin 80} is the record Opts (map literals are not
;;     in the language, E2116); default-opts returns it.
;;   * the keyword lookups become the accessors default-indent and default-margin.

(defrecord Opts [indent :i64 margin :i64])

(defn default-opts [] [:ref :kotoba.fmt.default-opts/Opts]
  (->Opts 2 80))

(defn default-indent [] :i64
  (record-get [:ref :kotoba.fmt.default-opts/Opts] (default-opts) :indent))

(defn default-margin [] :i64
  (record-get [:ref :kotoba.fmt.default-opts/Opts] (default-opts) :margin))
