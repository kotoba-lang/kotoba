(ns kotoba.fmt.fits-margin
  "fits-margin? -- addressed on its own.

  Split out of kotoba.lang.fmt on 2026-09-09 (ADR-2609091200). The unit
  here is the DEFINITION, and this repo's deps.edn names exactly the
  definitions it reaches -- nothing else.
"
  (:require [kotoba.fmt.emit-inline :refer [emit-inline]])
)

(defn fits-margin? [x depth opts]
  (let [inline (emit-inline x)]
    (< (+ (* depth (:indent opts)) (count inline)) (:margin opts))))
