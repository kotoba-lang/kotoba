(ns kotoba.fmt.emit-scalar-test (:export [main]) (:require [kotoba.fmt.emit-scalar :as p]))

(defn main [] :i64
  (+ (if (string=? (p/emit-scalar (document-null)) "nil") 0 1)
     (if (string=? (p/emit-scalar (document-string "ab")) "\"ab\"") 0 1)
     (if (string=? (p/emit-scalar (document-keyword :a/b)) ":a/b") 0 1)
     (if (string=? (p/emit-scalar (document-i64 42)) "42") 0 1)
     (if (string=? (p/emit-scalar (document-bool true)) "true") 0 1)
     (if (string=? (p/emit-scalar (document-i64 42)) "43") 1 0)))
