{:paths ["src"]
 :deps {
        io.github.kotoba-lang/test
        {:local/root "../kotoba.test"}}
 :aliases
 {:test {:extra-paths ["test"]}
  ;; Real-browser render-proof E2E (test/e2e/, ADR-2607121400): compiles
  ;; kami.eizo.timeline.e2e.entry, which pulls in both this repo's own
  ;; timeline query layer and org-w3-webcodecs's raw WebCodecs binding, into
  ;; one browser bundle via scripts/build-e2e-bundle.sh. See test/e2e/ and
  ;; the README's "Real-browser render proof" section.
  :e2e {:extra-paths ["test/e2e/src"]
        :extra-deps {io.github.kotoba-lang/org-w3-webcodecs
        {:local/root "../org.w3.webcodecs"}}}}}
