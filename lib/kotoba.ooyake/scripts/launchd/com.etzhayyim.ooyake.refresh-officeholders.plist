<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- ooyake 公 — 週次の 公人再取得（ADR-2607253200）。

     なぜ launchd か: `.github/workflows/` への書き込みには OAuth token の
     `workflow` scope が要り、このワークスペースのトークンは持っていない
     （GH_TOKEN/GITHUB_TOKEN 環境変数・kagi vault・secrets-location-map の
     いずれにも GitHub PAT は無い）。等価な Actions 版は
     `.github/workflows-pending/refresh-officeholders.yml` に温存してあり、scope が
     付いた日に `git mv` すれば置き換えられる — どちらも同じ
     `scripts/refresh-cron.cljk` を叩くだけなので、二重メンテにはならない。

     launchd の弱点は正直に: このマシンが眠っていれば動かない。
     StartCalendarInterval なので、指定時刻を寝過ごした場合は次の起動時に
     1回だけ発火する（StartInterval と違い、溜まった回数分は撃たない）。
     GitHub Actions ならマシン非依存だが、今日動くのはこちら。

     専用 clone `~/.ooyake/refresh-clone` の中で動く。west 管理下の共有
     checkout は触らない — 無人ジョブが `git reset (hard)` する場所と、人が
     編集する場所を同じにしてはいけない。

     インストール:
       cp scripts/launchd/com.etzhayyim.ooyake.refresh-officeholders.plist ~/Library/LaunchAgents/
       launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.etzhayyim.ooyake.refresh-officeholders.plist
     手動実行:
       launchctl kickstart -k gui/$(id -u)/com.etzhayyim.ooyake.refresh-officeholders
     ログ: ~/.ooyake/logs/refresh-officeholders.log
-->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.etzhayyim.ooyake.refresh-officeholders</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/junkawasaki/.local/bin/kbb</string>
    <string>--backend</string>
    <string>sci</string>
    <string>/Users/junkawasaki/.ooyake/refresh-clone/scripts/refresh-cron.cljk</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/junkawasaki/.ooyake/refresh-clone</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/Users/junkawasaki/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HOME</key><string>/Users/junkawasaki</string>
    <key>OOYAKE_FETCH_MIN_RETAINED</key><string>0.7</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key><integer>1</integer>
    <key>Hour</key><integer>4</integer>
    <key>Minute</key><integer>23</integer>
  </dict>
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>/Users/junkawasaki/.ooyake/logs/refresh-officeholders.log</string>
  <key>StandardErrorPath</key><string>/Users/junkawasaki/.ooyake/logs/refresh-officeholders.log</string>
  <key>ProcessType</key><string>Background</string>
</dict>
</plist>
