{:paths ["src"]
 ;; ooyake の実行系は長く bb.edn だけだった。ADR-2607173000 が bb を退役させている
 ;; ので、新しい実行経路は clojure alias で足す（bb.edn には手を触れない）。
 :deps {
        io.github.kotoba-lang/io {:local/root "../kotoba.io"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}
        io.github.kotoba-lang/edn {:local/root "../kotoba.edn"}}
 :aliases
 {;; registry を datalog で引く。DataScript であって Datomic でないのは、registry が
  ;; transactor を持たないファイル群だから — スキーマはどちらにもそのまま transact できる。
  ;; nbb + npm datascript を使わない理由は kawaraban の query.clj と同じで、
  ;; datascript.js だと属性も値も裸文字列に潰れ :db.unique/identity も keyword 値も消える。
  :query {:extra-deps {datascript/datascript {:mvn/version "1.7.4"}}
          :main-opts ["-m" "ooyake.query"]}}}