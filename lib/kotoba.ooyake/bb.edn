{:paths ["src" "test" "scripts"]
 :deps {
        ;; kotoba.io replaced clojure.java.io here (2026-09-24). An explicit floor:
        ;; kotoba.io carries clojure.java.io's file/as-file/as-relative-path/
        ;; make-parents/delete-file from 98045c7, and tools.deps takes the NEWEST
        ;; sha it is shown.
        io.github.kotoba-lang/io
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "64b3ffb2099e6911827c1fe8858bad31236b18ff"
         :deps/root "lib/kotoba.io"}
        io.github.kotoba-lang/edn
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "64b3ffb2099e6911827c1fe8858bad31236b18ff"
         :deps/root "lib/kotoba.edn"}}
 :tasks
 {test {:doc "Run ooyake cljc actor boundary tests."
        :task (do
                (require 'clojure.test
                         'ooyake.murakumo-test
                         'ooyake.cells.reconcile.test-state-machine
                         'ooyake.cells.world-model.test-state-machine
                         'ooyake.methods.test-charter-gates
                         'ooyake.repository-contract-test)
                (let [run-tests (requiring-resolve 'clojure.test/run-tests)
                      r (run-tests 'ooyake.murakumo-test
                                   'ooyake.cells.reconcile.test-state-machine
                                   'ooyake.cells.world-model.test-state-machine
                                   'ooyake.methods.test-charter-gates
                                   'ooyake.repository-contract-test)]
                  (System/exit (if (zero? (+ (:fail r) (:error r))) 0 1))))}
  coverage {:doc "Run kotoba/CLJC functional coverage matrix."
            :task (do
                    (require 'coverage-matrix)
                    ((requiring-resolve 'coverage-matrix/-main)))}}}