;; ooyake 公 — gov-officeholders.schema.edn — :gov.person/* の属性宣言。
;; ADR-2607253000（G6 改訂 2026-07-25「公人は記録して ok」）。
;;
;; 形は registry/gov-units.seed.edn 冒頭の :schema ブロックと同じ Datomic 形
;; （:db/ident の map の vector）。DataScript にも Datomic にもそのまま transact できる。
;;
;; ── 連動（これがこのファイルの存在理由）──────────────────────────────────────
;; :gov.person/unit は **文字列で** :gov.unit/id を指す（ref ではない）。ooyake の
;; registry 全体が id 文字列参照で書かれているのに合わせてある。したがって join は:
;;
;;   [:find ?person ?role ?unit-name ?country
;;    :where [?p :gov.person/name-en ?person]
;;           [?p :gov.person/role-en ?role]
;;           [?p :gov.person/unit ?uid]
;;           [?u :gov.unit/id ?uid]
;;           [?u :gov.unit/name-en ?unit-name]
;;           [?u :gov.unit/jurisdiction ?country]]
;;
;; 同じ id 文字列は kawaraban の :news.mention/target からも指せる（mentionEdge の
;; target は "did:web actor OR org.*/gov.* entity id"）。記事 → 公人 → 政府組織 が
;; 1本の datalog で繋がる設計。
;;
;; ── 属性が「無い」ことが憲章 ─────────────────────────────────────────────────
;; 私的連絡先・住所・生年月日・家族・資産・宗教・所属政党・日程に相当する属性は
;; **1つも宣言されていない**。宣言されていない属性は Datomic では transact 自体が
;; 通らない。G6 の改訂は「私的データ不可」を緩めたのではなく、「公職の事実は可」に
;; 限定して開けたもので、G10（civic wayfinding, never a target-list）は不変。

{:schema
 [{:db/id ":gov.person/id" :db/ident :gov.person/id :db/unique :db.unique/identity}

  {:db/ident :gov.person/unit           :db/valueType :db.type/string  :db/cardinality :db.cardinality/one
   :db/doc "→ :gov.unit/id（文字列 join）。必ず既存の unit を指す。"}
  {:db/ident :gov.person/unit-wikidata  :db/valueType :db.type/string  :db/cardinality :db.cardinality/one
   :db/doc "引くのに使った unit の QID。導出を後から再検証できるように残す。"}
  {:db/ident :gov.person/jurisdiction   :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}
  {:db/ident :gov.person/role-en        :db/valueType :db.type/string  :db/cardinality :db.cardinality/one
   :db/doc "役職。人物と組織を結んだ Wikidata property から導出した構造的関係名で、自由記述の肩書きではない（何が根拠かがそのまま読める形にしてある）。"}
  {:db/ident :gov.person/role-property  :db/valueType :db.type/string  :db/cardinality :db.cardinality/one
   :db/doc "role-en の根拠になった生の property slug。役職主張そのものの provenance。\"position-held\" は役職エンティティ経由（Pass B）で取れた行を意味し、その場合だけ role-en が実タイトルになる。"}
  {:db/ident :gov.person/position-wikidata :db/valueType :db.type/string :db/cardinality :db.cardinality/one
   :db/doc "役職エンティティの QID（Pass B のみ）。id をこれで作るので、上流がラベルを直しても id は変わらず、在任者が替わったときだけ diff が出る。"}
  {:db/ident :gov.person/name-en        :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}
  {:db/ident :gov.person/name-native    :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}
  {:db/ident :gov.person/since          :db/valueType :db.type/string  :db/cardinality :db.cardinality/one
   :db/doc "就任日（P580）。出典に無ければ属性ごと不在 — 推測で埋めない。"}
  {:db/ident :gov.person/official-url   :db/valueType :db.type/string  :db/cardinality :db.cardinality/one
   :db/doc "その職を説明している**組織側**の公式 URL。個人サイトではない。"}
  {:db/ident :gov.person/wikidata       :db/valueType :db.type/string  :db/cardinality :db.cardinality/one
   :db/doc "人物の QID = 引用元。どの行も出典に当たり直せる。"}
  {:db/ident :gov.person/sourcing       :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one
   :db/doc "G5 — 主張の**出所**であって信頼度ではない。:authoritative = その職に就いていることを当局自身のページで確認した（:source-url がその引用）。:third-party = 実在するが aggregator（Wikidata）由来で、当局側では未確認 — 独自確認していないものの正直な既定値。:representative = 例示、coverage に数えない。:third-party は 2026-07-25 追加（ADR-2607253400）: それまで全行が provenance wikidata のまま :authoritative を名乗り、行われていない1次確認を主張していた。"}
  {:db/ident :gov.person/source-url     :db/valueType :db.type/string  :db/cardinality :db.cardinality/one
   :db/doc "その人物がその職に就いていることが載っていた**当局自身の**ページ。:authoritative な行にのみ存在し、authoritative たらしめているのはこの1本。無い＝まだ誰も政府側の公表と突き合わせていない、という **カバレッジの穴**であって、その人物への疑いではない。"}
  {:db/ident :gov.person/provenance     :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}
  {:db/ident :gov.person/last-verified  :db/valueType :db.type/string  :db/cardinality :db.cardinality/one
   :db/doc "G5 — 実際に出典を読んだ日。在任者は変わる事実なので、この日付が無い行は自分の知っている以上を主張することになる。古い行は『偽の行』ではなく『日付の古い行』。"}]}
