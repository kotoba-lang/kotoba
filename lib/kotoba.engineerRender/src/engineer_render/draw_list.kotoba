;; Port of engineer-render.draw-list (draw_list.cljk), Kotoba-native, :document maps.
;;
;; The draw-list buffer is {:commands [...]}; each command is a :document map
;; {:cmd <kind> ...}. The native renderer consumes the EDN command list.
;;
;; Named divergences from draw_list.cljk:
;;   - cmd-kinds is a zero-arg fn returning the :document set (a def cannot be exported).
;;   - buffer parameters are named dl (the source's draw-list parameter would shadow
;;     the draw-list constructor).
;;   - empty? is draw-empty? as in the source; it compares the command count.

(ns engineer-render.draw-list
  (:export [cmd-kinds draw-list push clear commands draw-count draw-empty?]))

(defn cmd-kinds [] :document
  (document-set (document-keyword :line) (document-keyword :arc) (document-keyword :circle)
                (document-keyword :pad) (document-keyword :dimension) (document-keyword :hatch)
                (document-keyword :grid) (document-keyword :crosshair)
                (document-keyword :color-map-quad) (document-keyword :waveform-trace)))

(defn draw-list [] :document
  (document-map :commands (document-vector)))

(defn commands [dl :document] :document
  (option-or (document-get dl :commands) (document-vector)))

(defn push [dl :document cmd :document] :document
  (document-assoc dl :commands (document-vector-conj (commands dl) cmd)))

(defn clear [dl :document] :document
  (document-assoc dl :commands (document-vector)))

(defn draw-count [dl :document] :i64
  (document-count (commands dl)))

(defn draw-empty? [dl :document] :bool
  (= (draw-count dl) 0))
