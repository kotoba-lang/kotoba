(ns engineer-render.draw-list-test
  (:export [main])
  (:require [engineer-render.draw-list :as d]))

(defn- cmd [k :keyword] :document
  (document-map :cmd (document-keyword k)))

(defn main [] :i64
  (let [empty (d/draw-list)
        two (d/push (d/push empty (cmd :line)) (cmd :arc))
        cleared (d/clear two)]
    (+ (if (d/draw-empty? empty) 0 1)
       (if (= (d/draw-count two) 2) 0 1)
       (if (d/draw-empty? cleared) 0 1)
       (if (= (d/draw-count (d/push cleared (cmd :pad))) 1) 0 1)
       (if (document-set-contains? (d/cmd-kinds) (document-keyword :waveform-trace)) 0 1)
       (if (document-set-contains? (d/cmd-kinds) (document-keyword :text)) 1 0))))
