(ns multiformats.native-sha256 (:export [main])
  (:require [multiformats.sha256 :as sha] [multiformats.cid-hash :as hash]))
(defn- bytes [s :string] :vector-i64 (vector-i64-from-bytes (string-to-utf8 s)))
(defn- repeated [size :i64] :vector-i64
  (loop [i 0 out (vector-alloc size)]
    (if (= i size) out (recur (+ i 1) (vector-assoc! out i 97)))))
(defn main [] :i64
  (cond
    (not (string=? (sha/digest-hex []) "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855")) 1
    (not (string=? (sha/digest-hex (bytes "abc")) "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")) 2
    (not (string=? (sha/digest-hex (bytes "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq"))
          "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1")) 3
    (not (string=? (sha/digest-hex (repeated 1000000)) "cdc76e5c9914fb9281a1c7e284d73e67f1809a48a497200e046d39ccc7112cd0")) 4
    (not (string=? (hash/cidv1-raw-bytes (bytes "hello\n")) "bafkreicysg23kiwv34eg2d7qweipxwosdo2py4ldv42nbauguluen5v6am")) 5
    (not (string=? (sha/digest-hex [-1]) "")) 6
    (not (string=? (sha/digest-hex [256]) "")) 7
    :else 0))
