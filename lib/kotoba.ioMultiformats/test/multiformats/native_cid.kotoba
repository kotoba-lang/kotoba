(ns multiformats.native-cid (:export [main])
  (:require [multiformats.cid :as cid]))
(defn- cid-of [bytes :vector-i64] :string (string-concat "b" (cid/base32 bytes)))
(defn- digest [count :i64] :vector-i64
  (loop [i 0 out [1 85 18 32]] (if (= i count) out (recur (+ i 1) (vector-conj out 0)))))
(defn- decoder-tests [] :bool
  (let [max (cid/varint-decode [255 255 255 255 255 255 255 255 127] 0)
        wide (cid/varint-decode [128 128 128 128 128 128 128 128 128 1] 0)
        alias (cid/varint-decode [129 0] 0) missing (cid/varint-decode [128] 0)
        negative (cid/varint-decode [1] -1) byte (cid/varint-decode [256] 0)
        v53 (cid/varint-decode (cid/varint 9007199254740993) 0)]
    (and (= (record-get [:ref :multiformats.cid/varint] max :error) :none)
         (= (record-get [:ref :multiformats.cid/varint] max :value) 9223372036854775807)
         (= (record-get [:ref :multiformats.cid/varint] max :next) 9)
         (= (record-get [:ref :multiformats.cid/varint] wide :error) :unterminated)
         (= (record-get [:ref :multiformats.cid/varint] alias :error) :noncanonical)
         (= (record-get [:ref :multiformats.cid/varint] missing :error) :incomplete)
         (= (record-get [:ref :multiformats.cid/varint] negative :error) :offset)
         (= (record-get [:ref :multiformats.cid/varint] byte :error) :byte)
         (= (record-get [:ref :multiformats.cid/varint] v53 :value) 9007199254740993)
         (= (vector-count (cid/varint -1)) 0))))
(defn- cid-tests [] :bool
  (let [good "bafkreihdwdcefgh4dqkjv67uzcmw7ojee6xedzdetojuzjevtenxquvyku"
        parts (cid/cid->parts good)
        short (cid/cid->parts (cid-of (digest 31))) trailing (cid/cid->parts (cid-of (digest 33)))]
    (and (cid/cid-valid? good)
         (= (record-get [:ref :multiformats.cid/parts] parts :codec) 85)
         (= (record-get [:ref :multiformats.cid/parts] parts :hash-code) 18)
         (= (record-get [:ref :multiformats.cid/parts] parts :digest-size) 32)
         (= (vector-count (record-get [:ref :multiformats.cid/parts] parts :multihash)) 34)
         (= (record-get [:ref :multiformats.cid/parts] short :error) :digest-length)
         (= (record-get [:ref :multiformats.cid/parts] trailing :error) :digest-length)
         (cid/cid-valid? (cid-of [1 85 0 0]))
         (not (cid/cid-valid? (cid-of [129 0 85 0 0])))
         (not (cid/cid-valid? (cid-of [1 213 0 0 0])))
         (not (cid/cid-valid? (cid-of [1 85 128 0 0])))
         (not (cid/cid-valid? (cid-of [1 85 0 128 0])))
         (not (cid/cid-valid? (string-concat (string-substring good 0 58) "v")))
         (not (cid/cid-valid? (cid-of [2 85 0 0])))
         (string=? (cid/cidv1 85 "invalid") "")
         (string=? (cid/cidv1 -1 "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855") ""))))
(defn main [] :i64
  (cond (not= (cid/main) 6) 1
        (not (decoder-tests)) 2
        (not (cid-tests)) 3
        (not (and (cid/base32-valid? "") (cid/base32-valid? "my") (cid/base32-valid? "mzxw6ytboi"))) 4
        (or (cid/base32-valid? "a") (cid/base32-valid? "ab") (cid/base32-valid? "aaa")
            (cid/base32-valid? "aaaaaa") (cid/base32-valid? "my=")) 5
        (or (cid/hex-valid? "0") (cid/hex-valid? "0g") (not (cid/hex-valid? "00fFaB"))) 6
        (not (and (string=? (cid/base32 [-1]) "") (string=? (cid/base32 [256]) ""))) 7
        :else 0))
