;; CIDv1 from exact native bytes, or text through an explicit hash capability.
;; The byte APIs use pure canonical SHA-256 without UTF-8 coercion or a
;; provider request. Text APIs retain their declared hash/sha256 capability.
;;
;; root ADR-2610082200 §16: crypto arrives as a named capability. hash/sha256
;; (capability catalog wire id 3, classification :public) answers the lower-case
;; hex sha2-256 of the UTF-8 text, which is what multiformats.cid/cidv1 takes.
;; A guest using this module declares [:cap/call 3] in its policy.
;;
;;   cidv1-raw-text  = multiformats.core/cidv1-raw of the text's UTF-8 bytes
;;   kotoba-cid      = multiformats.core/kotoba-cid (dag-cbor codec over the
;;                     UTF-8 name), the node's graph / RID addressing

(ns multiformats.cid-hash
  (:require [multiformats.cid :as cid] [multiformats.sha256 :as sha256])
  (:export [cidv1-raw-text kotoba-cid cidv1-raw-bytes cidv1-dag-cbor-bytes]))

(defn cidv1-raw-bytes [bytes :vector-i64] :string
  (cid/cidv1 85 (sha256/digest-hex bytes)))
(defn cidv1-dag-cbor-bytes [bytes :vector-i64] :string
  (cid/cidv1 113 (sha256/digest-hex bytes)))

(defn cidv1-raw-text [text :string] :string
  (cid/cidv1 85 (hash/sha256 text)))

(defn kotoba-cid [name :string] :string
  (cid/cidv1 113 (hash/sha256 name)))
