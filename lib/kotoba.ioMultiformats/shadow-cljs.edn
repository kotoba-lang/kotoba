{:deps {:aliases [:shadow]}
 :builds
 {:test {:target :node-test
         :output-to "out/test.js"
         :ns-regexp "-test$"}
  ;; Compiled, because the number that matters is the compiled one. Measured
  ;; under nbb first and the SCI interpreter reported ~2,000 ms for a 384 KB
  ;; digest -- a real signal about the ratio, and not a number any deployment
  ;; pays. Quoting it would have been quoting the harness.
  :bench {:target :node-script
          :output-to "out/sha-bench.js"
          :main multiformats.sha-bench/-main}}}
