;; Port of cnc-toolpath.tool (tool.cljk), Kotoba-native, :document maps.
;;
;; Named divergences from tool.cljk:
;;   - tool-types and tool-materials are zero-arg functions returning
;;     :document sets (cross-module constants are not exportable in amu).
;;   - add and remove-tool return a :document vector [lib previous-or-null].
;;   - list-tools sorts the ids with document-vector-sort (canonical document
;;     order). For string ids this is the source's order; for keyword ids the
;;     order may differ from sort-by :id.
;;   - lib-count returns :i64; lib-empty? returns :bool.

(ns cnc-toolpath.tool
  (:export [tool-types tool-materials tool tool-library add get-tool
            remove-tool list-tools lib-count lib-empty?]))

(defn- field [m :document k :keyword] :document
  (if (map? m)
    (option-or (document-get m k) (document-null))
    (document-null)))

(defn- null-doc? [d :document] :bool
  (string=? (document-edn-print d) (document-edn-print (document-null))))

(defn- or-empty [v :document] :document
  (if (null-doc? v) (document-vector) v))

(defn- lib-base [lib :document] :document
  (if (map? lib) lib (document-map)))

(defn- tools-of [lib :document] :document
  (let [t (field (lib-base lib) :tools)]
    (if (null-doc? t) (document-map) t)))

(defn- at-or-null [v :document i :i64] :document
  (option-value-of [:option :document] (document-vector-at v i) (document-null)))

(defn tool-types [] :document
  (document-set (document-keyword :end-mill) (document-keyword :ball-nose)
                (document-keyword :bull-nose) (document-keyword :drill)
                (document-keyword :tap) (document-keyword :face-mill)
                (document-keyword :chamfer-mill) (document-keyword :lathe)))

(defn tool-materials [] :document
  (document-set (document-keyword :hss) (document-keyword :carbide)
                (document-keyword :ceramic) (document-keyword :cbn)
                (document-keyword :pcd)))

(defn tool [opts :document] :document
  (document-map :id (field opts :id)
                :name (field opts :name)
                :tool-type (field opts :tool-type)
                :diameter (field opts :diameter)
                :flute-length (field opts :flute-length)
                :overall-length (field opts :overall-length)
                :flute-count (field opts :flute-count)
                :corner-radius (field opts :corner-radius)
                :material (field opts :material)
                :coating (field opts :coating)))

(defn tool-library [] :document
  (document-map))

(defn add [lib :document t :document] :document
  (let [base (lib-base lib)
        tools (tools-of base)
        id (field t :id)
        previous (option-or (document-get tools id) (document-null))]
    (document-vector (document-assoc base (document-keyword :tools) (document-assoc tools id t))
                     previous)))

(defn get-tool [lib :document id :document] :document
  (option-or (document-get (tools-of lib) id) (document-null)))

(defn remove-tool [lib :document id :document] :document
  (let [base (lib-base lib)
        tools (tools-of base)
        removed (option-or (document-get tools id) (document-null))]
    (document-vector (document-assoc base (document-keyword :tools) (document-dissoc tools id))
                     removed)))

(defn list-tools [lib :document] :document
  (let [tools (tools-of lib)
        ids (loop [i 0 acc (document-vector)]
              (if (< i (document-count tools))
                (recur (+ i 1)
                       (document-vector-conj acc
                                             (at-or-null (option-value-of [:option :document]
                                                                          (document-map-entry-at tools i)
                                                                          (document-null))
                                                         0)))
                acc))
        sorted (document-vector-sort ids)]
    (loop [i 0 acc (document-vector)]
      (if (< i (document-count sorted))
        (recur (+ i 1)
               (document-vector-conj acc (option-or (document-get tools (at-or-null sorted i)) (document-null))))
        acc))))

(defn lib-count [lib :document] :i64
  (document-count (tools-of lib)))

(defn lib-empty? [lib :document] :bool
  (= (document-count (tools-of lib)) 0))
