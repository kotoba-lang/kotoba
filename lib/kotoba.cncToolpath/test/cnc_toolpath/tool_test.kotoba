(ns cnc-toolpath.tool-test (:export [main]) (:require [cnc-toolpath.tool :as p]))

(defn- fedn [d :document k :keyword] :string
  (document-edn-print (option-or (document-get d k) (document-null))))

(defn- at [v :document i :i64] :document
  (option-value-of [:option :document] (document-vector-at v i) (document-null)))

(defn- mk [id :string name :string] :document
  (p/tool (document-map :id (document-string id) :name (document-string name)
                        :tool-type (document-keyword :end-mill) :diameter (document-i64 6))))

(defn main [] :i64
  (let [lib0 (p/tool-library)
        r1 (p/add lib0 (mk "b" "drill-b"))
        lib1 (at r1 0)
        prev1 (at r1 1)
        r2 (p/add lib1 (mk "a" "endmill-a"))
        lib2 (at r2 0)
        r3 (p/remove-tool lib2 (document-string "b"))
        lib3 (at r3 0)
        removed (at r3 1)
        listed (p/list-tools lib2)]
    (+ (if (= (p/lib-count lib0) 0) 0 1)
       (if (p/lib-empty? lib0) 0 1)
       (if (= (p/lib-count lib1) 1) 0 1)
       (if (= (p/lib-count lib2) 2) 0 1)
       (if (document-equal? prev1 (document-null)) 0 1)
       (if (string=? (fedn (p/get-tool lib2 (document-string "a")) :name) "\"endmill-a\"") 0 1)
       (if (document-equal? (p/get-tool lib2 (document-string "zz")) (document-null)) 0 1)
       (if (string=? (fedn (at listed 0) :id) "\"a\"") 0 1)
       (if (string=? (fedn (at listed 1) :id) "\"b\"") 0 1)
       (if (= (p/lib-count lib3) 1) 0 1)
       (if (string=? (fedn removed :name) "\"drill-b\"") 0 1)
       (if (document-set-contains? (p/tool-types) (document-keyword :lathe)) 0 1)
       (if (document-set-contains? (p/tool-materials) (document-keyword :cbn)) 0 1))))
