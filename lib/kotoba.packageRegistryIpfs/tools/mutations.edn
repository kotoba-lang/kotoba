;; One mutation per invariant. `:find` must occur EXACTLY ONCE in `:file`.
;;
;; ## SCOPE
;;
;; Covers the 2026-08-18 `.clj` → `.cljc` conversion: that the CID shape is
;; checked before any I/O, that the returned bytes are verified against the
;; CID that was ASKED FOR, that a non-200 and a throwing transport are
;; refusals rather than escapes, that the bytes are decoded as UTF-8 before
;; being read as EDN, and that a missing transport is a named refusal rather
;; than a pass. It does NOT cover `kotoba.lang.package-registry` — every
;; registry and lock semantic belongs to `kotoba-lang/kotoba-lang` and is
;; measured there — so a clean run here means "the transport and its
;; verification are measured", not "the package registry is measured".
;;
;; ⚠ These mutations drive `kbb -M:test`. `test/run_portable.cljk` runs
;; the same `.cljc` suite under nbb and this harness does not invoke it, so
;; a defect that exists only on the `:cljs` side survives here. Two forms in
;; `ipfs.cljc` have platform branches — `utf8-string` and the `fetch-fn`
;; default — and for both the `:cljs` half was broken BY HAND under nbb and
;; watched going red. That evidence is in the PR, not in this table.
[{:id :the-cid-shape-is-checked-before-any-io
  :invariant "a malformed CID never reaches a transport"
  :file "src/kotoba/package_registry/ipfs.cljk"
  :find "(not (contract/cid? cid))"
  :replace "false"}

 {:id :the-returned-bytes-are-verified
  :invariant "bytes that do not hash back to the CID are refused"
  :file "src/kotoba/package_registry/ipfs.cljk"
  :find "(not= cid (mf/cidv1-raw bytes))"
  :replace "false"}

 {:id :a-non-200-response-is-refused
  :invariant "a gateway error body is not parsed as a registry"
  :file "src/kotoba/package_registry/ipfs.cljk"
  :find "(not= 200 status)"
  :replace "false"}

 {:id :a-missing-transport-is-refused
  :invariant "no fetch-fn is a named refusal, not a null dereference"
  :file "src/kotoba/package_registry/ipfs.cljk"
  :find "(nil? fetch-fn)"
  :replace "false"}

 {:id :a-throwing-transport-keeps-its-message
  :invariant "the cause is written down, not reduced to a status"
  :file "src/kotoba/package_registry/ipfs.cljk"
  :find ":message (ex-message error)"
  :replace ":message nil"}

 {:id :the-bytes-are-decoded-as-utf-8
  :invariant "multi-byte content survives the trip to edn/read-string"
  :file "src/kotoba/package_registry/ipfs.cljk"
  :find "(String. ^bytes b \"UTF-8\")"
  :replace "(String. ^bytes b \"ISO-8859-1\")"}

 {:id :the-gateway-base-reaches-the-transport
  :invariant "the caller's gateway is the one used"
  :file "src/kotoba/package_registry/ipfs.cljk"
  :find "(fetch-fn cid {:gateway-base gateway-base"
  :replace "(fetch-fn cid {:gateway-base \"http://mutant/\""}

 {:id :the-default-gateway-is-the-local-one
  :invariant "the documented default is the one actually applied"
  :file "src/kotoba/package_registry/ipfs.cljk"
  :find "{gateway-base \"http://127.0.0.1:8080/ipfs/\""
  :replace "{gateway-base \"http://mutant.invalid/ipfs/\""}

 {:id :the-default-timeout-is-ten-seconds
  :invariant "the documented default is the one actually applied"
  :file "src/kotoba/package_registry/ipfs.cljk"
  :find "timeout-ms 10000"
  :replace "timeout-ms 1"}

 {:id :the-requests-reach-the-pure-registry
  :invariant "resolution is over the caller's requests, not over nothing"
  :file "src/kotoba/package_registry/ipfs.cljk"
  :find "(edn/read-string (utf8-string bytes)) requests)))"
  :replace "(edn/read-string (utf8-string bytes)) nil)))"}

 {:id :the-status-refusal-is-named-as-such
  :invariant "a 503 and a hash mismatch are different diagnoses"
  :file "src/kotoba/package_registry/ipfs.cljk"
  :find ":problem :registry/fetch-http-status"
  :replace ":problem :registry/cid-mismatch"}

 {:id :the-refused-status-is-carried-in-the-problem
  :invariant "the caller can see WHICH status the gateway returned"
  :file "src/kotoba/package_registry/ipfs.cljk"
  :find ":status status}]}"
  :replace "}]}"}

 ;; RETARGETED, not deleted. The first form of this mutation replaced the
 ;; empty option map with `{:fetch-fn nil}`, and it was UNKILLABLE by this
 ;; harness rather than merely uncaught: `kbb -M:test` is the JVM, the
 ;; JVM's default fetch-fn is `http-fetch`, and the only way to tell the two
 ;; apart from the JVM is to let a call reach the transport and open a socket
 ;; to 127.0.0.1:8080. A unit test must not do that. The difference the
 ;; original form was reaching for is a `:cljs` one and it IS asserted — in
 ;; `a-missing-transport-is-a-refusal-and-not-a-pass`, under a `#?(:cljs …)`
 ;; that only `test/run_portable.cljk` evaluates.
 ;;
 ;; What is left here is the part the JVM can answer: that the short arity
 ;; delegates at all rather than answering on its own.
 {:id :the-two-argument-form-delegates
  :invariant "the short arity is the long one, not a separate answer"
  :file "src/kotoba/package_registry/ipfs.cljk"
  :find "([cid requests] (lock-from-requests cid requests {}))"
  :replace "([cid requests] {:ok? true})"}]
