;; mv -- POSIX mv (IEEE Std 1003.1).
;;
;;   mv SRC DST        rename SRC to DST
;;   mv SRC DIR        move SRC into DIR, keeping its name
;;   mv SRC... DIR     move several into DIR
;;
;; ## Measured against /bin/mv 2026-09-10
;;
;;   mv nope x   ->  mv: rename nope to x: No such file or directory    exit 1
;;   mv nope dd  ->  mv: rename nope to dd/nope: No such file or directory
;;
;; The diagnostic names BOTH operands and the verb -- `rename SRC to DST` --
;; which none of the sibling commands do, and the destination it names is the
;; RESOLVED target: `dd/nope`, not the `dd` that was typed. Measured on mv
;; rather than shaped after cp's.
;;
;; Overwriting an existing destination is silent and allowed, exactly as
;; rename(2) is.
;;
;; ## This is a rename, not a copy
;;
;; The wire form is RENAME_SEP, which is rename(2) under the grant, so a move
;; ACROSS filesystems fails where mv(1) would fall back to copy-and-unlink.
;; Inside one granted scope that cannot arise; the README says so rather than
;; leaving it to be discovered.
;;
;; Capabilities: :cli/args (38), :fs/app-data (35), :fs/browse (34),
;; :io/write-error (39).
(ns mv.core (:export [main]))

(defn arg [i :string] :string
  (typed-cap-call :cli/args :string :string i))

(defn emit-error [s :string] :string
  (typed-cap-call :io/write-error :string :string s))

(defn cap [s :string] :string
  (typed-cap-call :fs/app-data :string :string s))

(defn listing [dir :string] :string
  (typed-cap-call :fs/browse :string :string dir))

(defn exists? [path :string] :bool
  (string=? (cap (string-concat path "EXISTS_SEP")) "1"))

(defn rename-to [from :string to :string] :bool
  (string=? (cap (string-concat (string-concat from "RENAME_SEP") to)) "1"))

(defn nl [] :string
  (string-substring "a
b" 1 2))

(defn tab [] :string
  (string-substring "a	b" 1 2))

(defn digit-text [d :i64] :string
  (string-substring "0123456789" d (+ d 1)))

(defn decimal-of [n :i64] :string
  (if (< n 10)
    (digit-text n)
    (string-concat (decimal-of (quot n 10))
                   (digit-text (- n (* 10 (quot n 10)))))))

;; --- paths ---------------------------------------------------------------
(defn last-slash [p :string from :i64 best :i64] :i64
  (let [rest (string-substring p from (string-byte-length p))
        i (string-index-of rest "/")]
    (if (< i 0) best (last-slash p (+ from (+ i 1)) (+ from i)))))

(defn parent-of [p :string] :string
  (let [i (last-slash p 0 -1)]
    (if (< i 0) "." (if (= i 0) "/" (string-substring p 0 i)))))

(defn base-of [p :string] :string
  (let [i (last-slash p 0 -1)]
    (if (< i 0) p (string-substring p (+ i 1) (string-byte-length p)))))

(defn line-flag [line :string name :string] :i64
  (let [t (string-index-of line (tab))]
    (if (< t 0)
      -1
      (if (string=? (string-substring line 0 t) name)
        (if (string=? (string-substring line (+ t 1) (+ t 2)) "1") 1 0)
        -1))))

(defn flag-in [rest :string name :string] :i64
  (let [n (string-byte-length rest)]
    (if (= n 0)
      -1
      (let [i (string-index-of rest "\n")]
        (if (< i 0)
          (line-flag rest name)
          (let [f (line-flag (string-substring rest 0 i) name)]
            (if (>= f 0) f (flag-in (string-substring rest (+ i 1) n) name))))))))

(defn dir? [p :string] :bool
  (if (exists? p) (= (flag-in (listing (parent-of p)) (base-of p)) 1) false))

;; --- operands ------------------------------------------------------------
;; The index of the LAST operand, found by walking rather than by arithmetic
;; on the rendered count.
(defn last-index [i :i64 total :string] :i64
  (if (string=? (decimal-of (+ i 1)) total)
    i
    (last-index (+ i 1) total)))

;; `mv SRC DIR` moves INTO the directory under SRC's own name -- resolving
;; that here is what keeps rename(2) from ever being handed a directory as a
;; destination it should have entered.
(defn target-for [src :string dst :string] :string
  (if (dir? dst)
    (string-concat (string-concat dst "/") (base-of src))
    dst))

(defn complain [from :string to :string] :i64
  (do (emit-error "mv: rename ")
      (emit-error from)
      (emit-error " to ")
      (emit-error to)
      (emit-error ": No such file or directory")
      (emit-error (nl))
      1))

;; Every operand except the last, moved to (or into) the last.
(defn each [i :i64 stop :i64 dst :string worst :i64] :i64
  (if (>= i stop)
    worst
    (let [src (arg (decimal-of i))]
      (if (rename-to src (target-for src dst))
        (each (+ i 1) stop dst worst)
        ;; The message names the RESOLVED target, not the operand as given:
        ;; measured, `mv nope dd` over a directory `dd` reports
        ;; `rename nope to dd/nope`. Reporting the operand instead passes
        ;; every case whose destination is a plain path and fails exactly the
        ;; two whose destination is a directory.
        (each (+ i 1) stop dst (complain src (target-for src dst)))))))

(defn main [] :i64
  (let [total (arg "")]
    ;; Measured: BOTH no operands and one operand print the same two usage
    ;; lines and exit 64, not 1.
    (if (if (string=? total "0") true (string=? total "1"))
      (do
        (emit-error "usage: mv [-f | -i | -n] [-hv] source target")
        (emit-error (nl))
        (emit-error "       mv [-f | -i | -n] [-v] source ... directory")
        (emit-error (nl))
        64)
      (let [stop (last-index 0 total)]
        (each 0 stop (arg (decimal-of stop)) 0)))))
