(ns filecoin.transport-binary-test
  (:require [kotoba.test :as t :refer [deftest is]]
            [filecoin.protocols :as p]
            [filecoin.transport :as transport]))

(def payload [0 127 128 255])

(defn- ints [bytes]
  (mapv #(bit-and (int %) 255) (seq bytes)))

#?(:clj
   (deftest binary-put-and-get-over-loopback
     (let [seen (atom nil)
           server (com.sun.net.httpserver.HttpServer/create
                   (java.net.InetSocketAddress. "127.0.0.1" 0) 0)]
       (.createContext server "/piece"
                       (reify com.sun.net.httpserver.HttpHandler
                         (handle [_ exchange]
                           (when (= "PUT" (.getRequestMethod exchange))
                             (reset! seen (ints (.readAllBytes (.getRequestBody exchange)))))
                           (.add (.getResponseHeaders exchange) "Location" "/piece/upload/one")
                           (let [body (byte-array (map unchecked-byte payload))]
                             (.sendResponseHeaders exchange 200 (alength body))
                             (with-open [out (.getResponseBody exchange)]
                               (.write out body))))))
       (.start server)
       (try
         (let [url (str "http://127.0.0.1:" (.getPort (.getAddress server)) "/piece")
               http (transport/http)
               put (p/request http {:method :put :url url :headers {} :body payload
                                    :response-type :bytes})
               get (p/request http {:method :get :url url :headers {}
                                    :response-type :bytes})]
           (is (= payload @seen))
           (is (= 200 (:status put)))
           (is (= payload (ints (:body put))))
           (is (= "/piece/upload/one" (get (:headers put) "location")))
           (is (= payload (ints (:body get)))))
         (finally (.stop server 0))))))

#?(:cljs
   (deftest binary-put-and-get-over-loopback
     (t/async done
       (let [seen (atom nil)
             http-module (js/require "node:http")
             server (.createServer http-module
                                   (fn [req res]
                                     (let [chunks (atom [])]
                                       (.on req "data" #(swap! chunks conj %))
                                       (.on req "end"
                                            (fn []
                                              (when (= "PUT" (.-method req))
                                                (reset! seen (ints (js/Buffer.concat
                                                                    (clj->js @chunks)))))
                                              (.writeHead res 200 #js {"Location" "/piece/upload/one"})
                                              (.end res (js/Buffer.from (clj->js payload))))))))]
         (.listen server 0 "127.0.0.1"
                  (fn []
                    (let [url (str "http://127.0.0.1:" (.-port (.address server)) "/piece")
                          http (transport/http)]
                      (-> (p/request http {:method :put :url url :headers {} :body payload
                                           :response-type :bytes})
                          (.then (fn [put]
                                   (is (= payload @seen))
                                   (is (= 200 (:status put)))
                                   (is (= payload (ints (:body put))))
                                   (is (= "/piece/upload/one" (get (:headers put) "location")))
                                   (p/request http {:method :get :url url :headers {}
                                                    :response-type :bytes})))
                          (.then (fn [get]
                                   (is (= payload (ints (:body get))))
                                   (.close server (fn [] (done)))))
                          (.catch (fn [error]
                                    (is false (str error))
                                    (.close server (fn [] (done)))))))))))))
