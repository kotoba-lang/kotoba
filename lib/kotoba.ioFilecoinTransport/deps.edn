;; Three dependencies, and this repo exists because io-filecoin has none of
;; the impure ones.
;;
;;   io-filecoin         — messages, addresses, and the JSON-RPC bodies. Its
;;                         `src/` opens no socket, which is why the socket
;;                         lives here.
;;   io-filecoin-signer  — secp256k1, for the calls that need a signature.
;;                         Optional in practice: everything read-only works
;;                         without ever constructing a signer.
;;   org-ethereum-abi    — decoding what an FEVM contract returns, since
;;                         `StateCall` hands back ABI-encoded bytes.
;;
;; No HTTP library. `java.net.http` is in the JDK and `fetch` is in Node and
;; in every Worker runtime; pulling in a client would pin a platform for no
;; capability.
{:paths ["src"]
 :deps {
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}
        io.github.kotoba-lang/io-filecoin {:local/root "../kotoba.ioFilecoin"}
        io.github.kotoba-lang/io-filecoin-signer {:local/root "../kotoba.ioFilecoinSigner"}
        io.github.kotoba-lang/org-ethereum-abi {:local/root "../org.ethereum.abi"}}
 ;; cloud-filecoin is a *test* dependency only: the live suite calls a real
 ;; FEVM contract, and that message is built by filecoin.cloud.evm. The
 ;; library itself has no idea Onchain Cloud exists.

 :aliases
 {:test {:extra-paths ["test"]}
  :cljs {:extra-paths ["test"]
         :extra-deps {io.github.kotoba-lang/cloud-filecoin
                      {:git/sha "5e7305993c6cbf87ca14d6963b0a4527a6a0d55d"}}}
}}
