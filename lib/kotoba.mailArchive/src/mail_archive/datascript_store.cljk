(ns mail-archive.datascript-store
  "The nbb query backend of the `Store` — `kotoba-lang/datalog` over the shared
  schema (`mail_archive/schema.edn`), reachable only from nbb. This namespace
  name is historical (ADR-0001); it no longer uses npm `datascript`. Answers
  must match `mail_archive.store/LangchainDbStore`; the twin contract tests
  (`store_contract_test.cljc` on JVM, `datascript_contract_test.cljs` here)
  prove it.

  Pragmatic deviation (documented per the design): nbb's SCI loader can't cleanly
  `:require` a JVM `.cljc` protocol namespace, so this file does NOT reify
  `mail_archive.store/Store`; it implements the same three operations
  (`transact!`/`q`/`pull`) as plain top-level fns over a store map
  `{:volatile :schema}`. `transact!` mutates the volatile state in place (same
  observable contract as the old npm DataScript conn). Same shape, no protocol import.

  Two-pass ref flattening (the crux): nested-map tx-data is walked and every nested
  map under a ref attr is hoisted to its own entity with a fresh negative tempid.
  Unique-identity upsert then unifies tempids carrying the same `:person/id` /
  `:blob/cid` / `:email/cid` into one entity — exactly as `langchain.db` does —
  so refs resolve identically on both sides."
  (:require [kotoba.lang.edn :as edn]
            [kotoba.lang.text :as str]
            [datalog.core :as dl]
            [datalog.index :as index]
            ["fs" :as fs]))

(defn- visible? [_ _ _] true)

;; ───────────────────────── schema helpers ─────────────────────────

(defn kw->attr
  "Keyword -> bare string attribute name (no leading colon)."
  [k]
  (cond
    (keyword? k) (if-let [ns (namespace k)] (str ns "/" (name k)) (name k))
    (string? k) k
    :else (str k)))

(defn attr->kw
  "Bare string attribute -> keyword."
  [s]
  (if (and (string? s) (pos? (str/index-of s "/")))
    (keyword (subs s 0 (str/index-of s "/"))
             (subs s (inc (str/index-of s "/"))))
    (keyword s)))

(defn ref-attr? [schema a]
  (= :db.type/ref (get-in schema [(if (keyword? a) a (attr->kw a)) :db/valueType])))

(defn card-many? [schema a]
  (= :db.cardinality/many (get-in schema [(if (keyword? a) a (attr->kw a)) :db/cardinality])))

(defn unique-identity-attrs [schema]
  (into #{}
        (comp (filter #(= :db.unique/identity (get-in schema [% :db/unique])))
              (map identity))
        (keys schema)))

(defn identity-pairs [schema ent]
  (into []
        (comp (filter #(contains? ent %))
              (map (fn [a] [(kw->attr a) (get ent a)])))
        (unique-identity-attrs schema)))

;; ───────────────────────── two-pass ref flattening ─────────────────────────

(defn flatten-tx
  "Walk nested-map tx-data and return a flat vector of entity maps (keyword attrs;
  `:db/id` = a fresh negative tempid or the caller's explicit id)."
  [schema tx-data]
  (let [counter (atom 0)
        out (atom [])
        walk (fn walk [m]
               (let [id (or (:db/id m) (swap! counter dec))
                     flat (reduce-kv
                           (fn [acc a v]
                             (cond
                               (and (ref-attr? schema a) (map? v))
                               (assoc acc a (walk v))
                               (and (ref-attr? schema a) (sequential? v))
                               (assoc acc a (mapv (fn [x] (if (map? x) (walk x) x)) v))
                               :else (assoc acc a v)))
                           {:db/id id}
                           (dissoc m :db/id))]
                 (swap! out conj flat)
                 id))]
    (doseq [m tx-data] (walk m))
    @out))

;; ───────────────────────── entity / quad materialization ─────────────────────────

(defn- ref-pred [db]
  (fn [o] (contains? (:eavt db) o)))

(defn- resolve-ref [tid->eid v]
  (if (and (number? v) (contains? tid->eid v))
    (get tid->eid v)
    v))

(defn- resolve-eids
  "Assign a stable positive entity id to every flat entity, unifying by unique identity."
  [store flat-ents]
  (let [tid->eid (atom {})
        lookup (atom (:lookup store))
        counter (atom (:counter store))
        alloc (fn [] (swap! counter inc) @counter)
        resolve-one (fn [ent]
                      (let [tid (:db/id ent)]
                        (if-let [eid (@tid->eid tid)]
                          eid
                          (let [eid (or (some (fn [[ak av]] (get @lookup [ak av]))
                                              (identity-pairs (:schema store) ent))
                                        (alloc))]
                            (swap! tid->eid assoc tid eid)
                            (doseq [[ak av] (identity-pairs (:schema store) ent)]
                              (swap! lookup assoc [ak av] eid))
                            eid))))]
    (doseq [ent flat-ents] (resolve-one ent))
    {:tid->eid @tid->eid
     :lookup @lookup
     :counter @counter}))

(defn- ent->quads [schema ent eid tid->eid]
  (mapcat
   (fn [[a v]]
     (let [p (kw->attr a)]
       (cond
         (and (card-many? schema a) (sequential? v))
         (map (fn [item] {:s eid :p p :o (resolve-ref tid->eid item)}) v)
         :else
         [{:s eid :p p :o (resolve-ref tid->eid v)}])))
   (dissoc ent :db/id)))

(defn- merge-entity [schema old ent]
  (reduce-kv
   (fn [acc a v]
     (if (card-many? schema a)
       (update acc a (fnil into #{}) (if (sequential? v) v [v]))
       (assoc acc a v)))
   (or old {})
   (dissoc ent :db/id)))

(defn- snapshot [store]
  (assoc @(:volatile store) :schema (:schema store)))

(defn- transact-state [store tx-data]
  (let [schema (:schema store)
        flat (flatten-tx schema tx-data)
        {:keys [tid->eid lookup counter]} (resolve-eids store flat)
        [db entities]
        (reduce
         (fn [[db entities] ent]
           (let [eid (get tid->eid (:db/id ent))
                 quads (ent->quads schema ent eid tid->eid)
                 db' (reduce #(index/assert-quad %1 %2 (ref-pred %1)) db quads)
                 entities' (assoc entities eid (merge-entity schema (get entities eid) ent))]
             [db' entities']))
         [(:index store) (:entities store)]
         flat)]
    {:index db :entities entities :lookup lookup :counter counter}))

;; ───────────────────────── store ops (Store shape, plain fns) ─────────────────────────

(defn create-store
  "A datalog-backed store map over the shared schema."
  [schema]
  {:volatile (volatile! {:index (index/empty-db)
                         :entities {}
                         :lookup {}
                         :counter 0})
   :schema schema})

(defn transact!
  "Transact nested-map tx-data (flattened via `flatten-tx`) into the store."
  [store tx-data]
  (vreset! (:volatile store) (transact-state (snapshot store) tx-data))
  store)

(defn- vector-query->map
  "DataScript-style `[:find ?x :where ...]` vector -> `datalog.core` map."
  [v]
  (when (and (vector? v) (= :find (first v)))
    (let [where-idx (.indexOf v :where)]
      (when (pos? where-idx)
        {:find (vec (subvec v 1 where-idx))
         :where (vec (subvec v (inc where-idx)))}))))

(defn- parse-query
  [query]
  (cond
    (map? query) query
    (string? query) (parse-query (edn/read-string query))
    :else (or (vector-query->map query)
              (throw (ex-info "unsupported query shape" {:query query})))))

(defn q
  "Datalog query (DataScript-style EDN string with bare-string attrs, a
  `[:find ?x :where ...]` vector, or a `{:find ... :where ...}` map) against the
  store's db, plus optional extra `:in` inputs."
  [store query & inputs]
  (let [qmap (parse-query query)
        {:keys [index]} @(:volatile store)
        rows (apply dl/q index qmap visible? inputs)]
    (mapv vec rows)))

(defn- lookup-eid [store lookup-ref]
  (let [[attr val] lookup-ref
        ak (if (keyword? attr) (kw->attr attr) (str attr))
        {:keys [lookup]} @(:volatile store)]
    (get lookup [ak val])))

(defn- pull-pattern [store eid pattern]
  (let [{:keys [entities]} @(:volatile store)]
    (when-let [ent (get entities eid)]
      (into {}
            (map (fn [spec]
                   (cond
                     (keyword? spec)
                     (let [k spec]
                       [k (get ent k)])

                     (and (map? spec) (= 1 (count spec)))
                     (let [[k nested] (first spec)
                           ref-eid (get ent k)]
                       [k (when ref-eid (pull-pattern store ref-eid nested))]))))
            pattern))))

(defn pull
  "Datomic-style pull of entity `eid-or-lookup` (numeric id or lookup ref
  vector like `[:email/cid \"cid1\"]`) using `pattern` (vector or EDN string)."
  [store pattern eid-or-lookup]
  (let [pattern (if (string? pattern) (edn/read-string pattern) pattern)
        eid (cond
              (number? eid-or-lookup) eid-or-lookup
              (vector? eid-or-lookup) (lookup-eid store eid-or-lookup)
              :else eid-or-lookup)]
    (pull-pattern store eid pattern)))

;; ───────────────────────── schema loading (nbb) ─────────────────────────

(defn load-schema
  "Read the shared schema map from `src/mail_archive/schema.edn` (relative to the
  repo root, the cwd nbb runs from)."
  ([] (load-schema "src/mail_archive/schema.edn"))
  ([path] (edn/read-string (.readFileSync fs path "utf8"))))
