;; mail_archive/schema.edn — the single source of truth both backends load.
;;
;; DataScript-style *map* schema (attr -> constraint map), NOT the Datomic-native
;; vector-of-`{:db/ident ...}` form. `langchain.db/create-conn` and DataScript's
;; `create-conn` both accept exactly this shape, so LangchainDbStore and
;; DataScriptStore index the same data identically (ADR-0001; parity precedent
;; ADR-2607122000). Only constraint attributes are declared; plain scalar attrs
;; carry `{}` for self-documentation. `:db/valueType :db.type/ref` is the one
;; declaration DataScript treats specially (entity references); cardinality and
;; uniqueness are declared for both sides.
{;; ---------- blob (content-addressed raw artifact; cid = sha256 hex) ----------
 :blob/cid          {:db/unique :db.unique/identity}
 :blob/sha256       {}
 :blob/size         {}
 :blob/mime         {}
 :blob/path         {}

 ;; ---------- person (a sender/recipient, identified by canonical email) ----------
 :person/id         {:db/unique :db.unique/identity}
 :person/emails     {:db/cardinality :db.cardinality/many}
 :person/name       {}
 :person/canonical  {:db/valueType :db.type/ref}

 ;; ---------- email (one message) ----------
 :email/cid         {:db/unique :db.unique/identity}
 :email/message-id  {:db/unique :db.unique/identity}
 :email/thread-id   {}
 :email/date        {}
 :email/subject     {}
 :email/labels      {:db/cardinality :db.cardinality/many}
 :email/from        {:db/valueType :db.type/ref}
 :email/to          {:db/valueType :db.type/ref :db/cardinality :db.cardinality/many}
 :email/cc          {:db/valueType :db.type/ref :db/cardinality :db.cardinality/many}
 :email/blob        {:db/valueType :db.type/ref}
 :email/attachments {:db/valueType :db.type/ref :db/cardinality :db.cardinality/many}

 ;; ---------- attachment ----------
 :attachment/id     {:db/unique :db.unique/identity}
 :attachment/name   {}
 :attachment/blob   {:db/valueType :db.type/ref}}
