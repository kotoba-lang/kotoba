{:paths ["src"]
 ;; org.clojure/data.json matches com-gmail's JSON codec. The four kotoba-lang
 ;; libraries are consumed via :local/root sibling checkouts (they are not yet
 ;; published to Clojars or pinned to a git tag): com-gmail (the Gmail API v1
 ;; client ingest consumes), org-ietf-oauth2 (RFC 6749/7636 request/response
 ;; shaping for auth), mail (mail.inbound/mail.message address normalization),
 ;; langchain (langchain.db, the Datomic-API-compatible in-memory EAV store
 ;; that backs LangchainDbStore).
 :deps {
        io.github.kotoba-lang/error {:local/root "../kotoba.error"}
        io.github.kotoba-lang/bytes {:local/root "../kotoba.bytes"}
        io.github.kotoba-lang/io {:local/root "../kotoba.io"}
        io.github.kotoba-lang/process {:local/root "../kotoba.process"}
        io.github.kotoba-lang/edn {:local/root "../kotoba.edn"}
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}
        io.github.kotoba-lang/json {:local/root "../kotoba.json"}
        io.github.kotoba-lang/com-gmail {:local/root "../kotoba.comGmail"}
        io.github.kotoba-lang/org-ietf-oauth2 {:local/root "../org.ietf.oauth2"}
        io.github.kotoba-lang/mail {:local/root "../kotoba.mail"}
        io.github.kotoba-lang/langchain {:local/root "../kotoba.langchain"}}
 :aliases
 {:test {:extra-paths ["test"]}}}