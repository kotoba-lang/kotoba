{:paths ["src"]
 :version "0.1.0"
 ;; kotoba-lang/device — device capability interfaces (bluetooth/wifi/display/
 ;; geolocation/camera) as EDN + a discover protocol, host-injected drivers.
 ;; Consumes wit (capability tokens) + coll (shaping). Aligns with aiueos
 ;; :aiueos/device + aiueos:host: device surfaces are capability tokens, not
 ;; direct OS access. No third-party deps; .cljc.
 ;; See ADR-kotoba-lang-foundational-stdlib.md.
 :deps {
        ;; kotoba.test (clojure.test-compatible surface), not clojure.test --
        ;; scripts/migrate-clojure-test-to-kotoba-test.cljk. Explicit floor.
        io.github.kotoba-lang/test {:git/url "https://github.com/kotoba-lang/test.git"
                                    :git/sha "2ab4885f99fd25552d380d0f6b0b54c5a72eb7ae"}
        io.github.kotoba-lang/device-device
        {:git/url "https://github.com/kotoba-lang/device-device.git"
         :git/sha "c29451e1c239f27e2ba41b6643e39606df9409d6"}
        io.github.kotoba-lang/device-call
        {:git/url "https://github.com/kotoba-lang/device-call.git"
         :git/sha "9e295163ef3fd89b792ce6156498bec4521863e4"}
        io.github.kotoba-lang/device-describe
        {:git/url "https://github.com/kotoba-lang/device-describe.git"
         :git/sha "b31b29091aafbe25aa4b171c940dde96f10909ac"}
        io.github.kotoba-lang/device-discover
        {:git/url "https://github.com/kotoba-lang/device-discover.git"
         :git/sha "087b3b7483a77e2e08272fc75ce2653cf9022a6e"}
        io.github.kotoba-lang/device-make-device-manager
        {:git/url "https://github.com/kotoba-lang/device-make-device-manager.git"
         :git/sha "268a5d2db69697bbc1c8d2e64f8cd1fe1384d5b2"}
        io.github.kotoba-lang/device-mock-device
        {:git/url "https://github.com/kotoba-lang/device-mock-device.git"
         :git/sha "b28d1194fc33d0e86c88a7ac45c8320b1d257d58"}
        io.github.kotoba-lang/device-sensing-host-driver-ref
        {:git/url "https://github.com/kotoba-lang/device-sensing-host-driver-ref.git"
         :git/sha "d5f29a3481249c39106c65b70fbde840aa4ca392"}
        io.github.kotoba-lang/device-surface-cap
        {:git/url "https://github.com/kotoba-lang/device-surface-cap.git"
         :git/sha "bfd5647d4798c992432f4ec58b2cff39b87bad2a"}
        io.github.kotoba-lang/device-surfaces
        {:git/url "https://github.com/kotoba-lang/device-surfaces.git"
         :git/sha "b0229ff2beaf599d00563cf17cf5c7ba4ff301b7"}
io.github.kotoba-lang/wit  {:git/sha "5708fb98c9e25f233c5e44afe155328b29982cb2"}
        io.github.kotoba-lang/coll {:git/sha "9740cc2dc43a192077d77374b869a37940c801e4"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  ;; clj-kondo as a Clojars lib (no Homebrew/system install needed).
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
