(ns kotoba.device.surface-to-cap-test (:export [main]) (:require [kotoba.device.surface-to-cap :as p]))

(defn main [] :i64
  (+ (if (string=? (p/surface->cap (document-keyword :camera)) "device:camera") 0 1)
     (if (string=? (p/surface->cap (document-keyword :display/main)) "device:main") 0 1)
     (if (string=? (p/surface->cap (document-string "mic")) "device:mic") 0 1)
     (if (string=? (p/surface->cap (document-keyword :speaker)) "device:speaker!") 1 0)))
