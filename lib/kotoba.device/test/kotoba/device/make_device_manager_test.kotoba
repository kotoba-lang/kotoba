;; Test for kotoba.device.make-device-manager. main returns failed-case count.
(ns kotoba.device.make-device-manager-test
  (:export [main])
  (:require [kotoba.device.make-device-manager :as m]))

(defn- g [mp :document k :keyword] :document
  (option-value-of [:option :document] (document-get mp k) (document-null)))
(defn- chk-i64 [got :i64 want :i64] :i64
  (if (= got want) 0 1))

(defn main [] :i64
  (let [pol (document-vector (document-string "cap.a") (document-string "cap.b"))
        drv (document-assoc (document-map) (document-string "surface") (document-string "dev"))
        dm (m/make-device-manager pol drv (document-map))
        a (chk-i64 (document-count (g dm :policy)) 2)
        b (chk-i64 (document-count (g dm :drivers)) 1)
        c (chk-i64 (document-count (g dm :opts)) 0)]
    (+ a (+ b c))))
