;; Port of kotoba.device.surface-to-cap (surface_to_cap.cljk), Kotoba-native.
;;
;; surface->cap is "device:" followed by the surface's name.
;;
;; Named divergences from surface_to_cap.cljk:
;;   - the surface is a :document. A keyword contributes its name (namespace
;;     dropped, as clojure name does); a string contributes itself. Any other
;;     value contributes its canonical EDN text (the source throws on it).

(ns kotoba.device.surface-to-cap
  (:export [surface->cap]))

(defn- surface-name [s :document] :string
  (if (option-some?-of [:option :keyword] (document-keyword-value s))
    (keyword-name (option-value-of [:option :keyword] (document-keyword-value s) :none))
    (option-or (document-string-value s) (document-edn-print s))))

(defn surface->cap [s :document] :string
  (string-concat "device:" (surface-name s)))
