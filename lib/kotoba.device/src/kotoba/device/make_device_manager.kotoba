;; Port of kotoba.device.make-device-manager (make_device_manager.cljk).
;;
;; The source returns {:policy :drivers :opts}. This port returns the same map
;; shape as a :document. Named divergence: drivers hold live Device values in
;; the source; here they are document values (no live handles in a pure
;; document). The gating behaviour is not part of this unit.
(ns kotoba.device.make-device-manager
  (:export [make-device-manager]))

(defn make-device-manager [policy :document drivers :document opts :document] :document
  (document-map :policy policy :drivers drivers :opts opts))
