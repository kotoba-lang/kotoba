(ns kotoba.device.surfaces
  "surfaces -- addressed on its own.

  Split out of kotoba.lang.device on 2026-09-09 (ADR-2609091200). The unit
  here is the DEFINITION, and this repo's deps.edn names exactly the
  definitions it reaches -- nothing else.
"
  (:require [kotoba.device.surface-to-cap :refer [surface->cap]]
            [kotoba.device.surface-effects :refer [surface-effects]])
)

(defn surfaces
  "Return the canonical device-surface capability tokens (wit-compatible). Each
  is {:wit/capability \"device:<s>\" :wit/effects #{...}}."
  []
  (for [[s effects] surface-effects]
    {:wit/capability (surface->cap s)
     :wit/effects    effects}))
