(ns kotoba.device.sensing-host-driver-ref
  "sensing-host-driver-ref -- addressed on its own.

  Split out of kotoba.lang.device on 2026-09-09 (ADR-2609091200). The unit
  here is the DEFINITION, and this repo's deps.edn names exactly the
  definitions it reaches -- nothing else.
"
  (:require [kotoba.device.sensing-host-driver-refs :refer [sensing-host-driver-refs]])
)

(defn sensing-host-driver-ref
  "Return `sensing-host-driver-refs`' entry for surface `s`, or nil (e.g. for
  bluetooth/wifi/display/geolocation/camera, which have none)."
  [s]
  (get sensing-host-driver-refs s))
