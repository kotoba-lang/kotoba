(ns kotoba.device.discover
  "discover -- addressed on its own.

  Split out of kotoba.lang.device on 2026-09-09 (ADR-2609091200). The unit
  here is the DEFINITION, and this repo's deps.edn names exactly the
  definitions it reaches -- nothing else.
"
  (:require [kotoba.lang.wit :as w]
            [kotoba.device.surface-cap :refer [surface-cap]]
            [kotoba.device.surface-effects :refer [surface-effects]])
)

(defn discover
  "Enumerate the device surfaces a manager's policy grants (in canonical
  order). Returns a seq of surface keywords."
  [mgr]
  (let [granted? (fn [s] (w/allows? (:policy mgr) (surface-cap s)))]
    (filter granted? (keys surface-effects))))
