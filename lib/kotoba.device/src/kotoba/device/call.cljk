(ns kotoba.device.call
  "call -- addressed on its own.

  Split out of kotoba.lang.device on 2026-09-09 (ADR-2609091200). The unit
  here is the DEFINITION, and this repo's deps.edn names exactly the
  definitions it reaches -- nothing else.
"
  (:require [kotoba.device.device :refer [Device read-dev scan subscribe write-dev]]
            [kotoba.device.denied :refer [denied]]
            [kotoba.device.gate :refer [gate]]
            [kotoba.device.surface-effects :refer [surface-effects]])
)

(defn call
  "Capability-gated device call. `surface` is a keyword (`:bluetooth`), `method`
  is `:scan`/`:read`/`:write`/`:subscribe`, `args` is a map of method args.
  Returns `:kotoba.lang.device/denied` if the surface isn't granted, `:kotoba.lang.device/unknown-method` if
  `method` isn't among the surface's declared effects (see surface-effects) —
  granting a surface only authorizes the methods that surface's schema
  actually exposes, not every Device method a driver happens to implement —
  dispatches to the driver otherwise."
  [mgr surface method args]
  (if-let [dev (gate mgr surface)]
    (if (contains? (get surface-effects surface) method)
      (case method
        :scan      (scan dev)
        :read      (read-dev dev (:handle args))
        :write     (write-dev dev (:handle args) (:data args))
        :subscribe (subscribe dev (:handle args) (:fn args))
        :kotoba.lang.device/unknown-method)
      :kotoba.lang.device/unknown-method)
    denied))
