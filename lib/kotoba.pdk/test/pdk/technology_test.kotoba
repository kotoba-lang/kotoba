;; Test for pdk.technology (ported part). main returns the number of failed cases.
(ns pdk.technology-test
  (:export [main])
  (:require [pdk.technology :as t]))

(defn- chk [ok :bool] :i64
  (if ok 0 1))

(defn- item [v :document i :i64] :document
  (option-value-of [:option :document] (document-vector-at v i) (document-null)))

(defn- nodes-and-layers [] :i64
  (+ (chk (= (document-count (t/nodes)) 14))
     (+ (chk (document-equal? (item (t/nodes) 0) (document-keyword :n180)))
        (+ (chk (= (document-count (t/layer-types)) 6))
           (chk (= (document-kind (t/layer-types)) :set))))))

(defn- feature-sizes [] :i64
  (+ (chk (= (t/feature-nm :n180) 180))
     (+ (chk (= (t/feature-nm :n2) 2))
        (chk (= (t/feature-nm :n7) 7)))))

(defn- widths [] :i64
  (let [tech (document-map :min-width (document-map (document-string "poly") (document-i64 3)
                                                    (document-string "metal1") (document-i64 5))
                           :min-spacing (document-map (document-string "metal1") (document-i64 4)))]
    (+ (chk (document-equal? (t/get-min-width tech (document-string "poly")) (document-i64 3)))
       (+ (chk (document-equal? (t/get-min-spacing tech (document-string "metal1")) (document-i64 4)))
          (chk (document-equal? (t/get-min-spacing tech (document-string "poly")) (document-null)))))))

(defn main [] :i64
  (+ (nodes-and-layers) (+ (feature-sizes) (widths))))
