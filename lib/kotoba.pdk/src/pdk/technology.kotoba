;; Port of pdk.technology (technology.cljk), Kotoba-native. PARTIAL.
;;
;; Ported: nodes, layer-types, feature-nm, layer-def, get-min-width,
;; get-min-spacing.
;; Skipped (not ported): metal-pitch (adds floating-point widths and spacings)
;; and for-node (floating-point feature sizes and widths). The Kotoba f64
;; surface has no arithmetic, so these have no faithful port yet.
;; Named divergences:
;;   - feature-nm returns 0 for an unknown node; the source's case throws.
;;   - nodes and layer-types are constant documents (zero-argument functions).
;;   - the source's get-in and map-field accessors return nil for absent keys;
;;     here they return the document null, which is the same value.
(ns pdk.technology
  (:export [nodes layer-types feature-nm layer-def get-min-width get-min-spacing]))

(defn- field [m :document k :keyword] :document
  (if (= (document-kind m) :map)
    (option-value-of [:option :document] (document-get m (document-keyword k)) (document-null))
    (document-null)))

(defn nodes [] :document
  (document-edn-read "[:n180 :n130 :n90 :n65 :n45 :n28 :n22 :n16 :n14 :n10 :n7 :n5 :n3 :n2]"))

(defn layer-types [] :document
  (document-edn-read "#{:diffusion :implant :metal :poly :via :well}"))

(defn feature-nm [node :keyword] :i64
  (cond (= node :n180) 180
        (= node :n130) 130
        (= node :n90) 90
        (= node :n65) 65
        (= node :n45) 45
        (= node :n28) 28
        (= node :n22) 22
        (= node :n16) 16
        (= node :n14) 14
        (= node :n10) 10
        (= node :n7) 7
        (= node :n5) 5
        (= node :n3) 3
        (= node :n2) 2
        :else 0))

(defn layer-def [m :document] :document
  (document-map :name (field m :name)
                :gds-number (field m :gds-number)
                :gds-datatype (field m :gds-datatype)
                :layer-type (field m :layer-type)))

(defn get-min-width [tech-file :document layer :document] :document
  (let [widths (field tech-file :min-width)]
    (if (= (document-kind widths) :map)
      (option-value-of [:option :document] (document-get widths layer) (document-null))
      (document-null))))

(defn get-min-spacing [tech-file :document layer :document] :document
  (let [spacings (field tech-file :min-spacing)]
    (if (= (document-kind spacings) :map)
      (option-value-of [:option :document] (document-get spacings layer) (document-null))
      (document-null))))
