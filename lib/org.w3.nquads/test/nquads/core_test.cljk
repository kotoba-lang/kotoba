(ns nquads.core-test
  (:require [kotoba.lang.text :as str]
            [kotoba.test :refer [deftest is testing]]
            [nquads.core :as nq]))

(def ^:private s (nq/iri "http://example.com/s"))
(def ^:private p (nq/iri "http://example.com/p"))

;; ── canonical N-Triples escaping ─────────────────────────────────────────────
;; This is the whole reason this layer exists as its own thing: the grammar accepts
;; several byte sequences for one term, and RDFC-1.0 hashes exactly one of them —
;; the one canonical N-Triples specifies.
;;
;; The first version of these tests asserted that only FOUR characters are escaped
;; and that tab, form feed and backspace are NOT. Every test agreed with the
;; implementation and the whole set was wrong; W3C's own escaping vector (test060,
;; exercised from org-w3-rdf-canon) is what disproved it.

(deftest exactly-seven-characters-are-echar-escaped
  (testing "BS, HT, LF, FF, CR, quote and backslash — no more, no fewer"
    (is (= "\\b" (nq/escape-literal "\b")))
    (is (= "\\t" (nq/escape-literal "\t")))
    (is (= "\\n" (nq/escape-literal "\n")))
    (is (= "\\f" (nq/escape-literal "\f")))
    (is (= "\\r" (nq/escape-literal "\r")))
    (is (= "\\\"" (nq/escape-literal "\"")))
    (is (= "\\\\" (nq/escape-literal "\\")))
    (testing "and the whole set at once, in the order W3C's test060 uses"
      (is (= "\\t\\b\\n\\r\\f\\\"'\\\\"
             (nq/escape-literal "\t\b\n\r\f\"'\\"))
          "note the apostrophe is NOT escaped, though the grammar's ECHAR allows it"))))

(deftest vertical-tab-is-uchar-not-echar
  (testing "VT has no ECHAR form, so it must be written \\u000B — and with the hex
            digits UPPERCASE, which is normative"
    (is (= "\\u000B" (nq/escape-literal "\u000B")))))

(deftest the-uchar-ranges-are-exactly-those-specified
  (testing "U+0000-U+0007, VT, U+000E-U+001F, DEL"
    (is (= "\\u0000\\u0001\\u0007" (nq/escape-literal "\u0000\u0001\u0007")))
    (is (= "\\u000E\\u001F" (nq/escape-literal "\u000E\u001F")))
    (is (= "\\u007F" (nq/escape-literal "\u007F")) "DEL"))
  (testing "but U+0008-U+000A, U+000C, U+000D take their ECHAR forms instead"
    (is (= "\\b\\t\\n\\f\\r" (nq/escape-literal "\b\t\n\f\r"))))
  (testing "and U+0080-U+008F match XML 1.1 Char, so they are NOT escaped —
            surprising for C1 controls, but that is what the production says"
    (is (= "\u0080\u008F" (nq/escape-literal "\u0080\u008F")))))

(deftest hex-digits-in-uchar-are-uppercase-but-the-u-is-lowercase
  (testing "\"HEX MUST use only digits and uppercase letters\", while the escape
            itself is a lowercase backslash-u"
    (let [out (nq/escape-literal "\u001A\u001B\u001C\u001D\u001E\u001F")]
      (is (= "\\u001A\\u001B\\u001C\\u001D\\u001E\\u001F" out))
      (is (not (str/includes? out "\\U")) "capital U is the 8-digit form"))))

(deftest printable-ascii-and-non-ascii-are-emitted-natively
  (testing "everything not required to be ECHAR or UCHAR is native UTF-8"
    (is (= "日本語" (nq/escape-literal "日本語")))
    (is (= "é" (nq/escape-literal "é")))
    (is (= "😀" (nq/escape-literal "😀")) "a supplementary character stays one char")
    (is (= " !#$%&'()*+,-./" (nq/escape-literal " !#$%&'()*+,-./")))
    (testing "so no backslash appears at all"
      (is (not (str/includes? (nq/escape-literal "日本語😀 '~") "\\"))))))

(deftest escaping-is-a-single-pass-so-it-cannot-re-escape-its-own-output
  (testing "the old implementation chained str/replace and had to put backslash
            first; a code-point pass has no such ordering hazard"
    (is (= "\\\\n" (nq/escape-literal "\\n"))
        "a literal backslash followed by the letter n")
    (is (= "\\\\" (nq/escape-literal "\\")))
    (is (= "a\\\\b\\nc" (nq/escape-literal "a\\b\nc")))
    (is (= "\\\\u0039" (nq/escape-literal "\\u0039"))
        "text that merely LOOKS like an escape is escaped, not interpreted")))

;; ── serialization ────────────────────────────────────────────────────────────

(deftest a-triple-serializes
  (is (= "<http://example.com/s> <http://example.com/p> \"v\" .\n"
         (nq/serialize-statement {:subject s :predicate p :object (nq/literal "v")}))))

(deftest a-quad-carries-its-graph-label
  (is (= (str "<http://example.com/s> <http://example.com/p> \"v\" "
              "<http://example.com/g> .\n")
         (nq/serialize-statement {:subject s :predicate p :object (nq/literal "v")
                                  :graph (nq/iri "http://example.com/g")}))))

(deftest the-period-is-preceded-by-a-space
  (testing "the grammar separates terminals with whitespace, so without it the
            period would read as part of the preceding term"
    (let [line (nq/serialize-statement {:subject s :predicate p :object s})]
      (is (str/ends-with? line "> .\n"))
      (is (not (str/includes? line ">."))))))

(deftest blank-nodes-get-their-prefix-back-on-serialization
  (testing "the label is stored without `_:` because the prefix is serialization
            and the label is identity — RDFC-1.0 relabels labels"
    (is (= "b0" (:value (nq/blank "b0"))))
    (is (= "_:b0" (nq/serialize-term (nq/blank "b0"))))))

(deftest literals-carry-a-language-or-a-datatype-never-both
  (is (= "\"v\"@ja" (nq/serialize-term (nq/literal "v" nil "ja"))))
  (testing "a datatype of xsd:string MUST NOT be written — in RDF 1.1 a plain
            literal already IS xsd:string-typed, so the two are the same term and
            canonical N-Triples picks the shorter spelling. This assertion used to
            expect the datatype to survive."
    (is (= "\"v\"" (nq/serialize-term (nq/literal "v" nq/xsd-string))))
    (is (nil? (:datatype (nq/literal "v" nq/xsd-string)))
        "dropped at construction, not merely at serialization"))
  (is (= "\"v\"" (nq/serialize-term (nq/literal "v"))))
  (testing "a language tag with a contradicting datatype is refused rather than
            silently preferring one"
    (is (= :nquads/language-and-datatype
           (:nquads/error
            (ex-data (try (nq/literal "v" "http://example.com/other" "ja")
                          (catch clojure.lang.ExceptionInfo e e))))))
    (testing "but rdf:langString is consistent, so it is allowed"
      (is (= "\"v\"@ja"
             (nq/serialize-term (nq/literal "v" nq/rdf-lang-string "ja")))))))

(deftest a-dataset-is-not-sorted-here
  (testing "RDFC-1.0 sorts the canonical N-Quads as one of its own numbered steps;
            sorting earlier would hide whether that step ran"
    (let [a {:subject s :predicate p :object (nq/literal "a")}
          b {:subject s :predicate p :object (nq/literal "b")}]
      (is (= (str (nq/serialize-statement b) (nq/serialize-statement a))
             (nq/serialize-dataset [b a]))))))

;; ── UCHAR inside an IRI ──────────────────────────────────────────────────────

(deftest an-iri-decodes-uchar-and-serializes-natively
  (testing "<urn:ex:\\u221e> and <urn:ex:∞> are the SAME IRI, and only the second is
            canonical. A parser that skipped this would hash them apart."
    (let [[st] (nq/parse "<urn:ex:s> <urn:ex:p> <urn:ex:\\u221e> .\n")]
      (is (= "urn:ex:∞" (get-in st [:object :value])))
      (is (= "<urn:ex:s> <urn:ex:p> <urn:ex:∞> .\n" (nq/serialize-statement st))
          "round-tripping normalises the spelling"))
    (testing "and the 8-digit form, for a supplementary character"
      (let [[st] (nq/parse "<urn:ex:s> <urn:ex:p> <urn:ex:\\U0001F303> .\n")]
        (is (= "urn:ex:🌃" (get-in st [:object :value])))))
    (testing "including in a datatype IRI"
      (let [[st] (nq/parse "<urn:ex:s> <urn:ex:p> \"d\"^^<urn:ex:\\u0064\\u0074> .\n")]
        (is (= "urn:ex:dt" (get-in st [:object :datatype])))))))

(deftest an-iri-refuses-an-echar-because-the-production-has-none
  (testing "IRIREF admits UCHAR only. Inventing a tab here would accept a document
            no conforming parser accepts."
    (is (= :nquads/bad-iri-escape
           (:nquads/error
            (ex-data (try (nq/parse "<urn:ex:s> <urn:ex:p> <urn:ex:a\\tb> .\n")
                          (catch clojure.lang.ExceptionInfo e e))))))))

;; ── language tags are case normalised ────────────────────────────────────────

(deftest a-language-tag-is-lowercased
  (testing "canonical N-Triples case maps LANG_DIR to lowercase. NOTE: the official
            RDFC-1.0 suite has no mixed-case tag, so this rule is implemented from
            the spec text and checked only here — not corroborated by W3C vectors."
    (is (= "\"v\"@en-gb" (nq/serialize-term (nq/literal "v" nil "en-GB"))))
    (is (= "en-gb" (:language (nq/literal "v" nil "EN-GB"))))))

;; ── the grammar's own limits ──────────────────────────────────────────────────

(deftest an-iri-with-a-forbidden-character-is-refused
  (testing "the IRIREF production excludes control characters and < > \" { } | ^ `
            backslash; emitting one would produce something no parser accepts"
    (doseq [bad ["http://ex.com/a b" "http://ex.com/<" "http://ex.com/\""
                 "http://ex.com/{" "http://ex.com/|" "http://ex.com/^"
                 "http://ex.com/`" "http://ex.com/\\" "http://ex.com/\n"
                 "http://ex.com/\t"]]
      (is (= :nquads/bad-iri
             (:nquads/error (ex-data (try (nq/iri bad)
                                          (catch clojure.lang.ExceptionInfo e e)))))
          (str "should refuse: " (pr-str bad)))))
  (testing "and an ordinary IRI is fine"
    (is (= :iri (:type (nq/iri "http://example.com/a#b?c=d"))))))

(deftest a-subject-cannot-be-a-literal-and-a-predicate-must-be-an-iri
  (is (= :nquads/bad-subject
         (:nquads/error
          (ex-data (try (nq/serialize-statement {:subject (nq/literal "v")
                                                 :predicate p :object s})
                        (catch clojure.lang.ExceptionInfo e e))))))
  (is (= :nquads/bad-predicate
         (:nquads/error
          (ex-data (try (nq/serialize-statement {:subject s :predicate (nq/blank "b")
                                                 :object s})
                        (catch clojure.lang.ExceptionInfo e e)))))))

;; ── round trip ───────────────────────────────────────────────────────────────

(deftest serialize-then-parse-round-trips
  (let [statements [{:subject s :predicate p :object (nq/literal "plain")}
                    {:subject (nq/blank "b0") :predicate p :object (nq/literal "v" nil "ja")}
                    {:subject s :predicate p :object (nq/literal "typed" nq/xsd-string)}
                    {:subject s :predicate p :object (nq/blank "b1")
                     :graph (nq/iri "http://example.com/g")}
                    {:subject s :predicate p
                     :object (nq/literal "quote \" backslash \\ newline \n")}]]
    (is (= statements (nq/parse (nq/serialize-dataset statements))))))

(deftest parsing-reads-the-escapes-the-grammar-allows-even-though-we-do-not-write-them
  (testing "RDFC-1.0 has to read documents it did not write"
    (let [line "<http://ex.com/s> <http://ex.com/p> \"a\\tb\\u00E9c\" .\n"
          [st] (nq/parse line)]
      ;; a, TAB, b, e-acute, c -- the first version of this assertion dropped the
      ;; `b` and then tried to paper over the mismatch with a str/replace, which
      ;; is how a wrong expectation survives as a passing test.
      (is (= "a\tbéc" (get-in st [:object :value]))
          "ECHAR tab and UCHAR both decoded"))
    (testing "and a surrogate-pair UCHAR"
      (let [[st] (nq/parse "<http://ex.com/s> <http://ex.com/p> \"\\U0001F600\" .\n")]
        (is (= "😀" (get-in st [:object :value])))))))

(deftest comments-and-blank-lines-are-skipped-but-nothing-else-is
  (let [doc (str "# a comment\n"
                 "\n"
                 "<http://ex.com/s> <http://ex.com/p> \"v\" .\n"
                 "   # indented comment\n")]
    (is (= 1 (count (nq/parse doc)))))
  (testing "an unparseable line THROWS rather than being dropped — silently
            ignoring one loses a triple from the graph being hashed"
    (is (= :nquads/unparseable
           (:nquads/error
            (ex-data (try (nq/parse "this is not n-quads\n")
                          (catch clojure.lang.ExceptionInfo e e))))))))

(deftest an-unknown-escape-is-refused
  (is (= :nquads/bad-escape
         (:nquads/error
          (ex-data (try (nq/parse "<http://ex.com/s> <http://ex.com/p> \"a\\qb\" .\n")
                        (catch clojure.lang.ExceptionInfo e e)))))))
