;; nbb smoke test — proves the :cljs branch is real.
;;
;; The reader conditionals here decode UCHAR escapes: :clj uses Character/toChars
;; and Integer/parseInt, :cljs uses String.fromCodePoint and parseInt. A host that
;; decoded a surrogate pair differently would parse a different graph from the same
;; document — and then hash it differently, which is the failure this layer exists
;; to prevent.
;;
;;   kbb --backend sci --classpath src test/nbb_smoke.cljk
(ns nbb-smoke
  (:require [nquads.core :as nq]))

(def ^:private failures (atom 0))
(defn- check [label expected actual]
  (if (= expected actual)
    (println "  ok  " label)
    (do (swap! failures inc)
        (println "  FAIL" label "\n        expected:" (pr-str expected)
                 "\n        actual:  " (pr-str actual)))))
(defn- threw [f] (try (f) :no-throw (catch :default _ :threw)))

(def s (nq/iri "http://example.com/s"))
(def p (nq/iri "http://example.com/p"))

(println "nquads :cljs smoke")

;; Canonical N-Triples escaping. This host has its OWN code point iteration
;; (String.codePointAt / fromCodePoint / Number.toString(16)) and its own hex
;; formatting, so every rule below is re-proved here rather than assumed from the
;; JVM run — a host that disagreed would hash the same graph differently.
(check "the seven ECHARs, all at once" "\\t\\b\\n\\r\\f\\\"'\\\\"
       (nq/escape-literal "\t\b\n\r\f\"'\\"))
(check "VT is UCHAR with UPPERCASE hex" "\\u000B" (nq/escape-literal "\u000B"))
(check "DEL is UCHAR" "\\u007F" (nq/escape-literal "\u007F"))
(check "U+0000 is UCHAR (excluded from XML 1.1 Char)" "\\u0000"
       (nq/escape-literal "\u0000"))
(check "U+001A-U+001F use uppercase hex" "\\u001A\\u001F"
       (nq/escape-literal "\u001A\u001F"))
(check "C1 U+0080-U+008F match Char, so stay native" "\u0080\u008F"
       (nq/escape-literal "\u0080\u008F"))
(check "non-ascii literal" "日本語😀" (nq/escape-literal "日本語😀"))
(check "a supplementary character is ONE code point, not two escapes" "😀"
       (nq/escape-literal "😀"))
(check "text that looks like an escape is escaped, not interpreted" "\\\\u0039"
       (nq/escape-literal "\\u0039"))

;; Serialization, byte for byte — the cross-host invariant. Pinned identically in
;; test/nquads/core_test.cljk.
(check "a triple serializes"
       "<http://example.com/s> <http://example.com/p> \"v\" .\n"
       (nq/serialize-statement {:subject s :predicate p :object (nq/literal "v")}))
(check "a quad carries its graph"
       "<http://example.com/s> <http://example.com/p> \"v\" <http://example.com/g> .\n"
       (nq/serialize-statement {:subject s :predicate p :object (nq/literal "v")
                                :graph (nq/iri "http://example.com/g")}))
(check "blank node regains its prefix" "_:b0" (nq/serialize-term (nq/blank "b0")))
(check "language tag" "\"v\"@ja" (nq/serialize-term (nq/literal "v" nil "ja")))
(check "a datatype of xsd:string is NOT written" "\"v\""
       (nq/serialize-term (nq/literal "v" nq/xsd-string)))
(check "but a real datatype is" "\"v\"^^<urn:ex:dt>"
       (nq/serialize-term (nq/literal "v" "urn:ex:dt")))
(check "a language tag is lowercased" "\"v\"@en-gb"
       (nq/serialize-term (nq/literal "v" nil "en-GB")))
(check "an IRI decodes UCHAR and re-serializes natively"
       "<urn:ex:s> <urn:ex:p> <urn:ex:\u221e> .\n"
       (nq/serialize-statement
        (first (nq/parse "<urn:ex:s> <urn:ex:p> <urn:ex:\\u221e> .\n"))))

;; The reader conditional this file exists for.
(check "UCHAR \\u decodes" "a\tbéc"
       (get-in (first (nq/parse "<http://ex.com/s> <http://ex.com/p> \"a\\tb\\u00E9c\" .\n"))
               [:object :value]))
(check "UCHAR \\U decodes a surrogate pair" "😀"
       (get-in (first (nq/parse "<http://ex.com/s> <http://ex.com/p> \"\\U0001F600\" .\n"))
               [:object :value]))

;; Round trip
(let [statements [{:subject s :predicate p :object (nq/literal "plain")}
                  {:subject (nq/blank "b0") :predicate p :object (nq/literal "v" nil "ja")}
                  {:subject s :predicate p
                   :object (nq/literal "quote \" backslash \\ newline \n")}]]
  (check "serialize then parse round-trips" statements
         (nq/parse (nq/serialize-dataset statements))))

;; Fail-closed
(check "a forbidden IRI character is refused" :threw (threw #(nq/iri "http://ex.com/a b")))
(check "a literal subject is refused" :threw
       (threw #(nq/serialize-statement {:subject (nq/literal "v") :predicate p :object s})))
(check "an unparseable line throws" :threw (threw #(nq/parse "not n-quads\n")))
(check "an unknown escape throws" :threw
       (threw #(nq/parse "<http://ex.com/s> <http://ex.com/p> \"a\\qb\" .\n")))
(check "comments are skipped" 1
       (count (nq/parse "# c\n\n<http://ex.com/s> <http://ex.com/p> \"v\" .\n")))

(println (if (zero? @failures)
           "all nquads :cljs checks passed"
           (str @failures " nquads :cljs check(s) FAILED")))
(when (pos? @failures) (throw (js/Error. (str @failures " failure(s)"))))
