;; echo -- POSIX echo (IEEE Std 1003.1) as a Kotoba command.
;;
;; Writes its arguments to standard output separated by single spaces and
;; terminated by a newline. With `-n` as the first argument the newline is
;; suppressed and that argument is not printed.
;;
;; Capabilities: :cli/args (wire 38) to see the arguments, :io/write (wire 37)
;; to answer. Nothing else -- echo reads no file, so it is granted no
;; filesystem scope and could not use one if it had it.
;;
;; ## Why the numbers are text
;;
;; Both capabilities carry `:string -> :string`, because those are the
;; generic type pairs `kotoba.kir`'s native gate admits for `typed-cap-call`
;; (with i64, option-i64 and result-i64). So the argument count arrives as
;; DECIMAL TEXT and the guest has no text->number builtin. The walk therefore
;; counts UP and compares the RENDERED index against the rendered count,
;; rather than parsing one.
;;
;; ## Why the loop does not stop at the first empty answer
;;
;; An index past the end answers the empty string -- but an empty ARGUMENT is
;; legal and answers the same thing, so `echo x "" y` would stop after `x`.
;; The count comes from the EMPTY REQUEST, which no index can collide with.
(ns echo.core (:export [main]))

(defn arg [i :string] :string
  (typed-cap-call :cli/args :string :string i))

(defn emit [s :string] :string
  (typed-cap-call :io/write :string :string s))

(defn digit-text [d :i64] :string
  (string-substring "0123456789" d (+ d 1)))

;; Decimal text of a non-negative i64: the guest has no number->string
;; builtin, so digits are cut from a literal. Depth is the digit count.
(defn decimal-of [n :i64] :string
  (if (< n 10)
    (digit-text n)
    (string-concat (decimal-of (quot n 10))
                   (digit-text (- n (* 10 (quot n 10)))))))

;; A one-byte "\n", cut from a two-line literal: Kotoba source cannot write a
;; control character and has no char-to-string builtin.
(defn nl [] :string
  (string-substring "a
b" 1 2))

;; Write arguments FROM index i, space-separated. `first?` is carried rather
;; than compared against the start index, because with -n the first PRINTED
;; argument is index 1 and the separator must still be omitted before it.
(defn walk [i :i64 total :string first? :bool] :i64
  (if (string=? (decimal-of i) total)
    0
    (do
      (if first? (emit "") (emit " "))
      (emit (arg (decimal-of i)))
      (walk (+ i 1) total false))))

(defn main [] :i64
  (let [total (arg "")
        suppress? (if (string=? total "0")
                    false
                    (string=? (arg "0") "-n"))
        start (if suppress? 1 0)]
    (do
      (walk start total true)
      (if suppress? 0 (string-byte-length (emit (nl))))
      0)))
