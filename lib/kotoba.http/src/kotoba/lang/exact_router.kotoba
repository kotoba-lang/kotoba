(ns kotoba.lang.exact-router
  (:export [empty-routes route-key add-route remove-route route-count
            route-exists? resolve-route main]))

;; Pure routing policy. Transport remains a host-granted :http capability.
;; This kernel deliberately handles exact method/path routes only; parameter
;; extraction and middleware composition remain higher-level concerns.

(defn empty-routes [] [:map :string :keyword]
  (typed-map-new [:map :string :keyword]))

(defn route-key [method :string path :string] :string
  (string-concat (string-fold-case method) (string-concat " " path)))

(defn add-route [routes [:map :string :keyword]
                 method :string path :string handler :keyword]
  [:map :string :keyword]
  (typed-map-assoc [:map :string :keyword]
                   routes (route-key method path) handler))

(defn remove-route [routes [:map :string :keyword]
                    method :string path :string]
  [:map :string :keyword]
  (typed-map-dissoc [:map :string :keyword]
                    routes (route-key method path)))

(defn route-count [routes [:map :string :keyword]] :i64
  (typed-map-count [:map :string :keyword] routes))

(defn route-exists? [routes [:map :string :keyword]
                     method :string path :string] :bool
  (typed-map-contains [:map :string :keyword]
                      routes (route-key method path)))

(defn resolve-route [routes [:map :string :keyword]
                     method :string path :string]
  [:option :keyword]
  (typed-map-get [:map :string :keyword]
                 routes (route-key method path)))

(defn main [] :i64
  (let [r0 (empty-routes)
        r1 (add-route r0 "GET" "/health" :health)
        r2 (add-route r1 "post" "/runs" :create-run)
        r3 (remove-route r2 "POST" "/runs")
        health (resolve-route r3 "get" "/health")]
    (if (= (route-count r3) 1)
      (if (route-exists? r3 "GET" "/health")
        (if (= (option-or health :missing) :health)
          (if (route-exists? r3 "GET" "/missing") 4 42)
          3)
        2)
      1)))
