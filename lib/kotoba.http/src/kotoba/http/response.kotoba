;; Port of kotoba.http.response (response.cljk), Kotoba-native.
;;
;; A response is a :document map {:http/status :http/headers :http/body}.
;; Named divergences:
;;   - the source is multi-arity; amu cannot export multi-arity functions
;;     (E2138). The two arities are exported under two names:
;;       (response status headers body)  -- 3-arity
;;       (response-status status)        -- 1-arity; headers {} and body nil
;;     The source 2-arity form is not ported.
;;   - (or headers {}) becomes: a null headers document -> empty document map.
(ns kotoba.http.response
  (:export [response response-status]))

(defn response [status :i64 headers :document body :document] :document
  (document-map :http/status (document-i64 status)
                :http/headers (if (document-equal? headers (document-null)) (document-map) headers)
                :http/body body))

(defn response-status [status :i64] :document
  (response status (document-map) (document-null)))
