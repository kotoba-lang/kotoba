;; Port of kotoba.http.set-header (set_header.cljk), Kotoba-native.
;;
;; Associates a header, replacing any case-variant of the same name.
;; Named divergences:
;;   - the source lower-cases with kotoba.lang.text str/lower; this port uses
;;     the builtin string-fold-ascii (ASCII lower-case), which is identical for
;;     HTTP header names and needs no module dependency.
;;   - only string keys can match a name; a non-string key is kept as-is
;;     (the source would compare its str form).
;;   - the result keeps the original key order of the non-matching entries
;;     by iteration; document maps are compared by content, not order.
(ns kotoba.http.set-header
  (:export [set-header]))

(defn- entry-part [m :document i :i64 j :i64] :document
  (option-value-of [:option :document]
                   (document-vector-at
                    (option-value-of [:option :document] (document-map-entry-at m i) (document-vector))
                    j)
                   (document-null)))

(defn set-header [headers :document name :string value :document] :document
  (let [target (string-fold-ascii name)
        n (document-count headers)]
    (loop [i 0 acc (document-map)]
      (if (>= i n)
        (document-assoc acc (document-string name) value)
        (let [k (entry-part headers i 0)
              v (entry-part headers i 1)
              same (and (= (document-kind k) :string)
                        (string=? (string-fold-ascii (option-value-of [:option :string] (document-string-value k) "")) target))]
          (recur (+ i 1) (if same acc (document-assoc acc k v))))))))
