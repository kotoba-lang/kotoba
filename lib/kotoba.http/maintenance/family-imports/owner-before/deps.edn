{:paths ["src"]
 :version "0.1.0"
 ;; kotoba-lang/http — Layer 3 (I/O) of the kotoba foundational stdlib.
 ;; Request/response data model + pure parse-url + an IHttp protocol the HOST
 ;; injects (no baked-in HTTP client) so it runs on kotoba-WASM. No third-party
 ;; deps; the only dep is the sibling kotoba-lang/json (first-party, zero-dep)
 ;; for JSON request/response body helpers. .cljc.
 ;; See ADR-kotoba-lang-foundational-stdlib.md.
 :deps {
        ;; kotoba.lang.error replaced clojure.lang.ExceptionInfo here (2026-09-25).
        ;; An explicit floor: tools.deps takes the NEWEST sha it is shown.
        io.github.kotoba-lang/error {:git/sha "838dec56c9a5b74f9eec825a2fb28bda157f8cd3"}
        ;; kotoba.test (clojure.test-compatible surface), not clojure.test --
        ;; scripts/migrate-clojure-test-to-kotoba-test.cljk. Explicit floor.
        io.github.kotoba-lang/test {:git/url "https://github.com/kotoba-lang/test.git"
                                    :git/sha "2ab4885f99fd25552d380d0f6b0b54c5a72eb7ae"}
        ;; kotoba.bytes replaced UTF-8 .getBytes / String. here (2026-09-24). An explicit
        ;; floor: tools.deps takes the NEWEST sha it is shown.
        io.github.kotoba-lang/bytes {:git/sha "7a286888fcd9288ea1c5136f82a84749e70175cd"}
        io.github.kotoba-lang/http-http
        {:git/url "https://github.com/kotoba-lang/http-http.git"
         :git/sha "f7495072017e9c7f04576bd6233f3bd39005688e"}
        io.github.kotoba-lang/http-decode-json-body
        {:git/url "https://github.com/kotoba-lang/http-decode-json-body.git"
         :git/sha "c830f63eb75b1081d689dc194a3e3c6aef59e573"}
        io.github.kotoba-lang/http-fold-headers
        {:git/url "https://github.com/kotoba-lang/http-fold-headers.git"
         :git/sha "41c530b976f159ca55056e80fee6e817deb0c17c"}
        io.github.kotoba-lang/http-header
        {:git/url "https://github.com/kotoba-lang/http-header.git"
         :git/sha "ad39da57026254369bab7818252b1f1b5bdd1173"}
        io.github.kotoba-lang/http-mock-http
        {:git/url "https://github.com/kotoba-lang/http-mock-http.git"
         :git/sha "8cad99ec188c291ff4a4905ce5cda3522ebb9f26"}
        io.github.kotoba-lang/http-parse-url
        {:git/url "https://github.com/kotoba-lang/http-parse-url.git"
         :git/sha "df88f9a1578cd14eea0619f0a8d77b6682fdd8ed"}
        io.github.kotoba-lang/http-request
        {:git/url "https://github.com/kotoba-lang/http-request.git"
         :git/sha "7c7d7c34f70ae47442730088b760c7a155be4124"}
        io.github.kotoba-lang/http-request-json
        {:git/url "https://github.com/kotoba-lang/http-request-json.git"
         :git/sha "38f7341c36b7b49fc8add0e9ba70029733aa820b"}
        io.github.kotoba-lang/http-response
        {:git/url "https://github.com/kotoba-lang/http-response.git"
         :git/sha "ed1b1a32a889da9490a5436aaf4db9a933c96218"}
        io.github.kotoba-lang/http-set-header
        {:git/url "https://github.com/kotoba-lang/http-set-header.git"
         :git/sha "0d34c33367b26ff33db57468d5ce338c167b790c"}


io.github.kotoba-lang/json {:git/sha "ae1f323a424119a04078e3a3bcbebdc5b4d321c7"}
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}
                      ;; host/httpkit_test.cljc loads host/httpkit.cljc, which
                      ;; requires org.httpkit.server. Without it here the
                      ;; DOCUMENTED command (README) and the one CI runs --
                      ;; plain `kbb -M:test` -- dies during load rather
                      ;; than running a test, measured on main 2026-09-09.
                      ;; Test scope, so httpkit still never reaches :deps and
                      ;; is still not shipped; what changes is that the
                      ;; command this repo tells people to run now works.
                      http-kit/http-kit {:mvn/version "2.8.1"}
                      io.github.kotoba-lang/amu
                      {:git/url "https://github.com/kotoba-lang/amu.git"
                       :git/sha "1e6dbb17d314cf45d3dd6796a6a9d5cb84b437b2"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}

  ;; Live composition proof (scripts/live_fetch.cljk). org-ietf-tls is a
  ;; SCRIPT-SCOPE dependency and appears nowhere in :deps -- `http` is Layer 3
  ;; of the foundational stdlib and must not depend on TLS. The wire client
  ;; takes an injected byte transport; this alias only supplies one real
  ;; instance of it so the composition can be run against the public internet.
  :live {:extra-deps {io.github.kotoba-lang/org-ietf-tls
                      {:git/url "https://github.com/kotoba-lang/org-ietf-tls.git"
                       :git/sha "b91d4a144e7ce89380643e440f7eac48d91e45a4"}}}

  ;; clj-kondo as a Clojars lib (no Homebrew/system install needed).
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}

  ;; Host adapters — script/engine scope only; not in top-level :deps.
  :httpkit-host {:extra-deps {http-kit/http-kit {:mvn/version "2.8.1"}}}
  :babashka-client-host {:extra-deps {org.babashka/http-client {:mvn/version "0.4.23"}}}}}
