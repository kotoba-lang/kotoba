;; Test for kotoba.http.response. main returns the number of failed cases.
(ns kotoba.http.response-test
  (:export [main])
  (:require [kotoba.http.response :as r]))

(defn- g [m :document k :keyword] :document
  (option-value-of [:option :document] (document-get m k) (document-null)))
(defn- i64v [m :document k :keyword] :i64
  (option-value-of [:option :i64] (document-i64-value (g m k)) -1))
(defn- strv [m :document k :keyword] :string
  (option-value-of [:option :string] (document-string-value (g m k)) "<none>"))
(defn- chk-i64 [got :i64 want :i64] :i64
  (if (= got want) 0 1))
(defn- chk-str [got :string want :string] :i64
  (if (string=? got want) 0 1))

(defn main [] :i64
  (let [a (r/response 200 (document-assoc (document-map) (document-string "x") (document-string "y")) (document-string "hi"))
        a1 (chk-i64 (i64v a :http/status) 200)
        a2 (chk-str (strv a :http/body) "hi")
        a3 (chk-i64 (document-count (g a :http/headers)) 1)
        o (r/response-status 404)
        o1 (chk-i64 (i64v o :http/status) 404)
        o2 (chk-i64 (document-count (g o :http/headers)) 0)
        o3 (if (document-equal? (g o :http/body) (document-null)) 0 1)
        n (r/response 201 (document-null) (document-null))
        n1 (chk-i64 (i64v n :http/status) 201)
        n2 (chk-i64 (document-count (g n :http/headers)) 0)]
    (+ a1 (+ a2 (+ a3 (+ o1 (+ o2 (+ o3 (+ n1 n2)))))))))
