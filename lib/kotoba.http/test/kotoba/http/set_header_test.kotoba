;; Test for kotoba.http.set-header. main returns the number of failed cases.
(ns kotoba.http.set-header-test
  (:export [main])
  (:require [kotoba.http.set-header :as s]))

(defn- gs [m :document k :string] :document
  (option-value-of [:option :document] (document-get m (document-string k)) (document-null)))
(defn- strv [m :document k :string] :string
  (option-value-of [:option :string] (document-string-value (gs m k)) "<none>"))
(defn- chk-i64 [got :i64 want :i64] :i64
  (if (= got want) 0 1))
(defn- chk-str [got :string want :string] :i64
  (if (string=? got want) 0 1))

(defn main [] :i64
  (let [h (document-assoc (document-assoc (document-map) (document-string "Content-Type") (document-string "a"))
                          (document-string "X-K") (document-string "b"))
        out (s/set-header h "content-type" (document-string "c"))
        a (chk-i64 (document-count out) 2)
        b (chk-str (strv out "content-type") "c")
        c (chk-i64 (if (document-contains out (document-string "Content-Type")) 1 0) 0)
        d (chk-str (strv out "X-K") "b")
        fresh (s/set-header (document-map) "Accept" (document-string "t"))
        e (chk-i64 (document-count fresh) 1)
        f (chk-str (strv fresh "Accept") "t")]
    (+ a (+ b (+ c (+ d (+ e f)))))))
