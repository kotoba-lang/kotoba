(ns kotoba.http.form-urlencoded-test
  "kotoba.http.form-urlencoded against java.net.URLEncoder / URLDecoder
  (UTF-8), JDK 21 (Temurin 21.0.1) as the oracle.

  form_urlencoded_vectors.tsv was written by the JDK, one case per line:
    op TAB input TAB (OK TAB output | ERR TAB IllegalArgumentException message)
  op is E (URLEncoder/encode s UTF_8) or D (URLDecoder/decode s UTF_8); every
  string is 4 hex digits per UTF-16 code unit, so lone surrogates survive the
  file. The set: all of ASCII in one string and one by one, every 97th BMP
  code unit, lone / paired / crossed surrogates, 300 random strings (ASCII,
  Latin-1, BMP, astral, lone high, lone low), %XY%ZW over a byte grid, %0c and
  %c0 for a stride of the BMP plus every Arabic-Indic / fullwidth digit and
  letter, 800 random escape runs weighted to UTF-8 lead / continuation bytes,
  300 encode->decode round trips and 300 random mixtures of '+', '%', bad
  escapes, raw non-ASCII and surrogates."
  (:require [clojure.string :as str]
            [kotoba.test :refer [deftest is testing]]
            [kotoba.http.form-urlencoded :as f]))

(def vectors-path "lib/kotoba.http/test/kotoba/http/form_urlencoded_vectors.tsv")

(defn- read-text [p]
  #?(:clj (slurp p)
     :cljs (.readFileSync (js/require "fs") p "utf8")))

(defn- unhex [h]
  (apply str (for [k (range 0 (count h) 4)]
               (char #?(:clj (Integer/parseInt (subs h k (+ k 4)) 16)
                        :cljs (js/parseInt (subs h k (+ k 4)) 16))))))

(defn- outcome [f s]
  (try [:ok (f s)]
       (catch #?(:clj Exception :cljs :default) x [:err (ex-message x)])))

(deftest jdk-vectors
  (let [lines (remove str/blank? (str/split-lines (read-text vectors-path)))
        rows (for [l lines :let [[op in kind out] (str/split l #"\t" -1)]]
               {:op op :in (unhex in) :want [(if (= kind "OK") :ok :err) (unhex out)]})
        bad (remove (fn [{:keys [op in want]}]
                      (= want (outcome (if (= op "E") f/form-encode f/form-decode) in)))
                    rows)
        counts (frequencies (map :op rows))]
    (testing "the fixture was read (an empty file must not pass)"
      (is (< 1000 (get counts "E" 0)))
      (is (< 2500 (get counts "D" 0)))
      (is (< 800 (count (filter #(= :err (first (:want %))) rows)))))
    (testing "0 mismatches against the JDK"
      (is (= [] (vec (take 5 (map #(select-keys % [:op :in]) bad)))))
      (is (zero? (count bad))))))

(deftest documented-examples
  (is (= "a+b%26c%3D%C3%BC" (f/form-encode "a b&c=ü")))
  (is (= "a b&c" (f/form-decode "a+b%26c")))
  (is (= "-_.*" (f/form-encode "-_.*")))
  (is (= "%7E" (f/form-encode "~")))
  (testing "surrogates: a pair is one code point, a lone one is '?'"
    (is (= "%F0%9F%98%80" (f/form-encode "😀")))
    (is (= "%3F" (f/form-encode "\uD800")))
    (is (= "%3F%F0%90%80%80" (f/form-encode "\uD800𐀀"))))
  (testing "decode: the JDK's replacement and its lenient hex"
    (is (= "�" (f/form-decode "%ED%A0%80")))
    (is (= "\u000F" (f/form-decode "%+F")))
    (is (= "\u0000" (f/form-decode "%-0")))
    (is (= "\n" (f/form-decode "%０Ａ")))))

(defn- error-kind [s]
  (try (f/form-decode s) nil
       (catch #?(:clj Exception :cljs :default) x (::f/error (ex-data x)))))

(deftest decode-refusals-name-their-reason
  (is (= :incomplete-escape (error-kind "%")))
  (is (= :incomplete-escape (error-kind "abc%4")))
  (is (= :incomplete-escape (error-kind "%41%")))
  (is (= :illegal-hex (error-kind "%4g")))
  (is (= :illegal-hex (error-kind "%++")))
  (is (= :negative-value (error-kind "%-1")))
  (is (nil? (error-kind "%41"))))

(deftest not-a-string
  (is (= :not-a-string (try (f/form-encode nil) nil
                            (catch #?(:clj Exception :cljs :default) x (::f/error (ex-data x))))))
  (is (= :not-a-string (try (f/form-decode 42) nil
                            (catch #?(:clj Exception :cljs :default) x (::f/error (ex-data x)))))))
