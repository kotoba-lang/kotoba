[{:resources.mangaka-expression-patterns/source "HUNTER×HUNTER 王位継承戦編（冨樫義博）のコマ観察。抽出した漫画文法:\n  (1) モブ群衆の“ざわめき”= 薄い小さな手書き文字＋小さな雲形吹き出し＋群衆シルエット背景(:chatter),\n  (2) キャラ名札 = 黒箱に白抜きゴシック(:nameplate),\n  (3) 割り込み/元気 = 挙手＋放射状の集中線背景＋太く大きなトゲ/バースト吹き出し(:energetic + :shout),\n  (4) 激昂アップ = 前傾＋歯剥き＋黒トゲ/フラッシュ背景＋汗・怒張, 太く大きい(:hot-blooded + :shout),\n  (5) 冷酷/威圧 = 直立＋重い影(暗いビネット)＋太明朝の決め台詞(:cold-menace),\n  (6) 独白/地の文 = 明朝の囲み(:monologue/:narration)。", :resources.mangaka-expression-patterns/default-register :speech, :resources.mangaka-expression-patterns/expression-cues "{\"Neutral\" {:posture :upright, :marks [], :tone-bias :none}, \"Happy\" {:posture :arm-raised, :marks [:sparkle], :tone-bias :flat-white}, \"Angry\" {:posture :lean-in, :marks [:anger-vein :sweat], :tone-bias :focus-lines}, \"Sad\" {:posture :turn-away, :marks [:tear], :tone-bias :gradient}, \"Surprised\" {:posture :recoil, :marks [:shock :exclaim], :tone-bias :flash}, \"Determined\" {:posture :upright, :marks [], :tone-bias :focus-lines}, \"Pained\" {:posture :slump, :marks [:sweat], :tone-bias :hatching}, \"Smirk\" {:posture :cross-arms, :marks [], :tone-bias :vignette-dark}}", :resources.mangaka-expression-patterns/default-archetype :stoic, :db/id -1, :resources.mangaka-expression-patterns/version 1, :resources.mangaka-expression-patterns/observations "[{:panel \"election-guards\", :who [\"ナイベイン\" \"トアアスタ\" \"リズルタ\" \"ガター\"], :note \"名札=黒箱に白抜きゴシック(:nameplate)。背景のモブは群衆シルエット＋薄い小雲(:chatter, weight :faint, scale 0.7)。ガターの激昂アップは黒トゲ背景(:hot-blooded + :shout → :focus-lines/:flash)＋汗・怒張。\"} {:panel \"slakka-interrupt\", :who [\"スラッカ\"], :note \"挙手＋放射状集中線(:energetic archetype → :radial-burst)。割り込み『ちょっといいかな?』は太く大きなトゲ/バースト(:shout / :burst)。\"} {:panel \"standoff\", :who [], :note \"対峙アップはグラデ/ビネットでテンション。『バカな!!』は :shout(spike, :heavy, scale 1.6, :flash)。冷酷側は :cold-menace(暗ビネット, 太明朝)。\"}]", :resources.mangaka-expression-patterns/registers "{:chatter {:bubble :cloud, :weight :faint, :scale 0.7, :font-role :handwritten, :tone :crowd-silhouette}, :shout {:bubble :spike, :weight :heavy, :scale 1.6, :tone :flash, :fx [:speed-lines], :marks [:anger-vein :sweat]}, :monologue {:bubble :square, :weight :regular, :scale 0.95, :font-role :mincho}, :thought {:bubble :cloud, :weight :light, :scale 0.95, :font-role :mincho, :dashed true}, :nameplate {:bubble :square, :weight :bold, :scale 0.9, :font-role :gothic, :invert true}, :narration {:bubble :square, :weight :regular, :scale 0.95, :font-role :mincho}, :speech {:bubble :oval, :weight :regular, :scale 1.0}, :sfx {:weight :heavy, :scale 1.8, :font-role :brush, :rotate -8}, :whisper {:bubble :oval, :weight :light, :scale 0.8, :font-role :handwritten}}", :resources.mangaka-expression-patterns/intensity "{:scale-gain 0.6, :scale-max 2.4, :weight-steps [[0.66 1] [0.9 2]], :tone-threshold 0.4, :subtle-tone :dot}", :resources.mangaka-expression-patterns/context "https://kami.etzhayyim.com/mangaka-expression/v1", :resources.mangaka-expression-patterns/vocab "{:register #{:chatter :shout :monologue :thought :nameplate :narration :speech :sfx :whisper}, :bubble #{:wavy :cloud :oval :jagged :burst :square :spike}, :expression #{\"Happy\" \"Smirk\" \"Pained\" \"Angry\" \"Sad\" \"Determined\" \"Surprised\" \"Neutral\"}, :font-role #{:gothic :horror :brush :mincho :handwritten :maru :bold-mincho :antigochi :kyokasho :digital}, :weight [:faint :light :regular :bold :heavy], :tone #{:radial-burst :flash :flat-white :vignette-dark :focus-lines :gradient :hatching :dot :crowd-silhouette :none}, :posture #{:cross-arms :lean-in :turn-away :arm-raised :recoil :slump :upright :point}, :mark #{:exclaim :question :tear :sparkle :shock :anger-vein :sweat}}", :resources.mangaka-expression-patterns/archetypes "{:strategist {:expression \"Determined\", :font-role :mincho, :weight :regular, :posture :upright, :bubble :oval, :tone :flat-white}, :hot-blooded {:expression \"Angry\", :font-role :gothic, :weight :bold, :posture :lean-in, :bubble :jagged, :tone :focus-lines}, :cold-menace {:expression \"Smirk\", :font-role :bold-mincho, :weight :bold, :posture :cross-arms, :bubble :oval, :tone :vignette-dark}, :energetic {:expression \"Happy\", :font-role :gothic, :weight :bold, :posture :arm-raised, :bubble :burst, :tone :radial-burst}, :gentle {:expression \"Neutral\", :font-role :maru, :weight :regular, :posture :upright, :bubble :oval, :tone :flat-white}, :stoic {:expression \"Neutral\", :font-role :gothic, :weight :regular, :posture :upright, :bubble :oval, :tone :none}, :mob {:expression \"Neutral\", :font-role :handwritten, :weight :faint, :posture :upright, :bubble :cloud, :tone :crowd-silhouette}}"}]