{:version 1
 :context "https://kami.etzhayyim.com/mangaka-expression/hume-face/v1"
 :measurement-semantics
 {:value :observer-interpretation-confidence
  :not #{:inner-emotion :emotion-intensity :diagnosis}
  :guidance "Keep a multi-dimensional profile. A label describes how an expression may be interpreted, not what the person is feeling. Use :intensity separately for manga exaggeration."}
 :research
 [{:title "Hume AI use case guidelines"
   :url "https://dev.hume.ai/docs/resources/use-case-guidelines"
   :used-for [:measurement-semantics :multi-dimensional-profile :culture-caution]}
  {:title "Deep learning reveals what facial expressions mean to people in different cultures"
   :url "https://doi.org/10.1016/j.isci.2024.108570"
   :used-for [:cross-cultural-variation :many-to-many-expression-meaning]}
  {:title "Facial movements have over twenty dimensions of perceived meaning"
   :url "https://psyarxiv.com/7p2e5/"
   :used-for [:facial-movement-dimensionality :facs-complement]}
  {:title "Hume FACS 2.0 explorer"
   :url "https://www.hume.ai/explore/facs"
   :used-for [:action-unit-grounding :head-and-eye-features]}]

 :families
 {:affiliation       {:ja "親和・愛着" :valence :positive :energy :low-to-medium}
  :wonder            {:ja "畏敬・没入" :valence :positive :energy :medium}
  :play              {:ja "愉快・遊び" :valence :positive :energy :medium-to-high}
  :reward            {:ja "満足・達成" :valence :positive :energy :low-to-high}
  :attention         {:ja "注意・思考" :valence :mixed :energy :low-to-medium}
  :agency            {:ja "意志・前進" :valence :mixed :energy :medium-to-high}
  :wanting           {:ja "欲求・接近" :valence :mixed :energy :medium}
  :social-evaluation {:ja "対人評価・自己意識" :valence :mixed-to-negative :energy :low-to-medium}
  :uncertainty       {:ja "不確実・困惑" :valence :mixed :energy :medium}
  :threat            {:ja "脅威・警戒" :valence :negative :energy :high}
  :loss              {:ja "喪失・落胆" :valence :negative :energy :low}
  :suffering         {:ja "苦痛・共感痛" :valence :negative :energy :medium-to-high}
  :aversion          {:ja "嫌悪・拒絶" :valence :negative :energy :medium}
  :fatigue           {:ja "疲労・離脱" :valence :negative :energy :low}
  :surprise          {:ja "驚き・更新" :valence :mixed :energy :high}}

 ;; Hume's 48 expression dimensions. These are a classification bridge, not a
 ;; claim that any one facial construction uniquely identifies an emotion.
 :dimensions
 {"Admiration"             {:family :affiliation :rig :soft-wide}
  "Adoration"              {:family :affiliation :rig :soft-joy}
  "Aesthetic Appreciation" {:family :wonder :rig :soft-wide}
  "Amusement"              {:family :play :rig :laughing-closed}
  "Anger"                  {:family :threat :rig :anger-glare}
  "Anxiety"                {:family :threat :rig :fear-wide}
  "Awe"                    {:family :wonder :rig :wide-reveal}
  "Awkwardness"            {:family :social-evaluation :rig :asymmetric-uneasy}
  "Boredom"                {:family :fatigue :rig :tired-heavy}
  "Calmness"               {:family :attention :rig :neutral-soft}
  "Concentration"          {:family :attention :rig :focused-narrow}
  "Confusion"              {:family :uncertainty :rig :asymmetric-question}
  "Contemplation"          {:family :attention :rig :averted-thought}
  "Contempt"               {:family :aversion :rig :contempt-asymmetric}
  "Contentment"            {:family :reward :rig :soft-joy}
  "Craving"                {:family :wanting :rig :intent-wide}
  "Desire"                 {:family :wanting :rig :intent-wide}
  "Determination"          {:family :agency :rig :focused-narrow}
  "Disappointment"         {:family :loss :rig :sad-droop}
  "Disgust"                {:family :aversion :rig :disgust-squint}
  "Distress"               {:family :suffering :rig :fear-wide}
  "Doubt"                  {:family :uncertainty :rig :asymmetric-question}
  "Ecstasy"                {:family :reward :rig :laughing-closed}
  "Embarrassment"          {:family :social-evaluation :rig :asymmetric-uneasy}
  "Empathic Pain"          {:family :suffering :rig :pain-squeeze}
  "Entrancement"           {:family :wonder :rig :entranced-glow}
  "Envy"                   {:family :social-evaluation :rig :side-eye}
  "Excitement"             {:family :play :rig :wide-joy}
  "Fear"                   {:family :threat :rig :fear-wide}
  "Guilt"                  {:family :social-evaluation :rig :downcast}
  "Horror"                 {:family :threat :rig :fear-wide}
  "Interest"               {:family :attention :rig :attentive}
  "Joy"                    {:family :play :rig :soft-joy}
  "Love"                   {:family :affiliation :rig :soft-joy}
  "Nostalgia"              {:family :loss :rig :distant-soft}
  "Pain"                   {:family :suffering :rig :pain-squeeze}
  "Pride"                  {:family :reward :rig :focused-wide}
  "Realization"            {:family :surprise :rig :wide-reveal}
  "Relief"                 {:family :reward :rig :soft-droop}
  "Romance"                {:family :affiliation :rig :soft-joy}
  "Sadness"                {:family :loss :rig :sad-droop}
  "Satisfaction"           {:family :reward :rig :soft-joy}
  "Shame"                  {:family :social-evaluation :rig :downcast}
  "Surprise (negative)"    {:family :surprise :rig :fear-wide}
  "Surprise (positive)"    {:family :surprise :rig :wide-joy}
  "Sympathy"               {:family :affiliation :rig :sad-soft}
  "Tiredness"              {:family :fatigue :rig :tired-heavy}
  "Triumph"                {:family :agency :rig :focused-wide}}

 :eye-vocab
 {:lid-curve #{:flat :soft-arc :raised-arc :downturned :pinched :angular}
  :brow-shape #{:neutral :inner-raised :outer-raised :lowered :knit :one-raised :sad-slope}
  :gaze #{:forward :at-subject :up :down :side :away :unfocused}
  :highlight #{:none :single :double :star :wet}
  :tear #{:none :rim :pool :stream}}

 ;; Numeric fields are renderer-independent, normalized semantic controls.
 ;; :open 0 = shut, 1 = maximally open; pupil/iris are relative to neutral.
 :rigs
 {:neutral-soft        {:scene-expression "Neutral"    :eyes {:open 0.55 :upper-lid :soft-arc  :lower-lid :soft-arc  :brow :neutral      :pupil 1.00 :iris 1.00 :gaze :at-subject :highlight :single :tear :none :asymmetry 0.00} :mouth :rest}
  :soft-wide           {:scene-expression "Happy"      :eyes {:open 0.68 :upper-lid :raised-arc :lower-lid :soft-arc  :brow :outer-raised :pupil 1.02 :iris 1.04 :gaze :at-subject :highlight :double :tear :none :asymmetry 0.00} :mouth :soft-smile}
  :soft-joy            {:scene-expression "Happy"      :eyes {:open 0.40 :upper-lid :soft-arc  :lower-lid :raised-arc :brow :neutral      :pupil 1.02 :iris 1.02 :gaze :at-subject :highlight :double :tear :none :asymmetry 0.00} :mouth :smile}
  :laughing-closed     {:scene-expression "Happy"      :eyes {:open 0.02 :upper-lid :raised-arc :lower-lid :raised-arc :brow :outer-raised :pupil 1.00 :iris 1.00 :gaze :forward    :highlight :none   :tear :rim  :asymmetry 0.03} :mouth :open-laugh}
  :wide-joy            {:scene-expression "Happy"      :eyes {:open 0.88 :upper-lid :raised-arc :lower-lid :raised-arc :brow :outer-raised :pupil 1.08 :iris 1.05 :gaze :at-subject :highlight :star   :tear :none :asymmetry 0.00} :mouth :open-smile}
  :wide-reveal         {:scene-expression "Surprised"  :eyes {:open 0.96 :upper-lid :raised-arc :lower-lid :soft-arc  :brow :inner-raised :pupil 0.82 :iris 0.93 :gaze :forward    :highlight :double :tear :none :asymmetry 0.00} :mouth :small-open}
  :fear-wide           {:scene-expression "Surprised"  :eyes {:open 1.00 :upper-lid :raised-arc :lower-lid :pinched   :brow :inner-raised :pupil 0.58 :iris 0.86 :gaze :at-subject :highlight :single :tear :rim  :asymmetry 0.04} :mouth :tense-open}
  :anger-glare         {:scene-expression "Angry"      :eyes {:open 0.42 :upper-lid :angular    :lower-lid :pinched   :brow :lowered      :pupil 0.78 :iris 0.90 :gaze :at-subject :highlight :single :tear :none :asymmetry 0.02} :mouth :teeth-clench}
  :focused-narrow      {:scene-expression "Determined" :eyes {:open 0.38 :upper-lid :angular    :lower-lid :flat      :brow :knit         :pupil 0.92 :iris 0.96 :gaze :at-subject :highlight :single :tear :none :asymmetry 0.00} :mouth :firm}
  :focused-wide        {:scene-expression "Determined" :eyes {:open 0.68 :upper-lid :angular    :lower-lid :soft-arc  :brow :lowered      :pupil 0.92 :iris 0.98 :gaze :at-subject :highlight :double :tear :none :asymmetry 0.00} :mouth :confident-smile}
  :attentive           {:scene-expression "Neutral"    :eyes {:open 0.72 :upper-lid :raised-arc :lower-lid :soft-arc  :brow :outer-raised :pupil 1.04 :iris 1.02 :gaze :at-subject :highlight :double :tear :none :asymmetry 0.00} :mouth :rest}
  :intent-wide         {:scene-expression "Determined" :eyes {:open 0.70 :upper-lid :angular    :lower-lid :soft-arc  :brow :knit         :pupil 1.12 :iris 1.02 :gaze :at-subject :highlight :wet    :tear :none :asymmetry 0.00} :mouth :parted}
  :sad-droop           {:scene-expression "Sad"        :eyes {:open 0.38 :upper-lid :downturned :lower-lid :soft-arc  :brow :sad-slope    :pupil 0.96 :iris 1.00 :gaze :down       :highlight :wet    :tear :pool :asymmetry 0.02} :mouth :downturn}
  :sad-soft            {:scene-expression "Sad"        :eyes {:open 0.48 :upper-lid :downturned :lower-lid :soft-arc  :brow :inner-raised :pupil 1.00 :iris 1.00 :gaze :at-subject :highlight :wet    :tear :rim  :asymmetry 0.00} :mouth :soft-downturn}
  :soft-droop          {:scene-expression "Happy"      :eyes {:open 0.34 :upper-lid :soft-arc  :lower-lid :raised-arc :brow :inner-raised :pupil 1.00 :iris 1.00 :gaze :down       :highlight :wet    :tear :rim  :asymmetry 0.00} :mouth :exhale-smile}
  :pain-squeeze        {:scene-expression "Pained"     :eyes {:open 0.02 :upper-lid :pinched   :lower-lid :pinched   :brow :knit         :pupil 0.82 :iris 0.94 :gaze :forward    :highlight :none   :tear :stream :asymmetry 0.08} :mouth :grimace}
  :disgust-squint      {:scene-expression "Pained"     :eyes {:open 0.24 :upper-lid :pinched   :lower-lid :raised-arc :brow :lowered      :pupil 0.88 :iris 0.96 :gaze :away       :highlight :single :tear :none :asymmetry 0.06} :mouth :upper-lip-raise}
  :contempt-asymmetric {:scene-expression "Smirk"      :eyes {:open 0.36 :upper-lid :angular    :lower-lid :flat      :brow :one-raised   :pupil 0.90 :iris 0.98 :gaze :side       :highlight :single :tear :none :asymmetry 0.28} :mouth :one-corner-smirk}
  :asymmetric-question {:scene-expression "Neutral"    :eyes {:open 0.58 :upper-lid :raised-arc :lower-lid :flat      :brow :one-raised   :pupil 0.96 :iris 1.00 :gaze :side       :highlight :single :tear :none :asymmetry 0.22} :mouth :uncertain}
  :asymmetric-uneasy   {:scene-expression "Pained"     :eyes {:open 0.44 :upper-lid :downturned :lower-lid :pinched   :brow :one-raised   :pupil 0.92 :iris 0.98 :gaze :away       :highlight :single :tear :none :asymmetry 0.18} :mouth :uneasy-smile}
  :side-eye            {:scene-expression "Smirk"      :eyes {:open 0.36 :upper-lid :flat       :lower-lid :flat      :brow :one-raised   :pupil 0.88 :iris 0.97 :gaze :side       :highlight :single :tear :none :asymmetry 0.16} :mouth :tight}
  :downcast            {:scene-expression "Sad"        :eyes {:open 0.30 :upper-lid :downturned :lower-lid :soft-arc  :brow :sad-slope    :pupil 0.94 :iris 0.99 :gaze :down       :highlight :none   :tear :none :asymmetry 0.04} :mouth :compressed}
  :tired-heavy         {:scene-expression "Neutral"    :eyes {:open 0.22 :upper-lid :downturned :lower-lid :flat      :brow :neutral      :pupil 0.96 :iris 1.00 :gaze :unfocused  :highlight :none   :tear :none :asymmetry 0.06} :mouth :slack}
  :averted-thought     {:scene-expression "Neutral"    :eyes {:open 0.46 :upper-lid :soft-arc  :lower-lid :flat      :brow :neutral      :pupil 0.98 :iris 1.00 :gaze :up         :highlight :single :tear :none :asymmetry 0.03} :mouth :rest}
  :distant-soft        {:scene-expression "Sad"        :eyes {:open 0.42 :upper-lid :downturned :lower-lid :soft-arc  :brow :inner-raised :pupil 0.98 :iris 1.00 :gaze :unfocused  :highlight :wet    :tear :rim  :asymmetry 0.00} :mouth :faint-smile}
  :entranced-glow      {:scene-expression "Happy"      :eyes {:open 0.80 :upper-lid :raised-arc :lower-lid :soft-arc  :brow :outer-raised :pupil 1.18 :iris 1.08 :gaze :at-subject :highlight :star   :tear :none :asymmetry 0.00} :mouth :parted}}

 :manga-grammar
 {:subtle {:intensity [0.0 0.33] :line-weight :light :detail :micro :background :none}
  :readable {:intensity [0.34 0.66] :line-weight :regular :detail :standard :background :supportive}
  :emphatic {:intensity [0.67 1.0] :line-weight :bold :detail :exaggerated :background :dramatic}}

 :references-from-attached-pages
 [{:pattern :paired-contrast :note "同じ顔で開眼量・瞳孔・眉だけを変え、内面の切替を読ませる。"}
  {:pattern :eye-first :note "目と眉を先に定め、口や輪郭はその後に追従させる。"}
  {:pattern :sclera-and-pupil :note "白目の露出と瞳孔比で警戒・驚愕・集中を分離する。"}
  {:pattern :asymmetry :note "左右差で疑念・気まずさ・軽蔑など単純な基本感情に還元しにくい表出を作る。"}
  {:pattern :intensity-ladder :note "同じ表出を微細・通常・誇張の三段階で描き分ける。"}]}
