(ns kotoba.lsp-rpc.response-test
  (:export [main])
  (:require [kotoba.lsp-rpc.response :as r]))

(defn- str-at [d :document k :keyword] :string
  (option-or (document-string-value (option-or (document-get d k) (document-null))) "<none>"))

(defn- i64-at [d :document k :keyword] :i64
  (option-or (document-i64-value (option-or (document-get d k) (document-null))) -1))

(defn main [] :i64
  (let [m (r/response (document-i64 1) (document-string "ok"))
        n (r/response (document-null) (document-null))]
    (+ (if (string=? (str-at m :jsonrpc) "2.0") 0 1)
       (if (= (i64-at m :id) 1) 0 1)
       (if (string=? (str-at m :result) "ok") 0 1)
       (if (string=? (str-at n :jsonrpc) "2.0") 0 1)
       (if (string=? (str-at n :result) "<none>") 0 1))))
