(ns kotoba.lsp-rpc.error-response-test (:export [main]) (:require [kotoba.lsp-rpc.error-response :as p]))

(defn- ok [b :bool] :i64
  (if b 0 1))

(defn- plain-expected [] :document
  (document-map :jsonrpc (document-string "2.0")
                :id (document-i64 1)
                :error (document-map :code (document-i64 -32600) :message (document-string "bad"))))

(defn- data-expected [] :document
  (document-map :jsonrpc (document-string "2.0")
                :id (document-i64 1)
                :error (document-map :code (document-i64 -32600) :message (document-string "bad")
                                     :data (document-string "x"))))

(defn main [] :i64
  (+ (ok (document-equal? (p/error-response (document-i64 1) (document-i64 -32600) (document-string "bad"))
                          (plain-expected)))
     (ok (document-equal? (p/error-response-with-data (document-i64 1) (document-i64 -32600)
                                                      (document-string "bad") (document-bool false))
                          (plain-expected)))
     (ok (document-equal? (p/error-response-with-data (document-i64 1) (document-i64 -32600)
                                                      (document-string "bad") (document-string "x"))
                          (data-expected)))))
