;; Acceptance test for kotoba.lsp-rpc.notification (port of notification.cljk).
;; main returns the number of failed cases (0 = all pass).
(ns kotoba.lsp-rpc.notification-test
  (:export [main])
  (:require [kotoba.lsp-rpc.notification :as n]))

(defn- chk [ok :bool] :i64 (if ok 0 1))
(defn- kv [m :document k :keyword v :document] :document
  (document-assoc m (document-keyword k) v))
(defn- fget [m :document k :keyword] :document
  (option-or (document-get m (document-keyword k)) (document-null)))

(defn main [] :i64
  (let [m (n/notification (document-string "textDocument/didOpen") (option-none-of [:option :document]))
        a (chk (document-equal? (fget m :jsonrpc) (document-string "2.0")))
        b (chk (document-equal? (fget m :method) (document-string "textDocument/didOpen")))
        c (chk (document-equal? (fget m :params) (document-map)))
        p (kv (document-map) :uri (document-string "file:///a"))
        m2 (n/notification (document-string "x") (option-some-of [:option :document] p))
        d (chk (document-equal? (fget m2 :params) p))
        e (chk (document-equal? (fget m2 :method) (document-string "x")))]
    (+ a (+ b (+ c (+ d e))))))
