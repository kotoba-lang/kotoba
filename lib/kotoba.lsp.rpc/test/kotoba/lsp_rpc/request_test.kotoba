(ns kotoba.lsp-rpc.request-test (:export [main]) (:require [kotoba.lsp-rpc.request :as p]))

(defn- g [d :document k :keyword] :document
  (option-or (document-get d k) (document-null)))

(defn- s [d :document k :keyword] :string
  (option-or (document-string-value (g d k)) "<none>"))

(defn- same [a :document b :document] :bool
  (string=? (document-edn-print a) (document-edn-print b)))

(defn main [] :i64
  (let [params (document-map :rootUri (document-string "file:///w"))
        r (p/request (document-i64 1) "initialize" params)
        rs (p/request (document-string "abc") "shutdown" (document-null))]
    (+ (if (string=? (s r :jsonrpc) "2.0") 0 1)
       (if (string=? (s r :method) "initialize") 0 1)
       (if (same (g r :id) (document-i64 1)) 0 1)
       (if (same (g r :params) params) 0 1)
       (if (same (g rs :id) (document-string "abc")) 0 1)
       (if (same (g rs :params) (document-map)) 0 1)
       (if (string=? (s rs :method) "shutdown") 0 1))))
