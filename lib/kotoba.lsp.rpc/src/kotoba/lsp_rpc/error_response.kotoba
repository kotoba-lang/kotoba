;; Port of kotoba.lsp-rpc.error-response (error_response.cljk), Kotoba-native.
;;
;; Named divergences from error_response.cljk:
;;   - The source's optional `data` argument is split into a named function:
;;     `error-response` (no data) and `error-response-with-data`.
;;   - As in the source's `cond->` on a truthy `data`, a null or false `data`
;;     gives the no-data response (no :data key).

(ns kotoba.lsp-rpc.error-response
  (:export [error-response error-response-with-data]))

(defn- falsy-doc? [d :document] :bool
  (or (document-equal? d (document-null))
      (document-equal? d (document-bool false))))

(defn error-response [id :document code :document message :document] :document
  (document-map :jsonrpc (document-string "2.0")
                :id id
                :error (document-map :code code :message message)))

(defn error-response-with-data [id :document code :document message :document data :document] :document
  (if (falsy-doc? data)
    (error-response id code message)
    (document-map :jsonrpc (document-string "2.0")
                  :id id
                  :error (document-map :code code :message message :data data))))
