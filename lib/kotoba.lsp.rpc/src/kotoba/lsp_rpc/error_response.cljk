(ns kotoba.lsp-rpc.error-response
  "error-response -- addressed on its own.

  Split out of kotoba.lang.lsp-rpc on 2026-09-09 (ADR-2609091200). The unit
  here is the DEFINITION, and this repo's deps.edn names exactly the
  definitions it reaches -- nothing else.
"
  )

(defn error-response [id code message & [data]]
  (cond-> {:jsonrpc "2.0" :id id :error {:code code :message message}}
    data (assoc-in [:error :data] data)))
