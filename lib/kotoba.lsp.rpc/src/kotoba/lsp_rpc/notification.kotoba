;; Port of kotoba.lsp-rpc.notification (notification.cljk), Kotoba-native.
;;
;; Named divergences from notification.cljk:
;;   - `method` is a :document: the source accepts any value and stores it
;;     as-is, so the port does the same.
;;   - `params` is [:option :document]. An absent params argument becomes an
;;     empty map, as `(or params {})` does.

(ns kotoba.lsp-rpc.notification
  (:export [notification]))

(defn notification [method :document params [:option :document]] :document
  (document-assoc
   (document-assoc (document-assoc (document-map) :jsonrpc (document-string "2.0"))
                   :method method)
   :params (option-or params (document-map))))
