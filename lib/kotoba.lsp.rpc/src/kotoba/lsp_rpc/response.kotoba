;; Port of kotoba.lsp-rpc.response (response.cljk), Kotoba-native, :document maps.
;;
;; A JSON-RPC response envelope {:jsonrpc "2.0" :id id :result result}.
;;
;; Named divergences from response.cljk:
;;   - id and result are :document values; a nil id or result is document-null.

(ns kotoba.lsp-rpc.response
  (:export [response]))

(defn response [id :document result :document] :document
  (document-map :jsonrpc (document-string "2.0") :id id :result result))
