;; Port of kotoba.lsp-rpc.request (request.cljk), Kotoba-native.
;;
;; A JSON-RPC request is a :document map {:jsonrpc "2.0" :id id :method m
;; :params p}.
;;
;; Named divergences from request.cljk:
;;   - method is a :string (LSP method names are strings); the source accepts
;;     any value.
;;   - params is a :document; a null params document becomes the empty map,
;;     as (or params {}) does in the source.

(ns kotoba.lsp-rpc.request
  (:export [request]))

(defn request [id :document method :string params :document] :document
  (document-map :jsonrpc (document-string "2.0")
                :id id
                :method (document-string method)
                :params (if (string=? (document-edn-print params) (document-edn-print (document-null)))
                          (document-map)
                          params)))
