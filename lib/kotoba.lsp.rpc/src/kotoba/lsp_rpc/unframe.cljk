(ns kotoba.lsp-rpc.unframe
  "unframe -- addressed on its own.

  Split out of kotoba.lang.lsp-rpc on 2026-09-09 (ADR-2609091200). The unit
  here is the DEFINITION, and this repo's deps.edn names exactly the
  definitions it reaches -- nothing else.
"
  (:require [kotoba.lsp-rpc.framing :as framing]
            [kotoba.lang.json :as json]
            [kotoba.lsp-rpc.keywordize :refer [keywordize]]
            [kotoba.lsp-rpc.read-content-length :refer [read-content-length]])
)

(defn unframe
  "Parse one framed message from `s`. Returns `[message-map remainder]` if a
  complete message is present, else `nil` (needs more input). The message map
  has keyword keys (keywordized from the JSON wire form)."
  [s] (framing/unframe s))
