(ns kotoba.lsp-rpc.framing
  "UTF-8 Content-Length framing shared by the retained and assembled APIs.
  The caller supplies complete decoded string chunks and owns the transport."
  (:require [kotoba.bytes :as bytes]
            [kotoba.lang.json :as json]
            [kotoba.lsp-rpc.keywordize :refer [keywordize]]))

(defn frame [message]
  (let [body (json/encode message)]
    (str "Content-Length: " (count (bytes/utf8-bytes body)) "\r\n\r\n" body)))

(defn read-content-length [source]
  (when-let [match (re-find #"^Content-Length:[ \t]*(\d+)\r\n\r\n" source)]
    (let [length #?(:clj (try (Long/parseLong (second match))
                              (catch NumberFormatException _ nil))
                    :cljs (js/Number (second match)))]
      (when (and (some? length) (<= 0 length 9007199254740991))
        [length (count (first match))]))))

(defn unframe [source]
  (when-let [[length header-length] (read-content-length source)]
    (let [octets (bytes/utf8-encode (subs source header-length))]
      (when (>= (count octets) length)
        (let [body (bytes/utf8-decode (subvec octets 0 length))
              remainder (bytes/utf8-decode (subvec octets length))]
          (when (or (nil? body) (nil? remainder))
            (throw (ex-info "Content-Length splits a UTF-8 character" {:length length})))
          [(keywordize (json/decode body)) remainder])))))
