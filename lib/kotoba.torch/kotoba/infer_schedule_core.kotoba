(ns infer-schedule-core
  (:export [max-running max-draft-tokens mtp-admitted? intel-b70?]))

;; Host-independent admission/rank policy compiled by Amu into sealed KEXE.
(defn max-running [requested :i64] :i64
  (if (< requested 1) 1 (if (> requested 64) 64 requested)))

(defn max-draft-tokens [requested :i64] :i64
  (if (< requested 1) 1 (if (> requested 8) 8 requested)))

;; MTP is only safe when the artifact exposes its head and llama.cpp reports
;; the complete target model on the accelerator.  Partial offload changes the
;; performance contract and is rejected rather than silently accepted.
(defn mtp-admitted? [head-present :bool fully-offloaded :bool requested :i64] :bool
  (if head-present
    (if fully-offloaded
      (if (< requested 1) false (if (> requested 8) false true))
      false)
    false))

(defn intel-b70? [pci-device-id :i64] :bool
  (= pci-device-id 57891))
