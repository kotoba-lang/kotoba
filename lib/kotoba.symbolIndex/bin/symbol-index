#!/usr/bin/env bash
# symbol-index launcher: kbb > nbb > bb, first available wins.
# Resolves its own symlink first (ln -s bin/symbol-index ~/.local/bin/...) —
# BASH_SOURCE[0] alone points at the link, so ../scripts would miss.
set -euo pipefail
SELF="${BASH_SOURCE[0]}"
while [ -L "$SELF" ]; do
  TARGET="$(readlink "$SELF")"
  case "$TARGET" in
    /*) SELF="$TARGET" ;;
    *)  SELF="$(cd "$(dirname "$SELF")" && pwd)/$TARGET" ;;
  esac
done
DIR="$(cd "$(dirname "$SELF")/.." && pwd)"
SCRIPT="$DIR/scripts/symbol-index.cljk"
if command -v kbb >/dev/null 2>&1; then
  exec kbb --backend sci "$SCRIPT" "$@"
elif command -v nbb >/dev/null 2>&1; then
  exec nbb "$SCRIPT" "$@"
elif command -v bb >/dev/null 2>&1; then
  exec bb "$SCRIPT" "$@"
else
  echo "symbol-index: no kbb / nbb / bb on PATH" >&2
  exit 64
fi
