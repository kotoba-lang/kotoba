#!/usr/bin/env kbb
;; scripts/install.cljk — symbol-index を他の agent / CLI から使えるように置く。
;;
;;   kbb --backend sci scripts/install.cljk            ; 導入
;;   kbb --backend sci scripts/install.cljk --check    ; 導入状態の検査 (未導入 / ずれは exit 2)
;;
;; 置くもの:
;;   ~/.local/bin/symbol-index  → <repo>/bin/symbol-index の symlink (kbb > nbb > bb を選ぶ launcher)
;;   ~/.hermes/skills/software-development/symbol-index/SKILL.md  (~/.hermes が在るときだけ、skills/ の写し)
;; 印字するもの: AGENTS.md / .cursorrules 等に貼る 1 行 (agent が「Read の前に引く」ため)。
;;
;; 何も黙って上書きしない: symlink が別の実体を指していれば REFUSE (exit 2)。skill の写しは
;; 内容が違うときだけ更新し、その旨を印字する。

(require '[clojure.string :as str])

(def fs (js/require "node:fs"))
(def path (js/require "node:path"))
(def os (js/require "node:os"))

(def argv (vec (js->clj (.-argv js/process))))
(def check? (some #{"--check"} argv))

(def repo
  (let [me (some #(when (str/ends-with? % "scripts/install.cljk") %) argv)]
    (.realpathSync fs (if me (.resolve path (.dirname path me) "..") (.cwd js/process)))))

(def home (.homedir os))
(def bin-target (.join path repo "bin" "symbol-index"))
(def bin-link (.join path home ".local" "bin" "symbol-index"))
(def skill-src (.join path repo "skills" "symbol-index" "SKILL.md"))
(def hermes-dir (.join path home ".hermes"))
(def skill-dst (.join path hermes-dir "skills" "software-development" "symbol-index" "SKILL.md"))

(def problems (volatile! []))
(defn- say [& xs] (println (apply str xs)))
(defn- problem! [m] (vswap! problems conj m) (say "PROBLEM\t" m))

;; ---- bin symlink
(let [;; existsSync は symlink を辿るので、指先が消えた (worktree を retire した) link を
      ;; 「無い」と言う → symlinkSync が EEXIST で落ちた (実測)。lstat で link 自体を見る
      lstat (try (.lstatSync fs bin-link) (catch :default _ nil))
      exists (some? lstat)
      current (when (and lstat (.isSymbolicLink lstat)) (.readlinkSync fs bin-link))]
  (cond
    (and current (= (.resolve path (.dirname path bin-link) current) bin-target))
    (say "OK\t" bin-link " -> " bin-target)

    ;; 別の symbol-index checkout (worktree 等) を指している symlink は付け替える (実体は同じ launcher)
    (and current (str/ends-with? current "/bin/symbol-index") (not check?))
    (do (.unlinkSync fs bin-link) (.symlinkSync fs bin-target bin-link)
        (say "RELINKED\t" bin-link ": " current " -> " bin-target))

    (and current (str/ends-with? current "/bin/symbol-index"))
    (problem! (str bin-link " points at another checkout: " current))

    exists
    (problem! (str bin-link " exists and is not our symlink (" (or current "regular file") ") — not touching it"))

    check?
    (problem! (str bin-link " missing"))

    :else
    (do (.mkdirSync fs (.dirname path bin-link) #js{:recursive true})
        (.symlinkSync fs bin-target bin-link)
        (say "INSTALLED\t" bin-link " -> " bin-target))))

;; ---- hermes skill (only when hermes is present)
(if-not (.existsSync fs hermes-dir)
  (say "SKIP\tno " hermes-dir " (hermes not installed here)")
  (let [src (.readFileSync fs skill-src "utf8")
        dst (when (.existsSync fs skill-dst) (.readFileSync fs skill-dst "utf8"))]
    (cond
      (= src dst) (say "OK\t" skill-dst " (identical)")
      check? (problem! (str skill-dst (if dst " differs from skills/symbol-index/SKILL.md" " missing")))
      :else (do (.mkdirSync fs (.dirname path skill-dst) #js{:recursive true})
                (.writeFileSync fs skill-dst src "utf8")
                (say (if dst "UPDATED\t" "INSTALLED\t") skill-dst)))))

;; ---- launcher runs at all
(let [cp (js/require "node:child_process")
      r (.spawnSync cp bin-target #js["status"] #js{:encoding "utf8" :cwd repo})]
  (if (contains? #{0 2} (.-status r))
    (say "OK\tlauncher runs (exit " (.-status r) ")")
    (problem! (str "launcher failed: " (str (.-stderr r)) (str (.-stdout r))))))

(say "")
(say "AGENTS.md に貼る 1 行:")
(say "- コードを Read / grep する前に `symbol-index <sym|file|ns>` を引く (exit 0 hit / 1 なし / 2 拒否)。outline の #hash が同じなら本文は同じ、読み直さない。")
(say "hermes: `hermes chat -s symbol-index` (先読み。置くだけでは 2/8 しか選ばない実測)")
(say (str "CHECKS\t" (if (seq @problems) "with problems" "clean") "\tproblems=" (count @problems)))
(.exit js/process (if (seq @problems) 2 0))
