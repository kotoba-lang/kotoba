(ns shamir.core
  "Shamir secret sharing over GF(2^8), byte by byte.

      (split secret 3 5 random-fn)   ; five shares, any three recover
      (combine [s1 s4 s5])           ; => secret

  A share is `{:x 1..255 :y bytes}`. Each secret byte is the constant term of
  its own random polynomial of degree `threshold - 1`; share `x` holds every
  polynomial evaluated at `x`. Fewer than `threshold` shares are consistent
  with every possible secret, so they reveal nothing about it.

  The field is GF(2^8) with the AES polynomial x^8+x^4+x^3+x+1 (0x11B),
  multiplication through log/antilog tables over the generator 3.

  `combine` cannot tell a wrong share from a right one — it answers *some*
  bytes for any input. Callers that need to know (nafuda does) keep a hash of
  the secret beside the shares and compare.")

(def ^:private tables
  (let [step (fn [x] ;; multiply by 3 = x ^ xtime(x)
               (let [x2 (bit-shift-left x 1)
                     x2 (if (>= x2 256) (bit-xor x2 0x11B) x2)]
                 (bit-xor x x2)))
        exps (vec (take 255 (iterate step 1)))
        logs (reduce (fn [acc [i v]] (assoc acc v i)) (vec (repeat 256 0)) (map-indexed vector exps))]
    {:exp (into exps exps) :log logs}))

(defn gf-mul [a b]
  (if (or (zero? a) (zero? b))
    0
    (nth (:exp tables) (+ (nth (:log tables) a) (nth (:log tables) b)))))

(defn gf-div [a b]
  (when (zero? b) (throw (ex-info "shamir: division by zero" {})))
  (if (zero? a)
    0
    (nth (:exp tables) (+ 255 (- (nth (:log tables) a) (nth (:log tables) b))))))

(defn- eval-poly
  "Horner's rule; `coeffs` lowest degree first."
  [coeffs x]
  (reduce (fn [acc c] (bit-xor (gf-mul acc x) c)) 0 (reverse coeffs)))

(defn split
  "`n` shares of `secret` (bytes), any `threshold` of which recover it.
  `random-bytes` is `(fn [n] bytes)`, normally the host CSPRNG."
  [secret threshold n random-bytes]
  (when-not (<= 2 threshold n 255)
    (throw (ex-info "shamir: need 2 <= threshold <= n <= 255" {:threshold threshold :n n})))
  (let [secret (mapv #(bit-and % 0xff) secret)
        polys (mapv (fn [b] (into [b] (map #(bit-and % 0xff)) (random-bytes (dec threshold))))
                    secret)]
    (mapv (fn [x] {:x x :y (mapv #(eval-poly % x) polys)})
          (range 1 (inc n)))))

(defn combine
  "The secret from `threshold` or more shares (Lagrange interpolation at 0)."
  [shares]
  (let [shares (vec shares)
        xs (mapv :x shares)]
    (when (not= (count xs) (count (set xs)))
      (throw (ex-info "shamir: duplicate share x" {:xs xs})))
    (let [len (count (:y (first shares)))
          basis (mapv (fn [i]
                        (reduce (fn [acc j]
                                  (if (= i j)
                                    acc
                                    ;; l_i(0) = Π x_j / (x_j - x_i), and - is xor
                                    (gf-mul acc (gf-div (nth xs j) (bit-xor (nth xs j) (nth xs i))))))
                                1 (range (count xs))))
                      (range (count xs)))]
      (mapv (fn [k]
              (reduce bit-xor 0 (map-indexed (fn [i s] (gf-mul (nth basis i) (nth (:y s) k))) shares)))
            (range len)))))

(defn encode-share
  "Bytes for one share: x ++ y."
  [{:keys [x y]}]
  (into [x] y))

(defn decode-share [bs]
  (let [bs (vec bs)]
    (when (and (>= (count bs) 2) (pos? (first bs)))
      {:x (first bs) :y (subvec bs 1)})))
