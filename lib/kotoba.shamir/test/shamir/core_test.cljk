(ns shamir.core-test
  (:require [kotoba.test :refer [deftest is testing]]
            [shamir.core :as s]))

(defn- counter-random
  "Deterministic stand-in for a CSPRNG."
  [seed]
  (let [state (atom seed)]
    (fn [n] (vec (repeatedly n #(bit-and (swap! state (fn [x] (+ (* x 73) 41))) 0xff))))))

(deftest field-test
  (testing "known AES-field products"
    (is (= 0xC1 (s/gf-mul 0x57 0x83)))
    (is (= 0xFE (s/gf-mul 0x57 0x13))))
  (testing "division inverts multiplication for every nonzero pair sampled"
    (doseq [a [1 2 3 0x53 0xCA 0xFF] b [1 7 0x80 0xFF]]
      (is (= a (s/gf-div (s/gf-mul a b) b))))))

(deftest split-combine-test
  (let [secret (vec (range 32))
        shares (s/split secret 3 5 (counter-random 7))]
    (is (= 5 (count shares)))
    (testing "every 3-subset recovers the secret"
      (doseq [ix [[0 1 2] [0 2 4] [1 3 4] [2 3 4]]]
        (is (= secret (s/combine (map shares ix))))))
    (testing "all five also recover it"
      (is (= secret (s/combine shares))))
    (testing "two shares do not"
      (is (not= secret (s/combine (take 2 shares)))))
    (testing "encoding round-trips"
      (is (= (first shares) (s/decode-share (s/encode-share (first shares))))))))
