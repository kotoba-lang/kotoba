(ns kotoba.retail-test
  (:require [kotoba.test :refer [deftest is testing]]
            [kotoba.retail :as retail]))

;; 4006381333931 is a valid EAN-13 (GS1 test shape, mod-10 correct).
(def ean "4006381333931")

(deftest ean13-test
  (is (retail/ean13-valid? ean))
  (is (not (retail/ean13-valid? "4006381333932"))) ; bad checksum
  (is (not (retail/ean13-valid? "123")))           ; wrong length
  (is (not (retail/ean13-valid? nil))))

(deftest validate-ean13-test
  (is (true? (:retail/valid? (retail/validate-ean13 ean))))
  (is (= :bad-checksum (:retail/error (retail/validate-ean13 "4006381333932")))))

(deftest inventory-test
  (is (retail/needs-reorder? (retail/inventory "S1" "L1" 3 :reorder-at 5)))
  (is (not (retail/needs-reorder? (retail/inventory "S1" "L1" 10 :reorder-at 5)))))

(deftest receipt-test
  (let [li [(retail/line-item "S1" 200 2)               ; net 400
            (retail/line-item "S2" 500 1 :tax-rate 0.1)]  ; net 500 tax 50
        r (retail/receipt "R1" li :currency "USD")]
    (is (= 900 (:receipt/net r)))
    (is (= 50 (:receipt/tax r)))
    (is (= 950 (:receipt/total r)))))

(deftest ean13-edge-cases
  (testing "13-digit exactly is accepted when checksum valid"
    (is (retail/ean13-valid? "4006381333931")))
  (testing "12 digits is too short"
    (is (not (retail/ean13-valid? "400638133393"))))
  (testing "14 digits is too long"
    (is (not (retail/ean13-valid? "40063813339311"))))
  (testing "non-string is rejected"
    (is (not (retail/ean13-valid? nil)))))

(deftest inventory-edge-cases
  (testing "no reorder point means no reorder"
    (is (not (retail/needs-reorder? (retail/inventory "S1" "L1" 0)))))
  (testing "exactly at reorder point triggers reorder"
    (is (retail/needs-reorder? (retail/inventory "S1" "L1" 5 :reorder-at 5))))
  (testing "empty receipt totals zero"
    (let [r (retail/receipt "R1" [])]
      (is (zero? (:receipt/net r)))
      (is (zero? (:receipt/total r))))))

(deftest validate-ean13-names-every-branch-it-can-return
  ;; validate-ean13 has four outcomes and only two were pinned (:bad-checksum
  ;; and valid?=true). The other two are the ones a caller switches on to tell
  ;; "you passed the wrong kind of thing" from "this barcode is wrong", so an
  ;; error keyword silently changing or collapsing is a caller-visible break.
  (testing "a non-string is refused as :not-a-string, not as a length problem"
    ;; ordering matters here: digits-only returns nil for a non-string and
    ;; (count nil) is 0, so a :wrong-length check placed first would swallow
    ;; this branch and no test would notice.
    (is (= :not-a-string (:retail/error (retail/validate-ean13 42))))
    (is (= :not-a-string (:retail/error (retail/validate-ean13 nil))))
    (is (false? (:retail/valid? (retail/validate-ean13 42)))))
  (testing "a string of the wrong digit count is :wrong-length"
    (is (= :wrong-length (:retail/error (retail/validate-ean13 "400638133393"))))
    (is (= :wrong-length (:retail/error (retail/validate-ean13 "40063813339311"))))
    (is (= :wrong-length (:retail/error (retail/validate-ean13 "")))))
  (testing "a valid barcode returns the normalized digits and no error"
    (let [r (retail/validate-ean13 ean)]
      (is (true? (:retail/valid? r)))
      (is (= ean (:retail/normalized r)))
      (is (nil? (:retail/error r))))))

(deftest ean13-normalizes-separators-on-purpose
  ;; digits-only strips every non-digit before counting, so a barcode written
  ;; with the separators printed on the package validates and normalizes to the
  ;; bare 13 digits. That is the intended contract (validate-ean13 hands back
  ;; :retail/normalized precisely so a caller can store the stripped form), and
  ;; it is worth pinning because it is indistinguishable from a leak: tightening
  ;; digits-only to reject separators would break scanner input that works today
  ;; and nothing else in the suite would go red.
  (is (retail/ean13-valid? "400-6381-333931"))
  (is (= ean (:retail/normalized (retail/validate-ean13 "400 6381 333931"))))
  (testing "stripping separators never invents length: 12 digits stay too short"
    (is (not (retail/ean13-valid? "400-638-133-393")))))
