;; Behavior check for actor-ipc.time (time.kotoba). main returns the number of
;; failed cases; 0 means all pass.
(ns actor-ipc.time-test
  (:require [actor-ipc.time :as t]))

(defn check [ok :bool] :i64
  (if ok 0 1))

(defn main [] :i64
  (let [c (t/make-clock 60)
        r (t/advance c 40000000)
        c2 (:clock r)
        r0 (t/advance c 16666665)]
    (+ (check (= (t/clock-tick-rate c) 60))
       (check (= (:tick-duration-ns c) 16666666))
       (check (= (:ticks r) 2))
       (check (= (t/clock-tick c2) 2))
       (check (= (:accumulator-ns c2) 6666668))
       (check (= (:ticks r0) 0))
       (check (= (:accumulator-ns (:clock r0)) 16666665))
       (check (f64-lt (t/alpha c2) 0.41))
       (check (f64-lt 0.39 (t/alpha c2))))))
