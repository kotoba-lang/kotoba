;; actor-ipc.time -- fixed-timestep game loop timing. Kotoba port of time.cljk
;; (restored from kami-engine/kami-core src/time.rs; see time.cljk header).
;;
;; Named divergences from time.cljk (the .cljk is the host reference):
;;   - GameClock is the record `GameClock` (typed fields), not a plain map.
;;     Field access stays `(:tick clock)` etc.; constructor `->GameClock`.
;;   - `advance` returns the record `Advance` {clock ticks} instead of a map
;;     `{:clock .. :ticks ..}`. Field access is the same keyword form.
;;   - `alpha` returns :f64 computed with f64 ops; the .cljk uses `double`
;;     over a Clojure ratio. Equal for the accumulator < duration range.
;;   - Integer arithmetic is i64 throughout; the .cljk is untyped.
(ns actor-ipc.time)

(defrecord GameClock [tick :i64 tick-rate :i64 tick-duration-ns :i64 accumulator-ns :i64])

(defrecord Advance [clock [:record :actor-ipc.time/GameClock [[:tick :i64] [:tick-rate :i64] [:tick-duration-ns :i64] [:accumulator-ns :i64]]] ticks :i64])

(def ns-per-second 1000000000)

(defn make-clock [tick-rate :i64] [:record :actor-ipc.time/GameClock [[:tick :i64] [:tick-rate :i64] [:tick-duration-ns :i64] [:accumulator-ns :i64]]]
  (->GameClock 0 tick-rate (quot ns-per-second tick-rate) 0))

(defn advance [clock [:record :actor-ipc.time/GameClock [[:tick :i64] [:tick-rate :i64] [:tick-duration-ns :i64] [:accumulator-ns :i64]]] elapsed-ns :i64] [:record :actor-ipc.time/Advance [[:clock [:record :actor-ipc.time/GameClock [[:tick :i64] [:tick-rate :i64] [:tick-duration-ns :i64] [:accumulator-ns :i64]]]] [:ticks :i64]]]
  (let [acc (+ (:accumulator-ns clock) elapsed-ns)
        dur (:tick-duration-ns clock)
        ticks (quot acc dur)
        acc2 (mod acc dur)
        tick2 (mod (+ (:tick clock) ticks) 4294967296)]
    (->Advance (->GameClock tick2 (:tick-rate clock) dur acc2) ticks)))

(defn clock-tick [clock [:record :actor-ipc.time/GameClock [[:tick :i64] [:tick-rate :i64] [:tick-duration-ns :i64] [:accumulator-ns :i64]]]] :i64
  (:tick clock))

(defn clock-tick-rate [clock [:record :actor-ipc.time/GameClock [[:tick :i64] [:tick-rate :i64] [:tick-duration-ns :i64] [:accumulator-ns :i64]]]] :i64
  (:tick-rate clock))

(defn alpha [clock [:record :actor-ipc.time/GameClock [[:tick :i64] [:tick-rate :i64] [:tick-duration-ns :i64] [:accumulator-ns :i64]]]] :f64
  (f64-div (i64-to-f64-rounded (:accumulator-ns clock)) (i64-to-f64-rounded (:tick-duration-ns clock))))
