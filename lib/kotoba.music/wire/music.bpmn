<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  targetNamespace="http://bpmn.io/schema/bpmn">

  <!-- createTrack -->
  <bpmn:process id="music-create-track" name="Music Create Track" isExecutable="true">
    <bpmn:startEvent id="start-create-track"/>
    <bpmn:sequenceFlow id="sf-ct-1" sourceRef="start-create-track" targetRef="task-create-track"/>
    <bpmn:serviceTask id="task-create-track" name="Create Track">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.music.createTrack"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-ct-2" sourceRef="task-create-track" targetRef="end-create-track"/>
    <bpmn:endEvent id="end-create-track"/>
  </bpmn:process>

  <!-- updateTrack -->
  <bpmn:process id="music-update-track" name="Music Update Track" isExecutable="true">
    <bpmn:startEvent id="start-update-track"/>
    <bpmn:sequenceFlow id="sf-ut-1" sourceRef="start-update-track" targetRef="task-update-track"/>
    <bpmn:serviceTask id="task-update-track" name="Update Track">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.music.updateTrack"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-ut-2" sourceRef="task-update-track" targetRef="end-update-track"/>
    <bpmn:endEvent id="end-update-track"/>
  </bpmn:process>

  <!-- listTracks -->
  <bpmn:process id="music-list-tracks" name="Music List Tracks" isExecutable="true">
    <bpmn:startEvent id="start-list-tracks"/>
    <bpmn:sequenceFlow id="sf-lt-1" sourceRef="start-list-tracks" targetRef="task-list-tracks"/>
    <bpmn:serviceTask id="task-list-tracks" name="List Tracks">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.music.listTracks"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-lt-2" sourceRef="task-list-tracks" targetRef="end-list-tracks"/>
    <bpmn:endEvent id="end-list-tracks"/>
  </bpmn:process>

  <!-- getTrack -->
  <bpmn:process id="music-get-track" name="Music Get Track" isExecutable="true">
    <bpmn:startEvent id="start-get-track"/>
    <bpmn:sequenceFlow id="sf-gtr-1" sourceRef="start-get-track" targetRef="task-get-track"/>
    <bpmn:serviceTask id="task-get-track" name="Get Track">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.music.getTrack"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-gtr-2" sourceRef="task-get-track" targetRef="end-get-track"/>
    <bpmn:endEvent id="end-get-track"/>
  </bpmn:process>

  <!-- createArtist -->
  <bpmn:process id="music-create-artist" name="Music Create Artist" isExecutable="true">
    <bpmn:startEvent id="start-create-artist"/>
    <bpmn:sequenceFlow id="sf-ca-1" sourceRef="start-create-artist" targetRef="task-create-artist"/>
    <bpmn:serviceTask id="task-create-artist" name="Create Artist">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.music.createArtist"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-ca-2" sourceRef="task-create-artist" targetRef="end-create-artist"/>
    <bpmn:endEvent id="end-create-artist"/>
  </bpmn:process>

  <!-- updateArtist -->
  <bpmn:process id="music-update-artist" name="Music Update Artist" isExecutable="true">
    <bpmn:startEvent id="start-update-artist"/>
    <bpmn:sequenceFlow id="sf-ua-1" sourceRef="start-update-artist" targetRef="task-update-artist"/>
    <bpmn:serviceTask id="task-update-artist" name="Update Artist">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.music.updateArtist"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-ua-2" sourceRef="task-update-artist" targetRef="end-update-artist"/>
    <bpmn:endEvent id="end-update-artist"/>
  </bpmn:process>

  <!-- listArtists -->
  <bpmn:process id="music-list-artists" name="Music List Artists" isExecutable="true">
    <bpmn:startEvent id="start-list-artists"/>
    <bpmn:sequenceFlow id="sf-la-1" sourceRef="start-list-artists" targetRef="task-list-artists"/>
    <bpmn:serviceTask id="task-list-artists" name="List Artists">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.music.listArtists"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-la-2" sourceRef="task-list-artists" targetRef="end-list-artists"/>
    <bpmn:endEvent id="end-list-artists"/>
  </bpmn:process>

  <!-- getArtist -->
  <bpmn:process id="music-get-artist" name="Music Get Artist" isExecutable="true">
    <bpmn:startEvent id="start-get-artist"/>
    <bpmn:sequenceFlow id="sf-ga-1" sourceRef="start-get-artist" targetRef="task-get-artist"/>
    <bpmn:serviceTask id="task-get-artist" name="Get Artist">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.music.getArtist"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-ga-2" sourceRef="task-get-artist" targetRef="end-get-artist"/>
    <bpmn:endEvent id="end-get-artist"/>
  </bpmn:process>

</bpmn:definitions>
