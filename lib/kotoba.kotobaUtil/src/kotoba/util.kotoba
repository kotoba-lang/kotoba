(ns kotoba.util
  "Pure base64 (RFC 4648) core in Kotoba. Operates on char codes; byte-slice
  and string conversion live in the host layer."
  (:export [b64-char b64-decode-char self-check main]))

;; index -> base64 char code. 0-25 A-Z, 26-51 a-z, 52-61 0-9, 62 +, 63 /
(defn b64-char [i] :i64
  (cond
    (< i 26) (+ i 65)
    (< i 52) (+ i -26 97)
    (< i 62) (+ i -52 48)
    (= i 62) 43
    :else 47))

(defn b64-decode-char [c] :i64
  (cond
    (and (>= c 65) (<= c 90)) (- c 65)
    (and (>= c 97) (<= c 122)) (+ c 26 -97)
    (and (>= c 48) (<= c 57)) (+ c 52 -48)
    (= c 43) 62
    (= c 47) 63
    :else -1))

;; Self-check returns the NUMBER of failing cases (0 = all good).
(defn self-check [] :i64
  (+ (+ (+ (+ (+ (+ (+ (+ (+ (if (= 65 (b64-char 0)) 0 1)
   (if (= 90 (b64-char 25)) 0 1))
   (if (= 97 (b64-char 26)) 0 1))
   (if (= 122 (b64-char 51)) 0 1))
   (if (= 48 (b64-char 52)) 0 1))
   (if (= 57 (b64-char 61)) 0 1))
   (if (= 43 (b64-char 62)) 0 1))
   (if (= 47 (b64-char 63)) 0 1))
   (if (= 0 (b64-decode-char 65)) 0 1))
   (if (= -1 (b64-decode-char 33)) 0 1)))

(defn main [] :i64 (self-check))
