{:paths ["src"]
 :deps {
        io.github.kotoba-lang/coll {:local/root "../kotoba.coll"}
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}
        io.github.kotoba-lang/io-ipld {:local/root "../kotoba.ioIpld"}
        io.github.kotoba-lang/io-multiformats {:local/root "../kotoba.ioMultiformats"}
        io.github.kotoba-lang/merkle-lsm {:local/root "../kotoba.merkleLsm"}
        io.github.kotoba-lang/kotobase-block-codec {:local/root "../kotoba.kotobaseBlockCodec"}}
 :aliases
 {:test {:extra-paths ["test"]
         ;; **No kotobase-peer here, and that is the point.** peer's `:deps`
         ;; include this repo, so a peer dependency here — even test-scoped —
         ;; is a cycle, and a cycle cannot be pin-consistent: each side can
         ;; only name a slightly older revision of the other. Measured
         ;; 2026-08-18, pointing this alias at peer's current main pushed the
         ;; conflicting-pin count from eight pairs to seventeen, because the
         ;; traversal re-enters at a new version each way round.
         ;;
         ;; The tests that needed a real store moved to peer, where the
         ;; dependency runs the way it already did
         ;; (`kotobase-peer.projection-datalog-test`).
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
