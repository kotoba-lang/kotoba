#!/bin/sh
# The local loop. Point it at a directory of real documents.
#
#   bin/run-fidelity-loop ~/Documents
#   bin/run-fidelity-loop ~/Documents 96 ./evidence
#
# Exits non-zero when the ratchet says this run is worse than the last one
# over the same corpus, so a shell loop or a pre-commit hook can use it
# without parsing anything.
set -e
ROOT="${1:?usage: run-fidelity-loop <corpus-dir> [limit] [evidence-dir]}"
exec kbb -M:run --root "$ROOT" --limit "${2:-48}" --evidence "${3:-evidence}"
