(ns bzip2.fixtures
  "Reference bzip2 streams recorded from the reference implementation
   (the `bzip2` binary, i.e. libbzip2) so the portable suite can assert real
   conformance on both runtimes with no shell and no filesystem.

   `streams` holds small cases as `{:data <base64> :bz2 <base64>}`.
   `repeated` holds cases whose plaintext is too large to inline: the
   plaintext is `unit` repeated `times`, which keeps a multi-block stream
   (level 1 = 100,000-byte blocks) in the suite without a 300 KB file.

   Generated by tools/record_fixtures.cljk — do not hand-edit.")

(def streams
  {
   "allbytes-9"
   {:data ""
    :bz2 ""}
   "concat"
   {:data "Zmlyc3QKc2Vjb25kCg=="
    :bz2 "QlpoMTFBWSZTWRPK/Y0AAADBgAAQASAcACAAIYAMAycu4u5IpwoSAnlfsaBCWmg5MUFZJlNZltpZzwAAA0GAABAOAYgAIAAxDAENManOAHi7kinChIS20s54"}
   "empty-9"
   {:data ""
    :bz2 "QlpoORdyRThQkAAAAAA="}
   "one-1"
   {:data "Wg=="
    :bz2 "QlpoMTFBWSZTWebqPZoAAAACAAAQIAAhGEaC7kinChIc3UezQA=="}
   "random-9"
   {:data ""
    :bz2 ""}
   "runs-1"
   {:data ""
    :bz2 "QlpoMTFBWSZTWf6ajsIAAALEAMAAPgAACCAAIrw1NQhgGNdRbebykiC34u5IpwoSH9NR2EA="}
   "text-1"
   {:data ""
    :bz2 "QlpoMTFBWSZTWeHm0vMAAveRgEABP///8DAAuAo0NAAAAUaGgAAAClUmppgmCM1NtR+CYE7CYE4iaCZCaCbxOgn6JxE7iZCdwmomwTyJ6CaiZifwmQmwTAnkTMTmJoJ6EzE7Cf4momYTAmBOgq9iexPgu5IpwoSHDzaXmA=="}
   "text-9"
   {:data ""
    :bz2 "QlpoOTFBWSZTWeHm0vMAAveRgEABP///8DAAuAo0NAAAAUaGgAAAClUmppgmCM1NtR+CYE7CYE4iaCZCaCbxOgn6JxE7iZCdwmomwTyJ6CaiZifwmQmwTAnkTMTmJoJ6EzE7Cf4momYTAmBOgq9iexPgu5IpwoSHDzaXmA=="}
   "zeros-1"
   {:data ""
    :bz2 "QlpoMTFBWSZTWbDaYVsAAAXACMAAAACACCAAMMwImkpQA8XckU4UJCw2mFbA"}
   })

