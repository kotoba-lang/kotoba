(ns record-fixtures
  "Regenerate test/bzip2/fixtures.cljk by driving the reference `bzip2` binary.

       kbb --backend sci tools/record_fixtures.cljk

   The portable suite must be able to assert conformance against real reference
   output on ClojureScript, where there is no shell and no filesystem. So the
   reference streams are recorded here, once, and checked in as base64.

   Every stream is verified round-trip through `bunzip2` before being written,
   so a fixture file can never record something the reference itself rejects."
  (:require ["node:child_process" :as cp]
            ["node:fs" :as fs]
            [kotoba.lang.text :as str]))

(defn- ascii [s] (mapv #(.charCodeAt % 0) (seq s)))

(defn- run
  "Feed `bytes` to `cmd` on stdin and return its stdout as a byte vector."
  [cmd args bytes]
  (let [buf (.from js/Buffer (clj->js bytes))
        out (cp/execFileSync cmd (clj->js args)
                             #js {:input buf :maxBuffer 100000000})]
    (vec (js/Array.from out))))

(defn- b64 [bytes] (.toString (.from js/Buffer (clj->js bytes)) "base64"))

(defn- compress-with-reference [bytes level]
  (let [bz2 (run "bzip2" ["-c" (str "-" level)] bytes)
        back (run "bunzip2" ["-c"] bz2)]
    (when-not (= (vec bytes) back)
      (throw (ex-info "the reference did not round-trip its own output"
                      {:level level :size (count bytes)})))
    bz2))

(def ^:private small-cases
  ;; [name level bytes]
  (let [rnd (loop [i 0 s 20260730 out []]
              (if (= i 2000)
                out
                (let [s' (mod (+ (* 1103515245 s) 12345) 2147483648)]
                  (recur (inc i) s' (conj out (mod s' 256))))))]
    [["empty" 9 []]
     ["one" 1 (ascii "Z")]
     ["text" 1 (vec (mapcat identity (repeat 40 (ascii "the quick brown fox jumps over the lazy dog. "))))]
     ["text" 9 (vec (mapcat identity (repeat 40 (ascii "the quick brown fox jumps over the lazy dog. "))))]
     ["runs" 1 (vec (concat (repeat 4 65) (repeat 255 66) (repeat 256 67) (repeat 259 68) [69]))]
     ["allbytes" 9 (vec (mapcat identity (repeat 3 (range 256))))]
     ["zeros" 1 (vec (repeat 3000 0))]
     ["random" 9 rnd]]))

(defn- concat-case []
  ;; `cat a.bz2 b.bz2 | bunzip2` works, so a decoder must handle it
  (let [a (compress-with-reference (ascii "first\n") 1)
        b (compress-with-reference (ascii "second\n") 9)]
    {:data (b64 (ascii "first\nsecond\n")) :bz2 (b64 (into a b))}))

(def ^:private repeated-unit "abcdefghij")
(def ^:private repeated-times 25000)

(defn -main []
  (let [small (reduce (fn [acc [name level bytes]]
                        (assoc acc (str name "-" level)
                               {:data (b64 bytes)
                                :bz2 (b64 (compress-with-reference bytes level))}))
                      {}
                      small-cases)
        small (assoc small "concat" (concat-case))
        big-plain (vec (mapcat identity (repeat repeated-times (ascii repeated-unit))))
        big {"multiblock-1" {:unit repeated-unit :times repeated-times
                             :bz2 (b64 (compress-with-reference big-plain 1))}}
        lines
        (concat
         ["(ns bzip2.fixtures"
          "  \"Reference bzip2 streams recorded from the reference implementation"
          "   (the `bzip2` binary, i.e. libbzip2) so the portable suite can assert real"
          "   conformance on both runtimes with no shell and no filesystem."
          ""
          "   `streams` holds small cases as `{:data <base64> :bz2 <base64>}`."
          "   `repeated` holds cases whose plaintext is too large to inline: the"
          "   plaintext is `unit` repeated `times`, which keeps a multi-block stream"
          "   (level 1 = 100,000-byte blocks) in the suite without a 300 KB file."
          ""
          "   Generated by tools/record_fixtures.cljk — do not hand-edit.\")"
          ""
          "(def streams"
          "  {"]
         (mapcat (fn [[k v]]
                   [(str "   \"" k "\"")
                    (str "   {:data \"" (:data v) "\"")
                    (str "    :bz2 \"" (:bz2 v) "\"}")])
                 (sort small))
         ["   })"
          ""
          "(def repeated"
          "  {"]
         (mapcat (fn [[k v]]
                   [(str "   \"" k "\"")
                    (str "   {:unit \"" (:unit v) "\" :times " (:times v))
                    (str "    :bz2 \"" (:bz2 v) "\"}")])
                 (sort big))
         ["   })"])]
    (fs/writeFileSync "test/bzip2/fixtures.cljk" (str (str/join "\n" lines) "\n"))
    (println "wrote test/bzip2/fixtures.cljk"
             (str "(" (count small) " streams, " (count big) " repeated)"))))

(-main)
