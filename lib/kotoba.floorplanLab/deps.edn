{:paths ["src"]
 :version "0.1.0"
 ;; kotoba-lang/floorplan-lab — indoor floorplan estimation algorithms
 ;; (dead-reckoning / chirp-echo sonar / BLE RSSI trilateration / sensor
 ;; fusion) per ADR-2607140600. Depends only on kotoba-lang/device (matching
 ;; device's OWN convention of minimal deps — device itself depends only on
 ;; wit + coll, not the full kotoba-lang/kotoba monorepo). See
 ;; src/floorplan_lab/sensing_bridge.cljk for why this repo does NOT also
 ;; depend directly on kotoba-lang/kotoba (chicory/ed25519/dag-cbor
 ;; transitive weight) despite ADR-2607140600 describing the sensing driver
 ;; contract kotoba.sensing-host implements.
 :deps {
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/device {:local/root "../kotoba.device"}}
 :aliases
 {:test {:extra-paths ["test"]}}}
