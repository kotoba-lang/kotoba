;; Same shape as kotoba-lang/kami-app-sculpt & kami-app-bim-editor's
;; shadow-cljs.edn (both real, deployed kami.webgpu consumers) -- default
;; :browser target optimizations work fine with kami.webgpu because
;; org-w3-webgpu's WebGPU bindings are ^js-hinted throughout (Closure
;; :advanced keeps `navigator.gpu`/`.requestAdapter`/etc. unmangled), so no
;; :compiler-options override is needed here either.
{:deps {:aliases [:cljs]}
 :builds
 {:app {:target :browser
        :output-dir "public/js"
        :asset-path "./js"
        :modules {:app {:init-fn floorplan-lab.viewer/init!}}}}}
