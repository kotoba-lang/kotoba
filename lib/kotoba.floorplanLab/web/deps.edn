;; kotoba-lang/floorplan-lab web/ — browser 3D viewer for this lab's
;; wall-point/room-outline output. Reuses `kotoba-lang/webgpu`'s
;; declarative render-IR executor (`kami.webgpu`/`kami.webgpu.ir`) for all
;; rendering (no new SceneKit/Metal/RealityKit code -- see README /
;; ADR-2607078000 addendum on native-desktop targets wrapping the
;; browser-proven cljs path instead of new native code) and `kotoba-ui`
;; for the page shell (per the kotoba-uiux skill contract: apps require
;; `kotoba-ui.core` only, never `liquid-glass.*`/`shitsuke.*` directly).
;;
;; This dir is nested one level below floorplan-lab's own repo root (it's
;; `orgs/kotoba-lang/floorplan-lab/web`, not `orgs/kotoba-lang/<name>`
;; directly), so :local/root sibling paths need one extra `../` versus the
;; kami-app-* convention (which lives directly under orgs/kotoba-lang/).
{:paths ["src" "../src"]
 :deps {
        ;; kotoba.io replaced clojure.java.io / java.io.File here (2026-09-24).
        ;; An explicit floor: the java.io.File method functions (exists?, file?,
        ;; parent-file, canonical-path, mkdirs, list-files ...) are in kotoba.io
        ;; from this sha, and tools.deps takes the NEWEST sha it is shown.
        io.github.kotoba-lang/io {:git/sha "f7b3fca8e08147ae7d658fe36ae0475a45fb76a9"}
        io.github.kotoba-lang/webgpu   {:local/root "../../webgpu"}
        io.github.kotoba-lang/kotoba-ui {:local/root "../../kotoba-ui"}}
 :aliases
 {;; browser build (shadow-cljs.edn's :deps {:aliases [:cljs]} pulls this in)
  :cljs {:extra-deps {thheller/shadow-cljs {:mvn/version "2.28.20"}}}
  ;; JVM-side static page build (SSR via kotoba-ui.core/->page, same
  ;; build.clj pattern kami-app-sculpt/kami-app-bim-editor use) -- run via
  ;; `kbb -M:build`
  :build {:main-opts ["-m" "floorplan-lab.viewer.build"]}}}
