{:paths ["src"]
 :deps {
        io.github.kotoba-lang/io {:local/root "../kotoba.io"}
        io.github.kotoba-lang/edn {:local/root "../kotoba.edn"}
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}}
 :aliases {:test {:extra-paths ["test"]
                  :extra-deps {io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}
                               ;; TEST-ONLY. Parity compiles
                               ;; kotoba/rt/routing.kotoba and runs it
                               ;; against kotoba.rt.core. Nothing in :paths
                               ;; depends on either. Pins are the west pair
                               ;; (amu + kotoba-kir) as of this commit.
                               io.github.kotoba-lang/amu
                               {:git/url "https://github.com/kotoba-lang/amu.git"
                                :git/sha "35e8a18f2842762bedbf88b32f22e1128ad95cf0"}
                               io.github.kotoba-lang/osaho
                               {:git/url "https://github.com/kotoba-lang/osaho.git"
                                :git/sha "099c627609ad506babf05f2d5e9a73b95c1b026b"}}
                  :main-opts ["-m" "cognitect.test-runner"]}
                ;; clj-kondo as a Clojars lib (no Homebrew/system install needed).
                :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
                  :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                              "--fail-level" "error"]}}}
