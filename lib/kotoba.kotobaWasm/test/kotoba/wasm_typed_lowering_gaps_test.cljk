(ns kotoba.wasm-typed-lowering-gaps-test
  "Three typed-lowering gaps found 2026-10-10 while registering operation
  families in kotoba-lang/kotoba-lang (root ADR-2610092330 R4). The KIR
  interpreter and js-kotoba-v1 ran every program below; this backend refused
  each one. The KIR here is what `kotoba.kir/lower` produced for them."
  (:require [kotoba.test :refer [deftest is testing]]
            [kotoba.wasm.core :as wasm]
            [kotoba.wasm.typed :as typed]))

(defn- module-bytes? [x]
  #?(:clj (bytes? x) :cljs (instance? js/Uint8Array x)))

(defn- test-module
  "A module exporting a `:bool` test body plus an `:i64` main."
  [format body]
  {:format format
   :entry 'main
   :exports ['main 'test-x]
   :effects #{}
   :functions
   [(cond-> {:name 'test-x :params [] :result :bool :effects #{} :body body}
      (= :kotoba.kir/v4 format) (assoc :param-types []))
    (cond-> {:name 'main :params [] :result :i64 :effects #{} :body 0}
      (= :kotoba.kir/v4 format) (assoc :param-types []))]})

(defn- emits? [kir]
  (module-bytes? (wasm/emit kir :wasm32-kotoba-v1 {:fuel 512})))

;; 1. The emitter lowered option-value / result-value / result-error and the
;; constructors, but `=` and `let` ask `typed/infer-type` for an operand's
;; type first, and none of the seven was there: "unsupported typed Wasm
;; expression" with or without a let-bound operand.
(deftest i64-safe-values-have-an-inferred-type
  (is (= :option-i64 (typed/infer-type '(option-some 4) {} {})))
  (is (= :option-i64 (typed/infer-type '(option-none) {} {})))
  (is (= :result-i64 (typed/infer-type '(result-ok 4) {} {})))
  (is (= :result-i64 (typed/infer-type '(result-err 4) {} {})))
  (is (= :i64 (typed/infer-type '(option-value o 0) '{o :option-i64} {})))
  (is (= :i64 (typed/infer-type '(result-value r 0) '{r :result-i64} {})))
  (is (= :i64 (typed/infer-type '(result-error r 0) '{r :result-i64} {}))))

(deftest i64-safe-value-extractors-lower-in-operand-position
  (testing "let-bound operand"
    (is (emits? (test-module :kotoba.kir/v4
                             '(let [o (option-some 4)] (= (option-value o 0) 4)))))
    (is (emits? (test-module :kotoba.kir/v4
                             '(let [r (result-ok 4)] (= (result-value r 0) 4)))))
    (is (emits? (test-module :kotoba.kir/v4
                             '(let [r (result-err 5)] (= (result-error r 0) 5))))))
  (testing "inline operand"
    (is (emits? (test-module :kotoba.kir/v4 '(= (option-value (option-none) 9) 9))))
    (is (emits? (test-module :kotoba.kir/v4 '(= (result-error (result-ok 5) 6) 6))))))

;; 2. With the constructor in operand position there is no typed local, the
;; frontend labels the module v3, and only the v4 emitter imports the compact
;; graph intrinsics: `disjoint-set-i64-new` was emitted as `call nil`
;; ("invalid Wasm index operand"). The let-bound form, typed by its local,
;; already compiled.
(deftest compact-graph-constructor-in-operand-position
  (is (emits? (test-module :kotoba.kir/v3
                           '(= (disjoint-set-i64-count (disjoint-set-i64-new 4)) 4))))
  (is (emits? (test-module :kotoba.kir/v3
                           '(= (string-index-count (string-index-new)) 0))))
  (testing "a v3 module with no compact graph value still emits"
    (is (emits? (test-module :kotoba.kir/v3 '(= 1 1))))))

;; 3. A `:bool` slot holds a host boolean. `emit-builder` boxes the i64 word
;; before `push-ref`; `emit-assoc` handed it to `assoc-ref` unboxed, so the
;; module did not validate. `emit` self-validates on every host with a
;; WebAssembly engine, which is the host `kbb -M:test` runs this suite on.
(def ^:private bool-pair '[:vector [:i64 :bool]])

(deftest hetero-vector-assoc-into-a-bool-position
  (is (emits? (test-module :kotoba.kir/v4
                           (list 'let ['v (list 'hetero-vector-new bool-pair 7 true)
                                       'w (list 'hetero-vector-assoc bool-pair 'v 1 false)]
                                 (list 'if (list 'hetero-vector-at bool-pair 'w 1) false true)))))
  (testing "the :i64 position, which already worked"
    (is (emits? (test-module :kotoba.kir/v4
                             (list '= (list 'hetero-vector-at bool-pair
                                            (list 'hetero-vector-assoc bool-pair
                                                  (list 'hetero-vector-new bool-pair 7 true) 0 8)
                                            0)
                                   8))))))
