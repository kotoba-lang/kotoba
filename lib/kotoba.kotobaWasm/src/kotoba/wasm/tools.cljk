(ns kotoba.wasm.tools
  "Pinned official tooling used only for Component Model encoding.

  Portable since 2026-09-11 (amu ADR 0348 iteration 4; the level-1 leaf of
  amu's `docs/jvm-route-topology.edn` outside amu itself). The contract is
  the same on both hosts: the binary on PATH must answer the pinned version
  or every call is refused, a WAT module is handed to the official parser
  through a private temporary directory, and the bytes come back. The JVM
  branch is the one that was here; the Node branch spawns the same commands
  through `node:child_process` with no shell in between."
  {:kotoba/export [assert-version! parse-wat run-command! version]}
  #?(:clj (:import
                   [java.nio.file Files]
                   [java.nio.file.attribute FileAttribute])
     :cljs (:require ["node:child_process" :as child]
                     ["node:fs" :as fs]
                     ["node:os" :as os]
                     ["node:path" :as path]))
  (:require [kotoba.bytes :as kbytes]))

(def version "1.243.0")

(defn- reject [message data]
  (throw (ex-info message (assoc data :phase :wasm-tools))))

(defn run-command! [args]
  #?(:clj
     (let [process (.start (doto (ProcessBuilder. ^java.util.List (vec args))
                             (.redirectErrorStream true)))
           output (kbytes/utf8-string (.readAllBytes (.getInputStream process)))
           exit (.waitFor process)]
       (when-not (zero? exit)
         (reject "pinned wasm-tools command failed"
                 {:command (vec args) :exit exit :output output}))
       output)
     :cljs
     (let [[command & rest] (vec args)
           result (.spawnSync child command (clj->js (vec rest))
                              #js {:encoding "utf8" :maxBuffer (* 64 1024 1024)})
           output (str (.-stdout result) (.-stderr result))]
       ;; A binary that is not on PATH is `.-error`, not a status; it is the
       ;; same refusal as a failing one, with the reason in :output.
       (when (.-error result)
         (reject "pinned wasm-tools command failed"
                 {:command (vec args) :exit nil :output (.-message (.-error result))}))
       (when-not (zero? (.-status result))
         (reject "pinned wasm-tools command failed"
                 {:command (vec args) :exit (.-status result) :output output}))
       output)))

(def ^:private version-pattern
  ;; `wasm-tools --version` prints `wasm-tools <version>` optionally followed
  ;; by a ` (<git-hash> <date>)` build-metadata suffix that varies between
  ;; otherwise-identical pinned builds. Pin the version token exactly; ignore
  ;; the suffix. \Q..\E quotes the dotted version literally on the JVM; the
  ;; JavaScript engine has no \Q, so the dots are escaped by hand there --
  ;; `wasm-tools-test` checks both spellings against the same inputs.
  (re-pattern (str "wasm-tools "
                   #?(:clj (str "\\Q" version "\\E")
                      :cljs (.replace version (js/RegExp. "\\." "g") "\\."))
                   "(?: \\(.*\\))?")))

(defn assert-version! []
  (let [output (.trim ^String (run-command! ["wasm-tools" "--version"]))]
    (when-not (re-matches version-pattern output)
      (reject "wasm-tools version is not pinned"
              {:expected version :actual output}))))

(defn parse-wat
  "Encode a generated core WAT module with the pinned official parser."
  [source]
  (assert-version!)
  #?(:clj
     (let [dir (Files/createTempDirectory "kotoba-component-core-"
                                          (make-array FileAttribute 0))
           wat (.resolve dir "core.wat")
           wasm (.resolve dir "core.wasm")]
       (try
         (Files/writeString wat ^String source (make-array java.nio.file.OpenOption 0))
         (run-command! ["wasm-tools" "parse" (str wat) "-o" (str wasm)])
         (Files/readAllBytes wasm)
         (finally
           (Files/deleteIfExists wasm)
           (Files/deleteIfExists wat)
           (Files/deleteIfExists dir))))
     :cljs
     (let [dir (.mkdtempSync fs (.join path (.tmpdir os) "kotoba-component-core-"))
           wat (.join path dir "core.wat")
           wasm (.join path dir "core.wasm")]
       (try
         (.writeFileSync fs wat source "utf8")
         (run-command! ["wasm-tools" "parse" wat "-o" wasm])
         (.readFileSync fs wasm)
         (finally
           (.rmSync fs dir #js {:recursive true :force true}))))))
