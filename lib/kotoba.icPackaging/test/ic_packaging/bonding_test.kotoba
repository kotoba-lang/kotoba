(ns ic-packaging.bonding-test (:export [main]) (:require [ic-packaging.bonding :as p]))

(defn- fedn [d :document k :keyword] :string
  (document-edn-print (option-or (document-get d k) (document-null))))

(defn- fcount [d :document k :keyword] :i64
  (document-count (option-or (document-get d k) (document-null))))

(defn- at [v :document i :i64] :document
  (option-value-of [:option :document] (document-vector-at v i) (document-null)))

(defn main [] :i64
  (let [wb (p/wire-bond (document-f64 25.0) (document-f64 200.0))
        dies (document-vector (p/pad-location (document-string "P1") (document-i64 1) (document-i64 2))
                              (p/pad-location (document-string "P2") (document-i64 3) (document-i64 4)))
        pkgs (document-vector (p/pad-location (document-string "A") (document-i64 10) (document-i64 20))
                              (p/pad-location (document-string "B") (document-i64 30) (document-i64 40))
                              (p/pad-location (document-string "C") (document-i64 50) (document-i64 60)))
        d (p/generate-bond-diagram dies pkgs (document-keyword :thermo-compression))
        b0 (at (option-or (document-get d :bonds) (document-null)) 0)
        b1 (at (option-or (document-get d :bonds) (document-null)) 1)]
    (+ (if (string=? (fedn wb :kind) ":wire-bond") 0 1)
       (if (string=? (fedn wb :loop-height-um) "200.0") 0 1)
       (if (string=? (fedn (p/flip-chip (document-f64 1.0) (document-f64 2.0)) :kind) ":flip-chip") 0 1)
       (if (string=? (fedn (p/thermo-compression) :kind) ":thermo-compression") 0 1)
       (if (= (fcount d :bonds) 2) 0 1)
       (if (string=? (fedn b0 :pad-name) "\"P1\"") 0 1)
       (if (string=? (fedn b0 :pkg-x) "10") 0 1)
       (if (string=? (fedn b1 :pkg-y) "40") 0 1)
       (if (string=? (fedn b1 :bond-type) ":thermo-compression") 0 1)
       (if (= (fcount (p/bond-diagram (document-null)) :bonds) 0) 0 1))))
