;; Port of ic-packaging.bonding (bonding.cljk), Kotoba-native, :document maps.
;;
;; Named divergences from bonding.cljk:
;;   - thermo-compression is a zero-arg function (a constant map).
;;   - bond-diagram keeps its bonds value; a nil bonds gives the empty vector
;;     (as (vec nil) does in the source).
;;   - generate-bond-diagram reads pads by index with document-vector-at; a
;;     nil pad list gives no bonds.

(ns ic-packaging.bonding
  (:export [wire-bond flip-chip thermo-compression pad-location bond
            bond-diagram generate-bond-diagram]))

(defn- field [m :document k :keyword] :document
  (if (map? m)
    (option-or (document-get m k) (document-null))
    (document-null)))

(defn- null-doc? [d :document] :bool
  (string=? (document-edn-print d) (document-edn-print (document-null))))

(defn- or-empty [v :document] :document
  (if (null-doc? v) (document-vector) v))

(defn- at-or-null [v :document i :i64] :document
  (option-value-of [:option :document] (document-vector-at v i) (document-null)))

(defn wire-bond [wire-diameter-um :document loop-height-um :document] :document
  (document-map :kind (document-keyword :wire-bond)
                :wire-diameter-um wire-diameter-um
                :loop-height-um loop-height-um))

(defn flip-chip [bump-pitch-um :document bump-diameter-um :document] :document
  (document-map :kind (document-keyword :flip-chip)
                :bump-pitch-um bump-pitch-um
                :bump-diameter-um bump-diameter-um))

(defn thermo-compression [] :document
  (document-map :kind (document-keyword :thermo-compression)))

(defn pad-location [name :document x :document y :document] :document
  (document-map :name name :x x :y y))

(defn bond [opts :document] :document
  (document-map :pad-name (field opts :pad-name)
                :die-x (field opts :die-x)
                :die-y (field opts :die-y)
                :pkg-x (field opts :pkg-x)
                :pkg-y (field opts :pkg-y)
                :bond-type (field opts :bond-type)))

(defn bond-diagram [bonds :document] :document
  (document-map :bonds (or-empty bonds)))

(defn generate-bond-diagram [die-pads :document pkg-pads :document bond-type :document] :document
  (let [dies (or-empty die-pads)
        pkgs (or-empty pkg-pads)
        n (min (document-count dies) (document-count pkgs))
        bonds (loop [i 0 acc (document-vector)]
                (if (< i n)
                  (let [dp (at-or-null dies i)
                        pp (at-or-null pkgs i)]
                    (recur (+ i 1)
                           (document-vector-conj acc
                                                 (bond (document-map :pad-name (field dp :name)
                                                                     :die-x (field dp :x)
                                                                     :die-y (field dp :y)
                                                                     :pkg-x (field pp :x)
                                                                     :pkg-y (field pp :y)
                                                                     :bond-type bond-type)))))
                  acc))]
    (bond-diagram bonds)))
