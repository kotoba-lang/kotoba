;; basename -- POSIX basename (IEEE Std 1003.1) as a Kotoba command.
;;
;;   basename STRING [SUFFIX]     the last path component, SUFFIX removed
;;   basename -s SUFFIX STRING    the same (the BSD spelling)
;;   basename -- STRING           STRING may begin with a dash
;;
;; ## Measured, 2026-09-16
;;
;; 760 invocations in 1,268,018 agent Bash calls (superproject
;; ADR-2609161710): `basename ARG` 619, `basename ARG SUFFIX` 146, `--` 3,
;; `-s` 0 -- kept because it is the same table. No `-a`.
;;
;; The algorithm is POSIX's, checked against /usr/bin/basename on each edge:
;;   1. ""            -> "" (an empty line)
;;   2. all slashes   -> "/"
;;   3. strip trailing slashes; the answer is what follows the last slash
;;   4. SUFFIX removed only when it is a PROPER suffix (`basename c.txt .txt`
;;      is `c`; `basename .txt .txt` is `.txt`)
;;
;; Capabilities: :cli/args (38), :io/write (37), :io/write-error (39).
(ns basename.core (:export [main]))

(defn arg [i :string] :string
  (typed-cap-call :cli/args :string :string i))

(defn emit [s :string] :string
  (typed-cap-call :io/write :string :string s))

(defn emit-error [s :string] :string
  (typed-cap-call :io/write-error :string :string s))

(defn nl [] :string "\n")

(defn digit-text [d :i64] :string
  (string-substring "0123456789" d (+ d 1)))

(defn decimal-of [n :i64] :string
  (if (< n 10)
    (digit-text n)
    (string-concat (decimal-of (quot n 10)) (digit-text (- n (* 10 (quot n 10)))))))

(defn argc-from [k :i64 total :string] :i64
  (if (string=? (decimal-of k) total) k (argc-from (+ k 1) total)))

(defn argc [] :i64 (argc-from 0 (arg "")))

;; The last non-empty component of S as a packed pair START * 2^32 + END, or
;; -1 when S has no such component (empty, or all slashes). One FORWARD walk
;; over the slash positions with `string-find-byte`: a slash is always a
;; code-point boundary, so no offset this constructs can land inside a
;; multi-byte sequence -- the first cut walked BACKWARD a byte at a time and
;; `string-code-point-at` refused the continuation byte of 本 (SIGILL,
;; measured 2026-09-16).
(defn- last-component [s :string from :i64 n :i64 found :i64] :i64
  (if (>= from n)
    found
    (let [i (string-find-byte s 47 from)]
      (if (< i 0)
        (+ (* from 4294967296) n)
        (if (> i from)
          (last-component s (+ i 1) n (+ (* from 4294967296) i))
          (last-component s (+ i 1) n found))))))

;; Does S end with SUFFIX, as a PROPER suffix (something before it)?
(defn- ends-with? [s :string suffix :string] :bool
  (let [n (string-byte-length s)
        m (string-byte-length suffix)]
    (if (>= m n)
      false
      (if (= m 0)
        false
        (= 0 (string-compare (string-substring s (- n m) n) suffix))))))

(defn- base-of [s :string suffix :string] :string
  (let [n (string-byte-length s)
        packed (last-component s 0 n -1)]
    (if (= n 0)
      ""
      (if (< packed 0)
        "/"
        (let [start (quot packed 4294967296)
              end (- packed (* 4294967296 (quot packed 4294967296)))
              base (string-substring s start end)]
          (if (ends-with? base suffix)
            (string-substring base 0 (- (string-byte-length base) (string-byte-length suffix)))
            base))))))

(defn- usage [] :i64
  (do (emit-error "usage: basename string [suffix]")
      (emit-error (nl))
      (emit-error "       basename [-a] [-s suffix] string [...]")
      (emit-error (nl))
      1))

(defn- answer [s :string suffix :string] :i64
  (do (emit (base-of s suffix)) (emit (nl)) 0))

;; Three or more operands: /usr/bin/basename answers each one, no suffix --
;; the `-a` form without the flag. Measured: `basename a b c` prints three
;; lines and exits 0 where POSIX would call it a usage error.
(defn- each [i :i64 n :i64 suffix :string] :i64
  (if (>= i n) 0 (do (answer (arg (decimal-of i)) suffix) (each (+ i 1) n suffix))))

(defn main [] :i64
  (let [n (argc)]
    (if (= n 0)
      (usage)
      (let [a0 (arg "0")]
        (if (string=? a0 "--")
          (if (= n 1) (usage) (if (= n 2) (answer (arg "1") "") (if (= n 3) (answer (arg "1") (arg "2")) (each 1 n ""))))
          (if (string=? a0 "-s")
            (if (< n 3) (usage) (if (= n 3) (answer (arg "2") (arg "1")) (each 2 n (arg "1"))))
            (if (= n 1)
              (answer a0 "")
              (if (= n 2)
                (answer a0 (arg "1"))
                (each 0 n "")))))))))
