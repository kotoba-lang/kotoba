(ns activitystreams
  (:export [main context-key as-context ensure-vector object actor activity note person
            create update-activity delete follow like announce activity? errors validate]))

(defn main [] :i64 0)
(defn context-key [] :keyword (keyword-from-string "@context"))
(defn as-context [] :string "https://www.w3.org/ns/activitystreams")

(defn fail-document [] :document
  (document-vector-assoc (document-vector) 0 (document-null)))

(defn field [value :document key :keyword] :document
  (option-or (document-get value key) (fail-document)))

(defn maybe-field [value :document key :keyword] :document
  (option-or (document-get value key) (document-null)))

(defn doc-bool [value :document] :bool
  (option-or (document-bool-value value) false))

(defn present? [value :document] :bool
  (case (document-kind value)
    :null false
    :bool (doc-bool value)
    true))

(defn ensure-vector [value :document] :document
  (case (document-kind value)
    :null (document-vector)
    :vector value
    (document-vector value)))

(defn base-object [type :keyword props :document] :document
  (document-merge
    (document-map
      (context-key) (document-string (as-context))
      :type (document-string (keyword-name type)))
    props))

(defn object
  ([type :keyword props :document] :document
   (base-object type props))
  ([id :document type :keyword props :document] :document
   (document-assoc (base-object type props) :id id)))

(defn actor [id :document type :keyword props :document] :document
  (object id type props))

(defn without-activity-fields [props :document] :document
  (let [a (document-dissoc props :id)
        b (document-dissoc a :actor)
        c (document-dissoc b :object)
        d (document-dissoc c :target)
        e (document-dissoc d :result)
        f (document-dissoc e :to)
        g (document-dissoc f :cc)]
    (document-dissoc g :published)))

(defn assoc-present
  [output :document props :document key :keyword vectorize? :bool] :document
  (if (document-contains props key)
    (let [value (field props key)]
      (if (present? value)
        (document-assoc output key (if vectorize? (ensure-vector value) value))
        output))
    output))

(defn activity [type :keyword props :document] :document
  (let [base (base-object type (without-activity-fields props))
        with-id (assoc-present base props :id false)
        with-actor (assoc-present with-id props :actor false)
        with-object (assoc-present with-actor props :object false)
        with-target (assoc-present with-object props :target false)
        with-result (assoc-present with-target props :result false)
        with-to (assoc-present with-result props :to true)
        with-cc (assoc-present with-to props :cc true)]
    (assoc-present with-cc props :published false)))

(defn note [props :document] :document (object :Note props))
(defn person [props :document] :document (object :Person props))
(defn create [props :document] :document (activity :Create props))
(defn update-activity [props :document] :document (activity :Update props))
(defn delete [props :document] :document (activity :Delete props))
(defn follow [props :document] :document (activity :Follow props))
(defn like [props :document] :document (activity :Like props))
(defn announce [props :document] :document (activity :Announce props))

(defn activity-type? [value :string] :bool
  (if (or (string=? value "Create")
          (string=? value "Update")
          (string=? value "Delete")
          (string=? value "Follow")
          (string=? value "Like")
          (string=? value "Announce")
          (string=? value "Accept")
          (string=? value "Reject"))
    true false))

(defn activity? [value :document] :bool
  (if (= (document-kind value) :map)
    (if (document-contains value :type)
      (option-match [:option :string]
        (document-string-value (field value :type))
        false type-name (activity-type? type-name))
      false)
    false))

(defn error-document [code :keyword] :document
  (document-map :error (document-keyword code)))

(defn errors [value :document] :document
  (if (= (document-kind value) :map)
    (if (document-contains value :type)
      (if (= (document-kind (field value :type)) :null)
        (document-vector (error-document :activitystreams/missing-type))
        (document-vector))
      (document-vector (error-document :activitystreams/missing-type)))
    (document-vector (error-document :activitystreams/document-must-be-map))))

(defn validate [value :document] :document
  (let [found (errors value)]
    (document-map
      :valid? (document-bool (if (= (document-count found) 0) true false))
      :errors found)))
