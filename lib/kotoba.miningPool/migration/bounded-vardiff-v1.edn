{:schema "kotoba-mining-pool-migration/v1"
 :profile :mining-pool/bounded-vardiff-v1
 :legacy {:engine "src/mining_pool/vardiff.cljk"
          :status :retained-general-oracle}
 :canonical {:engine-and-conformance "src/mining_pool/bounded_vardiff.kotoba"}
 :domain {:function :adjust-difficulty
          :params [:current :observed-seconds-per-share :target-seconds-per-share
                   :max-adjust-factor]
          :pinned-not-parameterized {:min-difficulty 1.0}
          :formula
          "safe-observed = max(observed, 0.001); ratio = target / safe-observed;
           clamped = clamp(ratio, 1/max-adjust-factor, max-adjust-factor);
           result = max(1.0, current * clamped)"}
 :excluded [:general-min-difficulty-parameter :stratum-protocol-encode-decode
            :share-validation :ledger-and-payout-schemes]
 :compiler-finding
 {:description "Functions with five or more :f64-typed parameters miscompile
                to Wasm (\"invalid local index\" at WebAssembly.compile time)
                even though five params is within the compiler's own declared
                max-parameters admission limit; the admission gate accepts
                the source, the Wasm backend then emits an invalid module."
  :compiler-sha "def5161be96d489539175813326a316da46268be"
  :isolation
  {:two-f64-params :compiles-and-runs
   :four-f64-params :compiles-and-runs
   :five-f64-params :wasm-instantiation-fails
   :error "WebAssembly.compile(): Compiling function #N failed: invalid local index"
   :reproduced-with-minimal-standalone-functions true}
  :original-design-had-five-params
  [:current :observed-seconds-per-share :target-seconds-per-share
   :min-difficulty :max-adjust-factor]
  :resolution "pinned min-difficulty to the Stratum-standard 1.0 floor,
               dropping to four params; every legacy test.cljc case already
               used the default min-difficulty of 1, so this changes no
               observed behavior for the cases checked -- a real bounded-
               profile narrowing, not a disguised workaround"
  :also-found "cross-file :require of a function returning raw :f64 fails
               project-linking (\"project import result type has no closed
               stub value\" -- kotoba.compiler.project/stub-value has no
               case for :f64/:f32), independent of the five-param bug; kernel
               and conformance were kept in one file to avoid it, matching
               the kotoba-lang/pbrt / kami-usd-native / rtx-native single-
               file precedent"}
 :verification {:legacy {:tests 15 :assertions 29 :failures 0 :errors 0}
                :hand-verified-cases
                [{:case "shares arriving too fast" :current 100 :observed 1
                  :target 4 :max-adjust-factor 4 :expected 400.0}
                 {:case "shares arriving too slow" :current 100 :observed 16
                  :target 4 :max-adjust-factor 4 :expected 25.0}
                 {:case "clamped up at the floor observed time"
                  :current 100 :observed 0.0001 :target 4 :max-adjust-factor 4
                  :expected 400.0}
                 {:case "clamped down" :current 100 :observed 100000
                  :target 4 :max-adjust-factor 4 :expected 25.0}
                 {:case "floored at min-difficulty" :current 0.5 :observed 100000
                  :target 4 :max-adjust-factor 4 :expected 1.0}]
                :equality-method "f64-to-bits comparison via = (kotoba-lang/
                                   compiler's = operator does not admit :f64
                                   operands directly -- only :i64/:keyword/
                                   :bool/:option-i64/:result-i64/:vector-i64
                                   and parametric result types)"
                :web {:main 42 :required-capabilities []}
                :wasm {:main 42}
                :required-capabilities []
                :local-verification
                {:clojure-test {:tests 15 :assertions 29 :failures 0 :errors 0}
                 :lint {:errors 0 :warnings 0}
                 :kotoba-compile [:js-browser :wasm32-browser]
                 :kotoba-conformance :passed-both-targets}}
 :cutover {:bounded-profile-authorized true :general-cljc-oracle-retained true}}
