(ns mining-pool.ledger-test (:export [main]) (:require [mining-pool.ledger :as p]))

(defn- ok [b :bool] :i64
  (if b 0 1))

(defn- entry [miner :string difficulty :i64] :document
  (document-map :miner (document-string miner) :difficulty (document-i64 difficulty)))

(defn- ledger [] :document
  (p/append (p/append (p/append (document-vector) (entry "a" 2)) (entry "b" 3)) (entry "a" 5)))

(defn- append-checks [] :i64
  (+ (ok (= (document-count (ledger)) 3))
     (ok (= (document-count (p/append (document-vector) (entry "a" 1))) 1))))

(defn- pay-checks [] :i64
  (+ (ok (document-equal? (p/pay-per-share (ledger) 10)
                          (document-map (document-string "a") (document-i64 70)
                                        (document-string "b") (document-i64 30))))
     (ok (document-equal? (p/pay-per-share (document-vector) 10) (document-map)))))

(defn main [] :i64
  (+ (append-checks) (pay-checks)))
