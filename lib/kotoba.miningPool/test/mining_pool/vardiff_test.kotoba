(ns mining-pool.vardiff-test
  (:export [main])
  (:require [mining-pool.vardiff :as v]))

(defn- near [a :f64 b :f64] :bool
  (f64-lt (f64-abs (f64-sub a b)) 0.000001))

(defn main [] :i64
  (let [floor5 (document-map :min-difficulty (document-f64 5.0))
        target2 (document-map :target-seconds-per-share (document-f64 2.0))]
    (+ (if (near (v/adjust-difficulty 10.0 2.0) 20.0) 0 1)
       (if (near (v/adjust-difficulty 10.0 0.0) 40.0) 0 1)
       (if (near (v/adjust-difficulty 10.0 100.0) 2.5) 0 1)
       (if (near (v/adjust-difficulty-opts 1.0 100.0 floor5) 5.0) 0 1)
       (if (near (v/adjust-difficulty-opts 10.0 2.0 target2) 10.0) 0 1)
       (if (near (v/adjust-difficulty-opts 10.0 2.0 (document-map)) 20.0) 0 1))))
