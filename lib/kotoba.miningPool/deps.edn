;; mining-pool — Stratum v1 protocol logic, share validation, vardiff, and a
;; PPLNS payout reference implementation. Protocol/logic layer only in this
;; v1 — no hardened production TCP server (see the ADR's out-of-scope list).
{:paths ["src"]
 :deps {
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}
        io.github.kotoba-lang/btc-mining {:local/root "../kotoba.btcMining"}
        io.github.kotoba-lang/btc-crypto {:local/root "../kotoba.btcCrypto"}
        io.github.kotoba-lang/eth-crypto {:local/root "../kotoba.ethCrypto"}
        io.github.kotoba-lang/crypto {:local/root "../kotoba.crypto"}
        io.github.kotoba-lang/json {:local/root "../kotoba.json"}}
 :aliases
 {:test {:extra-paths ["test"]}

  :kotoba {:replace-paths ["src"]
           :replace-deps {io.github.kotoba-lang/amu
                          {:git/url "https://github.com/kotoba-lang/amu.git"
                           :git/sha "def5161be96d489539175813326a316da46268be"}}
           :main-opts ["-m" "kotoba.compiler.cli"]}}}
