;; Port of mining-pool.ledger (ledger.cljk), Kotoba-native, :document values.
;;
;; PARTIAL. Ported: `append` and `pay-per-share` (integer reward and
;; difficulty, i64). Not ported: `pplns-payout`. Its share is
;; (* total-reward (/ window-sum total-diff)), a rational or f64 quotient, and
;; Kotoba has no f64 arithmetic or division with a fractional result. An
;; integer-quotient approximation would change the values, so it is left out.
;;
;; Named divergences:
;;   - pay-per-share takes an i64 reward per difficulty unit; the source
;;     accepts any number. Entries are :document maps with :miner and an i64
;;     :difficulty.

(ns mining-pool.ledger
  (:export [append pay-per-share]))

(defn- field [m :document k :keyword] :document
  (if (map? m)
    (option-or (document-get m k) (document-null))
    (document-null)))

(defn append [ledger :document entry :document] :document
  (document-vector-conj ledger entry))

(defn- miner-total [acc :document miner :document] :i64
  (option-or (document-i64-value (option-or (document-get acc miner) (document-null))) 0))

(defn- pps-loop [ledger :document rate :i64 i :i64 acc :document] :document
  (if (>= i (document-count ledger))
    acc
    (let [e (option-or (document-vector-at ledger i) (document-null))
          miner (field e :miner)
          diff (option-or (document-i64-value (field e :difficulty)) 0)
          total (+ (miner-total acc miner) (* rate diff))]
      (pps-loop ledger rate (+ i 1) (document-assoc acc miner (document-i64 total))))))

(defn pay-per-share [ledger :document rate :i64] :document
  (pps-loop ledger rate 0 (document-map)))
