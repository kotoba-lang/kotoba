;; Port of mining-pool.vardiff (vardiff.cljk), Kotoba-native, f64 arithmetic.
;;
;; Named divergences from vardiff.cljk:
;;   - Kotoba exports no multi-arity fns (E2138). adjust-difficulty is the
;;     2-arity form with default options; adjust-difficulty-opts is the 3-arity
;;     form that takes the opts map as a :document.
;;   - opts defaults are read with option-or; a non-numeric option reads as its default.
;;   - max and min are f64-max and f64-min.

(ns mining-pool.vardiff
  (:export [adjust-difficulty adjust-difficulty-opts]))

(defn- opt-f64 [opts :document k :keyword dflt :f64] :f64
  (option-or (document-f64-value (option-or (document-get opts k) (document-null))) dflt))

(defn adjust-difficulty-opts [current :f64 observed-seconds-per-share :f64 opts :document] :f64
  (let [target (opt-f64 opts :target-seconds-per-share 4.0)
        min-difficulty (opt-f64 opts :min-difficulty 1.0)
        max-adjust-factor (opt-f64 opts :max-adjust-factor 4.0)
        safe-observed (f64-max observed-seconds-per-share 0.001)
        ratio (f64-div target safe-observed)
        clamped-ratio (f64-max (f64-div 1.0 max-adjust-factor) (f64-min max-adjust-factor ratio))]
    (f64-max min-difficulty (f64-mul current clamped-ratio))))

(defn adjust-difficulty [current :f64 observed-seconds-per-share :f64] :f64
  (adjust-difficulty-opts current observed-seconds-per-share (document-map)))
