{:paths ["src"]
 ;; The Kademlia message is protobuf; that is the only runtime dependency.
 ;; Hashing (kad.key), HTTP (kad.routing) and record validation are all
 ;; injected, so this library holds no crypto, no socket and no clock.
 :deps {
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}
        io.github.kotoba-lang/dev-protobuf {:local/root "../kotoba.devProtobuf"}}
 :aliases
 {:test {:extra-paths ["test"]}}}
