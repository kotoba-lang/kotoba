;; bench/benchmark.edn — the fixed judge for the query plane's co-scientist
;; loop.
;;
;; Owner instructions, in order: 2026-09-11 "benchmark も決めて" (v1 below,
;; superseded the same day); 2026-09-11 "lcdb 世界 no1 を bench にして.
;; network over で." -- the benchmark is LDBC SNB Interactive, the target is
;; the audited world No.1, and every scored number is measured over the
;; network. This file is v2 of that contract. v1 is kept at the bottom as
;; the judge iterations 11 and 12 were scored under, so their scoreboard
;; rows stay readable; it no longer scores anything.
;;
;; Changing this file is a decision, not a tidy-up: an iteration that moves
;; the judge and the number in the same commit has measured nothing.
;; `bench/scoreboard.edn` (append-only) holds one row per iteration; rows
;; carry the benchmark id they were scored under.
{:benchmark/id :ldbc-snb-interactive-network-v2
 :benchmark/since "2026-09-11 (iteration 13 is the first row scored under it)"
 :benchmark/supersedes :ayatori-query-plane-v1

 ;; ── the workload ───────────────────────────────────────────────────────────
 ;; LDBC Social Network Benchmark, Interactive workload, as specified by the
 ;; LDBC (now Graph Data Council) -- the audited table is Interactive v1
 ;; (spec/auditing policies v2.2.3 on the latest FDR). Read from
 ;; https://ldbcouncil.org/benchmarks/snb/interactive/ on 2026-09-11.
 :workload {:name "LDBC SNB Interactive v1"
            :spec "https://ldbcouncil.org/ldbc_snb_docs/ldbc-snb-specification.pdf"
            :datagen "v1.0.0, CsvComposite/LongDateFormatter"
            :data "https://datasets.ldbcouncil.org/snb-interactive-v1/social_network-sf<SF>-CsvComposite-LongDateFormatter.tar.zst"
            :parameters "https://datasets.ldbcouncil.org/snb-interactive-v1-parameters/substitution_parameters-sf<SF>.tar.zst"
            :updates "https://datasets.ldbcouncil.org/snb-interactive-v1-updates/social_network-sf<SF>-numpart-<N>.tar.zst"
            :operations "14 complex reads IC1-IC14, 7 short reads IS1-IS7, 8 inserts INS1-INS8 (v1); the driver interleaves them by simulation time"}

 ;; ── the metric (the benchmark's own, not ours) ─────────────────────────────
 ;; One number: throughput in operations per second, obtained by running the
 ;; operation stream at a schedule set by the time-compression ratio (TCR).
 ;; A run is valid only under the 95% on-time requirement: 95% of operations
 ;; must START within 1 second of their scheduled start
 ;; (results_log.csv: actual_start_time - scheduled_start_time < 1 s).
 ;; Systems compete on the lowest TCR that still passes. Per-operation
 ;; execution times (min/max/mean/P50/P90/P95/P99) are reported, not scored.
 :metric {:primary :throughput-ops-per-second
          :validity "95% of operations start within 1 s of schedule; answers validated against the reference implementation"
          :reported [:per-operation-p50-p90-p95-p99 :load-time :on-time-compliance]}

 ;; ── over the network ───────────────────────────────────────────────────────
 ;; The driver and the system under test are different processes joined by
 ;; TCP/HTTP; a number produced by calling the engine in-process is not a
 ;; row of this benchmark (it is what kotobase-peer/bench/results/*ldbc*
 ;; hold, and they say so). Three origins are recognised, and every row
 ;; names which one it was:
 :network {:loopback "driver and SUT on one host over 127.0.0.1 -- the smallest thing that is still a network measurement"
           :cross-host "driver on one fleet mac-mini, SUT on another (murakumo fleet)"
           :live "driver anywhere, SUT = the deployed kotobase.net query surface"
           :rule "a row must name its origin; rows at different origins are different columns, never compared as one"}

 ;; ── the target ─────────────────────────────────────────────────────────────
 ;; The audited world No.1 on the LDBC SNB Interactive results table as read
 ;; on 2026-09-11 (three SFs in one FDR, all by the same system):
 ;;
 ;;   date        system                        sponsor        SF    throughput  on-time   TCR
 ;;   2025-12-01  Graph Engine Service 3.1.0    Huawei Cloud   100   129,090     98.92%    0.00010
 ;;   2025-12-01  Graph Engine Service 3.1.0    Huawei Cloud   300   139,411     98.96%    0.00315
 ;;   2025-12-01  Graph Engine Service 3.1.0    Huawei Cloud   1000  125,873     95.50%    0.02300
 ;;
 ;; SUT: 1 x km2.40xlarge.8 (160 Kunpeng cores @ 2.0 GHz, 1280 GiB, 6000 GiB
 ;; NVMe), C++, 64 driver read threads, 48 partitions / write threads, Read
 ;; Committed; 3-year system cost 2,939,112 RMB; audited by Dr. Benjamin
 ;; Steer. Previous holder: GraphScope Flex (Alibaba), 2024-05-14, SF300
 ;; 131,264 ops/s. Source: LDBC_SNB_I_20251201_SF100-300-1000_huawei
 ;; executive summary.
 :target {:record :world-no1-audited
          :read-on "2026-09-11"
          :source "https://ldbcouncil.org/benchmarks/snb/interactive/"
          :fdr "https://ldbcouncil.org/docs/audits/snb/LDBC_SNB_I_20251201_SF100-300-1000_huawei.pdf"
          :system "Graph Engine Service 3.1.0 (Huawei Cloud), 2025-12-01"
          :throughput-ops-s {:sf100 129089.68 :sf300 139411.14 :sf1000 125872.54}
          :peak-ops-s 139411.14
          :hardware "1 node, 160 cores, 1280 GiB RAM, C++"
          :note "the target is a number on a machine 160x this workstation's core count and with a 3-year price; the gap is reported as a ratio per SF, never rescaled by hardware"}

 ;; ── the scale ladder ───────────────────────────────────────────────────────
 ;; The audited table starts at SF30. We start where the data fits one JVM
 ;; and climb; every rung is a separate column. SF1 is not on the table and
 ;; is not compared against it -- it is where the mechanism is found.
 ;; Amended 2026-09-11 after iteration 34: SF1 is served WHOLE and resident
 ;; for the first time (datalog 645c9e58, one-value counterpart sets cost
 ;; one object: 20.6M quads in 4.4 GB used heap on a 16 GiB host). The
 ;; subset rung stays as its own column; the full rung is `:sf1-full`.
 ;; SF3 is the next rung and, by the same bytes-per-quad, ~13 GB -- it
 ;; needs a persisted plane or a larger host before it is a column.
 :scale {:ladder [1 3 10 30 100 300 1000]
         :first-audited-rung 30
         :current-rung 1
         :sf1-rungs [:sf1-subset-35k-posts+profiles+knows-dates+forums :sf1-full]}

 ;; ── the gate ───────────────────────────────────────────────────────────────
 ;; A run with failed operations, or with fewer than 95% on-time starts, or
 ;; whose answers disagree with the reference, is not a row. The driver
 ;; exits 2 when nothing was measured. Every row also carries the share of
 ;; EMPTY answers: an empty answer is fast for the wrong reason (root
 ;; ADR-2609109900), and a subset of the data makes official parameters
 ;; empty; a rung whose empty share is not ~0 is a subset rung and says so.
 ;; Amended 2026-09-11 after iteration 14: the same IC08 was 1.9 ms
 ;; in-process and 96-310 ms served with the SUT JVM paged out (host swap
 ;; 34.5 of 35.8 GB). Load average did not show it; swap did. A run on a
 ;; host past the swap threshold is refused by the driver (exit 2), and
 ;; host memory is written beside every row with the load average.
 ;; Amended 2026-09-12 after iteration 40: on an Apple-silicon SUT a lightly
 ;; loaded process runs on the efficiency cores, so server-ms p50 at a low
 ;; rate is ~2.5x the same op's cost at saturation (IC09 12.0 vs 4.8 ms on
 ;; the same parameters). Per-op costs are compared at saturation only;
 ;; ceilings are unaffected.
 :gate {:validity [:zero-failed-operations :on-time>=95% :answers-agree-with-reference :sut-resident]
        ;; Amended 2026-09-11 after iteration 26: a full-SF1 SUT with 6.6 GB
        ;; of its heap in swap passed the swap threshold (80.7%) and the old
        ;; half-heap RSS rule, and answered IC02 at 111 ms against 3.4 ms
        ;; resident. The SUT's own reading is judged: RSS below 0.95 x used
        ;; heap means part of the heap is not in memory, and the run is refused.
        :sut-resident "driver refuses when the SUT's (or, failing that, its own host's) swap-used exceeds --max-swap-pct (default 90), or when the SUT's RSS is below 0.95 x its used heap; :host-memory (heap used, RSS, swap) is in every receipt"
        :reference "kotobase-peer.ldbc-snb-bench asserts the four served reads equal Neo4j's on the same data; a rung adds operations only with a reference for each"
        :empty-answer-share :reported-on-every-row}

 ;; ── what counts as growth ─────────────────────────────────────────────────
 ;; Growth is a higher passing throughput at the same rung and origin with
 ;; the same operation mix, or the same throughput at a higher rung or a
 ;; wider mix (more of the 29 operations). A trade (throughput up, on-time
 ;; down toward 95%) is recorded as a trade. Wall-clock is the axis here
 ;; because the benchmark defines it so; the load average at measurement
 ;; time is written beside every row so a machine-shaped number is
 ;; recognisable as one.
 ;; Amended 2026-09-12 after iteration 46: the driver now runs LDBC's own
 ;; operation schedule (`--official`: complex read N every update_interleave
 ;; x freq_N of simulation time from the driver's sf1.properties, the update
 ;; stream at the same TCR under the dependency rule, short reads following
 ;; complex reads with dissipation 0.2 -- approximated, stated). Under it
 ;; the sweep is over TCR and the metric is the throughput at the lowest
 ;; passing TCR, which is how the audited table defines it. Rows carry
 ;; `:schedule :official`; the uniform round-robin rows stay as their own
 ;; column (`:schedule :uniform`, the default before this date).
 ;; Amended 2026-09-12 after iteration 48: the short-read generator is LDBC's
 ;; own (LdbcSnbShortReadGenerator, ported rule for rule); official rows
 ;; carry `:generator :exact`, and the two rows measured under the earlier
 ;; approximation are marked `:generator :approximate-superseded-by-iteration-48`.
 :schedule {:official {:properties "kotobase-peer bench/ldbc-sf1-official.properties" :metric :throughput-at-lowest-passing-tcr :generator :exact}
            :uniform {:metric :throughput-at-highest-passing-rate}}
 :growth {:primary :throughput-ops-s
          :held [:rung :origin :mix]
          :widening [:rung :mix]
          :rule "throughput strictly higher with rung/origin/mix held, or rung or mix widened at >= the previous throughput; else :no-growth or :trade with the price stated"
          :load-avg :written-beside-every-row
          :host-memory :written-beside-every-row}

 ;; ── current coverage, honestly ─────────────────────────────────────────────
 ;; The kotobase side today serves 4 of the 29 operations (IC02, IC07, IC08,
 ;; IC09) from `kotobase-peer.ldbc-snb-net`, the driver is our own open-loop
 ;; scheduled one (`bench/ldbc_snb_driver.cljk`), and the data is SF1. None
 ;; of that is the certified driver over the full workload with an auditor;
 ;; no row claims to be an LDBC score until it is.
 :coverage {:operations-served [:ic02 :ic07 :ic08 :ic09]
            :operations-total 29
            :driver "bench/ldbc_snb_driver.cljk (kotobase-peer), open-loop, official substitution parameters, 95% on-time rule"
            :sut "kotobase-peer.ldbc-snb-net (JDK HttpServer over the hot db)"
            :ldbc-score? false}

 ;; ── what is NOT in this benchmark, on purpose ─────────────────────────────
 :excluded {:in-process "a function call measured with nanoTime is the previous receipts' unit, not this benchmark's"
            :hardware-rescaling "no per-core or per-price normalisation of the target; the ratio is reported raw"
            :read-counts "the v1 axes (reads, bytes) remain the query plane's transport diagnostics and inform hypotheses; they are not scored here"}

 ;; ── v1, superseded 2026-09-11 (kept so iterations 11-12 stay readable) ───
 :superseded
 {:benchmark/id :ayatori-query-plane-v1
  :benchmark/since "2026-09-11 (iteration 11 is the first row scored under it)"
  :corpus {:generator "bench/fitness corpus: n subjects, exactly 3 kind=rare"
           :sizes [50 100 200 400 800]
           :fixed-shape 800
           :query [:find [?s ?name] :where [[?s "kind" "rare"] [?s "name" ?name]]]
           :answer-rows 3}
  :metrics {:reads "range/object requests that would cross a network"
            :bytes "bytes those requests moved"
            :packs-opened "packs whose header/index were read (multi-pack arms)"
            :packs-total "packs that exist for the snapshot (multi-pack arms)"}
  :arms {:reference [:per-object :exact-read]
         :under-test [:window/bfs :multi/bfs :multi/hash]}
  :gate :every-arm-returns-the-same-3-rows
  :growth {:primary :reads
           :secondary :bytes
           :rule "reads at :fixed-shape strictly lower with bytes <= previous, or both lower; else :trade, with the price stated"}
  :excluded {:wall-clock "describes the machine, not the transport"
             :live-origin "the Worker measurements (root ADR-2609109900) are a different judge with a different unit (R2 requests, io-ms); they inform hypotheses here and are not scored here"
             :cpu "iteration 10 attributes the fold's CPU separately; it is not this benchmark's axis"}}}
