{:ayatori.q9/whole-component-version 2
 :as-of "2026-09-10"
 :status :blocked

 :authority
 {:canonical-repository "kotoba-lang/kotoba-lang"
  :canonical-rule "lang/q9-migration.edn"
  :canonical-decision "docs/adr/ADR-q9-whole-component-build-migration.md"
  :measurement "com-junkawasaki/root 90-docs/adr/2609100100-worker-cpu-limit-drift-datoms-read.edn"}

 :scope
 {:migration-unit :whole-component
  :decision-only-slices-accepted false
  :complete-public-surface-required true
  :transitive-source-closure-required true
  :jvm-dependency-forbidden true}

 ;; Measured 2026-09-10, not quoted. `#?(:clj` counted per file.
 :starting-point
 {:jvm-only-namespaces []
  :note "Nothing in this repository is JVM-only. arrangement/source.cljc carries
         exactly one reader conditional and it is #?(:cljs -- the cursor-async
         branch. ayatori.agent, ayatori.pack and ayatori.query carry zero.
         `cursor`'s docstring says \"JVM-only for now\" about its SYNCHRONOUS
         arity, and gives its own reason: decrypt-fn is Promise-returning on
         cljs so the scan has to be async all the way out. That is a sync/async
         statement, not a JVM one, and reading it as a JVM one is what this
         record exists to stop the next reader doing."
  :reader-conditionals {"agent.cljc" 0 "pack.cljc" 0 "query.cljc" 0
                        "disclosure.cljc" 2 "discovery.cljc" 2 "remote.cljc" 19}
  :public-source-lines 1171}

 :transitive-closure
 {:kotoba-lang-deps [:arrangement :envelope :io-ipld :io-ipld-car
                     :io-ipni-specs :io-multiformats :kotobase :text]
  :npm-deps ["@noble/curves" "@noble/hashes" "@noble/post-quantum"]}

 ;; Why :blocked. Read from the kit files and the catalog on 2026-09-10, with
 ;; the reader (not grep -- grep truncates on line wrap and the truncation is
 ;; invisible). Re-read them rather than trusting these values.
 :blockers
 [{:id :no-crypto-kit
   :severity :blocking
   :what "There is no crypto or hash capability KIT at all. The kit set is
          can-frame / clock / datagram / dataspace / http-ingress / http /
          link-frame / llm / log / state / storage / stream-ingress /
          stream-object / ui. None of them cover AES-GCM decryption or keyed
          blinding."
   :why-it-blocks "ayatori.remote's whole reason for existing is verified
                   provider block reads: every block is decrypted and every
                   scan prefix is derived through a keyed blind-fn. Those two
                   are called per block, not at the edges, so they are inside
                   the transitive closure and cannot be left to a host shim
                   without making the component a decision core -- which
                   lang/q9-migration.edn version 3 forbids as migration proof."
   :catalog-state "capability-catalog.edn has :hash/sha256, :identity/sign and
                   :identity/verify among its 35 capabilities. It has no
                   symmetric-decrypt and no keyed-blind capability. A catalog
                   entry is also not a backend qualification: `capability-catalog.edn`
                   says whether a capability exists, `capability-kits/*.edn`
                   says whether it runs on a backend, and these three have no
                   kit."}
  {:id :native-aot-pending-for-io
   :severity :blocking-for-native-target-only
   :what "storage-v1 and http-v1 are both {:wasm-aot :implemented,
          :native-aot :pending}."
   :why-it-blocks "A native-binary target additionally needs block fetch and
                   provider HTTP. A wasm32-browser target does not: both are
                   already :implemented there, which narrows the native-binary
                   blocker set to crypto alone if the deployment target is a
                   Worker."}]

 ;; Stated because the request that produced this record was to refactor
 ;; ayatori to a native binary in order to make datoms.kotobase.net faster.
 :target-note
 {:production-bottleneck-runs-in "Cloudflare Worker"
  :worker-target "wasm32-browser"
  :native-binary-runs-in "fleet node / kbb distribution, not a Worker"
  :consequence "A native binary and the Worker are different deployment
                targets. Porting to native does not make the Worker faster."}

 ;; And the reason this migration is not the optimisation it was proposed as.
 :not-the-optimisation
 {:measured "bench/coscientist-iteration-09.edn"
  :finding "A limit-1 read costs 4 block reads and 1 decrypt against a fully
            folded snapshot, unchanged when the snapshot quadruples, and
            decrypts once per unfolded novelty entry otherwise. The snapshot
            half is already O(result); the cost is O(unfolded novelty)."
  :consequence "Moving this component to a faster runtime lowers the constant
                on each row. The term that needs removing is the number of
                rows, and it is in kotobase-peer's novelty enumeration, not in
                ayatori and not in the runtime. Both are worth doing; doing the
                runtime port first optimises the constant on a term that should
                not exist."}

 :unblock-conditions
 [:crypto-kit-specified-with-typed-request-result-schema
  :crypto-kit-qualified-on-the-declared-target
  :closure-recount-after-kit-lands]}
