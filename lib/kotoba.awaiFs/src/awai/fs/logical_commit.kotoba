;; Restricted v1 EDN commit profile: fixed observed field order, safe ASCII
;; strings and zero or one parent. No merge commits or general EDN support.
(ns awai.fs.logical-commit
 (:require [multiformats.sha256 :as sha])
 (:export [root checkpoint-root])
 (:schemas {:awai.fs/commit-part [:record :awai.fs/commit-part [[:text :string] [:next :i64]]]}))
(defn- expect [s :string pos :i64 prefix :string] :i64
 (let [end (+ pos (string-length prefix))]
  (if (or (< pos 0) (> end (string-length s))) (throw :invalid-commit)
   (if (string=? (string-substring s pos end) prefix) end (throw :invalid-commit)))))
(defn- safe [c :i64] :bool
 (or (and (>= c 48) (<= c 57)) (and (>= c 65) (<= c 90)) (and (>= c 97) (<= c 122)) (= c 45) (= c 46) (= c 47) (= c 58) (= c 95)))
(defn- quoted [s :string pos :i64] [:ref :awai.fs/commit-part]
 (let [p (expect s pos "\"") n (string-length s)]
  (loop [i p] (if (or (>= i n) (> (- i p) 4096)) (throw :invalid-commit)
   (let [c (string-code-point-at s i)]
    (if (= c 34) (if (= i p) (throw :invalid-commit) (record-new [:ref :awai.fs/commit-part] (string-substring s p i) (+ i 1)))
     (if (safe c) (recur (+ i 1)) (throw :unsupported-commit))))))))
(defn- epoch [s :string pos :i64] [:ref :awai.fs/commit-part]
 (let [n (string-length s)]
  (loop [i pos v 0] (if (>= i n) (throw :invalid-commit)
   (let [c (string-code-point-at s i)]
    (if (and (>= c 48) (<= c 57))
     (let [d (- c 48)] (if (or (and (> i pos) (= (string-code-point-at s pos) 48)) (> v 900719925474099) (and (= v 900719925474099) (> d 1))) (throw :invalid-commit)
      (recur (+ i 1) (+ (* v 10) d))))
     (if (= i pos) (throw :invalid-commit) (record-new [:ref :awai.fs/commit-part] (string-substring s pos i) i))))))))
(defn- part [p [:ref :awai.fs/commit-part]] :string (record-get [:ref :awai.fs/commit-part] p :text))
(defn- next [p [:ref :awai.fs/commit-part]] :i64 (record-get [:ref :awai.fs/commit-part] p :next))
(defn- kv [key :string val :string] :string
 (string-concat "[[:keyword nil \"" (string-concat key (string-concat "\"] [:string \"" (string-concat val "\"]]")))))
(defn- canonical! [s :string] :string
 (let [p (expect s 0 ":epoch ") e (epoch s p)
       fmt (quoted s (expect s (next e) ", :format "))
       tx (quoted s (expect s (next fmt) ", :tx-root "))
       checkpoint (quoted s (expect s (next tx) ", :logical-checkpoint-root "))
       policy (quoted s (expect s (next checkpoint) ", :admission-policy-root "))
       model (quoted s (expect s (next policy) ", :model-contract-root "))
       schema (quoted s (expect s (next model) ", :schema-root "))
       pp (expect s (next schema) ", :parents [")
       parent (if (and (< pp (string-length s)) (= (string-code-point-at s pp) 93))
                (record-new [:ref :awai.fs/commit-part] "" pp) (quoted s pp))
       p2 (expect s (next parent) "], :database-id ")
       db (quoted s p2)]
  (if (or (not= (next db) (string-length s)) (not (string=? (part fmt) "kotobase.logical-commit/v1"))) (throw :unsupported-commit)
   (let [a (string-concat "[:kotobase.logical/envelope [:format \"kotobase.logical/v1\"] [:domain :logical-commit] [:value [:map [" (kv "admission-policy-root" (part policy)))
         b (string-concat (string-concat a " ") (kv "database-id" (part db)))
         c (string-concat (string-concat b " [[:keyword nil \"epoch\"] [:integer ") (string-concat (part e) "]]"))
         d (string-concat (string-concat c " ") (kv "format" (part fmt)))
         f (string-concat (string-concat d " ") (kv "logical-checkpoint-root" (part checkpoint)))
         g (string-concat (string-concat f " ") (kv "model-contract-root" (part model)))
         parents (if (string=? (part parent) "") "" (string-concat "[:string \"" (string-concat (part parent) "\"]")))
         h (string-concat (string-concat g " [[:keyword nil \"parents\"] [:vector [") (string-concat parents "]]] "))
         j (string-concat h (kv "schema-root" (part schema)))
         k (string-concat (string-concat j " ") (kv "tx-root" (part tx)))]
    (string-concat k "]]]]")))))
(defn root [s :string] [:result :string :keyword]
 (try (result-ok-of [:result :string :keyword] (sha/digest-hex (vector-i64-from-bytes (string-to-utf8 (canonical! s)))))
  (catch :keyword e (result-err-of [:result :string :keyword] e))))
(defn checkpoint-root [s :string] [:result :string :keyword]
 (try (let [checked (canonical! s) p (expect s 0 ":epoch ") e (epoch s p)
            fmt (quoted s (expect s (next e) ", :format ")) tx (quoted s (expect s (next fmt) ", :tx-root "))
            cp (quoted s (expect s (next tx) ", :logical-checkpoint-root "))]
         (result-ok-of [:result :string :keyword] (part cp)))
  (catch :keyword e (result-err-of [:result :string :keyword] e))))
