;; Build one bounded Forest v1 Pack from the canonical native CAR profile.
;; Output is an immutable byte vector, not a durability/publication protocol.
(ns awai.fs.forest-write
 (:require [ipld.car.pack :as pack] [ipld.dag-cbor-write :as w] [multiformats.cid :as cid]
           [multiformats.byte-cid :as hash] [zstd.frame-write :as zstd] [awai.fs.forest-index-write :as index])
 (:export [encode encode-large]))
(defn- slice [b :vector-i64 start :i64 len :i64] :vector-i64
 (loop [i 0 out (vector-alloc len)] (if (= i len) out
  (recur (+ i 1) (vector-assoc! out i (vector-at b (+ start i)))))))
(defn- leaf-count [flat :vector-i64] :i64
 (loop [at 0 n 0] (if (= at (vector-count flat)) n
  (recur (+ at 1 (vector-at flat at)) (+ n 1)))))
(defn- leaf-cids [flat :vector-i64] :vector-i64
 (loop [at 0 out (vector-i64)]
  (if (= at (vector-count flat)) out
   (let [n (vector-at flat at) bytes (slice flat (+ at 1) n)
         c (cid/cid->bytes (hash/cidv1-raw-bytes bytes))]
    (recur (+ at 1 n) (w/append out c))))))
(defn- encode-bound [version :i64 flat :vector-i64 large :bool] [:result :vector-i64 :keyword]
 (let [e (if large (pack/refusal-large version flat) (pack/refusal version flat))]
  (if (not= e :none) (result-err-of [:result :vector-i64 :keyword] e)
   (let [n (leaf-count flat)]
    (if (or (< n 1) (> n 63)) (result-err-of [:result :vector-i64 :keyword] :leaf-limit)
     (let [car (if large (pack/encode-large version flat) (pack/encode version flat))
           root (if large (pack/root-cid-large version flat) (pack/root-cid version flat))]
      (if (not (and (result-ok?-of [:result :vector-i64 :keyword] car) (result-ok?-of [:result :string :keyword] root)))
       (result-err-of [:result :vector-i64 :keyword] :pack-refused)
       (let [v (result-value-of [:result :vector-i64 :keyword] car (vector-i64))
             hv (cid/varint-decode v 51) header-start (record-get [:ref :multiformats.cid/varint] hv :next)
             header-size (record-get [:ref :multiformats.cid/varint] hv :value) end (+ header-start header-size)]
        (if (or (not= (record-get [:ref :multiformats.cid/varint] hv :error) :none) (> end (vector-count v)))
         (result-err-of [:result :vector-i64 :keyword] :pack-refused)
         (let [head-frame (zstd/encode-frame (slice v 51 (- end 51)))
               block-frame (zstd/encode-frame (slice v end (- (vector-count v) end)))]
          (if (not (and (result-ok?-of [:result :vector-i64 :keyword] head-frame) (result-ok?-of [:result :vector-i64 :keyword] block-frame)))
           (result-err-of [:result :vector-i64 :keyword] :frame-refused)
           (let [h (result-value-of [:result :vector-i64 :keyword] head-frame (vector-i64))
                 b (result-value-of [:result :vector-i64 :keyword] block-frame (vector-i64))
                 root-bytes (cid/cid->bytes (result-value-of [:result :string :keyword] root ""))
                 ids (w/append (leaf-cids flat) root-bytes)
                 offsets (loop [i 0 out (vector-alloc (+ n 1))]
                           (if (= i (+ n 1)) out (recur (+ i 1) (vector-assoc! out i (vector-count h)))))
                 ix (index/encode-index ids offsets (+ (vector-count h) (vector-count b)))]
            (if (not (result-ok?-of [:result :vector-i64 :keyword] ix))
             (result-err-of [:result :vector-i64 :keyword] :index-refused)
             (result-ok-of [:result :vector-i64 :keyword]
               (w/append (w/append h b) (result-value-of [:result :vector-i64 :keyword] ix (vector-i64))))))))))))))))
)

(defn encode [version :i64 flat :vector-i64] [:result :vector-i64 :keyword]
 (encode-bound version flat false))
(defn encode-large [version :i64 flat :vector-i64] [:result :vector-i64 :keyword]
 (encode-bound version flat true))
