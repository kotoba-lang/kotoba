;; Verify logical signed-basis fields only. Physical publication, policy,
;; checkpoint truth and authority enrollment are separate caller duties.
(ns awai.fs.basis-verify
 (:require [awai.fs.basis-edn :as basis] [awai.fs.logical-commit :as commit] [awai.fs.logical-signature :as sign])
 (:export [verify]))
(defn verify [wire :vector-i64 issuer :string key :string public :vector-i64] [:result :bool :keyword]
 (let [r (basis/read wire)]
  (if (not (result-ok?-of [:result [:ref :awai.fs/basis-edn] :keyword] r))
   (result-err-of [:result :bool :keyword] (result-error-of [:result [:ref :awai.fs/basis-edn] :keyword] r :invalid-proof))
   (let [p (result-value-of [:result [:ref :awai.fs/basis-edn] :keyword] r (record-new [:ref :awai.fs/basis-edn] "" "" "" "" "" []))
         signed-root (record-get [:ref :awai.fs/basis-edn] p :root) actual (commit/root (record-get [:ref :awai.fs/basis-edn] p :commit))]
    (cond (or (not (string=? issuer (record-get [:ref :awai.fs/basis-edn] p :issuer))) (not (string=? key (record-get [:ref :awai.fs/basis-edn] p :key))) ) (result-err-of [:result :bool :keyword] :untrusted-issuer)
          (not (result-ok?-of [:result :string :keyword] actual)) (result-err-of [:result :bool :keyword] (result-error-of [:result :string :keyword] actual :invalid-commit))
          (not (string=? (result-value-of [:result :string :keyword] actual "") signed-root)) (result-err-of [:result :bool :keyword] :commit-root-mismatch)
          :else (sign/verify signed-root issuer key public (record-get [:ref :awai.fs/basis-edn] p :signature)))))))
