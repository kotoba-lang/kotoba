;; Child selection for an already CID-verified Prolly internal node.
;; Keys are restricted to ASCII until canonical cross-runtime ordering is fixed.
(ns awai.fs.prolly-branch
 (:require [cbor.codec :as cbor] [cbor.value :as value] [awai.fs.forest-index :as index])
 (:export [select child-count child-at]))
(defn- child [v [:ref :cbor/value] i :i64] [:ref :cbor/value]
 (if (and (= (value/kind v) :array) (>= i 0) (< i (vector-count (value/children v))))
  (typed-list-nth [:list [:ref :cbor/value]] (value/children v) i) (value/null-value)))
(defn- field [m [:ref :cbor/value] key :string] [:ref :cbor/value]
 (if (not= (value/kind m) :map) (value/null-value)
  (let [xs (value/children m) n (vector-count xs)]
   (loop [i 0] (if (>= i n) (value/null-value)
    (let [k (typed-list-nth [:list [:ref :cbor/value]] xs i)]
     (if (and (= (value/kind k) :text) (string=? (value/text k) key))
      (typed-list-nth [:list [:ref :cbor/value]] xs (+ i 1)) (recur (+ i 2)))))))))
(defn- ascii? [s :string] :bool
 (let [n (string-length s)] (and (<= n 4096) (loop [i 0] (if (= i n) true (let [c (string-code-point-at s i)] (and (>= c 0) (< c 128) (recur (+ i 1)))))))))
(defn- cmp [a :string b :string] :i64
 (let [na (string-length a) nb (string-length b)]
  (loop [i 0] (cond (and (= i na) (= i nb)) 0 (= i na) -1 (= i nb) 1
   (< (string-code-point-at a i) (string-code-point-at b i)) -1
   (> (string-code-point-at a i) (string-code-point-at b i)) 1 :else (recur (+ i 1))))))
(defn- link [v [:ref :cbor/value]] :vector-i64
 (let [children (value/children v)]
  (if (or (not= (value/kind v) :tag) (not= (value/number v) 42) (not= (vector-count children) 1)) (throw :invalid-link)
   (let [x (typed-list-nth [:list [:ref :cbor/value]] children 0) wire (value/data x)]
    (if (or (not= (value/kind x) :bytes) (not= (vector-count wire) 37) (not= (vector-at wire 0) 0)) (throw :invalid-link)
     (let [cid (loop [i 0 out (vector-alloc 36)] (if (= i 36) out (recur (+ i 1) (vector-assoc! out i (vector-at wire (+ i 1))))))]
      (if (index/cid-valid? cid) cid (throw :invalid-link))))))))
(defn- choose-step [xs [:list [:ref :cbor/value]] n :i64 key :string i :i64 prev :string chosen :bool result :vector-i64] :vector-i64
    (if (= i n) result
     (let [entry (typed-list-nth [:list [:ref :cbor/value]] xs i) k (child entry 0) maxkey (value/text k)]
      (if (or (not= (value/kind entry) :array) (not= (vector-count (value/children entry)) 2)
              (not= (value/kind k) :text) (not (ascii? maxkey)) (and (> i 0) (>= (cmp prev maxkey) 0))) (throw :invalid-branch)
       (let [cid (link (child entry 1)) pick (and (not chosen) (or (<= (cmp key maxkey) 0) (= i (- n 1))))]
        (choose-step xs n key (+ i 1) maxkey (or chosen pick) (if pick cid result)))))))
(defn- choose [entries [:ref :cbor/value] key :string] :vector-i64
 (let [xs (value/children entries) n (vector-count xs)]
  (if (or (not= (value/kind entries) :array) (< n 1) (> n 4096)) (throw :invalid-branch)
   (choose-step xs n key 0 "" false (vector-i64)))))
(defn- select! [wire :vector-i64 key :string] :vector-i64
 (if (not (ascii? key)) (throw :unsupported-key)
  (let [d (cbor/decode-checked wire)]
   (if (not (result-ok?-of [:result [:ref :cbor/value] :keyword] d)) (throw :invalid-cbor)
    (let [node (result-value-of [:result [:ref :cbor/value] :keyword] d (value/null-value)) kind (field node "kind")]
     (if (or (not= (value/kind kind) :text) (not (string=? (value/text kind) "internal"))) (throw :not-branch)
      (choose (field node "children") key)))))))
(defn select [wire :vector-i64 key :string] [:result :vector-i64 :keyword]
 (try (result-ok-of [:result :vector-i64 :keyword] (select! wire key))
  (catch :keyword e (result-err-of [:result :vector-i64 :keyword] e))))
;; Enumeration validates the whole node, including links other than the one
;; returned. This is needed for full checkpoint traversal, not just lookup.
(defn- validated-entries [wire :vector-i64] [:ref :cbor/value]
 (let [checked (select! wire "") d (cbor/decode-checked wire)]
  (if (not (result-ok?-of [:result [:ref :cbor/value] :keyword] d)) (throw :invalid-cbor)
   (field (result-value-of [:result [:ref :cbor/value] :keyword] d (value/null-value)) "children"))))
(defn child-count [wire :vector-i64] [:result :i64 :keyword]
 (try (result-ok-of [:result :i64 :keyword] (vector-count (value/children (validated-entries wire))))
  (catch :keyword e (result-err-of [:result :i64 :keyword] e))))
(defn child-at [wire :vector-i64 i :i64] [:result :vector-i64 :keyword]
 (try (let [entries (validated-entries wire) n (vector-count (value/children entries))]
        (if (or (< i 0) (>= i n)) (throw :child-out-of-bounds)
         (result-ok-of [:result :vector-i64 :keyword] (link (child (child entries i) 1)))))
  (catch :keyword e (result-err-of [:result :vector-i64 :keyword] e))))
