;; This combines logical proof verification with a bounded Forest checkpoint.
;; The caller authenticates issuer/key, supplies an immutable catalog, and must
;; independently bind root-cid to the snapshot described by its authority.
;; The logical signature does not authenticate the supplied physical root.
(ns awai.fs.basis-checkpoint-tree
 (:capabilities #{:fs/app-data})
 (:require [awai.fs.basis-verify :as verify] [awai.fs.basis-edn :as basis]
           [awai.fs.logical-commit :as commit] [awai.fs.prolly-checkpoint-tree :as tree])
 (:export [verify-tree]))
(defn verify-tree [proof :vector-i64 issuer :string key :string public :vector-i64 paths [:list :string] sizes :vector-i64 root-cid :vector-i64 window :i64 cap :i64] [:result :bool :keyword]
 (let [checked (verify/verify proof issuer key public)]
  (if (not (result-ok?-of [:result :bool :keyword] checked)) checked
   (let [p (basis/read proof)
         v (result-value-of [:result [:ref :awai.fs/basis-edn] :keyword] p (record-new [:ref :awai.fs/basis-edn] "" "" "" "" "" []))
         expected (commit/checkpoint-root (record-get [:ref :awai.fs/basis-edn] v :commit))
         actual (tree/root paths sizes root-cid window cap)]
    (cond (not (result-ok?-of [:result :string :keyword] expected)) (result-err-of [:result :bool :keyword] :invalid-commit)
          (not (result-ok?-of [:result :string :keyword] actual)) (result-err-of [:result :bool :keyword] (result-error-of [:result :string :keyword] actual :invalid-tree))
          (not (string=? (result-value-of [:result :string :keyword] actual "") (result-value-of [:result :string :keyword] expected ""))) (result-err-of [:result :bool :keyword] :checkpoint-mismatch)
          :else (result-ok-of [:result :bool :keyword] true))))))
