;; The caller must authenticate the trusted physical root and issuer/key and
;; provide an immutable catalog. The logical signature does NOT sign the
;; physical root; matching the caller's trusted root is mandatory here.
(ns awai.fs.basis-snapshot
 (:capabilities #{:fs/app-data})
 (:require [awai.fs.basis-verify :as verify] [awai.fs.basis-edn :as basis]
           [awai.fs.logical-commit :as commit]
           [awai.fs.basis-checkpoint-tree :as bound] [awai.fs.forest-file :as forest]
           [awai.fs.forest-index :as index] [multiformats.cid :as cid]
           [cbor.codec :as cbor] [cbor.value :as value])
 (:export [verify-snapshot supported-schema?]))
(defn supported-schema? [schema [:ref :cbor/value]] :bool
 (and (= (value/kind schema) :int) (= (value/number schema) 2)))
(defn- field [m [:ref :cbor/value] key :string] [:ref :cbor/value]
 (if (not= (value/kind m) :map) (throw :invalid-node)
  (let [xs (value/children m)]
   (loop [i 0 seen false found (value/null-value)]
    (if (= i (vector-count xs)) (if seen found (throw :missing-field))
     (let [k (typed-list-nth [:list [:ref :cbor/value]] xs i) v (typed-list-nth [:list [:ref :cbor/value]] xs (+ i 1))]
      (if (and (= (value/kind k) :text) (string=? (value/text k) key))
       (if seen (throw :duplicate-field) (recur (+ i 2) true v))
       (recur (+ i 2) seen found))))))))
(defn- link [v [:ref :cbor/value]] :vector-i64
 (if (or (not= (value/kind v) :tag) (not= (value/number v) 42) (not= (vector-count (value/children v)) 1)) (throw :invalid-link)
  (let [x (typed-list-nth [:list [:ref :cbor/value]] (value/children v) 0) wire (value/data x)]
   (if (or (not= (value/kind x) :bytes) (not= (vector-count wire) 37) (not= (vector-at wire 0) 0)) (throw :invalid-link)
    (let [out (loop [i 0 a (vector-alloc 36)] (if (= i 36) a (recur (+ i 1) (vector-assoc! a i (vector-at wire (+ i 1))))))]
     (if (and (index/cid-valid? out) (= (vector-at out 1) 113)) out (throw :invalid-link)))))))
(defn- read-node [paths [:list :string] sizes :vector-i64 id :vector-i64 window :i64 cap :i64] [:ref :cbor/value]
 (let [b (forest/get-block-in-files paths sizes id window cap)]
  (if (not (result-ok?-of [:result :vector-i64 :keyword] b)) (throw (result-error-of [:result :vector-i64 :keyword] b :read-refused))
   (let [d (cbor/decode-checked (result-value-of [:result :vector-i64 :keyword] b []))]
    (if (not (result-ok?-of [:result [:ref :cbor/value] :keyword] d)) (throw :invalid-node)
     (result-value-of [:result [:ref :cbor/value] :keyword] d (value/null-value)))))))
(defn- verified! [proof :vector-i64 issuer :string key :string public :vector-i64 physical :string paths [:list :string] sizes :vector-i64 window :i64 cap :i64] [:result :bool :keyword]
 (let [v (verify/verify proof issuer key public)]
  (if (not (result-ok?-of [:result :bool :keyword] v)) v
   (let [p (basis/read proof) b (result-value-of [:result [:ref :awai.fs/basis-edn] :keyword] p (record-new [:ref :awai.fs/basis-edn] "" "" "" "" "" []))]
    (if (not (string=? (record-get [:ref :awai.fs/basis-edn] b :physical) physical)) (throw :untrusted-physical-root)
     (let [id (cid/cid->bytes physical)]
      (if (or (not (index/cid-valid? id)) (not= (vector-at id 1) 113)) (throw :invalid-physical-root)
       (let [manifest (read-node paths sizes id window cap) engine (field manifest "engine") version (field manifest "format-version")
             database (field manifest "database-id") basis-t (field manifest "basis-t")
             commit-text (record-get [:ref :awai.fs/basis-edn] b :commit)
             expected-db (commit/database-id commit-text) expected-epoch (commit/epoch-text commit-text)]
        (if (or (not= (value/kind engine) :text) (not (string=? (value/text engine) "kotobase-engine-prolly")) (not= (value/kind version) :int) (< (value/number version) 1) (> (value/number version) 3)) (throw :unsupported-manifest)
         (if (or (not= (value/kind database) :text) (not= (value/kind basis-t) :int) (< (value/number basis-t) 0)
                 (not (result-ok?-of [:result :string :keyword] expected-db)) (not (result-ok?-of [:result :string :keyword] expected-epoch))
                 (not (string=? (value/text database) (result-value-of [:result :string :keyword] expected-db "")))
                 (not (string=? (string-from-i64 (value/number basis-t)) (result-value-of [:result :string :keyword] expected-epoch "")))) (throw :basis-mismatch)
         (let [snapshot (read-node paths sizes (link (field manifest "snapshot")) window cap) schema (field snapshot "schema-version")]
          (if (not (supported-schema? schema)) (throw :unsupported-snapshot-schema)
           (let [root (link (field (field snapshot "index-roots") "spo"))]
            (bound/verify-tree proof issuer key public paths sizes root window cap))))))))))))))
(defn verify-snapshot [proof :vector-i64 issuer :string key :string public :vector-i64 physical :string paths [:list :string] sizes :vector-i64 window :i64 cap :i64] [:result :bool :keyword]
 (try (verified! proof issuer key public physical paths sizes window cap)
  (catch :keyword e (result-err-of [:result :bool :keyword] e))))
