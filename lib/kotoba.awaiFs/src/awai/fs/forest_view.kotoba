;; Canonical logical-file to ordered Forest locations. The caller supplies
;; both the trusted logical CID and physical hints; this is not a signature
;; verifier, authenticated catalog, absence proof, or concurrent file snapshot.
(ns awai.fs.forest-view
  (:capabilities #{:fs/app-data})
  (:require [awai.fs.logical-file :as logical] [awai.fs.forest-file :as forest]
            [multiformats.byte-cid :as hash])
  (:export [read-chunk]))

(defn- row-cid [rows :vector-i64 row :i64] :vector-i64
  (loop [i 0 out (vector-alloc 36)]
    (if (= i 36) out
      (recur (+ i 1) (vector-assoc! out i (vector-at rows (+ (* row 38) 2 i)))))))

(defn read-chunk [wire :vector-i64 expected-cid :string chunk-index :i64
                  paths [:list :string] sizes :vector-i64 max-window :i64 max-output :i64]
  [:result :vector-i64 :keyword]
  (let [decoded (logical/decode wire)]
    (if (not (result-ok?-of [:result [:ref :awai.fs/file] :keyword] decoded))
      (result-err-of [:result :vector-i64 :keyword] (result-error-of [:result [:ref :awai.fs/file] :keyword] decoded :invalid-manifest))
      (if (not (string=? expected-cid (hash/cidv1-dag-cbor-bytes wire)))
        (result-err-of [:result :vector-i64 :keyword] :manifest-cid-mismatch)
        (let [f (result-value-of [:result [:ref :awai.fs/file] :keyword] decoded
                  (logical/file-new 1 0 (logical/profile-new 1 "fixed" 1) (vector-i64)))
              rows (record-get [:ref :awai.fs/file] f :rows)
              n (quot (vector-count rows) 38)]
          (if (or (< chunk-index 0) (>= chunk-index n))
            (result-err-of [:result :vector-i64 :keyword] :chunk-out-of-range)
            (let [r (forest/get-block-in-files paths sizes (row-cid rows chunk-index) max-window max-output)]
              (if (not (result-ok?-of [:result :vector-i64 :keyword] r)) r
                (if (= (vector-count (result-value-of [:result :vector-i64 :keyword] r (vector-i64)))
                       (vector-at rows (+ (* chunk-index 38) 1))) r
                  (result-err-of [:result :vector-i64 :keyword] :chunk-length-mismatch))))))))))
