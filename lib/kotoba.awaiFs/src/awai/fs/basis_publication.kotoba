;; Restricted Kotobase physical-publication/v1, Prolly format 3, SHA-256.
;; Trusted digest and issuer key must be independently authenticated by host.
(ns awai.fs.basis-publication
 (:capabilities #{:fs/app-data})
 (:require [awai.fs.basis-edn :as basis] [awai.fs.basis-snapshot :as snapshot]
           [awai.fs.forest-index :as index] [multiformats.cid :as cid] [multiformats.sha256 :as sha])
 (:export [payload verify-publication]))
(defn- hex-root? [s :string] :bool
 (and (= (string-length s) 64) (loop [i 0] (if (= i 64) true
  (let [c (string-code-point-at s i)] (and (or (and (>= c 48) (<= c 57)) (and (>= c 97) (<= c 102))) (recur (+ i 1))))))))
(defn payload [logical :string physical :string] [:result :string :keyword]
 (let [c (cid/cid->bytes physical)]
  (if (or (not (hex-root? logical)) (not (index/cid-valid? c)) (not= (vector-at c 1) 113)) (result-err-of [:result :string :keyword] :invalid-publication)
   (result-ok-of [:result :string :keyword]
    (string-concat "[:kotobase.logical/envelope [:format \"kotobase.logical/v1\"] [:domain :physical-publication] [:value [:map [[[:keyword nil \"engine-format\"] [:integer 3]] [[:keyword nil \"engine-profile\"] [:keyword nil \"prolly\"]] [[:keyword nil \"format\"] [:string \"kotobase.physical-publication/v1\"]] [[:keyword nil \"logical-commit-root\"] [:string \""
     (string-concat logical (string-concat "\"]] [[:keyword nil \"physical-root\"] [:string \"" (string-concat physical "\"]]]]]]"))))))))
(defn verify-publication [proof :vector-i64 issuer :string key :string public :vector-i64 trusted-digest :string paths [:list :string] sizes :vector-i64 window :i64 cap :i64] [:result :bool :keyword]
 (let [p (basis/read proof)]
  (if (not (result-ok?-of [:result [:ref :awai.fs/basis-edn] :keyword] p)) (result-err-of [:result :bool :keyword] :invalid-proof)
   (let [v (result-value-of [:result [:ref :awai.fs/basis-edn] :keyword] p (record-new [:ref :awai.fs/basis-edn] "" "" "" "" "" []))
         physical (record-get [:ref :awai.fs/basis-edn] v :physical) data (payload (record-get [:ref :awai.fs/basis-edn] v :root) physical)]
    (cond (not (hex-root? trusted-digest)) (result-err-of [:result :bool :keyword] :invalid-publication-digest)
          (not (result-ok?-of [:result :string :keyword] data)) (result-err-of [:result :bool :keyword] :invalid-publication)
          (not (string=? trusted-digest (sha/digest-hex (vector-i64-from-bytes (string-to-utf8 (result-value-of [:result :string :keyword] data "")))))) (result-err-of [:result :bool :keyword] :untrusted-publication)
          :else (snapshot/verify-snapshot-format proof issuer key public physical paths sizes window cap 3))))))
