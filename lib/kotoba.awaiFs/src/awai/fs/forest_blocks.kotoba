;; Bounded CARv1 block-section traversal over one already-decoded Forest frame.
;; This is not an index parser, positioned I/O or whole-frame authentication.
(ns awai.fs.forest-blocks
  (:require [multiformats.cid :as cid] [multiformats.byte-cid :as hash])
  (:export [get-block]))

(defn- valid-cid? [v :vector-i64] :bool
  (and (= (vector-count v) 36)
       (= (vector-at v 0) 1)
       (or (= (vector-at v 1) 85) (= (vector-at v 1) 113))
       (= (vector-at v 2) 18) (= (vector-at v 3) 32)
       (loop [i 4] (if (= i 36) true
                    (let [x (vector-at v i)]
                      (if (or (< x 0) (> x 255)) false (recur (+ i 1))))))))
(defn- same? [a :vector-i64 b :vector-i64] :bool
  (and (= (vector-count a) (vector-count b))
       (loop [i 0] (if (= i (vector-count a)) true
                     (if (= (vector-at a i) (vector-at b i)) (recur (+ i 1)) false)))))
(defn- slice [b :vector-i64 start :i64 len :i64] :vector-i64
  (loop [i 0 out (vector-alloc len)]
    (if (= i len) out (recur (+ i 1) (vector-assoc! out i (vector-at b (+ start i)))))))
(defn- valid-bytes? [b :vector-i64] :bool
  (loop [i 0] (if (= i (vector-count b)) true
                (let [x (vector-at b i)]
                  (if (or (< x 0) (> x 255)) false (recur (+ i 1)))))))

;; Finds the requested CID in one <=2 MiB frame of complete CAR block
;; sections. Every traversed section's framing/CID is validated; only the
;; selected payload is hashed. No absence claim for other, unread frames.
(defn get-block [frame :vector-i64 target :vector-i64] [:result :vector-i64 :keyword]
  (let [n (vector-count frame)]
    (cond (> n 2097152) (result-err-of [:result :vector-i64 :keyword] :frame-limit)
          (not (valid-cid? target)) (result-err-of [:result :vector-i64 :keyword] :invalid-cid)
          :else
          (loop [p 0 count 0]
            (cond (= p n) (result-err-of [:result :vector-i64 :keyword] :not-found)
                  (>= count 1024) (result-err-of [:result :vector-i64 :keyword] :section-limit)
                  :else
                  (let [v (cid/varint-decode frame p) e (record-get [:ref :multiformats.cid/varint] v :error)
                        start (record-get [:ref :multiformats.cid/varint] v :next)
                        size (record-get [:ref :multiformats.cid/varint] v :value)]
                    (cond (not= e :none) (result-err-of [:result :vector-i64 :keyword] :invalid-section)
                          (or (< size 36) (> size (- n start))) (result-err-of [:result :vector-i64 :keyword] :invalid-section)
                          :else
                          (let [link (slice frame start 36) next (+ start size)]
                            (cond (not (valid-cid? link)) (result-err-of [:result :vector-i64 :keyword] :invalid-cid)
                                  (same? link target)
                                    (let [data (slice frame (+ start 36) (- size 36))]
                                      (if (not (valid-bytes? data)) (result-err-of [:result :vector-i64 :keyword] :invalid-byte)
                                        (let [text (if (= (vector-at link 1) 85) (hash/cidv1-raw-bytes data)
                                                     (hash/cidv1-dag-cbor-bytes data))]
                                          (if (same? link (cid/cid->bytes text))
                                            (result-ok-of [:result :vector-i64 :keyword] data)
                                            (result-err-of [:result :vector-i64 :keyword] :cid-mismatch)))))
                                  :else (recur next (+ count 1)))))))))))
