;; Verify a private Forest generation against a caller-supplied CID before publish.
;; The caller owns CID authority, source stability and exclusion against other writers.
(ns awai.fs.forest-verified-publish
 (:capabilities #{:fs/app-data})
 (:require [awai.fs.forest-source-stage :as stage]
           [awai.fs.forest-generation-verify :as generation])
 (:export [publish]))
(defn- name-valid? [name :string] :bool
 (let [n (string-length name)]
  (and (>= n 5) (<= n 80) (string=? (string-substring name 0 4) "gen-")
       (loop [i 4] (if (= i n) true
        (let [c (string-code-point-at name i)]
         (if (or (and (>= c 48) (<= c 57)) (and (>= c 97) (<= c 122)) (= c 45))
          (recur (+ i 1)) false)))))))
(defn- sync-path? [path :string] :bool
 (let [r (typed-cap-call :fs/app-data :string :string
           (string-concat "\u0000FS2\u0000M" (string-concat path "\u0000")))]
  (and (= (string-length r) 6) (= (string-code-point-at r 0) 0)
       (= (string-code-point-at r 1) 70) (= (string-code-point-at r 2) 83)
       (= (string-code-point-at r 3) 50) (= (string-code-point-at r 4) 0)
       (= (string-code-point-at r 5) 49))))
;; 101: generation verification failed; private path is retained.
;; 95: rename refused; 96: renamed, parent sync failed; 97: response unknown.
;; No signature, snapshot, fencing, WAL, mutable head or orphan cleanup is implied.
(defn publish [source-path :string size :i64 parent :string name :string expected-cid :string] [:ref :awai.fs/stage-result]
 (if (not (name-valid? name)) (record-new [:ref :awai.fs/stage-result] "" 1)
  (let [staged (stage/stage-private source-path size parent)
        status (record-get [:ref :awai.fs/stage-result] staged :status)
        path (record-get [:ref :awai.fs/stage-result] staged :path)]
   (if (not= status 0) staged
    (if (not= (generation/verify path expected-cid) 0)
     (record-new [:ref :awai.fs/stage-result] path 101)
     (let [target (string-concat parent (string-concat "/" name))
           r (typed-cap-call :fs/app-data :string :string
               (string-concat "\u0000FS2\u0000T" (string-concat path (string-concat "\u0000" target))))
           framed (and (= (string-length r) 6) (= (string-code-point-at r 0) 0)
                       (= (string-code-point-at r 1) 70) (= (string-code-point-at r 2) 83)
                       (= (string-code-point-at r 3) 50) (= (string-code-point-at r 4) 0))]
      (cond (not framed) (record-new [:ref :awai.fs/stage-result] target 97)
            (= (string-code-point-at r 5) 48) (record-new [:ref :awai.fs/stage-result] path 95)
            (not= (string-code-point-at r 5) 49) (record-new [:ref :awai.fs/stage-result] target 97)
            (not (sync-path? parent)) (record-new [:ref :awai.fs/stage-result] target 96)
            :else (record-new [:ref :awai.fs/stage-result] target 0))))))))
