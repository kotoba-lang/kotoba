;; Bounded CARv1 and Zstd frame building blocks for a streaming Forest writer.
;; Callers own ordering, index, I/O, source consistency and publication.
(ns awai.fs.forest-stream
 (:require [ipld.dag-cbor-write :as w] [multiformats.cid :as cid]
           [multiformats.byte-cid :as hash] [zstd.frame-write :as zstd]
           [awai.fs.forest-index :as index])
 (:export [root-bytes header-frame block-frame checked-block-frame]))
(defn- slice [v :vector-i64 at :i64 n :i64] :vector-i64
 (loop [i 0 out (vector-alloc n)] (if (= i n) out
  (recur (+ i 1) (vector-assoc! out i (vector-at v (+ at i)))))))
(defn- valid-bytes? [v :vector-i64] :bool
 (loop [i 0] (if (= i (vector-count v)) true
  (let [x (vector-at v i)] (if (or (< x 0) (> x 255)) false (recur (+ i 1)))))))
(defn root-bytes [cids :vector-i64] [:result :vector-i64 :keyword]
 (let [width (vector-count cids) n (quot width 36)]
  (if (or (< n 1) (> n 63) (not= (rem width 36) 0)
          (not (loop [i 0] (if (= i n) true
                 (let [c (slice cids (* i 36) 36)]
                  (if (and (index/cid-valid? c) (= (vector-at c 1) 85)) (recur (+ i 1)) false))))))
   (result-err-of [:result :vector-i64 :keyword] :invalid-leaves)
   (let [links (loop [i 0 out (w/array-head n)]
                 (if (= i n) out
                  (recur (+ i 1) (w/append out (w/link-bytes-item (slice cids (* i 36) 36))))))]
    (result-ok-of [:result :vector-i64 :keyword] (w/append (w/append (w/head 5 1) (w/text-item "leaves")) links))))))
(defn header-frame [root :vector-i64] [:result :vector-i64 :keyword]
 (if (or (> (vector-count root) 4096) (not (valid-bytes? root)))
  (result-err-of [:result :vector-i64 :keyword] :invalid-root)
  (let [id (cid/cid->bytes (hash/cidv1-dag-cbor-bytes root))
        header (w/append (w/append (w/append (w/append (w/head 5 2) (w/text-item "roots")) (w/array-head 1))
                                  (w/link-bytes-item id)) (w/append (w/text-item "version") (w/int-item 1)))
        full (w/append (cid/varint (vector-count header)) header)]
   (zstd/encode-frame full))))
(defn block-frame [codec :i64 data :vector-i64] [:result :vector-i64 :keyword]
 (if (or (not (or (= codec 85) (= codec 113))) (> (vector-count data) 1048576) (not (valid-bytes? data)))
  (result-err-of [:result :vector-i64 :keyword] :invalid-block)
  (let [id (cid/cid->bytes (if (= codec 85) (hash/cidv1-raw-bytes data) (hash/cidv1-dag-cbor-bytes data)))
        body (w/append (cid/varint (+ 36 (vector-count data))) (w/append id data))]
   (zstd/encode-frame body))))

;; Caller must not mutate DATA during this call. The expected ID is from the
;; previously fixed logical basis; a changed input is rejected before framing.
(defn checked-block-frame [expected :vector-i64 data :vector-i64] [:result :vector-i64 :keyword]
 (if (or (not (index/cid-valid? expected)) (not= (vector-at expected 1) 85)
         (> (vector-count data) 1048576) (not (valid-bytes? data)))
  (result-err-of [:result :vector-i64 :keyword] :invalid-block)
  (let [actual (cid/cid->bytes (hash/cidv1-raw-bytes data))
        same (loop [i 0] (if (= i 36) true
               (if (= (vector-at actual i) (vector-at expected i)) (recur (+ i 1)) false)))]
   (if same (block-frame 85 data)
    (result-err-of [:result :vector-i64 :keyword] :cid-mismatch)))))
