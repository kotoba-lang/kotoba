;; Verify a caller-addressed generation against an externally trusted manifest CID.
;; File paths are untrusted physical hints and no source snapshot or authority is implied.
(ns awai.fs.forest-generation-verify
 (:capabilities #{:fs/app-data})
 (:require [awai.fs.logical-file :as logical] [awai.fs.source-file :as source]
           [awai.fs.forest-view :as view])
 (:export [verify]))
(defn- valid-path? [p :string] :bool
 (let [n (string-length p)]
  (and (> n 1) (<= (string-byte-length p) 3000) (= (string-code-point-at p 0) 47)
       (not= (string-code-point-at p (- n 1)) 47)
       (loop [i 0] (if (= i n) true
        (if (= (string-code-point-at p i) 0) false (recur (+ i 1))))))))
(defn- verify-one [wire :vector-i64 cid :string root :string i :i64] :bool
 (arena-scope
  (let [pack (quot i 16) path (string-concat root (string-concat "/pack-" (string-from-i64 pack)))
        stat (source/regular-size path)]
   (if (not (result-ok?-of [:result :i64 :keyword] stat)) false
    (let [n (result-value-of [:result :i64 :keyword] stat -1)]
     (if (or (< n 64) (> n 33554432)) false
      (let [r (view/read-chunk wire cid i (typed-list-new [:list :string] path)
                              (vector-i64 n) 2097152 1049000)]
       (result-ok?-of [:result :vector-i64 :keyword] r))))))))
;; 0 verified; 1 invalid root; 2 manifest metadata; 3 manifest read;
;; 4 invalid or untrusted manifest; 5 unsupported profile; 10+pack failure.
;; Some provider errors may terminate the process rather than return a status.
(defn verify [root :string expected-cid :string] :i64
 (if (not (valid-path? root)) 1
  (let [path (string-concat root "/manifest") stat (source/regular-size path)]
   (if (not (result-ok?-of [:result :i64 :keyword] stat)) 2
    (let [n (result-value-of [:result :i64 :keyword] stat -1)]
     (if (or (< n 1) (> n 131072)) 2
      (let [r (source/read-chunk path 0 n)]
       (if (not (result-ok?-of [:result :vector-i64 :keyword] r)) 3
        (let [wire (result-value-of [:result :vector-i64 :keyword] r (vector-i64))
              decoded (logical/decode wire) address (logical/bytes-cid wire)]
         (if (or (not (result-ok?-of [:result [:ref :awai.fs/file] :keyword] decoded))
                 (not (result-ok?-of [:result :string :keyword] address))
                 (not (string=? expected-cid (result-value-of [:result :string :keyword] address "")))) 4
          (let [f (result-value-of [:result [:ref :awai.fs/file] :keyword] decoded
                    (logical/file-new 0 0 (logical/profile-new 0 "" 0) (vector-i64)))
                profile (record-get [:ref :awai.fs/file] f :profile)
                rows (record-get [:ref :awai.fs/file] f :rows)
                chunks (quot (vector-count rows) 38)]
           (if (or (not= (record-get [:ref :awai.fs/profile] profile :leaf-size) 1048576)
                   (> (record-get [:ref :awai.fs/file] f :size) 1073741824)) 5
            (loop [i 0] (if (= i chunks) 0
              (if (verify-one wire expected-cid root i) (recur (+ i 1)) (+ 10 (quot i 16))))))))))))))))
)
