;; Logical extent plan only. Does not choose physical pack/media or mint CIDs.
(ns awai.fs.chunk-plan
  (:require [awai.fs.logical-file :as file])
  (:export [plan]))

;; Result is flat [index offset length ...], in logical-file order.
;; Admission matches logical-file v1, including its 1024-chunk limit.
(defn plan [size :i64 profile [:ref :awai.fs/profile]] [:result :vector-i64 :keyword]
  (let [e (file/profile-refusal profile)]
    (cond (not= e :none) (result-err-of [:result :vector-i64 :keyword] e)
          (or (< size 0) (> size 17179869184))
            (result-err-of [:result :vector-i64 :keyword] :file-size)
          :else
            (let [leaf (record-get [:ref :awai.fs/profile] profile :leaf-size)
                  full (quot size leaf) remainder (rem size leaf)
                  count (+ full (if (= remainder 0) 0 1))]
              (if (> count 1024)
                (result-err-of [:result :vector-i64 :keyword] :chunk-count)
                (result-ok-of [:result :vector-i64 :keyword]
                  (loop [i 0 out (vector-alloc (* count 3))]
                    (if (= i count) out
                      (let [offset (* i leaf)
                            length (if (< (- size offset) leaf) (- size offset) leaf)
                            j (* i 3)]
                        (recur (+ i 1)
                          (vector-assoc! (vector-assoc! (vector-assoc! out j i) (+ j 1) offset) (+ j 2) length)))))))))))
