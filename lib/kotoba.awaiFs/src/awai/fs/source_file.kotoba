;; Bounded Native source reads. The caller owns snapshot consistency and publication.
(ns awai.fs.source-file
 (:capabilities #{:fs/app-data})
 (:export [read-range read-chunk regular-size]))
(defn- path-valid? [p :string] :bool
 (let [n (string-length p)]
  (and (> n 0) (<= (string-byte-length p) 4095)
   (loop [i 0] (if (= i n) true
    (if (= (string-code-point-at p i) 0) false (recur (+ i 1))))))))
(defn- digit [n :i64] :string (string-substring "0123456789" n (+ n 1)))
(defn- decimal [n :i64] :string
 (if (< n 10) (digit n) (string-concat (decimal (quot n 10)) (digit (rem n 10)))))
;; The provider must return exact framed ranges. This does not lock the file;
;; the caller must enforce a stable source or verify each block's fixed CID.
(defn read-range [path :string offset :i64 length :i64] [:result :vector-i64 :keyword]
 (cond (not (path-valid? path)) (result-err-of [:result :vector-i64 :keyword] :invalid-path)
       (or (< offset 0) (< length 1) (> length 262144) (> offset (- 9007199254740991 length)))
         (result-err-of [:result :vector-i64 :keyword] :invalid-range)
       :else
        (let [req (string-concat "\u0000FS2\u0000E" (string-concat path
                    (string-concat "\u0000" (string-concat (decimal offset) (string-concat ":" (decimal length))))))
              reply (typed-cap-call :fs/app-data :string :bytes req)]
         (if (and (= (bytes-count reply) (+ length 5)) (= (bytes-at reply 0) 0)
                  (= (bytes-at reply 1) 70) (= (bytes-at reply 2) 83)
                  (= (bytes-at reply 3) 50) (= (bytes-at reply 4) 0))
          (result-ok-of [:result :vector-i64 :keyword] (vector-i64-from-bytes (bytes-slice reply 5 (+ length 5))))
          (result-err-of [:result :vector-i64 :keyword] :read-refused)))))

;; A bounded logical leaf assembled from provider-sized reads. Not a snapshot.
(defn read-chunk [path :string offset :i64 length :i64] [:result :vector-i64 :keyword]
 (cond (not (path-valid? path)) (result-err-of [:result :vector-i64 :keyword] :invalid-path)
       (or (< offset 0) (< length 1) (> length 1048576) (> offset (- 9007199254740991 length)))
         (result-err-of [:result :vector-i64 :keyword] :invalid-range)
       :else
        (let [out (vector-alloc length)]
         (loop [pos 0]
          (if (= pos length) (result-ok-of [:result :vector-i64 :keyword] out)
           (let [left (- length pos) count (if (> left 262144) 262144 left)
                 r (read-range path (+ offset pos) count)]
            (if (not (result-ok?-of [:result :vector-i64 :keyword] r)) r
             (let [v (result-value-of [:result :vector-i64 :keyword] r (vector-i64))
                   copied (loop [i 0] (if (= i count) 0
                            (let [ignored (vector-assoc! out (+ pos i) (vector-at v i))]
                             (recur (+ i 1)))))]
              (recur (+ pos count))))))))))

;; FS2 O returns mode, size, mtime, type. Limit sizes to this writer profile.
;; The result is a point-in-time check, not an open-handle snapshot.
(defn regular-size [path :string] [:result :i64 :keyword]
 (if (not (path-valid? path)) (result-err-of [:result :i64 :keyword] :invalid-path)
  (let [s (typed-cap-call :fs/app-data :string :string (string-concat "\u0000FS2\u0000O" (string-concat path "\u0000")))
        n (string-length s)]
   (if (or (< n 12) (not= (string-code-point-at s 0) 0) (not= (string-code-point-at s 1) 70)
           (not= (string-code-point-at s 2) 83) (not= (string-code-point-at s 3) 50) (not= (string-code-point-at s 4) 0))
    (result-err-of [:result :i64 :keyword] :stat-refused)
    (let [start (loop [i 5] (cond (>= i n) -1 (= (string-code-point-at s i) 32) (+ i 1) :else (recur (+ i 1))))]
     (if (or (< start 7) (>= start n)) (result-err-of [:result :i64 :keyword] :stat-refused)
      (loop [i start value 0 digits 0]
       (if (or (= i n) (= (string-code-point-at s i) 32))
        (if (or (= digits 0) (= i n)) (result-err-of [:result :i64 :keyword] :stat-refused)
         (let [end (loop [j (+ i 1)] (cond (>= j n) -1 (= (string-code-point-at s j) 32) j :else (recur (+ j 1))))]
          (if (and (> end (+ i 1)) (= (+ end 2) n) (= (string-code-point-at s (+ end 1)) 48))
           (result-ok-of [:result :i64 :keyword] value) (result-err-of [:result :i64 :keyword] :stat-refused))))
        (let [d (- (string-code-point-at s i) 48)]
         (if (or (< d 0) (> d 9) (> value 107374182) (and (= value 107374182) (> d 4)))
          (result-err-of [:result :i64 :keyword] :size-limit)
          (recur (+ i 1) (+ (* value 10) d) (+ digits 1))))))))))))
