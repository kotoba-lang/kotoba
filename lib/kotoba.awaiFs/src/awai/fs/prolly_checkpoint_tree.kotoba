;; Bounded plaintext traversal; root authority, immutable catalog and decryption
;; are caller duties. Every child is fetched and CID-verified by Forest.
(ns awai.fs.prolly-checkpoint-tree
 (:capabilities #{:fs/app-data})
 (:require [awai.fs.forest-file :as forest] [awai.fs.prolly-branch :as branch] [awai.fs.prolly-leaf :as leaf]
           [awai.fs.prolly-checkpoint :as checkpoint])
 (:export [root])
 (:schemas {:awai.fs/check-pending [:record :awai.fs/check-pending [[:cid :vector-i64] [:depth :i64] [:lower :string] [:has-lower :bool] [:upper :string] [:has-upper :bool]]]}))
(defn- enqueue [wire :vector-i64 n :i64 i :i64 depth :i64 lower :string has-lower :bool pending [:list [:ref :awai.fs/check-pending]]] [:list [:ref :awai.fs/check-pending]]
 (if (= i n) pending
  (if (>= (vector-count pending) 256) (throw :node-limit)
   (let [c (branch/child-at wire i) k (branch/child-key wire i)]
    (if (not (result-ok?-of [:result :vector-i64 :keyword] c)) (throw (result-error-of [:result :vector-i64 :keyword] c :invalid-link))
     (let [upper (result-value-of [:result :string :keyword] k "")]
      (enqueue wire n (+ i 1) depth upper true (typed-list-conj [:list [:ref :awai.fs/check-pending]] pending (record-new [:ref :awai.fs/check-pending] (result-value-of [:result :vector-i64 :keyword] c []) depth lower has-lower upper true)))))))))
(defn- walk [paths [:list :string] sizes :vector-i64 window :i64 cap :i64 pending [:list [:ref :awai.fs/check-pending]] i :i64 rows [:ref :awai.fs/check-rows]] [:ref :awai.fs/check-rows]
 (if (= i (vector-count pending)) rows
  (let [item (typed-list-nth [:list [:ref :awai.fs/check-pending]] pending i) depth (record-get [:ref :awai.fs/check-pending] item :depth)
        lower (record-get [:ref :awai.fs/check-pending] item :lower) has-lower (record-get [:ref :awai.fs/check-pending] item :has-lower)
        upper (record-get [:ref :awai.fs/check-pending] item :upper) has-upper (record-get [:ref :awai.fs/check-pending] item :has-upper)]
   (if (>= depth 32) (throw :depth-limit)
    (let [b (forest/get-block-in-files paths sizes (record-get [:ref :awai.fs/check-pending] item :cid) window cap)]
     (if (not (result-ok?-of [:result :vector-i64 :keyword] b)) (throw (result-error-of [:result :vector-i64 :keyword] b :read-refused))
      (let [wire (result-value-of [:result :vector-i64 :keyword] b []) count (branch/child-count wire)]
       (if (result-ok?-of [:result :i64 :keyword] count)
        (let [n (result-value-of [:result :i64 :keyword] count 0) first (branch/child-key wire 0) last (branch/child-key wire (- n 1))
              first-key (result-value-of [:result :string :keyword] first "") last-key (result-value-of [:result :string :keyword] last "")]
         (if (or (and has-lower (>= (branch/key-compare lower first-key) 0)) (and has-upper (not (string=? last-key upper)))) (throw :key-range-mismatch)
          (walk paths sizes window cap (enqueue wire n 0 (+ depth 1) lower has-lower pending) (+ i 1) rows)))
        (if (not= (result-error-of [:result :i64 :keyword] count :invalid-branch) :not-branch)
         (throw (result-error-of [:result :i64 :keyword] count :invalid-branch))
         (let [valid (leaf/validate-range wire lower has-lower upper has-upper) r (checkpoint/add-leaf wire rows)]
          (if (not (result-ok?-of [:result :bool :keyword] valid)) (throw (result-error-of [:result :bool :keyword] valid :invalid-leaf))
          (if (not (result-ok?-of [:result [:ref :awai.fs/check-rows] :keyword] r)) (throw (result-error-of [:result [:ref :awai.fs/check-rows] :keyword] r :invalid-leaf))
           (walk paths sizes window cap pending (+ i 1) (result-value-of [:result [:ref :awai.fs/check-rows] :keyword] r (checkpoint/empty-rows)))))))))))))))
(defn root [paths [:list :string] sizes :vector-i64 cid :vector-i64 window :i64 cap :i64] [:result :string :keyword]
 (try (let [pending (typed-list-conj [:list [:ref :awai.fs/check-pending]] (typed-list-new [:list [:ref :awai.fs/check-pending]]) (record-new [:ref :awai.fs/check-pending] cid 0 "" false "" false))
            rows (walk paths sizes window cap pending 0 (checkpoint/empty-rows))]
        (checkpoint/digest-rows rows))
  (catch :keyword e (result-err-of [:result :string :keyword] e))))
