;; Bounded Forest index v1 writer for the reader's CIDv1/sha256 profile.
;; This produces index/footer bytes only; frame and root publication are caller-owned.
(ns awai.fs.forest-index-write
  (:require [awai.fs.forest-index :as index])
  (:export [encode-index]))
(defn- put-le [out :vector-i64 at :i64 n :i64 value :i64] :vector-i64
  (loop [i 0 v out]
    (if (= i n) v
      (recur (+ i 1) (vector-assoc! v (+ at i) (bit-and (u64-shift-right value (* 8 i)) 255))))))
(defn- cid-at [cids :vector-i64 i :i64] :vector-i64
  (loop [j 0 c (vector-alloc 36)]
    (if (= j 36) c (recur (+ j 1) (vector-assoc! c j (vector-at cids (+ (* i 36) j)))))))
(defn- le [b :vector-i64 p :i64 n :i64] :i64
  (loop [i 0 v 0] (if (= i n) v (recur (+ i 1) (bit-or v (i64-shift-left (vector-at b (+ p i)) (* 8 i)))))))
(defn- cid-hash [c :vector-i64] :i64
  (let [h (bit-xor (bit-xor (bit-xor (bit-xor (bit-xor (vector-at c 1) 18)
              (le c 4 8)) (le c 12 8)) (le c 20 8)) (le c 28 8))
        min-i64 (- (- 0 9223372036854775807) 1)]
    (cond (= h 0) 0 (= h min-i64) 9223372036854775807 :else (- h 1))))
(defn- seen-before? [cids :vector-i64 i :i64 h :i64] :bool
  (loop [j 0] (cond (= j i) false (= h (cid-hash (cid-at cids j))) true :else (recur (+ j 1)))))
(defn encode-index [cids :vector-i64 offsets :vector-i64 index-pos :i64] [:result :vector-i64 :keyword]
  (let [n (vector-count offsets)]
    (cond (or (< n 1) (> n 64) (not= (vector-count cids) (* n 36)) (< index-pos 1) (> index-pos 33550000))
            (result-err-of [:result :vector-i64 :keyword] :invalid-index-input)
          (not (loop [i 0] (if (= i n) true
                 (if (and (index/cid-valid? (cid-at cids i)) (> (vector-at offsets i) 0) (< (vector-at offsets i) index-pos))
                   (recur (+ i 1)) false))))
            (result-err-of [:result :vector-i64 :keyword] :invalid-index-input)
          :else
          (let [slots (+ n 1) payload (+ 32 (* slots 16)) total (+ 8 payload 16)
                head (-> (vector-alloc total)
                         (vector-assoc! 0 80) (vector-assoc! 1 42) (vector-assoc! 2 77) (vector-assoc! 3 24)
                         (put-le 4 4 payload) (put-le 8 8 3735928560)
                         (put-le 16 8 n) (put-le 24 8 0) (put-le 32 8 1))
                groups (loop [i 0 used 0 out head]
                         (if (= i n) out
                           (let [h (cid-hash (cid-at cids i))]
                             (if (seen-before? cids i h) (recur (+ i 1) used out)
                               (let [matches (loop [j 0 count 0]
                                               (if (= j n) count
                                                 (recur (+ j 1) (if (= h (cid-hash (cid-at cids j))) (+ count 1) count))))
                                     next (loop [j 0 k used v out]
                                            (if (= j n) v
                                              (if (= h (cid-hash (cid-at cids j)))
                                                (recur (+ j 1) (+ k 1) (-> v (put-le (+ 40 (* k 16)) 8 h)
                                                                                  (put-le (+ 48 (* k 16)) 8 (vector-at offsets j))))
                                                (recur (+ j 1) k v))))]
                                 (recur (+ i 1) (+ used matches) next))))))
                sentinel (+ 40 (* n 16)) footer (+ 8 payload)
                out (-> groups (put-le sentinel 8 -1) (put-le (+ sentinel 8) 8 -1)
                        (vector-assoc! footer 80) (vector-assoc! (+ footer 1) 42)
                        (vector-assoc! (+ footer 2) 77) (vector-assoc! (+ footer 3) 24)
                        (put-le (+ footer 4) 4 8) (put-le (+ footer 8) 8 (+ index-pos 8)))]
            (result-ok-of [:result :vector-i64 :keyword] out)))))
