;; Cooperative, single-host publication using the provider's scoped flock.
;; All writers must use the same stable lock inode. This is not distributed fencing.
(ns awai.fs.forest-locked-publish
 (:capabilities #{:fs/app-data})
 (:require [awai.fs.forest-verified-publish :as verified])
 (:export [publish]))
(defn- valid-parent? [p :string] :bool
 (let [n (string-length p)]
  (and (>= n 2) (<= (string-byte-length p) 2900) (= (string-code-point-at p 0) 47)
       (not= (string-code-point-at p (- n 1)) 47)
       (loop [i 0] (if (= i n) true
        (if (= (string-code-point-at p i) 0) false (recur (+ i 1))))))))
(defn- valid-name? [name :string] :bool
 (let [n (string-length name)]
  (and (>= n 5) (<= n 80) (string=? (string-substring name 0 4) "gen-")
       (loop [i 4] (if (= i n) true
        (let [c (string-code-point-at name i)]
         (if (or (and (>= c 48) (<= c 57)) (and (>= c 97) (<= c 122)) (= c 45))
          (recur (+ i 1)) false)))))))
;; Status 104: lock not acquired, no staging attempted. Status 102: unlock
;; failed; publication may already have happened and outcome requires inspection.
;; A trap exits the process; the OS releases the held flock, not its lock file.
(defn publish [source-path :string size :i64 parent :string name :string cid :string] [:ref :awai.fs/stage-result]
 (if (or (not (valid-parent? parent)) (not (valid-name? name)) (< size 0) (> size 1073741824))
  (record-new [:ref :awai.fs/stage-result] "" 1)
  (let [path (string-concat parent "/.awai-writer.lock")
        acquire (typed-cap-call :fs/app-data :string :string (string-concat path "FLOCK_SEP"))]
   (if (not (string=? acquire "1")) (record-new [:ref :awai.fs/stage-result] "" 104)
    (let [r (verified/publish source-path size parent name cid)
          release (typed-cap-call :fs/app-data :string :string (string-concat path "UNLOCK_SEP"))]
     (if (string=? release "1") r
      (record-new [:ref :awai.fs/stage-result] (record-get [:ref :awai.fs/stage-result] r :path) 102)))))))
