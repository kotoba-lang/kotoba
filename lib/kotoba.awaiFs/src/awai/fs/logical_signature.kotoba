;; Kotobase logical signature v1 for bounded, unescaped ASCII identifiers.
;; Does not authenticate an issuer/key binding, commit content or physical layout.
(ns awai.fs.logical-signature
 (:require [ed25519.selfhost :as ed])
 (:export [payload verify]))
(defn- safe-id? [s :string] :bool
 (let [n (string-length s)]
  (and (> n 0) (<= n 256)
   (loop [i 0] (if (= i n) true
    (let [x (string-code-point-at s i)]
     (and (or (and (>= x 48) (<= x 57)) (and (>= x 65) (<= x 90)) (and (>= x 97) (<= x 122)) (= x 45) (= x 46) (= x 47) (= x 58) (= x 95)) (recur (+ i 1)))))))))
(defn- hex-root? [s :string] :bool
 (and (= (string-length s) 64)
  (loop [i 0] (if (= i 64) true (let [x (string-code-point-at s i)]
   (and (or (and (>= x 48) (<= x 57)) (and (>= x 97) (<= x 102))) (recur (+ i 1))))))))
(defn payload [root :string issuer :string key :string] [:result :string :keyword]
 (if (or (not (hex-root? root)) (not (safe-id? issuer)) (not (safe-id? key))) (result-err-of [:result :string :keyword] :unsupported-identity)
  (result-ok-of [:result :string :keyword]
   (string-concat "[:kotobase.logical/envelope [:format \"kotobase.logical/v1\"] [:domain :signature] [:value [:map [[[:keyword nil \"format\"] [:string \"kotobase.logical-signature/v1\"]] [[:keyword nil \"issuer\"] [:string \""
    (string-concat issuer (string-concat "\"]] [[:keyword nil \"key-id\"] [:string \"" (string-concat key (string-concat "\"]] [[:keyword nil \"logical-commit-root\"] [:string \"" (string-concat root "\"]]]]]]")))))))))
(defn verify [root :string issuer :string key :string public :vector-i64 signature :vector-i64] [:result :bool :keyword]
 (let [p (payload root issuer key)]
  (cond (not (result-ok?-of [:result :string :keyword] p)) (result-err-of [:result :bool :keyword] :unsupported-identity)
        (not (ed/prime-order-key? public)) (result-err-of [:result :bool :keyword] :invalid-key)
        (not (ed/verify? public (vector-i64-from-bytes (string-to-utf8 (result-value-of [:result :string :keyword] p ""))) signature)) (result-err-of [:result :bool :keyword] :invalid-signature)
        :else (result-ok-of [:result :bool :keyword] true))))
