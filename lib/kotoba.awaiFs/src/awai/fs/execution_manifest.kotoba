;; Raw-vector signature profile observed in the hosted execution fixture.
;; Trusted key, registry/issuer scope, time, publication and policy are caller
;; duties. This is not the registry-key envelope profile or an admission gate.
(ns awai.fs.execution-manifest
 (:require [cbor.codec :as cbor] [cbor.value :as value]
           [kotoba.value.native-validate :as canonical]
           [multiformats.byte-cid :as hash] [ed25519.selfhost :as ed])
 (:export [verify]))
(defn- child [v [:ref :cbor/value] i :i64] [:ref :cbor/value]
 (if (and (= (value/kind v) :array) (>= i 0) (< i (vector-count (value/children v))))
  (typed-list-nth [:list [:ref :cbor/value]] (value/children v) i) (value/null-value)))
(defn- tagged? [v [:ref :cbor/value] code :i64] :bool
 (and (= (value/kind v) :array) (= (vector-count (value/children v)) 2)
      (= (value/kind (child v 0)) :int) (= (value/number (child v 0)) code)))
(defn- key-name [pair [:ref :cbor/value]] :string
 (let [k (child pair 0) v (child k 1)]
  (if (and (= (value/kind pair) :array) (= (vector-count (value/children pair)) 2) (tagged? k 5) (= (value/kind v) :text)) (value/text v) "")))
(defn- find-field [pairs [:list [:ref :cbor/value]] key :string] [:ref :cbor/value]
 (loop [i 0] (if (= i (vector-count pairs)) (value/null-value)
  (let [p (typed-list-nth [:list [:ref :cbor/value]] pairs i)]
   (if (string=? (key-name p) key) (child p 1) (recur (+ i 1)))))))
(defn- text-field? [x [:ref :cbor/value]] :bool
 (and (tagged? x 4) (= (value/kind (child x 1)) :text) (> (string-length (value/text (child x 1))) 0)))
(defn- int-field? [x [:ref :cbor/value] n :i64] :bool
 (and (tagged? x 2) (= (value/kind (child x 1)) :int) (= (value/number (child x 1)) n)))
(defn- signature-bytes [x [:ref :cbor/value]] :vector-i64
 (let [v (child x 1) xs (value/children v)]
  (if (or (not (tagged? x 16)) (not= (value/kind v) :array) (not= (vector-count xs) 64)) (throw :invalid-signature)
   (loop [i 0 out (vector-alloc 64)]
    (if (= i 64) out
     (let [b (typed-list-nth [:list [:ref :cbor/value]] xs i) n (value/number (child b 1))]
      (if (or (not (tagged? b 2)) (not= (value/kind (child b 1)) :int) (< n 0) (> n 255)) (throw :invalid-signature)
       (recur (+ i 1) (vector-assoc! out i n)))))))))
(defn- unsigned-pairs [pairs [:list [:ref :cbor/value]] i :i64 out [:list [:ref :cbor/value]]] [:list [:ref :cbor/value]]
 (if (= i (vector-count pairs)) out
  (let [p (typed-list-nth [:list [:ref :cbor/value]] pairs i)]
   (unsigned-pairs pairs (+ i 1) (if (string=? (key-name p) "signature") out (typed-list-conj [:list [:ref :cbor/value]] out p))))))
(defn- array2 [a [:ref :cbor/value] b [:ref :cbor/value]] [:ref :cbor/value]
 (value/array-value (typed-list-conj [:list [:ref :cbor/value]] (typed-list-conj [:list [:ref :cbor/value]] (typed-list-new [:list [:ref :cbor/value]]) a) b)))
(defn- verify! [wire :vector-i64 public :vector-i64 expected-root :string expected-policy :string expected-epoch :i64] :string
 (let [v (canonical/validate wire)]
  (if (not (result-ok?-of [:result :bool :keyword] v)) (throw :invalid-value)
   (let [decoded (cbor/decode-checked wire) root (result-value-of [:result [:ref :cbor/value] :keyword] decoded (value/null-value)) entries (child root 1) pairs (value/children entries)]
    (if (or (not (tagged? root 19)) (not= (value/kind entries) :array) (not= (vector-count pairs) 9)) (throw :invalid-manifest)
     (let [version (find-field pairs "execution/version") data (find-field pairs "data/commit") policy (find-field pairs "authority/policy") epoch (find-field pairs "authority/epoch")
           location (find-field pairs "location/manifest") schema (find-field pairs "schema/root") parent (find-field pairs "parent") issued (find-field pairs "issued-at") signature (find-field pairs "signature")]
      (if (or (not (int-field? version 1)) (not (text-field? data)) (not (text-field? policy)) (not (int-field? epoch expected-epoch)) (< expected-epoch 0)
              (not (text-field? location)) (not (text-field? schema)) (not (text-field? issued))
              (not (or (and (tagged? parent 0) (= (value/kind (child parent 1)) :null)) (text-field? parent)))) (throw :invalid-manifest)
       (if (or (not (string=? (value/text (child data 1)) expected-root)) (not (string=? (value/text (child policy 1)) expected-policy))) (throw :scope-mismatch)
        (let [sig (signature-bytes signature) unsigned (array2 (value/int-value 19) (value/array-value (unsigned-pairs pairs 0 (typed-list-new [:list [:ref :cbor/value]]))))
              bytes (cbor/encode-checked unsigned)]
         (if (not (result-ok?-of [:result :vector-i64 :keyword] bytes)) (throw :invalid-manifest)
          (let [payload (hash/cidv1-dag-cbor-bytes (result-value-of [:result :vector-i64 :keyword] bytes []))]
           (cond (not (ed/prime-order-key? public)) (throw :invalid-key)
                 (not (ed/verify? public (vector-i64-from-bytes (string-to-utf8 payload)) sig)) (throw :invalid-signature)
                 :else payload))))))))))))
(defn verify [wire :vector-i64 public :vector-i64 expected-root :string expected-policy :string expected-epoch :i64] [:result :string :keyword]
 (try (result-ok-of [:result :string :keyword] (verify! wire public expected-root expected-policy expected-epoch))
  (catch :keyword e (result-err-of [:result :string :keyword] e))))
