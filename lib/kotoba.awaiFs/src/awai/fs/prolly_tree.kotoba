;; Bounded exact lookup over CID-checked Forest blocks. Root authenticity,
;; authorization, value decryption and transaction basis are caller duties.
(ns awai.fs.prolly-tree
 (:capabilities #{:fs/app-data})
 (:require [awai.fs.forest-file :as forest] [awai.fs.prolly-branch :as branch] [awai.fs.prolly-leaf :as leaf])
 (:export [lookup lookup-verified]))
(defn- walk [paths [:list :string] sizes :vector-i64 cid :vector-i64 key :string window :i64 cap :i64 depth :i64] [:result :vector-i64 :keyword]
 (if (>= depth 64) (result-err-of [:result :vector-i64 :keyword] :depth-limit)
  (let [block (forest/get-block-in-files paths sizes cid window cap)]
   (if (not (result-ok?-of [:result :vector-i64 :keyword] block)) block
    (let [wire (result-value-of [:result :vector-i64 :keyword] block []) next (branch/select wire key)]
     (if (result-ok?-of [:result :vector-i64 :keyword] next)
      (walk paths sizes (result-value-of [:result :vector-i64 :keyword] next []) key window cap (+ depth 1))
      (if (= (result-error-of [:result :vector-i64 :keyword] next :invalid-branch) :not-branch)
       (leaf/lookup wire key) next)))))))
(defn lookup [paths [:list :string] sizes :vector-i64 cid :vector-i64 key :string window :i64 cap :i64] [:result :vector-i64 :keyword]
 (walk paths sizes cid key window cap 0))
;; Digest checks are read-before-use measurements; they do not lock the files.
;; The caller owns trusted digest selection and exclusion of concurrent writes.
(defn- check-archives [paths [:list :string] sizes :vector-i64 digests [:list :string] i :i64] [:result :bool :keyword]
 (if (= i (vector-count paths)) (result-ok-of [:result :bool :keyword] true)
  (let [p (typed-list-nth [:list :string] paths i) d (typed-list-nth [:list :string] digests i)
        r (forest/verify-archive p (vector-at sizes i) d)]
   (if (not (result-ok?-of [:result :bool :keyword] r)) r (check-archives paths sizes digests (+ i 1))))))
(defn lookup-verified [paths [:list :string] sizes :vector-i64 digests [:list :string] cid :vector-i64 key :string window :i64 cap :i64] [:result :vector-i64 :keyword]
 (let [n (vector-count paths)]
  (if (or (< n 1) (> n 64) (not= n (vector-count sizes)) (not= n (vector-count digests)))
   (result-err-of [:result :vector-i64 :keyword] :invalid-file-list)
   (let [checked (check-archives paths sizes digests 0)]
    (if (not (result-ok?-of [:result :bool :keyword] checked))
     (result-err-of [:result :vector-i64 :keyword] (result-error-of [:result :bool :keyword] checked :archive-refused))
     (walk paths sizes cid key window cap 0))))))
