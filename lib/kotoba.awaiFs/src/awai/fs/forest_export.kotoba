;; Cooperative single-host export from a trusted HEAD CID into a new file.
;; No signature authority, rollback protection, hostile fencing or cleanup.
(ns awai.fs.forest-export
 (:capabilities #{:fs/app-data})
 (:require [awai.fs.forest-head :as head] [awai.fs.source-file :as source]
           [awai.fs.logical-file :as logical] [awai.fs.forest-view :as view])
 (:export [export-new]))

(defn- valid-parent? [p :string] :bool
 (let [n (string-length p)]
  (and (>= n 2) (<= (string-byte-length p) 2800) (= (string-code-point-at p 0) 47)
       (not= (string-code-point-at p (- n 1)) 47)
       (loop [i 0] (if (= i n) true (if (= (string-code-point-at p i) 0) false (recur (+ i 1))))))))
(defn- valid-name? [s :string] :bool
 (let [n (string-length s)]
  (and (>= n 6) (<= n 80) (string=? (string-substring s 0 5) "file-")
       (loop [i 5] (if (= i n) true
        (let [c (string-code-point-at s i)]
         (if (or (and (>= c 48) (<= c 57)) (and (>= c 97) (<= c 122)) (= c 45))
          (recur (+ i 1)) false)))))))
(defn- framed-true? [r :string] :bool
 (and (= (string-length r) 6) (= (string-code-point-at r 0) 0)
      (= (string-code-point-at r 1) 70) (= (string-code-point-at r 2) 83)
      (= (string-code-point-at r 3) 50) (= (string-code-point-at r 4) 0)
      (= (string-code-point-at r 5) 49)))
(defn- sync? [p :string] :bool
 (framed-true? (typed-cap-call :fs/app-data :string :string
  (string-concat "\u0000FS2\u0000M" (string-concat p "\u0000")))))
(defn- temp-dir [parent :string] :string
 (let [r (typed-cap-call :fs/app-data :string :string
           (string-concat "\u0000FS2\u0000N" (string-concat parent "\u0000awai-export-")))
       n (string-length r) base (string-concat parent "/awai-export-") k (string-length base)]
  (if (and (= n (+ 5 k 6)) (= (string-code-point-at r 0) 0) (= (string-code-point-at r 1) 70)
           (= (string-code-point-at r 2) 83) (= (string-code-point-at r 3) 50) (= (string-code-point-at r 4) 0)
           (string=? (string-substring r 5 (+ 5 k)) base)
           (loop [i (+ 5 k)] (if (= i n) true
            (let [c (string-code-point-at r i)]
             (if (or (and (>= c 48) (<= c 57)) (and (>= c 97) (<= c 122))) (recur (+ i 1)) false)))))
   (string-substring r 5 n) "")))
(defn- emit! [name :string v :vector-i64] :i64
 (let [n (vector-count v)]
  (loop [at 0] (if (= at n) 0
   (let [left (- n at) count (if (> left 262144) 262144 left)
         status (arena-scope
          (let [piece (loop [j 0 out (vector-alloc count)] (if (= j count) out
                        (recur (+ j 1) (vector-assoc! out j (vector-at v (+ at j))))))
                h (string-to-utf8 (string-concat "\u0000FS2\u0000C" (string-concat name "\u0000")))
                r (typed-cap-call :fs/app-data-bytes :bytes :bytes (bytes-concat h (bytes-from-vector-i64 piece)))]
           (if (and (= (bytes-count r) (+ count 5)) (= (bytes-at r 0) 0)
                    (= (bytes-at r 1) 70) (= (bytes-at r 2) 83) (= (bytes-at r 3) 50) (= (bytes-at r 4) 0)) 0 1)))]
    (if (= status 0) (recur (+ at count)) status))))))
(defn- emit-chunk! [wire :vector-i64 cid :string gen :string path :string i :i64] :i64
 (arena-scope
  (let [pack (string-concat gen (string-concat "/pack-" (string-from-i64 (quot i 16)))) st (source/regular-size pack)]
   (if (not (result-ok?-of [:result :i64 :keyword] st)) 1
    (let [n (result-value-of [:result :i64 :keyword] st -1)
          r (view/read-chunk wire cid i (typed-list-new [:list :string] pack) (vector-i64 n) 2097152 1049000)]
     (if (not (result-ok?-of [:result :vector-i64 :keyword] r)) 1
      (emit! path (result-value-of [:result :vector-i64 :keyword] r (vector-i64)))))))))
(defn- export-held [parent :string cid :string out-parent :string name :string] :i64
 (let [h (head/recover-held parent cid) hs (record-get [:ref :awai.fs/head-result] h :status)]
  (if (not= hs 0) hs
   (let [gen (string-concat parent (string-concat "/" (record-get [:ref :awai.fs/head-result] h :name)))
         manifest (string-concat gen "/manifest") st (source/regular-size manifest)]
    (if (not (result-ok?-of [:result :i64 :keyword] st)) 106
     (let [n (result-value-of [:result :i64 :keyword] st -1)]
      (if (or (< n 1) (> n 131072)) 106
       (let [r (source/read-chunk manifest 0 n)]
        (if (not (result-ok?-of [:result :vector-i64 :keyword] r)) 106
         (let [wire (result-value-of [:result :vector-i64 :keyword] r (vector-i64)) d (logical/decode wire)
               address (logical/bytes-cid wire)]
          (if (or (not (result-ok?-of [:result [:ref :awai.fs/file] :keyword] d))
                  (not (result-ok?-of [:result :string :keyword] address))
                  (not (string=? cid (result-value-of [:result :string :keyword] address "")))) 106
           (let [f (result-value-of [:result [:ref :awai.fs/file] :keyword] d (logical/file-new 0 0 (logical/profile-new 0 "" 0) (vector-i64)))
                 p (record-get [:ref :awai.fs/file] f :profile) rows (record-get [:ref :awai.fs/file] f :rows)
                 count (quot (vector-count rows) 38)]
            (if (or (not= (record-get [:ref :awai.fs/profile] p :leaf-size) 1048576)
                    (> (record-get [:ref :awai.fs/file] f :size) 1073741824)) 106
             (let [tmp (temp-dir out-parent)]
              (if (string=? tmp "") 110
               (let [path (string-concat tmp "/data") target (string-concat out-parent (string-concat "/" name))
                     created (typed-cap-call :fs/app-data :string :string
                               (string-concat "\u0000FS2\u0000B" (string-concat path "\u0000")))]
                (if (not (string=? created "\u0000FS2\u0000")) 111
                 (let [status (loop [i 0] (if (= i count) 0
                                (if (= (emit-chunk! wire cid gen path i) 0) (recur (+ i 1)) 111)))]
                  (if (not= status 0) status
                   (if (or (not (sync? path)) (not (sync? tmp))) 111
                    (let [rr (typed-cap-call :fs/app-data :string :string
                               (string-concat "\u0000FS2\u0000T" (string-concat path (string-concat "\u0000" target))))]
                     (if (not (framed-true? rr)) 112
                      (if (or (not (sync? tmp)) (not (sync? out-parent))) 113 0)))))))))))))))))))))))
;; Holds the stable cooperative writer lock through publication. Status 0 means
;; no-replace rename and directory sync acknowledged; 102 unlock failure and
;; 113 post-rename sync failure have uncertain outcomes. 112 is a rename refusal
;; or malformed response; inspect target before retry. Failed stages are retained.
;; All local writers/GC must cooperate. Caller authenticates CID; no hostile
;; same-identity safety, product wiring, authority, WAL or power-loss proof.
(defn export-new [parent :string cid :string out-parent :string name :string] :i64
 (if (or (not (valid-parent? parent)) (not (valid-parent? out-parent)) (not (valid-name? name))) 1
  (let [lock (string-concat parent "/.awai-writer.lock")
        acquired (typed-cap-call :fs/app-data :string :string (string-concat lock "FLOCK_SEP"))]
   (if (not (string=? acquired "1")) 104
    (let [r (export-held parent cid out-parent name)
          released (typed-cap-call :fs/app-data :string :string (string-concat lock "UNLOCK_SEP"))]
     (if (string=? released "1") r 102))))))
