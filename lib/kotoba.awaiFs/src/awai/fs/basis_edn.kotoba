;; Strict bounded reader for the hosted v1 proof's fixed pr-str field order.
;; The :commit map is retained as opaque text and is NOT root-validated.
(ns awai.fs.basis-edn
 (:export [read])
 (:schemas {:awai.fs/basis-edn [:record :awai.fs/basis-edn [[:physical :string] [:root :string] [:commit :string] [:issuer :string] [:key :string] [:signature :vector-i64]]]
            :awai.fs/edn-part [:record :awai.fs/edn-part [[:text :string] [:next :i64]]]
            :awai.fs/edn-number [:record :awai.fs/edn-number [[:value :i64] [:next :i64]]]}))
(defn- expect [s :string p :i64 token :string] :i64
 (let [n (string-length token) end (+ p n)]
  (if (or (< p 0) (> end (string-length s))) (throw :invalid-proof)
   (if (string=? (string-substring s p end) token) end (throw :invalid-proof)))))
(defn- text-until [s :string p :i64 term :i64 limit :i64] [:ref :awai.fs/edn-part]
 (let [n (string-length s)]
  (loop [i p] (if (or (>= i n) (> (- i p) limit)) (throw :invalid-proof)
   (let [c (string-code-point-at s i)]
    (cond (= c term) (record-new [:ref :awai.fs/edn-part] (string-substring s p i) (+ i 1))
          (or (< c 32) (> c 126) (= c 92) (= c 123) (and (= c 125) (not= term 125))) (throw :unsupported-proof)
          :else (recur (+ i 1))))))))
(defn- number [s :string p :i64] [:ref :awai.fs/edn-number]
 (let [n (string-length s)]
  (loop [i p v 0 digits 0]
   (if (>= i n) (throw :invalid-signature)
    (let [c (string-code-point-at s i)]
     (if (and (>= c 48) (<= c 57))
      (if (or (>= digits 3) (> (+ (* v 10) (- c 48)) 255)) (throw :invalid-signature)
       (recur (+ i 1) (+ (* v 10) (- c 48)) (+ digits 1)))
      (if (= digits 0) (throw :invalid-signature) (record-new [:ref :awai.fs/edn-number] v i))))))))
(defn- sig-bytes [s :string p :i64 i :i64 out :vector-i64] :vector-i64
 (if (= i 64) out
  (let [x (number s p) next (record-get [:ref :awai.fs/edn-number] x :next) delimiter (if (= i 63) "]}" " ") p2 (expect s next delimiter)]
   (if (and (= i 63) (not= p2 (string-length s))) (throw :trailing-data)
    (sig-bytes s p2 (+ i 1) (vector-assoc! out i (record-get [:ref :awai.fs/edn-number] x :value)))))))
(defn- parse! [wire :vector-i64] [:ref :awai.fs/basis-edn]
 (let [n (vector-count wire)]
  (if (or (< n 1) (> n 16384)) (throw :invalid-bound)
   (let [ok (loop [i 0] (if (= i n) true (let [c (vector-at wire i)] (and (>= c 32) (<= c 126) (recur (+ i 1))))))]
    (if (not ok) (throw :unsupported-proof)
     (let [s (string-from-utf8 (bytes-from-vector-i64 wire)) p (expect s 0 "{:physical-root \"")
           physical (text-until s p 34 256) p1 (expect s (record-get [:ref :awai.fs/edn-part] physical :next) ", :root \"")
           root (text-until s p1 34 64) p2 (expect s (record-get [:ref :awai.fs/edn-part] root :next) ", :commit {")
           commit (text-until s p2 125 12000) p3 (expect s (record-get [:ref :awai.fs/edn-part] commit :next) ", :issuer \"")
           issuer (text-until s p3 34 256) p4 (expect s (record-get [:ref :awai.fs/edn-part] issuer :next) ", :key-id \"")
           key (text-until s p4 34 256) p5 (expect s (record-get [:ref :awai.fs/edn-part] key :next) ", :signature [")
           signature (sig-bytes s p5 0 (vector-alloc 64))]
      (record-new [:ref :awai.fs/basis-edn] (record-get [:ref :awai.fs/edn-part] physical :text) (record-get [:ref :awai.fs/edn-part] root :text) (record-get [:ref :awai.fs/edn-part] commit :text) (record-get [:ref :awai.fs/edn-part] issuer :text) (record-get [:ref :awai.fs/edn-part] key :text) signature)))))))
(defn read [wire :vector-i64] [:result [:ref :awai.fs/basis-edn] :keyword]
 (try (result-ok-of [:result [:ref :awai.fs/basis-edn] :keyword] (parse! wire))
  (catch :keyword e (result-err-of [:result [:ref :awai.fs/basis-edn] :keyword] e))))
