;; Cooperative single-host composition. No WAL, signed authority or hostile fencing.
(ns awai.fs.forest-commit
 (:capabilities #{:fs/app-data})
 (:require [awai.fs.forest-head :as head] [awai.fs.forest-verified-publish :as published]
           [awai.fs.forest-generation-verify :as generation])
 (:export [commit]))
(defn- valid-parent? [p :string] :bool
 (let [n (string-length p)]
  (and (>= n 2) (<= (string-byte-length p) 2800) (= (string-code-point-at p 0) 47)
       (not= (string-code-point-at p (- n 1)) 47)
       (loop [i 0] (if (= i n) true (if (= (string-code-point-at p i) 0) false (recur (+ i 1))))))))
;; Holds the shared lock across precondition, generation publication and HEAD
;; transition. On collision the existing named generation must validate against
;; new-cid; it is never silently treated as equal by name alone. On failure a
;; staged or published but unattached generation can remain for inspection.
;; 104 busy; 105 stale; 106 old damaged; 107 new/collision damaged;
;; 102 unlock failure (outcome uncertain); other statuses come from publisher.
(defn commit [source :string size :i64 parent :string old-name :string old-cid :string
              new-name :string new-cid :string] :i64
 (if (or (not (valid-parent? parent)) (< size 0) (> size 1073741824)) 1
  (let [lock (string-concat parent "/.awai-writer.lock")
        acquired (typed-cap-call :fs/app-data :string :string (string-concat lock "FLOCK_SEP"))]
   (if (not (string=? acquired "1")) 104
    (let [prior (head/check-held parent old-name old-cid)
          result (if (not= prior 0) prior
                   (let [r (published/publish source size parent new-name new-cid)
                         status (record-get [:ref :awai.fs/stage-result] r :status)
                         target (string-concat parent (string-concat "/" new-name))]
                    (cond (= status 0) (head/advance-held parent old-name old-cid new-name new-cid)
                          (= status 95) (if (= (generation/verify target new-cid) 0)
                                          (head/advance-held parent old-name old-cid new-name new-cid) 107)
                          :else status)))
          released (typed-cap-call :fs/app-data :string :string (string-concat lock "UNLOCK_SEP"))]
     (if (string=? released "1") result 102))))))
