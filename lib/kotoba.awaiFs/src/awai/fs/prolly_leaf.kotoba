;; Exact opaque-key lookup in a single already CID-checked Prolly leaf.
;; This is not tree traversal, decryption, policy evaluation or a Datalog query.
(ns awai.fs.prolly-leaf
 (:require [cbor.codec :as cbor] [cbor.value :as value])
 (:export [lookup]))
(defn- child [v [:ref :cbor/value] i :i64] [:ref :cbor/value]
 (if (and (= (value/kind v) :array) (>= i 0) (< i (vector-count (value/children v))))
  (typed-list-nth [:list [:ref :cbor/value]] (value/children v) i) (value/null-value)))
(defn- field [m [:ref :cbor/value] key :string] [:ref :cbor/value]
 (if (not= (value/kind m) :map) (value/null-value)
  (let [xs (value/children m) n (vector-count xs)]
   (loop [i 0] (if (>= i n) (value/null-value)
    (let [k (typed-list-nth [:list [:ref :cbor/value]] xs i)]
     (if (and (= (value/kind k) :text) (string=? (value/text k) key))
      (typed-list-nth [:list [:ref :cbor/value]] xs (+ i 1)) (recur (+ i 2)))))))))
(defn- scan [entries [:ref :cbor/value] key :string] :vector-i64
 (let [xs (value/children entries) n (vector-count xs)]
  (if (or (not= (value/kind entries) :array) (> n 4096)) (throw :invalid-leaf)
   (loop [i 0 found false result (vector-i64)]
    (if (= i n) (if found result (throw :not-found))
     (let [item (typed-list-nth [:list [:ref :cbor/value]] xs i) k (child item 0) v (child item 1)]
      (if (or (not= (value/kind item) :array) (not= (vector-count (value/children item)) 2)
              (not= (value/kind k) :text) (not= (value/kind v) :bytes)) (throw :invalid-leaf)
       (if (string=? (value/text k) key)
        (if found (throw :duplicate-key) (recur (+ i 1) true (value/data v)))
        (recur (+ i 1) found result)))))))))
(defn- lookup! [wire :vector-i64 key :string] :vector-i64
 (let [decoded (cbor/decode-checked wire)]
  (if (not (result-ok?-of [:result [:ref :cbor/value] :keyword] decoded)) (throw :invalid-cbor)
   (let [node (result-value-of [:result [:ref :cbor/value] :keyword] decoded (value/null-value)) kind (field node "kind")]
    (if (or (not= (value/kind kind) :text) (not (string=? (value/text kind) "leaf"))) (throw :not-leaf)
     (scan (field node "entries") key))))))
(defn lookup [wire :vector-i64 key :string] [:result :vector-i64 :keyword]
 (try (result-ok-of [:result :vector-i64 :keyword] (lookup! wire key))
  (catch :keyword e (result-err-of [:result :vector-i64 :keyword] e))))
