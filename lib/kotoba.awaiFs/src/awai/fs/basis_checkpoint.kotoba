;; Logical basis plus one complete plaintext root leaf. Caller must validate
;; the leaf CID, prove it is the snapshot's complete SPO root, and bind the
;; selected issuer/key to authority before invoking this helper.
(ns awai.fs.basis-checkpoint
 (:require [awai.fs.basis-verify :as verify] [awai.fs.basis-edn :as basis]
           [awai.fs.logical-commit :as commit] [awai.fs.prolly-checkpoint :as checkpoint])
 (:export [verify-leaf]))
(defn verify-leaf [proof :vector-i64 leaf :vector-i64 issuer :string key :string public :vector-i64] [:result :bool :keyword]
 (let [checked (verify/verify proof issuer key public)]
  (if (not (result-ok?-of [:result :bool :keyword] checked)) checked
   (let [p (basis/read proof)
         v (result-value-of [:result [:ref :awai.fs/basis-edn] :keyword] p (record-new [:ref :awai.fs/basis-edn] "" "" "" "" "" []))
         expected (commit/checkpoint-root (record-get [:ref :awai.fs/basis-edn] v :commit)) actual (checkpoint/root leaf)]
    (cond (not (result-ok?-of [:result :string :keyword] expected)) (result-err-of [:result :bool :keyword] :invalid-commit)
          (not (result-ok?-of [:result :string :keyword] actual)) (result-err-of [:result :bool :keyword] (result-error-of [:result :string :keyword] actual :invalid-leaf))
          (not (string=? (result-value-of [:result :string :keyword] actual "") (result-value-of [:result :string :keyword] expected ""))) (result-err-of [:result :bool :keyword] :checkpoint-mismatch)
          :else (result-ok-of [:result :bool :keyword] true))))))
