(ns native-forest-commit-gib-recover
 (:capabilities #{:fs/app-data})
 (:require [awai.fs.forest-head :as head])
 (:export [main]))
(defn main [] :i64
 (let [r (head/recover "PARENT" "bafyreidru6ltjx62ydamsef4o6dpxrlzjaavb4nfzxx6xxnzzcgiypmfui")]
  (if (and (= (record-get [:ref :awai.fs/head-result] r :status) 0)
           (string=? (record-get [:ref :awai.fs/head-result] r :name) "gen-gib")) 0 1)))
