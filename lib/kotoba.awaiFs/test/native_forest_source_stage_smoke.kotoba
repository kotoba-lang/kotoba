(ns native-stage-smoke
 (:capabilities #{:fs/app-data})
 (:require [awai.fs.forest-source-stage :as stage])
 (:export [main]))
(defn main [] :i64
 (cond (not= (stage/stage "SOURCE" -1 "OUT/bad/") 1) 1
       (not= (stage/stage "SOURCE" 1073741825 "OUT/bad/") 1) 2
       (not= (stage/stage "SOURCE" 1 "OUT/bad") 1) 3
       (not= (stage/stage "SOURCE" 0 "OUT/empty/") 0) 4
       (not= (stage/stage "SOURCE" 1 "OUT/one/") 0) 5
       (not= (stage/stage "SOURCE" 1048579 "OUT/partial/") 0) 6
       (not= (stage/stage "SOURCE" 16777219 "OUT/multipack/") 0) 7
       :else 0))
