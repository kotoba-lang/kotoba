(ns awai.fs.native-logical-signature
 (:require [awai.fs.logical-signature :as s] [ed25519.selfhost :as ed]) (:export [main]))
(defn main [] :i64
 (let [root "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" issuer "did:key:fixture-issuer" key "fixture-key"
       public (vector-i64 237 73 40 198 40 209 194 198 234 233 3 56 144 89 149 97 41 89 39 58 92 99 249 54 54 193 70 20 172 135 55 209)
       sig (vector-i64 37 4 108 177 238 65 205 200 90 7 148 73 226 156 140 82 174 53 108 66 52 85 81 6 132 10 26 221 231 208 184 67 204 12 115 107 87 149 147 137 76 131 97 149 234 222 78 83 94 214 217 253 212 42 253 221 3 17 151 191 15 127 115 8)
       p (s/payload root issuer key) good (s/verify root issuer key public sig)
       changed (s/verify root "did:key:other" key public sig)
       changed-key (s/verify root issuer "fixture-other" public sig)
       changed-root (s/verify "baaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" issuer key public sig)
       badkey (s/verify root issuer key (vector-alloc 32) sig)
       badroot (s/verify "bad" issuer key public sig)
       wrongsig (s/verify root issuer key public (vector-assoc! sig 0 36))]
  (cond (not (result-ok?-of [:result :string :keyword] p)) 1
        (not (string=? (result-value-of [:result :string :keyword] p "") "[:kotobase.logical/envelope [:format \"kotobase.logical/v1\"] [:domain :signature] [:value [:map [[[:keyword nil \"format\"] [:string \"kotobase.logical-signature/v1\"]] [[:keyword nil \"issuer\"] [:string \"did:key:fixture-issuer\"]] [[:keyword nil \"key-id\"] [:string \"fixture-key\"]] [[:keyword nil \"logical-commit-root\"] [:string \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"]]]]]]")) 2
        (not (result-ok?-of [:result :bool :keyword] good)) 3
        (not= (result-error-of [:result :bool :keyword] changed :none) :invalid-signature) 4
        (not= (result-error-of [:result :bool :keyword] badkey :none) :invalid-key) 5
        (not= (result-error-of [:result :bool :keyword] badroot :none) :unsupported-identity) 6
        (not= (result-error-of [:result :bool :keyword] wrongsig :none) :invalid-signature) 7
        (not= (result-error-of [:result :bool :keyword] changed-key :none) :invalid-signature) 8
        (not= (result-error-of [:result :bool :keyword] changed-root :none) :invalid-signature) 9 :else 0)))
