(ns native-forest-head-smoke
 (:capabilities #{:fs/app-data})
 (:require [awai.fs.forest-head :as head])
 (:export [main]))
(defn main [] :i64
 (let [a "bafyreifofrzrmfqc2affepxac6oyi57owuaulr3pvmqi2dftdtfmjtxifq"
       b "bafyreifi7jcs6ncvlb65csdwcslxb4rezs7xvm4dfq4bg2zvelch43342q"]
  (cond (not= (head/advance "PARENT" "" "" "gen-a" a) 0) 1
        (not= (head/advance "PARENT" "" "" "gen-b" b) 105) 2
        (not= (head/advance "PARENT" "gen-a" a "gen-b" b) 0) 3
        (not= (head/advance "PARENT" "gen-a" a "gen-b" b) 105) 4
        :else 0)))
