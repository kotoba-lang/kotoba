;; Synthetic 17 MiB native writer; no atomic catalog or durability claim.
(ns awai.fs.native-forest-many-write
 (:capabilities #{:fs/app-data})
 (:require [awai.fs.forest-write :as forest] [awai.fs.logical-file :as logical]
           [multiformats.byte-cid :as hash])
 (:export [main]))
(defn- flat [chunk :i64] :vector-i64
 (loop [i 0 out (vector-alloc 1048577)]
  (if (= i 1048577) out
   (let [p (+ (* chunk 1048576) (- i 1))]
    (recur (+ i 1) (vector-assoc! out i (if (= i 0) 1048576 (rem (+ (* p 19) (quot p 8191)) 256))))))))
(defn- body [v :vector-i64] :vector-i64
 (loop [i 0 out (vector-alloc 1048576)]
  (if (= i 1048576) out (recur (+ i 1) (vector-assoc! out i (vector-at v (+ i 1)))))))
(defn- write-pieces [path :string v :vector-i64] :i64
 (let [n (vector-count v)]
  (loop [at 0]
   (if (= at n) 0
    (let [left (- n at) count (if (> left 262144) 262144 left)
          status (arena-scope
           (let [piece (loop [i 0 out (vector-alloc count)]
                        (if (= i count) out (recur (+ i 1) (vector-assoc! out i (vector-at v (+ at i))))))
                 head (string-to-utf8 (string-concat (if (= at 0) "\u0000FS2\u0000B" "\u0000FS2\u0000C") (string-concat path "\u0000")))
                 reply (typed-cap-call :fs/app-data-bytes :bytes :bytes (bytes-concat head (bytes-from-vector-i64 piece)))]
            (if (= (bytes-count reply) (+ count 5)) 0 1)))]
     (if (= status 0) (recur (+ at count)) status))))))
(defn- one [i :i64 rows :vector-i64] :i64
 (arena-scope
  (let [data (flat i) block (body data) cid (hash/cidv1-raw-bytes block)
        row (logical/chunk-row (* i 1048576) 1048576 cid)
        encoded (forest/encode-large 1 data)]
   (if (or (not= (vector-count row) 38) (not (result-ok?-of [:result :vector-i64 :keyword] encoded))) 1
    (let [copied (loop [j 0] (if (= j 38) 0
                   (let [v (vector-assoc! rows (+ (* i 38) j) (vector-at row j))] (recur (+ j 1)))))
          path (string-concat "pack-" (string-from-i64 i))]
     (write-pieces path (result-value-of [:result :vector-i64 :keyword] encoded [])))))))
(defn main [] :i64
 (let [rows (vector-alloc (* 17 38)) status (loop [i 0]
          (if (= i 17) 0 (let [r (one i rows)] (if (= r 0) (recur (+ i 1)) (+ 10 i)))))]
  (if (not= status 0) status
   (let [file (logical/file-new 1 17825792 (logical/profile-new 1 "fixed" 1048576) rows)
         manifest (logical/encode file)]
    (if (not (result-ok?-of [:result :vector-i64 :keyword] manifest)) 90
      (write-pieces "manifest" (result-value-of [:result :vector-i64 :keyword] manifest [])))))))
