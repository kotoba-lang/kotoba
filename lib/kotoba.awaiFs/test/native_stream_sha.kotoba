(ns awai.fs.native-stream-sha (:export [main])
  (:require [multiformats.sha256 :as sha]))
(defn- bytes [s :string] :vector-i64 (vector-i64-from-bytes (string-to-utf8 s)))
(defn- repeat-a [n :i64] :vector-i64
  (loop [i 0 out (vector-alloc n)]
    (if (= i n) out (recur (+ i 1) (vector-assoc! out i 97)))))
(defn main [] :i64
  (let [empty (sha/stream-new) a (sha/stream-new) b (sha/stream-new)
        c (sha/stream-new) d (sha/stream-new) e (sha/stream-new) million (repeat-a 1000000)]
    (cond
      (not (string=? (sha/stream-final empty) "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855")) 1
      (not (sha/stream-update! a (bytes "a"))) 2
      (not (sha/stream-update! a (bytes "bc"))) 3
      (not (string=? (sha/stream-final a) "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")) 4
      (not (sha/stream-update! b (repeat-a 55))) 5
      (not (string=? (sha/stream-final b) (sha/digest-hex (repeat-a 55)))) 6
      (not (sha/stream-update! b (repeat-a 1))) 7
      (not (string=? (sha/stream-final b) (sha/digest-hex (repeat-a 56)))) 8
      (not (sha/stream-update! b (repeat-a 8))) 9
      (not (string=? (sha/stream-final b) (sha/digest-hex (repeat-a 64)))) 10
      (not (sha/stream-update! b (repeat-a 1))) 11
      (not (string=? (sha/stream-final b) (sha/digest-hex (repeat-a 65)))) 12
      (sha/stream-update! a [-1]) 13
      (not (string=? (sha/stream-final a) "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")) 14
      (not (sha/stream-update! c million)) 15
      (not (string=? (sha/stream-final c) "cdc76e5c9914fb9281a1c7e284d73e67f1809a48a497200e046d39ccc7112cd0")) 16
      (not (loop [i 0] (if (= i 1000) true
                           (if (sha/stream-update! d (repeat-a 1000)) (recur (+ i 1)) false)))) 17
      (not (string=? (sha/stream-final d) "cdc76e5c9914fb9281a1c7e284d73e67f1809a48a497200e046d39ccc7112cd0")) 18
      (sha/stream-update! (vector-i64) (bytes "x")) 19
      (not (string=? (sha/stream-final (vector-i64)) "")) 20
      (not (loop [i 0] (if (= i 1000) true
                           (if (arena-scope (sha/stream-update! e (repeat-a 1000))) (recur (+ i 1)) false)))) 21
      (not (string=? (sha/stream-final e) "cdc76e5c9914fb9281a1c7e284d73e67f1809a48a497200e046d39ccc7112cd0")) 22
      :else 0)))
