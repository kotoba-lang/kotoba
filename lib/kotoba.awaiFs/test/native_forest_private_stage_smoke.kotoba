(ns native-private-stage-smoke
 (:capabilities #{:fs/app-data})
 (:require [awai.fs.forest-source-stage :as stage])
 (:export [main]))
(defn main [] :i64
 (let [bad (stage/stage-private "SOURCE" 2 "PARENT")
       a (stage/stage-private "SOURCE" 1 "PARENT")
       b (stage/stage-private "SOURCE" 1 "PARENT")
       x (record-get [:ref :awai.fs/stage-result] a :path)
       y (record-get [:ref :awai.fs/stage-result] b :path)]
  (cond (not= (record-get [:ref :awai.fs/stage-result] bad :status) 2) 1
        (not (string=? (record-get [:ref :awai.fs/stage-result] bad :path) "")) 2
        (not= (record-get [:ref :awai.fs/stage-result] a :status) 0) 3
        (not= (record-get [:ref :awai.fs/stage-result] b :status) 0) 4
        (or (= (string-length x) 0) (= (string-length y) 0) (string=? x y)) 5
        :else 0)))
