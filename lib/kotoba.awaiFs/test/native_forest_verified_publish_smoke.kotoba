(ns native-verified-publish-smoke
 (:capabilities #{:fs/app-data})
 (:require [awai.fs.forest-verified-publish :as publish])
 (:export [main]))
(defn main [] :i64
 (let [bad (publish/publish "SOURCE" 16777219 "PARENT" "gen-bad" "not-a-cid")
       good (publish/publish "SOURCE" 16777219 "PARENT" "gen-good"
                  "bafyreifofrzrmfqc2affepxac6oyi57owuaulr3pvmqi2dftdtfmjtxifq")]
  (cond (not= (record-get [:ref :awai.fs/stage-result] bad :status) 101) 1
        (not= (record-get [:ref :awai.fs/stage-result] good :status) 0) 2
        :else 0)))
