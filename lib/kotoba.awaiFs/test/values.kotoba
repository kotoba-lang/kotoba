(ns awai.fs.values-test (:require [awai.fs.logical-file :as f] [multiformats.cid-hash :as hash]) (:export [main]))
(defn main [] :i64
  (let [p (f/profile-new 1 "fixed" 8) body (vector-i64 0 255 128)
        row (f/chunk-row 0 3 (hash/cidv1-raw-bytes body))
        version (f/file-new 2 3 p row) badp (f/profile-new 2 "fixed" 8)
        too-many (f/file-new 1 0 p (vector-alloc (* 1025 38)))
        bad-byte (vector-i64 -1) too-large (vector-alloc 131073)]
    (cond (not= (f/verify-leaf row body) :none) 1
          (= (f/verify-leaf row (vector-i64 0 254 128)) :none) 2
          (= (f/verify-leaf row (vector-i64)) :none) 3
          (= (f/verify-leaf (vector-assoc! row 0 -1) body) :none) 4
          (result-ok?-of [:result :vector-i64 :keyword] (f/encode version)) 5
          (result-ok?-of [:result :string :keyword] (f/file-cid version)) 6
          (result-ok?-of [:result :string :keyword] (f/profile-cid badp)) 7
          (result-ok?-of [:result :vector-i64 :keyword] (f/profile-encode badp)) 8
          (result-ok?-of [:result :vector-i64 :keyword] (f/encode too-many)) 9
          (result-ok?-of [:result [:ref :awai.fs/file] :keyword] (f/decode bad-byte)) 10
          (result-ok?-of [:result [:ref :awai.fs/file] :keyword] (f/decode too-large)) 11
          (result-ok?-of [:result :string :keyword] (f/bytes-cid bad-byte)) 12
          :else 0)))
