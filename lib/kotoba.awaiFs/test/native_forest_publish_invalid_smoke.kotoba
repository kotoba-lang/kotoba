(ns native-publish-invalid-smoke
 (:capabilities #{:fs/app-data})
 (:require [awai.fs.forest-source-stage :as stage])
 (:export [main]))
(defn- bad? [name :string] :bool
 (let [r (stage/publish-new "SOURCE" 1 "PARENT" name)]
  (and (= (record-get [:ref :awai.fs/stage-result] r :status) 1)
       (string=? (record-get [:ref :awai.fs/stage-result] r :path) ""))))
(defn main [] :i64
 (if (and (bad? "") (bad? "gen-") (bad? "../other") (bad? "gen-/escape") (bad? "gen-X")) 0 1))
