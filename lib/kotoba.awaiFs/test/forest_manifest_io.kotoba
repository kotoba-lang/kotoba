;; Native end-to-end sample over the canonical manifest from a real 1 GiB file.
(ns awai.fs.forest-manifest-io
  (:capabilities #{:fs/app-data})
  (:require [awai.fs.logical-file :as logical] [awai.fs.forest-file :as forest]
            [multiformats.sha256 :as sha])
  (:export [main]))
(defn- row-cid [rows :vector-i64 row :i64] :vector-i64
  (loop [i 0 out (vector-alloc 36)]
    (if (= i 36) out
      (recur (+ i 1) (vector-assoc! out i (vector-at rows (+ (* row 38) 2 i)))))))
(defn main [] :i64
  (let [req (string-concat "\u0000FS2\u0000E" (string-concat "/gib-manifest" "\u00000:71783"))
        reply (typed-cap-call :fs/app-data :string :bytes req)
        framed (and (= (bytes-count reply) 71788) (= (bytes-at reply 0) 0) (= (bytes-at reply 1) 70)
                    (= (bytes-at reply 2) 83) (= (bytes-at reply 3) 50) (= (bytes-at reply 4) 0))
        wire (if framed (vector-i64-from-bytes (bytes-slice reply 5 71788)) (vector-i64))
        decoded (logical/decode wire)
        address (logical/bytes-cid wire)]
    (cond (not framed) 1
          (not (result-ok?-of [:result [:ref :awai.fs/file] :keyword] decoded)) 2
          (not (result-ok?-of [:result :string :keyword] address)) 3
          (not (string=? (result-value-of [:result :string :keyword] address "") "bafyreiaxmc5bs3qy42y62gchpmvef3l65ysiygiqadcb54tct7dox5endy")) 4
          :else
          (let [f (result-value-of [:result [:ref :awai.fs/file] :keyword] decoded
                    (logical/file-new 1 0 (logical/profile-new 1 "fixed" 1) (vector-i64)))
                rows (record-get [:ref :awai.fs/file] f :rows)]
            (if (or (not= (record-get [:ref :awai.fs/file] f :size) 1073741824)
                    (not= (vector-count rows) (* 1024 38))) 5
              (let [cid0 (row-cid rows 0) cid16 (row-cid rows 16)
                    a (forest/get-block "/fixture-gib-0" 2655 cid0 2097152 1049000)
                    b (forest/get-block-in-files (typed-list-new [:list :string] "/fixture-gib-0" "/fixture-gib-1")
                                                (vector-i64 2655 2639) cid16 2097152 1049000)]
                (cond (not (result-ok?-of [:result :vector-i64 :keyword] a)) 6
                      (not (result-ok?-of [:result :vector-i64 :keyword] b)) 7
                      (not (string=? (sha/digest-hex (result-value-of [:result :vector-i64 :keyword] a (vector-i64))) "6ffb6ccd5ca18062fb3e6175f6682800e623056b77256e074f1fef9ceb10b900")) 8
                      (not (string=? (sha/digest-hex (result-value-of [:result :vector-i64 :keyword] b (vector-i64))) "ad1925fe80c09fb367e0a7b3630232403b03161c78f50e432b48dc723258f4c0")) 9
                      :else 0)))))))
