(ns native-generation-verify-smoke
 (:capabilities #{:fs/app-data})
 (:require [awai.fs.forest-generation-verify :as generation])
 (:export [main]))
(defn main [] :i64
 (let [cid "bafyreifofrzrmfqc2affepxac6oyi57owuaulr3pvmqi2dftdtfmjtxifq"]
  (cond (not= (generation/verify "GENERATION" cid) 0) 1
        (not= (generation/verify "GENERATION" "not-a-cid") 4) 2
        (not= (generation/verify "bad-path" cid) 1) 3
        :else 0)))
