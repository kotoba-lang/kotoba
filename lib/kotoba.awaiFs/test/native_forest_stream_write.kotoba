;; Synthetic 16 MiB / one Pack streaming fixture. No atomic publication.
(ns awai.fs.native-forest-stream-write
 (:capabilities #{:fs/app-data})
 (:require [awai.fs.forest-stream :as stream] [awai.fs.forest-index-write :as index]
           [multiformats.byte-cid :as hash] [multiformats.cid :as cid])
 (:export [main]))
(defn- block [i :i64] :vector-i64
 (vector-assoc! (vector-alloc 1048576) 0 (+ i 1)))
(defn- copy-at! [dst :vector-i64 at :i64 src :vector-i64] :i64
 (loop [i 0] (if (= i (vector-count src)) 0
  (let [v (vector-assoc! dst (+ at i) (vector-at src i))] (recur (+ i 1))))))
(defn- emit! [v :vector-i64 first :bool] :i64
 (let [n (vector-count v)]
  (loop [at 0]
   (if (= at n) 0
    (let [left (- n at) count (if (> left 262144) 262144 left)
          status (arena-scope
           (let [piece (loop [j 0 out (vector-alloc count)] (if (= j count) out
                         (recur (+ j 1) (vector-assoc! out j (vector-at v (+ at j))))))
                 head (string-to-utf8 (if (and first (= at 0)) "\u0000FS2\u0000Bstream.forest\u0000" "\u0000FS2\u0000Cstream.forest\u0000"))
                 reply (typed-cap-call :fs/app-data-bytes :bytes :bytes (bytes-concat head (bytes-from-vector-i64 piece)))]
            (if (= (bytes-count reply) (+ count 5)) 0 1)))]
     (if (= status 0) (recur (+ at count)) status))))))
(defn- compute-cid! [i :i64 ids :vector-i64] :i64
 (arena-scope (let [c (cid/cid->bytes (hash/cidv1-raw-bytes (block i)))]
   (if (= (vector-count c) 36) (copy-at! ids (* i 36) c) 1))))
(defn- emit-leaf! [i :i64 position :i64 offsets :vector-i64 ids :vector-i64] :i64
 (arena-scope
  (let [expected (loop [j 0 out (vector-alloc 36)]
                  (if (= j 36) out (recur (+ j 1) (vector-assoc! out j (vector-at ids (+ (* i 36) j))))))
        r (stream/checked-block-frame expected (block i))]
   (if (not (result-ok?-of [:result :vector-i64 :keyword] r)) -1
    (let [v (result-value-of [:result :vector-i64 :keyword] r [])
          saved (vector-assoc! offsets i position)]
     (if (= (emit! v false) 0) (vector-count v) -1))))))
(defn main [] :i64
 (let [ids (vector-alloc (* 17 36)) offsets (vector-alloc 17)
       ready (loop [i 0] (if (= i 16) 0 (if (= (compute-cid! i ids) 0) (recur (+ i 1)) 1)))
       leaf-ids (loop [i 0 out (vector-alloc (* 16 36))]
                  (if (= i (* 16 36)) out (recur (+ i 1) (vector-assoc! out i (vector-at ids i)))))
       root-result (stream/root-bytes leaf-ids)
       wrong (stream/checked-block-frame (cid/cid->bytes (hash/cidv1-raw-bytes [1])) [2])
       bad-root (stream/root-bytes [])
       bad-codec (stream/block-frame 999 [1])]
  (if (or (result-ok?-of [:result :vector-i64 :keyword] wrong)
          (result-ok?-of [:result :vector-i64 :keyword] bad-root)
          (result-ok?-of [:result :vector-i64 :keyword] bad-codec)) 9
  (if (or (not= ready 0) (not (result-ok?-of [:result :vector-i64 :keyword] root-result))) 1
   (let [root (result-value-of [:result :vector-i64 :keyword] root-result [])
         root-cid (cid/cid->bytes (hash/cidv1-dag-cbor-bytes root))
         copied (copy-at! ids (* 16 36) root-cid)
         header (stream/header-frame root) root-frame (stream/block-frame 113 root)]
    (if (or (not= copied 0) (not (result-ok?-of [:result :vector-i64 :keyword] header))
            (not (result-ok?-of [:result :vector-i64 :keyword] root-frame))) 2
     (let [h (result-value-of [:result :vector-i64 :keyword] header [])
           wrote (emit! h true)
           position (if (not= wrote 0) -1
                     (loop [i 0 pos (vector-count h)]
                      (if (= i 16) pos (let [n (emit-leaf! i pos offsets ids)]
                       (if (< n 0) -1 (recur (+ i 1) (+ pos n)))))))]
      (if (< position 0) 3
       (let [r (result-value-of [:result :vector-i64 :keyword] root-frame [])
             saved (vector-assoc! offsets 16 position)
             code (emit! r false)
             ix (index/encode-index ids offsets (+ position (vector-count r)))]
        (if (or (not= code 0) (not (result-ok?-of [:result :vector-i64 :keyword] ix))) 4
         (emit! (result-value-of [:result :vector-i64 :keyword] ix []) false)))))))))))
