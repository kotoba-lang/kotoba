(ns native-forest-commit-recover
 (:capabilities #{:fs/app-data})
 (:require [awai.fs.forest-head :as head])
 (:export [main]))
(defn main [] :i64
 (let [r (head/recover "PARENT" "bafyreifi7jcs6ncvlb65csdwcslxb4rezs7xvm4dfq4bg2zvelch43342q")]
  (if (and (= (record-get [:ref :awai.fs/head-result] r :status) 0)
           (string=? (record-get [:ref :awai.fs/head-result] r :name) "gen-b")) 0 1)))
