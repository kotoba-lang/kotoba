(ns awai.fs.native-logical-commit-test
 (:require [awai.fs.logical-commit :as c] [multiformats.sha256 :as sha]) (:export [main]))
(defn- input [parents :string epoch :string] :string
 (string-concat (string-concat ":epoch " epoch)
  (string-concat ", :format \"kotobase.logical-commit/v1\", :tx-root \"a5dd3faed58f5c3c920c3d1b943c8d3ffc5ce8896103174a58fc4cd0cc2e0de6\", :logical-checkpoint-root \"994bf8778ef21d93f873dd5cfc759a543c0c1fea1066558419933bed649749a9\", :admission-policy-root \"bafyreiadioixzcdfft2cjwm5ic4iozd3y5keuxs2wqto3tqjh2s3hbo3fq\", :model-contract-root \"fixture-model\", :schema-root \"fixture-schema\", :parents " (string-concat parents ", :database-id \"fixture/gib-file\""))))
(defn main [] :i64
 (let [one (c/root (input "[\"bafyreidmrjy3bjb57fbbi7wmyuhmnzomuhati474cmprcfxa6zfm7dj6sm\"]" "2"))
       changed (c/root (input "[\"bafyreidmrjy3bjb57fbbi7wmyuhmnzomuhati474cmprcfxa6zfm7dj6sn\"]" "2"))
       two (c/root (input "[\"a\" \"b\"]" "2")) empty (c/root (input "[\"\"]" "2"))
       zero (c/root (input "[]" "1")) bad-epoch (c/root (input "[]" "9007199254740992"))]
  (cond (not (result-ok?-of [:result :string :keyword] one)) 1
        (not (string=? (result-value-of [:result :string :keyword] one "") "1fb3a3396ad238892be6df1e12f59a4e6866efdcc43ea5c243a6c07db1ee612e")) 2
        (or (not (result-ok?-of [:result :string :keyword] changed)) (string=? (result-value-of [:result :string :keyword] changed "") (result-value-of [:result :string :keyword] one ""))) 3
        (result-ok?-of [:result :string :keyword] two) 4
        (result-ok?-of [:result :string :keyword] empty) 5
        (not (string=? (result-value-of [:result :string :keyword] zero "") "d60510423675d6014c635d309639975bf83f60b0f1b1595a24d613407ffc03aa")) 6
        (result-ok?-of [:result :string :keyword] bad-epoch) 7 :else 0)))
