(ns awai.fs.forest-file-io
  (:capabilities #{:fs/app-data})
  (:require [awai.fs.forest-file :as file] [multiformats.sha256 :as sha])
  (:export [main]))
(defn main [] :i64
  (let [cid (vector-i64 1 85 18 32 136 73 54 132 153 91 229 250 69 98 52 168 104 235 213 131 219 138 28 35 87 88 97 244 25 55 225 77 237 212 236 253)
        found (file/get-block "/fixture" 1767 cid 2097152 524600)
        corrupt (file/get-block "/fixture-corrupt" 1767 cid 2097152 524600)
        short (file/get-block "/fixture-short" 1767 cid 2097152 524600)
        missing (file/get-block "/fixture-missing" 1767 cid 2097152 524600)
        hidden (file/get-block "/fixture-hidden" 1767 cid 2097152 524600)
        footer (file/get-block "/fixture-badfooter" 1767 cid 2097152 524600)
        bad-path (file/get-block "\u0000bad" 1767 cid 2097152 524600)
        bad-cid (file/get-block "/fixture" 1767 (vector-i64 1 85) 2097152 524600)]
    (cond (not (result-ok?-of [:result :vector-i64 :keyword] found)) 1
          (not= (vector-count (result-value-of [:result :vector-i64 :keyword] found (vector-i64))) 65536) 2
          (not (string=? (sha/digest-hex (result-value-of [:result :vector-i64 :keyword] found (vector-i64))) "88493684995be5fa456234a868ebd583db8a1c23575861f41937e14dedd4ecfd")) 3
          (not= (result-error-of [:result :vector-i64 :keyword] corrupt :none) :cid-mismatch) 4
          (not= (result-error-of [:result :vector-i64 :keyword] short :none) :file-size-mismatch) 5
          (not= (result-error-of [:result :vector-i64 :keyword] missing :none) :stat-refused) 10
          (not= (result-error-of [:result :vector-i64 :keyword] hidden :none) :no-candidate) 6
          (not= (result-error-of [:result :vector-i64 :keyword] footer :none) :invalid-footer) 7
          (not= (result-error-of [:result :vector-i64 :keyword] bad-path :none) :invalid-path) 8
          (not= (result-error-of [:result :vector-i64 :keyword] bad-cid :none) :invalid-cid) 9
          :else 0)))
