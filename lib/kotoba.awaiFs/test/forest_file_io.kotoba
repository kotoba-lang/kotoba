(ns awai.fs.forest-file-io
  (:capabilities #{:fs/app-data})
  (:require [awai.fs.forest-file :as file] [multiformats.sha256 :as sha])
  (:export [main]))
(defn main [] :i64
  (let [cid (vector-i64 1 85 18 32 136 73 54 132 153 91 229 250 69 98 52 168 104 235 213 131 219 138 28 35 87 88 97 244 25 55 225 77 237 212 236 253)
        second-cid (vector-i64 1 85 18 32 119 134 193 147 113 246 184 169 72 229 81 98 78 13 210 153 60 166 194 20 57 191 135 111 103 161 72 33 128 123 140 136)
        mega-cid (vector-i64 1 85 18 32 239 37 245 43 222 58 36 49 105 18 242 33 78 23 156 162 229 108 33 231 140 211 234 118 160 98 150 233 111 242 52 158)
        gib0-cid (vector-i64 1 85 18 32 111 251 108 205 92 161 128 98 251 62 97 117 246 104 40 0 230 35 5 107 119 37 110 7 79 31 239 156 235 16 185 0)
        gib1-cid (vector-i64 1 85 18 32 173 25 37 254 128 192 159 179 103 224 167 179 99 2 50 64 59 3 22 28 120 245 14 67 43 72 220 114 50 88 244 192)
        found (file/get-block "/fixture" 1767 cid 2097152 524600)
        second (file/get-block "/fixture-second" 1765 second-cid 2097152 524600)
        large (file/get-block "/fixture-large" 1155199 cid 2097152 524600)
        mega (file/get-block "/fixture-mega" 1048922 mega-cid 2097152 1049000)
        mega-corrupt (file/get-block "/fixture-mega-corrupt" 1048922 mega-cid 2097152 1049000)
        gib0 (file/get-block "/fixture-gib-0" 2655 gib0-cid 2097152 1049000)
        gib1 (file/get-block-in-files (typed-list-new [:list :string] "/fixture-gib-0" "/fixture-gib-1") (vector-i64 2655 2639) gib1-cid 2097152 1049000)
        large-bad (file/get-block "/fixture-large-bad-index" 1155199 cid 2097152 524600)
        over-limit (file/get-block "/fixture-large" 33554433 cid 2097152 524600)
        wrong-file (file/get-block "/fixture" 1767 second-cid 2097152 524600)
        paths (typed-list-new [:list :string] "/fixture" "/fixture-second")
        group (file/get-block-in-files paths (vector-i64 1767 1765) second-cid 2097152 524600)
        group-first (file/get-block-in-files paths (vector-i64 1767 1765) cid 2097152 524600)
        group-miss (file/get-block-in-files (typed-list-new [:list :string] "/fixture") (vector-i64 1767) second-cid 2097152 524600)
        group-corrupt (file/get-block-in-files (typed-list-new [:list :string] "/fixture-corrupt" "/fixture") (vector-i64 1767 1767) cid 2097152 524600)
        group-missing (file/get-block-in-files (typed-list-new [:list :string] "/fixture-missing" "/fixture-second") (vector-i64 1767 1765) second-cid 2097152 524600)
        group-bounds (file/get-block-in-files paths (vector-i64 1767) cid 2097152 524600)
        group-empty (file/get-block-in-files (typed-list-new [:list :string]) (vector-i64) cid 2097152 524600)
        too-many (loop [i 0 xs (typed-list-new [:list :string])]
                   (if (= i 65) xs (recur (+ i 1) (typed-list-conj [:list :string] xs "/fixture"))))
        group-too-many (file/get-block-in-files too-many (vector-alloc 65) cid 2097152 524600)
        corrupt (file/get-block "/fixture-corrupt" 1767 cid 2097152 524600)
        short (file/get-block "/fixture-short" 1767 cid 2097152 524600)
        missing (file/get-block "/fixture-missing" 1767 cid 2097152 524600)
        hidden (file/get-block "/fixture-hidden" 1767 cid 2097152 524600)
        footer (file/get-block "/fixture-badfooter" 1767 cid 2097152 524600)
        bad-path (file/get-block "\u0000bad" 1767 cid 2097152 524600)
        bad-cid (file/get-block "/fixture" 1767 (vector-i64 1 85) 2097152 524600)]
    (cond (not (result-ok?-of [:result :vector-i64 :keyword] found)) 1
          (not= (vector-count (result-value-of [:result :vector-i64 :keyword] found (vector-i64))) 65536) 2
          (not (string=? (sha/digest-hex (result-value-of [:result :vector-i64 :keyword] found (vector-i64))) "88493684995be5fa456234a868ebd583db8a1c23575861f41937e14dedd4ecfd")) 3
          (not= (result-error-of [:result :vector-i64 :keyword] corrupt :none) :cid-mismatch) 4
          (not= (result-error-of [:result :vector-i64 :keyword] short :none) :file-size-mismatch) 5
          (not= (result-error-of [:result :vector-i64 :keyword] missing :none) :stat-refused) 10
          (not= (result-error-of [:result :vector-i64 :keyword] hidden :none) :no-candidate) 6
          (not= (result-error-of [:result :vector-i64 :keyword] footer :none) :invalid-footer) 7
          (not= (result-error-of [:result :vector-i64 :keyword] bad-path :none) :invalid-path) 8
          (not= (result-error-of [:result :vector-i64 :keyword] bad-cid :none) :invalid-cid) 9
          (not (result-ok?-of [:result :vector-i64 :keyword] second)) 11
          (not= (vector-count (result-value-of [:result :vector-i64 :keyword] second (vector-i64))) 65536) 12
          (not (string=? (sha/digest-hex (result-value-of [:result :vector-i64 :keyword] second (vector-i64))) "7786c19371f6b8a948e551624e0dd2993ca6c21439bf876f67a14821807b8c88")) 13
          (not= (result-error-of [:result :vector-i64 :keyword] wrong-file :none) :no-candidate) 14
          (not (result-ok?-of [:result :vector-i64 :keyword] group)) 15
          (not (string=? (sha/digest-hex (result-value-of [:result :vector-i64 :keyword] group (vector-i64))) (sha/digest-hex (result-value-of [:result :vector-i64 :keyword] second (vector-i64))))) 16
          (not (result-ok?-of [:result :vector-i64 :keyword] group-first)) 17
          (not (string=? (sha/digest-hex (result-value-of [:result :vector-i64 :keyword] group-first (vector-i64))) (sha/digest-hex (result-value-of [:result :vector-i64 :keyword] found (vector-i64))))) 18
          (not= (result-error-of [:result :vector-i64 :keyword] group-miss :none) :no-candidate) 19
          (not= (result-error-of [:result :vector-i64 :keyword] group-corrupt :none) :cid-mismatch) 20
          (not= (result-error-of [:result :vector-i64 :keyword] group-missing :none) :stat-refused) 21
          (not= (result-error-of [:result :vector-i64 :keyword] group-bounds :none) :invalid-file-list) 22
          (not= (result-error-of [:result :vector-i64 :keyword] group-empty :none) :invalid-file-list) 23
          (not= (result-error-of [:result :vector-i64 :keyword] group-too-many :none) :invalid-file-list) 24
          (not (result-ok?-of [:result :vector-i64 :keyword] large)) 25
          (not (string=? (sha/digest-hex (result-value-of [:result :vector-i64 :keyword] large (vector-i64))) (sha/digest-hex (result-value-of [:result :vector-i64 :keyword] found (vector-i64))))) 26
          (not= (result-error-of [:result :vector-i64 :keyword] large-bad :none) :invalid-index) 27
          (not= (result-error-of [:result :vector-i64 :keyword] over-limit :none) :invalid-bound) 28
          (not (result-ok?-of [:result :vector-i64 :keyword] mega)) 29
          (not= (vector-count (result-value-of [:result :vector-i64 :keyword] mega (vector-i64))) 1048576) 30
          (not (string=? (sha/digest-hex (result-value-of [:result :vector-i64 :keyword] mega (vector-i64))) "ef25f52bde3a24316912f2214e179ca2e56c21e78cd3ea76a06296e96ff2349e")) 31
          (not= (result-error-of [:result :vector-i64 :keyword] mega-corrupt :none) :cid-mismatch) 32
          (not (result-ok?-of [:result :vector-i64 :keyword] gib0)) 33
          (not= (vector-count (result-value-of [:result :vector-i64 :keyword] gib0 (vector-i64))) 1048576) 34
          (not (string=? (sha/digest-hex (result-value-of [:result :vector-i64 :keyword] gib0 (vector-i64))) "6ffb6ccd5ca18062fb3e6175f6682800e623056b77256e074f1fef9ceb10b900")) 35
          (not (result-ok?-of [:result :vector-i64 :keyword] gib1)) 36
          (not= (vector-count (result-value-of [:result :vector-i64 :keyword] gib1 (vector-i64))) 1048576) 37
          (not (string=? (sha/digest-hex (result-value-of [:result :vector-i64 :keyword] gib1 (vector-i64))) "ad1925fe80c09fb367e0a7b3630232403b03161c78f50e432b48dc723258f4c0")) 38
          :else 0)))
