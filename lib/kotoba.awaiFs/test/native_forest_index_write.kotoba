(ns awai.fs.native-forest-index-write
 (:capabilities #{:fs/app-data})
 (:require [awai.fs.forest-index-write :as writer] [awai.fs.forest-index :as reader])
 (:export [main]))
(defn- cid0 [] :vector-i64 [1 85 18 32 188 169 209 250 125 10 56 26 101 103 75 232 155 150 154 3 62 243 228 208 255 51 19 119 77 3 93 149 5 133 219 74])
(defn- cid1 [] :vector-i64 [1 113 18 32 230 249 161 20 75 22 204 190 139 85 119 127 21 181 216 254 76 135 116 92 218 191 140 125 79 241 68 137 17 0 180 150])
(defn- join [a :vector-i64 b :vector-i64] :vector-i64
 (let [n (vector-count a) m (vector-count b) v (vector-alloc (+ n m))]
  (loop [i 0 out v] (if (= i (+ n m)) out
   (recur (+ i 1) (vector-assoc! out i (if (< i n) (vector-at a i) (vector-at b (- i n)))))))))
(defn main [] :i64
 (let [cids (join (cid0) (cid1)) encoded (writer/encode-index cids [68 1048719] 1048818)]
  (if (not (result-ok?-of [:result :vector-i64 :keyword] encoded)) 1
   (let [tail (result-value-of [:result :vector-i64 :keyword] encoded (vector-i64))
         a (reader/find-frames-tail tail 1048818 (+ 1048818 (vector-count tail)) (cid0))
         b (reader/find-frames-tail tail 1048818 (+ 1048818 (vector-count tail)) (cid1))
         invalid (writer/encode-index cids [0 1048719] 1048818)
         colliding-cid (vector-assoc! (vector-assoc! (cid0) 4 189) 12 100)
         collision (writer/encode-index (join (join (cid0) (cid1)) colliding-cid) [68 200 1048719] 1048818)
         matches (if (result-ok?-of [:result :vector-i64 :keyword] collision)
                   (reader/find-frames-tail (result-value-of [:result :vector-i64 :keyword] collision (vector-i64))
                                           1048818 (+ 1048818 (vector-count (result-value-of [:result :vector-i64 :keyword] collision (vector-i64)))) (cid0))
                   (result-err-of [:result :vector-i64 :keyword] :invalid-index))]
    (if (or (not (result-ok?-of [:result :vector-i64 :keyword] a))
            (not (result-ok?-of [:result :vector-i64 :keyword] b))
            (result-ok?-of [:result :vector-i64 :keyword] invalid)
            (not (result-ok?-of [:result :vector-i64 :keyword] matches))
            (not= (vector-count (result-value-of [:result :vector-i64 :keyword] matches (vector-i64))) 4)
            (not= (vector-at (result-value-of [:result :vector-i64 :keyword] a (vector-i64)) 0) 68)
            (not= (vector-at (result-value-of [:result :vector-i64 :keyword] b (vector-i64)) 0) 1048719)) 2
      (let [head (string-to-utf8 "\u0000FS2\u0000Bindex\u0000")
            reply (typed-cap-call :fs/app-data-bytes :bytes :bytes (bytes-concat head (bytes-from-vector-i64 tail)))]
       (if (= (bytes-count reply) (+ 5 (vector-count tail))) 0 3)))))))
