(ns native-forest-extract-gib
 (:capabilities #{:fs/app-data})
 (:require [awai.fs.source-file :as source] [awai.fs.forest-view :as view])
 (:export [main]))
(defn- emit! [name :string v :vector-i64 first :bool] :i64
 (let [n (vector-count v)]
  (loop [at 0]
   (if (= at n) 0
    (let [left (- n at) count (if (> left 262144) 262144 left)
          status (arena-scope
           (let [piece (loop [j 0 out (vector-alloc count)] (if (= j count) out
                         (recur (+ j 1) (vector-assoc! out j (vector-at v (+ at j))))))
                 h (string-to-utf8 (string-concat (if (and first (= at 0)) "\u0000FS2\u0000B" "\u0000FS2\u0000C") (string-concat name "\u0000")))
                 reply (typed-cap-call :fs/app-data-bytes :bytes :bytes (bytes-concat h (bytes-from-vector-i64 piece)))]
            (if (and (= (bytes-count reply) (+ count 5)) (= (bytes-at reply 0) 0)
                     (= (bytes-at reply 1) 70) (= (bytes-at reply 2) 83)
                     (= (bytes-at reply 3) 50) (= (bytes-at reply 4) 0)) 0 1)))]
     (if (= status 0) (recur (+ at count)) status))))))
(defn- extract-one [wire :vector-i64 i :i64] :i64
 (arena-scope
  (let [path (string-concat "PARENT/gen-gib/pack-" (string-from-i64 (quot i 16)))
        st (source/regular-size path)]
   (if (not (result-ok?-of [:result :i64 :keyword] st)) 10
    (let [n (result-value-of [:result :i64 :keyword] st -1)
          r (view/read-chunk wire "bafyreidru6ltjx62ydamsef4o6dpxrlzjaavb4nfzxx6xxnzzcgiypmfui" i
                (typed-list-new [:list :string] path) (vector-i64 n) 2097152 1049000)]
     (if (not (result-ok?-of [:result :vector-i64 :keyword] r)) 11
      (emit! "OUTPUT" (result-value-of [:result :vector-i64 :keyword] r (vector-i64)) (= i 0))))))))
(defn main [] :i64
 (let [r (source/read-chunk "PARENT/gen-gib/manifest" 0 71783)]
  (if (not (result-ok?-of [:result :vector-i64 :keyword] r)) 1
   (let [wire (result-value-of [:result :vector-i64 :keyword] r (vector-i64))]
    (loop [i 0] (if (= i 1024) 0
     (let [s (extract-one wire i)] (if (= s 0) (recur (+ i 1)) s))))))))
