;; Fixture key, plaintext data and caller-selected synthetic root.
(ns awai.fs.native-prolly-checkpoint-io
 (:capabilities #{:fs/app-data})
 (:require [awai.fs.basis-publication :as publication] [kotoba.value.native-validate :as native-value] [multiformats.sha256 :as sha] [cbor.value :as value] [awai.fs.basis-snapshot :as snapshot] [awai.fs.basis-checkpoint-tree :as bound] [awai.fs.prolly-checkpoint-tree :as tree] [multiformats.cid :as cid])
 (:export [main]))
(defn- one [path :string] [:list :string] (typed-list-conj [:list :string] (typed-list-new [:list :string]) path))
(defn- proof [] :vector-i64 (vector-i64-from-bytes (string-to-utf8 "{:physical-root \"bafyreidmrjy3bjb57fbbi7wmyuhmnzomuhati474cmprcfxa6zfm7dj6sm\", :root \"d60510423675d6014c635d309639975bf83f60b0f1b1595a24d613407ffc03aa\", :commit {:epoch 1, :format \"kotobase.logical-commit/v1\", :tx-root \"a5dd3faed58f5c3c920c3d1b943c8d3ffc5ce8896103174a58fc4cd0cc2e0de6\", :logical-checkpoint-root \"994bf8778ef21d93f873dd5cfc759a543c0c1fea1066558419933bed649749a9\", :admission-policy-root \"bafyreiadioixzcdfft2cjwm5ic4iozd3y5keuxs2wqto3tqjh2s3hbo3fq\", :model-contract-root \"fixture-model\", :schema-root \"fixture-schema\", :parents [], :database-id \"fixture/gib-file\"}, :issuer \"did:key:fixture-issuer\", :key-id \"fixture-key\", :signature [213 205 44 129 160 24 192 206 131 109 50 182 206 17 141 102 215 217 143 76 156 139 37 109 188 100 107 203 190 44 46 63 245 187 88 99 199 20 247 12 17 111 253 12 218 35 254 124 222 189 242 146 156 49 40 13 81 224 51 96 17 120 115 14]}")))
(defn- pub [] :vector-i64 (vector-i64 237 73 40 198 40 209 194 198 234 233 3 56 144 89 149 97 41 89 39 58 92 99 249 54 54 193 70 20 172 135 55 209))
(defn- manifest-bytes [] :vector-i64
 (let [r (typed-cap-call :fs/app-data :string :bytes (string-concat "\u0000FS2\u0000E" (string-concat "/fixture-execution" "\u00000:642")))]
  (if (and (= (bytes-count r) 647) (= (bytes-at r 0) 0) (= (bytes-at r 1) 70) (= (bytes-at r 2) 83) (= (bytes-at r 3) 50) (= (bytes-at r 4) 0))
   (vector-i64-from-bytes (bytes-slice r 5 647)) [])))
(defn main [] :i64
 (let [manifest (manifest-bytes) manifest-valid (native-value/validate manifest)
       good (tree/root (one "/fixture-prolly") (vector-i64 1438) (cid/cid->bytes "bafyreiboajpomf4kvfh5pv4wx3xzoesvokcki3ekgorkhwvuhzqz3s44le") 2097152 2097152)
       verified (bound/verify-tree (proof) "did:key:fixture-issuer" "fixture-key" (pub) (one "/fixture-prolly") (vector-i64 1438) (cid/cid->bytes "bafyreiboajpomf4kvfh5pv4wx3xzoesvokcki3ekgorkhwvuhzqz3s44le") 2097152 2097152)
       untrusted (bound/verify-tree (proof) "did:key:wrong" "fixture-key" (pub) (one "/fixture-prolly") (vector-i64 1438) (cid/cid->bytes "bafyreiboajpomf4kvfh5pv4wx3xzoesvokcki3ekgorkhwvuhzqz3s44le") 2097152 2097152)
       altered (bound/verify-tree (vector-assoc! (proof) 220 98) "did:key:fixture-issuer" "fixture-key" (pub) (one "/fixture-prolly") (vector-i64 1438) (cid/cid->bytes "bafyreiboajpomf4kvfh5pv4wx3xzoesvokcki3ekgorkhwvuhzqz3s44le") 2097152 2097152)
       snapshot-ok (snapshot/verify-snapshot (proof) "did:key:fixture-issuer" "fixture-key" (pub) "bafyreidmrjy3bjb57fbbi7wmyuhmnzomuhati474cmprcfxa6zfm7dj6sm" (one "/fixture-snapshot") (vector-i64 41181) 2097152 2097152)
       snapshot-missing (snapshot/verify-snapshot (proof) "did:key:fixture-issuer" "fixture-key" (pub) "bafyreidmrjy3bjb57fbbi7wmyuhmnzomuhati474cmprcfxa6zfm7dj6sm" (one "/fixture-missing") (vector-i64 41181) 2097152 2097152)
       snapshot-bad-key (snapshot/verify-snapshot (proof) "did:key:fixture-issuer" "fixture-key" (vector-i64 215 90 152 1 130 177 10 183 213 75 254 211 201 100 7 58 14 225 114 243 218 166 35 37 175 2 26 104 247 7 81 26) "bafyreidmrjy3bjb57fbbi7wmyuhmnzomuhati474cmprcfxa6zfm7dj6sm" (one "/fixture-snapshot") (vector-i64 41181) 2097152 2097152)
       snapshot-wrong (snapshot/verify-snapshot (proof) "did:key:fixture-issuer" "fixture-key" (pub) "bafyreiaexpnbjuvgx4uzb6zmgoeprymcc46rpftepuln6t7urwa2lttkm4" (one "/fixture-snapshot") (vector-i64 41181) 2097152 2097152)
       pub-ok (publication/verify-publication (proof) "did:key:fixture-issuer" "fixture-key" (pub) "68a40080587e7cf2becf4d51f9374207cf4b0c33c273abe257631c665c109774" (one "/fixture-snapshot") (vector-i64 41181) 2097152 2097152)
       wrong-format (snapshot/verify-snapshot-format (proof) "did:key:fixture-issuer" "fixture-key" (pub) "bafyreidmrjy3bjb57fbbi7wmyuhmnzomuhati474cmprcfxa6zfm7dj6sm" (one "/fixture-snapshot") (vector-i64 41181) 2097152 2097152 2)
       pub-bad-physical (publication/verify-publication (vector-assoc! (proof) 27 107) "did:key:fixture-issuer" "fixture-key" (pub) "68a40080587e7cf2becf4d51f9374207cf4b0c33c273abe257631c665c109774" (one "/fixture-snapshot") (vector-i64 41181) 2097152 2097152)
       pub-bad-logical (publication/verify-publication (vector-assoc! (proof) 96 56) "did:key:fixture-issuer" "fixture-key" (pub) "68a40080587e7cf2becf4d51f9374207cf4b0c33c273abe257631c665c109774" (one "/fixture-snapshot") (vector-i64 41181) 2097152 2097152)
       pub-bad (publication/verify-publication (proof) "did:key:fixture-issuer" "fixture-key" (pub) "068a40080587e7cf2becf4d51f9374207cf4b0c33c273abe257631c665c10977" (one "/fixture-snapshot") (vector-i64 41181) 2097152 2097152)
       bad (tree/root (one "/fixture-prolly-bad") (vector-i64 1087) (cid/cid->bytes "bafyreihm5mmdalgjj53fkb7dbo5d7tdlfvrdegu37vo6zlgks367kfwetm") 2097152 2097152)]
  (cond (not (result-ok?-of [:result :string :keyword] good)) 1
        (not (string=? (result-value-of [:result :string :keyword] good "") "994bf8778ef21d93f873dd5cfc759a543c0c1fea1066558419933bed649749a9")) 2
        (not= (result-error-of [:result :string :keyword] bad :none) :key-range-mismatch) 3
        (not (result-ok?-of [:result :bool :keyword] verified)) 4
        (not= (result-error-of [:result :bool :keyword] untrusted :none) :untrusted-issuer) 5
        (not= (result-error-of [:result :bool :keyword] altered :none) :commit-root-mismatch) 6
        (not (result-ok?-of [:result :bool :keyword] snapshot-ok)) 7
        (not= (result-error-of [:result :bool :keyword] snapshot-wrong :none) :untrusted-physical-root) 8
        (not (snapshot/supported-schema? (value/int-value 2))) 9
        (snapshot/supported-schema? (value/int-value 1)) 10
        (snapshot/supported-schema? (value/int-value 3)) 11
        (snapshot/supported-schema? (value/text-value "2")) 12
        (result-ok?-of [:result :bool :keyword] snapshot-missing) 13
        (not= (result-error-of [:result :bool :keyword] snapshot-bad-key :none) :invalid-signature) 14
        (not (result-ok?-of [:result :bool :keyword] pub-ok)) 15
        (not= (result-error-of [:result :bool :keyword] pub-bad :none) :untrusted-publication) 16
        (not= (result-error-of [:result :bool :keyword] wrong-format :none) :publication-format-mismatch) 17
        (not= (result-error-of [:result :bool :keyword] pub-bad-physical :none) :untrusted-publication) 18
        (not= (result-error-of [:result :bool :keyword] pub-bad-logical :none) :untrusted-publication) 19
        (not (string=? (sha/digest-hex manifest) "6d2aae91a0149616d57c700967227e94586ffd32621dbed49cd728bdb5958371")) 20
        (not (result-ok?-of [:result :bool :keyword] manifest-valid)) 21
        :else 0)))
