;; Opt-in Native 1 GiB selected-block verification, against a pinned logical root.
(ns awai.fs.forest-gib-full
  (:capabilities #{:fs/app-data})
  (:require [awai.fs.logical-file :as logical] [awai.fs.forest-view :as view])
  (:export [main]))
(defn- verify-one [wire :vector-i64 rows :vector-i64 sizes :vector-i64 i :i64] :bool
  (arena-scope
    (let [pack (quot i 16)
          path (string-concat "/gib-base/pack-" (string-from-i64 pack))
          block (view/read-chunk wire "bafyreiaxmc5bs3qy42y62gchpmvef3l65ysiygiqadcb54tct7dox5endy"
                                 i (typed-list-new [:list :string] path) (vector-i64 (vector-at sizes pack))
                                 2097152 1049000)]
      (and (result-ok?-of [:result :vector-i64 :keyword] block)
           (= (vector-count (result-value-of [:result :vector-i64 :keyword] block (vector-i64)))
              (vector-at rows (+ (* i 38) 1)))))))
(defn main [] :i64
  (let [req (string-concat "\u0000FS2\u0000E" (string-concat "/gib-manifest" "\u00000:71783"))
        reply (typed-cap-call :fs/app-data :string :bytes req)
        framed (and (= (bytes-count reply) 71788) (= (bytes-at reply 0) 0) (= (bytes-at reply 1) 70)
                    (= (bytes-at reply 2) 83) (= (bytes-at reply 3) 50) (= (bytes-at reply 4) 0))
        wire (if framed (vector-i64-from-bytes (bytes-slice reply 5 71788)) (vector-i64))
        decoded (logical/decode wire) address (logical/bytes-cid wire)
        sizes (vector-i64 2655 2639 2639 2639 2639 2639 2646 2655 2655 2646 2639 2639 2671 2639 2639 2638 2671 2655 2639 2655 2639 2639 2646 2639 2639 2639 2639 2655 2671 2639 2662 2654 2655 2639 2671 2662 2639 2639 2639 2655 2639 2687 2687 2703 2639 2639 2671 2638 2671 2639 2639 2655 2671 2671 2639 2655 2639 2646 2703 2687 2655 2639 2655 2638)]
    (cond (not framed) 1
          (not (result-ok?-of [:result [:ref :awai.fs/file] :keyword] decoded)) 2
          (not (result-ok?-of [:result :string :keyword] address)) 3
          (not (string=? (result-value-of [:result :string :keyword] address "") "bafyreiaxmc5bs3qy42y62gchpmvef3l65ysiygiqadcb54tct7dox5endy")) 4
          :else (let [f (result-value-of [:result [:ref :awai.fs/file] :keyword] decoded
                         (logical/file-new 1 0 (logical/profile-new 1 "fixed" 1) (vector-i64)))
                      rows (record-get [:ref :awai.fs/file] f :rows)]
                  (if (or (not= (record-get [:ref :awai.fs/file] f :size) 1073741824)
                          (not= (vector-count rows) (* 1024 38))) 5
                    (loop [i 0]
                      (if (= i 1024) 0
                        (if (verify-one wire rows sizes i) (recur (+ i 1)) (+ 10 (quot i 16))))))))))
