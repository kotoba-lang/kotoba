(ns awai.fs.native-value-validate
 (:require [kotoba.value.native-validate :as canonical])
 (:export [main]))
(defn main [] :i64
 (let [good (canonical/validate [130 19 130 130 130 5 97 97 130 4 97 98 130 130 5 98 98 98 130 2 7])
       unsorted (canonical/validate [130 19 130 130 130 5 98 98 98 130 2 7 130 130 5 97 97 130 4 97 98])
       duplicate (canonical/validate [130 19 130 130 130 5 97 97 130 4 97 98 130 130 5 97 97 130 2 7])
       nonminimal (canonical/validate [130 24 19 128])
       unsupported (canonical/validate [130 3 72 0 0 0 0 0 0 0 0])
       nested-unsupported (canonical/validate [130 19 129 130 130 5 97 97 130 3 72 0 0 0 0 0 0 0 0])
       set-good (canonical/validate [130 18 130 130 4 97 97 130 4 98 98 98])
       set-unsorted (canonical/validate [130 18 130 130 4 98 98 98 130 4 97 97])
       empty (canonical/validate [130 19 128])]
  (cond (not (result-ok?-of [:result :bool :keyword] good)) 1
        (not (result-ok?-of [:result :bool :keyword] empty)) 2
        (not= (result-error-of [:result :bool :keyword] unsorted :none) :noncanonical-order) 3
        (not= (result-error-of [:result :bool :keyword] duplicate :none) :noncanonical-order) 4
        (not= (result-error-of [:result :bool :keyword] nonminimal :none) :noncanonical-cbor) 5
        (not= (result-error-of [:result :bool :keyword] unsupported :none) :unsupported-type) 6
        (not= (result-error-of [:result :bool :keyword] nested-unsupported :none) :unsupported-type) 7
        (not (result-ok?-of [:result :bool :keyword] set-good)) 8
        (not= (result-error-of [:result :bool :keyword] set-unsorted :none) :noncanonical-order) 9
        :else 0)))
