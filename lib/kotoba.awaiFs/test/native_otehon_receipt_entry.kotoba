;; Fixed hosted receipt commit: follow its novelty-back CID through Native Forest.
(ns awai.fs.native-otehon-receipt-entry
  (:capabilities #{:fs/app-data})
  (:require [awai.fs.forest-file :as forest] [multiformats.cid :as cid]
            [multiformats.byte-cid :as hash] [cbor.codec :as cbor] [cbor.value :as value]
            [deflate.bit-reader :as bits] [deflate.huffman-reader :as huffman])
  (:export [main]))
(defn- field [m [:ref :cbor/value] name :string] [:ref :cbor/value]
 (if (not= (value/kind m) :map) (value/null-value)
  (let [xs (value/children m) n (vector-count xs)]
   (loop [i 0]
    (if (>= i n) (value/null-value)
     (let [k (typed-list-nth [:list [:ref :cbor/value]] xs i)]
      (if (and (= (value/kind k) :text) (string=? (value/text k) name))
       (typed-list-nth [:list [:ref :cbor/value]] xs (+ i 1)) (recur (+ i 2)))))))))
(defn- link-bytes [tag [:ref :cbor/value]] :vector-i64
 (let [xs (value/children tag)]
  (if (or (not= (value/kind tag) :tag) (not= (value/number tag) 42) (not= (vector-count xs) 1)) []
   (let [item (typed-list-nth [:list [:ref :cbor/value]] xs 0) b (value/data item)]
    (if (or (not= (value/kind item) :bytes) (not= (vector-count b) 37) (not= (vector-at b 0) 0)) []
     (loop [i 1 out (vector-alloc 36)]
      (if (= i 37) out (recur (+ i 1) (vector-assoc! out (- i 1) (vector-at b i))))))))))
(defn- same? [a :vector-i64 b :vector-i64] :bool
 (and (= (vector-count a) (vector-count b))
  (loop [i 0] (if (= i (vector-count a)) true
   (and (= (vector-at a i) (vector-at b i)) (recur (+ i 1)))))))
(defn- verify-dynamic [data :vector-i64] :bool
 (let [order (vector-i64 16 17 18 0 8 7 9 6 10 5 11 4 12 3 13 2 14 1 15)
       lengths (loop [i 0 out (vector-alloc 19)]
                 (if (= i 14) out
                  (let [r (bits/read-bits data (+ 41 (* i 3)) 3)]
                   (if (not (result-ok?-of [:result [:ref :deflate/read] :keyword] r)) []
                    (recur (+ i 1) (vector-assoc! out (vector-at order i)
                     (record-get [:ref :deflate/read] (result-value-of [:result [:ref :deflate/read] :keyword] r (record-new [:ref :deflate/read] 0 0)) :value)))))))
       symbol (huffman/decode-symbol lengths data 83)]
  (and (result-ok?-of [:result [:ref :deflate/symbol] :keyword] symbol)
       (= (record-get [:ref :deflate/symbol] (result-value-of [:result [:ref :deflate/symbol] :keyword] symbol (record-new [:ref :deflate/symbol] -1 -1)) :symbol) 0)
       (= (record-get [:ref :deflate/symbol] (result-value-of [:result [:ref :deflate/symbol] :keyword] symbol (record-new [:ref :deflate/symbol] -1 -1)) :next) 86))))
(defn- verify-novelty [paths [:list :string] sizes :vector-i64 wire :vector-i64] :i64
 (let [d (cbor/decode-checked wire)]
  (if (not (result-ok?-of [:result [:ref :cbor/value] :keyword] d)) 13
   (let [node (result-value-of [:result [:ref :cbor/value] :keyword] d (value/null-value))
         es (field node "es") xs (value/children es)]
    (if (or (not= (value/kind es) :array) (not= (vector-count xs) 1)
            (not= (value/kind (field node "rest")) :null)) 14
     (let [entry (typed-list-nth [:list [:ref :cbor/value]] xs 0)
           linked (link-bytes (field entry "e"))
           expected "bafyreid6kp4ddbx772k7eje6ywjrpliitao247bfxnteuprlgdml4vbixy"]
      (if (not (same? linked (cid/cid->bytes expected))) 15
       (let [r (forest/get-block-in-files paths sizes linked 2097152 2097152)]
        (if (not (result-ok?-of [:result :vector-i64 :keyword] r)) 16
         (let [b (result-value-of [:result :vector-i64 :keyword] r []) x (cbor/decode-checked b)]
          (if (or (not= (vector-count b) 655) (not (string=? expected (hash/cidv1-dag-cbor-bytes b)))
                  (not (result-ok?-of [:result [:ref :cbor/value] :keyword] x))) 17
           (let [node2 (result-value-of [:result [:ref :cbor/value] :keyword] x (value/null-value)) ct (field node2 "ct")]
            (if (or (not= (value/kind ct) :bytes) (not= (vector-count (value/data ct)) 648)) 18
             (let [data (value/data ct) final (bits/read-bits data 24 1) typ (bits/read-bits data 25 2)]
              (if (and (= (vector-at data 0) 1) (= (vector-at data 1) 120) (= (vector-at data 2) 1)
                       (result-ok?-of [:result [:ref :deflate/read] :keyword] final)
                       (result-ok?-of [:result [:ref :deflate/read] :keyword] typ)
                       (= (record-get [:ref :deflate/read] (result-value-of [:result [:ref :deflate/read] :keyword] final (record-new [:ref :deflate/read] 0 0)) :value) 1)
                       (= (record-get [:ref :deflate/read] (result-value-of [:result [:ref :deflate/read] :keyword] typ (record-new [:ref :deflate/read] 0 0)) :value) 2)
                       (verify-dynamic data)) 0 19)))))))))))))
))
(defn main [] :i64
 (let [target "bafyreif44qzkubrjm2t7sk3v6nfhchpgw52ef7siizxaeqcfnlzadufcya"
       sizes (vector-i64 41181 2125 2125 2125 2125 2125 2125 2157 2125 2125 2125 2141 2141 2125 2125 2140 2141 2125 2141 2141 2125 2141 2125 2125 2125 2141 2157 2141 2125 2173 2124 2125 2157 2157 2125 2125 2125 2157 2141 2141 2189 2125 2141 2125 2125 2172 2125 2125 2141 2173 2141 2125 2125 2125 2157 2205 2157 2125 2141 2141 2715)
       paths (loop [i 0 xs (typed-list-new [:list :string])]
               (if (= i 61) xs (recur (+ i 1) (typed-list-conj [:list :string] xs (string-concat "/receipt/pack-" (string-from-i64 i))))))
       first (forest/get-block-in-files paths sizes (cid/cid->bytes target) 2097152 2097152)]
  (if (not (result-ok?-of [:result :vector-i64 :keyword] first)) 7
   (let [b (result-value-of [:result :vector-i64 :keyword] first [])]
    (if (or (not= (vector-count b) 112) (not (string=? target (hash/cidv1-dag-cbor-bytes b)))) 8
     (let [decoded (cbor/decode-checked b)]
      (if (not (result-ok?-of [:result [:ref :cbor/value] :keyword] decoded)) 9
       (let [node (result-value-of [:result [:ref :cbor/value] :keyword] decoded (value/null-value))
             linked (link-bytes (field (field node "state") "novelty-back"))]
        (if (or (not (same? linked (cid/cid->bytes "bafyreighh56nt2xygosck7yvubnax2pqlashxinaw6k5v4ihkefbi6nneq")))
                (not= (vector-count (link-bytes (field (field node "state") "novelty-missing"))) 0)) 10
         (let [next (forest/get-block-in-files paths sizes linked 2097152 2097152)]
          (if (not (result-ok?-of [:result :vector-i64 :keyword] next)) 11
           (let [v (result-value-of [:result :vector-i64 :keyword] next [])]
            (if (and (= (vector-count v) 55) (string=? (hash/cidv1-dag-cbor-bytes v) "bafyreighh56nt2xygosck7yvubnax2pqlashxinaw6k5v4ihkefbi6nneq")) (verify-novelty paths sizes v) 12)))))))))))
)
)
