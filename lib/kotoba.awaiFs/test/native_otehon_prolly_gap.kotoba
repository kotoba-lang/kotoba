;; Fixture-specific traversal, not an authenticated catalog or general query.
(ns awai.fs.native-otehon-prolly-gap
 (:capabilities #{:fs/app-data})
 (:require [awai.fs.forest-file :as forest] [multiformats.cid :as cid]
           [multiformats.byte-cid :as hash] [multiformats.sha256 :as sha]
           [cbor.codec :as cbor] [cbor.value :as value] [zstd.literal-header :as literals]
           [zstd.fse-description :as fse] [zstd.fse-weights :as weights] [zstd.frame-header :as zstd]
           [zstd.huffman-tree :as tree] [zstd.huffman-literals :as hl] [zstd.sequence-offset :as seq] [zstd.forest-frame :as ff])
 (:export [main]))
(defn- child [v [:ref :cbor/value] i :i64] [:ref :cbor/value]
 (if (and (= (value/kind v) :array) (>= i 0) (< i (vector-count (value/children v))))
  (typed-list-nth [:list [:ref :cbor/value]] (value/children v) i) (value/null-value)))
(defn- field [m [:ref :cbor/value] key :string] [:ref :cbor/value]
 (if (not= (value/kind m) :map) (value/null-value)
  (let [xs (value/children m) n (vector-count xs)]
   (loop [i 0] (if (>= i n) (value/null-value)
    (let [k (typed-list-nth [:list [:ref :cbor/value]] xs i)]
     (if (and (= (value/kind k) :text) (string=? (value/text k) key))
      (typed-list-nth [:list [:ref :cbor/value]] xs (+ i 1)) (recur (+ i 2)))))))))
(defn- same? [a :vector-i64 b :vector-i64] :bool
 (and (= (vector-count a) (vector-count b))
  (loop [i 0] (if (= i (vector-count a)) true (and (= (vector-at a i) (vector-at b i)) (recur (+ i 1)))))))
(defn- link-matches? [x [:ref :cbor/value] expected :string] :bool
 (let [xs (value/children x)]
  (if (or (not= (value/kind x) :tag) (not= (value/number x) 42) (not= (vector-count xs) 1)) false
   (let [b (typed-list-nth [:list [:ref :cbor/value]] xs 0) wire (value/data b) raw (cid/cid->bytes expected)]
    (and (= (value/kind b) :bytes) (= (vector-count wire) (+ 1 (vector-count raw))) (= (vector-at wire 0) 0)
         (loop [i 0] (if (= i (vector-count raw)) true
          (and (= (vector-at wire (+ i 1)) (vector-at raw i)) (recur (+ i 1))))))))))
(defn- node [paths [:list :string] sizes :vector-i64 id :string n :i64] [:ref :cbor/value]
 (let [r (forest/get-block-in-files paths sizes (cid/cid->bytes id) 2097152 2097152)]
  (if (not (result-ok?-of [:result :vector-i64 :keyword] r)) (value/null-value)
   (let [b (result-value-of [:result :vector-i64 :keyword] r []) d (cbor/decode-checked b)]
    (if (and (= (vector-count b) n) (string=? (hash/cidv1-dag-cbor-bytes b) id)
             (result-ok?-of [:result [:ref :cbor/value] :keyword] d))
     (result-value-of [:result [:ref :cbor/value] :keyword] d (value/null-value)) (value/null-value))))))
(defn- tagged-text? [v [:ref :cbor/value] expected :string] :bool
 (let [t (child v 0) x (child v 1)]
  (and (= (value/kind v) :array) (= (vector-count (value/children v)) 2)
       (= (value/kind t) :int) (= (value/number t) 4) (= (value/kind x) :text) (string=? (value/text x) expected))))
(defn- entry? [entry [:ref :cbor/value] key-sha :string a :string b :string c :string] :bool
 (let [key (child entry 0) payload (child entry 1) d (cbor/decode-checked (value/data payload))]
  (if (or (not= (value/kind entry) :array) (not= (vector-count (value/children entry)) 2)
          (not= (value/kind key) :text) (not= (value/kind payload) :bytes)
          (not (string=? (sha/digest-hex (vector-i64-from-bytes (string-to-utf8 (value/text key)))) key-sha))
          (not (result-ok?-of [:result [:ref :cbor/value] :keyword] d))) false
   (let [v (result-value-of [:result [:ref :cbor/value] :keyword] d (value/null-value)) tag (child v 0) items (child v 1)]
    (and (= (value/kind v) :array) (= (vector-count (value/children v)) 2)
         (= (value/kind tag) :int) (= (value/number tag) 16)
         (= (value/kind items) :array) (= (vector-count (value/children items)) 3)
         (tagged-text? (child items 0) a) (tagged-text? (child items 1) b) (tagged-text? (child items 2) c))))))
(defn- selected-frame [] :vector-i64
 (let [r (typed-cap-call :fs/app-data :string :bytes "\u0000FS2\u0000E/receipt/pack-0\u0000235:355")]
  (if (and (= (bytes-count r) 360) (= (bytes-at r 0) 0) (= (bytes-at r 1) 70)
           (= (bytes-at r 2) 83) (= (bytes-at r 3) 50) (= (bytes-at r 4) 0))
   (vector-i64-from-bytes (bytes-slice r 5 360)) [])))
(defn- literal-only-frame [frame :vector-i64] :vector-i64
 (if (< (vector-count frame) 270) []
  (let [v (loop [i 0 out (vector-alloc 271)]
            (if (= i 270) out (recur (+ i 1) (vector-assoc! out i (vector-at frame i)))))]
   (vector-assoc! (vector-assoc! (vector-assoc! (vector-assoc! v 6 53) 7 8) 8 0) 270 0))))
(defn- corrupt-offset [v :vector-i64] :vector-i64
 (if (< (vector-count v) 273) []
  (let [out (loop [i 0 x (vector-alloc (vector-count v))]
              (if (= i (vector-count v)) x (recur (+ i 1) (vector-assoc! x i (vector-at v i)))))]
   (vector-assoc! out 272 255))))
(defn main [] :i64
 (let [sizes (vector-i64 41181 2125 2125 2125 2125 2125 2125 2157 2125 2125 2125 2141 2141 2125 2125 2140 2141 2125 2141 2141 2125 2141 2125 2125 2125 2141 2157 2141 2125 2173 2124 2125 2157 2157 2125 2125 2125 2157 2141 2141 2189 2125 2141 2125 2125 2172 2125 2125 2141 2173 2141 2125 2125 2125 2157 2205 2157 2125 2141 2141 2715)
       paths (loop [i 0 xs (typed-list-new [:list :string])]
               (if (= i 61) xs (recur (+ i 1) (typed-list-conj [:list :string] xs (string-concat "/receipt/pack-" (string-from-i64 i))))))
       root-id "bafyreidmrjy3bjb57fbbi7wmyuhmnzomuhati474cmprcfxa6zfm7dj6sm"
       snap-id "bafyreiaexpnbjuvgx4uzb6zmgoeprymcc46rpftepuln6t7urwa2lttkm4"
       leaf-id "bafyreib6fa5qlo4akgowy2ivxcdvop5mxd3zbjnjvgdic2qckoqkxqxrwi"
       root (node paths sizes root-id 362) snap (node paths sizes snap-id 176)
       leaf (forest/get-block-in-files paths sizes (cid/cid->bytes leaf-id) 2097152 2097152)]
  (cond (not (string=? (value/text (field root "engine")) "kotobase-engine-prolly")) 1
        (not (link-matches? (field root "snapshot") snap-id)) 2
        (not (link-matches? (field (field snap "index-roots") "spo") leaf-id)) 3
        (not (result-ok?-of [:result :vector-i64 :keyword] leaf)) 4
        (not (string=? (hash/cidv1-dag-cbor-bytes (result-value-of [:result :vector-i64 :keyword] leaf [])) leaf-id)) 5
        :else (let [frame (selected-frame) header (literals/parse frame 9 (vector-count frame) 131072)
                    leaf-bytes (result-value-of [:result :vector-i64 :keyword] leaf [])
                    leaf-cbor (cbor/decode-checked leaf-bytes)
                    desc (fse/parse-weights frame 13 69)
                    parsed (result-value-of [:result [:ref :zstd/fse-description] :keyword] desc (record-new [:ref :zstd/fse-description] [] 0 0))
                    table (zstd/fse-table (record-get [:ref :zstd/fse-description] parsed :counts) 5)
                    decoded (weights/decode frame 13 69)
                    tree-result (tree/complete (result-value-of [:result :vector-i64 :keyword] decoded []))
                    tree-value (result-value-of [:result [:ref :zstd/huffman-tree] :keyword] tree-result (record-new [:ref :zstd/huffman-tree] [] 0))
                    literal-result (hl/decode-four frame 69 270 270 tree-value)
                    extended-frame (ff/decode-frame frame 0 (vector-count frame) 2097152 2097152)
                    bad-offset-frame (ff/decode-frame (corrupt-offset frame) 0 (vector-count frame) 2097152 2097152)
                    offsets (fse/parse-offsets frame 272 352)
                    off-desc (result-value-of [:result [:ref :zstd/fse-description] :keyword] offsets (record-new [:ref :zstd/fse-description] [] 0 0))
                    off-table (zstd/fse-table (record-get [:ref :zstd/fse-description] off-desc :counts) (record-get [:ref :zstd/fse-description] off-desc :accuracy))
                    single (literal-only-frame frame)
                    single-frame (ff/decode-frame single 0 (vector-count single) 2097152 2097152)
                    bad-jump (hl/decode-four (vector-i64 255 255 1 0 1 0 1 1 1 1) 0 10 4 tree-value)
                    bad-marker (hl/decode-four (vector-i64 1 0 1 0 1 0 0 1 1 1) 0 10 4 tree-value)
                    bad-weight (tree/complete (vector-i64 13))
                    bad-tree (tree/complete (vector-i64 2 2))
                    no-marker (weights/decode (vector-assoc! (vector-i64 80 197 166 13 40 59 51 51 211 40 81 176 86 29 241 61 211 121 1 32 126 248 236 155 93 218 182 34 36 196 137 82 210 38 207 165 115 239 180 237 181 39 216 154 122 108 206 142 212 198 16 144 128 150 6 1) 55 0) 0 56)
                    short (weights/decode (vector-i64 80) 0 1)
                    init-short (weights/decode (vector-i64 80 197 166 13 40) 0 5)]
                (cond (not (string=? (sha/digest-hex frame) "94a7ef3e671615b242ba0e4c7ace2fac0fc56a0cfa2fc825d59bd6749b631572")) 6
                      (or (not= (record-get [:ref :zstd/literal-header] header :error) :none)
                          (not= (record-get [:ref :zstd/literal-header] header :regenerated) 270)
                          (not= (record-get [:ref :zstd/literal-header] header :compressed) 258)
                          (not= (record-get [:ref :zstd/literal-header] header :streams) 4)
                          (not= (record-get [:ref :zstd/literal-header] header :tree-mode) :fse)
                          (not= (record-get [:ref :zstd/literal-header] header :tree-bytes) 56)) 7
                      (not (result-ok?-of [:result [:ref :zstd/fse-description] :keyword] desc)) 8
                      (not= (record-get [:ref :zstd/fse-description] parsed :accuracy) 5) 9
                      (not= (record-get [:ref :zstd/fse-description] parsed :next-byte) 17) 10
                      (not (same? (record-get [:ref :zstd/fse-description] parsed :counts) (vector-i64 20 1 5 2 1 2 1))) 11
                      (or (not (result-ok?-of [:result :vector-i64 :keyword] table))
                          (not= (vector-count (result-value-of [:result :vector-i64 :keyword] table [])) 96)) 12
                      (not (result-ok?-of [:result :vector-i64 :keyword] decoded)) 13
                      (not (string=? (sha/digest-hex (result-value-of [:result :vector-i64 :keyword] decoded [])) "bab4c3ac31561350cee85281bdef792da52b828566b8a0c857f3630facdc16e4")) 14
                      (not= (result-error-of [:result :vector-i64 :keyword] no-marker :none) :invalid-stream) 15
                      (not= (result-error-of [:result :vector-i64 :keyword] short :none) :invalid-description) 16
                      (not= (result-error-of [:result :vector-i64 :keyword] init-short :none) :truncated) 17
                      (not (result-ok?-of [:result [:ref :zstd/huffman-tree] :keyword] tree-result)) 18
                      (not= (record-get [:ref :zstd/huffman-tree] tree-value :log) 9) 19
                      (not (string=? (sha/digest-hex (record-get [:ref :zstd/huffman-tree] tree-value :weights)) "1b43db0f11c2b2163d0e44d34e6dbc60cd75585021cebbf869fac529b9170a4c")) 20
                      (not= (result-error-of [:result [:ref :zstd/huffman-tree] :keyword] bad-weight :none) :invalid-weight) 21
                      (not= (result-error-of [:result [:ref :zstd/huffman-tree] :keyword] bad-tree :none) :invalid-tree) 22
                      (not (result-ok?-of [:result :vector-i64 :keyword] literal-result)) 23
                      (not (string=? (sha/digest-hex (result-value-of [:result :vector-i64 :keyword] literal-result [])) "f40a73a2e57d7e14c07c03a28777d8bf1fcb007c67dddd6933b29b8a959c9c13")) 24
                      (not= (result-error-of [:result :vector-i64 :keyword] bad-jump :none) :invalid-bound) 25
                      (not= (result-error-of [:result :vector-i64 :keyword] bad-marker :none) :invalid-stream) 26
                      (not= (record-get [:ref :zstd/frame-output] extended-frame :error) :none) 27
                      (not= (record-get [:ref :zstd/frame-output] single-frame :error) :none) 28
                      (not (string=? (sha/digest-hex (record-get [:ref :zstd/frame-output] single-frame :bytes)) "f40a73a2e57d7e14c07c03a28777d8bf1fcb007c67dddd6933b29b8a959c9c13")) 29
                      (not (result-ok?-of [:result [:ref :zstd/fse-description] :keyword] offsets)) 30
                      (not= (record-get [:ref :zstd/fse-description] off-desc :accuracy) 5) 31
                      (not= (record-get [:ref :zstd/fse-description] off-desc :next-byte) 277) 32
                      (not (same? (record-get [:ref :zstd/fse-description] off-desc :counts) (vector-i64 1 0 0 0 1 10 5 8 7))) 33
                      (not (result-ok?-of [:result :vector-i64 :keyword] off-table)) 34
                      (not= (record-get [:ref :zstd/frame-output] bad-offset-frame :error) :accuracy-limit) 35
                      (not= (vector-count leaf-bytes) 637) 36
                      (not (result-ok?-of [:result [:ref :cbor/value] :keyword] leaf-cbor)) 37
                      :else 0)))))
