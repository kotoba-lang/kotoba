       trusted (vector-i64 237 73 40 198 40 209 194 198 234 233 3 56 144 89 149 97 41 89 39 58 92 99 249 54 54 193 70 20 172 135 55 209)
       proof-wire (result-value-of [:result :vector-i64 :keyword] proof [])
