       changed-proof (verifier/verify (alter proof-wire 220 98) "did:key:fixture-issuer" "fixture-key" trusted)
       wrong-issuer (verifier/verify proof-wire "did:key:other" "fixture-key" trusted)
       proof-sig (sign/verify (record-get [:ref :awai.fs/basis-edn] pv :root) (record-get [:ref :awai.fs/basis-edn] pv :issuer) (record-get [:ref :awai.fs/basis-edn] pv :key) (vector-i64 237 73 40 198 40 209 194 198 234 233 3 56 144 89 149 97 41 89 39 58 92 99 249 54 54 193 70 20 172 135 55 209) (record-get [:ref :awai.fs/basis-edn] pv :signature))
       mutated-sig (sign/verify (record-get [:ref :awai.fs/basis-edn] bv :root) (record-get [:ref :awai.fs/basis-edn] bv :issuer) (record-get [:ref :awai.fs/basis-edn] bv :key) (vector-i64 237 73 40 198 40 209 194 198 234 233 3 56 144 89 149 97 41 89 39 58 92 99 249 54 54 193 70 20 172 135 55 209) (record-get [:ref :awai.fs/basis-edn] bv :signature))
       proof-bad (sign/verify "e60510423675d6014c635d309639975bf83f60b0f1b1595a24d613407ffc03aa" "did:key:fixture-issuer" "fixture-key" (vector-i64 237 73 40 198 40 209 194 198 234 233 3 56 144 89 149 97 41 89 39 58 92 99 249 54 54 193 70 20 172 135 55 209) (vector-i64 213 205 44 129 160 24 192 206 131 109 50 182 206 17 141 102 215 217 143 76 156 139 37 109 188 100 107 203 190 44 46 63 245 187 88 99 199 20 247 12 17 111 253 12 218 35 254 124 222 189 242 146 156 49 40 13 81 224 51 96 17 120 115 14))
       selected (branch/select (fixture-branch) "a")
       child-count (branch/child-count (fixture-branch))
       first-child (branch/child-at (fixture-branch) 0)
       last-child (branch/child-at (fixture-branch) 1)
       outside-child (branch/child-at (fixture-branch) 2)
       corrupt-child (branch/child-at (vector-assoc! (fixture-branch) 32 1) 1)
       leaf (forest/get-block-in-files paths sizes (result-value-of [:result :vector-i64 :keyword] selected []) 2097152 2097152)]
  (cond (not (string=? (value/text (field root "engine")) "kotobase-engine-prolly")) 1
        (not (link-matches? (field root "snapshot") snap-id)) 2
        (not (link-matches? (field (field snap "index-roots") "spo") leaf-id)) 3
        (not (result-ok?-of [:result :vector-i64 :keyword] proof)) 64
        (not (string=? (sha/digest-hex (result-value-of [:result :vector-i64 :keyword] proof [])) "1c25bb7dfceabf199305306c6f40e8f3b0d6b5c516820683a13d661b65ab9a1c")) 65
        (not (result-ok?-of [:result [:ref :awai.fs/basis-edn] :keyword] parsed-proof)) 68
        (not (result-ok?-of [:result :string :keyword] recomputed)) 73
        (not (string=? (result-value-of [:result :string :keyword] recomputed "") (record-get [:ref :awai.fs/basis-edn] pv :root))) 74
        (not (result-ok?-of [:result :string :keyword] tampered-commit)) 75
        (string=? (result-value-of [:result :string :keyword] tampered-commit "") (record-get [:ref :awai.fs/basis-edn] pv :root)) 76
        (not (result-ok?-of [:result :bool :keyword] verified-proof)) 77
        (not= (result-error-of [:result :bool :keyword] changed-proof :none) :commit-root-mismatch) 78
        (not= (result-error-of [:result :bool :keyword] wrong-issuer :none) :untrusted-issuer) 79
        (not (string=? (record-get [:ref :awai.fs/basis-edn] pv :physical) root-id)) 69
        (not= (result-error-of [:result [:ref :awai.fs/basis-edn] :keyword] parsed-bad-number :none) :invalid-signature) 70
        (result-ok?-of [:result [:ref :awai.fs/basis-edn] :keyword] parsed-short) 72
        (not= (result-error-of [:result :bool :keyword] mutated-sig :none) :invalid-signature) 71
        (not (result-ok?-of [:result :bool :keyword] proof-sig)) 66
        (not= (result-error-of [:result :bool :keyword] proof-bad :none) :invalid-signature) 67
        (not (result-ok?-of [:result :vector-i64 :keyword] leaf)) 4
        (not (string=? (hash/cidv1-dag-cbor-bytes (result-value-of [:result :vector-i64 :keyword] leaf [])) leaf-id)) 5
        :else (let [frame (selected-frame) header (literals/parse frame 9 (vector-count frame) 131072)
                    leaf-bytes (result-value-of [:result :vector-i64 :keyword] leaf [])
                    leaf-cbor (cbor/decode-checked leaf-bytes)
                    checkpoint-actual (checkpoint/root leaf-bytes)
                    checkpoint-expected (commit/checkpoint-root (record-get [:ref :awai.fs/basis-edn] pv :commit))
                    checkpoint-changed (checkpoint/root (alter leaf-bytes 223 103))
                    first-rows (checkpoint/add-leaf leaf-bytes (checkpoint/empty-rows))
                    repeat-rows (checkpoint/add-leaf leaf-bytes (result-value-of [:result [:ref :awai.fs/check-rows] :keyword] first-rows (checkpoint/empty-rows)))
                    repeat-digest (checkpoint/digest-rows (result-value-of [:result [:ref :awai.fs/check-rows] :keyword] repeat-rows (checkpoint/empty-rows)))
                    bound (binding/verify-leaf proof-wire leaf-bytes "did:key:fixture-issuer" "fixture-key" trusted)
                    bound-tampered (binding/verify-leaf proof-wire (alter leaf-bytes 223 103) "did:key:fixture-issuer" "fixture-key" trusted)
                    bound-untrusted (binding/verify-leaf proof-wire leaf-bytes "did:key:wrong" "fixture-key" trusted)
                    bound-invalid (binding/verify-leaf proof-wire [] "did:key:fixture-issuer" "fixture-key" trusted)
                    leaf-node (result-value-of [:result [:ref :cbor/value] :keyword] leaf-cbor (value/null-value))
                    entries (field leaf-node "entries") first-entry (child entries 0)
                    first-key (value/text (child first-entry 0))
                    found (prolly/lookup leaf-bytes first-key) absent (prolly/lookup leaf-bytes "not-a-present-key")
                    tree-found (ptree/lookup paths sizes (cid/cid->bytes leaf-id) first-key 2097152 2097152)
                    tree-absent (ptree/lookup paths sizes (cid/cid->bytes leaf-id) "not-a-present-key" 2097152 2097152)
                    expanded-paths (typed-list-conj [:list :string] paths "/receipt/branch")
                    expanded-sizes (loop [i 0 v (vector-alloc 62)] (if (= i 61) (vector-assoc! v 61 319) (recur (+ i 1) (vector-assoc! v i (vector-at sizes i)))))
                    checkpoint-tree (ctree/root paths sizes (cid/cid->bytes leaf-id) 2097152 2097152)
                    two-tree (ctree/root (typed-list-conj [:list :string] (typed-list-new [:list :string]) "/receipt/two-leaf.forest") (vector-i64 1438) (cid/cid->bytes "bafyreiboajpomf4kvfh5pv4wx3xzoesvokcki3ekgorkhwvuhzqz3s44le") 2097152 2097152)
                    bad-range-tree (ctree/root (typed-list-conj [:list :string] (typed-list-new [:list :string]) "/receipt/two-invalid.forest") (vector-i64 1087) (cid/cid->bytes "bafyreihm5mmdalgjj53fkb7dbo5d7tdlfvrdegu37vo6zlgks367kfwetm") 2097152 2097152)
                    incomplete-tree (ctree/root expanded-paths expanded-sizes (cid/cid->bytes "bafyreib2njd3gg5rztukhlqmu26zg2w2mk5dpprc3udmbwdssyx3osmdle") 2097152 2097152)
                    multi-found (ptree/lookup expanded-paths expanded-sizes (cid/cid->bytes "bafyreib2njd3gg5rztukhlqmu26zg2w2mk5dpprc3udmbwdssyx3osmdle") first-key 2097152 2097152)
                    verified-paths (typed-list-conj [:list :string] (typed-list-conj [:list :string] (typed-list-new [:list :string]) "/receipt/branch") "/receipt/pack-0")
                    verified-digests (typed-list-conj [:list :string] (typed-list-conj [:list :string] (typed-list-new [:list :string]) "51514aaadd1de8ed5e8c9c9e8250010d54b8d778d99506547bf140b8e7253368") "5fefcde7d85a4a6a24b526856b2fa7d65561478b839f6ea9161d15608a1fe0b8")
                    verified-found (ptree/lookup-verified verified-paths (vector-i64 319 41181) verified-digests (cid/cid->bytes "bafyreib2njd3gg5rztukhlqmu26zg2w2mk5dpprc3udmbwdssyx3osmdle") first-key 2097152 2097152)
                    archive-ok (forest/verify-archive "/receipt/branch" 319 "51514aaadd1de8ed5e8c9c9e8250010d54b8d778d99506547bf140b8e7253368")
                    archive-wrong (forest/verify-archive "/receipt/branch" 319 "01514aaadd1de8ed5e8c9c9e8250010d54b8d778d99506547bf140b8e7253368")
                    archive-mega (forest/verify-archive "/receipt/mega" 1048922 "ee5c2c5c601e5f24cbf087ac73f8e9cfdd3bfa3002445e426b48a9756e6c0d50")
                    second-entry (child entries 1) second-key (value/text (child second-entry 0))
                    second-found (prolly/lookup leaf-bytes second-key)
