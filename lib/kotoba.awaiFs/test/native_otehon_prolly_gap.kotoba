                    unsorted (branch/select (vector-assoc! (fixture-branch) 71 97) "a")
                    bad-link (branch/select (vector-assoc! (fixture-branch) 32 1) "a")
                    duplicate (prolly/lookup (vector-i64 162 100 107 105 110 100 100 108 101 97 102 103 101 110 116 114 105 101 115 130 130 97 97 65 1 130 97 97 65 2) "a")
                    malformed (prolly/lookup (vector-i64 162 100 107 105 110 100 100 108 101 97 102 103 101 110 116 114 105 101 115 129 130 97 97 97 120) "a")
