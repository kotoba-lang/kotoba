                      (or (not= (record-get [:ref :zstd/literal-header] header :error) :none)
                          (not= (record-get [:ref :zstd/literal-header] header :regenerated) 270)
                          (not= (record-get [:ref :zstd/literal-header] header :compressed) 258)
                          (not= (record-get [:ref :zstd/literal-header] header :streams) 4)
                          (not= (record-get [:ref :zstd/literal-header] header :tree-mode) :fse)
                          (not= (record-get [:ref :zstd/literal-header] header :tree-bytes) 56)) 7
                      (not (result-ok?-of [:result [:ref :zstd/fse-description] :keyword] desc)) 8
                      (not= (record-get [:ref :zstd/fse-description] parsed :accuracy) 5) 9
                      (not= (record-get [:ref :zstd/fse-description] parsed :next-byte) 17) 10
                      (not (same? (record-get [:ref :zstd/fse-description] parsed :counts) (vector-i64 20 1 5 2 1 2 1))) 11
