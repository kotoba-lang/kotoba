;; Fixture-specific traversal, not an authenticated catalog or general query.
(ns awai.fs.native-otehon-prolly-gap
 (:capabilities #{:fs/app-data})
 (:require [awai.fs.forest-file :as forest] [awai.fs.prolly-leaf :as prolly] [awai.fs.prolly-branch :as branch] [awai.fs.prolly-tree :as ptree] [awai.fs.prolly-checkpoint :as checkpoint] [awai.fs.prolly-checkpoint-tree :as ctree] [awai.fs.logical-signature :as sign] [awai.fs.logical-commit :as commit] [awai.fs.basis-edn :as basis] [awai.fs.basis-verify :as verifier] [awai.fs.basis-checkpoint :as binding] [ed25519.selfhost :as ed] [multiformats.cid :as cid]
           [multiformats.byte-cid :as hash] [multiformats.sha256 :as sha]
           [cbor.codec :as cbor] [cbor.value :as value] [zstd.literal-header :as literals]
           [zstd.fse-description :as fse] [zstd.fse-weights :as weights] [zstd.frame-header :as zstd]
           [zstd.huffman-tree :as tree] [zstd.huffman-literals :as hl] [zstd.sequence-offset :as seq] [zstd.forest-frame :as ff])
 (:export [main]))
(defn- child [v [:ref :cbor/value] i :i64] [:ref :cbor/value]
 (if (and (= (value/kind v) :array) (>= i 0) (< i (vector-count (value/children v))))
  (typed-list-nth [:list [:ref :cbor/value]] (value/children v) i) (value/null-value)))
(defn- field [m [:ref :cbor/value] key :string] [:ref :cbor/value]
 (if (not= (value/kind m) :map) (value/null-value)
  (let [xs (value/children m) n (vector-count xs)]
   (loop [i 0] (if (>= i n) (value/null-value)
    (let [k (typed-list-nth [:list [:ref :cbor/value]] xs i)]
     (if (and (= (value/kind k) :text) (string=? (value/text k) key))
      (typed-list-nth [:list [:ref :cbor/value]] xs (+ i 1)) (recur (+ i 2)))))))))
(defn- same? [a :vector-i64 b :vector-i64] :bool
 (and (= (vector-count a) (vector-count b))
  (loop [i 0] (if (= i (vector-count a)) true (and (= (vector-at a i) (vector-at b i)) (recur (+ i 1)))))))
(defn- link-matches? [x [:ref :cbor/value] expected :string] :bool
 (let [xs (value/children x)]
  (if (or (not= (value/kind x) :tag) (not= (value/number x) 42) (not= (vector-count xs) 1)) false
   (let [b (typed-list-nth [:list [:ref :cbor/value]] xs 0) wire (value/data b) raw (cid/cid->bytes expected)]
    (and (= (value/kind b) :bytes) (= (vector-count wire) (+ 1 (vector-count raw))) (= (vector-at wire 0) 0)
         (loop [i 0] (if (= i (vector-count raw)) true
          (and (= (vector-at wire (+ i 1)) (vector-at raw i)) (recur (+ i 1))))))))))
(defn- node [paths [:list :string] sizes :vector-i64 id :string n :i64] [:ref :cbor/value]
 (let [r (forest/get-block-in-files paths sizes (cid/cid->bytes id) 2097152 2097152)]
  (if (not (result-ok?-of [:result :vector-i64 :keyword] r)) (value/null-value)
   (let [b (result-value-of [:result :vector-i64 :keyword] r []) d (cbor/decode-checked b)]
    (if (and (= (vector-count b) n) (string=? (hash/cidv1-dag-cbor-bytes b) id)
             (result-ok?-of [:result [:ref :cbor/value] :keyword] d))
     (result-value-of [:result [:ref :cbor/value] :keyword] d (value/null-value)) (value/null-value))))))
(defn- tagged-text? [v [:ref :cbor/value] expected :string] :bool
 (let [t (child v 0) x (child v 1)]
  (and (= (value/kind v) :array) (= (vector-count (value/children v)) 2)
       (= (value/kind t) :int) (= (value/number t) 4) (= (value/kind x) :text) (string=? (value/text x) expected))))
(defn- entry? [entry [:ref :cbor/value] key-sha :string a :string b :string c :string] :bool
 (let [key (child entry 0) payload (child entry 1) d (cbor/decode-checked (value/data payload))]
  (if (or (not= (value/kind entry) :array) (not= (vector-count (value/children entry)) 2)
          (not= (value/kind key) :text) (not= (value/kind payload) :bytes)
          (not (string=? (sha/digest-hex (vector-i64-from-bytes (string-to-utf8 (value/text key)))) key-sha))
          (not (result-ok?-of [:result [:ref :cbor/value] :keyword] d))) false
   (let [v (result-value-of [:result [:ref :cbor/value] :keyword] d (value/null-value)) tag (child v 0) items (child v 1)]
    (and (= (value/kind v) :array) (= (vector-count (value/children v)) 2)
         (= (value/kind tag) :int) (= (value/number tag) 16)
         (= (value/kind items) :array) (= (vector-count (value/children items)) 3)
         (tagged-text? (child items 0) a) (tagged-text? (child items 1) b) (tagged-text? (child items 2) c))))))
(defn- selected-frame [] :vector-i64
 (let [r (typed-cap-call :fs/app-data :string :bytes "\u0000FS2\u0000E/receipt/pack-0\u0000235:355")]
  (if (and (= (bytes-count r) 360) (= (bytes-at r 0) 0) (= (bytes-at r 1) 70)
           (= (bytes-at r 2) 83) (= (bytes-at r 3) 50) (= (bytes-at r 4) 0))
   (vector-i64-from-bytes (bytes-slice r 5 360)) [])))
(defn- literal-only-frame [frame :vector-i64] :vector-i64
 (if (< (vector-count frame) 270) []
  (let [v (loop [i 0 out (vector-alloc 271)]
            (if (= i 270) out (recur (+ i 1) (vector-assoc! out i (vector-at frame i)))))]
   (vector-assoc! (vector-assoc! (vector-assoc! (vector-assoc! v 6 53) 7 8) 8 0) 270 0))))
(defn- corrupt-offset [v :vector-i64] :vector-i64
 (if (< (vector-count v) 273) []
  (let [out (loop [i 0 x (vector-alloc (vector-count v))]
              (if (= i (vector-count v)) x (recur (+ i 1) (vector-assoc! x i (vector-at v i)))))]
   (vector-assoc! out 272 255))))
(defn- alter [v :vector-i64 pos :i64 byte :i64] :vector-i64
 (if (>= pos (vector-count v)) []
  (let [out (loop [i 0 x (vector-alloc (vector-count v))]
              (if (= i (vector-count v)) x (recur (+ i 1) (vector-assoc! x i (vector-at v i)))))]
   (vector-assoc! out pos byte))))
(defn- fixture-branch [] :vector-i64
 (vector-i64 162 100 107 105 110 100 104 105 110 116 101 114 110 97 108 104 99 104 105 108 100 114 101 110 130 130 97 109 216 42 88 37 0 1 113 18 32 62 40 59 5 187 128 81 157 108 105 21 184 135 87 63 172 184 247 144 165 169 169 134 129 106 2 83 160 171 194 241 178 130 97 122 216 42 88 37 0 1 113 18 32 4 187 218 20 210 166 191 41 144 251 44 51 136 248 225 130 23 61 23 150 100 125 22 223 79 244 141 129 165 206 106 103))
(defn main [] :i64
 (let [sizes (vector-i64 41181 2125 2125 2125 2125 2125 2125 2157 2125 2125 2125 2141 2141 2125 2125 2140 2141 2125 2141 2141 2125 2141 2125 2125 2125 2141 2157 2141 2125 2173 2124 2125 2157 2157 2125 2125 2125 2157 2141 2141 2189 2125 2141 2125 2125 2172 2125 2125 2141 2173 2141 2125 2125 2125 2157 2205 2157 2125 2141 2141 2715)
       paths (loop [i 0 xs (typed-list-new [:list :string])]
               (if (= i 61) xs (recur (+ i 1) (typed-list-conj [:list :string] xs (string-concat "/receipt/pack-" (string-from-i64 i))))))
       root-id "bafyreidmrjy3bjb57fbbi7wmyuhmnzomuhati474cmprcfxa6zfm7dj6sm"
       snap-id "bafyreiaexpnbjuvgx4uzb6zmgoeprymcc46rpftepuln6t7urwa2lttkm4"
       leaf-id "bafyreib6fa5qlo4akgowy2ivxcdvop5mxd3zbjnjvgdic2qckoqkxqxrwi"
       root (node paths sizes root-id 362) snap (node paths sizes snap-id 176)
       proof (forest/get-block-in-files paths sizes (cid/cid->bytes "bafkreia4ew5x37hkx4mzgbjqnrxub2htwdlllriwqidihij5mynwlk42dq") 2097152 2097152)
       parsed-proof (basis/read (result-value-of [:result :vector-i64 :keyword] proof []))
       parsed-bad-number (basis/read (alter (result-value-of [:result :vector-i64 :keyword] proof []) 651 57))
       parsed-short (basis/read (if (= (vector-count (result-value-of [:result :vector-i64 :keyword] proof [])) 884) (vector-take (result-value-of [:result :vector-i64 :keyword] proof []) 883) []))
       parsed-bad-root (basis/read (alter (result-value-of [:result :vector-i64 :keyword] proof []) 86 101))
       parsed-bad-commit (basis/read (alter (result-value-of [:result :vector-i64 :keyword] proof []) 220 98))
       pv (result-value-of [:result [:ref :awai.fs/basis-edn] :keyword] parsed-proof (record-new [:ref :awai.fs/basis-edn] "" "" "" "" "" []))
       bv (result-value-of [:result [:ref :awai.fs/basis-edn] :keyword] parsed-bad-root (record-new [:ref :awai.fs/basis-edn] "" "" "" "" "" []))
       cv (result-value-of [:result [:ref :awai.fs/basis-edn] :keyword] parsed-bad-commit (record-new [:ref :awai.fs/basis-edn] "" "" "" "" "" []))
       recomputed (commit/root (record-get [:ref :awai.fs/basis-edn] pv :commit))
