(ns native-forest-export-smoke
 (:capabilities #{:fs/app-data})
 (:require [awai.fs.forest-export :as export])
 (:export [main]))
(defn main [] :i64
 (let [parent "PARENT" out "OUT" cid "bafyreifi7jcs6ncvlb65csdwcslxb4rezs7xvm4dfq4bg2zvelch43342q"
       a (export/export-new parent cid out "file-test")
       b (export/export-new parent cid out "file-test")
       c (export/export-new parent "" out "file-other")
       d (export/export-new parent cid out "../bad")]
  (if (and (= a 0) (= b 112) (= c 105) (= d 1)) 0 1)))
