;; Native read of the frozen Otehon allow commit CID; physical hints are test inputs.
(ns awai.fs.native-otehon-receipt
  (:capabilities #{:fs/app-data})
  (:require [awai.fs.forest-file :as forest] [multiformats.cid :as cid]
            [multiformats.byte-cid :as hash])
  (:export [main]))
(defn main [] :i64
  (let [target "bafyreif44qzkubrjm2t7sk3v6nfhchpgw52ef7siizxaeqcfnlzadufcya"
        sizes (vector-i64 41181 2125 2125 2125 2125 2125 2125 2157 2125 2125 2125 2141 2141 2125 2125 2140 2141 2125 2141 2141 2125 2141 2125 2125 2125 2141 2157 2141 2125 2173 2124 2125 2157 2157 2125 2125 2125 2157 2141 2141 2189 2125 2141 2125 2125 2172 2125 2125 2141 2173 2141 2125 2125 2125 2157 2205 2157 2125 2141 2141 2715)
        paths (loop [i 0 xs (typed-list-new [:list :string])]
                (if (= i 61) xs
                  (recur (+ i 1) (typed-list-conj [:list :string] xs (string-concat "/receipt/pack-" (string-from-i64 i))))))
        r (forest/get-block-in-files paths sizes (cid/cid->bytes target) 2097152 2097152)]
    (if (not (result-ok?-of [:result :vector-i64 :keyword] r)) 7
      (let [b (result-value-of [:result :vector-i64 :keyword] r (vector-i64))]
        (if (and (= 112 (vector-count b)) (string=? target (hash/cidv1-dag-cbor-bytes b))) 0 8)))))
