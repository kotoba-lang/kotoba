(ns awai.fs.writer-test (:require [ipld.dag-cbor-write :as w]) (:export [main]))
(defn main [] :i64
  (let [a (loop [i 0 out (vector-alloc 70000)]
            (if (= i 70000) out (recur (+ i 1) (vector-assoc! out i (rem i 256)))))
        b (w/append (vector-i64) a)
        changed (vector-assoc! b 1 99)]
    (cond (not= (w/main) 6) 1
          (not= (vector-count b) 70000) 2
          (not= (vector-at changed 1) 99) 3
          (not= (vector-at a 1) 1) 4
          (not= (vector-at b 69999) (rem 69999 256)) 5
          :else 0)))
