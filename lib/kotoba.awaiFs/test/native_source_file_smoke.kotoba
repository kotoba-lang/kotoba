(ns source-adapter-test
 (:capabilities #{:fs/app-data})
 (:require [awai.fs.source-file :as source])
 (:export [main]))
(defn main [] :i64
 (let [path "SOURCE_INPUT_PATH"
       a (source/read-range path 2 3)
       v (result-value-of [:result :vector-i64 :keyword] a (vector-i64))
       bad (source/read-range path -1 1)
       long (source/read-range path 0 262145)
       overflow (source/read-range path 9007199254740991 1)
       invalid (source/read-range "bad\u0000path" 0 1)]
  (cond (not (result-ok?-of [:result :vector-i64 :keyword] a)) 1
        (or (not= (vector-count v) 3) (not= (vector-at v 0) 99) (not= (vector-at v 1) 100) (not= (vector-at v 2) 101)) 2
        (result-ok?-of [:result :vector-i64 :keyword] bad) 3
        (result-ok?-of [:result :vector-i64 :keyword] long) 4
        (result-ok?-of [:result :vector-i64 :keyword] overflow) 5
        (result-ok?-of [:result :vector-i64 :keyword] invalid) 6
        :else 0)))
