(ns awai.fs.native-forest-large-write
 (:capabilities #{:fs/app-data})
 (:require [awai.fs.forest-write :as writer])
 (:export [main]))
(defn- sample [] :vector-i64
 (loop [i 0 out (vector-alloc 1048577)]
  (if (= i 1048577) out
   (recur (+ i 1) (vector-assoc! out i (if (= i 0) 1048576 (rem (+ (* (- i 1) 19) (quot (- i 1) 8191)) 256)))))))
(defn- write-pieces [v :vector-i64] :i64
 (let [n (vector-count v)]
  (loop [at 0]
   (if (= at n) 0
    (let [left (- n at) count (if (> left 262144) 262144 left)
          status (arena-scope
           (let [piece (loop [i 0 out (vector-alloc count)]
                        (if (= i count) out (recur (+ i 1) (vector-assoc! out i (vector-at v (+ at i))))))
                 header (string-to-utf8 (if (= at 0) "\u0000FS2\u0000Blarge.forest\u0000" "\u0000FS2\u0000Clarge.forest\u0000"))
                 reply (typed-cap-call :fs/app-data-bytes :bytes :bytes (bytes-concat header (bytes-from-vector-i64 piece)))]
            (if (= (bytes-count reply) (+ count 5)) 0 1)))]
     (if (= status 0) (recur (+ at count)) status))))))
(defn main [] :i64
 (let [data (sample) old (writer/encode 1 data) large (writer/encode-large 1 data)]
  (cond (result-ok?-of [:result :vector-i64 :keyword] old) 2
        (not (result-ok?-of [:result :vector-i64 :keyword] large)) 3
        :else (write-pieces (result-value-of [:result :vector-i64 :keyword] large [])))))
