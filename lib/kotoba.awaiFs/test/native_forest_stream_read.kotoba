(ns awai.fs.native-forest-stream-read
 (:capabilities #{:fs/app-data})
 (:require [awai.fs.forest-file :as forest] [multiformats.byte-cid :as hash]
           [multiformats.cid :as cid])
 (:export [main]))
(defn- verify [i :i64] :bool
 (arena-scope
  (let [v (vector-assoc! (vector-alloc 1048576) 0 (+ i 1))
        found (forest/get-block "/stream.forest" 2098986 (cid/cid->bytes (hash/cidv1-raw-bytes v)) 2097152 2097152)]
   (if (not (result-ok?-of [:result :vector-i64 :keyword] found)) false
    (let [b (result-value-of [:result :vector-i64 :keyword] found [])]
     (and (= (vector-count b) 1048576)
      (loop [j 0] (if (= j 1048576) true
       (if (= (vector-at v j) (vector-at b j)) (recur (+ j 1)) false)))))))))
(defn main [] :i64
 (loop [i 0] (if (= i 16) 0 (if (verify i) (recur (+ i 1)) (+ 10 i)))))
