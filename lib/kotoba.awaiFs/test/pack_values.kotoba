(ns awai.fs.pack-values (:require [ipld.car.pack :as pack]) (:export [main]))
(defn main [] :i64
  (cond
    (result-ok?-of [:result :vector-i64 :keyword] (pack/encode 2 (vector-i64))) 1
    (result-ok?-of [:result :string :keyword] (pack/root-cid 2 (vector-i64))) 2
    (result-ok?-of [:result :vector-i64 :keyword] (pack/encode 1 (vector-i64 -1))) 3
    (result-ok?-of [:result :vector-i64 :keyword] (pack/encode 1 (vector-i64 2 0))) 4
    (result-ok?-of [:result :vector-i64 :keyword] (pack/encode 1 (vector-i64 1 256))) 5
    (result-ok?-of [:result :vector-i64 :keyword] (pack/encode 1 (vector-alloc 65537))) 6
    (result-ok?-of [:result :string :keyword] (pack/root-cid 1 (vector-alloc 1025))) 7
    (result-ok?-of [:result :vector-i64 :keyword] (pack/encode 1 (vector-alloc 1024))) 8
    :else 0))
