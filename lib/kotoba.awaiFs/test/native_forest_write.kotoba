(ns awai.fs.native-forest-write
 (:capabilities #{:fs/app-data})
 (:require [awai.fs.forest-write :as writer] [awai.fs.forest-index :as index]
           [multiformats.cid :as cid] [multiformats.byte-cid :as hash])
 (:export [main]))
(defn- same? [a :vector-i64 b :vector-i64] :bool
 (and (= (vector-count a) (vector-count b))
  (loop [i 0] (if (= i (vector-count a)) true
   (if (= (vector-at a i) (vector-at b i)) (recur (+ i 1)) false)))))
(defn- sample [] :vector-i64
 (loop [i 0 out (vector-alloc 60000)]
  (if (= i 60000) out (recur (+ i 1) (vector-assoc! out i (rem (+ (* i 19) (quot i 8191)) 256))))))
(defn- flat-sample [v :vector-i64] :vector-i64
 (loop [i 0 out (vector-assoc! (vector-alloc 60001) 0 60000)]
  (if (= i 60000) out (recur (+ i 1) (vector-assoc! out (+ i 1) (vector-at v i))))))
(defn- cloned [v :vector-i64] :vector-i64
 (loop [i 0 out (vector-alloc (vector-count v))]
  (if (= i (vector-count v)) out (recur (+ i 1) (vector-assoc! out i (vector-at v i))))))
(defn main [] :i64
 (let [data [5 104 101 108 108 111 4 0 1 2 255] result (writer/encode 1 data)]
  (if (not (result-ok?-of [:result :vector-i64 :keyword] result)) 1
   (let [forest (result-value-of [:result :vector-i64 :keyword] result (vector-i64))
         a (index/get-indexed-block forest (cid/cid->bytes (hash/cidv1-raw-bytes [104 101 108 108 111])) 65536 65536)
         b (index/get-indexed-block forest (cid/cid->bytes (hash/cidv1-raw-bytes [0 1 2 255])) 65536 65536)
         frame-list (index/find-frames forest (cid/cid->bytes (hash/cidv1-raw-bytes [104 101 108 108 111])))
         frame-pos (vector-at (result-value-of [:result :vector-i64 :keyword] frame-list []) 0)
         changed (+ frame-pos 12)
         corrupted (vector-assoc! (cloned forest) changed (bit-xor 1 (vector-at forest changed)))
         corrupt-read (index/get-indexed-block corrupted (cid/cid->bytes (hash/cidv1-raw-bytes [104 101 108 108 111])) 65536 65536)
         footer (vector-assoc! (cloned forest) (- (vector-count forest) 16) 0)
         footer-read (index/get-indexed-block footer (cid/cid->bytes (hash/cidv1-raw-bytes [104 101 108 108 111])) 65536 65536)
         empty (writer/encode 1 []) bad (writer/encode 1 [2 0 999]) version (writer/encode 2 data)
         maximum (writer/encode 1 (vector-alloc 63)) excessive (writer/encode 1 (vector-alloc 64))
         sample-data (sample) large (writer/encode 1 (flat-sample sample-data))
         large-read (if (result-ok?-of [:result :vector-i64 :keyword] large)
           (index/get-indexed-block (result-value-of [:result :vector-i64 :keyword] large [])
             (cid/cid->bytes (hash/cidv1-raw-bytes sample-data)) 65536 65536)
           (result-err-of [:result :vector-i64 :keyword] :pack-refused))]
    (cond (not (result-ok?-of [:result :vector-i64 :keyword] a)) 2
          (not (result-ok?-of [:result :vector-i64 :keyword] b)) 3
          (not (same? (result-value-of [:result :vector-i64 :keyword] a []) [104 101 108 108 111])) 4
          (not (same? (result-value-of [:result :vector-i64 :keyword] b []) [0 1 2 255])) 5
          (or (result-ok?-of [:result :vector-i64 :keyword] empty)
              (result-ok?-of [:result :vector-i64 :keyword] bad)
              (result-ok?-of [:result :vector-i64 :keyword] version)
              (not (result-ok?-of [:result :vector-i64 :keyword] maximum))
              (result-ok?-of [:result :vector-i64 :keyword] excessive)) 6
          (or (result-ok?-of [:result :vector-i64 :keyword] corrupt-read)
              (result-ok?-of [:result :vector-i64 :keyword] footer-read)) 12
          (not (result-ok?-of [:result :vector-i64 :keyword] large-read)) 9
          (not (same? sample-data (result-value-of [:result :vector-i64 :keyword] large-read []))) 10
          :else (let [head (string-to-utf8 "\u0000FS2\u0000Bnative.forest\u0000")
                      reply (typed-cap-call :fs/app-data-bytes :bytes :bytes (bytes-concat head (bytes-from-vector-i64 forest)))]
                   (if (not= (bytes-count reply) (+ 5 (vector-count forest))) 7
                    (let [v (result-value-of [:result :vector-i64 :keyword] maximum [])
                          req (bytes-concat (string-to-utf8 "\u0000FS2\u0000Bmaximum.forest\u0000") (bytes-from-vector-i64 v))
                          written (typed-cap-call :fs/app-data-bytes :bytes :bytes req)]
                     (if (not= (bytes-count written) (+ 5 (vector-count v))) 8
                      (let [large-bytes (result-value-of [:result :vector-i64 :keyword] large [])
                            large-req (bytes-concat (string-to-utf8 "\u0000FS2\u0000Brandom.forest\u0000") (bytes-from-vector-i64 large-bytes))
                            large-written (typed-cap-call :fs/app-data-bytes :bytes :bytes large-req)]
                       (if (= (bytes-count large-written) (+ 5 (vector-count large-bytes))) 0 11)))))))))))
