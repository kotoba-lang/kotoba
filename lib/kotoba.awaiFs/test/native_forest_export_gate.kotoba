(ns native-forest-export-gate
 (:capabilities #{:fs/app-data})
 (:require [awai.fs.forest-commit :as commit] [awai.fs.forest-export :as export])
 (:export [main]))
(defn main [] :i64
 (let [parent "PARENT" out "OUT" cid "bafyreifi7jcs6ncvlb65csdwcslxb4rezs7xvm4dfq4bg2zvelch43342q"
       a (commit/commit "INPUT" 1 parent "" "" "gen-gate" cid)]
  (if (not= a 0) 1
   (let [b (export/export-new parent cid out "file-gate")
         c (export/export-new parent cid out "file-gate")
         d (export/export-new parent "" out "file-wrong")
         e (export/export-new parent cid out "../bad")]
    (if (and (= b 0) (= c 112) (= d 105) (= e 1)) 0 2)))))
