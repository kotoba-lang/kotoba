;; Local Native provider observation; PATH/SPEC are replaced by the gate.
(ns fs2-range-probe
  (:capabilities #{:fs/app-data})
  (:export [main]))
(defn main [] :i64
  (let [reply (typed-cap-call :fs/app-data :string :bytes "\u0000FS2\u0000E/PATH\u0000SPEC")]
    (if (and (= (bytes-count reply) 6) (= (bytes-at reply 0) 0)
             (= (bytes-at reply 1) 70) (= (bytes-at reply 2) 83)
             (= (bytes-at reply 3) 50) (= (bytes-at reply 4) 0)
             (= (bytes-at reply 5) 65)) 0 7)))
