(ns awai.fs.native-zstd-frame-write
 (:capabilities #{:fs/app-data})
 (:require [zstd.frame-write :as writer] [zstd.frame-header :as reader])
 (:export [main]))
(defn- pattern [n :i64 mode :i64] :vector-i64
 (loop [i 0 v (vector-alloc n)] (if (= i n) v
  (recur (+ i 1) (vector-assoc! v i (if (= mode 0) (rem (+ (* i 19) (quot i 8191)) 256) 42))))))
(defn- equal? [a :vector-i64 b :vector-i64] :bool
 (and (= (vector-count a) (vector-count b))
  (loop [i 0] (if (= i (vector-count a)) true
   (if (= (vector-at a i) (vector-at b i)) (recur (+ i 1)) false)))))
(defn- test-case [n :i64 mode :i64] :bool
 (let [src (pattern n mode) frame (writer/encode-frame src)]
  (if (not (result-ok?-of [:result :vector-i64 :keyword] frame)) false
   (let [v (result-value-of [:result :vector-i64 :keyword] frame (vector-i64))
         decoded (reader/decode-frame v 0 (vector-count v) 2097152 2097152)]
    (and (= (record-get [:ref :zstd/frame-output] decoded :error) :none)
         (= (record-get [:ref :zstd/frame-output] decoded :next) (vector-count v))
         (equal? src (record-get [:ref :zstd/frame-output] decoded :bytes)))))))
(defn- write-case [name :string n :i64 mode :i64] :bool
 (let [frame (writer/encode-frame (pattern n mode))]
  (if (not (result-ok?-of [:result :vector-i64 :keyword] frame)) false
   (let [v (result-value-of [:result :vector-i64 :keyword] frame (vector-i64))
         req (bytes-concat (string-to-utf8 (string-concat "\u0000FS2\u0000B" (string-concat name "\u0000"))) (bytes-from-vector-i64 v))
         reply (typed-cap-call :fs/app-data-bytes :bytes :bytes req)]
    (= (bytes-count reply) (+ 5 (vector-count v)))))))
(defn main [] :i64
 (cond (not (test-case 0 0)) 1
       (not (test-case 1 0)) 2
       (not (test-case 255 0)) 3
       (not (test-case 256 1)) 4
       (not (test-case 131072 0)) 5
       (not (test-case 131073 0)) 6
       (not (test-case 131073 1)) 7
       (result-ok?-of [:result :vector-i64 :keyword] (writer/encode-frame [256])) 8
       (not (test-case 2097152 1)) 11
       (result-ok?-of [:result :vector-i64 :keyword] (writer/encode-frame (vector-alloc 2097153))) 12
       (not (write-case "empty.zst" 0 0)) 13
       (not (write-case "raw.zst" 131073 0)) 9
       (not (write-case "rle.zst" 131073 1)) 10
       :else 0))
