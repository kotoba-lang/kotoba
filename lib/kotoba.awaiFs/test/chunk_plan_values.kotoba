(ns awai.fs.chunk-plan-values
  (:require [awai.fs.chunk-plan :as plan] [awai.fs.logical-file :as f])
  (:export [main]))
(defn main [] :i64
  (let [p (f/profile-new 1 "fixed" 8) bad (f/profile-new 2 "fixed" 8)
        empty (plan/plan 0 p) one (plan/plan 1 p) exact (plan/plan 16 p)
        partial (plan/plan 17 p) max (plan/plan 1024 (f/profile-new 1 "fixed" 1))
        big (plan/plan 17179869184 (f/profile-new 1 "fixed" 16777216))]
    (cond (not (result-ok?-of [:result :vector-i64 :keyword] empty)) 1
          (not (f/same-bytes? (result-value-of [:result :vector-i64 :keyword] empty (vector-i64)) (vector-i64))) 2
          (not (f/same-bytes? (result-value-of [:result :vector-i64 :keyword] one (vector-i64)) (vector-i64 0 0 1))) 3
          (not (f/same-bytes? (result-value-of [:result :vector-i64 :keyword] exact (vector-i64)) (vector-i64 0 0 8 1 8 8))) 4
          (not (f/same-bytes? (result-value-of [:result :vector-i64 :keyword] partial (vector-i64)) (vector-i64 0 0 8 1 8 8 2 16 1))) 5
          (not (result-ok?-of [:result :vector-i64 :keyword] max)) 6
          (not= (vector-count (result-value-of [:result :vector-i64 :keyword] max (vector-i64))) 3072) 7
          (result-ok?-of [:result :vector-i64 :keyword] (plan/plan 1025 (f/profile-new 1 "fixed" 1))) 8
          (result-ok?-of [:result :vector-i64 :keyword] (plan/plan -1 p)) 9
          (result-ok?-of [:result :vector-i64 :keyword] (plan/plan 17179869185 p)) 10
          (result-ok?-of [:result :vector-i64 :keyword] (plan/plan 1 bad)) 11
          (result-ok?-of [:result :vector-i64 :keyword] (plan/plan 1 (f/profile-new 1 "fixed" 0))) 12
          (not (f/same-bytes? (result-value-of [:result :vector-i64 :keyword] (plan/plan 8 p) (vector-i64)) (vector-i64 0 0 8))) 13
          (not (f/same-bytes? (result-value-of [:result :vector-i64 :keyword] (plan/plan 9 p) (vector-i64)) (vector-i64 0 0 8 1 8 1))) 14
          (not (result-ok?-of [:result :vector-i64 :keyword] big)) 15
          (not= (vector-at (result-value-of [:result :vector-i64 :keyword] big (vector-i64)) 3069) 1023) 16
          (not= (vector-at (result-value-of [:result :vector-i64 :keyword] big (vector-i64)) 3070) 17163091968) 17
          (not= (vector-at (result-value-of [:result :vector-i64 :keyword] big (vector-i64)) 3071) 16777216) 18
          :else 0)))
