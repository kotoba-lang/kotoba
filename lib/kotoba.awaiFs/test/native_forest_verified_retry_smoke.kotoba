(ns native-verified-retry-smoke
 (:capabilities #{:fs/app-data})
 (:require [awai.fs.forest-source-stage :as stage])
 (:export [main]))
(defn main [] :i64
 (let [same (stage/publish-verified-retry "SOURCE_A" 16777219 "PARENT" "gen-test")
       different (stage/publish-verified-retry "SOURCE_B" 16777219 "PARENT" "gen-test")]
  (cond (not= (record-get [:ref :awai.fs/stage-result] same :status) 98) 1
        (not= (record-get [:ref :awai.fs/stage-result] different :status) 99) 2
        (or (= (string-length (record-get [:ref :awai.fs/stage-result] same :path)) 0)
            (= (string-length (record-get [:ref :awai.fs/stage-result] different :path)) 0)) 3
        :else 0)))
