(ns native-forest-commit-smoke
 (:capabilities #{:fs/app-data})
 (:require [awai.fs.forest-commit :as commit] [awai.fs.forest-head :as head])
 (:export [main]))
(defn main [] :i64
 (let [a "bafyreifofrzrmfqc2affepxac6oyi57owuaulr3pvmqi2dftdtfmjtxifq"
       b "bafyreifi7jcs6ncvlb65csdwcslxb4rezs7xvm4dfq4bg2zvelch43342q"
       first (commit/commit "SOURCE_A" 16777219 "PARENT" "" "" "gen-a" a)
       stale (commit/commit "SOURCE_B" 1 "PARENT" "" "" "gen-b" b)
       second (commit/commit "SOURCE_B" 1 "PARENT" "gen-a" a "gen-b" b)
       replay (commit/commit "SOURCE_B" 1 "PARENT" "gen-a" a "gen-b" b)
       recovered (head/recover "PARENT" b)]
  (cond (not= first 0) 1 (not= stale 105) 2 (not= second 0) 3
        (not= replay 105) 4 (not= (record-get [:ref :awai.fs/head-result] recovered :status) 0) 5
        (not (string=? (record-get [:ref :awai.fs/head-result] recovered :name) "gen-b")) 6
        :else 0)))
