(ns awai.fs.native-forest-large-read
 (:capabilities #{:fs/app-data})
 (:require [awai.fs.forest-file :as forest] [multiformats.cid :as cid] [multiformats.byte-cid :as hash])
 (:export [main]))
(defn- sample [] :vector-i64
 (loop [i 0 out (vector-alloc 1048576)]
  (if (= i 1048576) out (recur (+ i 1) (vector-assoc! out i (rem (+ (* i 19) (quot i 8191)) 256))))))
(defn main [] :i64
 (let [source (sample) got (forest/get-block "/large.forest" FILESIZE
                (cid/cid->bytes (hash/cidv1-raw-bytes source)) 2097152 2097152)]
  (if (not (result-ok?-of [:result :vector-i64 :keyword] got)) 1
   (let [v (result-value-of [:result :vector-i64 :keyword] got [])]
    (if (not= (vector-count v) (vector-count source)) 2
     (loop [i 0] (if (= i 1048576) 0
      (if (= (vector-at v i) (vector-at source i)) (recur (+ i 1)) 3))))))))
