(ns awai.fs.native-one-parent-basis (:require [awai.fs.basis-edn :as basis] [awai.fs.logical-commit :as commit] [awai.fs.logical-signature :as sign] [awai.fs.basis-verify :as verify] [ed25519.selfhost :as ed] [multiformats.sha256 :as sha]) (:export [main]))
(defn- proof [] :vector-i64 (vector-i64-from-bytes (string-to-utf8 "{:physical-root \"bafyreidmrjy3bjb57fbbi7wmyuhmnzomuhati474cmprcfxa6zfm7dj6sm\", :root \"1fb3a3396ad238892be6df1e12f59a4e6866efdcc43ea5c243a6c07db1ee612e\", :commit {:epoch 2, :format \"kotobase.logical-commit/v1\", :tx-root \"a5dd3faed58f5c3c920c3d1b943c8d3ffc5ce8896103174a58fc4cd0cc2e0de6\", :logical-checkpoint-root \"994bf8778ef21d93f873dd5cfc759a543c0c1fea1066558419933bed649749a9\", :admission-policy-root \"bafyreiadioixzcdfft2cjwm5ic4iozd3y5keuxs2wqto3tqjh2s3hbo3fq\", :model-contract-root \"fixture-model\", :schema-root \"fixture-schema\", :parents [\"bafyreidmrjy3bjb57fbbi7wmyuhmnzomuhati474cmprcfxa6zfm7dj6sm\"], :database-id \"fixture/gib-file\"}, :issuer \"did:key:fixture-issuer\", :key-id \"fixture-key\", :signature [9 128 254 80 142 100 231 112 148 252 98 89 134 193 194 87 120 202 63 77 222 101 119 217 115 165 204 96 253 26 104 35 255 231 85 83 33 119 181 57 170 46 49 19 82 1 85 209 245 192 36 134 19 76 182 197 153 46 11 11 56 72 53 9]}")))
(defn main [] :i64
 (let [pub (vector-i64 237 73 40 198 40 209 194 198 234 233 3 56 144 89 149 97 41 89 39 58 92 99 249 54 54 193 70 20 172 135 55 209) good (verify/verify (proof) "did:key:fixture-issuer" "fixture-key" pub) tampered (verify/verify (vector-assoc! (proof) 546 99) "did:key:fixture-issuer" "fixture-key" pub) wrong (verify/verify (proof) "did:key:fixture-issuer" "wrong-key" pub)]
  (cond (not (result-ok?-of [:result :bool :keyword] good)) 1
        (not= (result-error-of [:result :bool :keyword] tampered :none) :commit-root-mismatch) 2
        (not= (result-error-of [:result :bool :keyword] wrong :none) :untrusted-issuer) 3 :else 0)))
