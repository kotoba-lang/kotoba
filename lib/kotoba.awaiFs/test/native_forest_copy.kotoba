;; Bounded FS2 copy of pre-existing Forest archives into a fresh test scope.
;; This does not generate a Forest archive or publish a durable catalog.
(ns awai.fs.native-forest-copy
  (:capabilities #{:fs/app-data})
  (:export [main]))
(defn- read-chunk [path :string offset :i64 length :i64] :bytes
  (let [req (string-concat "\u0000FS2\u0000E" (string-concat path
                (string-concat "\u0000" (string-concat (string-from-i64 offset) (string-concat ":" (string-from-i64 length))))))]
    (typed-cap-call :fs/app-data :string :bytes req)))
(defn- marker? [b :bytes] :bool
  (and (>= (bytes-count b) 5) (= (bytes-at b 0) 0) (= (bytes-at b 1) 70)
       (= (bytes-at b 2) 83) (= (bytes-at b 3) 50) (= (bytes-at b 4) 0)))
(defn- transfer [src :string dst :string size :i64] :i64
  (loop [offset 0]
    (if (= offset size) 0
      (let [left (- size offset) n (if (> left 262144) 262144 left)
            status (arena-scope
              (let [r (read-chunk src offset n)]
                (if (or (not (marker? r)) (not= (bytes-count r) (+ n 5))) 1
                  (let [head (string-to-utf8 (string-concat (if (= offset 0) "\u0000FS2\u0000B" "\u0000FS2\u0000C") (string-concat dst "\u0000")))
                        request (bytes-concat head (bytes-slice r 5 (+ n 5)))
                        response (typed-cap-call :fs/app-data-bytes :bytes :bytes request)]
                    (if (and (marker? response) (= (bytes-count response) (+ n 5))) 0 2)))))]
        (if (= status 0) (recur (+ offset n)) status)))))
(defn main [] :i64
  (let [first (transfer "/source/pack-0" "pack-0" 16779503)]
    (if (not= first 0) first
      (transfer "/source/pack-1" "pack-1" 1048922))))
