(ns native-forest-head-recover-smoke
 (:capabilities #{:fs/app-data})
 (:require [awai.fs.forest-head :as head])
 (:export [main]))
(defn main [] :i64
 (let [cid "bafyreifofrzrmfqc2affepxac6oyi57owuaulr3pvmqi2dftdtfmjtxifq"
       other "bafyreifi7jcs6ncvlb65csdwcslxb4rezs7xvm4dfq4bg2zvelch43342q"
       good (head/recover "PARENT" cid) wrong (head/recover "PARENT" other)]
  (cond (not= (record-get [:ref :awai.fs/head-result] good :status) 0) 1
        (not (string=? (record-get [:ref :awai.fs/head-result] good :name) "gen-a")) 2
        (not (string=? (record-get [:ref :awai.fs/head-result] good :cid) cid)) 3
        (not= (record-get [:ref :awai.fs/head-result] wrong :status) 105) 4
        :else 0)))
