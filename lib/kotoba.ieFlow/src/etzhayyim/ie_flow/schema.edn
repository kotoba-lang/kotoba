;; ie-flow ontology — the information-energy flow ledger schema. ADR-2606211200.
;; The flow facts live on the kotoba Datom log (EAVT, append-only 非終末論). This is the
;; declared vocabulary; the cljc code is the only writer/reader (lexicon↔code parity).
;; Numbers are stored milli-scaled (×1000, long) for content-address determinism.
{:flow.event   {:doc "a measured atom of information-energy flow (the Sankey backbone)"
                :attrs {:flow.event/id       {:type :string :unique :identity}
                        :flow.event/actor    {:type :string :doc "who moved the energy"}
                        :flow.event/source   {:type :string :doc "node energy left"}
                        :flow.event/target   {:type :string :doc "node energy arrived at"}
                        :flow.event/type     {:type :string :doc "click/run/purchase/publish/…"}
                        :flow.event/volume-milli {:type :long :doc "flow quantity ×1000"}
                        :flow.event/cost-milli   {:type :long :doc "free energy dissipated ×1000"}
                        :flow.event/value-milli  {:type :long :doc "order realised ×1000"}
                        :flow.event/risk-milli   {:type :long :doc "risk/failure load ×1000"}
                        :flow.event/agent    {:type :boolean :doc "an AI-agent edge (→ agent-eff)"}
                        :flow.event/session  {:type :string}
                        :flow.event/as-of    {:type :string :doc "logical time (no wall clock)"}}}
 :flow.node    {:doc "a station in the flow (organism/agent/page/product/fund)"
                :attrs {:flow.node/id   {:type :string :unique :identity}
                        :flow.node/type {:type :string}
                        :flow.node/name {:type :string}
                        :flow.node/as-of {:type :string}}}
 :flow.stock   {:doc "accumulated-order snapshot (subscribers/trust/data-asset/reserves)"
                :attrs {;; dynamic order-name keys :flow.stock/<name>-milli + :flow.stock/as-of
                        :flow.stock/as-of {:type :string}}}
 :flow.intervention {:doc "a 施策 hypothesis the co-scientist pre-registers (dry-run; member-principal outward)"
                     :attrs {:flow.intervention/id        {:type :string :unique :identity}
                             :flow.intervention/type      {:type :string}
                             :flow.intervention/name      {:type :string}
                             :flow.intervention/target    {:type :string}
                             :flow.intervention/hypothesis {:type :string}
                             :flow.intervention/status    {:type :string :doc "dry-run only (G-leash)"}
                             :flow.intervention/as-of     {:type :string}}}
 ;; ── the loop's own cognitive readout (lifecycle.cljc) ──────────────────────
 :ie.flow-state  {:doc "the SENSE state vector folded per beat"
                  :attrs {:flow-state/beat :long :flow-state/net-gain-milli :long
                          :flow-state/order-index-milli :long :flow-state/throughput-milli :long
                          :flow-state/agent-eff-milli :long :flow-state/parasitic :boolean}}
 :ie.experiment  {:doc "a pre-registered dry-run experiment (leak-free: prediction before outcome)"
                  :attrs {:experiment/mechanism :string :experiment/predicted-up-milli :long
                          :experiment/net-at-act-milli :long :experiment/status :string}}
 :ie.outcome     {:doc "the Brier proper-score of the prior beat's experiment"
                  :attrs {:outcome/actual-up :boolean :outcome/brier-milli :long
                          :outcome/score-milli :long}}
 :ie.coscientist {:doc "per-mechanism learned kaizen weights"
                  :attrs {;; :coscientist.weight/<mechanism>-milli + :coscientist/as-of
                          :coscientist/as-of :string}}}
