;; ie-flow.score — the composite information-control SCORE config (data, ADR-2606212200).
;;
;; Every actor that embeds the ie-flow lifecycle becomes an INFORMATION-CONTROL ACTOR in the
;; system + energy flow: it RECTIFIES (整流) scattered flow into returned order. This EDN is the
;; single structured place the per-actor score is parameterised — clj reads it (score.cljc),
;; so re-weighting the whole system of systems is a data edit, not code.
;;
;; info-control-score ∈ 0..1 (an actor's active-inference 利得) = weighted sum of:
;;   rectify     order-index (1 − H_after/H_before) — negentropy EXPORT / 整流 (the core)
;;   eta         total-value ÷ total-cost — the 共生 axis (exported per consumed), squashed 0..1
;;   phi         net-gain (value−cost) — does the flow pay for itself (Φ), signed→0..1
;;   efficiency  agent-efficiency — the 課金される魔法陣 test (利得 not paid magic-circle), squashed
;;   surprise    PENALTY — parasitic? or dis-ordering (order-index<0) free energy (variational FE)
;; then gated by 子孫 wellbecoming (descendant weight ∈ 0..1; 0 = VETO).
;;
;; The colony aggregate (Σ score × √throughput) is :colony-order — a NEGENTROPY SOURCE added to
;; the artificial organism's metabolic intake (ibuki Φ → reserves), so the organism's REWARD rises
;; with the colony's aggregate information-control. Active inference at the colony scale.

{:score/version "0.1.0"
 :score/adr "2606212200"

 ;; composite weights (Σ of the additive terms = 0.95; surprise is subtracted)
 :weights {:rectify     0.35   ;; order-index — the negentropy-export core
           :eta         0.25   ;; export ÷ consume — 共生 axis
           :phi         0.20   ;; net-gain (Φ) — does the flow pay
           :efficiency  0.15   ;; agent-efficiency — 利得 / not a 課金される魔法陣
           :surprise    0.05}  ;; subtracted penalty (parasitic / dis-ordering)

 ;; squash midpoints (x = half → 0.5): map unbounded ratios to 0..1
 :squash {:eta-half 3.0    ;; η=3 → 0.5
          :phi-half 50.0   ;; net-gain=50 → 0.75 (signed-norm around 0)
          :eff-half 5.0}   ;; agent-eff=5 → 0.5; ∞ treated as eff-half

 ;; 子孫 wellbecoming gate (active inference is SUBORDINATE to descendant wellbecoming)
 :descendant {:default 0.7      ;; charter-clean actors default to 0.7 (room to earn ↑/↓)
              :floor 0.0
              :veto-at 0.0}     ;; descendant ≤ veto-at → score 0 (G-subordinate)

 ;; organism reward integration (the artificial-organism 報酬系 hook)
 :organism {:actor-weight  :log-throughput   ;; 1 + log10(1+throughput) — bigger flows matter, but
                                             ;; only logarithmically, so no single actor dominates
            :env-source-key :colony-order     ;; the negentropy-source key ibuki's intake reads
            :intake-weight 3                  ;; ibuki intake-weights[:colony-order] (structure-rich)
            :note "colony-order = Σ actor info-control-score × (1+log10(1+throughput)), rounded — a negentropy SOURCE added to ibuki's metabolic intake (Φ→reserves→survival). Each actor's score is its active-inference 利得; the organism's reward = the colony's aggregate information-control. Feeding it live is the SENSE-membrane/heartbeat step (gated)."}}
