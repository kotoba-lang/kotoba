{:paths ["src"]
 ;; kotobase-query (kotoba-lang/kotobase-query) is the ADR-2607172300 bridge
 ;; that turns kotobase.store/IStore documents into a queryable
 ;; arrangement-backed Datalog database (kotobase.query.bridge/materialize +
 ;; q). This repo's kotobase.gremlin.traversal translates a small,
 ;; bytecode-shaped Gremlin traversal subset (g.V()/.hasLabel()/.has()/
 ;; .out()/.in()/.values()) into that bridge's :find/:where shape directly --
 ;; it does not reimplement materialization or query evaluation, same
 ;; discipline `org-opencypher-cypher`'s Cypher translator uses.
 ;;
 ;; kotobase-query's own deps.edn pulls in kotobase (kotobase.store/local)
 ;; and arrangement (the 4-covering index + arrangement.datalog); arrangement
 ;; in turn pulls in prolly-tree/io-ipld (its commit!/CID-snapshot machinery,
 ;; unused by this bridge chain but required at namespace-load time), which
 ;; pull in io-multiformats/org-ietf-cbor. tools.deps resolves that whole
 ;; chain transitively from the single direct dep below for the JVM :test
 ;; alias. The nbb primary test path has no dependency resolver, so
 ;; bin/run_tests.cljk / CI clone every transitive dep by hand and list every
 ;; src dir on --classpath -- see the README's Develop/test section for the
 ;; exact command and kotobase-query's own README for why each hop is there.
 :deps {
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}
        io.github.kotoba-lang/kotobase-query {:local/root "../kotoba.ayatori"}}
 ;; First-class runtime is nbb/cljs (repo-wide runtime priority):
 ;;   kbb --backend sci --classpath "src:test:.deps/kotobase-query/src:.deps/kotobase/src:.deps/arrangement/src:.deps/prolly-tree/src:.deps/io-ipld/src:.deps/io-multiformats/src:.deps/org-ietf-cbor/src" bin/run_tests.cljk
 ;;   kbb --backend sci --classpath "src:test:.deps/kotobase-query/src:.deps/kotobase/src:.deps/arrangement/src:.deps/prolly-tree/src:.deps/io-ipld/src:.deps/io-multiformats/src:.deps/org-ietf-cbor/src" test/kotobase/gremlin/wire_test.cljk
 ;; The :test alias below is the :clj COMPAT suite (pure .cljc namespaces
 ;; only -- kotobase.gremlin.wire is .cljs-only and is NEVER loaded here,
 ;; same isolation kotoba-lang/nostr's nostr.relay.transport uses) -- not the
 ;; primary execution path.
 :aliases
 {:test {:extra-paths ["test"]}}}
