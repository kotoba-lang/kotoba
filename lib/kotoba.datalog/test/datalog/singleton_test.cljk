(ns datalog.singleton-test
  "`singleton/of` must be indistinguishable from `#{v}` to every reader of the
  index, and (on the JVM) be what the index actually stores for a one-value
  counterpart. Both directions: the set semantics are asserted against a real
  set, and the storage assertion has a control that shows the ordinary set
  where two values are held."
  (:require [kotoba.test :refer [deftest is testing]]
            [kotoba.lang.coll :as set]
            [datalog.singleton :as singleton]
            [datalog.index :as index]))

(def ^:private no-refs (constantly false))

(deftest a-singleton-is-the-set-it-stands-for
  (let [s (singleton/of "x")]
    (is (set? s))
    (is (= 1 (count s)))
    (is (contains? s "x"))
    (is (not (contains? s "y")))
    (is (= "x" (get s "x")))
    (is (nil? (get s "y")))
    (is (= "x" (s "x")) "callable like a set")
    (is (= "x" (first s)))
    (is (= ["x"] (vec s)))
    (is (not (empty? s)))
    (testing "equal to the real set in BOTH directions, with the same hash"
      (is (= s #{"x"}))
      (is (= #{"x"} s))
      (is (= (hash s) (hash #{"x"})))
      (is (not= s #{"y"}))
      (is (not= s #{"x" "y"}))
      (is (= {"p" s} {"p" #{"x"}}) "as a map value too"))
    (testing "conj of another value is an ordinary two-element set; of the same value, itself"
      (is (= #{"x" "y"} (conj s "y")))
      (is (not (singleton/singleton? (conj s "y"))))
      (is (identical? s (conj s "x"))))
    (testing "disj of the value is the empty set; of another, itself"
      (is (= #{} (disj s "x")))
      (is (empty? (disj s "x")))
      (is (identical? s (disj s "y"))))
    (testing "clojure.set"
      (is (= #{"x"} (set/intersection s #{"x" "z"})))
      (is (= #{} (set/intersection s #{"z"})))
      (is (= #{"x" "z"} (set/union s #{"z"})))
      (is (= #{} (set/difference s #{"x"}))))
    (testing "into, as a source and as a target"
      (is (= #{"x" 1} (into s [1])))
      (is (= ["x"] (into [] s))))
    (testing "a value that is itself a set stays wrapped, not confused with a multi-set"
      (let [ss (singleton/of #{:a :b})]
        (is (= 1 (count ss)))
        (is (= #{#{:a :b}} ss))))))

(deftest the-index-stores-a-singleton-for-one-value-and-a-set-for-two
  (let [db1 (index/assert-quad (index/empty-db) {:s "a" :p "p" :o "x"} no-refs)
        db2 (index/assert-quad db1 {:s "a" :p "p" :o "y"} no-refs)
        one (get (index/entity-attrs db1 "a") "p")
        two (get (index/entity-attrs db2 "a") "p")]
    #?(:clj (is (singleton/singleton? one) "one value: the compact form")
       :cljs (is (not (singleton/singleton? one)) "ClojureScript keeps the hash set"))
    (is (not (singleton/singleton? two)) "control: two values are an ordinary set")
    (is (= #{"x"} one))
    (is (= #{"x" "y"} two))
    (testing "the bulk path stores the same thing"
      (let [dbb (index/assert-quads (index/empty-db) [{:s "a" :p "p" :o "x"} {:s "b" :p "p" :o "x"} {:s "b" :p "p" :o "y"}] no-refs)]
        #?(:clj (is (singleton/singleton? (get (index/entity-attrs dbb "a") "p"))))
        (is (not (singleton/singleton? (get (index/entity-attrs dbb "b") "p"))))
        (is (= {"a" #{"x"} "b" #{"x" "y"}} (index/by-predicate dbb "p")))
        (is (= #{"a" "b"} (index/by-predicate-value dbb "p" "x")))))
    (testing "retract through the singleton prunes the key, as before"
      (let [db0 (index/retract-quad db1 {:s "a" :p "p" :o "x"} no-refs)]
        (is (= (index/empty-db) db0))))))
