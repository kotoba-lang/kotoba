{:paths ["src"]
 ;; The ONE runtime dependency, and it is a protocol + combinators with
 ;; `:deps {}` of its own -- so this library's whole transitive runtime
 ;; closure is `datom.source`. Deliberately absent: io-ipld, io-multiformats,
 ;; prolly-tree, block-cache. Nothing here stores, hashes, or addresses
 ;; anything. Pinned to the same SHA `kotoba-lang/arrangement`'s main uses.
 :deps {
        io.github.kotoba-lang/coll {:local/root "../kotoba.coll"}
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}
        io.github.kotoba-lang/datom-source {:local/root "../kotoba.datomSource"}}
 :aliases
 {:test {:extra-paths ["test"]}}}
