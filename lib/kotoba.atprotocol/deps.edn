{;; atprotocol — atproto 互換を kotoba-protocol の上の投影層として定義する
 ;; boundary/spec repo (ADR-2607071500)。層関係は依存にも現れる:
 ;; kotoba-protocol にのみ依存し、逆依存は永遠に作らない。
 ;; XRPC/PDS/AppView の実装はここに置かない (参照実装 = gftdcojp/app-aozora)。
 :paths ["src"]
 :deps {
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/kotoba-protocol {:git/url "https://github.com/kotoba-lang/kotoba-protocol.git"
                                     :git/sha "a8ddb2d37ef264b6e35bfd88e510ff31e9470dd5"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  ;; clj-kondo as a Clojars lib (no Homebrew/system install needed).
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}
  :kotoba {:replace-paths ["src"]
           :replace-deps {io.github.kotoba-lang/amu
                          {:git/url "https://github.com/kotoba-lang/amu.git"
                           :git/sha "f6ee539e23a967c25893361c4746746e623e8bd4"}}
           :main-opts ["-m" "kotoba.compiler.cli"]}}}