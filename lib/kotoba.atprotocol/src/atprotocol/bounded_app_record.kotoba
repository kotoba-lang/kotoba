(ns atprotocol.bounded-app-record
  (:export [main field-attr-table known-field? field->attr-or field-count]))

;; Bounded-profile port of atprotocol.app-record's fixed field<->attr
;; projection vocabulary: the closed 13-field camelCase-record-key ->
;; :kotoba.app/* attribute table that the net.kotoba.app.manifest codec
;; projects through. The reduce-kv record<->manifest codec (which walks
;; arbitrary open input maps and preserves unknown fields under
;; :atprotocol/unprojected) and valid-record? (which delegates to
;; kotoba.protocol.app/validate-manifest) stay the CLJC oracle -- only the
;; fixed projection vocabulary is bounded here.
;;
;; The table is kotoba-lang/compiler's canonical bounded typed-map
;; ([:map :string :keyword], <= 31 entries) -- string field name to
;; qualified-keyword attribute, the same primitive already qualified by
;; kotoba-lang/crdt / states / sheets / edu-berkeley-spice, here with a
;; keyword VALUE.

(defn field-attr-table [] [:map :string :keyword]
  (typed-map-assoc [:map :string :keyword]
   (typed-map-assoc [:map :string :keyword]
    (typed-map-assoc [:map :string :keyword]
     (typed-map-assoc [:map :string :keyword]
      (typed-map-assoc [:map :string :keyword]
       (typed-map-assoc [:map :string :keyword]
        (typed-map-assoc [:map :string :keyword]
         (typed-map-assoc [:map :string :keyword]
          (typed-map-assoc [:map :string :keyword]
           (typed-map-assoc [:map :string :keyword]
            (typed-map-assoc [:map :string :keyword]
             (typed-map-assoc [:map :string :keyword]
              (typed-map-assoc [:map :string :keyword]
               (typed-map-new [:map :string :keyword])
               "id" :kotoba.app/id)
              "version" :kotoba.app/version)
             "kind" :kotoba.app/kind)
            "bundleCid" :kotoba.app/bundle-cid)
           "entry" :kotoba.app/entry)
          "embedUrl" :kotoba.app/embed-url)
         "appviewOf" :kotoba.app/appview-of)
        "wasm" :kotoba.app/wasm)
       "caps" :kotoba.app/caps)
      "limits" :kotoba.app/limits)
     "latest" :kotoba.app/latest)
    "icon" :kotoba.app/icon)
   "sig" :kotoba.app/sig))

(defn field-count [table [:map :string :keyword]] :i64
  (typed-map-count [:map :string :keyword] table))

(defn known-field? [table [:map :string :keyword] field :string] :bool
  (typed-map-contains [:map :string :keyword] table field))

;; camelCase field name -> :kotoba.app/* attribute, or a caller-supplied
;; fallback keyword for a field outside the projection vocabulary (the codec
;; oracle preserves those under :atprotocol/unprojected).
(defn field->attr-or [table [:map :string :keyword] field :string fallback :keyword] :keyword
  (match-option
   (typed-map-get [:map :string :keyword] table field)
   [:option :keyword]
   (none fallback)
   (some attr attr)))

;; Self-conformance: the fixed vocabulary has exactly 13 fields; a
;; representative field projects to its documented attribute; a $type
;; control key and an arbitrary unknown field are NOT in the vocabulary.
(defn main [] :i64
  (let [t (field-attr-table)]
    (if (= 13 (field-count t))
      (if (known-field? t "bundleCid")
        (if (= :kotoba.app/bundle-cid (field->attr-or t "bundleCid" :atprotocol/unknown))
          (if (= :kotoba.app/sig (field->attr-or t "sig" :atprotocol/unknown))
            (if (known-field? t "$type")
              1
              (if (known-field? t "notAField")
                1
                (if (= :atprotocol/unknown (field->attr-or t "notAField" :atprotocol/unknown))
                  42
                  1)))
            1)
          1)
        1)
      1)))
