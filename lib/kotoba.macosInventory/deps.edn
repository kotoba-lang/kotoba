;; macos-inventory — read-only inventory of what a Mac is running and what it is
;; permitted to do: launchd jobs, login items, configuration profiles, kernel and
;; system extensions, browser extensions, TCC privacy grants, code signatures,
;; listening sockets, installed applications, Gatekeeper/XProtect state.
;;
;; Every probe is non-mutating and every probe can fail for a legible reason. A
;; failed probe reports reduced coverage; it never returns an empty result that
;; reads as a clean machine.
{:paths ["src"]
 :deps {
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test" "--fail-level" "error"]}}}
