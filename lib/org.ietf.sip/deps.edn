;; No third-party dependencies. SIP (RFC 3261) is a text protocol — headers,
;; quoted strings, folded continuation lines and URI grammar — and none of
;; that needs anything beyond string/char manipulation. A leaf that dragged
;; in a regex-heavy parsing library or an HTTP client would defeat the point,
;; which is that this codec has to run anywhere `.cljc` runs (JVM, browser,
;; nbb) with nothing to install first.
{:paths ["src"]
 :deps {
        io.github.kotoba-lang/io {:local/root "../kotoba.io"}
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {
                      ;; TEST-ONLY. Parity compiles kotoba/sip/reader.kotoba
                      ;; and runs it against sip.message. Nothing in :paths
                      ;; depends on either; the codec stays dependency-free.
                      ;; Pins are the west pair (amu + kotoba-kir) as of this
                      ;; commit; advanced together.
                      io.github.kotoba-lang/amu
                      {:git/url "https://github.com/kotoba-lang/amu.git"
                       :git/sha "35e8a18f2842762bedbf88b32f22e1128ad95cf0"}
                      io.github.kotoba-lang/osaho
                      {:git/url "https://github.com/kotoba-lang/osaho.git"
                       :git/sha "099c627609ad506babf05f2d5e9a73b95c1b026b"}}}
  :cljs {:extra-paths ["test"]}}}
