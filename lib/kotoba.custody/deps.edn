{:paths ["src"]
 :deps {
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}}
 ;; Pure .cljc, no runtime deps. The randomness and the digest are injected
 ;; (see custody.shamir/split and custody.model/open) precisely so this
 ;; library never has to pick a CSPRNG or a hash on a caller's behalf.
 :aliases {:test {:extra-paths ["test"]}}}
