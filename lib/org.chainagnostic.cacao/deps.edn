{:paths ["src"]
 ;; ed25519 / dag-cbor are pinned as git deps (not :local/root) so cacao
 ;; resolves standalone when consumed as a git dep from a clean clone with no
 ;; monorepo siblings present (ADR-2607022400). SHAs are each sibling repo's
 ;; origin/main HEAD as of 2026-07-02, obtained via
 ;;   gh api repos/kotoba-lang/<repo>/commits/main --jq .sha
 :deps {
        io.github.kotoba-lang/error {:local/root "../kotoba.error"}
        io.github.kotoba-lang/bytes {:local/root "../kotoba.bytes"}
        io.github.kotoba-lang/io {:local/root "../kotoba.io"}
        io.github.kotoba-lang/edn {:local/root "../kotoba.edn"}
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}
        io.github.kotoba-lang/authority {:local/root "../kotoba.authority"}
        io.github.kotoba-lang/org-ietf-ed25519 {:local/root "../org.ietf.ed25519"}
        io.github.kotoba-lang/org-ietf-cbor {:local/root "../org.ietf.cbor"}}
 :aliases {;; Monorepo-local dev: resolve the siblings from the working-tree
           ;; checkouts (../org-ietf-ed25519, ../org-ietf-cbor) instead of git.
           ;; Compose with other aliases, e.g. `kbb -M:local:test`.
           ;; Preserves the pre-existing sibling-checkout workflow without
           ;; breaking clean git-dep consumption above.
           :local {:override-deps {io.github.kotoba-lang/authority {:local/root "../authority"}
                                   io.github.kotoba-lang/org-ietf-ed25519  {:local/root "../org-ietf-ed25519"}
                                   io.github.kotoba-lang/org-ietf-cbor {:local/root "../org-ietf-cbor"}}}
           :test {:extra-paths ["test"]
                  :extra-deps {
                               ;; The Kotoba compiler and KIR interpreter, so
                               ;; `kotoba/siwe/window.kotoba` is driven by the
                               ;; suite rather than described by it.
                               io.github.kotoba-lang/amu
                               {:git/url "https://github.com/kotoba-lang/amu.git"
                                :git/sha "2cb7d3f18205eadb3791441d3c3e09d9eb9b1a22"}
                               io.github.kotoba-lang/osaho
                               {:git/url "https://github.com/kotoba-lang/osaho.git"
                                :git/sha "56911149694ddaa382ce7d214ed62c69a2d917c5"}}}}}
