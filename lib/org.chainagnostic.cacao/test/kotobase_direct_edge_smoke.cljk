;; WebCrypto smoke for the CACAO profile used by Kotobase's direct /ipld write.
(require '[cacao.edge.cbor :as cbor]
         '[cacao.edge.mint :as mint]
         '[cacao.edge.verify :as verify])

(def failures (atom []))
(defn check! [label ok?]
  (if ok?
    (js/console.log "ok  -" label)
    (do (js/console.error "FAIL-" label) (swap! failures conj label))))

(defn base64url->bytes [value]
  (let [standard (-> value (.replace #"-" "+") (.replace #"_" "/"))
        padding (apply str (repeat (mod (- 4 (mod (count standard) 4)) 4) "="))]
    (verify/base64->bytes (str standard padding))))

(def fields
  {:domain "kotobase.net"
   :aud "did:web:kotobase.net"
   :nonce "direct-smoke-1"
   :iat "2026-09-22T04:00:00Z"
   :exp "2026-09-22T04:05:00Z"
   :resources ["kotoba://can/kotobase:pin"]})

(-> (.generateKey js/crypto.subtle #js {:name "Ed25519"} true #js ["sign" "verify"])
    (.then
     (fn [kp]
       (-> (.exportKey js/crypto.subtle "raw" (.-publicKey kp))
           (.then
            (fn [raw]
              (let [did (mint/did-key-from-raw-ed25519-pub (js/Uint8Array. raw))
                    signer (fn [message]
                             (.sign js/crypto.subtle "Ed25519" (.-privateKey kp) message))]
                (-> (mint/mint-kotobase-direct did signer fields)
                    (.then
                     (fn [{:keys [cacao-b64]}]
                       (let [envelope (cbor/decode (verify/base64->bytes cacao-b64))
                             payload (aget envelope "p")
                             signature-map (aget envelope "s")
                             signature (aget signature-map "s")
                             message (.encode (js/TextEncoder.) (verify/siwe-message payload))]
                         (check! "signature type is explicit EdDSA"
                                 (= "EdDSA" (aget signature-map "t")))
                         (check! "inner signature is unpadded base64url"
                                 (and (not (.includes signature "="))
                                      (= 64 (.-length (base64url->bytes signature)))))
                         (-> (.verify js/crypto.subtle "Ed25519" (.-publicKey kp)
                                      (base64url->bytes signature) message)
                             (.then #(check! "direct profile signature verifies" %)))))))))))))
    (.then (fn [_]
             (if (seq @failures)
               (set! (.-exitCode js/process) 1)
               (js/console.log "Kotobase direct edge mint smoke: all checks passed"))))
    (.catch (fn [error]
              (js/console.error "threw:" error)
              (set! (.-exitCode js/process) 1))))
