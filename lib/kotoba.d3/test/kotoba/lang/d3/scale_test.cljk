(ns kotoba.lang.d3.scale-test
  (:require [kotoba.test :refer [deftest is testing]]
            [kotoba.lang.d3.scale :as scale]))

(deftest linear-scale-interpolates
  (let [f (scale/linear-scale [0 100] [0 1])]
    (is (= 1/2 (f 50)))
    (is (= 0 (f 0)))
    (is (= 1 (f 100)))
    ;; extrapolates outside the domain rather than clamping
    (is (= -1/2 (f -50)))
    (is (= 3/2 (f 150)))))

(deftest linear-scale-reversed-range
  (let [f (scale/linear-scale [0 10] [100 0])]
    (is (= 50 (f 5)))
    (is (= 100 (f 0)))
    (is (= 0 (f 10)))))

(deftest linear-invert-round-trips
  (let [domain [0 100]
        range [0 1]
        scale-fn (scale/linear-scale domain range)
        invert-fn (scale/linear-invert domain range)]
    (is (= 50 (invert-fn (scale-fn 50))))
    (is (= 0 (invert-fn (scale-fn 0))))
    (is (= 100 (invert-fn (scale-fn 100))))
    (is (= 37 (invert-fn (scale-fn 37))))))

(deftest log-scale-maps-log-space-linearly
  (let [f (scale/log-scale [1 100] [0 1])]
    (is (= 0.0 (f 1)))
    (is (= 1.0 (f 100)))
    (is (== 0.5 (f 10)))))

(deftest log-invert-round-trips
  (let [domain [1 100]
        range [0 1]
        scale-fn (scale/log-scale domain range)
        invert-fn (scale/log-invert domain range)]
    (is (< (Math/abs (- 10 (invert-fn (scale-fn 10)))) 1e-9))
    (is (< (Math/abs (- 1 (invert-fn (scale-fn 1)))) 1e-9))
    (is (< (Math/abs (- 100 (invert-fn (scale-fn 100)))) 1e-9))))

(deftest ordinal-scale-maps-by-position
  (let [f (scale/ordinal-scale [:a :b :c] [1 2 3])]
    (is (= 1 (f :a)))
    (is (= 2 (f :b)))
    (is (= 3 (f :c)))
    (is (nil? (f :d)))))

(deftest point-scale-evenly-spaces-domain
  (testing "three values span the full range inclusive of both endpoints"
    (let [f (scale/point-scale [:a :b :c] [0 100])]
      (is (= 0 (f :a)))
      (is (= 50 (f :b)))
      (is (= 100 (f :c)))))
  (testing "a single value maps to the midpoint"
    (let [f (scale/point-scale [:a] [0 100])]
      (is (= 50 (f :a)))))
  (testing "unknown values map to nil"
    (let [f (scale/point-scale [:a :b] [0 10])]
      (is (nil? (f :z))))))

(deftest band-scale-computes-bands
  (testing "zero padding: bands tile the range exactly"
    (let [f (scale/band-scale [:a :b] [0 100])]
      (is (= {:start 0 :end 50 :width 50} (f :a)))
      (is (= {:start 50 :end 100 :width 50} (f :b)))))
  (testing "padding shrinks bandwidth and insets both edges"
    (let [f (scale/band-scale [:a :b] [0 100] 1/2)]
      (is (= {:start 25/2 :end 75/2 :width 25} (f :a)))
      (is (= {:start 125/2 :end 175/2 :width 25} (f :b))))))
