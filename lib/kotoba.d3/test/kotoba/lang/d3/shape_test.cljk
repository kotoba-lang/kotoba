(ns kotoba.lang.d3.shape-test
  (:require [kotoba.test :refer [deftest is testing]]
            [kotoba.lang.d3.shape :as shape]))

(deftest line-generator-emits-move-then-lines
  (is (= "" (shape/line-generator [])))
  (is (= "M0,0" (shape/line-generator [[0 0]])))
  (is (= "M0,0L10,0L10,10"
         (shape/line-generator [[0 0] [10 0] [10 10]])))
  (testing "accessor-based points (maps)"
    (is (= "M0,0L10,5"
           (shape/line-generator [{:px 0 :py 0} {:px 10 :py 5}]
                                  {:x :px :y :py})))))

(deftest area-generator-closes-to-baseline
  (is (= "" (shape/area-generator [])))
  (is (= "M0,0L10,5L20,0L20,10L0,10Z"
         (shape/area-generator [[0 0] [10 5] [20 0]] {:baseline 10})))
  (testing "default baseline is 0"
    (is (= "M0,3L10,3L10,0L0,0Z"
           (shape/area-generator [[0 3] [10 3]])))))

(deftest arc-generator-quarter-slice-no-large-arc-flag
  (is (= "M0,0L0,-10A10,10 0 0 1 10,0Z"
         (shape/arc-generator {:outer-radius 10
                                :start-angle 0
                                :end-angle (/ Math/PI 2)}))))

(deftest arc-generator-half-slice-sets-large-arc-flag
  (is (= "M0,0L0,-5A5,5 0 1 1 0,5Z"
         (shape/arc-generator {:outer-radius 5
                                :start-angle 0
                                :end-angle Math/PI}))))

(deftest arc-generator-donut-quarter-segment
  (is (= "M0,-10A10,10 0 0 1 10,0L5,0A5,5 0 0 0 0,-5Z"
         (shape/arc-generator {:inner-radius 5
                                :outer-radius 10
                                :start-angle 0
                                :end-angle (/ Math/PI 2)}))))

(deftest arc-generator-full-circle-edge-case
  (testing "a full-circle span (>= 2*pi) is split into two half-circle arcs
            rather than emitted as a single degenerate arc command"
    (is (= "M0,-5A5,5 0 1 1 0,5A5,5 0 1 1 0,-5L0,0Z"
           (shape/arc-generator {:outer-radius 5
                                  :start-angle 0
                                  :end-angle (* 2 Math/PI)})))))

(deftest arc-generator-full-donut-edge-case
  (testing "full-circle donut splits both the outer and inner arcs"
    (is (= "M0,-5A5,5 0 1 1 0,5A5,5 0 1 1 0,-5L0,-2A2,2 0 1 0 0,2A2,2 0 1 0 0,-2Z"
           (shape/arc-generator {:inner-radius 2
                                  :outer-radius 5
                                  :start-angle 0
                                  :end-angle (* 2 Math/PI)})))))

(deftest pie-layout-angles-sum-to-full-circle
  (let [tau (* 2 Math/PI)
        slices (shape/pie-layout [1 1 2])]
    (is (= 3 (count slices)))
    (is (= 1 (:value (first slices))))
    (is (< (Math/abs (- (:start-angle (first slices)) 0.0)) 1e-9))
    (is (< (Math/abs (- (:end-angle (first slices)) (/ tau 4))) 1e-9))
    (is (< (Math/abs (- (:end-angle (second slices)) (/ tau 2))) 1e-9))
    (is (< (Math/abs (- (:end-angle (last slices)) tau)) 1e-9))
    ;; angle-sum-to-360 invariant: last slice's end-angle is a full turn
    (is (< (Math/abs (- (reduce + (map #(- (:end-angle %) (:start-angle %)) slices))
                         tau))
           1e-9))))

(deftest pie-layout-handles-all-zero-values
  (let [slices (shape/pie-layout [0 0 0])]
    (is (every? #(= 0.0 (:start-angle %)) slices))
    (is (every? #(= 0.0 (:end-angle %)) slices))))
