(ns kotoba.lang.d3.shape
  "Native reimplementation of d3-shape's core: pure functions turning data
  points or angle/radius descriptions into SVG path `d` strings and pie-slice
  angle maps. NOT a JS-interop wrapper around real d3.js.

  Output path strings are plain SVG path syntax and the EDN this namespace
  otherwise touches (none — these fns return strings, not Hiccup) is
  wire-compatible with kotoba-lang/svg: feed the returned `d` string straight
  into `[:path {:d (line-generator pts)}]`, which `svg.core/render` (a
  separate sibling repo, not a dependency here) can render.

  Angle convention (matches d3-shape / SVG clock geometry): angle 0 points
  straight up (12 o'clock), and angle increases clockwise, in radians. This
  matters for `arc-generator` and the angles produced by `pie-layout`."
  (:refer-clojure :exclude [line abs]))

(def ^:private pi #?(:clj Math/PI :cljs js/Math.PI))
(def ^:private tau (* 2 pi))

(defn- sin [a] #?(:clj (Math/sin a) :cljs (js/Math.sin a)))
(defn- cos [a] #?(:clj (Math/cos a) :cljs (js/Math.cos a)))
(defn- abs [x] #?(:clj (Math/abs (double x)) :cljs (js/Math.abs x)))
(defn- round-half-even [x] #?(:clj (Math/round (double x)) :cljs (js/Math.round x)))

(defn- round6
  "Round to 6 decimal places, both to keep path strings short and to collapse
  floating-point noise (e.g. sin(pi) ~= 1.2e-16) to exact zero so path
  strings for well-known angles are stable and testable."
  [x]
  (/ (round-half-even (* x 1e6)) 1e6))

(defn- num-str
  "Render a number for an SVG path: integral values print without a decimal
  point (matches d3's default path number formatting)."
  [x]
  (let [r (round6 x)]
    (if (== r (long r))
      (str (long r))
      (str r))))

(defn- point->xy
  "Extract [x y] from a point, which is either a [x y] pair or a map/record
  accessed via `x-fn`/`y-fn` (default `first`/`second`)."
  [x-fn y-fn p]
  [(x-fn p) (y-fn p)])

(defn line-generator
  "Turn a seq of points into an SVG path `d` string of straight line
  segments: `M x0,y0 L x1,y1 L x2,y2 ...`. A point is either a `[x y]` pair
  (the default) or any value accepted by `:x`/`:y` accessor fns (e.g. maps
  `{:x .. :y ..}` with `{:x :x :y :y}`, or records with custom accessors).
  Returns \"\" for an empty seq. Curved/spline interpolation is out of scope
  for v1 (straight segments only)."
  ([points] (line-generator points {}))
  ([points {:keys [x y] :or {x first y second}}]
   (if (empty? points)
     ""
     (let [pts (map (partial point->xy x y) points)
           [x0 y0] (first pts)]
       (apply str
              "M" (num-str x0) "," (num-str y0)
              (map (fn [[px py]] (str "L" (num-str px) "," (num-str py)))
                   (rest pts)))))))

(defn area-generator
  "Turn a seq of points into a *filled* SVG path `d` string: the line through
  the points, then closed down to a horizontal `baseline` (default 0) and
  back to the first point's x, then `Z`. Suitable for area/stream charts.
  Point/accessor conventions match `line-generator`; `:baseline` is an extra
  option key for the y-coordinate of the flat bottom edge."
  ([points] (area-generator points {}))
  ([points {:keys [x y baseline] :or {x first y second baseline 0}}]
   (if (empty? points)
     ""
     (let [pts (map (partial point->xy x y) points)
           [x0 _] (first pts)
           [xn _] (last pts)]
       (str (line-generator points {:x x :y y})
            "L" (num-str xn) "," (num-str baseline)
            "L" (num-str x0) "," (num-str baseline)
            "Z")))))

(defn- polar
  "Convert (radius, angle) in the d3 clock convention (0 = up, clockwise) to
  cartesian [x y], relative to the arc's center at the origin."
  [r angle]
  [(* r (sin angle)) (* -1 r (cos angle))])

(defn arc-generator
  "Turn `{:inner-radius :outer-radius :start-angle :end-angle}` (angles in
  radians, d3 clock convention) into an SVG path `d` string for a pie/donut
  wedge, centered at the origin (wrap the resulting `[:path]` in a
  `[:g {:transform \"translate(cx,cy)\"}]` to place it). `inner-radius`
  defaults to 0 (a pie slice rather than a donut segment).

  Handles the well-known SVG arc large-arc-flag edge case (angular span >
  180 degrees / pi radians needs `large-arc-flag=1`) and the full-circle
  edge case (a span of a full 360 degrees / tau radians cannot be expressed
  as a single SVG arc command, because the arc command's start and end
  point would coincide and the renderer cannot infer a direction/radius from
  a zero-length arc — so a full circle is split into two 180-degree arcs at
  the midpoint angle)."
  [{:keys [inner-radius outer-radius start-angle end-angle]
    :or {inner-radius 0}}]
  (let [span (- end-angle start-angle)
        large-arc (if (>= (abs span) pi) 1 0)
        full? (>= (abs span) (- tau 1e-9))]
    (if full?
      (let [mid (+ start-angle (/ span 2))
            [ox0 oy0] (polar outer-radius start-angle)
            [oxm oym] (polar outer-radius mid)
            [ox1 oy1] (polar outer-radius end-angle)]
        (if (pos? inner-radius)
          (let [[ix0 iy0] (polar inner-radius start-angle)
                [ixm iym] (polar inner-radius mid)
                [ix1 iy1] (polar inner-radius end-angle)]
            (str "M" (num-str ox0) "," (num-str oy0)
                 "A" (num-str outer-radius) "," (num-str outer-radius) " 0 1 1 " (num-str oxm) "," (num-str oym)
                 "A" (num-str outer-radius) "," (num-str outer-radius) " 0 1 1 " (num-str ox1) "," (num-str oy1)
                 "L" (num-str ix1) "," (num-str iy1)
                 "A" (num-str inner-radius) "," (num-str inner-radius) " 0 1 0 " (num-str ixm) "," (num-str iym)
                 "A" (num-str inner-radius) "," (num-str inner-radius) " 0 1 0 " (num-str ix0) "," (num-str iy0)
                 "Z"))
          (str "M" (num-str ox0) "," (num-str oy0)
               "A" (num-str outer-radius) "," (num-str outer-radius) " 0 1 1 " (num-str oxm) "," (num-str oym)
               "A" (num-str outer-radius) "," (num-str outer-radius) " 0 1 1 " (num-str ox1) "," (num-str oy1)
               "L0,0"
               "Z")))
      (let [[ox0 oy0] (polar outer-radius start-angle)
            [ox1 oy1] (polar outer-radius end-angle)]
        (if (pos? inner-radius)
          (let [[ix1 iy1] (polar inner-radius end-angle)
                [ix0 iy0] (polar inner-radius start-angle)]
            (str "M" (num-str ox0) "," (num-str oy0)
                 "A" (num-str outer-radius) "," (num-str outer-radius) " 0 " large-arc " 1 " (num-str ox1) "," (num-str oy1)
                 "L" (num-str ix1) "," (num-str iy1)
                 "A" (num-str inner-radius) "," (num-str inner-radius) " 0 " large-arc " 0 " (num-str ix0) "," (num-str iy0)
                 "Z"))
          (str "M0,0"
               "L" (num-str ox0) "," (num-str oy0)
               "A" (num-str outer-radius) "," (num-str outer-radius) " 0 " large-arc " 1 " (num-str ox1) "," (num-str oy1)
               "Z"))))))

(defn pie-layout
  "Turn a seq of non-negative numeric `values` into a seq of
  `{:value v :start-angle .. :end-angle ..}` slices (radians, d3 clock
  convention, starting at angle 0 / 12 o'clock and proceeding clockwise) each
  proportional to that value's share of the total. The end-angle of the last
  slice equals `tau` (2*pi) whenever the total is positive — i.e. angles sum
  to a full circle. All-zero `values` produce zero-width slices (all angles
  0) rather than dividing by zero."
  [values]
  (let [total (reduce + 0 values)]
    (loop [vs values acc [] angle 0.0]
      (if (empty? vs)
        acc
        (let [v (first vs)
              slice (if (zero? total) 0.0 (* tau (/ v total)))
              end (+ angle slice)]
          (recur (rest vs)
                 (conj acc {:value v :start-angle angle :end-angle end})
                 end))))))
