(ns record-fixtures
  "Regenerate test/flac/fixtures.cljk from real FLAC files.

       kbb --backend sci tools/record_fixtures.cljk

   Each fixture carries the `.flac` bytes **and the samples the reference decoder
   produces from them**, so the portable suite asserts bit-exactness on
   ClojureScript with no shell — not merely that decoding does not throw.

   Files are kept short (0.02 s) because the expected samples are inlined."
  (:require ["node:child_process" :as cp]
            ["node:fs" :as fs]
            [kotoba.lang.text :as str]))

(def ^:private cases
  ;; [name lavfi-source channels codec level] — chosen for subframe coverage:
  ;; a sine gives LPC, noise gives high-order LPC and verbatim, silence gives
  ;; CONSTANT, and level 0 vs 8 changes the predictor and partitioning entirely.
  [["sine-l0" "sine=frequency=440:duration=0.02:sample_rate=44100" 2 "pcm_s16le" 0]
   ["sine-l8" "sine=frequency=440:duration=0.02:sample_rate=44100" 2 "pcm_s16le" 8]
   ["noise-l8" "anoisesrc=duration=0.02:sample_rate=44100:amplitude=0.8" 1 "pcm_s16le" 8]
   ["quiet-l5" "sine=frequency=1:duration=0.02:sample_rate=8000" 1 "pcm_u8" 5]
   ["deep-l8" "sine=frequency=440:duration=0.02:sample_rate=48000" 2 "pcm_s24le" 8]])

(defn- sh [cmd args]
  (let [r (cp/spawnSync cmd (clj->js args) #js {:encoding "buffer"})]
    (when-not (zero? (.-status r))
      (throw (ex-info (str cmd " failed") {:stderr (str (.-stderr r))})))
    r))

(defn- bytes-of [path] (vec (js/Array.from (fs/readFileSync path))))

(defn- make [name source channels codec level]
  (let [wav (str "/tmp/flac-fixture-" name ".wav")
        fl (str "/tmp/flac-fixture-" name ".flac")
        dec (str "/tmp/flac-fixture-" name ".dec.wav")]
    (sh "ffmpeg" ["-hide_banner" "-v" "error" "-f" "lavfi" "-i" source
                  "-ac" (str channels) "-c:a" codec wav "-y"])
    (sh "flac" ["--totally-silent" "-f" (str "-" level) "-o" fl wav])
    ;; the reference decode is what the fixture asserts against
    (sh "flac" ["--totally-silent" "-f" "-d" "-o" dec fl])
    {:flac (bytes-of fl) :wav (bytes-of dec)}))

(defn- b64 [bytes] (.toString (.from js/Buffer (clj->js bytes)) "base64"))

(defn -main []
  (let [recorded (mapv (fn [[name source channels codec level]]
                         [name (make name source channels codec level)])
                       cases)
        lines (concat
               ["(ns flac.fixtures"
                "  \"Real FLAC files and the samples the reference decoder produces from"
                "   them, so the portable suite can assert bit-exactness on both runtimes"
                "   with no shell and no filesystem."
                ""
                "   `:flac` is the stream; `:wav` is `flac -d` output, decoded in the suite"
                "   with org-microsoft-riff. Sources are chosen for subframe coverage: a sine"
                "   gives LPC, noise gives verbatim and high-order LPC, near-silence gives"
                "   CONSTANT, and level 0 against level 8 changes predictor and partitioning."
                ""
                "   Generated by tools/record_fixtures.cljk — do not hand-edit.\")"
                ""
                "(def files"
                "  {"]
               (mapcat (fn [[name {:keys [flac wav]}]]
                         [(str "   \"" name "\"")
                          (str "   {:flac \"" (b64 flac) "\"")
                          (str "    :wav \"" (b64 wav) "\"}")])
                       recorded)
               ["   })"])]
    (fs/writeFileSync "test/flac/fixtures.cljk" (str (str/join "\n" lines) "\n"))
    (println "wrote test/flac/fixtures.cljk"
             (str "(" (str/join ", " (map (fn [[n {:keys [flac]}]] (str n " " (count flac) "B"))
                                          recorded))
                  ")"))))

(-main)
