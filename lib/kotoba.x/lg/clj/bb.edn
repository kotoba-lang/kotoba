{;; lg-x clj — scoped babashka project for the langgraph-clj port of the
 ;; Python lg_x LangGraph server (x.etzhayyim.com Twitter-ops actor).
 ;; ADR-2606280030 (langgraph-python → langgraph-clj). This bb.edn is scoped
 ;; to THIS app only — it does NOT touch the repo-root bb.edn.
 ;;
 ;; The langgraph-clj sha is pinned to the same revision as the repo-root
 ;; bb.edn so the StateGraph idiom matches the rest of the actor tree.
 :paths ["src" "test"]
 :deps {com-junkawasaki/langgraph-clj
        {:git/url "https://github.com/com-junkawasaki/langgraph-clj"
         :git/sha "c7daa07d4e50f55d7e2a02e4b89dbeb2b200961d"}}
 :tasks
 {test {:doc "Run the lg-x clj test suite (clojure.test under bb)."
        :task (load-file "run_tests.clj")}}}
