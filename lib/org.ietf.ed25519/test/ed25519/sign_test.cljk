(ns ed25519.sign-test
  "RFC 8032 §7.1 verbatim. All four were independently reproduced with
  BouncyCastle 1.78.1 (`org.bouncycastle.math.ec.rfc8032.Ed25519`) before
  being written here."
  (:require [kotoba.test :refer [deftest is testing]]
            [ed25519.scalar :as sc]
            [ed25519.sign :as ed]))

(defn- h [s] (ed/unhex s))

(def vectors
  [{:name "TEST 1"
    :seed "9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60"
    :public "d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a"
    :msg ""
    :sig (str "e5564300c360ac729086e2cc806e828a84877f1eb8e5d974d873e0652249015"
              "55fb8821590a33bacc61e39701cf9b46bd25bf5f0595bbe24655141438e7a100b")}
   {:name "TEST 2"
    :seed "4ccd089b28ff96da9db6c346ec114e0f5b8a319f35aba624da8cf6ed4fb8a6fb"
    :public "3d4017c3e843895a92b70aa74d1b7ebc9c982ccf2ec4968cc0cd55f12af4660c"
    :msg "72"
    :sig (str "92a009a9f0d4cab8720e820b5f642540a2b27b5416503f8fb3762223ebdb69"
              "da085ac1e43e15996e458f3613d0f11d8c387b2eaeb4302aeeb00d291612bb0c00")}
   {:name "TEST 3"
    :seed "c5aa8df43f9f837bedb7442f31dcb7b166d38535076f094b85ce3a2e0b4458f7"
    :public "fc51cd8e6218a1a38da47ed00230f0580816ed13ba3303ac5deb911548908025"
    :msg "af82"
    :sig (str "6291d657deec24024827e69c3abe01a30ce548a284743a445e3680d7db5ac3"
              "ac18ff9b538d16f290ae67f760984dc6594a7c15e9716ed28dc027beceea1ec40a")}
   {:name "TEST SHA(abc)"
    :seed "833fe62409237b9d62ec77587520911e9a759cec1d19755b7da901b96dca3d42"
    :public "ec172b93ad5e563bf4932c70e1245034c35467ef2efd4d64ebf819683467e2bf"
    :msg (str "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a"
              "2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f")
    :sig (str "dc2a4459e7369633a52b1bf277839a00201009a3efbf3ecb69bea2186c26b589"
              "09351fc9ac90b3ecfdfbc7c66431e0303dca179c138ac17ad9bef1177331a704")}])

(deftest rfc-8032-section-7-1
  (doseq [{:keys [name seed public msg sig]} vectors]
    (let [sk (ed/secret-key! (h seed))]
      (is (= public (ed/hex (:public sk))) (str name " public key"))
      (is (= sig (ed/hex (ed/sign sk (h msg)))) (str name " signature"))
      (is (true? (ed/verify (h public) (h msg) (h sig))) (str name " verifies")))))

;; ── what a verifier must reject ──────────────────────────────────────────────

(deftest every-single-bit-change-is-rejected
  (let [{:keys [public msg sig]} (nth vectors 2)
        pk (h public) m (h msg) s (h sig)]
    (is (true? (ed/verify pk m s)))
    (testing "a flipped bit anywhere in the signature"
      (doseq [i (range 64) bit (range 8)]
        (is (false? (ed/verify pk m (assoc (vec s) i (bit-xor (nth s i) (bit-shift-left 1 bit)))))
            (str "sig byte " i " bit " bit))))
    (testing "a flipped bit anywhere in the public key"
      (doseq [i (range 32) bit (range 8)]
        (is (false? (ed/verify (assoc (vec pk) i (bit-xor (nth pk i) (bit-shift-left 1 bit))) m s))
            (str "key byte " i " bit " bit))))
    (testing "a changed message"
      (is (false? (ed/verify pk (conj (vec m) 0) s))))))

(deftest malleability-is-rejected
  ;; RFC 8032 §5.1.7. Without the S < L check, S + L is a second valid
  ;; signature for the same message and key -- which breaks anything treating
  ;; a signature as an identifier.
  (let [{:keys [public msg sig]} (nth vectors 1)
        s (h sig)
        malleated (vec (concat (subvec s 0 32)
                               (loop [out [] i 0 carry 0]
                                 (if (= i 32)
                                   out
                                   (let [v (+ (nth s (+ 32 i)) (nth sc/order-bytes i) carry)]
                                     (recur (conj out (bit-and v 255)) (inc i) (quot v 256)))))))]
    (is (true? (ed/verify (h public) (h msg) s)))
    (is (false? (ed/verify (h public) (h msg) malleated))
        "S + L must be rejected")))

(deftest malformed-input-is-false-not-a-throw
  (let [{:keys [public msg sig]} (first vectors)]
    (is (false? (ed/verify (h public) (h msg) (vec (repeat 63 0)))) "short signature")
    (is (false? (ed/verify (vec (repeat 31 0)) (h msg) (h sig))) "short key")
    (testing "a public key that is not a point at all"
      ;; y = p - 1 with the sign bit set has no matching x on the curve.
      (is (false? (ed/verify (vec (concat (repeat 31 0xFF) [0xFF])) (h msg) (h sig)))))
    (is (= :bad-seed-length (:reason (ed/secret-key (vec (repeat 31 0))))))))

;; ── the scalar arithmetic ────────────────────────────────────────────────────

(deftest scalar-reduction
  (testing "a value already below L is unchanged"
    (let [s (vec (concat [7] (repeat 31 0)))]
      (is (= s (sc/reduce32 s)))))
  (testing "L itself reduces to zero"
    (is (= (vec (repeat 32 0)) (sc/reduce32 sc/order-bytes))))
  (testing "L + 1 reduces to 1"
    (let [l1 (assoc (vec sc/order-bytes) 0 (inc (nth sc/order-bytes 0)))]
      (is (= (vec (concat [1] (repeat 31 0))) (sc/reduce32 l1)))))
  (testing "2^256 - 1 reduces below L, which is the property reduction exists for"
    (is (true? (sc/less-than-order? (sc/reduce32 (vec (repeat 32 255)))))))
  (testing "less-than-order? is exclusive at L"
    (is (false? (sc/less-than-order? sc/order-bytes)))
    (is (true? (sc/less-than-order? (assoc (vec sc/order-bytes) 0
                                          (dec (nth sc/order-bytes 0))))))))

(deftest mul-add-matches-schoolbook
  ;; (a*b + c) mod L, checked against reduce of the same thing computed the
  ;; long way, over small values where both are easy to reason about.
  (doseq [[a b c] [[[2] [3] [1]] [[255] [255] [0]] [[7] [0] [9]]]]
    (let [pad (fn [v] (vec (concat v (repeat (- 32 (count v)) 0))))
          direct (sc/mul-add (pad a) (pad b) (pad c))
          expect (sc/reduce32 (pad [(+ (* (first a) (first b)) (first c))]))]
      (when (< (+ (* (first a) (first b)) (first c)) 256)
        (is (= expect direct) (pr-str [a b c]))))))
