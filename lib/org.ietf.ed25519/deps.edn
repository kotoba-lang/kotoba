{:paths ["src"]
 ;; Two first-party leaves, added for RFC 8032 signing. The key-derivation
 ;; and encoding half of this library still has no dependencies -- it reaches
 ;; the platform's own SHA-512 through a reader conditional -- but sign and
 ;; verify need a PORTABLE hash and portable field arithmetic, and neither
 ;; runtime supplies those.
 :deps {
        io.github.kotoba-lang/error {:local/root "../kotoba.error"}
        io.github.kotoba-lang/bytes {:local/root "../kotoba.bytes"}
        io.github.kotoba-lang/edn {:local/root "../kotoba.edn"}
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}
        io.github.kotoba-lang/org-nist-sha2 {:local/root "../gov.nist.sha2"}
        io.github.kotoba-lang/org-ietf-x25519 {:local/root "../org.ietf.x25519"}}
 :aliases
 {:test {:extra-paths ["test"]}}}
