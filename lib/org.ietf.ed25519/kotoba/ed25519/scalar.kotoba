;; ed25519.scalar -- arithmetic mod L = 2^252 + 27742317777372353535851937790883648493
;; as a pure Kotoba guest (oracle: src/ed25519/scalar.cljk).
;;
;; A scalar is 32 little-endian bytes; the reduction works on BYTE limbs,
;; every intermediate under about 2^22, exact as an i64 -- the TweetNaCl
;; shape, for the same reason the oracle gives.
;;
;; A scalar here is a :document vector of 32 i64 limbs (0..255). 32 is
;; :container-items exactly -- measured as the binding bound -- so a scalar
;; fits with zero headroom and no byte ARRAY of 64 ever exists in the guest.
;; mul-add therefore runs its 32x32 fold through the host-sized accumulator
;; pattern below instead: limbwise, two passes, the same arithmetic the
;; oracle's `assoc` vector fold performs.
;;
;; max-parameters is 5 (measured, amu ABI) -- every loop takes
;; (state, index, one scalar argument) at most.
;;
;; `rem`/`mod` have no admitted lowering (measured); every modulus is
;; spelled `(- x (* n (quot x n)))`, the exact identity the guest has.
;;
;; Compile (single file, JVM-free):
;;   kotoba compile kotoba/ed25519/scalar.kotoba --target wasm32-browser --output scalar.wasm

(ns ed25519.scalar
  (:export [order-byte reduce64 mul-add reduce32 less-than-order?]))

;; --- order constant ---------------------------------------------------------
;; L, little-endian, byte limbs. Derived in the oracle from its definition.

(defn order-byte [i :i64] :i64
  (if (= i 0) 237
      (if (= i 1) 211
          (if (= i 2) 245
              (if (= i 3) 92
                  (if (= i 4) 26
                      (if (= i 5) 99
                          (if (= i 6) 18
                              (if (= i 7) 88
                                  (if (= i 8) 214
                                      (if (= i 9) 156
                                          (if (= i 10) 247
                                              (if (= i 11) 162
                                                  (if (= i 12) 222
                                                      (if (= i 13) 249
                                                          (if (= i 14) 222
                                                              (if (= i 15) 20
                                                                  0)))))))))))))))))

;; --- element access ---------------------------------------------------------

(defn- at [v :document i :i64] :document
  (option-value-of [:option :document] (document-vector-at v i) (document-i64 0)))

(defn- rd [v :document i :i64] :i64
  (option-value-of [:option :i64] (document-i64-value (at v i)) 0))

(defn- is-neg [x :i64] :bool
  (< x 0))

(defn- rem-n [x :i64 n :i64] :i64
  (- x (* n (quot x n))))

(defn- floor-div [x :i64 n :i64] :i64
  (let [q (quot x n)]
    (if (if (is-neg x) (not= (rem-n x n) 0) false)
      (- q 1)
      q)))

(defn- set-at [v :document i :i64 val :i64] :document
  (set-loop v i val 0 (document-vector)))

(defn- set-loop [v :document i :i64 val :i64 p :i64 acc :document] :document
  (if (>= p 32)
    acc
    (set-loop v i val (+ p 1)
              (document-vector-conj acc
                (document-i64 (if (= p i) val (rd v p)))))))

(defn- zero32 [] :document
  (document-vector (document-i64 0) (document-i64 0) (document-i64 0) (document-i64 0)
                   (document-i64 0) (document-i64 0) (document-i64 0) (document-i64 0)
                   (document-i64 0) (document-i64 0) (document-i64 0) (document-i64 0)
                   (document-i64 0) (document-i64 0) (document-i64 0) (document-i64 0)
                   (document-i64 0) (document-i64 0) (document-i64 0) (document-i64 0)
                   (document-i64 0) (document-i64 0) (document-i64 0) (document-i64 0)
                   (document-i64 0) (document-i64 0) (document-i64 0) (document-i64 0)
                   (document-i64 0) (document-i64 0) (document-i64 0) (document-i64 0)))

;; --- reduce64 ---------------------------------------------------------------
;; The oracle's two passes: fold each byte above position 31 downward by
;; subtracting a shifted multiple of L (rounding to nearest with +128),
;; then a final carry pass with the top nibble of limb 31.



;; --- final carry pass -------------------------------------------------------

(defn- carry-final [x :document j :i64 carry :i64] :document
  (if (= j 32)
    (subtract-order x carry 0)
    (let [v (- (+ (rd x j) carry)
               (* (floor-div (rd x 31) 16) (order-byte j)))]
      (carry-final (set-at x j (bit-and v 255)) (+ j 1) (floor-div v 256)))))

(defn- subtract-order [x :document carry :i64 j :i64] :document
  (if (>= j 32)
    x
    (subtract-order (set-at x j (- (rd x j) (* carry (order-byte j)))) carry (+ j 1))))

;; --- byte normalisation -----------------------------------------------------

(defn- normalise [x :document i :i64] :document
  (if (>= i 31)
    x
    (normalise (set-at x (+ i 1) (+ (rd x (+ i 1)) (floor-div (rd x i) 256))) (+ i 1))))

(defn- emit [x :document i :i64 acc :document] :document
  (if (= i 32)
    acc
    (emit (set-at x (+ i 1) (+ (rd x (+ i 1)) (floor-div (rd x i) 256))) (+ i 1)
          (document-vector-conj acc (document-i64 (bit-and (rd x i) 255))))))

(defn- horner-64 [x64 :document i :i64 r :document] :document
  (if (< i 0)
    r
    (let [r2 (reduce-small (document-vector-conj (shl-bytes r) (document-i64 (rd x64 i))))]
      (horner-64 x64 (- i 1) r2))))

(defn reduce64 [x64 :document] :document
  (horner-64 x64 63 (document-vector
                     (document-i64 0) (document-i64 0) (document-i64 0) (document-i64 0)
                     (document-i64 0) (document-i64 0) (document-i64 0) (document-i64 0)
                     (document-i64 0) (document-i64 0) (document-i64 0) (document-i64 0)
                     (document-i64 0) (document-i64 0) (document-i64 0) (document-i64 0)
                     (document-i64 0) (document-i64 0) (document-i64 0) (document-i64 0)
                     (document-i64 0) (document-i64 0) (document-i64 0) (document-i64 0)
                     (document-i64 0) (document-i64 0) (document-i64 0) (document-i64 0)
                     (document-i64 0) (document-i64 0) (document-i64 0) (document-i64 0))))

(defn- reduce-small [x :document] :document
  ;; The oracle's reduce with bytes 32..63 all zero: fold-high has nothing
  ;; to fold, so the final carry pass + order subtraction + emit is the
  ;; whole reduction. Limbs may exceed 255 on entry (Horner's r*256 step),
  ;; which the emit's floor-div carry normalises.
  (let [x2 (carry-final x 0 0)]
    (emit (normalise x2 0) 0 (document-vector))))

(defn reduce32 [b :document] :document
  (reduce-small b))

;; --- mul-add ----------------------------------------------------------------
;; (a*b + c) mod L -- S = (r + k*a) mod L. The oracle accumulates all 1024
;; products into a 64-byte limb vector and reduces once; :container-items is
;; 32 (measured), so that vector cannot be a guest value. The guest computes
;; the same sum mod L by Horner over the multiplier's bytes instead:
;;
;;   a*b = sum_i a_i * (b << 8i), so with r_32 = c and, for i from 31 down
;;   to 0, r_i = (r_{i+1} * 256 + a_i * b) mod L,
;;
;; every step is a 32-byte shift, a 32-byte multiply-add row and a reduce --
;; all mod L, so the answer is the oracle's answer. Each intermediate byte
;; limb stays under about 2^22 + 2^16, inside i64 exactly as the oracle's
;; comment promises for its own limbs.

(defn- shift1 [x :document i :i64 acc :document] :document
  (if (< i 1)
    acc
    (shift1 x (- i 1) (document-vector-conj acc (document-i64 (rd x (- i 1)))))))

(defn- shl-bytes [x :document] :document
  (document-vector-conj (shift1 x 31 (document-vector)) (document-i64 0)))

(defn- row-add [x :document b :document coef :i64 i :i64 acc :document] :document
  (if (>= i 32)
    acc
    (row-add x b coef (+ i 1)
             (set-at acc i (+ (rd acc i) (* coef (rd b i)))))))

(defn mul-add [a :document b :document c :document] :document
  (horner a b c 31))

(defn- horner [a :document b :document r :document i :i64] :document
  (if (< i 0)
    r
    (let [shifted (shl-bytes r)
          summed (row-add shifted b (rd a i) 0 shifted)]
      (horner a b (reduce32 summed) (- i 1)))))

;; --- comparison -------------------------------------------------------------

(defn- less-loop [s :document i :i64] :bool
  (if (< i 0)
    false
    (if (not= (rd s i) (order-byte i))
      (< (rd s i) (order-byte i))
      (less-loop s (- i 1)))))

(defn less-than-order? [s :document] :bool
  (less-loop s 31))
