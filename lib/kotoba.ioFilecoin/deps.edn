;; Four dependencies, all of them things this workspace already had:
;;
;;   org-ietf-blake2  — BLAKE2b at 4, 20 and 32 bytes. Filecoin's address
;;                      checksums, address payloads and CIDs are all this
;;                      hash, and neither runtime provides it.
;;   io-multiformats  — base32 (the same lowercase RFC 4648 alphabet
;;                      addresses use), varint, CIDv1 assembly, hex.
;;   org-ietf-cbor    — definite-length CBOR. A message is a 10-element
;;                      array, and re-encoding has to be byte-exact or the
;;                      CID moves and the signature stops matching.
;;   json             — JSON-RPC bodies. Lotus speaks JSON, the chain speaks
;;                      CBOR, and the two encodings of a message are not
;;                      derivable from each other.
;;
;; No Filecoin SDK, no secp256k1, no BLS: signing is a seam
;; (`filecoin.protocols/ISigner`), so this library never holds a key and
;; never pins itself to one curve implementation.
{:paths ["src"]
 :deps {
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}
        io.github.kotoba-lang/org-ietf-blake2 {:local/root "../org.ietf.blake2"}
        io.github.kotoba-lang/io-multiformats {:local/root "../kotoba.ioMultiformats"}
        io.github.kotoba-lang/org-ietf-cbor {:local/root "../org.ietf.cbor"}
        io.github.kotoba-lang/json {:local/root "../kotoba.json"}}
 :aliases
 {:test {:extra-paths ["test"]}
  ;; classpath only, no :main-opts — `kbb -A:cljs -Spath` resolves the
  ;; git deps for nbb without the deprecation warning `-A` prints when the
  ;; alias carries a main.
  :cljs {:extra-paths ["test"]}
}}
