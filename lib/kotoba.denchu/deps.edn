;; denchu — 電柱広告のドメイン。純 .cljc。
;;
;; 法令面（屋外広告物法・条例・道路占用・建築基準法）と出稿の一般則は
;; kotoba-lang/okugai が正本。電柱はその体系の中の 1 媒体（:utility-pole）で、
;; この repo が持つのは電柱固有の知識だけ —— 柱の識別、供給区域からの候補所有者、
;; 電力/通信各社の指定代理店、巻付/袖の掲出面、公開料金表。
;;
;; 第一の runtime は ClojureScript / nbb（AGENTS.md の runtime 優先順位）。
{:paths ["src"]
 :deps {
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}
        io.github.kotoba-lang/okugai {:local/root "../kotoba.okugai"}}
 :aliases {:test {:extra-paths ["test"]}}}
