(ns sbml.model
  "SBML Level 3 Version 2 Core (systems biology) model as EDN. Zero
  third-party deps -- portable .cljc (JVM, ClojureScript, SCI). A model is a
  plain namespaced-key map you can assoc, diff, store in Datomic, or
  generate; this namespace adds threading-friendly builders and the
  structural queries sbml.validate/sbml.execute need.

  A model (sec 4.2 Model; the various listOf* children are sec 4.2.7's
  ListOf container classes):
    {:sbml/id \"repressilator\"
     :sbml/compartments {\"cell\" {:sbml/id \"cell\" :sbml/spatial-dimensions 3.0
                                  :sbml/size 1.0 :sbml/constant true}}
     :sbml/species {\"A\" {:sbml/id \"A\" :sbml/compartment \"cell\"
                          :sbml/initial-amount 100.0
                          :sbml/has-only-substance-units? false
                          :sbml/boundary-condition? false :sbml/constant false}}
     :sbml/parameters {\"k\" {:sbml/id \"k\" :sbml/value 0.1 :sbml/constant true}}
     :sbml/reactions {\"decay\" {:sbml/id \"decay\" :sbml/reversible false
                                :sbml/reactants [{:sbml/species \"A\" :sbml/stoichiometry 1.0 :sbml/constant true}]
                                :sbml/products [] :sbml/modifiers []
                                :sbml/kinetic-law {:sbml/math [:apply :times [[:ci \"k\"] [:ci \"A\"]]]}}}
     :sbml/rules []
     :sbml/unit-definitions {}
     :sbml/events []}

  Compartment (sec 4.5): :sbml/id (4.5.1, required), :sbml/spatial-dimensions
  (4.5.2, optional double), :sbml/size (4.5.3, optional double -- ABSENT is
  meaningful ('unknown/externally determined'), not the same as 0 or 1),
  :sbml/units (4.5.4, optional), :sbml/constant (4.5.5, mandatory boolean --
  the builder defaults it to `true` as a convenience; the spec itself
  defines no default, see sbml.validate).

  Species (sec 4.6): :sbml/id (4.6.1), :sbml/compartment (4.6.3, required --
  SBML has no notion of a default compartment), :sbml/initial-amount XOR
  :sbml/initial-concentration (4.6.4, both optional, mutually exclusive --
  setting both is an SBML error), :sbml/substance-units (4.6.4, optional),
  :sbml/has-only-substance-units? (4.6.5, mandatory boolean -- whether the
  species id means an amount always, vs. amount/size i.e. concentration),
  :sbml/constant and :sbml/boundary-condition? (4.6.6, both mandatory
  booleans; Table 4 there defines the 4 meaningful combinations),
  :sbml/conversion-factor (4.6.7, optional, id of a constant Parameter).

  Parameter (sec 4.7), global (in :sbml/parameters) or local (nested in a
  KineticLaw's :sbml/local-parameters, sec 4.11.6): :sbml/id (required),
  :sbml/value (4.7.2, optional double -- absent means unknown/externally
  determined), :sbml/units (4.7.3, optional), :sbml/constant (4.7.4,
  mandatory boolean, global parameters only -- LocalParameter has no
  constant attribute, sec 4.11.6, since it is fixed for the reaction's scope).

  Reaction (sec 4.11.1): :sbml/id (required), :sbml/reversible (mandatory
  boolean, no spec default), :sbml/reactants/:sbml/products (vectors of
  SpeciesReference, sec 4.11.3: :sbml/species + :sbml/stoichiometry
  [optional double] + :sbml/constant [mandatory boolean] + optional
  :sbml/id -- a species may legally repeat across entries, sec 4.11.3
  'effective stoichiometry' example, so these are vectors, not maps),
  :sbml/modifiers (vector of ModifierSpeciesReference, sec 4.11.4: just
  :sbml/species, no stoichiometry), :sbml/kinetic-law (optional, sec 4.11.5:
  :sbml/math is a sbml.mathml expr tree defining the rate, sec 4.11.2/3/4
  restrict which species identifiers may appear in it to the reaction's own
  reactant/product/modifier lists; :sbml/local-parameters is a
  {id -> LocalParameter} map scoped to this reaction only, sec 4.11.6).

  Rule (sec 4.9): {:sbml/rule-type :assignment|:rate|:algebraic
  :sbml/variable id  ; absent for :algebraic (sec 4.9.2 -- an AlgebraicRule
                       has no variable, only a math expression that must
                       equal zero)
  :sbml/math expr}   ; AssignmentRule sec 4.9.3, RateRule sec 4.9.4.
  Kept as a vector (:sbml/rules), not a map-by-variable, because
  AlgebraicRule has no key to map by.

  UnitDefinition/Unit (sec 4.4, structural only -- no dimensional analysis,
  see README): {:sbml/id id :sbml/units [{:sbml/kind \"mole\" :sbml/exponent 1.0
  :sbml/scale 0.0 :sbml/multiplier 1.0} ...]}. Semantics (sec 4.4.2 Eq. 1):
  u_new = (multiplier * 10^scale * u_kind)^exponent.

  Event (sec 4.12, structural only -- sbml.execute never simulates events,
  same v2 scope-out as XMILE's conveyor/queue stocks): kept as opaque maps
  in :sbml/events; see sbml.xml for the shape round-tripped through XML.")

;; --- builders (all return plain maps; thread with add-*) ---

(defn compartment
  "Build a :sbml/compartment map (sec 4.5). `opts` may set :sbml/size,
  :sbml/units, :sbml/spatial-dimensions (default 3.0), :sbml/constant
  (default true -- a builder convenience, not a spec default)."
  ([id] (compartment id nil))
  ([id opts] (merge {:sbml/id id :sbml/spatial-dimensions 3.0 :sbml/constant true} opts)))

(defn species
  "Build a :sbml/species map (sec 4.6). `compartment-id` is required (sec
  4.6.3). `opts` should set exactly one of :sbml/initial-amount /
  :sbml/initial-concentration (sec 4.6.4); defaults :sbml/constant,
  :sbml/boundary-condition?, :sbml/has-only-substance-units? to false
  (the most common 'ordinary dynamic species' case)."
  ([id compartment-id] (species id compartment-id nil))
  ([id compartment-id opts]
   (merge {:sbml/id id :sbml/compartment compartment-id
           :sbml/has-only-substance-units? false
           :sbml/boundary-condition? false
           :sbml/constant false}
          opts)))

(defn parameter
  "Build a global :sbml/parameter map (sec 4.7). `opts` should set
  :sbml/value (4.7.2); defaults :sbml/constant to true (the common case for
  rate constants -- set false explicitly for parameters a rule/event varies)."
  ([id] (parameter id nil))
  ([id opts] (merge {:sbml/id id :sbml/constant true} opts)))

(defn local-parameter
  "Build a LocalParameter map (sec 4.11.6) -- scoped to one reaction's
  KineticLaw, no :sbml/constant attribute (it is implicitly fixed)."
  ([id] (local-parameter id nil))
  ([id opts] (merge {:sbml/id id} opts)))

(defn species-ref
  "Build a SpeciesReference map (sec 4.11.3) for a reaction's
  :sbml/reactants/:sbml/products. `stoichiometry` defaults to 1.0;
  :sbml/constant defaults to true (the common fixed-stoichiometry case)."
  ([species-id] (species-ref species-id 1.0))
  ([species-id stoichiometry] (species-ref species-id stoichiometry nil))
  ([species-id stoichiometry opts]
   (merge {:sbml/species species-id :sbml/stoichiometry stoichiometry :sbml/constant true} opts)))

(defn modifier-ref
  "Build a ModifierSpeciesReference map (sec 4.11.4) for a reaction's
  :sbml/modifiers -- just a species id, no stoichiometry (modifiers have no
  mathematical meaning of their own in Core)."
  [species-id]
  {:sbml/species species-id})

(defn kinetic-law
  "Build a :sbml/kinetic-law map (sec 4.11.5). `math` is a sbml.mathml expr
  tree for the rate. `opts` may set :sbml/local-parameters
  ({id -> local-parameter}, sec 4.11.6)."
  ([math] (kinetic-law math nil))
  ([math opts] (merge {:sbml/math math} opts)))

(defn reaction
  "Build a :sbml/reaction map (sec 4.11.1). :sbml/reversible defaults to
  false (the spec defines no default; this is a builder convenience).
  :sbml/reactants/:sbml/products/:sbml/modifiers default to empty vectors;
  thread species-ref/modifier-ref in via `opts` or assoc afterward. A valid
  SBML reaction must have at least one reactant or product (sec 4.11.1) --
  see sbml.validate."
  ([id] (reaction id nil))
  ([id opts]
   (merge {:sbml/id id :sbml/reversible false
           :sbml/reactants [] :sbml/products [] :sbml/modifiers []}
          opts)))

(defn assignment-rule
  "Build an AssignmentRule (sec 4.9.3): sets `variable`'s value to `math`
  at all simulation times."
  [variable math]
  {:sbml/rule-type :assignment :sbml/variable variable :sbml/math math})

(defn rate-rule
  "Build a RateRule (sec 4.9.4): `math` defines d(variable)/dt."
  [variable math]
  {:sbml/rule-type :rate :sbml/variable variable :sbml/math math})

(defn algebraic-rule
  "Build an AlgebraicRule (sec 4.9.2): `math` must evaluate to zero at all
  times; has no :sbml/variable of its own (see sbml.execute Follow-ups --
  full DAG/DAE solving for algebraic rules is a v2 scope-out)."
  [math]
  {:sbml/rule-type :algebraic :sbml/math math})

(defn unit
  "Build a Unit map (sec 4.4.2). u_new = (multiplier * 10^scale *
  u_kind)^exponent; defaults are the identity transform (exponent 1,
  scale 0, multiplier 1)."
  ([kind] (unit kind nil))
  ([kind opts] (merge {:sbml/kind kind :sbml/exponent 1.0 :sbml/scale 0.0 :sbml/multiplier 1.0} opts)))

(defn unit-definition
  "Build a :sbml/unit-definition map (sec 4.4.1): `units` is a vector of
  `unit` maps combined multiplicatively."
  [id units]
  {:sbml/id id :sbml/units (vec units)})

(defn model
  "Build an empty (or opts-seeded) :sbml/model map (sec 4.2)."
  ([id] (model id nil))
  ([id opts]
   (merge {:sbml/id id
           :sbml/compartments {} :sbml/species {} :sbml/parameters {}
           :sbml/reactions {} :sbml/rules [] :sbml/unit-definitions {} :sbml/events []}
          opts)))

(defn add-compartment [m c] (assoc-in m [:sbml/compartments (:sbml/id c)] c))
(defn add-species [m s] (assoc-in m [:sbml/species (:sbml/id s)] s))
(defn add-parameter [m p] (assoc-in m [:sbml/parameters (:sbml/id p)] p))
(defn add-reaction [m r] (assoc-in m [:sbml/reactions (:sbml/id r)] r))
(defn add-rule [m r] (update m :sbml/rules (fnil conj []) r))
(defn add-unit-definition [m ud] (assoc-in m [:sbml/unit-definitions (:sbml/id ud)] ud))
(defn add-event [m e] (update m :sbml/events (fnil conj []) e))

;; --- queries ---

(defn compartments [m] (vals (:sbml/compartments m {})))
(defn all-species [m] (vals (:sbml/species m {})))
(defn parameters [m] (vals (:sbml/parameters m {})))
(defn reactions [m] (vals (:sbml/reactions m {})))
(defn rules [m] (:sbml/rules m []))
(defn unit-definitions [m] (vals (:sbml/unit-definitions m {})))
(defn events [m] (:sbml/events m []))

(defn lookup-compartment [m id] (get (:sbml/compartments m {}) id))
(defn lookup-species [m id] (get (:sbml/species m {}) id))
(defn lookup-parameter [m id] (get (:sbml/parameters m {}) id))
(defn lookup-reaction [m id] (get (:sbml/reactions m {}) id))

(defn compartment-ids [m] (set (keys (:sbml/compartments m {}))))
(defn species-ids [m] (set (keys (:sbml/species m {}))))
(defn parameter-ids [m] (set (keys (:sbml/parameters m {}))))
(defn reaction-ids [m] (set (keys (:sbml/reactions m {}))))

(defn rule-type? [t r] (= t (:sbml/rule-type r)))
(defn assignment-rules [m] (filter #(rule-type? :assignment %) (rules m)))
(defn rate-rules [m] (filter #(rule-type? :rate %) (rules m)))
(defn algebraic-rules [m] (filter #(rule-type? :algebraic %) (rules m)))

(defn reactants [r] (:sbml/reactants r []))
(defn products [r] (:sbml/products r []))
(defn modifiers [r] (:sbml/modifiers r []))
(defn kinetic-law-of [r] (:sbml/kinetic-law r))
(defn has-kinetic-law? [r] (some? (:sbml/kinetic-law r)))
(defn local-parameters-of [r] (vals (get-in r [:sbml/kinetic-law :sbml/local-parameters] {})))
(defn local-parameter-ids [r] (set (keys (get-in r [:sbml/kinetic-law :sbml/local-parameters] {}))))
(defn species-reference-ids
  "SpeciesReference :sbml/id values (optional per sec 4.11.3) that are
  themselves usable as `ci` identifiers standing for that reference's
  stoichiometry."
  [r]
  (set (keep :sbml/id (concat (reactants r) (products r)))))

(defn known-ids
  "The global SId namespace visible to any math element in the model:
  species, compartment, and (global) parameter identifiers, plus reaction
  identifiers (sec 4.11.8: a reaction id stands for its rate and may be
  referenced in math elsewhere)."
  [m]
  (into (into (into (species-ids m) (compartment-ids m)) (parameter-ids m)) (reaction-ids m)))
