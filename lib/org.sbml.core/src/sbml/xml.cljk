(ns sbml.xml
  "Convert between an already-parsed SBML XML element tree and the
  sbml.model EDN. Does NOT parse XML text -- the host parses XML first
  (e.g. clojure.data.xml on the JVM, DOMParser/goog.dom.xml on
  ClojureScript) into the generic shape `{:tag :compartment :attrs {...}
  :content [...]}` (exactly what clojure.data.xml/parse or cljs.xml/parse
  already produce); this namespace is pure data transformation, zero I/O,
  zero XML-parsing deps. `<math>` children are delegated to sbml.mathml,
  which speaks this same generic element shape.

  Round-trip guarantee (for well-formed data):
    (= model (parse-model (emit-model model)))
    (= doc   (parse-doc   (emit-doc   doc)))

  Covers the structural elements needed to reconstruct a runnable model:
  <model>/<listOfCompartments>/<listOfSpecies>/<listOfParameters>/
  <listOfReactions>/<listOfRules>/<listOfUnitDefinitions>/<listOfEvents>
  (sec 4.2.7). Does NOT cover SBML Level 3 packages (spatial, multi, comp,
  qual, ...), <listOfFunctionDefinitions>/<listOfInitialAssignments>/
  <listOfConstraints>, or the <notes>/<annotation> children every SBase has
  -- all v2 scope-outs, see README Follow-ups."
  (:require [sbml.mathml :as mathml]))

;; --- generic parsed-XML element accessors (same shape/boundary as xmile.xml) ---

(defn- tag-kw [t] (keyword (name t)))
(defn- tag= [e t] (and (map? e) (= (tag-kw (:tag e)) t)))
(defn- elem-children [e] (filter map? (:content e)))
(defn- by-tag [e t] (filter #(tag= % t) (elem-children e)))
(defn- first-child [e t] (first (by-tag e t)))
(defn- attr [e k] (get (:attrs e) k))
(defn- elem [tag attrs content] (cond-> {:tag tag} (seq attrs) (assoc :attrs attrs) true (assoc :content (vec content))))

(defn- parse-num [s] #?(:clj (Double/parseDouble s) :cljs (js/parseFloat s)))
(defn- num->str [n] (str (double n)))
(defn- parse-bool [s] (= s "true"))
(defn- bool->str [b] (str (boolean b)))

(defn- math-of [e] (some-> (first-child e :math) mathml/parse-math))
(defn- emit-math-child [expr] (when expr [(mathml/emit-math expr)]))

;; --- Unit / UnitDefinition (sec 4.4) ---

(defn parse-unit [e]
  {:sbml/kind (attr e :kind)
   :sbml/exponent (parse-num (attr e :exponent))
   :sbml/scale (parse-num (attr e :scale))
   :sbml/multiplier (parse-num (attr e :multiplier))})

(defn emit-unit [u]
  (elem :unit {:kind (:sbml/kind u)
               :exponent (num->str (:sbml/exponent u))
               :scale (num->str (:sbml/scale u))
               :multiplier (num->str (:sbml/multiplier u))}
        []))

(defn parse-unit-definition [e]
  {:sbml/id (attr e :id)
   :sbml/units (mapv parse-unit (by-tag (first-child e :listOfUnits) :unit))})

(defn emit-unit-definition [ud]
  (elem :unitDefinition {:id (:sbml/id ud)}
        [(elem :listOfUnits {} (map emit-unit (:sbml/units ud)))]))

;; --- Compartment (sec 4.5) ---

(defn parse-compartment
  "Note: :sbml/constant (mandatory per sec 4.5.5, no spec default) is only
  assoc'd when the XML actually carries a constant attribute -- absence is
  preserved as absence (a validate-time :error, see sbml.validate), never
  silently coerced to false."
  [e]
  (cond-> {:sbml/id (attr e :id)}
    (attr e :spatialDimensions) (assoc :sbml/spatial-dimensions (parse-num (attr e :spatialDimensions)))
    (attr e :size) (assoc :sbml/size (parse-num (attr e :size)))
    (attr e :units) (assoc :sbml/units (attr e :units))
    (attr e :constant) (assoc :sbml/constant (parse-bool (attr e :constant)))))

(defn emit-compartment [c]
  (elem :compartment
        (cond-> {:id (:sbml/id c)}
          (:sbml/spatial-dimensions c) (assoc :spatialDimensions (num->str (:sbml/spatial-dimensions c)))
          (:sbml/size c) (assoc :size (num->str (:sbml/size c)))
          (:sbml/units c) (assoc :units (:sbml/units c))
          true (assoc :constant (bool->str (:sbml/constant c))))
        []))

;; --- Species (sec 4.6) ---

(defn parse-species
  "Mandatory booleans (sec 4.6.5/4.6.6, no spec defaults) are only assoc'd
  when actually present in the XML -- see parse-compartment docstring."
  [e]
  (cond-> {:sbml/id (attr e :id) :sbml/compartment (attr e :compartment)}
    (attr e :initialAmount) (assoc :sbml/initial-amount (parse-num (attr e :initialAmount)))
    (attr e :initialConcentration) (assoc :sbml/initial-concentration (parse-num (attr e :initialConcentration)))
    (attr e :substanceUnits) (assoc :sbml/substance-units (attr e :substanceUnits))
    (attr e :hasOnlySubstanceUnits) (assoc :sbml/has-only-substance-units? (parse-bool (attr e :hasOnlySubstanceUnits)))
    (attr e :boundaryCondition) (assoc :sbml/boundary-condition? (parse-bool (attr e :boundaryCondition)))
    (attr e :constant) (assoc :sbml/constant (parse-bool (attr e :constant)))
    (attr e :conversionFactor) (assoc :sbml/conversion-factor (attr e :conversionFactor))))

(defn emit-species [s]
  (elem :species
        (cond-> {:id (:sbml/id s) :compartment (:sbml/compartment s)}
          (:sbml/initial-amount s) (assoc :initialAmount (num->str (:sbml/initial-amount s)))
          (:sbml/initial-concentration s) (assoc :initialConcentration (num->str (:sbml/initial-concentration s)))
          (:sbml/substance-units s) (assoc :substanceUnits (:sbml/substance-units s))
          true (assoc :hasOnlySubstanceUnits (bool->str (:sbml/has-only-substance-units? s)))
          true (assoc :boundaryCondition (bool->str (:sbml/boundary-condition? s)))
          true (assoc :constant (bool->str (:sbml/constant s)))
          (:sbml/conversion-factor s) (assoc :conversionFactor (:sbml/conversion-factor s)))
        []))

;; --- Parameter / LocalParameter (sec 4.7 / 4.11.6) ---

(defn parse-parameter
  "Mandatory :sbml/constant (sec 4.7.4, no spec default) is only assoc'd
  when actually present -- see parse-compartment docstring."
  [e]
  (cond-> {:sbml/id (attr e :id)}
    (attr e :value) (assoc :sbml/value (parse-num (attr e :value)))
    (attr e :units) (assoc :sbml/units (attr e :units))
    (attr e :constant) (assoc :sbml/constant (parse-bool (attr e :constant)))))

(defn emit-parameter [p]
  (elem :parameter
        (cond-> {:id (:sbml/id p)}
          (:sbml/value p) (assoc :value (num->str (:sbml/value p)))
          (:sbml/units p) (assoc :units (:sbml/units p))
          true (assoc :constant (bool->str (:sbml/constant p))))
        []))

(defn parse-local-parameter [e]
  (cond-> {:sbml/id (attr e :id)}
    (attr e :value) (assoc :sbml/value (parse-num (attr e :value)))
    (attr e :units) (assoc :sbml/units (attr e :units))))

(defn emit-local-parameter [p]
  (elem :localParameter
        (cond-> {:id (:sbml/id p)}
          (:sbml/value p) (assoc :value (num->str (:sbml/value p)))
          (:sbml/units p) (assoc :units (:sbml/units p)))
        []))

;; --- SpeciesReference / ModifierSpeciesReference (sec 4.11.2/3/4) ---

(defn parse-species-ref
  "Mandatory :sbml/constant (sec 4.11.3, no spec default) is only assoc'd
  when actually present -- see parse-compartment docstring."
  [e]
  (cond-> {:sbml/species (attr e :species)}
    (attr e :id) (assoc :sbml/id (attr e :id))
    (attr e :stoichiometry) (assoc :sbml/stoichiometry (parse-num (attr e :stoichiometry)))
    (attr e :constant) (assoc :sbml/constant (parse-bool (attr e :constant)))))

(defn emit-species-ref [sr]
  (elem :speciesReference
        (cond-> {:species (:sbml/species sr)}
          (:sbml/id sr) (assoc :id (:sbml/id sr))
          (:sbml/stoichiometry sr) (assoc :stoichiometry (num->str (:sbml/stoichiometry sr)))
          true (assoc :constant (bool->str (:sbml/constant sr))))
        []))

(defn parse-modifier-ref [e] {:sbml/species (attr e :species)})
(defn emit-modifier-ref [mr] (elem :modifierSpeciesReference {:species (:sbml/species mr)} []))

;; --- KineticLaw (sec 4.11.5) ---

(defn parse-kinetic-law [e]
  (cond-> {}
    (first-child e :math) (assoc :sbml/math (math-of e))
    (first-child e :listOfLocalParameters)
    (assoc :sbml/local-parameters
           (into {} (for [lp (by-tag (first-child e :listOfLocalParameters) :localParameter)]
                      (let [plp (parse-local-parameter lp)] [(:sbml/id plp) plp]))))))

(defn emit-kinetic-law [kl]
  (elem :kineticLaw {}
        (concat (emit-math-child (:sbml/math kl))
                (when (seq (:sbml/local-parameters kl))
                  [(elem :listOfLocalParameters {} (map emit-local-parameter (vals (:sbml/local-parameters kl))))]))))

;; --- Reaction (sec 4.11.1) ---

(defn parse-reaction
  "Mandatory :sbml/reversible (sec 4.11.1, no spec default) is only assoc'd
  when actually present -- see parse-compartment docstring."
  [e]
  (cond-> {:sbml/id (attr e :id)
           :sbml/reactants (mapv parse-species-ref (by-tag (first-child e :listOfReactants) :speciesReference))
           :sbml/products (mapv parse-species-ref (by-tag (first-child e :listOfProducts) :speciesReference))
           :sbml/modifiers (mapv parse-modifier-ref (by-tag (first-child e :listOfModifiers) :modifierSpeciesReference))}
    (attr e :reversible) (assoc :sbml/reversible (parse-bool (attr e :reversible)))
    (attr e :compartment) (assoc :sbml/compartment (attr e :compartment))
    (first-child e :kineticLaw) (assoc :sbml/kinetic-law (parse-kinetic-law (first-child e :kineticLaw)))))

(defn emit-reaction [r]
  (elem :reaction
        (cond-> {:id (:sbml/id r) :reversible (bool->str (:sbml/reversible r))}
          (:sbml/compartment r) (assoc :compartment (:sbml/compartment r)))
        (concat
         (when (seq (:sbml/reactants r)) [(elem :listOfReactants {} (map emit-species-ref (:sbml/reactants r)))])
         (when (seq (:sbml/products r)) [(elem :listOfProducts {} (map emit-species-ref (:sbml/products r)))])
         (when (seq (:sbml/modifiers r)) [(elem :listOfModifiers {} (map emit-modifier-ref (:sbml/modifiers r)))])
         (when (:sbml/kinetic-law r) [(emit-kinetic-law (:sbml/kinetic-law r))]))))

;; --- Rules (sec 4.9) ---

(defn parse-rule [e]
  (case (tag-kw (:tag e))
    :assignmentRule {:sbml/rule-type :assignment :sbml/variable (attr e :variable) :sbml/math (math-of e)}
    :rateRule {:sbml/rule-type :rate :sbml/variable (attr e :variable) :sbml/math (math-of e)}
    :algebraicRule {:sbml/rule-type :algebraic :sbml/math (math-of e)}
    (throw (ex-info "sbml.xml: unknown rule tag" {:tag (:tag e)}))))

(defn emit-rule [r]
  (case (:sbml/rule-type r)
    :assignment (elem :assignmentRule {:variable (:sbml/variable r)} (emit-math-child (:sbml/math r)))
    :rate (elem :rateRule {:variable (:sbml/variable r)} (emit-math-child (:sbml/math r)))
    :algebraic (elem :algebraicRule {} (emit-math-child (:sbml/math r)))))

;; --- Events (sec 4.12, structural only -- sbml.execute never simulates
;;     them, the same v2 scope-out as XMILE's conveyor/queue stocks) ---

(defn- parse-trigger [e]
  (cond-> {:sbml/math (math-of e)}
    (attr e :persistent) (assoc :sbml/persistent? (parse-bool (attr e :persistent)))
    (attr e :initialValue) (assoc :sbml/initial-value? (parse-bool (attr e :initialValue)))))

(defn- emit-trigger [t]
  (elem :trigger {:persistent (bool->str (:sbml/persistent? t)) :initialValue (bool->str (:sbml/initial-value? t))}
        (emit-math-child (:sbml/math t))))

(defn- parse-event-assignment [e]
  {:sbml/variable (attr e :variable) :sbml/math (math-of e)})

(defn- emit-event-assignment [ea]
  (elem :eventAssignment {:variable (:sbml/variable ea)} (emit-math-child (:sbml/math ea))))

(defn parse-event [e]
  (cond-> {}
    (attr e :useValuesFromTriggerTime)
    (assoc :sbml/use-values-from-trigger-time? (parse-bool (attr e :useValuesFromTriggerTime)))
    (attr e :id) (assoc :sbml/id (attr e :id))
    (first-child e :trigger) (assoc :sbml/trigger (parse-trigger (first-child e :trigger)))
    (first-child e :priority) (assoc :sbml/priority {:sbml/math (math-of (first-child e :priority))})
    (first-child e :delay) (assoc :sbml/delay {:sbml/math (math-of (first-child e :delay))})
    (first-child e :listOfEventAssignments)
    (assoc :sbml/event-assignments
           (mapv parse-event-assignment (by-tag (first-child e :listOfEventAssignments) :eventAssignment)))))

(defn emit-event [ev]
  (elem :event
        (cond-> {:useValuesFromTriggerTime (bool->str (:sbml/use-values-from-trigger-time? ev))}
          (:sbml/id ev) (assoc :id (:sbml/id ev)))
        (concat
         (when (:sbml/trigger ev) [(emit-trigger (:sbml/trigger ev))])
         (when (:sbml/priority ev) [(elem :priority {} (emit-math-child (:sbml/math (:sbml/priority ev))))])
         (when (:sbml/delay ev) [(elem :delay {} (emit-math-child (:sbml/math (:sbml/delay ev))))])
         (when (seq (:sbml/event-assignments ev))
           [(elem :listOfEventAssignments {} (map emit-event-assignment (:sbml/event-assignments ev)))]))))

;; --- Model (sec 4.2) ---

(defn- parse-listof [e list-tag item-tag parse-item id-key]
  (into {} (for [item (by-tag (first-child e list-tag) item-tag)
                 :let [parsed (parse-item item)]]
             [(id-key parsed) parsed])))

(defn parse-model [e]
  (cond-> {:sbml/compartments (parse-listof e :listOfCompartments :compartment parse-compartment :sbml/id)
           :sbml/species (parse-listof e :listOfSpecies :species parse-species :sbml/id)
           :sbml/parameters (parse-listof e :listOfParameters :parameter parse-parameter :sbml/id)
           :sbml/reactions (parse-listof e :listOfReactions :reaction parse-reaction :sbml/id)
           :sbml/unit-definitions (parse-listof e :listOfUnitDefinitions :unitDefinition parse-unit-definition :sbml/id)
           :sbml/rules (if-let [lr (first-child e :listOfRules)] (mapv parse-rule (elem-children lr)) [])
           :sbml/events (if-let [le (first-child e :listOfEvents)] (mapv parse-event (by-tag le :event)) [])}
    (attr e :id) (assoc :sbml/id (attr e :id))))

(defn emit-model [m]
  (elem :model
        (cond-> {} (:sbml/id m) (assoc :id (:sbml/id m)))
        (cond-> []
          (seq (:sbml/unit-definitions m))
          (conj (elem :listOfUnitDefinitions {} (map emit-unit-definition (vals (:sbml/unit-definitions m)))))
          (seq (:sbml/compartments m))
          (conj (elem :listOfCompartments {} (map emit-compartment (vals (:sbml/compartments m)))))
          (seq (:sbml/species m))
          (conj (elem :listOfSpecies {} (map emit-species (vals (:sbml/species m)))))
          (seq (:sbml/parameters m))
          (conj (elem :listOfParameters {} (map emit-parameter (vals (:sbml/parameters m)))))
          (seq (:sbml/rules m))
          (conj (elem :listOfRules {} (map emit-rule (:sbml/rules m))))
          (seq (:sbml/reactions m))
          (conj (elem :listOfReactions {} (map emit-reaction (vals (:sbml/reactions m)))))
          (seq (:sbml/events m))
          (conj (elem :listOfEvents {} (map emit-event (:sbml/events m)))))))

;; --- top-level <sbml> document ---

(defn parse-doc
  "Parse a full <sbml> root element into {:sbml/level .. :sbml/version ..
  :sbml/model ..}."
  [root]
  (cond-> {}
    (attr root :level) (assoc :sbml/level (attr root :level))
    (attr root :version) (assoc :sbml/version (attr root :version))
    (first-child root :model) (assoc :sbml/model (parse-model (first-child root :model)))))

(defn emit-doc [doc]
  (elem :sbml
        {:xmlns "http://www.sbml.org/sbml/level3/version2/core"
         :level (:sbml/level doc "3") :version (:sbml/version doc "2")}
        (when (:sbml/model doc) [(emit-model (:sbml/model doc))])))
