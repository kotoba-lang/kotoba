(ns sbml.xml-test
  "Round-trip tests use double literals throughout (1.0, not 1) because
  sbml.xml's wire format is text -- parse-num always yields a double, so a
  fixture built with integer literals would legitimately fail `=` after a
  round trip (Clojure's `=` distinguishes 50 from 50.0) even though nothing
  is actually broken."
  (:require #?(:clj [kotoba.test :refer [deftest is]]
               :cljs [cljs.test :refer-macros [deftest is]])
            [sbml.model :as m]
            [sbml.xml :as xml]))

(deftest compartment-round-trip
  (doseq [c [(m/compartment "cell")
             (m/compartment "cell" {:sbml/size 1.0e-14 :sbml/spatial-dimensions 2.0 :sbml/units "litre"})
             (m/compartment "cell" {:sbml/constant false})]]
    (is (= c (xml/parse-compartment (xml/emit-compartment c))) (str "round-trip failed for " c))))

(deftest species-round-trip
  (doseq [s [(m/species "A" "cell" {:sbml/initial-amount 100.0})
             (m/species "A" "cell" {:sbml/initial-concentration 4.0 :sbml/has-only-substance-units? true})
             (m/species "A" "cell" {:sbml/initial-amount 1.0 :sbml/substance-units "mole"
                                     :sbml/conversion-factor "cf" :sbml/boundary-condition? true
                                     :sbml/constant true})]]
    (is (= s (xml/parse-species (xml/emit-species s))) (str "round-trip failed for " s))))

(deftest parameter-round-trip
  (doseq [p [(m/parameter "k" {:sbml/value 0.1})
             (m/parameter "k" {:sbml/value 0.1 :sbml/units "per_second" :sbml/constant false})
             (m/parameter "k")]]
    (is (= p (xml/parse-parameter (xml/emit-parameter p))) (str "round-trip failed for " p))))

(deftest species-ref-round-trip
  (doseq [sr [(m/species-ref "A")
              (m/species-ref "A" 2.0)
              (m/species-ref "A" 2.0 {:sbml/id "sr1" :sbml/constant false})]]
    (is (= sr (xml/parse-species-ref (xml/emit-species-ref sr))) (str "round-trip failed for " sr))))

(deftest kinetic-law-round-trip
  (doseq [kl [(m/kinetic-law [:apply :times [[:ci "k"] [:ci "A"]]])
              (m/kinetic-law [:ci "k_local"] {:sbml/local-parameters
                                               {"k_local" (m/local-parameter "k_local" {:sbml/value 1.0})}})]]
    (is (= kl (xml/parse-kinetic-law (xml/emit-kinetic-law kl))) (str "round-trip failed for " kl))))

(deftest reaction-round-trip
  (let [r (-> (m/reaction "r1" {:sbml/reversible true :sbml/compartment "cell"})
              (assoc :sbml/reactants [(m/species-ref "A" 2.0)]
                     :sbml/products [(m/species-ref "B")]
                     :sbml/modifiers [(m/modifier-ref "E")]
                     :sbml/kinetic-law (m/kinetic-law [:apply :times [[:ci "k"] [:ci "A"]]])))]
    (is (= r (xml/parse-reaction (xml/emit-reaction r))))))

(deftest rule-round-trip
  (doseq [r [(m/assignment-rule "X" [:apply :times [[:cn 2.0] [:ci "P"]]])
             (m/rate-rule "X" [:cn 1.0])
             (m/algebraic-rule [:apply :minus [[:ci "X"] [:ci "Y"]]])]]
    (is (= r (xml/parse-rule (xml/emit-rule r))) (str "round-trip failed for " r))))

(deftest unit-definition-round-trip
  (let [ud (m/unit-definition "per_second" [(m/unit "second" {:sbml/exponent -1.0})])]
    (is (= ud (xml/parse-unit-definition (xml/emit-unit-definition ud))))))

(deftest event-round-trip
  (let [ev {:sbml/id "e1" :sbml/use-values-from-trigger-time? true
            :sbml/trigger {:sbml/persistent? true :sbml/initial-value? false
                           :sbml/math [:apply :gt [[:ci "S"] [:cn 10.0]]]}
            :sbml/event-assignments [{:sbml/variable "S" :sbml/math [:cn 0.0]}]}]
    (is (= ev (xml/parse-event (xml/emit-event ev))))))

(deftest model-round-trip
  (let [model (-> (m/model "decay")
                  (m/add-compartment (m/compartment "cell" {:sbml/size 1.0}))
                  (m/add-species (m/species "A" "cell" {:sbml/initial-amount 100.0}))
                  (m/add-species (m/species "B" "cell" {:sbml/initial-amount 0.0}))
                  (m/add-parameter (m/parameter "k" {:sbml/value 0.1}))
                  (m/add-reaction (-> (m/reaction "r1")
                                      (assoc :sbml/reactants [(m/species-ref "A")]
                                             :sbml/products [(m/species-ref "B")]
                                             :sbml/kinetic-law (m/kinetic-law [:apply :times [[:ci "k"] [:ci "A"]]])))))]
    (is (= model (xml/parse-model (xml/emit-model model))))))

(deftest model-with-rules-and-units-round-trip
  (let [model (-> (m/model "m")
                  (m/add-parameter (m/parameter "P" {:sbml/value 0.0 :sbml/constant false}))
                  (m/add-rule (m/rate-rule "P" [:cn 1.0]))
                  (m/add-unit-definition (m/unit-definition "per_second" [(m/unit "second" {:sbml/exponent -1.0})])))]
    (is (= model (xml/parse-model (xml/emit-model model))))))

(deftest doc-round-trip
  (let [doc {:sbml/level "3" :sbml/version "2"
             :sbml/model (-> (m/model "m")
                             (m/add-compartment (m/compartment "c" {:sbml/size 1.0}))
                             (m/add-species (m/species "A" "c" {:sbml/initial-amount 1.0})))}]
    (is (= doc (xml/parse-doc (xml/emit-doc doc))))))
