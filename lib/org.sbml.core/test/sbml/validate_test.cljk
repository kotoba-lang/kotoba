(ns sbml.validate-test
  (:require #?(:clj [kotoba.test :refer [deftest is testing]]
               :cljs [cljs.test :refer-macros [deftest is testing]])
            [sbml.model :as m]
            [sbml.validate :as v]))

(defn- decay-model []
  (-> (m/model "decay")
      (m/add-compartment (m/compartment "cell" {:sbml/size 1.0}))
      (m/add-species (m/species "A" "cell" {:sbml/initial-amount 100.0}))
      (m/add-species (m/species "B" "cell" {:sbml/initial-amount 0.0}))
      (m/add-parameter (m/parameter "k" {:sbml/value 0.1}))
      (m/add-reaction (-> (m/reaction "r1")
                          (assoc :sbml/reactants [(m/species-ref "A")]
                                 :sbml/products [(m/species-ref "B")]
                                 :sbml/kinetic-law (m/kinetic-law [:apply :times [[:ci "k"] [:ci "A"]]]))))))

(deftest valid-model-has-no-errors
  (let [problems (v/validate (decay-model))]
    (is (v/valid? problems))
    (is (empty? (v/errors problems)))))

(deftest duplicate-id
  (testing "sec 3.3.1: species/compartment/parameter/reaction share one SId namespace"
    (let [model (-> (m/model "m")
                    (m/add-compartment (m/compartment "X" {:sbml/size 1.0}))
                    (m/add-parameter (m/parameter "X" {:sbml/value 1.0})))
          problems (v/validate model)]
      (is (not (v/valid? problems)))
      (is (some #(= :sbml/duplicate-id (:sbml/code %)) (v/errors problems))))))

(deftest missing-mandatory-attr
  (let [model (-> (m/model "m") (m/add-compartment {:sbml/id "c"}))
        problems (v/validate model)]
    (is (some #(= :sbml/missing-mandatory-attr (:sbml/code %)) (v/errors problems)))))

(deftest conflicting-initial-value
  (let [model (-> (m/model "m")
                  (m/add-compartment (m/compartment "c" {:sbml/size 1.0}))
                  (m/add-species (m/species "A" "c" {:sbml/initial-amount 1.0 :sbml/initial-concentration 2.0})))
        problems (v/validate model)]
    (is (some #(= :sbml/conflicting-initial-value (:sbml/code %)) (v/errors problems)))))

(deftest unknown-compartment-ref
  (let [model (-> (m/model "m") (m/add-species (m/species "A" "nope" {:sbml/initial-amount 1.0})))
        problems (v/validate model)]
    (is (some #(= :sbml/unknown-compartment-ref (:sbml/code %)) (v/errors problems)))))

(deftest empty-reaction
  (let [model (-> (m/model "m") (m/add-reaction (m/reaction "r")))
        problems (v/validate model)]
    (is (some #(= :sbml/empty-reaction (:sbml/code %)) (v/errors problems)))))

(deftest unknown-species-ref
  (let [model (-> (m/model "m")
                  (m/add-reaction (-> (m/reaction "r") (assoc :sbml/reactants [(m/species-ref "nope")]))))
        problems (v/validate model)]
    (is (some #(= :sbml/unknown-species-ref (:sbml/code %)) (v/errors problems)))))

(deftest dangling-ref-in-kinetic-law
  (let [model (-> (m/model "m")
                  (m/add-compartment (m/compartment "c" {:sbml/size 1.0}))
                  (m/add-species (m/species "A" "c" {:sbml/initial-amount 1.0}))
                  (m/add-reaction (-> (m/reaction "r")
                                      (assoc :sbml/reactants [(m/species-ref "A")]
                                             :sbml/kinetic-law (m/kinetic-law [:ci "nope"])))))
        problems (v/validate model)]
    (is (some #(= :sbml/dangling-ref (:sbml/code %)) (v/errors problems)))))

(deftest species-not-in-reaction
  (testing "sec 4.11.5: kineticLaw may only reference species declared in this reaction's own lists"
    (let [model (-> (m/model "m")
                    (m/add-compartment (m/compartment "c" {:sbml/size 1.0}))
                    (m/add-species (m/species "A" "c" {:sbml/initial-amount 1.0}))
                    (m/add-species (m/species "Z" "c" {:sbml/initial-amount 1.0}))
                    (m/add-reaction (-> (m/reaction "r")
                                        (assoc :sbml/reactants [(m/species-ref "A")]
                                               :sbml/kinetic-law (m/kinetic-law [:ci "Z"])))))
          problems (v/validate model)]
      (is (some #(= :sbml/species-not-in-reaction (:sbml/code %)) (v/errors problems))))))

(deftest dangling-rule-ref
  (let [model (-> (m/model "m") (m/add-parameter (m/parameter "P" {:sbml/value 0.0 :sbml/constant false}))
                  (m/add-rule (m/assignment-rule "P" [:ci "nope"])))
        problems (v/validate model)]
    (is (some #(= :sbml/dangling-ref (:sbml/code %)) (v/errors problems)))))

(deftest unknown-rule-variable
  (let [model (-> (m/model "m") (m/add-rule (m/assignment-rule "nope" [:cn 1.0])))
        problems (v/validate model)]
    (is (some #(= :sbml/unknown-rule-variable (:sbml/code %)) (v/errors problems)))))

(deftest duplicate-rule-variable
  (let [model (-> (m/model "m")
                  (m/add-parameter (m/parameter "P" {:sbml/value 0.0 :sbml/constant false}))
                  (m/add-rule (m/assignment-rule "P" [:cn 1.0]))
                  (m/add-rule (m/rate-rule "P" [:cn 2.0])))
        problems (v/validate model)]
    (is (some #(= :sbml/duplicate-rule-variable (:sbml/code %)) (v/errors problems)))))

(deftest unsupported-math-is-a-warning-not-an-error
  (let [model (-> (m/model "m")
                  (m/add-compartment (m/compartment "c" {:sbml/size 1.0}))
                  (m/add-species (m/species "A" "c" {:sbml/initial-amount 1.0}))
                  (m/add-reaction (-> (m/reaction "r")
                                      (assoc :sbml/reactants [(m/species-ref "A")]
                                             :sbml/kinetic-law (m/kinetic-law [:apply-unsupported "factorial" [[:ci "A"]]])))))
        problems (v/validate model)]
    (is (v/valid? problems))
    (is (some #(= :sbml/unsupported-math-construct (:sbml/code %)) (v/warnings problems)))))

(deftest not-yet-executable-warnings
  (let [model (-> (m/model "m")
                  (m/add-rule (m/algebraic-rule [:cn 0.0]))
                  (m/add-event {:sbml/use-values-from-trigger-time? true}))
        problems (v/validate model)]
    (is (v/valid? problems))
    (is (>= (count (filter #(= :sbml/not-yet-executable (:sbml/code %)) (v/warnings problems))) 2))))

(deftest compartment-governed-by-rule-is-not-yet-executable
  (let [model (-> (m/model "m")
                  (m/add-compartment (m/compartment "c" {:sbml/size 1.0 :sbml/constant false}))
                  (m/add-rule (m/rate-rule "c" [:cn 1.0])))
        problems (v/validate model)]
    (is (v/valid? problems))
    (is (some #(= :sbml/not-yet-executable (:sbml/code %)) (v/warnings problems)))))
