(ns sbml.mathml-test
  (:require #?(:clj [kotoba.test :refer [deftest is testing]]
               :cljs [cljs.test :refer-macros [deftest is testing]])
            [sbml.mathml :as mathml]))

(defn- close? [a b tol] (< (Math/abs (- a b)) tol))

;; --- cn / ci / const ---

(deftest cn-parses-real-and-integer
  (is (= [:cn 42.0] (mathml/parse {:tag :cn :attrs {:type "integer"} :content ["42"]})))
  (is (= [:cn 3.3] (mathml/parse {:tag :cn :attrs {:type "real"} :content ["3.3"]})))
  (is (= [:cn 5.0] (mathml/parse {:tag :cn :content ["5"]})) "type defaults to real (sec 3.4.2)"))

(deftest cn-e-notation-and-rational
  (testing "sec 3.4.2: <sep/> separates mantissa/exponent (e-notation) or numerator/denominator (rational)"
    (is (= [:cn 2.0e-5] (mathml/parse {:tag :cn :attrs {:type "e-notation"}
                                        :content ["2 " {:tag :sep :content []} " -5"]})))
    (is (= [:cn 1.5] (mathml/parse {:tag :cn :attrs {:type "rational"}
                                     :content ["3 " {:tag :sep :content []} " 2"]})))))

(deftest ci-and-const
  (is (= [:ci "S"] (mathml/parse {:tag :ci :content ["S"]})))
  (is (= [:const :pi] (mathml/parse {:tag :pi :content []})))
  (is (close? Math/PI (mathml/eval-expr [:const :pi] {}) 1.0e-12))
  (is (= 1.0 (mathml/eval-expr [:const :true] {})))
  (is (= 0.0 (mathml/eval-expr [:const :false] {}))))

;; --- round-trip: parse(emit(expr)) = expr, for every supported node shape ---

(deftest round-trip-arithmetic
  (doseq [e [[:cn 2.0]
             [:ci "S"]
             [:const :pi]
             [:apply :plus [[:cn 1.0] [:cn 2.0] [:cn 3.0]]]
             [:apply :times [[:ci "k"] [:ci "S"] [:cn 2.0]]]
             [:apply :minus [[:cn 5.0]]]
             [:apply :minus [[:cn 5.0] [:cn 3.0]]]
             [:apply :divide [[:ci "A"] [:ci "B"]]]
             [:apply :power [[:ci "x"] [:cn 2.0]]]
             [:apply :abs [[:ci "x"]]]
             [:apply :and [[:const :true] [:const :false]]]
             [:apply :max [[:cn 1.0] [:cn 2.0] [:cn 3.0]]]]]
    (is (= e (mathml/parse (mathml/emit e))) (str "round-trip failed for " e))))

(deftest round-trip-root-and-log-qualifiers
  (testing "default degree/logbase omit the qualifier element but still round-trip"
    (is (= [:apply :root [[:cn 2.0] [:ci "x"]]] (mathml/parse (mathml/emit [:apply :root [[:cn 2.0] [:ci "x"]]]))))
    (is (= [:apply :log [[:cn 10.0] [:ci "x"]]] (mathml/parse (mathml/emit [:apply :log [[:cn 10.0] [:ci "x"]]])))))
  (testing "non-default degree/logbase round-trip through an explicit qualifier element"
    (is (= [:apply :root [[:cn 3.0] [:ci "x"]]] (mathml/parse (mathml/emit [:apply :root [[:cn 3.0] [:ci "x"]]]))))
    (is (= [:apply :log [[:cn 2.0] [:ci "x"]]] (mathml/parse (mathml/emit [:apply :log [[:cn 2.0] [:ci "x"]]])))))
  (testing "the emitted element omits <degree>/<logbase> only for the default"
    (is (= 2 (count (:content (mathml/emit [:apply :root [[:cn 2.0] [:ci "x"]]])))))
    (is (= 3 (count (:content (mathml/emit [:apply :root [[:cn 3.0] [:ci "x"]]])))))))

(deftest round-trip-piecewise
  (let [pw [:piecewise [[[:cn 1.0] [:apply :lt [[:ci "x"] [:cn 0.0]]]]
                        [[:cn 2.0] [:apply :eq [[:ci "x"] [:cn 0.0]]]]]
            [:cn 3.0]]
        pw-no-otherwise [:piecewise [[[:cn 1.0] [:apply :gt [[:ci "x"] [:cn 0.0]]]]] nil]]
    (is (= pw (mathml/parse (mathml/emit pw))))
    (is (= pw-no-otherwise (mathml/parse (mathml/emit pw-no-otherwise))))))

(deftest round-trip-csymbol-and-unsupported
  (let [time-sym [:csymbol "http://www.sbml.org/sbml/symbols/time" []]
        delay-call [:csymbol "http://www.sbml.org/sbml/symbols/delay" [[:ci "S"] [:cn 2.0]]]
        fact [:apply-unsupported "factorial" [[:cn 5.0]]]]
    (is (= time-sym (mathml/parse (mathml/emit time-sym))))
    (is (= delay-call (mathml/parse (mathml/emit delay-call))))
    (is (= fact (mathml/parse (mathml/emit fact))))))

;; --- evaluator correctness ---

(deftest eval-n-ary-plus-and-times
  (testing "sec 3.4.1: plus/times are N-ary MathML operators, not just binary"
    (is (= 10.0 (mathml/eval-expr [:apply :plus [[:cn 1.0] [:cn 2.0] [:cn 3.0] [:cn 4.0]]] {})))
    (is (= 0.0 (mathml/eval-expr [:apply :plus []] {})) "0-ary plus is the additive identity")
    (is (= 24.0 (mathml/eval-expr [:apply :times [[:cn 2.0] [:cn 3.0] [:cn 4.0]]] {})))
    (is (= 1.0 (mathml/eval-expr [:apply :times []] {})) "0-ary times is the multiplicative identity")))

(deftest eval-minus-unary-and-binary
  (is (= -5.0 (mathml/eval-expr [:apply :minus [[:cn 5.0]]] {})))
  (is (= 2.0 (mathml/eval-expr [:apply :minus [[:cn 5.0] [:cn 3.0]]] {}))))

(deftest eval-root-and-log-qualifiers
  (is (close? 3.0 (mathml/eval-expr [:apply :root [[:cn 3.0] [:cn 27.0]]] {}) 1.0e-9)
      "cube root of 27")
  (is (= 4.0 (mathml/eval-expr [:apply :root [[:cn 2.0] [:cn 16.0]]] {}))
      "default degree 2 = square root")
  (is (close? 3.0 (mathml/eval-expr [:apply :log [[:cn 2.0] [:cn 8.0]]] {}) 1.0e-9)
      "log base 2 of 8")
  (is (close? 2.0 (mathml/eval-expr [:apply :log [[:cn 10.0] [:cn 100.0]]] {}) 1.0e-9)
      "default logbase 10"))

(deftest eval-comparisons-and-logic
  (is (= 1.0 (mathml/eval-expr [:apply :lt [[:cn 1.0] [:cn 2.0]]] {})))
  (is (= 0.0 (mathml/eval-expr [:apply :gt [[:cn 1.0] [:cn 2.0]]] {})))
  (is (= 1.0 (mathml/eval-expr [:apply :eq [[:cn 2.0] [:cn 2.0]]] {})))
  (is (= 1.0 (mathml/eval-expr [:apply :and [[:const :true] [:const :true]]] {})))
  (is (= 0.0 (mathml/eval-expr [:apply :and [[:const :true] [:const :false]]] {})))
  (is (= 1.0 (mathml/eval-expr [:apply :or [[:const :false] [:const :true]]] {})))
  (is (= 0.0 (mathml/eval-expr [:apply :not [[:const :true]]] {}))))

(deftest eval-piecewise
  (let [pw [:piecewise [[[:cn 1.0] [:apply :lt [[:ci "x"] [:cn 0.0]]]]
                        [[:cn 2.0] [:apply :eq [[:ci "x"] [:cn 0.0]]]]]
            [:cn 3.0]]]
    (is (= 1.0 (mathml/eval-expr pw {"x" -1.0})))
    (is (= 2.0 (mathml/eval-expr pw {"x" 0.0})))
    (is (= 3.0 (mathml/eval-expr pw {"x" 5.0})) "falls through to otherwise")))

(deftest eval-piecewise-no-match-no-otherwise-throws
  (is (thrown? #?(:clj Exception :cljs js/Error)
               (mathml/eval-expr [:piecewise [[[:cn 1.0] [:const :false]]] nil] {}))))

(deftest eval-time-csymbol
  (is (= 5.0 (mathml/eval-expr [:csymbol "http://www.sbml.org/sbml/symbols/time" []] {"time" 5.0}))))

(deftest eval-unsupported-throws-not-silently-wrong
  (testing "csymbol other than time (delay/rateOf/avogadro)"
    (is (thrown? #?(:clj Exception :cljs js/Error)
                 (mathml/eval-expr [:csymbol "http://www.sbml.org/sbml/symbols/delay" [[:ci "S"] [:cn 2.0]]]
                                    {"S" 1.0}))))
  (testing "apply-unsupported operators (factorial/quotient/rem/xor/implies/hyperbolic-trig/...)"
    (is (thrown? #?(:clj Exception :cljs js/Error)
                 (mathml/eval-expr [:apply-unsupported "factorial" [[:cn 5.0]]] {})))))

(deftest unsupported-tag-throws-on-parse
  (testing "lambda/semantics/annotation are outside the sec 3.4.1 subset entirely"
    (is (thrown? #?(:clj Exception :cljs js/Error)
                 (mathml/parse {:tag :lambda :content []})))))

;; --- static analysis ---

(deftest free-vars-collects-ci-only
  (is (= #{"k" "A"} (mathml/free-vars [:apply :times [[:ci "k"] [:ci "A"]]])))
  (is (= #{} (mathml/free-vars [:apply :plus [[:cn 1.0] [:const :pi]]])))
  (is (= #{"x"} (mathml/free-vars [:piecewise [[[:ci "x"] [:const :true]]] [:cn 0.0]]))))

(deftest unsupported-forms-detects-both-kinds
  (is (= #{"factorial"}
         (mathml/unsupported-forms [:apply :plus [[:apply-unsupported "factorial" [[:cn 1.0]]] [:cn 2.0]]])))
  (is (= #{"http://www.sbml.org/sbml/symbols/delay"}
         (mathml/unsupported-forms [:csymbol "http://www.sbml.org/sbml/symbols/delay" [[:ci "S"] [:cn 2.0]]])))
  (is (= #{} (mathml/unsupported-forms [:csymbol "http://www.sbml.org/sbml/symbols/time" []]))
      "time IS supported, so it contributes no unsupported-forms entry"))
