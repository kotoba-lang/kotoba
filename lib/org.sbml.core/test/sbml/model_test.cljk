(ns sbml.model-test
  (:require #?(:clj [kotoba.test :refer [deftest is]]
               :cljs [cljs.test :refer-macros [deftest is]])
            [sbml.model :as m]))

(defn- decay-model []
  (-> (m/model "decay")
      (m/add-compartment (m/compartment "cell" {:sbml/size 1.0}))
      (m/add-species (m/species "A" "cell" {:sbml/initial-amount 100.0}))
      (m/add-species (m/species "B" "cell" {:sbml/initial-amount 0.0}))
      (m/add-parameter (m/parameter "k" {:sbml/value 0.1}))
      (m/add-reaction (-> (m/reaction "r1")
                          (assoc :sbml/reactants [(m/species-ref "A")]
                                 :sbml/products [(m/species-ref "B")]
                                 :sbml/kinetic-law (m/kinetic-law [:apply :times [[:ci "k"] [:ci "A"]]]))))))

(deftest builders-and-queries
  (let [model (decay-model)]
    (is (= #{"cell"} (m/compartment-ids model)))
    (is (= #{"A" "B"} (m/species-ids model)))
    (is (= #{"k"} (m/parameter-ids model)))
    (is (= #{"r1"} (m/reaction-ids model)))
    (is (= "cell" (:sbml/compartment (m/lookup-species model "A"))))
    (is (= 100.0 (:sbml/initial-amount (m/lookup-species model "A"))))
    (is (= 1 (count (m/reactants (m/lookup-reaction model "r1")))))
    (is (m/has-kinetic-law? (m/lookup-reaction model "r1")))))

(deftest compartment-defaults
  (is (= 3.0 (:sbml/spatial-dimensions (m/compartment "c"))))
  (is (true? (:sbml/constant (m/compartment "c")))))

(deftest species-defaults
  (let [s (m/species "S" "c")]
    (is (false? (:sbml/has-only-substance-units? s)))
    (is (false? (:sbml/boundary-condition? s)))
    (is (false? (:sbml/constant s)))))

(deftest species-ref-defaults
  (is (= 1.0 (:sbml/stoichiometry (m/species-ref "S"))))
  (is (true? (:sbml/constant (m/species-ref "S"))))
  (is (= 2.0 (:sbml/stoichiometry (m/species-ref "S" 2.0)))))

(deftest reaction-defaults
  (is (false? (:sbml/reversible (m/reaction "r"))))
  (is (= [] (m/reactants (m/reaction "r"))))
  (is (not (m/has-kinetic-law? (m/reaction "r")))))

(deftest rule-builders
  (is (= {:sbml/rule-type :assignment :sbml/variable "X" :sbml/math [:cn 1.0]}
         (m/assignment-rule "X" [:cn 1.0])))
  (is (= {:sbml/rule-type :rate :sbml/variable "X" :sbml/math [:cn 1.0]}
         (m/rate-rule "X" [:cn 1.0])))
  (is (= {:sbml/rule-type :algebraic :sbml/math [:cn 0.0]}
         (m/algebraic-rule [:cn 0.0])))
  (is (nil? (:sbml/variable (m/algebraic-rule [:cn 0.0])))))

(deftest rule-queries
  (let [model (-> (m/model "m")
                  (m/add-rule (m/assignment-rule "A" [:cn 1.0]))
                  (m/add-rule (m/rate-rule "B" [:cn 2.0]))
                  (m/add-rule (m/algebraic-rule [:cn 0.0])))]
    (is (= 1 (count (m/assignment-rules model))))
    (is (= 1 (count (m/rate-rules model))))
    (is (= 1 (count (m/algebraic-rules model))))
    (is (= 3 (count (m/rules model))))))

(deftest unit-definition-builders
  (let [u (m/unit "mole")]
    (is (= 1.0 (:sbml/exponent u)))
    (is (= 0.0 (:sbml/scale u)))
    (is (= 1.0 (:sbml/multiplier u))))
  (let [ud (m/unit-definition "per_second" [(m/unit "second" {:sbml/exponent -1.0})])]
    (is (= "per_second" (:sbml/id ud)))
    (is (= 1 (count (:sbml/units ud))))))

(deftest known-ids-includes-species-compartments-parameters-reactions
  (let [model (decay-model)]
    (is (= #{"A" "B" "cell" "k" "r1"} (m/known-ids model)))))

(deftest species-reference-ids-only-includes-ided-refs
  (let [r (-> (m/reaction "r")
              (assoc :sbml/reactants [(m/species-ref "A" 1.0 {:sbml/id "sr1"})]
                     :sbml/products [(m/species-ref "B")]))]
    (is (= #{"sr1"} (m/species-reference-ids r)))))

(deftest local-parameters-scoped-to-reaction
  (let [r (-> (m/reaction "r")
              (assoc :sbml/kinetic-law (m/kinetic-law [:ci "k_local"]
                                                       {:sbml/local-parameters
                                                        {"k_local" (m/local-parameter "k_local" {:sbml/value 1.0})}})))]
    (is (= #{"k_local"} (m/local-parameter-ids r)))
    (is (= 1 (count (m/local-parameters-of r))))))
