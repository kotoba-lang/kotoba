;; Test for model-checking.assertion. main returns the number of failed cases.
(ns model-checking.assertion-test
  (:export [main])
  (:require [model-checking.assertion :as m]))

(defn- chk [ok :bool] :i64
  (if ok 0 1))

(defn- str-doc [s :string] :document
  (document-string s))

;; Signals per step. clk is "1" on steps 0..2 and "0" on step 3; en is "0" on every step.
(defn- trace [] :document
  (document-vector
   (document-map (str-doc "req") (str-doc "1") (str-doc "ack") (str-doc "1") (str-doc "clk") (str-doc "1") (str-doc "en") (str-doc "0"))
   (document-map (str-doc "req") (str-doc "1") (str-doc "ack") (str-doc "0") (str-doc "clk") (str-doc "1") (str-doc "en") (str-doc "0"))
   (document-map (str-doc "req") (str-doc "1") (str-doc "ack") (str-doc "0") (str-doc "clk") (str-doc "1") (str-doc "en") (str-doc "0"))
   (document-map (str-doc "req") (str-doc "0") (str-doc "ack") (str-doc "0") (str-doc "clk") (str-doc "0") (str-doc "en") (str-doc "0"))))

(defn- result-at [rs :document i :i64] :document
  (option-value-of [:option :document] (document-vector-at rs i) (document-null)))

(defn- field-of [m :document k :keyword] :document
  (option-value-of [:option :document] (document-get m (document-keyword k)) (document-null)))

(defn- status-is [r :document s :keyword] :bool
  (document-equal? (field-of r :status) (document-keyword s)))

(defn- ack-check [rs :document] :i64
  (let [r (result-at rs 0)]
    (+ (chk (status-is r :fail))
       (+ (chk (document-equal? (field-of r :hit-count) (document-i64 1)))
          (+ (chk (document-equal? (field-of r :fail-count) (document-i64 2)))
             (chk (document-equal? (field-of r :first-fail-time) (document-i64 1))))))))

(defn- req-check [rs :document] :i64
  (let [r (result-at rs 1)]
    (+ (chk (status-is r :pass))
       (+ (chk (document-equal? (field-of r :hit-count) (document-i64 3)))
          (chk (document-equal? (field-of r :first-fail-time) (document-null)))))))

(defn- missing-check [rs :document] :i64
  (let [r (result-at rs 2)]
    (+ (chk (status-is r :fail))
       (+ (chk (document-equal? (field-of r :hit-count) (document-i64 0)))
          (chk (document-equal? (field-of r :fail-count) (document-i64 3)))))))

(defn- vacuous-check [rs :document] :i64
  (let [r (result-at rs 3)]
    (+ (chk (status-is r :vacuous))
       (+ (chk (document-equal? (field-of r :hit-count) (document-i64 0)))
          (chk (document-equal? (field-of r :first-fail-time) (document-null)))))))

(defn- assertions [] :document
  (document-vector
   (m/sva-assertion (document-string "ack_ok") (document-keyword :assert) (document-string "ack") (document-string "clk") (document-keyword :error))
   (m/sva-assertion (document-string "req_ok") (document-keyword :assert) (document-string "req") (document-string "clk") (document-keyword :error))
   (m/sva-assertion (document-string "never") (document-keyword :cover) (document-string "missing") (document-string "clk") (document-keyword :info))
   (m/sva-assertion (document-string "disabled") (document-keyword :assume) (document-string "req") (document-string "en") (document-keyword :warning))))

(defn- sets [] :i64
  (+ (chk (= (document-count (m/assertion-types)) 4))
     (+ (chk (document-set-contains? (m/severities) (document-keyword :fatal)))
        (chk (document-set-contains? (m/assertion-statuses) (document-keyword :vacuous))))))

(defn main [] :i64
  (let [rs (m/evaluate-assertions-simple (assertions) (trace))]
    (+ (sets) (+ (ack-check rs) (+ (req-check rs) (+ (missing-check rs) (vacuous-check rs)))))))
