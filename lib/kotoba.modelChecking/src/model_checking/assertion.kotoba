;; Port of model-checking.assertion (assertion.cljk), Kotoba-native.
;;
;; SVA-style assertion evaluation over signal traces. Each trace step is a
;; signal map (names to string values); an assertion's expression is the name
;; of a signal that passes at a step when its value is "1" or "true". Steps
;; count only when the assertion's clock signal is truthy (absent = active).
;; Named divergences:
;;   - sva-result's first-fail-time is the document null when nothing failed
;;     (the source's nil).
;;   - the trace must be a :vector of step maps (the source takes any seq).
(ns model-checking.assertion
  (:export [assertion-types severities assertion-statuses sva-assertion sva-result
            evaluate-assertions-simple]))

(defn assertion-types [] :document
  (document-edn-read "#{:assert :assume :cover :restrict}"))

(defn severities [] :document
  (document-edn-read "#{:error :fatal :info :warning}"))

(defn assertion-statuses [] :document
  (document-edn-read "#{:fail :pass :vacuous}"))

(defn- lookup [m :document k :document] :document
  (if (= (document-kind m) :map)
    (option-value-of [:option :document] (document-get m k) (document-null))
    (document-null)))

(defn- field [m :document k :keyword] :document
  (lookup m (document-keyword k)))

(defn- step [trace :document i :i64] :document
  (option-value-of [:option :document] (document-vector-at trace i) (document-null)))

(defn sva-assertion [assertion-name :document assertion-type :document expression :document
                     clock :document severity :document] :document
  (document-map :name assertion-name
                :assertion-type assertion-type
                :expression expression
                :clock clock
                :severity severity))

(defn sva-result [assertion-name :document status :document hit-count :i64 fail-count :i64
                  first-fail-time :i64] :document
  (document-map :assertion-name assertion-name
                :status status
                :hit-count (document-i64 hit-count)
                :fail-count (document-i64 fail-count)
                :first-fail-time (if (< first-fail-time 0) (document-null) (document-i64 first-fail-time))))

(defn- truthy-doc [d :document] :bool
  (cond (= (document-kind d) :null) false
        (= (document-kind d) :bool) (option-value-of [:option :bool] (document-bool-value d) true)
        :else true))

(defn- truthy-signal? [v :document] :bool
  (let [s (option-value-of [:option :string] (document-string-value v) "")]
    (or (string=? s "1") (string=? s "true"))))

;; A step is active when the clock signal is absent or passes (truthy-signal?).
(defn- step-active? [signals :document a :document] :bool
  (let [v (lookup signals (field a :clock))]
    (if (truthy-doc v) (truthy-signal? v) true)))

(defn- evaluate-one [a :document trace :document] :document
  (let [n (document-count trace)
        expr-key (field a :expression)]
    (loop [t 0 hit 0 fail 0 cac 0 ff -1]
      (if (>= t n)
        (sva-result (field a :name)
                    (cond (= cac 0) (document-keyword :vacuous)
                          (= fail 0) (document-keyword :pass)
                          :else (document-keyword :fail))
                    hit fail ff)
        (let [signals (step trace t)]
          (if (step-active? signals a)
            (if (truthy-signal? (lookup signals expr-key))
              (recur (+ t 1) (+ hit 1) fail (+ cac 1) ff)
              (recur (+ t 1) hit (+ fail 1) (+ cac 1) (if (< ff 0) t ff)))
            (recur (+ t 1) hit fail cac ff)))))))

(defn evaluate-assertions-simple [assertions :document signal-trace :document] :document
  (let [n (document-count assertions)]
    (loop [i 0 out (document-vector)]
      (if (>= i n)
        out
        (recur (+ i 1)
               (document-vector-conj out (evaluate-one (step assertions i) signal-trace)))))))
