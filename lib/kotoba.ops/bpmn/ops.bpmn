<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  targetNamespace="http://bpmn.io/schema/bpmn">

  <!-- createProcessRun -->
  <bpmn:process id="ops-create-process-run" name="Ops Create Process Run" isExecutable="true">
    <bpmn:startEvent id="start-create-process-run"/>
    <bpmn:sequenceFlow id="sf-cpr-1" sourceRef="start-create-process-run" targetRef="task-create-process-run"/>
    <bpmn:serviceTask id="task-create-process-run" name="Create Process Run">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.ops.createProcessRun"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-cpr-2" sourceRef="task-create-process-run" targetRef="end-create-process-run"/>
    <bpmn:endEvent id="end-create-process-run"/>
  </bpmn:process>

  <!-- updateProcessRun -->
  <bpmn:process id="ops-update-process-run" name="Ops Update Process Run" isExecutable="true">
    <bpmn:startEvent id="start-update-process-run"/>
    <bpmn:sequenceFlow id="sf-upr-1" sourceRef="start-update-process-run" targetRef="task-update-process-run"/>
    <bpmn:serviceTask id="task-update-process-run" name="Update Process Run">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.ops.updateProcessRun"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-upr-2" sourceRef="task-update-process-run" targetRef="end-update-process-run"/>
    <bpmn:endEvent id="end-update-process-run"/>
  </bpmn:process>

  <!-- listProcessRuns -->
  <bpmn:process id="ops-list-process-runs" name="Ops List Process Runs" isExecutable="true">
    <bpmn:startEvent id="start-list-process-runs"/>
    <bpmn:sequenceFlow id="sf-lpr-1" sourceRef="start-list-process-runs" targetRef="task-list-process-runs"/>
    <bpmn:serviceTask id="task-list-process-runs" name="List Process Runs">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.ops.listProcessRuns"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-lpr-2" sourceRef="task-list-process-runs" targetRef="end-list-process-runs"/>
    <bpmn:endEvent id="end-list-process-runs"/>
  </bpmn:process>

  <!-- getProcessRun -->
  <bpmn:process id="ops-get-process-run" name="Ops Get Process Run" isExecutable="true">
    <bpmn:startEvent id="start-get-process-run"/>
    <bpmn:sequenceFlow id="sf-gpr-1" sourceRef="start-get-process-run" targetRef="task-get-process-run"/>
    <bpmn:serviceTask id="task-get-process-run" name="Get Process Run">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.ops.getProcessRun"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-gpr-2" sourceRef="task-get-process-run" targetRef="end-get-process-run"/>
    <bpmn:endEvent id="end-get-process-run"/>
  </bpmn:process>

  <!-- createAutomation -->
  <bpmn:process id="ops-create-automation" name="Ops Create Automation" isExecutable="true">
    <bpmn:startEvent id="start-create-automation"/>
    <bpmn:sequenceFlow id="sf-cat-1" sourceRef="start-create-automation" targetRef="task-create-automation"/>
    <bpmn:serviceTask id="task-create-automation" name="Create Automation">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.ops.createAutomation"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-cat-2" sourceRef="task-create-automation" targetRef="end-create-automation"/>
    <bpmn:endEvent id="end-create-automation"/>
  </bpmn:process>

  <!-- updateAutomation -->
  <bpmn:process id="ops-update-automation" name="Ops Update Automation" isExecutable="true">
    <bpmn:startEvent id="start-update-automation"/>
    <bpmn:sequenceFlow id="sf-uat-1" sourceRef="start-update-automation" targetRef="task-update-automation"/>
    <bpmn:serviceTask id="task-update-automation" name="Update Automation">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.ops.updateAutomation"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-uat-2" sourceRef="task-update-automation" targetRef="end-update-automation"/>
    <bpmn:endEvent id="end-update-automation"/>
  </bpmn:process>

  <!-- listAutomations -->
  <bpmn:process id="ops-list-automations" name="Ops List Automations" isExecutable="true">
    <bpmn:startEvent id="start-list-automations"/>
    <bpmn:sequenceFlow id="sf-lat-1" sourceRef="start-list-automations" targetRef="task-list-automations"/>
    <bpmn:serviceTask id="task-list-automations" name="List Automations">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.ops.listAutomations"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-lat-2" sourceRef="task-list-automations" targetRef="end-list-automations"/>
    <bpmn:endEvent id="end-list-automations"/>
  </bpmn:process>

  <!-- getAutomation -->
  <bpmn:process id="ops-get-automation" name="Ops Get Automation" isExecutable="true">
    <bpmn:startEvent id="start-get-automation"/>
    <bpmn:sequenceFlow id="sf-gat-1" sourceRef="start-get-automation" targetRef="task-get-automation"/>
    <bpmn:serviceTask id="task-get-automation" name="Get Automation">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.ops.getAutomation"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-gat-2" sourceRef="task-get-automation" targetRef="end-get-automation"/>
    <bpmn:endEvent id="end-get-automation"/>
  </bpmn:process>

</bpmn:definitions>
