{
  // NOTE: this app used to be built by SvelteKit's @sveltejs/adapter-cloudflare,
  // which emitted both a server-rendering Worker script (`main`, pointed at
  // the SvelteKit Cloudflare adapter build output) and a static client bundle
  // (`assets.directory`, the +page.svelte status page). The deployed XRPC
  // handler behind that build was svelte/src/routes/xrpc/[...path]/+server.ts
  // — moved (not deleted) to src/xrpc-proxy.ts, see that file's header.
  //
  // The frontend was migrated to a plain ClojureScript (shadow-cljs + reagent
  // + re-frame + jp-go-dds) static bundle with no server-rendering step — see
  // cljs/ and this repo's README. `assets.directory` now points at the cljs
  // build output.
  //
  // Unlike some sibling migrations, the `main` key is DROPPED here, not
  // repointed at src/app.ts. src/app.ts (this repo's actual production
  // Worker facade, entered above at .../src/app.ts) does NOT call
  // `env.ASSETS.fetch(...)` anywhere in its fetch handler — it only answers
  // `/health`, `/_app/meta`, and `/xrpc/com.etzhayyim.apps.ops.*`, and
  // returns a 404 JSON body for everything else. Putting a worker with no
  // ASSETS fallback in front of `assets.directory` would mean nothing ever
  // serves the static bundle, so `main` is removed entirely and the Workers
  // static-assets pipeline serves `assets.directory` directly. Reconciling
  // src/app.ts to add an `env.ASSETS.fetch(...)` fallback (as the gmail
  // sibling migration's src/app.ts already did) is an open product
  // decision, not made here. src/xrpc-proxy.ts (the moved +server.ts) is
  // also NOT wired as `main` — it duplicates a subset of src/app.ts's XRPC
  // proxying via a different upstream (AGENTGATEWAY_MCP_ROUTER_URL vs.
  // DISPATCHER_URL) and reviving/reconciling it is likewise not decided
  // here.
  //
  // This edit is UNVERIFIED: `wrangler deploy`/`wrangler dev` were not run
  // against it.
  "name": "kotodama-jxepq85j",
  "compatibility_date": "2025-03-17",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_als"
  ],
  "vars": {
    "APP_CAPABILITIES": "[\"createProcessRun\",\"updateProcessRun\",\"listProcessRuns\",\"getProcessRun\",\"createAutomation\",\"updateAutomation\",\"listAutomations\",\"getAutomation\"]",
    "APP_DESCRIPTION": "ops — Operations Automation Platform. Process run and automation management with BPMN-driven workflows.",
    "APP_DISPLAY_NAME": "Operations Platform",
    "APP_FRAMEWORK": "cljs-reagent-re-frame-jp-go-dds",
    "APP_NANOID": "jxepq85j",
    "APP_PERFORMER_TYPE": "service",
    "APP_UI_TYPE": "yoro",
    "AGENTGATEWAY_MCP_ROUTER_URL": "https://mcp.etzhayyim.com/xrpc/com.etzhayyim.mcp.message"
  },
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": [
        "**/*.wasm"
      ]
    }
  ],
  "routes": [
    {
      "pattern": "jxepq85j.etzhayyim.com/*",
      "zone_name": "etzhayyim.com"
    },
    {
      "pattern": "ops.etzhayyim.com/*",
      "zone_name": "etzhayyim.com"
    }
  ],
  "assets": {
    "directory": "./cljs/public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
