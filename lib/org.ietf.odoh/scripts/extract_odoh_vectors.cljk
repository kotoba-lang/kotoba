(ns extract-odoh-vectors
  "Turn Cloudflare's `odoh-go` test vectors into `test/odoh/vectors.cljk`.

  **RFC 9230 publishes no test vectors.** This is a reference implementation's
  corpus, not the specification's, and every place that matters says so rather
  than letting it read as RFC anchoring.

  What it is good for is the strongest single form of differential evidence
  available: the vectors carry `obliviousQuery` and `obliviousResponse` that
  *another implementation sealed*, and this one opens them. That is a stronger
  statement than two implementations agreeing on bytes they both computed the
  same wrong way — and it is the only kind available here, because the
  ephemeral key is not published and the ciphertexts therefore cannot be
  reproduced byte-for-byte.

      curl -sSo odoh_test_vectors.json \\
        https://raw.githubusercontent.com/cloudflare/odoh-go/master/test-vectors.json
      kbb --backend sci scripts/extract_odoh_vectors.cljk odoh_test_vectors.json"
  (:require ["fs" :as fs] ["crypto" :as crypto] [kotoba.lang.text :as str]))

(def source-url
  "https://raw.githubusercontent.com/cloudflare/odoh-go/master/test-vectors.json")
(def source-sha256
  "737badc10934c51ef306eb34f9de489861f5dfeebc1f59c003166a3c6b82857c")

(defn- sha256-hex [s] (-> (crypto/createHash "sha256") (.update s "utf8") (.digest "hex")))

(defn -main [& args]
  (let [path (first args)
        _ (when-not path
            (println "usage: kbb --backend sci scripts/extract_odoh_vectors.cljk <odoh_test_vectors.json>")
            (println "  curl -sSo odoh_test_vectors.json" source-url)
            (js/process.exit 2))
        text (str (fs/readFileSync path "utf8"))]
    (when (not= source-sha256 (sha256-hex text))
      (println "REFUSING: corpus sha256 mismatch")
      (println "  expected" source-sha256)
      (println "  got     " (sha256-hex text))
      (js/process.exit 2))
    (let [j (js->clj (js/JSON.parse text) :keywordize-keys true)
          vs (vec (for [v j]
                    {:kem-id (:kem_id v) :kdf-id (:kdf_id v) :aead-id (:aead_id v)
                     :odohconfigs (:odohconfigs v)
                     :public-key-seed (:public_key_seed v)
                     :key-id (:key_id v)
                     :transactions (vec (for [t (:transactions v)]
                                          {:query (:query t)
                                           :query-padding (:queryPaddingLength t)
                                           :response (:response t)
                                           :response-padding (:responsePaddingLength t)
                                           :oblivious-query (:obliviousQuery t)
                                           :oblivious-response (:obliviousResponse t)}))}))
          tx (reduce + (map #(count (:transactions %)) vs))]
      (println "vectors" (count vs) "transactions" tx)
      (let [out (str ";; GENERATED by scripts/extract_odoh_vectors.cljk — do not edit.\n;;\n"
                     ";; Cloudflare odoh-go test vectors: " (count vs) " configuration(s),\n"
                     ";; " tx " transactions. NOT RFC vectors — RFC 9230 publishes none.\n;;\n"
                     ";; Source:  " source-url "\n;; sha256:  " source-sha256 "\n"
                     "(ns odoh.vectors)\n\n"
                     "(def transaction-count " tx ")\n\n"
                     "(def vectors\n  ["
                     (str/join "\n\n   " (map pr-str vs)) "])\n")]
        (fs/mkdirSync "test/odoh" #js {:recursive true})
        (fs/writeFileSync "test/odoh/vectors.cljk" out)
        (println "wrote test/odoh/vectors.cljk" (count out) "bytes")))))

(apply -main *command-line-args*)
