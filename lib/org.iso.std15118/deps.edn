;; No dependencies. V2GTP is an 8-byte big-endian header (ProtocolVersion,
;; InverseProtocolVersion, PayloadType, PayloadLength) around an opaque
;; payload; nothing here needs a socket, TLS, or an EXI codec.
{:deps {
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}}
 :paths ["src"]
 :aliases
 {:test {:extra-paths ["test"]}
  :cljs {:extra-paths ["test"]}}}
