{:paths ["src" "resources"]
 ;; Deliberately dependency-free, like kotoba-lang/worklaw and
 ;; kotoba-lang/taxlaw. A caller that needs to know how a trial balance folds
 ;; into a balance sheet should not thereby acquire a ledger, a bank client
 ;; or a network stack.
 ;;
 ;; It does NOT depend on kotoba-lang/banking either. Balances come in as
 ;; plain data, so this library can fold a trial balance produced by anything
 ;; -- and banking stays the double-entry contract rather than becoming a
 ;; reporting engine.
 :deps {
        io.github.kotoba-lang/io {:local/root "../kotoba.io"}
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/edn {:local/root "../kotoba.edn"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}}
 :aliases
 {:test {:extra-paths ["test"]}}}
