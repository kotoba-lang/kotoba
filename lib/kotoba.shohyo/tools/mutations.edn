;; One mutation per invariant. `:find` must occur EXACTLY ONCE in `:file` —
;; `tools/check-mutations.cljk` refuses otherwise, because a mutation that
;; landed in a comment or in a second call site produces a red suite that
;; proves nothing.
;;
;; Read the pair before trusting a red: the thing broken and the thing
;; reported must be the same thing.
;;
;; ⚠ SCOPE. This table covers TWO modules and nothing else:
;;
;;   - `kotoba.shohyo.ifrs`, plus the one line it added to the core
;;     (`:declared`)                                          — 24 mutations
;;   - `kotoba.shohyo.renketsu`, plus the one function it factored out of the
;;     core (`fold-lines`)                                     — 51 mutations
;;
;; The core's own classification, the concept vocabulary and
;; `kotoba.shohyo.jp` are NOT mutated here. The README records fourteen and
;; seven mutations respectively for those, from separate runs. **A green
;; table below says nothing about them**, and a reader who quotes a total
;; from this file is quoting the wrong denominator.
[
 ;; --------------------------------------------------------------------
 ;; the taxlaw discipline: an unread rule must not back a check
 ;; --------------------------------------------------------------------
 {:id :deleted-item-is-requirable
  :invariant "a paragraph the Board deleted cannot make a statement short"
  :file "src/kotoba/shohyo/ifrs.cljk"
  :find "(not= :deleted status)"
  :replace "(not (nil? status))"}

 {:id :unread-scope-is-requirable
  :invariant "an item whose scope was never read cannot back a check"
  :file "src/kotoba/shohyo/ifrs.cljk"
  :find "(not= :reachable-not-read scope-review)"
  :replace "(not= :never-happens scope-review)"}

 {:id :unread-paragraph-is-requirable
  :invariant "an item is requirable only if its own paragraph was read"
  :file "src/kotoba/shohyo/ifrs.cljk"
  :find "(= :read-from-source review)"
  :replace "(not= :never-happens review)"}

 {:id :unverifiable-does-not-block
  :invariant "a declared item with unread scope makes the verdict not-a-pass"
  :file "src/kotoba/shohyo/ifrs.cljk"
  :find "(seq unverifiable) (conj :scope-not-read)"
  :replace "(seq nil) (conj :scope-not-read)"}

 {:id :unread-catalogue-still-answers
  :invariant "if no paragraph is :read-from-source the module refuses to answer"
  :file "src/kotoba/shohyo/ifrs.cljk"
  :find "(filter #(= :read-from-source (:review %))"
  :replace "(filter #(some? (:review %))"}

 {:id :deleted-paragraph-relabelled-live
  :invariant "IAS 1.82(e) is recorded as deleted, not quietly dropped or kept live"
  :file "src/kotoba/shohyo/ifrs.cljk"
  :find "{:provision \"IAS 1.82(e)\" :label \"[deleted]\" :status :deleted"
  :replace "{:provision \"IAS 1.82(e)\" :label \"[deleted]\" :status :live"}

 ;; --------------------------------------------------------------------
 ;; IAS 1.31 / 1.57 — a minimum list is not a checklist
 ;; --------------------------------------------------------------------
 {:id :every-item-required
  :invariant "only items the chart DECLARES are required; materiality is the entity's"
  :file "src/kotoba/shohyo/ifrs.cljk"
  :find "(into #{} (filter requirable?) declared)"
  :replace "(into #{} (filter requirable?) (keys sofp-items))"}

 {:id :nothing-is-ever-missing
  :invariant "a declared item absent from a currency's statement is reported"
  :file "src/kotoba/shohyo/ifrs.cljk"
  :find "(remove present required)"
  :replace "(remove (constantly true) required)"}

 {:id :missing-items-not-keyed-by-currency
  :invariant "missing-items reports only the currencies that are short"
  :file "src/kotoba/shohyo/ifrs.cljk"
  :find "(when (seq (:missing v))"
  :replace "(when (some? (:missing v))"}

 {:id :wrong-statement-not-caught
  :invariant "an item present on the wrong statement is not presentation"
  :file "src/kotoba/shohyo/ifrs.cljk"
  :find "(not (contains? got want))"
  :replace "(not (contains? got got))"}

 ;; --------------------------------------------------------------------
 ;; IAS 1.60 / 1.61 — the exception, and the clause that survives it
 ;; --------------------------------------------------------------------
 {:id :liquidity-switches-off-ias-1-61
  :invariant "`Whichever method of presentation is adopted` — 1.61 survives 1.60's exception"
  :file "src/kotoba/shohyo/ifrs.cljk"
  :find ":holds? (empty? gaps-61)"
  :replace ":holds? true"}

 ;; The first attempt at this one inserted a second `:holds?` into the same
 ;; map literal, so the file stopped READING and the harness scored it
 ;; UNMEASURED rather than killed. A mutation that breaks the reader
 ;; demonstrates the reader.
 {:id :undeclared-method-passes
  :invariant "an undeclared presentation method is answered, not assumed"
  :file "src/kotoba/shohyo/ifrs.cljk"
  :find ":holds? false})))"
  :replace ":holds? true})))"}

 {:id :liabilities-need-no-classification
  :invariant "IAS 1.60 asks for current/non-current assets AND liabilities"
  :file "src/kotoba/shohyo/ifrs.cljk"
  :find "(contains? #{:asset :liability} type)"
  :replace "(contains? #{:asset} type)"}

 {:id :equity-must-be-classified
  :invariant "IAS 1.60 says nothing about equity, so equity is not asked for"
  :file "src/kotoba/shohyo/ifrs.cljk"
  :find "#{:asset :liability} type)"
  :replace "#{:asset :liability :equity} type)"}

 {:id :deferred-tax-may-be-current
  :invariant "IAS 1.56 forbids classifying deferred tax as current"
  :file "src/kotoba/shohyo/ifrs.cljk"
  :find "(and never-current? (= :current cls))"
  :replace "(and never-current? (= :never-happens cls))"}

 ;; --------------------------------------------------------------------
 ;; the chart
 ;; --------------------------------------------------------------------
 {:id :item-type-conflict-allowed
  :invariant "an item whose account type contradicts its article is caught"
  :file "src/kotoba/shohyo/ifrs.cljk"
  :find "(not= type declared-type)"
  :replace "(not= type type)"}

 {:id :deleted-item-accepted-in-a-chart
  :invariant "a chart may not declare a paragraph the Board deleted"
  :file "src/kotoba/shohyo/ifrs.cljk"
  :find "(= :deleted status)"
  :replace "(= :never-happens status)"}

 {:id :current-tax-forced-onto-one-side
  :invariant "IAS 1.54(n) names `liabilities and assets`, so neither side conflicts"
  :file "src/kotoba/shohyo/ifrs.cljk"
  :find "    :type nil :review :read-from-source\n    :scope-source \"IAS 12\" :scope-review :reachable-not-read}"
  :replace "    :type :liability :review :read-from-source\n    :scope-source \"IAS 12\" :scope-review :reachable-not-read}"}

 ;; --------------------------------------------------------------------
 ;; the conservative answer, and the core's verdict
 ;; --------------------------------------------------------------------
 {:id :core-incompleteness-not-inherited
  :invariant "a statement the core calls short cannot be IAS 1 conformant"
  :file "src/kotoba/shohyo/ifrs.cljk"
  :find "core-ok? (= :complete (:shohyo/coverage r))"
  :replace "core-ok? (some? (:shohyo/coverage r))"}

 ;; This id first targeted an `(seq verdicts)` guard. It survived, and the
 ;; reason was not a missing test: coverage is `:checked` only when a line
 ;; declared an item, and lines live inside by-currency, so the guard could
 ;; never fire. The dead code is gone; the live invariant is that EVERY
 ;; currency must conform, not merely one.
 {:id :one-conformant-currency-is-enough
  :invariant "every currency must conform, not some — currencies do not mix"
  :file "src/kotoba/shohyo/ifrs.cljk"
  :find "(every? :conformant? (vals verdicts))"
  :replace "(some :conformant? (vals verdicts))"}

 {:id :presented-is-flattering
  :invariant "the convenient boolean gives the conservative answer, not the flattering one"
  :file "src/kotoba/shohyo/ifrs.cljk"
  :find "(true? (:shohyo.ifrs/conformant? (presentation r opts)))"
  :replace "(not (false? (:shohyo.ifrs/conformant? (presentation r opts))))"}

 {:id :not-declared-swallows-unverifiable
  :invariant "a chart declaring only unread-scope items is :checked-and-refused, not :not-declared"
  :file "src/kotoba/shohyo/ifrs.cljk"
  :find "(empty? declared)"
  :replace "(empty? requirable)"}

 {:id :unread-list-counts-instead-of-naming
  :invariant "what was not read is NAMED, the way missing items are"
  :file "src/kotoba/shohyo/ifrs.cljk"
  :find "(str/join \", \" scopes)"
  :replace "(str (count scopes))"}

 ;; --------------------------------------------------------------------
 ;; the one line this work added to the core
 ;; --------------------------------------------------------------------
 {:id :declaration-not-forwarded
  :invariant "the core carries the chart entry onto the line so a module can read its own key"
  :file "src/kotoba/shohyo.cljk"
  :find ":declared entry}))"
  :replace ":declared nil}))"}

 ;; ====================================================================
 ;; kotoba.shohyo.renketsu — 連結会計
 ;;
 ;; Written from the SOURCE, invariant by invariant, without consulting
 ;; `renketsu_test.cljc`. That is the point of the exercise: a mutation
 ;; aimed at what the tests happen to say measures the tests against
 ;; themselves.
 ;; ====================================================================

 ;; --------------------------------------------------------------------
 ;; 第六十三条 — the two modalities, and the scope as a determination
 ;; --------------------------------------------------------------------
 {:id :mandatory-ground-is-permissive
  :invariant "第六十三条第一項ただし書 is 含めないものとする, not a permission"
  :file "src/kotoba/shohyo/renketsu.cljk"
  :find "(= :mandatory (:modality (exclusion-grounds g)))"
  :replace "(= :permissive (:modality (exclusion-grounds g)))"}

 {:id :mandatory-exclusion-may-be-included
  :invariant "a subsidiary the regulation forbids consolidating is not consolidated"
  :file "src/kotoba/shohyo/renketsu.cljk"
  :find "(and (known-ground? ground) (mandatory-ground? ground) (= :included inclusion))"
  :replace "(and (known-ground? ground) (mandatory-ground? ground) (= :never inclusion))"}

 {:id :control-may-be-undeclared
  :invariant "control is a determination and its absence is not a pass"
  :file "src/kotoba/shohyo/renketsu.cljk"
  :find "(and (not parent?) (nil? control))"
  :replace "(and (not parent?) (false? control))"}

 {:id :inclusion-may-be-silent
  :invariant "silence about 連結の範囲 is neither in nor out"
  :file "src/kotoba/shohyo/renketsu.cljk"
  :find "(and (not parent?) (= :controlled control) (nil? inclusion))"
  :replace "(and (not parent?) (= :controlled control) (nil? :never))"}

 {:id :exclusion-needs-no-ground
  :invariant "an exclusion names the 号 it was made under"
  :file "src/kotoba/shohyo/renketsu.cljk"
  :find "(and (= :excluded inclusion) (nil? ground))"
  :replace "(and (= :excluded inclusion) (nil? :never))"}

 {:id :not-controlled-may-be-included
  :invariant "an entity outside 支配 cannot be inside 連結の範囲"
  :file "src/kotoba/shohyo/renketsu.cljk"
  :find "(and (= :not-controlled control) (= :included inclusion))"
  :replace "(and (= :not-controlled control) (= :never inclusion))"}

 {:id :excluded-subsidiaries-are-consolidated-anyway
  :invariant "only :included subsidiaries enter the fold"
  :file "src/kotoba/shohyo/renketsu.cljk"
  :find "(= :included (:renketsu/inclusion m))"
  :replace "(not= :never (:renketsu/inclusion m))"}

 {:id :scope-problems-do-not-stop-the-fold
  :invariant "no figures are produced on an unusable scope"
  :file "src/kotoba/shohyo/renketsu.cljk"
  :find "      (seq problems)\n      {:shohyo.renketsu/coverage :unusable-scope"
  :replace "      (seq nil)\n      {:shohyo.renketsu/coverage :unusable-scope"}

 {:id :an-empty-group-is-consolidatable
  :invariant "an undeclared scope is its own answer"
  :file "src/kotoba/shohyo/renketsu.cljk"
  :find "(empty? (:renketsu/members group))"
  :replace "(empty? [:something])"}

 ;; --------------------------------------------------------------------
 ;; the holding — two integers, and nothing divides
 ;; --------------------------------------------------------------------
 {:id :ownership-may-be-undeclared
  :invariant "whether a 非支配株主持分 arises cannot be known without the holding"
  :file "src/kotoba/shohyo/renketsu.cljk"
  :find "           (nil? ownership))"
  :replace "           (nil? :never))"}

 {:id :ownership-above-the-whole-is-usable
  :invariant "a holding cannot exceed the whole"
  :file "src/kotoba/shohyo/renketsu.cljk"
  :find "(<= n d)"
  :replace "(<= n (* 2 d))"}

 {:id :ownership-denominator-may-be-zero
  :invariant "a zero denominator is refused up front, not discovered later"
  :file "src/kotoba/shohyo/renketsu.cljk"
  :find "(pos? d) (<= 0 n)"
  :replace "(<= 0 d) (<= 0 n)"}

 {:id :wholly-owned-is-approximate
  :invariant "wholly owned is an exact integer identity"
  :file "src/kotoba/shohyo/renketsu.cljk"
  :find "[[n d]] (= n d))"
  :replace "[[n d]] (<= n d))"}

 {:id :a-partly-owned-subsidiary-raises-no-nci
  :invariant "a holding short of the whole raises a 非支配株主持分"
  :file "src/kotoba/shohyo/renketsu.cljk"
  :find "(not (wholly-owned? o))"
  :replace "(not (ownership-usable? o))"}

 ;; --------------------------------------------------------------------
 ;; 第六十八条 — the eliminations
 ;; --------------------------------------------------------------------
 {:id :a-leg-outside-the-scope-resolves
  :invariant "a leg naming an unconsolidated entity eliminates nothing"
  :file "src/kotoba/shohyo/renketsu.cljk"
  :find "(not (contains? in-scope e))"
  :replace "(contains? #{} e)"}

 {:id :a-leg-that-is-not-there-resolves
  :invariant "a leg naming a line that does not exist eliminates nothing"
  :file "src/kotoba/shohyo/renketsu.cljk"
  :find "(not (contains? by-key k))"
  :replace "(contains? #{} k)"}

 {:id :a-residual-eliminates-anyway
  :invariant "a pair that does not offset is not eliminated"
  :file "src/kotoba/shohyo/renketsu.cljk"
  :find "(if (zero? residual)"
  :replace "(if (number? residual)"}

 {:id :cross-currency-legs-are-netted
  :invariant "legs in two currencies are refused, never offset"
  :file "src/kotoba/shohyo/renketsu.cljk"
  :find "(< 1 (count currencies))"
  :replace "(< 99 (count currencies))"}

 {:id :a-one-legged-elimination-is-allowed
  :invariant "an elimination with one leg is a deletion"
  :file "src/kotoba/shohyo/renketsu.cljk"
  :find "(< (count legs) 2)"
  :replace "(< (count legs) 1)"}

 {:id :unpaired-counterparty-lines-are-not-named
  :invariant "a line the chart marked intercompany that no pair covered is named"
  :file "src/kotoba/shohyo/renketsu.cljk"
  :find "(when (and (some? cp)"
  :replace "(when (and (nil? cp)"}

 {:id :eliminated-lines-are-not-removed
  :invariant "an applied elimination actually changes the consolidated figures"
  :file "src/kotoba/shohyo/renketsu.cljk"
  :find ":remaining (vec (remove #(contains? eliminated-keys (line-key %)) lines))"
  :replace ":remaining (vec (remove #(contains? #{} (line-key %)) lines))"}

 {:id :standing-subsidiary-equity-is-fine
  :invariant "no equity line of a consolidated subsidiary may survive 資本連結"
  :file "src/kotoba/shohyo/renketsu.cljk"
  :find "(= :equity (:type l))"
  :replace "(= :never (:type l))"}

 {:id :the-parents-own-equity-must-also-be-eliminated
  :invariant "資本連結 eliminates the SUBSIDIARY's equity, not the parent's"
  :file "src/kotoba/shohyo/renketsu.cljk"
  :find "(let [subs (set (remove #(= % parent) in-scope))"
  :replace "(let [subs (set in-scope)"}

 ;; --------------------------------------------------------------------
 ;; currencies do not merge
 ;; --------------------------------------------------------------------
 {:id :currencies-are-folded-together
  :invariant "yen is never added to dollars"
  :file "src/kotoba/shohyo/renketsu.cljk"
  :find "(group-by :currency remaining)"
  :replace "(group-by (constantly \"JPY\") remaining)"}

 {:id :two-currencies-need-no-translation
  :invariant "a group reporting in two currencies is not conformant untranslated"
  :file "src/kotoba/shohyo/renketsu.cljk"
  :find "(if (< (count cs) 2)"
  :replace "(if (< (count cs) 9)"}

 ;; --------------------------------------------------------------------
 ;; 未実現損益, the members, and the conservative boolean
 ;; --------------------------------------------------------------------
 {:id :undeclared-unrealised-profit-is-answered
  :invariant "silence about 未実現損益 is not `no`"
  :file "src/kotoba/shohyo/renketsu.cljk"
  :find "{:answered? false :why :not-declared"
  :replace "{:answered? true :why :not-declared"}

 {:id :declared-unrealised-profit-is-answered
  :invariant "未実現損益 the caller says is present is refused, not waved through"
  :file "src/kotoba/shohyo/renketsu.cljk"
  :find "{:answered? false :why :not-eliminable"
  :replace "{:answered? true :why :not-eliminable"}

 {:id :an-incomplete-member-makes-a-whole-group
  :invariant "a member short by known accounts cannot make a whole group"
  :file "src/kotoba/shohyo/renketsu.cljk"
  :find "(seq incomplete-members) (conj :member-statement-incomplete)"
  :replace "(seq nil) (conj :member-statement-incomplete)"}

 {:id :the-consolidated-equation-is-not-checked
  :invariant "資産 = 負債 + 純資産 + 当期純利益 is checked on the GROUP too"
  :file "src/kotoba/shohyo/renketsu.cljk"
  :find "equation-ok? (shohyo/complete? consolidated)"
  :replace "equation-ok? true"}

 {:id :the-convenient-boolean-is-permissive
  :invariant "the convenient answer is the conservative one, not the flattering one"
  :file "src/kotoba/shohyo/renketsu.cljk"
  :find "[r] (true? (:shohyo.renketsu/conformant? r)))"
  :replace "[r] (not (false? (:shohyo.renketsu/conformant? r))))"}

 ;; --------------------------------------------------------------------
 ;; the taxlaw discipline, and the core function this module factored out
 ;; --------------------------------------------------------------------
 {:id :an-unread-provision-still-asserts
  :invariant "nothing may be asserted when no provision was read from source"
  :file "src/kotoba/shohyo/renketsu.cljk"
  :find "(boolean (seq (enforced-provisions)))"
  :replace "(boolean (seq [:something]))"}

 {:id :a-provision-marked-unenforced-backs-a-check
  :invariant "a provision quoted but marked :enforced? false backs nothing"
  :file "src/kotoba/shohyo/renketsu.cljk"
  :find "(remove #(false? (:enforced? %)))"
  :replace "(remove #(false? (:never-set %)))"}

 {:id :read-from-source-is-not-required
  :invariant "provision-read? admits only :read-from-source"
  :file "src/kotoba/shohyo/renketsu.cljk"
  :find "(= :read-from-source review))"
  :replace "(not= :never-happens review))"}

 {:id :fold-lines-does-not-net-revenue-against-expense
  :invariant "当期純利益 is revenue MINUS expenses, in the core fold"
  :file "src/kotoba/shohyo.cljk"
  :find "net (- (sum revenue) (sum expense))"
  :replace "net (+ (sum revenue) (sum expense))"}

 {:id :fold-lines-does-not-check-the-equation
  :invariant "the extracted fold still checks 資産 = 負債 + 純資産 + 当期純利益"
  :file "src/kotoba/shohyo.cljk"
  :find ":holds? (= lhs rhs)}}))"
  :replace ":holds? (<= lhs rhs)}}))"}

 ;; --------------------------------------------------------------------
 ;; Second blind round. Written after the first table was green, again
 ;; from the source only, aimed at the parts of the module the first
 ;; round did not name: the line key, the entity tag, the false-positive
 ;; direction of the unpaired scan, and the answers that are supposed to
 ;; be `answered? true`.
 ;; --------------------------------------------------------------------
 {:id :a-line-key-ignores-the-currency
  :invariant "the same account name in two currencies is two lines"
  :file "src/kotoba/shohyo/renketsu.cljk"
  :find "[(:renketsu/entity l) (:account l) (:currency l)])"
  :replace "[(:renketsu/entity l) (:account l)])"}

 {:id :lines-do-not-carry-the-entity-they-came-from
  :invariant "a leg is resolved by entity, account and currency together"
  :file "src/kotoba/shohyo/renketsu.cljk"
  :find "(map #(assoc % :renketsu/entity id :currency currency)"
  :replace "(map #(assoc % :renketsu/entity \"?\" :currency currency)"}

 {:id :eliminated-lines-are-also-reported-as-unpaired
  :invariant "the unpaired scan does not accuse a line that DID eliminate"
  :file "src/kotoba/shohyo/renketsu.cljk"
  :find "(not (contains? eliminated-keys (line-key l))))"
  :replace "(not (contains? #{} (line-key l))))"}

 {:id :the-nci-scan-includes-the-parent
  :invariant "a 非支配株主持分 arises from a SUBSIDIARY's minority, not the parent"
  :file "src/kotoba/shohyo/renketsu.cljk"
  :find "(when (and (not= id parent)"
  :replace "(when (and (not= id :never)"}

 {:id :a-wholly-owned-group-is-not-answered
  :invariant "no NCI arising is an ANSWER, not another refusal"
  :file "src/kotoba/shohyo/renketsu.cljk"
  :find "{:answered? true :arises? false :arises-from []"
  :replace "{:answered? false :arises? false :arises-from []"}

 {:id :clean-capital-consolidation-is-not-answered
  :invariant "no subsidiary equity standing is an ANSWER, not another refusal"
  :file "src/kotoba/shohyo/renketsu.cljk"
  :find "{:answered? true :standing-subsidiary-equity []"
  :replace "{:answered? false :standing-subsidiary-equity []"}

 {:id :one-currency-is-not-answered
  :invariant "a single-currency group needs no translation and says so"
  :file "src/kotoba/shohyo/renketsu.cljk"
  :find "{:answered? true :required? false :currencies cs}"
  :replace "{:answered? false :required? false :currencies cs}"}

 {:id :declaring-unrealised-profit-absent-is-not-answered
  :invariant "a declared absence is an answer the caller is allowed to give"
  :file "src/kotoba/shohyo/renketsu.cljk"
  :find "{:answered? true :declared :absent"
  :replace "{:answered? false :declared :absent"}

 {:id :a-pair-may-contradict-the-group-declaration
  :invariant "a group cannot declare absent what one of its pairs declares present"
  :file "src/kotoba/shohyo/renketsu.cljk"
  :find "(and (false? present) (seq declared-by-pair))"
  :replace "(and (false? present) (seq nil))"}

 {:id :translation-being-refused-does-not-block
  :invariant "an untranslated multi-currency group is not conformant"
  :file "src/kotoba/shohyo/renketsu.cljk"
  :find "(not (:answered? trans)) (conj :currency-translation-refused)"
  :replace "(not (:answered? nil)) (conj :currency-translation-refused)"}

 {:id :an-unmeasurable-nci-does-not-block
  :invariant "a 非支配株主持分 that cannot be measured is not conformant"
  :file "src/kotoba/shohyo/renketsu.cljk"
  :find "(not (:answered? nci)) (conj :non-controlling-interest-not-measurable)"
  :replace "(not (:answered? nil)) (conj :non-controlling-interest-not-measurable)"}

 {:id :unpaired-accounts-do-not-block
  :invariant "an intercompany line no pair covered is not conformant"
  :file "src/kotoba/shohyo/renketsu.cljk"
  :find "(seq (:unpaired elim)) (conj :intercompany-account-unpaired)"
  :replace "(seq nil) (conj :intercompany-account-unpaired)"}

 {:id :unmatched-pairs-do-not-block
  :invariant "a pair that did not eliminate is not conformant"
  :file "src/kotoba/shohyo/renketsu.cljk"
  :find "(seq (:unmatched elim)) (conj :intercompany-not-eliminated)"
  :replace "(seq nil) (conj :intercompany-not-eliminated)"}

 {:id :a-members-unclassified-accounts-are-dropped
  :invariant "an account no member's chart classified reaches the group's result"
  :file "src/kotoba/shohyo/renketsu.cljk"
  :find ":shohyo/unclassified unclassified"
  :replace ":shohyo/unclassified []"}

 {:id :the-group-is-complete-with-unclassified-accounts
  :invariant "the consolidated coverage answers :incomplete when a member is short"
  :file "src/kotoba/shohyo/renketsu.cljk"
  :find "(if (or (empty? by-cur) (seq unclassified))"
  :replace "(if (or (empty? by-cur) (seq nil))"}

 {:id :the-declared-holding-is-not-named-in-the-detail
  :invariant "a declared voting percentage is named so nobody thinks it was overlooked"
  :file "src/kotoba/shohyo/renketsu.cljk"
  :find "(pr-str (:renketsu/voting-rights m))"
  :replace "\"\""}
]
