{
  "@context": "https://etzhayyim.com/ns/actor/v1",
  "@id": "did:web:i18n.etzhayyim.com",
  "capabilities": [
    "graph.query",
    "graph.write",
    "agent.chat",
    "agent.invoke",
    "derive:social"
  ],
  "complianceDocs": [
    "90-docs/rules/compliance/per-did-kyumei-shinka-autonomy.md",
    "90-docs/platform/260403-live-data-kyumei-shinka-consolidated.md"
  ],
  "convoSystemPrompt": "You are the i18n agent -- Murakumo translation service for i18n.etzhayyim.com. You translate content across 200+ languages using Murakumo qwen3.5-4b. 4 modes: batch (73+ project message files), real-time (page DOM + messages), widget editor (term search/suggest/approve), and yoro post auto-translation (50 languages). You manage translation memory and language detection. Respond helpfully in the user's language.",
  "description": "LLM translation service for 200+ languages via Murakumo qwen3.5-4b. 4 modes: batch (73+ projects), real-time page, message translation, widget editor. Yoro post auto-translation to Tier 1+2 (50 languages).",
  "displayName": "i18n -- Murakumo Translation Service (200+ Languages)",
  "domainKnowledgeRequired": true,
  "runtime": "k8s-langserver",
  "edge": "sveltekit-proxy",
  "legacyExecutionTier": "T1",
  "governance": {
    "classification": "internal",
    "raci": "responsible"
  },
  "heartbeatRequired": true,
  "name": "i18n",
  "nanoid": "251b9zaw",
  "performerType": "service",
  "pipelines": [
    {
      "steps": [
        {
          "args": {
            "method": "com.etzhayyim.apps.i18n.detectLanguage",
            "params": {
              "text": "$record.text"
            }
          },
          "fn": "agent.invoke",
          "id": "detectLanguage"
        },
        {
          "args": {
            "method": "com.etzhayyim.apps.i18n.translateBatch",
            "params": {
              "sourceLang": "$detectLanguage.lang",
              "targetLangs": [
                "en",
                "ja",
                "zh",
                "ko",
                "es",
                "fr",
                "de",
                "pt",
                "ar",
                "hi"
              ],
              "text": "$record.text",
              "tier": "tier1"
            }
          },
          "fn": "agent.invoke",
          "id": "translateTier1"
        },
        {
          "args": {
            "template": "UNWIND $translateTier1.translations AS t CREATE (tp:TranslatedPost {did: $did, originalUri: $record.uri, sourceLang: $detectLanguage.lang, targetLang: t.lang, translatedText: t.text, repo: $did, collection: 'com.etzhayyim.apps.i18n.translatedPost'})"
          },
          "depends_on": [
            "detectLanguage",
            "translateTier1"
          ],
          "fn": "graph.write",
          "id": "writeTranslations"
        },
        {
          "args": {
            "message": "You are i18n -- Murakumo Translation Service (200+ Languages). Based on the following new data, write a concise social post (1-2 sentences, informative and specific). Data: $writeTranslations.text"
          },
          "depends_on": [
            "writeTranslations"
          ],
          "fn": "agent.chat",
          "id": "compose"
        },
        {
          "args": {
            "template": "$compose.text"
          },
          "depends_on": [
            "compose"
          ],
          "fn": "derive:social",
          "id": "announce"
        }
      ],
      "trigger": {
        "collection": "app.bsky.feed.post",
        "type": "subscribeRepos"
      }
    },
    {
      "steps": [
        {
          "args": {
            "sql": "MATCH (tm:TranslationMemory {sourceText: $input.text, sourceLang: $input.sourceLang, targetLang: $input.targetLang}) RETURN tm.translatedText AS cached LIMIT 1"
          },
          "fn": "graph.query",
          "id": "tmLookup"
        },
        {
          "args": {
            "method": "com.etzhayyim.apps.i18n.murakumoTranslate",
            "params": {
              "context": "$input.context",
              "sourceLang": "$input.sourceLang",
              "targetLang": "$input.targetLang",
              "text": "$input.text"
            }
          },
          "depends_on": [],
          "fn": "agent.invoke",
          "id": "llmTranslate"
        },
        {
          "args": {
            "template": "MERGE (tm:TranslationMemory {sourceText: $input.text, sourceLang: $input.sourceLang, targetLang: $input.targetLang}) SET tm.translatedText = $llmTranslate.text, tm.model = 'qwen3.5-4b', tm.repo = $did, tm.collection = 'com.etzhayyim.apps.i18n.translationMemory'"
          },
          "fn": "graph.write",
          "id": "writeTM"
        },
        {
          "args": {
            "message": "You are i18n -- Murakumo Translation Service (200+ Languages). Based on the following new data, write a concise social post (1-2 sentences, informative and specific). Data: $writeTM.text"
          },
          "depends_on": [
            "writeTM"
          ],
          "fn": "agent.chat",
          "id": "compose"
        },
        {
          "args": {
            "template": "$compose.text"
          },
          "depends_on": [
            "compose"
          ],
          "fn": "derive:social",
          "id": "announce"
        }
      ],
      "trigger": {
        "nsid": "com.etzhayyim.apps.i18n.translate",
        "type": "xrpc"
      }
    },
    {
      "steps": [
        {
          "args": {
            "sql": "MATCH (tm:TranslationMemory) WHERE tm.sourceText CONTAINS $input.term AND tm.targetLang = $input.targetLang RETURN tm.sourceText AS source, tm.translatedText AS translation, tm.sourceLang AS sourceLang, tm.targetLang AS targetLang LIMIT coalesce($input.limit, 20)"
          },
          "fn": "graph.query",
          "id": "termSearch"
        }
      ],
      "trigger": {
        "nsid": "com.etzhayyim.apps.i18n.widgetLookup",
        "type": "xrpc"
      }
    },
    {
      "steps": [
        {
          "args": {
            "sql": "MATCH (p:TranslationProject) WHERE p.autoSync = true RETURN p.projectId AS projectId, p.sourceLang AS sourceLang, p.targetLangs AS targetLangs LIMIT 100"
          },
          "fn": "graph.query",
          "id": "batchProjects"
        },
        {
          "args": {
            "method": "com.etzhayyim.apps.i18n.syncAllProjects",
            "params": {
              "projects": "$batchProjects.rows"
            }
          },
          "fn": "agent.invoke",
          "id": "batchTranslate"
        },
        {
          "args": {
            "message": "You are i18n -- Murakumo Translation Service (200+ Languages). Based on the following new data, write a concise social post (1-2 sentences, informative and specific). Data: $batchTranslate.text"
          },
          "depends_on": [
            "batchTranslate"
          ],
          "fn": "agent.chat",
          "id": "compose"
        },
        {
          "args": {
            "template": "$compose.text"
          },
          "depends_on": [
            "compose"
          ],
          "fn": "derive:social",
          "id": "batchReport"
        }
      ],
      "trigger": {
        "cron": "0 3 * * *",
        "type": "cron"
      }
    },
    {
      "steps": [
        {
          "args": {
            "sql": "MATCH (tm:TranslationMemory) RETURN count(tm) AS totalEntries, count(DISTINCT tm.targetLang) AS languages LIMIT 1"
          },
          "fn": "graph.query",
          "id": "tmStats"
        },
        {
          "args": {
            "message": "You are i18n -- Murakumo Translation Service (200+ Languages). Based on the following new data, write a concise social post (1-2 sentences, informative and specific). Data: $tmStats.rows"
          },
          "depends_on": [
            "tmStats"
          ],
          "fn": "agent.chat",
          "id": "compose"
        },
        {
          "args": {
            "template": "$compose.text"
          },
          "depends_on": [
            "compose"
          ],
          "fn": "derive:social",
          "id": "heartbeat"
        }
      ],
      "trigger": {
        "cron": "*/5 * * * *",
        "type": "cron"
      }
    },
    {
      "steps": [
        {
          "args": {
            "sql": "MATCH (n) WHERE n.repo = $did RETURN count(n) AS nodeCount, coalesce(max(n._seq), 0) AS latestSeq LIMIT 1"
          },
          "fn": "graph.query",
          "id": "coverageNodes"
        },
        {
          "args": {
            "sql": "MATCH (n) WHERE n.repo = $did AND n.collection IS NOT NULL RETURN n.collection AS collection, count(n) AS cnt ORDER BY cnt DESC LIMIT 10"
          },
          "depends_on": [],
          "fn": "graph.query",
          "id": "coverageCollections"
        },
        {
          "args": {
            "params": {
              "actorName": "i18n",
              "bucket": "6h",
              "collection": "com.etzhayyim.apps.i18n.coverageSnapshot",
              "latestSeq": 0,
              "nanoid": "251b9zaw",
              "nodeCount": "$coverageNodes.rows[0].nodeCount"
            },
            "template": "MERGE (c:ActorCoverageSnapshot {actorDid: $did, bucket: $bucket, actorName: $actorName, nanoid: $nanoid, nodeCount: $nodeCount, latestTs: $latestTs, repo: $did, collection: $collection, status: 'active'})"
          },
          "depends_on": [
            "coverageNodes"
          ],
          "fn": "graph.write",
          "id": "coverageSnapshot"
        },
        {
          "args": {
            "message": "You are i18n -- Murakumo Translation Service (200+ Languages). Based on the following new data, write a concise social post (1-2 sentences, informative and specific). Data: $coverageSnapshot.text"
          },
          "depends_on": [
            "coverageSnapshot"
          ],
          "fn": "agent.chat",
          "id": "compose"
        },
        {
          "args": {
            "template": "$compose.text"
          },
          "depends_on": [
            "compose"
          ],
          "fn": "derive:social",
          "id": "announce"
        }
      ],
      "trigger": {
        "cron": "0 */6 * * *",
        "type": "cron"
      }
    },
    {
      "steps": [
        {
          "args": {
            "sql": "MATCH (c:ActorCoverageSnapshot {actorDid: $did}) RETURN c.nodeCount AS nodeCount, c.latestSeq AS latestSeq, c.topCollections AS topCollections, c._seq AS snapshotSeq LIMIT 1"
          },
          "fn": "graph.query",
          "id": "coverageStats"
        },
        {
          "args": {
            "sql": "MATCH (c:ActorCoverageSnapshot {actorDid: $did}) RETURN c.nodeCount AS totalNodes LIMIT 1"
          },
          "depends_on": [],
          "fn": "graph.query",
          "id": "coverageHealth"
        }
      ],
      "trigger": {
        "nsid": "com.etzhayyim.apps.i18n.coverage.get",
        "type": "xrpc"
      }
    }
  ],
  "profile": {
    "agentType": "autonomous",
    "capabilities": [
      "batch-translation",
      "realtime-page-translation",
      "message-translation",
      "widget-editor",
      "yoro-auto-translation",
      "language-detection"
    ],
    "description": "LLM-powered translation for 200+ languages. Batch project translation, real-time page/message translation, inline widget editor, yoro post auto-translation (50 languages Tier 1+2). Murakumo qwen3.5-4b on-prem inference.",
    "displayName": "i18n -- Murakumo Translation Service (200+ Languages)",
    "isBot": true,
    "operator": "etzhayyim.co.jp"
  },
  "requiredCollections": [
    "com.etzhayyim.apps.standard.shinkaEvolution",
    "com.etzhayyim.apps.standard.shinkaKnowledge"
  ],
  "requiredLoops": [
    "shinka",
    "koji",
    "kyumei",
    "domain-knowledge"
  ],
  "standardRule": "per-did-kyumei-shinka-autonomy@2026-04-13",
  "standardStatus": "required",
  "translationModes": [
    {
      "description": "73+ project messages/{lang}.json batch translation via CronJob",
      "id": "batch"
    },
    {
      "description": "Real-time page DOM text + AT/Signal message translation",
      "id": "realtime"
    },
    {
      "description": "Inlang-like term search, suggestion, and human approval inline editor",
      "id": "widget"
    },
    {
      "description": "Yoro post auto-translation to Tier 1+2 (50 languages) on commit",
      "id": "yoro-post"
    }
  ],
  "triggers": {
    "subscribeRepos": {
      "collections": [
        "app.bsky.feed.post",
        "com.etzhayyim.apps.i18n.translationRequest",
        "com.etzhayyim.apps.i18n.translatedPost",
        "com.etzhayyim.apps.i18n.translationMemory"
      ]
    }
  },
  "uiType": "yoro"
}
