;; test/tr_test.cljk — build the command and compare it with the system tr,
;; byte for byte, on standard input.
;;
;; This does not assert that the guest COMPILES. It compiles it, packages it
;; into a standalone binary, runs that binary with each case's bytes on
;; standard input, and compares stdout, stderr and the exit status against
;; /usr/bin/tr fed the same bytes -- because `:ok true` from a compiler means
;; the artifact was built, not that it is right, and this repository's whole
;; claim is about what the artifact does.
;;
;; tr has no file operand: every case is {:argv [...] :stdin <fixture>}, and
;; stdin is fed as a Buffer (spawnSync applies :encoding "buffer" to a string
;; input and node refuses it).
;;
;;   AMU_HOME=<amu checkout> kbb --backend sci test/tr_test.cljk
;;
;; Exits 0 when every case matches, 1 on any difference, and 2 when it could
;; not run at all -- a distinct code, so "did not run" is never read as "ran
;; and found nothing".
(ns tr-test
  (:require [clojure.string :as str] ["fs" :as fs] ["path" :as path] ["os" :as os]))

(def cp (js/require "node:child_process"))

(defn- run [cmd args opts]
  (let [r (.spawnSync cp cmd (clj->js args)
                      (clj->js (merge {:encoding "buffer" :maxBuffer 67108864} opts)))]
    {:status (.-status r) :out (.-stdout r) :err (.-stderr r)}))

(defn- refuse [message]
  (println (pr-str {:ok false :phase :setup :message message}))
  (.exit js/process 2))

(def amu-home
  (or (.-AMU_HOME js/process.env)
      (let [guess (.resolve path (.cwd js/process) ".." ".." "kotoba-lang" "amu")]
        (when (.existsSync fs (.join path guess "bin" "amu")) guess))))

(def system-tr "/usr/bin/tr")

(def fixtures
  {"words"   "hello  world:foo bar\n  a  b\tc\n"
   "lines"   "one\ntwo\nthree\n"
   "empty"   ""
   "nonl"    "no trailing newline"
   ;; Multi-byte input with an ASCII set: the sequences pass through whole.
   "utf8"    "日本語 x é\n"
   "csv"     "a,b,c\n1,2,3\n"
   "colon"   "PATH:/usr/bin:/bin\n"
   "quotes"  "say \"hi\" \"there\"\n"
   "crlf"    "one\r\ntwo\r\n"
   "runs"    "aaa   bbb\n\n\nccc  \n"
   "mixed"   "Hello World 123\n"
   ;; Past one pipe buffer and past the 64 KiB chunk, with a squeezable
   ;; run straddling the chunk boundary: 65,535 x's then spaces.
   "big"     :big})

(defn- fixture-bytes [f]
  (let [v (get fixtures f)]
    (cond
      (= v :big) (str (.repeat "x" 65535) "      y"
                      (.repeat "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcde\n" 16384))
      (string? v) v
      :else (refuse (str "no fixture " (pr-str f))))))

;; Each case is an argv and a fixture. The measured forms first (2026-09-16,
;; 7,020 tr invocations in 1,268,018 agent Bash calls), then the boundaries
;; that separate a right table from a wrong one.
(def cases
  [;; --- the forms agents use, most frequent first ------------------------
   {:argv ["-d" " "] :stdin "words"}                 ; 2,261
   {:argv ["\\n" " "] :stdin "lines"}                ; 1,659
   {:argv ["-d" "\\n"] :stdin "lines"}               ;   228
   {:argv [":" "\\n"] :stdin "colon"}                ;   178
   {:argv ["," "\\n"] :stdin "csv"}                  ;   140
   {:argv ["/" "_"] :stdin "colon"}                  ;   109
   {:argv [" " "\\n"] :stdin "words"}                ;    95
   {:argv ["-d" "\""] :stdin "quotes"}               ;    76
   {:argv ["\\n" ":"] :stdin "lines"}                ;    67
   {:argv ["-d" "\\r"] :stdin "crlf"}                ;    65
   {:argv ["-s" " "] :stdin "runs"}                  ;    51
   {:argv ["\\n" "|"] :stdin "lines"}                ;    49
   {:argv ["-d" "[:space:]"] :stdin "words"}         ;    26
   {:argv ["-d" "\"\\n"] :stdin "quotes"}            ;    25
   {:argv ["\\t" "\\n"] :stdin "words"}              ;    23
   {:argv ["-s" " \\n" " \\n"] :stdin "runs"}        ;    23
   {:argv ["-" "_"] :stdin "mixed"}                  ;    21 (a lone "-" is a set)
   {:argv ["-d" " *"] :stdin "words"}                ;    16
   ;; --- ranges and classes ----------------------------------------------
   {:argv ["a-z" "A-Z"] :stdin "mixed"}
   {:argv ["[:lower:]" "[:upper:]"] :stdin "mixed"}
   {:argv ["[:upper:]" "[:lower:]"] :stdin "mixed"}
   {:argv ["-d" "[:digit:]"] :stdin "mixed"}
   {:argv ["-d" "[:punct:]"] :stdin "words"}
   {:argv ["-s" "[:blank:]"] :stdin "runs"}
   {:argv ["0-9" "#"] :stdin "csv"}
   ;; --- SET2 shorter than SET1: its last byte repeats (BSD) -------------
   {:argv ["abc" "x"] :stdin "runs"}
   {:argv ["abc" "xy"] :stdin "runs"}
   ;; --- -s with two sets squeezes SET2 after translating -----------------
   {:argv ["-s" "\\n" " "] :stdin "runs"}
   {:argv ["-s" "abc" "x"] :stdin "runs"}
   ;; --- -ds: delete SET1, then squeeze SET2 ------------------------------
   {:argv ["-ds" " " "a"] :stdin "runs"}
   {:argv ["-d" "-s" " " "b"] :stdin "runs"}
   ;; --- multi-byte input passes through; ASCII beside it is still mapped --
   {:argv ["x" "y"] :stdin "utf8"}
   {:argv ["-d" " "] :stdin "utf8"}
   {:argv ["a-z" "A-Z"] :stdin "utf8"}
   ;; --- edges ------------------------------------------------------------
   {:argv ["-d" " "] :stdin "empty"}
   {:argv ["a" "b"] :stdin "nonl"}
   {:argv ["\\\\" "/"] :stdin "colon"}
   {:argv ["\\101" "z"] :stdin "mixed"}               ; octal: 'A'
   ;; --- past the chunk: 64 KiB + squeeze across the boundary -------------
   {:argv ["-s" "x"] :stdin "big"}
   {:argv ["-d" "x"] :stdin "big"}
   {:argv ["x" "y"] :stdin "big"}
   ;; --- usage errors, matched: the usage block is measured, not typed ----
   {:argv [] :stdin "words"}
   {:argv ["a"] :stdin "words"}
   {:argv ["-d"] :stdin "words"}
   {:argv ["-d" "a" "b"] :stdin "words"}])

;; Behaviours this deliberately does NOT share with the system tr. Not
;; comparisons: the expected bytes are written out, because /usr/bin/tr
;; answers a different question. Each is named in the README.
(def divergences
  [{:label "-c is refused, not half-done"
    :argv ["-cd" "a"] :stdin "words"
    :out "" :exit 1
    :err "tr: only -d and -s are supported (no -c, -C, -u)\n"}
   {:label "a NUL escape is refused: no literal can hold it"
    :argv ["-d" "\\0"] :stdin "words"
    :out "" :exit 1
    :err "tr: a set may hold ASCII only, escapes \\n \\t \\r \\\\ \\NNN (1..177), ranges and the POSIX classes\n"}
   {:label "a set past ASCII is refused"
    :argv ["é" "e"] :stdin "utf8"
    :out "" :exit 1
    :err "tr: a set may hold ASCII only, escapes \\n \\t \\r \\\\ \\NNN (1..177), ranges and the POSIX classes\n"}
   {:label "an unknown class is refused"
    :argv ["-d" "[:nope:]"] :stdin "words"
    :out "" :exit 1
    :err "tr: a set may hold ASCII only, escapes \\n \\t \\r \\\\ \\NNN (1..177), ranges and the POSIX classes\n"}])

(when-not amu-home (refuse "set AMU_HOME to an amu checkout"))
(let [amu (.join path amu-home "bin" "amu")
      packager (.join path amu-home "scripts" "package-command.cljk")
      kbb (.join path amu-home "bin" "kbb")]
  (when-not (.existsSync fs amu) (refuse (str "no amu at " amu)))
  (when-not (.existsSync fs packager) (refuse (str "no packager at " packager)))
  (when-not (.existsSync fs system-tr) (refuse (str "no " system-tr " to compare against")))
  (let [tmp (.mkdtempSync fs (.join path (.tmpdir os) "org-ieee-tr-"))
        src (.resolve path (.cwd js/process) "tr" "core.kotoba")
        policy (.join path tmp "policy.edn")
        kexe (.join path tmp "tr.kexe")
        blob (.join path tmp "tr.bin")
        exe (.join path tmp "tr")]
    (.writeFileSync fs policy "{:allow #{[:cap/call 37] [:cap/call 38] [:cap/call 39] [:cap/call 41]}}" "utf8")
    (let [c (run "node" [amu "compile" src "--target" "aarch64-macos" "--jvm-free"
                         "--policy" policy "--output" kexe] {})]
      (when (not= 0 (:status c))
        (refuse (str "compile failed: " (str (:err c)) (str (:out c))))))
    (let [e (run "node" [amu "extract-native" kexe "--symbol" "main" "--output" blob] {})
          _ (when (not= 0 (:status e)) (refuse (str "extract failed: " (str (:err e)))))
          offset (second (re-find #":offset (\d+)" (str (:out e))))]
      (when-not offset (refuse (str "no :offset in the extract report: " (str (:out e)))))
      ;; The pool holds one 64 KiB chunk plus the walk's output at a time;
      ;; pairs are minted per changed byte within a chunk and reclaimed by
      ;; the region around it. Fuel covers the byte walk over the big case.
      (let [p (run "node" [kbb "--backend" "sci" packager "--code" blob "--offset" offset "--isa" "aarch64"
                           "--allow" "37,38,39,41"
                           "--fuel" "4000000000" "--pairs" "1000000" "--string-pool" "8000000"
                           "--output" exe] {})]
        (when (not= 0 (:status p)) (refuse (str "package failed: " (str (:err p)))))))
    ;; Now the only thing that matters: run it.
    (let [b64 (fn [buf] (.toString buf "base64"))
          results
          (for [c cases]
            (let [opts {:input (js/Buffer.from (fixture-bytes (:stdin c)) "utf8")}
                  k (run exe (:argv c) opts)
                  s (run system-tr (:argv c) opts)
                  same? (and (= (b64 (:out k)) (b64 (:out s)))
                             (= (b64 (:err k)) (b64 (:err s)))
                             (= (:status k) (:status s)))]
              {:case [(:argv c) :stdin (:stdin c)] :ok same?
               :kotoba (.toString (:out k) "utf8") :system (.toString (:out s) "utf8")
               :kotoba-err (.toString (:err k) "utf8") :system-err (.toString (:err s) "utf8")
               :exit [(:status k) (:status s)]}))
          div-results
          (for [d divergences]
            (let [k (run exe (:argv d) {:input (js/Buffer.from (fixture-bytes (:stdin d)) "utf8")})
                  ok? (and (= (.toString (:out k) "utf8") (:out d))
                           (= (.toString (:err k) "utf8") (:err d))
                           (= (:status k) (:exit d)))]
              {:case {:divergence (:label d) :argv (:argv d)} :ok ok?
               :kotoba (.toString (:out k) "utf8") :system "(not compared)"
               :kotoba-err (.toString (:err k) "utf8") :system-err (:err d)
               :exit [(:status k) (:exit d)]}))
          all (concat results div-results)
          bad (remove :ok all)]
      (doseq [r all]
        (println (str (if (:ok r) "  ok   " "  FAIL ")
                      (pr-str (:case r))
                      " -> " (pr-str (subs (:kotoba r) 0 (min 60 (count (:kotoba r)))))
                      (when-not (:ok r) (str " but " system-tr " says "
                                             (pr-str (subs (:system r) 0 (min 60 (count (:system r)))))
                                             " exits " (pr-str (:exit r))
                                             " stderr " (pr-str (:kotoba-err r)) " vs " (pr-str (:system-err r)))))))
      (println (pr-str {:ok (empty? bad) :cases (count all) :compared (count results)
                        :divergences (count div-results) :failed (count bad)}))
      (.exit js/process (if (seq bad) 1 0)))))
