(ns soko.ssr-test
  (:require [kotoba.lang.text] [kotoba.test :refer [deftest is]]
            [shitsuke.hiccup :as hic]
            [soko.ssr :as ssr]
            [soko.views :as views]))

(deftest root-html-stable-test
  (let [html (ssr/root-html)]
    (is (kotoba.lang.text/starts-with? html "<!doctype html>"))
    (is (kotoba.lang.text/includes? html "Warehouse / logistics"))
    (is (kotoba.lang.text/includes? html "shp_1"))
    (is (kotoba.lang.text/includes? html "1234")))) ; tracking

(deftest ssr-parity-test
  (is (= (hic/->html (views/root (ssr/sample-db)))
         (hic/->html (views/root (ssr/sample-db))))))
