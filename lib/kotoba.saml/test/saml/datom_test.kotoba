;; Test for saml.datom. main returns the number of failed cases.
(ns saml.datom-test
  (:export [main])
  (:require [saml.datom :as d]))

(defn- gv [m :document k :keyword] :document
  (option-value-of [:option :document] (document-get m k) (document-null)))
(defn- elem [xs :document i :i64] :document
  (option-value-of [:option :document] (document-vector-at xs i) (document-null)))
(defn- str-of [m :document k :keyword] :string
  (option-value-of [:option :string] (document-string-value (gv m k)) "<none>"))
(defn- bool-of [m :document k :keyword] :bool
  (option-value-of [:option :bool] (document-bool-value (gv m k)) false))
(defn- chk-str [got :string want :string] :i64
  (if (string=? got want) 0 1))
(defn- chk-bool [got :bool want :bool] :i64
  (if (= got want) 0 1))

(defn main [] :i64
  (let [req (document-map :saml.request/id (document-string "_r1")
                          :saml.request/issuer (document-string "idp")
                          :saml.request/acs-url (document-string "https://sp/acs")
                          :saml.request/created-at (document-string "t0"))
        row (elem (d/authn-request-datoms req) 0)
        c1 (chk-str (str-of row :db/id) "_r1")
        c2 (chk-str (str-of row :saml.request/issuer) "idp")
        c3 (chk-str (str-of row :saml.request/acs-url) "https://sp/acs")
        c4 (chk-bool (= (document-kind (gv row :saml.request/relay-state)) :null) true)
        res (document-map :saml.assertion/ok? (document-bool true)
                          :saml.assertion/issuer (document-string "idp")
                          :saml.assertion/subject (document-string "alice")
                          :saml.assertion/audience (document-string "sp"))
        arow (elem (d/assertion-result-datoms res) 0)
        c5 (chk-str (str-of arow :db/id) "saml:assertion:idp:alice")
        c6 (chk-bool (bool-of arow :saml.assertion/ok?) true)
        c7 (chk-str (str-of arow :saml.assertion/audience) "sp")
        c8 (chk-str (str-of arow :saml.assertion/subject) "alice")]
    (+ c1 (+ c2 (+ c3 (+ c4 (+ c5 (+ c6 (+ c7 c8)))))))))
