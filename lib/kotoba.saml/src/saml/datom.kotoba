;; Port of saml.datom (datom.cljk), Kotoba-native.
;; Maps are :document values; an absent key reads as null (the source reads nil).
;; Named divergence: the assertion :db/id is built with string-concat; a nil
;; issuer or subject renders as "" (as str does in the source).
(ns saml.datom
  (:export [authn-request-datoms assertion-result-datoms]))

(defn- gv [m :document k :keyword] :document
  (option-value-of [:option :document] (document-get m k) (document-null)))

(defn- text-of [x :document] :string
  (if (= (document-kind x) :null)
    ""
    (if (= (document-kind x) :string)
      (option-value-of [:option :string] (document-string-value x) "")
      (if (= (document-kind x) :i64)
        (string-from-i64 (option-value-of [:option :i64] (document-i64-value x) 0))
        (document-edn-print x)))))

(defn- assertion-id [result :document] :string
  (string-concat (string-concat (string-concat "saml:assertion:"
                                               (text-of (gv result :saml.assertion/issuer)))
                                ":")
                 (text-of (gv result :saml.assertion/subject))))

(defn authn-request-datoms [req :document] :document
  (document-vector
   (document-map :db/id (gv req :saml.request/id)
                 :saml.request/issuer (gv req :saml.request/issuer)
                 :saml.request/acs-url (gv req :saml.request/acs-url)
                 :saml.request/nameid-format (gv req :saml.request/nameid-format)
                 :saml.request/relay-state (gv req :saml.request/relay-state)
                 :saml.request/created-at (gv req :saml.request/created-at))))

(defn assertion-result-datoms [result :document] :document
  (document-vector
   (document-map :db/id (document-string (assertion-id result))
                 :saml.assertion/ok? (gv result :saml.assertion/ok?)
                 :saml.assertion/issuer (gv result :saml.assertion/issuer)
                 :saml.assertion/subject (gv result :saml.assertion/subject)
                 :saml.assertion/audience (gv result :saml.assertion/audience)
                 :saml.assertion/not-before (gv result :saml.assertion/not-before)
                 :saml.assertion/not-on-or-after (gv result :saml.assertion/not-on-or-after)
                 :saml.assertion/evidence-ref (gv result :saml.assertion/evidence-ref))))
