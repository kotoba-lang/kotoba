{:paths ["src"]
 ;; Zero dependencies by design -- a pure data-shape contract library,
 ;; the same "small shared .cljc contract library, zero I/O" role
 ;; kotoba-lang/robotics plays for the mission/action/safety-gate
 ;; contract. Consumers (any cloud-itonami-isic-* actor) take this as
 ;; a real pinned git-coordinate dependency, never :local/root, so it
 ;; stays forkable standalone outside the monorepo.
 :deps {
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
