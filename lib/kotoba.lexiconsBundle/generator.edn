{:schema "etzhayyim.lexicon-projection-generator/v1"
 :canonical-input-precedence ["<owner-repo>/data/lex/*.wire.edn"
                              "<owner-repo>/data/lex/*.edn"
                              "<owner-repo>/lex/*.edn"
                              "<owner-repo>/contracts/lexicons/*.edn"]
 :canonical-document-forms [{:form :map
                             :document-id [:id "id"]}
                            {:form :datom-vector
                             :document-id "sole distinct namespaced */id string value"}]
 :wire-output-precedence ["<owner-repo>/wire/lex/<record-name>.json"
                          "<owner-repo>/wire/lexicons/<record-name>.json"
                          "<owner-repo>/lexicons/<nsid-path>.json"]
 :command "kbb scripts/project-edn-lexicons.cljk --repo <owner-repo>"
 :freshness-command "kbb scripts/project-edn-lexicons.cljk --repo <owner-repo> --check"
 :test-command "test/project_edn_lexicons_test.sh"
 :properties [:deterministic :edn-canonical :flat-owner-output]}
