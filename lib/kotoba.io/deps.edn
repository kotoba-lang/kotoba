{:paths ["src"]
 :version "0.1.0"
 ;; kotoba-lang/io — Layer 3 (I/O) of the kotoba foundational stdlib.
 ;; IReader/IWriter protocols (host-injected) + a pure byte-buffer + copy.
 ;; The streaming abstraction the other libs and actors re-roll, in one place.
 ;; Zero third-party runtime deps; .cljc. See ADR-kotoba-lang-foundational-stdlib.md.
 :deps {
        ;; kotoba.bytes replaced UTF-8 .getBytes / String. here (2026-09-24). An explicit
        ;; floor: tools.deps takes the NEWEST sha it is shown.
        io.github.kotoba-lang/bytes {:local/root "../kotoba.bytes"}
        ;; kotoba.io replaced java.nio.file.Files here (2026-09-24). An explicit
        ;; floor: temp-dir temp-file read-all-bytes write-bytes write-string
        ;; delete-if-exists are in kotoba.io from this sha, and tools.deps takes
        ;; the NEWEST sha it is shown.

        ;; kotoba.test (clojure.test-compatible surface), not clojure.test --
        ;; scripts/migrate-clojure-test-to-kotoba-test.cljk. Explicit floor.
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}

}
 :aliases
 {:test {:extra-paths ["test"]}
}}
