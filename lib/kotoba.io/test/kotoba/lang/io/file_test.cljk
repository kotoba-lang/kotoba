(ns kotoba.lang.io.file-test
  "Every expected value here was measured on JVM clojure.java.io 2026-09-24
  (Clojure CLI, java.io.File on macOS); the same literals are asserted on
  Node, where a file is its path string. A JVM File is compared by `str`."
  (:require [kotoba.test :refer [deftest is testing]]
            [kotoba.io :as io]
            [kotoba.lang.io.file :as f]))

(defn- s [x] (when (some? x) (str x)))

(defn- thrown-msg [thunk]
  (try (thunk) nil
       (catch #?(:clj Throwable :cljs :default) e
         (or #?(:clj (.getMessage ^Throwable e) :cljs (ex-message e)) "<no message>"))))

(deftest file-normalises-like-java-io-file
  (doseq [[args expected] [[["a"] "a"]
                           [["a/"] "a"]
                           [["a//b/"] "a/b"]
                           [["/"] "/"]
                           [["//"] "/"]
                           [[""] ""]
                           [["./a/../b"] "./a/../b"]
                           [[nil] nil]
                           [["a" "b"] "a/b"]
                           [["a/" "b/"] "a/b"]
                           [["/" "b"] "/b"]
                           [["" "b"] "/b"]
                           [["a" ""] "a"]
                           [["" ""] "/"]
                           [["/" ""] "/"]
                           [[nil "b"] "b"]
                           [["a" "b" "c"] "a/b/c"]
                           [["a" "b//c"] "a/b/c"]
                           [["/a" "b"] "/a/b"]]]
    (testing (pr-str args)
      (is (= expected (s (apply io/file args)))))))

(deftest file-of-a-file
  (is (= "x/y" (s (io/file (io/file "x") "y")))))

(deftest file-refuses-what-the-jvm-refuses
  (is (= "/b is not a relative path" (thrown-msg #(io/file "a" "/b"))))
  (is (some? (thrown-msg #(io/file "a" nil))))
  (is (some? (thrown-msg #(io/file :k))))
  (is (some? (thrown-msg #(io/file 1)))))

(deftest as-file-and-as-relative-path
  (is (= "p/q" (s (io/as-file "p//q"))))
  (is (nil? (io/as-file nil)))
  (is (= "a/b" (io/as-relative-path "a/b/")))
  (is (= "" (io/as-relative-path "")))
  (is (= "/a is not a relative path" (thrown-msg #(io/as-relative-path "/a"))))
  (is (some? (thrown-msg #(io/as-relative-path nil)))))

(def ^:private host-fs #?(:cljs (js/require "fs") :clj nil))

(defn- tmp-dir []
  #?(:clj (str (io/temp-dir "kio-"))
     :cljs (.mkdtempSync host-fs (str (.tmpdir (js/require "os")) "/kio-"))))

(defn- exists? [p] #?(:clj (.exists (java.io.File. ^String p)) :cljs (.existsSync host-fs p)))
(defn- dir? [p] #?(:clj (.isDirectory (java.io.File. ^String p)) :cljs (and (.existsSync host-fs p) (.isDirectory (.statSync host-fs p)))))
(defn- touch! [p] #?(:clj (spit p "1") :cljs (.writeFileSync host-fs p "1")))

(deftest make-parents-answers-like-mkdirs
  (let [d (tmp-dir)]
    (is (true? (io/make-parents d "x" "y")) "created")
    (is (dir? (str d "/x")))
    (is (not (exists? (str d "/x/y"))) "the leaf is not made")
    (is (false? (io/make-parents d "x" "y")) "already there")
    (is (nil? (io/make-parents "zz")) "no parent")
    (is (nil? (io/make-parents "/")) "no parent")
    (touch! (str d "/x/f"))
    (is (false? (io/make-parents (str d "/x/f/g/h"))) "blocked by a file")))

(deftest delete-file-answers-like-java-io
  (let [d (tmp-dir)
        p (str d "/f")
        dd (str d "/empty")
        full (str d "/full")]
    (touch! p)
    (is (true? (io/delete-file p)))
    (is (not (exists? p)))
    (is (= (str "Couldn't delete " p) (thrown-msg #(io/delete-file p))))
    (is (true? (io/delete-file p true)))
    (is (= :q (io/delete-file p :q)))
    (is (= (str "Couldn't delete " p) (thrown-msg #(io/delete-file p false))))
    (io/make-parents dd "leaf")
    (is (true? (io/delete-file dd)) "an EMPTY directory is deleted")
    (io/make-parents full "leaf")
    (touch! (str full "/leaf"))
    (is (= :kept (io/delete-file full :kept)) "a non-empty directory is not deleted; silently is returned")
    (is (exists? (str full "/leaf")) "a non-empty directory is kept")))

(deftest the-facade-and-the-namespace-are-one-function
  (is (= f/file io/file))
  (is (= f/delete-file io/delete-file))
  (is (= f/make-parents io/make-parents)))
