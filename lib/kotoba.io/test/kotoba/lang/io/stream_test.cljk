(ns kotoba.lang.io.stream-test
  "clojure.java.io parity for resource / reader / writer / input-stream /
  output-stream / copy. `golden` below was MEASURED on the JVM (Temurin 21,
  Clojure 1.12, macOS/APFS, 2026-09-25) by `probe` over `jvm-ops`: raw
  clojure.java.io, not kotoba.io. The same probe runs through kotoba.io on
  every host and must give the same map; on the JVM the oracle test also
  runs, so a JVM run re-proves the literal.

  Paths are relativised (<T> the fixture directory). Bytes are compared as
  signed byte values (byte[] on the JVM, Int8Array on Node)."
  (:require [kotoba.bytes :as kbytes] [kotoba.test :refer [deftest is testing]]
            [kotoba.io :as io]
            [kotoba.io.reader :as ir]
            [kotoba.io.writer :as iw]
            [kotoba.lang.io.stream :as s]
            #?(:clj [clojure.java.io :as jio])))

(def ^:private host-fs #?(:cljs (js/require "fs") :clj nil))

;; ---------------------------------------------------------------------------
;; fixture, made and read with host calls only (never the functions under test)
;; ---------------------------------------------------------------------------

(defn- tmp-dir []
  #?(:clj (str (io/temp-dir "kio-stream-"))
     :cljs (.mkdtempSync host-fs (str (.tmpdir (js/require "os")) "/kio-stream-"))))

(defn- host-write! [p s] #?(:clj (spit p s) :cljs (.writeFileSync host-fs p s)))

(defn- host-bytes [p]
  #?(:clj (vec (io/read-all-bytes (java.io.File. ^String p)))
     :cljs (let [b (.readFileSync host-fs p)] (vec (js/Int8Array. (.-buffer b) (.-byteOffset b) (.-byteLength b))))))

(defn- host-text [p] #?(:clj (kbytes/utf8-string ^bytes (io/read-all-bytes (java.io.File. ^String p)))
                        :cljs (.readFileSync host-fs p "utf8")))

(defn- thrown-msg [thunk]
  (try (thunk) nil
       (catch #?(:clj Throwable :cljs :default) e
         (or #?(:clj (.getMessage ^Throwable e) :cljs (ex-message e)) "<no message>"))))

(defn- bytes-of [xs] #?(:clj (byte-array xs) :cljs (byte-array xs)))

;; ---------------------------------------------------------------------------
;; the probe, over an ops map
;; ---------------------------------------------------------------------------

(def kio-ops
  {:reader io/reader :writer io/writer :input-stream io/input-stream :output-stream io/output-stream
   :copy io/copy :resource io/resource :file io/file})

#?(:clj
   (def jvm-ops
     "The oracle: clojure.java.io itself."
     {:reader jio/reader :writer jio/writer :input-stream jio/input-stream :output-stream jio/output-stream
      :copy jio/copy :resource jio/resource :file jio/file}))

(defn probe
  "Every answer the ops give on a fresh fixture, as plain data."
  [{:keys [reader writer input-stream output-stream copy resource file]}]
  (let [t (tmp-dir)
        at #(str t "/" %)
        rel (fn [s] (when s (.replace (str s) t "<T>")))
        a (at "a.txt")]
    (host-write! (at "src.txt") "one\ntwo")
    (with-open [w (writer a)] (.write w "héllo\nwörld\r\nlast"))
    (let [lines (with-open [r (reader a)] (vec (line-seq r)))
          text1 (host-text a)
          _ (with-open [w (writer a :append true)] (.write w "!"))
          appended (host-text a)
          _ (with-open [w (writer (at "latin1.txt") :encoding "ISO-8859-1")] (.write w "é"))
          latin1 (host-bytes (at "latin1.txt"))
          latin1-back (with-open [r (reader (at "latin1.txt") :encoding "ISO-8859-1")] (slurp r))
          in-bytes (with-open [in (input-stream (bytes-of [1 2 -1]))] [(.read in) (.read in) (.read in) (.read in)])
          _ (with-open [o (output-stream (at "out.bin"))] (.write o 104) (.write o (bytes-of [105 33])))
          out-bin (host-text (at "out.bin"))
          _ (with-open [o (output-stream (at "out.bin") :append true)] (.write o 63))
          out-append (host-text (at "out.bin"))
          _ (copy "abc€" (file (at "copy-str.txt")))
          copy-str (host-bytes (at "copy-str.txt"))
          ;; a file as copy's INPUT goes through input-stream (a bare file value
          ;; is the path string on Node, which copy reads as content)
          _ (with-open [in (input-stream (file (at "src.txt")))] (copy in (file (at "copy-file.txt"))))
          copy-file (host-text (at "copy-file.txt"))
          _ (with-open [o (output-stream (at "copy-bytes.bin"))] (copy (bytes-of [120 121]) o))
          copy-bytes (host-text (at "copy-bytes.bin"))
          _ (with-open [r (reader a) w (writer (at "copy-rw.txt"))] (copy r w))
          copy-rw (host-text (at "copy-rw.txt"))
          _ (with-open [in (input-stream a)] (copy in (file (at "copy-in.txt"))))
          copy-in (host-text (at "copy-in.txt"))
          missing (rel (thrown-msg #(reader (at "nope.txt"))))
          missing-dir (rel (thrown-msg #(writer (at "no/such/dir.txt"))))
          hit (resource "kotoba/lang/io/stream.cljk")
          miss (resource "kotoba/no-such-resource.edn")]
      {:lines lines :text text1 :appended appended
       :latin1 latin1 :latin1-back latin1-back
       :in-bytes in-bytes :out-bin out-bin :out-append out-append
       :copy-str copy-str :copy-file copy-file :copy-bytes copy-bytes :copy-rw copy-rw :copy-in copy-in
       :missing missing :missing-dir missing-dir
       :resource-hit? (some? hit)
       :resource-names-it? (boolean (re-find #"kotoba/lang/io/stream\.cljk$" (str hit)))
       :resource-first-line (with-open [r (reader hit)] (first (line-seq r)))
       :resource-slurp-ns? (boolean (re-find #"^\(ns kotoba\.lang\.io\.stream" (slurp hit)))
       :resource-miss miss})))

(def golden
  "MEASURED on the JVM with jvm-ops (see the namespace docstring)."
  {:lines ["héllo" "wörld" "last"]
   :text "héllo\nwörld\r\nlast"
   :appended "héllo\nwörld\r\nlast!"
   :latin1 [-23]
   :latin1-back "é"
   :in-bytes [1 2 255 -1]
   :out-bin "hi!"
   :out-append "hi!?"
   :copy-str [97 98 99 -30 -126 -84]
   :copy-file "one\ntwo"
   :copy-bytes "xy"
   :copy-rw "héllo\nwörld\r\nlast!"
   :copy-in "héllo\nwörld\r\nlast!"
   :missing "<T>/nope.txt (No such file or directory)"
   :missing-dir "<T>/no/such/dir.txt (No such file or directory)"
   :resource-hit? true
   :resource-names-it? true
   :resource-first-line "(ns kotoba.lang.io.stream"
   :resource-slurp-ns? true
   :resource-miss nil})

(deftest kotoba-io-answers-as-clojure-java-io
  (let [got (probe kio-ops)]
    (doseq [[k v] golden]
      (testing (str k) (is (= v (get got k)))))
    (is (= (set (keys golden)) (set (keys got))))))

#?(:clj
   (deftest the-golden-literal-is-the-jvm
     (is (= golden (probe jvm-ops)))))

(deftest the-facade-and-the-namespace-are-one-function
  (is (= [s/resource s/reader s/writer s/input-stream s/output-stream s/copy]
         [io/resource io/reader io/writer io/input-stream io/output-stream io/copy])))

(deftest a-string-input-is-content-on-every-host
  ;; clojure.java.io/copy's contract: a String input is written, not opened
  (let [t (tmp-dir) out (str t "/s.txt")]
    (host-write! (str t "/src.txt") "file body")
    (io/copy (str t "/src.txt") (io/file out))
    (is (= (str t "/src.txt") (host-text out)))))

(deftest copy-still-drains-an-IReader-into-an-IWriter
  (let [chunks (atom ["ab" "cd"])
        out (atom [])
        rd (reify ir/Reader (read! [_] (let [c (first @chunks)] (swap! chunks rest) c)))
        wr (reify iw/Writer (write! [_ c] (swap! out conj c)))]
    (is (nil? (io/copy rd wr)))
    (is (= ["ab" "cd"] @out))))
