(ns kotoba.lang.io.file-ops-test
  "java.io.File method parity. `golden` below was MEASURED on the JVM
  (java.io.File, Temurin 21, macOS/APFS, 2026-09-24) by `jvm-ops`: raw
  interop, not kotoba.io. The same probe then runs through kotoba.io on
  every host and must give the same map. On the JVM the oracle test also runs,
  so a JVM run re-proves the literal each time.

  Paths are relativised: <T> the fixture directory, <CT> its canonical path,
  <CWD> user.dir. Directory listings are compared SORTED (java.io.File
  promises no order; both hosts list in readdir order). Values that depend on
  the file system rather than on the fixture (a directory's size and mtime)
  are reduced to :dir / :positive."
  (:require [kotoba.test :refer [deftest is testing]]
            [kotoba.io :as io]
            [kotoba.lang.io.file :as f]))

(def ^:private host-fs #?(:cljs (js/require "fs") :clj nil))

(defn- thrown-msg [thunk]
  (try (thunk) nil
       (catch #?(:clj Throwable :cljs :default) e
         (or #?(:clj (.getMessage ^Throwable e) :cljs (ex-message e)) "<no message>"))))

;; ---------------------------------------------------------------------------
;; fixture, made with host calls only (never the functions under test)
;; ---------------------------------------------------------------------------

(defn- tmp-dir []
  #?(:clj (str (.toFile (java.nio.file.Files/createTempDirectory "kio-ops-" (make-array java.nio.file.attribute.FileAttribute 0))))
     :cljs (.mkdtempSync host-fs (str (.tmpdir (js/require "os")) "/kio-ops-"))))

(defn- mkdir! [p] #?(:clj (.mkdir (java.io.File. ^String p)) :cljs (.mkdirSync host-fs p)))
(defn- write! [p s] #?(:clj (spit p s) :cljs (.writeFileSync host-fs p s)))
(defn- symlink! [target link]
  #?(:clj (java.nio.file.Files/createSymbolicLink (.toPath (java.io.File. ^String link)) (.toPath (java.io.File. ^String target))
                                                  (make-array java.nio.file.attribute.FileAttribute 0))
     :cljs (.symlinkSync host-fs target link)))
(defn- set-mtime! [p ms]
  #?(:clj (java.nio.file.Files/setLastModifiedTime (.toPath (java.io.File. ^String p)) (java.nio.file.attribute.FileTime/fromMillis ms))
     :cljs (.utimesSync host-fs p (/ (+ ms 0.5) 1000) (/ (+ ms 0.5) 1000))))
(defn- real-path [p]
  #?(:clj (str (.toRealPath (.toPath (java.io.File. ^String p)) (make-array java.nio.file.LinkOption 0)))
     :cljs (.native (.-realpathSync host-fs) p)))
(defn- cwd [] #?(:clj (System/getProperty "user.dir") :cljs (.cwd js/process)))
(defn- up [p] #?(:clj (.getParent (java.io.File. ^String p)) :cljs (.dirname (js/require "path") p)))

(def fixed-mtime 1700000000123)

(defn- fixture! []
  (let [t (tmp-dir) j #(str t "/" %)]
    (mkdir! (j "d"))
    (write! (j "d/f.txt") "hello")
    (write! (j "d/.hid") "")
    (mkdir! (j "d/sub"))
    (write! (j "d/sub/g") "0123456789")
    (mkdir! (j "e"))
    (symlink! "d" (j "link"))
    (symlink! "d/f.txt" (j "flink"))
    (symlink! "nowhere" (j "dangling"))
    (set-mtime! (j "d/f.txt") fixed-mtime)
    (set-mtime! (j "d/sub/g") (+ fixed-mtime 1))
    {:t t :ct (real-path t) :cwd (cwd) :ccwd (real-path (cwd)) :cwd-up (real-path (up (cwd)))}))

;; ---------------------------------------------------------------------------
;; the probe, over an ops map
;; ---------------------------------------------------------------------------

(def kio-ops
  {:exists? io/exists? :file? io/file? :directory? io/directory? :hidden? io/hidden?
   :absolute? io/absolute? :file-name io/file-name :path io/path :parent io/parent
   :parent-file io/parent-file :absolute-path io/absolute-path :absolute-file io/absolute-file
   :canonical-path io/canonical-path :canonical-file io/canonical-file :mkdir io/mkdir
   :mkdirs io/mkdirs :delete io/delete :create-new-file io/create-new-file :rename-to io/rename-to
   :length io/length :last-modified io/last-modified :set-last-modified io/set-last-modified
   :list-names io/list-names :list-files io/list-files :can-read? io/can-read?
   :can-write? io/can-write? :can-execute? io/can-execute? :file-seq io/file-seq
   :make-parents io/make-parents})

#?(:clj
   (def jvm-ops
     "The oracle: java.io.File's own methods (and clojure.core/file-seq,
     clojure.java.io/make-parents)."
     (let [F (fn [x] (clojure.java.io/as-file x))]
       {:exists? #(.exists ^java.io.File (F %)) :file? #(.isFile ^java.io.File (F %))
        :directory? #(.isDirectory ^java.io.File (F %)) :hidden? #(.isHidden ^java.io.File (F %))
        :absolute? #(.isAbsolute ^java.io.File (F %)) :file-name #(.getName ^java.io.File (F %))
        :path #(.getPath ^java.io.File (F %)) :parent #(.getParent ^java.io.File (F %))
        :parent-file #(.getParentFile ^java.io.File (F %)) :absolute-path #(.getAbsolutePath ^java.io.File (F %))
        :absolute-file #(.getAbsoluteFile ^java.io.File (F %)) :canonical-path #(.getCanonicalPath ^java.io.File (F %))
        :canonical-file #(.getCanonicalFile ^java.io.File (F %)) :mkdir #(.mkdir ^java.io.File (F %))
        :mkdirs #(.mkdirs ^java.io.File (F %)) :delete #(.delete ^java.io.File (F %))
        :create-new-file #(.createNewFile ^java.io.File (F %))
        :rename-to #(.renameTo ^java.io.File (F %1) ^java.io.File (F %2))
        :length #(.length ^java.io.File (F %)) :last-modified #(.lastModified ^java.io.File (F %))
        :set-last-modified #(.setLastModified ^java.io.File (F %1) (long %2))
        :list-names #(.list ^java.io.File (F %)) :list-files #(.listFiles ^java.io.File (F %))
        :can-read? #(.canRead ^java.io.File (F %)) :can-write? #(.canWrite ^java.io.File (F %))
        :can-execute? #(.canExecute ^java.io.File (F %)) :file-seq #(clojure.core/file-seq (F %))
        :make-parents clojure.java.io/make-parents})))

(def pure-paths ["" "." ".." "/" "//" "a" "a/" "a//b" "/a" "/a/b/" "./x/../y" ".hid" "d/.hid"
                 "a/b/c.txt" "/." "a/.." "..." "/.." "a/./b"])

(def fs-paths ["" "d" "d/f.txt" "d/.hid" "d/sub" "d/sub/g" "e" "link" "link/f.txt" "flink" "dangling"
               "nope" "nope/x" "d/f.txt/x" "link/../d/f.txt" "d/../d/sub/../f.txt" "d/./sub" "d/sub/.."
               "nope/../d" "link/.."])

(defn- relativise [{:keys [t ct cwd ccwd cwd-up]} s]
  (when (some? s)
    (let [s (str s)
          swap (fn [s pre tag] (if (and (seq pre) (.startsWith ^String s ^String pre)) (str tag (subs s (count pre))) s))]
      (if (= s cwd-up)
        "<CWD-UP>"
        (-> s (swap ct "<CT>") (swap t "<T>") (swap ccwd "<CWD>") (swap cwd "<CWD>"))))))

(defn- sorted-strs [fx arr] (when (some? arr) (vec (sort (map #(relativise fx %) (seq arr))))))

(defn probe
  "Every answer the ops give on a fresh fixture, as plain data."
  [ops]
  (let [fx (fixture!)
        {:keys [t]} fx
        op (fn [k & args] (apply (get ops k) args))
        R #(relativise fx %)
        at #(if (= "" %) t (str t "/" %))
        pure (into (sorted-map)
                   (for [p pure-paths]
                     [p {:name (op :file-name p) :path (op :path p) :parent (op :parent p)
                         :parent-file (some-> (op :parent-file p) str) :absolute? (op :absolute? p)
                         :hidden? (op :hidden? p) :absolute-path (R (op :absolute-path p))
                         :absolute-file (R (op :absolute-file p)) :canonical-path (R (op :canonical-path p))}]))
        on-fs (into (sorted-map)
                    (for [r fs-paths
                          :let [p (at r) dir? (op :directory? p)]]
                      [r {:exists? (op :exists? p) :file? (op :file? p) :directory? dir?
                          :hidden? (op :hidden? p)
                          :length (if dir? :dir (op :length p))
                          :last-modified (let [v (op :last-modified p)] (cond dir? :dir (zero? v) 0 (#{fixed-mtime (inc fixed-mtime)} v) v :else :positive))
                          :canonical-path (R (op :canonical-path p)) :canonical-file (R (op :canonical-file p))
                          :absolute-path (R (op :absolute-path p))
                          :can-read? (op :can-read? p) :can-write? (op :can-write? p) :can-execute? (op :can-execute? p)
                          :list-names (sorted-strs fx (op :list-names p))
                          :list-files (sorted-strs fx (op :list-files p))}]))
        m #(at (str "m/" %))
        mutations
        [[:mkdir-m (op :mkdir (at "m"))]
         [:mkdir-m-again (op :mkdir (at "m"))]
         [:mkdir-deep (op :mkdir (m "a/b"))]
         [:mkdirs-deep (op :mkdirs (m "a/b"))]
         [:mkdirs-deep-again (op :mkdirs (m "a/b"))]
         [:mkdirs-dotdot (op :mkdirs (m "q/../r"))]
         [:after-dotdot-q (op :exists? (m "q"))]
         [:after-dotdot-r (op :exists? (m "r"))]
         [:mkdirs-through-file (do (write! (m "plain") "x") (op :mkdirs (m "plain/x")))]
         [:mkdirs-empty (op :mkdirs "")]
         [:create (op :create-new-file (m "c"))]
         [:create-again (op :create-new-file (m "c"))]
         [:create-no-dir (thrown-msg #(op :create-new-file (m "zz/c")))]
         [:create-on-dir (op :create-new-file (m "a"))]
         [:rename (op :rename-to (m "c") (m "c2"))]
         [:rename-missing (op :rename-to (m "nope") (m "x"))]
         [:rename-into-missing-dir (op :rename-to (m "c2") (m "zz/c3"))]
         [:set-mtime (op :set-last-modified (m "c2") 1600000000123)]
         [:mtime (op :last-modified (m "c2"))]
         [:set-mtime-missing (op :set-last-modified (m "nope") 1600000000123)]
         [:set-mtime-negative (thrown-msg #(op :set-last-modified (m "c2") -1))]
         [:delete-nonempty (op :delete (m "a"))]
         [:delete-leaf (op :delete (m "a/b"))]
         [:delete-file (op :delete (m "c2"))]
         [:delete-again (op :delete (m "c2"))]
         [:delete-link (do (symlink! "a" (m "l")) (op :delete (m "l")))]
         [:link-target-kept (op :directory? (m "a"))]
         [:delete-empty-path (op :delete "")]
         [:make-parents (op :make-parents (m "p1/p2/leaf"))]
         [:make-parents-again (op :make-parents (m "p1/p2/leaf"))]
         [:make-parents-no-parent (op :make-parents "zz")]
         [:listing-after (sorted-strs fx (op :list-names (at "m")))]
         [:file-seq (vec (sort (map R (op :file-seq (at "d")))))]
         [:file-seq-file (vec (map R (op :file-seq (at "d/f.txt"))))]
         [:nil-throws (vec (for [k [:exists? :file-name :parent-file :canonical-path :mkdirs :delete :list-files]]
                             [k (some? (thrown-msg #(op k nil)))]))]]]
    {:pure pure :fs on-fs :mutations (into (sorted-map) mutations)}))

(def golden
