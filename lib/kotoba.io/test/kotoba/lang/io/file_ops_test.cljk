  {:pure
   {""
    {:path "",
     :absolute-file "<CWD>",
     :parent nil,
     :absolute-path "<CWD>",
     :name "",
     :canonical-path "<CWD>",
     :hidden? false,
     :parent-file nil,
     :absolute? false},
    "."
    {:path ".",
     :absolute-file "<CWD>/.",
     :parent nil,
     :absolute-path "<CWD>/.",
     :name ".",
     :canonical-path "<CWD>",
     :hidden? true,
     :parent-file nil,
     :absolute? false},
    ".."
    {:path "..",
     :absolute-file "<CWD>/..",
     :parent nil,
     :absolute-path "<CWD>/..",
     :name "..",
     :canonical-path "<CWD-UP>",
     :hidden? true,
     :parent-file nil,
     :absolute? false},
    "..."
    {:path "...",
     :absolute-file "<CWD>/...",
     :parent nil,
     :absolute-path "<CWD>/...",
     :name "...",
     :canonical-path "<CWD>/...",
     :hidden? true,
     :parent-file nil,
     :absolute? false},
    "./x/../y"
    {:path "./x/../y",
     :absolute-file "<CWD>/./x/../y",
     :parent "./x/..",
     :absolute-path "<CWD>/./x/../y",
     :name "y",
     :canonical-path "<CWD>/y",
     :hidden? false,
     :parent-file "./x/..",
     :absolute? false},
    ".hid"
    {:path ".hid",
     :absolute-file "<CWD>/.hid",
     :parent nil,
     :absolute-path "<CWD>/.hid",
     :name ".hid",
     :canonical-path "<CWD>/.hid",
     :hidden? true,
     :parent-file nil,
     :absolute? false},
    "/"
    {:path "/",
     :absolute-file "/",
     :parent nil,
     :absolute-path "/",
     :name "",
     :canonical-path "/",
     :hidden? false,
     :parent-file nil,
     :absolute? true},
    "/."
    {:path "/.",
     :absolute-file "/.",
     :parent "/",
     :absolute-path "/.",
     :name ".",
     :canonical-path "/",
