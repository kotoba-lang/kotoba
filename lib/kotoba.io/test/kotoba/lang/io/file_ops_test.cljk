(deftest kotoba-io-answers-as-java-io-file
  (let [got (probe kio-ops)]
    (doseq [section [:pure :fs :mutations]
            [k v] (get golden section)]
      (testing (pr-str [section k])
        (is (= v (get-in got [section k])))))
    (is (= (map (comp set keys) (vals golden)) (map (comp set keys) (vals got)))
        "the same cases were probed")))

#?(:clj
   (deftest the-golden-literal-is-the-jvm
     (is (= golden (probe jvm-ops)))))

(deftest the-facade-and-the-namespace-are-one-function
  (is (= f/exists? io/exists?))
  (is (= f/canonical-path io/canonical-path))
  (is (= f/list-files io/list-files))
  (is (= f/file-seq io/file-seq)))

(deftest listing-is-a-host-array-in-directory-order
  (let [{:keys [t]} (fixture!)
        names (io/list-names (str t "/d"))]
    (is (= 3 (count names)))
    (is (= #{"f.txt" ".hid" "sub"} (set names)))
    (is (= (map #(str t "/d/" %) names) (map str (io/list-files (str t "/d"))))
        "list-files is list-names resolved against the directory, in the same order")))
