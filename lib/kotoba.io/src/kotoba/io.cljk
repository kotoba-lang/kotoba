;; scripts/migrate-java-io-file-interop-to-kotoba-io.cljk (com-junkawasaki/root)
;; rewrites `(.exists f)` -> `(io/exists? f)` etc. with these.
#?(:kotoba nil
   :default
   (def exists? "See kotoba.lang.io.file/exists?." file-ns/exists?))
#?(:kotoba nil
   :default
   (def file? "See kotoba.lang.io.file/file?." file-ns/file?))
#?(:kotoba nil
   :default
   (def directory? "See kotoba.lang.io.file/directory?." file-ns/directory?))
#?(:kotoba nil
   :default
   (def hidden? "See kotoba.lang.io.file/hidden?." file-ns/hidden?))
#?(:kotoba nil
   :default
   (def absolute? "See kotoba.lang.io.file/absolute?." file-ns/absolute?))
#?(:kotoba nil
   :default
   (def file-name "See kotoba.lang.io.file/file-name." file-ns/file-name))
#?(:kotoba nil
   :default
   (def path "See kotoba.lang.io.file/path." file-ns/path))
#?(:kotoba nil
   :default
   (def parent "See kotoba.lang.io.file/parent." file-ns/parent))
#?(:kotoba nil
   :default
   (def parent-file "See kotoba.lang.io.file/parent-file." file-ns/parent-file))
#?(:kotoba nil
   :default
   (def absolute-path "See kotoba.lang.io.file/absolute-path." file-ns/absolute-path))
#?(:kotoba nil
   :default
   (def absolute-file "See kotoba.lang.io.file/absolute-file." file-ns/absolute-file))
#?(:kotoba nil
   :default
   (def canonical-path "See kotoba.lang.io.file/canonical-path." file-ns/canonical-path))
#?(:kotoba nil
   :default
   (def canonical-file "See kotoba.lang.io.file/canonical-file." file-ns/canonical-file))
#?(:kotoba nil
   :default
   (def mkdir "See kotoba.lang.io.file/mkdir." file-ns/mkdir))
#?(:kotoba nil
   :default
   (def mkdirs "See kotoba.lang.io.file/mkdirs." file-ns/mkdirs))
#?(:kotoba nil
   :default
   (def delete "See kotoba.lang.io.file/delete." file-ns/delete))
#?(:kotoba nil
   :default
   (def create-new-file "See kotoba.lang.io.file/create-new-file." file-ns/create-new-file))
#?(:kotoba nil
   :default
   (def rename-to "See kotoba.lang.io.file/rename-to." file-ns/rename-to))
#?(:kotoba nil
   :default
   (def length "See kotoba.lang.io.file/length." file-ns/length))
#?(:kotoba nil
   :default
   (def last-modified "See kotoba.lang.io.file/last-modified." file-ns/last-modified))
#?(:kotoba nil
   :default
   (def set-last-modified "See kotoba.lang.io.file/set-last-modified." file-ns/set-last-modified))
#?(:kotoba nil
   :default
   (def list-names "See kotoba.lang.io.file/list-names." file-ns/list-names))
#?(:kotoba nil
   :default
   (def list-files "See kotoba.lang.io.file/list-files." file-ns/list-files))
#?(:kotoba nil
   :default
   (def can-read? "See kotoba.lang.io.file/can-read?." file-ns/can-read?))
#?(:kotoba nil
   :default
   (def can-write? "See kotoba.lang.io.file/can-write?." file-ns/can-write?))
#?(:kotoba nil
