;; java.nio.file.Files, ambient (kotoba.lang.io.file): paths in and out are
;; file values, never java.nio.file.Path.
;; scripts/migrate-java-nio-file-files-to-kotoba-io.cljk (com-junkawasaki/root)
;; rewrites `(Files/createTempDirectory "p" (make-array FileAttribute 0))` ->
;; `(io/temp-dir "p")` etc. with these.
#?(:kotoba nil
   :default
   (def temp-dir "See kotoba.lang.io.file/temp-dir." file-ns/temp-dir))
#?(:kotoba nil
   :default
   (def temp-file "See kotoba.lang.io.file/temp-file." file-ns/temp-file))
#?(:kotoba nil
   :default
   (def read-all-bytes "See kotoba.lang.io.file/read-all-bytes." file-ns/read-all-bytes))
#?(:kotoba nil
   :default
   (def write-bytes "See kotoba.lang.io.file/write-bytes." file-ns/write-bytes))
#?(:kotoba nil
   :default
   (def write-string "See kotoba.lang.io.file/write-string." file-ns/write-string))
#?(:kotoba nil
   :default
   (def delete-if-exists "See kotoba.lang.io.file/delete-if-exists." file-ns/delete-if-exists))

;; Kotoba only: the host's buffer-writer appends into the buffer it was given,
;; so the caller reads that buffer; on Kotoba the buffer is a value and the
;; writer carries it, so the bytes written so far are read back here.
#?(:kotoba
   (defn written [writer [:record :kotoba.io.writer/BufferWriter [[:buf :vector-i64]]]] :bytes
     (iwriter-ns/written writer)))
