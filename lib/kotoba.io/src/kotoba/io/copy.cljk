(ns kotoba.io.copy
  "copy -- addressed on its own.

  Split out of kotoba.lang.io on 2026-09-09 (ADR-2609091200). The unit
  here is the DEFINITION, and this repo's deps.edn names exactly the
  definitions it reaches -- nothing else.

  KOTOBA reading: the same reduction as a tail recursion over the cursor
  operations of kotoba.io.reader (an aborting call may not precede `recur`),
  between the BufferReader and BufferWriter values; it returns the writer
  after the last chunk (the host returns nil). The :default branch is the
  host code, unchanged."
  #?(:kotoba (:schemas {:kotoba.io.reader/BufferReader
                    [:record :kotoba.io.reader/BufferReader [[:buf :vector-i64] [:done :i64]]]
                    :kotoba.io.writer/BufferWriter
                    [:record :kotoba.io.writer/BufferWriter [[:buf :vector-i64]]]}))
  (:require #?@(:kotoba [[kotoba.io.reader :as reader]
                         [kotoba.io.writer :as writer]]
                :default [[kotoba.io.reader :refer [Reader read!]]
                          [kotoba.io.writer :refer [Writer write!]]]))
)

#?(:kotoba
   (defn copy [source [:record :kotoba.io.reader/BufferReader [[:buf :vector-i64] [:done :i64]]]
               sink [:record :kotoba.io.writer/BufferWriter [[:buf :vector-i64]]]]
     [:record :kotoba.io.writer/BufferWriter [[:buf :vector-i64]]]
     (if (= 1 (reader/eof? source))
       sink
       (copy (reader/advance source)
             (writer/write! sink (reader/read! source)))))
   :default
   (defn copy
     "Drain `reader` into `writer` until EOF. Pure reduction over read!/write! —
  the host drives the loop (no threads)."
     [reader writer]
     (loop []
       (when-let [chunk (read! reader)]
         (write! writer chunk)
         (recur)))))
