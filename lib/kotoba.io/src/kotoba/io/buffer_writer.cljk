(ns kotoba.io.buffer-writer
  "buffer-writer -- addressed on its own.

  Split out of kotoba.lang.io on 2026-09-09 (ADR-2609091200). The unit
  here is the DEFINITION, and this repo's deps.edn names exactly the
  definitions it reaches -- nothing else.

  KOTOBA reading: the buffer is a `:bytes` value and the writer is
  kotoba.io.writer's BufferWriter, a value (read it back with
  kotoba.io.writer/written); see that file. The :default branch is the host
  code, unchanged."
  #?(:kotoba (:schemas {:kotoba.io.writer/BufferWriter
                    [:record :kotoba.io.writer/BufferWriter [[:buf :vector-i64]]]}))
  (:require #?@(:kotoba [[kotoba.io.writer :as writer]]
                :default [[kotoba.io.writer :refer [Writer write!]]
                          [kotoba.io.put :refer [put]]]))
)

#?(:kotoba
   (defn buffer-writer [buf :bytes] [:record :kotoba.io.writer/BufferWriter [[:buf :vector-i64]]]
     (writer/writer-of buf))
   :default
   (defn buffer-writer
     "Adapt `buf` as an Writer: each write appends the byte array to the buffer."
     [buf]
     (reify Writer
       (write! [_ chunk] (put buf chunk)))))
