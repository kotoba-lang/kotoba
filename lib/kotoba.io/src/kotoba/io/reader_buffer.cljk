(ns kotoba.io.reader-buffer
  "reader-buffer -- addressed on its own.

  Split out of kotoba.lang.io on 2026-09-09 (ADR-2609091200). The unit
  here is the DEFINITION, and this repo's deps.edn names exactly the
  definitions it reaches -- nothing else.

  KOTOBA reading: the buffer is a `:bytes` value and the reader is
  kotoba.io.reader's BufferReader (see that file). The :default branch is the
  host code, unchanged."
  #?(:kotoba (:schemas {:kotoba.io.reader/BufferReader
                    [:record :kotoba.io.reader/BufferReader [[:buf :vector-i64] [:done :i64]]]}))
  (:require #?@(:kotoba [[kotoba.io.reader :as reader]
                         [kotoba.io.to-bytes :refer [to-bytes]]]
                :default [[kotoba.io.reader :refer [Reader read!]]
                          [kotoba.io.to-bytes :refer [to-bytes]]]))
)

#?(:kotoba
   (defn reader-buffer [buf :bytes] [:record :kotoba.io.reader/BufferReader [[:buf :vector-i64] [:done :i64]]]
     (reader/reader-of (to-bytes buf)))
   :default
   (defn reader-buffer
     "Adapt `buf` as a one-shot Reader: a single read returns the whole buffer,
  then EOF."
     [buf]
     (let [done (atom false)]
       (reify Reader
         (read! [_]
           (if @done nil (do (reset! done true) (to-bytes buf))))))))
