(ns kotoba.io.reader-seq
  "reader-seq -- addressed on its own.

  Split out of kotoba.lang.io on 2026-09-09 (ADR-2609091200). The unit
  here is the DEFINITION, and this repo's deps.edn names exactly the
  definitions it reaches -- nothing else.

  KOTOBA reading: there are no lazy seqs over a cursor, so the chunks come
  back as a bounded typed list (`[:list :bytes]`, at most kotoba-sema's
  max-list-items), built eagerly with the cursor operations of
  kotoba.io.reader. The :default branch is the host code, unchanged."
  #?(:kotoba (:schemas {:kotoba.io.reader/BufferReader
                    [:record :kotoba.io.reader/BufferReader [[:buf :vector-i64] [:done :i64]]]}))
  (:require #?@(:kotoba [[kotoba.io.reader :as r]]
                :default [[kotoba.io.reader :refer [Reader read!]]]))
)

#?(:kotoba
   (defn- chunks-from [source [:record :kotoba.io.reader/BufferReader [[:buf :vector-i64] [:done :i64]]] acc [:list :bytes]]
     [:list :bytes]
     (if (= 1 (r/eof? source))
       acc
       (chunks-from (r/advance source)
                    (typed-list-conj [:list :bytes] acc (r/read! source)))))
   :default nil)

#?(:kotoba
   (defn reader-seq [source [:record :kotoba.io.reader/BufferReader [[:buf :vector-i64] [:done :i64]]]] [:list :bytes]
     (chunks-from source (typed-list-new [:list :bytes])))
   :default
   (defn reader-seq
     "A lazy seq of chunks from `reader` until EOF. Realizes on consumption."
     [reader]
     (lazy-seq
      (when-let [chunk (read! reader)]
        (cons chunk (reader-seq reader))))))
