(ns kotoba.io.reader
  "IReader -- addressed on its own.

  Split out of kotoba.lang.io on 2026-09-09 (ADR-2609091200). The unit
  here is the DEFINITION, and this repo's deps.edn names exactly the
  definitions it reaches -- nothing else.

  KOTOBA reading: closed immutable BufferReader cursor values, implemented by
  plain functions supported by the self-built compiler. The host protocol stays
  unchanged. Native read! returns the current bytes, eof? reports 0/1, and advance
  returns the next cursor. One buffer is one chunk, including an empty buffer.
  Internal octet vectors keep record schemas in the current closed profile;
  public chunks remain bytes. No native host protocol dispatch is implied."
  #?(:kotoba (:schemas {:kotoba.io.reader/BufferReader
                    [:record :kotoba.io.reader/BufferReader [[:buf :vector-i64] [:done :i64]]]})))

#?(:kotoba nil
   :default
   (defprotocol Reader
     (read! [reader] "Return the next chunk (a byte array) or nil at EOF.")))

;; Native cursor state has an internal octet vector. Public chunks remain bytes;
;; no host protocol dispatch or mutable cell crosses the native boundary.
#?(:kotoba
   (defn reader-of [buf :bytes] [:record :kotoba.io.reader/BufferReader [[:buf :vector-i64] [:done :i64]]]
     (record-new [:record :kotoba.io.reader/BufferReader [[:buf :vector-i64] [:done :i64]]] (vector-i64-from-bytes buf) 0)))
#?(:kotoba
   (defn read! [reader [:record :kotoba.io.reader/BufferReader [[:buf :vector-i64] [:done :i64]]]] :bytes
     (bytes-from-vector-i64 (record-get [:record :kotoba.io.reader/BufferReader [[:buf :vector-i64] [:done :i64]]] reader :buf))))
#?(:kotoba
   (defn eof? [reader [:record :kotoba.io.reader/BufferReader [[:buf :vector-i64] [:done :i64]]]] :i64
     (record-get [:record :kotoba.io.reader/BufferReader [[:buf :vector-i64] [:done :i64]]] reader :done)))
#?(:kotoba
   (defn advance [reader [:record :kotoba.io.reader/BufferReader [[:buf :vector-i64] [:done :i64]]]] [:record :kotoba.io.reader/BufferReader [[:buf :vector-i64] [:done :i64]]]
     (record-new [:record :kotoba.io.reader/BufferReader [[:buf :vector-i64] [:done :i64]]] (record-get [:record :kotoba.io.reader/BufferReader [[:buf :vector-i64] [:done :i64]]] reader :buf) 1)))
