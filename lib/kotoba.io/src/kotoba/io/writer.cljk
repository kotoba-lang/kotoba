(ns kotoba.io.writer
  "IWriter -- addressed on its own.

  Split out of kotoba.lang.io on 2026-09-09 (ADR-2609091200). The unit
  here is the DEFINITION, and this repo's deps.edn names exactly the
  definitions it reaches -- nothing else.

  KOTOBA reading: an immutable BufferWriter value with an internal octet
  vector. Native write! returns the updated writer; written returns its bytes.
  The host protocol remains unchanged and writes into its mutable buffer.
  Native code must use write!'s return value."
  #?(:kotoba (:schemas {:kotoba.io.writer/BufferWriter
                    [:record :kotoba.io.writer/BufferWriter [[:buf :vector-i64]]]})))

#?(:kotoba nil
   :default
   (defprotocol Writer
     (write! [writer chunk] "Append chunk (a byte array). Returns nil.")))

#?(:kotoba
   (defn writer-of [buf :bytes] [:record :kotoba.io.writer/BufferWriter [[:buf :vector-i64]]]
     (record-new [:record :kotoba.io.writer/BufferWriter [[:buf :vector-i64]]] (vector-i64-from-bytes buf))))
#?(:kotoba
   (defn write! [writer [:record :kotoba.io.writer/BufferWriter [[:buf :vector-i64]]] chunk :bytes] [:record :kotoba.io.writer/BufferWriter [[:buf :vector-i64]]]
     (record-new [:record :kotoba.io.writer/BufferWriter [[:buf :vector-i64]]]
       (vector-i64-from-bytes
         (bytes-concat (bytes-from-vector-i64 (record-get [:record :kotoba.io.writer/BufferWriter [[:buf :vector-i64]]] writer :buf)) chunk)))))
#?(:kotoba
   (defn written [writer [:record :kotoba.io.writer/BufferWriter [[:buf :vector-i64]]]] :bytes
     (bytes-from-vector-i64 (record-get [:record :kotoba.io.writer/BufferWriter [[:buf :vector-i64]]] writer :buf))))
