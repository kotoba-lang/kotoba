(ns kotoba.lang.io
  "Reader/Writer streaming abstraction for the kotoba foundational stdlib.
  Layer 3 (I/O).

  A capability-confined cell does not get a socket or file descriptor — the host
  grants a reader/writer handle. This namespace defines the protocols and the
  pure byte-buffer / copy glue; the host (or fs/http protocol impls) supplies
  the endpoints.

  Zero third-party runtime deps; .cljc (JVM / SCI / CLJS / GraalVM / kotoba-WASM).

  KOTOBA route (the :kotoba branches; the host code is unchanged): the
  protocols and `reify` are host-only. Here every name is a plain function over
  the one concrete reader / writer of kotoba.io.reader / kotoba.io.writer
  (BufferReader / BufferWriter), the buffer is a `:bytes` value
  (kotoba.io.byte-buffer), and each function delegates to its split module."
  (:refer-clojure :exclude [read write])
  #?(:kotoba (:schemas {:kotoba.io.reader/BufferReader
                        [:record :kotoba.io.reader/BufferReader [[:buf :vector-i64] [:done :i64]]]
                        :kotoba.io.writer/BufferWriter
                        [:record :kotoba.io.writer/BufferWriter [[:buf :vector-i64]]]}))
  (:require [kotoba.io.reader :as reader-p]
            [kotoba.io.writer :as writer-p]
            #?@(:kotoba [[kotoba.io.byte-buffer :as byte-buffer-p]
                         [kotoba.io.put :as put-p]
                         [kotoba.io.len :as len-p]
                         [kotoba.io.to-bytes :as to-bytes-p]
                         [kotoba.io.reader-buffer :as reader-buffer-p]
                         [kotoba.io.buffer-writer :as buffer-writer-p]
                         [kotoba.io.copy :as copy-p]
                         [kotoba.io.reader-seq :as reader-seq-p]])))

;; ---------- protocols ----------

#?(:kotoba nil
   :default
   (def IReader
     "The protocol itself lives in one repo of its own now. This name is that
     SAME protocol, not a second one: an implementation reified against either
     is accepted by both (ADR-2609091900)."
     reader-p/Reader))

#?(:kotoba nil
   :default
   (def read! reader-p/read!))

#?(:kotoba nil
   :default
   (def IWriter
     "The protocol itself lives in one repo of its own now. This name is that
     SAME protocol, not a second one: an implementation reified against either
     is accepted by both (ADR-2609091900)."
     writer-p/Writer))

#?(:kotoba nil
   :default
   (def write! writer-p/write!))

;; ---------- pure byte-buffer ----------

#?(:kotoba nil
   :default
   (defn byte-buffer
     "A pure growable byte buffer backed by a persistent vector of unsigned byte
     values (ints 0–255). Portable to WASM (no ByteArrayOutputStream)."
     []
     (atom [])))

#?(:kotoba nil
   :default
   (defn put
     "Append a byte array `arr` to `buf`. Each byte stored as an unsigned int 0–255."
     [buf ^bytes arr]
     (swap! buf into (map #(bit-and (int %) 0xFF) (seq arr)))
     buf))

#?(:kotoba nil
   :default
   (defn len [buf] (count @buf)))

#?(:kotoba nil
   :default
   (defn to-bytes
     "Materialize the buffer as a fresh byte array."
     [buf]
     (let [v @buf
           n (count v)
           arr #?(:clj (byte-array n) :cljs (js/Uint8Array. n))]
       (reduce-kv (fn [_ i b] #?(:clj (aset-byte arr i (unchecked-byte b))
                                 :cljs (aset arr i b)))
                  arr v)
       arr)))

#?(:kotoba nil
   :default
   (defn reader-buffer
     "Adapt `buf` as a one-shot IReader: a single read returns the whole buffer,
     then EOF."
     [buf]
     (let [done (atom false)]
       (reify IReader
         (read! [_]
           (if @done nil (do (reset! done true) (to-bytes buf))))))))

#?(:kotoba nil
   :default
   (defn buffer-writer
     "Adapt `buf` as an IWriter: each write appends the byte array to the buffer."
     [buf]
     (reify IWriter
       (write! [_ chunk] (put buf chunk)))))

;; ---------- copy / reader-seq ----------

#?(:kotoba nil
   :default
   (defn copy
     "Drain `reader` into `writer` until EOF. Pure reduction over read!/write! —
     the host drives the loop (no threads)."
     [reader writer]
     (loop []
       (when-let [chunk (read! reader)]
         (write! writer chunk)
         (recur)))))

#?(:kotoba nil
   :default
   (defn reader-seq
     "A lazy seq of chunks from `reader` until EOF. Realizes on consumption."
     [reader]
     (lazy-seq
      (when-let [chunk (read! reader)]
        (cons chunk (reader-seq reader))))))

#?(:kotoba
   (defn read! [reader [:record :kotoba.io.reader/BufferReader [[:buf :vector-i64] [:done :i64]]]] :bytes
     (reader-p/read! reader)))

#?(:kotoba
   (defn write! [writer [:record :kotoba.io.writer/BufferWriter [[:buf :vector-i64]]] chunk :bytes] [:record :kotoba.io.writer/BufferWriter [[:buf :vector-i64]]]
     (writer-p/write! writer chunk)))

#?(:kotoba
   (defn byte-buffer [] :bytes
     (byte-buffer-p/byte-buffer)))

#?(:kotoba
   (defn put [buf :bytes arr :bytes] :bytes
     (put-p/put buf arr)))

#?(:kotoba
   (defn len [buf :bytes] :i64
     (len-p/len buf)))

#?(:kotoba
   (defn to-bytes [buf :bytes] :bytes
     (to-bytes-p/to-bytes buf)))

#?(:kotoba
   (defn reader-buffer [buf :bytes] [:record :kotoba.io.reader/BufferReader [[:buf :vector-i64] [:done :i64]]]
     (reader-buffer-p/reader-buffer buf)))

#?(:kotoba
   (defn buffer-writer [buf :bytes] [:record :kotoba.io.writer/BufferWriter [[:buf :vector-i64]]]
     (buffer-writer-p/buffer-writer buf)))

#?(:kotoba
   (defn copy [reader [:record :kotoba.io.reader/BufferReader [[:buf :vector-i64] [:done :i64]]] writer [:record :kotoba.io.writer/BufferWriter [[:buf :vector-i64]]]] [:record :kotoba.io.writer/BufferWriter [[:buf :vector-i64]]]
     (copy-p/copy reader writer)))

#?(:kotoba
   (defn reader-seq [reader [:record :kotoba.io.reader/BufferReader [[:buf :vector-i64] [:done :i64]]]] [:list :bytes]
     (reader-seq-p/reader-seq reader)))

;; Kotoba only (see kotoba.io/written): the bytes a BufferWriter has received.
#?(:kotoba
   (defn written [writer [:record :kotoba.io.writer/BufferWriter [[:buf :vector-i64]]]] :bytes
     (writer-p/written writer)))
