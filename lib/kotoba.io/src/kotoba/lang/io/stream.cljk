(ns kotoba.lang.io.stream
  "The rest of clojure.java.io's surface, for the portable subset of its
  arguments: classpath resources and the four stream makers plus copy.

    resource  reader  writer  input-stream  output-stream  copy

  JVM: each var IS clojure.java.io's (delegation), so a JVM caller gets the
  same java.net.URL, the same java.io streams and the same exceptions as
  before.

  The kbb engine (:org.babashka/nbb): each var is the engine's own
  implementation of that clojure.java.io var (kotoba-lang/org-babashka-nbb
  nbb.jvm / nbb.jvm.io: FileInputStream / BufferedReader / ... with the JDK's
  buffering, readLine, exceptions and messages, checked there against JDK 21
  / Clojure 1.12), so the stream objects are the ones the engine's own
  with-open, line-seq, slurp and spit accept -- a stream this namespace makes
  is usable exactly where the clojure.java.io one was. `resource` is the
  engine's classpath lookup (the --classpath / project :paths entries; jars
  are not on that classpath) and answers a js/URL, which slurp and reader
  accept.

  The portable subset, measured against a real JDK (test/kotoba/lang/io/
  stream_test.cljk, golden from Temurin 21 / Clojure 1.12): file paths and
  file values, strings and byte arrays as sources, :append and :encoding,
  line-seq over a reader, copy between strings / byte arrays / files /
  streams / readers / writers, a missing file's FileNotFoundException
  message, and resource lookups that hit (slurp of the URL) or miss (nil).
  Known deviation: (str (resource ..)) is \"file:/..\" on the JVM and
  \"file:///..\" on the engine (both are the same file URL).

  copy and file values: a kotoba file value is a java.io.File on the JVM and
  its path STRING on the engine. As copy's OUTPUT that is unambiguous (copy
  takes no String output), so it names the file on both hosts. As copy's
  INPUT it is NOT portable: a String input is CONTENT (clojure.java.io's
  contract), so on the engine (copy (file p) out) copies the characters of
  p. Write (copy (input-stream (file p)) out) -- the same bytes on both
  hosts; scripts/migrate-clojure-java-io-to-kotoba-io.cljk moves a copy call
  only when its input is provably not a file value.

  copy dispatches: when `input` implements kotoba.io.reader/Reader it is
  kotoba.io.copy/copy (drain an IReader into an IWriter, unchanged -- the
  function kotoba.io/copy has always been); anything else is
  clojure.java.io/copy's contract above.

  Any other ClojureScript host (a browser build) has neither a classpath nor
  java.io streams: each var throws ex-info {:kotoba.io/op ..} saying so."
  (:require [kotoba.io.copy :as drain]
            [kotoba.io.reader :as r]
            #?(:clj [clojure.java.io :as jio]
               :org.babashka/nbb [clojure.java.io :as jio])))

#?(:cljs
   (defn- no-host! [op]
     (throw (ex-info (str "kotoba.io/" (name op) ": this host has no classpath / java.io streams "
                          "(the JVM and the kbb engine do)")
                     {:kotoba.io/op op}))))

(defn resource
  "clojure.java.io/resource: the classpath entry named `n` as a URL (JVM:
  java.net.URL, kbb: js/URL), or nil."
  ([n]
   #?(:clj (jio/resource n)
      :org.babashka/nbb (jio/resource n)
      :cljs (no-host! :resource)))
  ([n loader]
   #?(:clj (jio/resource n loader)
      :org.babashka/nbb (jio/resource n loader)
      :cljs (no-host! :resource))))

(defn reader
  "clojure.java.io/reader: a BufferedReader over x (a path, a file, a URL, a
  stream, a reader, a byte array ...). opts :encoding (default UTF-8)."
  [x & opts]
  #?(:clj (apply jio/reader x opts)
     :org.babashka/nbb (apply jio/reader x opts)
     :cljs (no-host! :reader)))

(defn writer
  "clojure.java.io/writer: a BufferedWriter onto x. opts :append :encoding."
  [x & opts]
  #?(:clj (apply jio/writer x opts)
     :org.babashka/nbb (apply jio/writer x opts)
     :cljs (no-host! :writer)))

(defn input-stream
  "clojure.java.io/input-stream: a BufferedInputStream over x."
  [x & opts]
  #?(:clj (apply jio/input-stream x opts)
     :org.babashka/nbb (apply jio/input-stream x opts)
     :cljs (no-host! :input-stream)))

(defn output-stream
  "clojure.java.io/output-stream: a BufferedOutputStream onto x. opts :append."
  [x & opts]
  #?(:clj (apply jio/output-stream x opts)
     :org.babashka/nbb (apply jio/output-stream x opts)
     :cljs (no-host! :output-stream)))

(defn copy
  "`input` implementing kotoba.io.reader/Reader: drain it into the IWriter
  `output` (kotoba.io.copy/copy). Otherwise clojure.java.io/copy: input a
  string, byte array, file, stream or reader; output a file, stream or
  writer; opts :buffer-size :encoding. Returns nil."
  [input output & opts]
  (if (satisfies? r/Reader input)
    (drain/copy input output)
    #?(:clj (apply jio/copy input output opts)
       ;; a kotoba file value is its path STRING here: as the OUTPUT it names
       ;; the file (the JVM's File); clojure.java.io/copy takes no String
       ;; output on either host, so this is the only reading
       :org.babashka/nbb (apply jio/copy input (if (string? output) (jio/file output) output) opts)
       :cljs (no-host! :copy))))
