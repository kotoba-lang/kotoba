  "identifier": "etzhayyim-project-vector-embedding",
  "name": "Etzhayyim Vector Embedding",
  "status": "Proposed",
  "description": "Text, image, video, audio, and future sensor embeddings for Etzhayyim search. The project owns embedding model registry, source/chunk metadata, the Phase 1 RisingWave vector(768) table, and future projection into a unified sensor-inclusive Etzhayyim embedding space.",
  "capabilities": {
    "@type": "DefinedTermSet",
    "name": "Capabilities",
    "terms": [
      {
        "@type": "DefinedTerm",
        "identifier": "cap:vector-embedding:model-registry",
        "name": "Embedding Model Registry",
        "description": "Track model_id, modality support, dimensions, license, and embedding space ownership."
      },
      {
        "@type": "DefinedTerm",
        "identifier": "cap:vector-embedding:multimodal-index",
        "name": "Multimodal Vector Index",
        "description": "Store Phase 1 append-only vector(768) embeddings for text, image, video, audio, and later sensor modalities."
      },
      {
        "@type": "DefinedTerm",
        "identifier": "cap:vector-embedding:unified-projection",
        "name": "Unified Projection",
        "description": "Support later projection from raw model spaces into a reusable Etzhayyim 768d sensor-inclusive embedding space."
      }
    ]
  },
