           (fixture-case :unknown-literal-encoding (flat 1 (vector1 i)) :invalid-rodata-content i))
      59 (let [i (-> (ins :gmir/function-address) (node/put-key :gmir/dst (reg 0)) (node/put-key :gmir/function (kw-value :main)))]
           (fixture-case :function-address-type (wrap (vector1 i)) :invalid-function-address i))
      (fixture-case :invalid-fixture-index (node/nil-value) :fixture-out-of-range (node/nil-value)))]
    (if (and (>= index 0) (< index (fixture-count))) (option-some-of [:option [:ref :gmir.validation/case]] test)
      (option-none-of [:option [:ref :gmir.validation/case]]))))

(defn check-fixture [index :i64] :i64
  (let [found (fixture index)]
    (if (not (option-some?-of [:option [:ref :gmir.validation/case]] found)) 2
      (let [test (option-value-of [:option [:ref :gmir.validation/case]] found
                   (fixture-case :missing (node/nil-value) :missing (node/nil-value)))
            program (record-get [:ref :gmir.validation/case] test :program)
            problem (record-get [:ref :gmir.validation/case] test :problem)]
        (if (if (= problem :ok) (accepted? program)
                (refused? program problem (record-get [:ref :gmir.validation/case] test :data))) 0 1)))))
(defn main [] :i64
  (cond
    (not (gmir/vreg? (reg 0))) 100
    (not (all-keysets?)) 101
    (not (all-arities? (gmir/runtime-operation-arities) :gmir/runtime-call :gmir/runtime :invalid-runtime-call)) 102
    (not (all-arities? (gmir/x86-privileged-action-arities) :gmir/x86-privileged :gmir/action :invalid-x86-privileged)) 103
    (not (all-capabilities?)) 104
    :else (loop [index 0]
            (if (>= index (fixture-count)) 0
              (if (= (arena-scope (check-fixture index)) 0) (recur (+ index 1)) (+ index 1))))))
