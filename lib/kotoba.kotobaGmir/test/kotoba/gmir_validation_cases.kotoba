      35 (fixture-case :entry-link (module (sym "missing") (vector1 (function (sym "main") (node/i64-value 0) (node/empty-vector))))
             :missing-entry-function (node/put-key (node/empty-map) :entry (sym "missing")))
      36 (let [f (function (sym "main") (node/i64-value 65) (node/empty-vector))]
           (fixture-case :function-bound (module (sym "main") (vector1 f)) :non-canonical-function f))
      37 (let [code (vector2 (argument (node/i64-value 0)) (argument (node/i64-value 0)))]
           (fixture-case :argument-duplicate (wrap code) :invalid-function-arguments
