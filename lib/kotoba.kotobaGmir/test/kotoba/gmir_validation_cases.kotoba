           (passes :ucs2-parent (flat 1 (vector1 i))))
      57 (let [i (-> (ins :gmir/rodata-address) (node/put-key :gmir/dst (reg 0)) (node/put-key :gmir/rodata-encoding (kw-value :guid-mixed-endian))
