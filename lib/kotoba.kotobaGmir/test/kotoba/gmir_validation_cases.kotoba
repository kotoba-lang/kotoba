;; Native-only self-check source for the whole owning validator contract.
;; All rows/arities/capabilities and fixed fixtures run in the whole native image.
(ns kotoba.gmir-validation-cases
  {:kotoba/export [main check-fixture fixture-count]}
  (:require [kotoba.gmir :as gmir] [kotoba.gmir.node :as node]
            [kotoba.gmir.identity :as identity] [kotoba.gmir.catalog :as catalog]
            [kotoba.gmir.outcome :as outcome])
  (:schemas
   {:gmir.validation/case [:record :gmir.validation/case
      [[:name :keyword] [:program [:ref :gmir.node/value]] [:problem :keyword]
       [:data [:ref :gmir.node/value]]]]}))

(defn- at [value [:ref :gmir.node/value] index :i64] [:ref :gmir.node/value]
  (option-match [:option [:ref :gmir.node/value]] (node/child value index) (node/nil-value) item item))
(defn- kw-value [value :keyword] [:ref :gmir.node/value] (node/keyword-literal value))
(defn- sym [value :string] [:ref :gmir.node/value]
  (node/symbol-parts (option-none-of [:option [:ref :gmir.node/text]]) (node/string-text value)))
(defn- reg [index :i64] [:ref :gmir.node/value]
  (result-value-of [:result [:ref :gmir.node/value] [:ref :gmir/refusal]] (gmir/vreg (node/i64-value index)) (node/nil-value)))
(defn- vector1 [a [:ref :gmir.node/value]] [:ref :gmir.node/value] (node/append (node/empty-vector) a))
(defn- vector2 [a [:ref :gmir.node/value] b [:ref :gmir.node/value]] [:ref :gmir.node/value] (node/append (vector1 a) b))
(defn- vector3 [a [:ref :gmir.node/value] b [:ref :gmir.node/value] c [:ref :gmir.node/value]] [:ref :gmir.node/value]
  (node/append (vector2 a b) c))
(defn- ins [op :keyword] [:ref :gmir.node/value] (node/put-key (node/empty-map) :gmir/op (kw-value op)))
(defn- return0 [] [:ref :gmir.node/value] (node/put-key (ins :gmir/return) :gmir/value (reg 0)))
(defn- constant0 [] [:ref :gmir.node/value]
  (-> (ins :gmir/constant) (node/put-key :gmir/dst (reg 0)) (node/put-key :gmir/value (node/i64-value 1))))
(defn- label [value :keyword] [:ref :gmir.node/value] (node/put-key (ins :gmir/label) :gmir/id (kw-value value)))
(defn- jump [value :keyword] [:ref :gmir.node/value] (node/put-key (ins :gmir/jump) :gmir/target (kw-value value)))
(defn- branch [value :keyword] [:ref :gmir.node/value]
  (-> (ins :gmir/branch-zero) (node/put-key :gmir/test (reg 0)) (node/put-key :gmir/target (kw-value value))))
(defn- incoming [value :keyword] [:ref :gmir.node/value]
  (-> (node/empty-map) (node/put-key :gmir/predecessor (kw-value value)) (node/put-key :gmir/value (reg 0))))
(defn- phi [values [:ref :gmir.node/value]] [:ref :gmir.node/value]
  (-> (ins :gmir/phi) (node/put-key :gmir/dst (reg 0)) (node/put-key :gmir/incomings values)))
(defn- good-phi [] [:ref :gmir.node/value] (phi (vector2 (incoming :case/a) (incoming :case/b))))
(defn- phi-code [value [:ref :gmir.node/value]] [:ref :gmir.node/value]
  (-> (node/empty-vector) (node/append (label :case/a)) (node/append (jump :case/join))
      (node/append (label :case/b)) (node/append (jump :case/join))
      (node/append (label :case/join)) (node/append value) (node/append (return0))))
(defn- flat [version :i64 code [:ref :gmir.node/value]] [:ref :gmir.node/value]
  (-> (node/empty-map) (node/put-key :gmir/version (node/i64-value version)) (node/put-key :gmir/instructions code)))
(defn- function [name [:ref :gmir.node/value] arity [:ref :gmir.node/value] code [:ref :gmir.node/value]] [:ref :gmir.node/value]
  (-> (node/empty-map) (node/put-key :gmir/name name) (node/put-key :gmir/arity arity) (node/put-key :gmir/instructions code)))
(defn- module [entry [:ref :gmir.node/value] functions [:ref :gmir.node/value]] [:ref :gmir.node/value]
  (-> (node/empty-map) (node/put-key :gmir/version (node/i64-value 3)) (node/put-key :gmir/entry entry)
      (node/put-key :gmir/functions functions)))
(defn- wrap [code [:ref :gmir.node/value]] [:ref :gmir.node/value]
  (module (sym "main") (vector1 (function (sym "main") (node/i64-value 1) code))))
(defn- args [count :i64] [:ref :gmir.node/value]
  (loop [index 0 out (node/empty-vector)]
    (if (>= index count) out (recur (+ index 1) (node/append out (reg 0))))))
(defn- call [op :keyword name [:ref :gmir.node/value] count :i64] [:ref :gmir.node/value]
  (let [base (-> (ins op) (node/put-key :gmir/callee name) (node/put-key :gmir/arguments (args count)))]
    (if (= op :gmir/tail-call) base (node/put-key base :gmir/dst (reg 0)))))
(defn- address [name [:ref :gmir.node/value]] [:ref :gmir.node/value]
  (-> (ins :gmir/function-address) (node/put-key :gmir/dst (reg 0)) (node/put-key :gmir/function name)))
(defn- argument [index [:ref :gmir.node/value]] [:ref :gmir.node/value]
  (-> (ins :gmir/argument) (node/put-key :gmir/dst (reg 0)) (node/put-key :gmir/index index)))
(defn- runtime [op :keyword field :keyword name :keyword count :i64] [:ref :gmir.node/value]
  (-> (ins op) (node/put-key :gmir/dst (reg 0)) (node/put-key field (kw-value name))
      (node/put-key :gmir/arguments (args count))))
(defn- fixture-case [name :keyword program [:ref :gmir.node/value] problem :keyword data [:ref :gmir.node/value]]
  [:ref :gmir.validation/case]
  (record-new [:ref :gmir.validation/case] name program problem data))
(defn- passes [name :keyword program [:ref :gmir.node/value]] [:ref :gmir.validation/case]
  (fixture-case name program :ok program))
(defn- without [value [:ref :gmir.node/value] field [:ref :gmir.node/value]] [:ref :gmir.node/value]
  (loop [index 0 out (node/empty-map)]
    (if (>= (+ index 1) (node/child-count value)) out
      (if (node/same-name? (at value index) field) (recur (+ index 2) out)
        (recur (+ index 2) (node/append (node/append out (at value index)) (at value (+ index 1))))))))

;; Full data comparison: every scalar, namespace/name byte and child. Maps
;; and sets compare without order; sequence kinds/ordering remain explicit.
(defn- same-data? [left [:ref :gmir.node/value] right [:ref :gmir.node/value]] :bool
  (and (= (node/kind left) (node/kind right)) (= (node/number left) (node/number right))
       (= (node/has-namespace? left) (node/has-namespace? right))
       (or (not (node/has-namespace? left))
           (node/text-equal? (option-value-of [:option [:ref :gmir.node/text]] (node/namespace-of left) (node/empty-text))
                            (option-value-of [:option [:ref :gmir.node/text]] (node/namespace-of right) (node/empty-text))))
       (node/text-equal? (node/name-of left) (node/name-of right))
       (= (node/child-count left) (node/child-count right))
       (case (node/kind left)
         :map (loop [index 0]
                (if (>= index (node/child-count left)) true
                  (if (loop [candidate 0]
                        (if (>= candidate (node/child-count right)) false
                          (if (and (same-data? (at left index) (at right candidate))
                                   (same-data? (at left (+ index 1)) (at right (+ candidate 1)))) true
                            (recur (+ candidate 2))))) (recur (+ index 2)) false)))
         :set (loop [index 0]
                (if (>= index (node/child-count left)) true
                  (if (loop [candidate 0]
                        (if (>= candidate (node/child-count right)) false
                          (if (same-data? (at left index) (at right candidate)) true (recur (+ candidate 1)))))
                    (recur (+ index 1)) false)))
         (loop [index 0]
           (if (>= index (node/child-count left)) true
             (if (same-data? (at left index) (at right index)) (recur (+ index 1)) false))))))
(defn- accepted? [program [:ref :gmir.node/value]] :bool
  (let [result (gmir/validate! program)]
    (and (result-ok?-of [:result [:ref :gmir.node/value] [:ref :gmir/refusal]] result)
         (same-data? program (result-value-of [:result [:ref :gmir.node/value] [:ref :gmir/refusal]] result (node/nil-value))))))
(defn- refused? [program [:ref :gmir.node/value] problem :keyword data [:ref :gmir.node/value]] :bool
  (let [result (gmir/validate! program)
        error (result-error-of [:result [:ref :gmir.node/value] [:ref :gmir/refusal]] result
                (outcome/refusal :unexpected-success (node/nil-value)))]
    (and (not (result-ok?-of [:result [:ref :gmir.node/value] [:ref :gmir/refusal]] result))
         (= (outcome/phase error) :gmir) (= (outcome/problem error) problem)
         (string=? (outcome/message error) (string-concat "GMIR rejected: " (keyword-name problem)))
         (same-data? data (outcome/instruction error)))))

(defn- operand [op :keyword field :keyword] [:ref :gmir.node/value]
  (case field
    :gmir/op (kw-value op)
    :gmir/dst (reg 0) :gmir/input (reg 0) :gmir/left (reg 0) :gmir/right (reg 0)
    :gmir/test (reg 0) :gmir/base (reg 0) :gmir/length (reg 0) :gmir/stored (reg 0)
    :gmir/expected (reg 0) :gmir/second-base (reg 0) :gmir/second-length (reg 0)
    :gmir/count (reg 0) :gmir/offset (reg 0) :gmir/size (reg 0)
    :gmir/value (if (= op :gmir/constant) (node/i64-value -9223372036854775808) (reg 0))
    :gmir/index (if (= op :gmir/argument) (node/i64-value 0) (reg 0))
    :gmir/content (node/string-value (node/string-text "00"))
    :gmir/rodata-encoding (kw-value :hex-bytes)
    :gmir/function (sym "main") :gmir/callee (sym "main")
    :gmir/runtime (kw-value :pair) :gmir/action (kw-value :uefi-call6)
    :gmir/capability (node/i64-value 255) :gmir/kind (kw-value :ui-event-v1)
    :gmir/arguments (args (case op :gmir/runtime-call 2 :gmir/x86-privileged 8 1))
    :gmir/id (kw-value :case/a) :gmir/target (kw-value :case/a)
    :gmir/incomings (vector2 (incoming :case/a) (incoming :case/b))
    :gmir/maximum (node/i64-value (cond
      (catalog/keyword-member? (gmir/slice-operations) op) (gmir/slice-item-limit)
      (or (catalog/keyword-member? (gmir/kernel-atomic-ops) op)
          (= op :gmir/kernel-try-lock-u32) (= op :gmir/kernel-unlock-u32)) 4096
      :else 65536))
    (kw-value :fixture/unhandled-field)))
(defn- template [shape [:ref :gmir.catalog/keyset]] [:ref :gmir.node/value]
  (let [op (catalog/keyset-operation shape) fields (catalog/keyset-keys shape)]
    (loop [index 0 out (node/empty-map)]
      (if (>= index (vector-count fields)) out
        (let [field (typed-list-nth [:list :keyword] fields index)]
          (recur (+ index 1) (node/put-key out field (operand op field))))))))
(defn- template-code [op :keyword instruction [:ref :gmir.node/value]] [:ref :gmir.node/value]
  (cond (= op :gmir/phi) (phi-code instruction)
        (or (= op :gmir/jump) (= op :gmir/branch-zero)) (vector3 instruction (label :case/a) (return0))
        :else (vector1 instruction)))
(defn- generic-register-field? [field :keyword] :bool
  (case field :gmir/dst true :gmir/input true :gmir/left true :gmir/right true :gmir/test true
    :gmir/base true :gmir/length true :gmir/stored true :gmir/expected true
    :gmir/second-base true :gmir/second-length true :gmir/count true :gmir/offset true :gmir/size true false))
(defn- nil-dst-problem [op :keyword] :keyword
  (case op :gmir/call :invalid-call :gmir/runtime-call :invalid-runtime-call
    :gmir/x86-privileged :invalid-x86-privileged :gmir/capability-call :invalid-capability-call
    :gmir/function-address :invalid-function-address :ok))
(defn- field-cases? [op :keyword instruction [:ref :gmir.node/value] field :keyword] :bool
  (let [register (or (generic-register-field? field)
                    (and (= field :gmir/index) (catalog/indexed-memory-operation? op))
                    (and (= field :gmir/value) (= op :gmir/return)))
        invalid (node/put-key instruction field (node/i64-value 0))
        nil-value (node/put-key instruction field (node/nil-value))
        nil-problem (if (= field :gmir/dst) (nil-dst-problem op) :ok)]
    (and (or (not register) (refused? (wrap (template-code op invalid)) :invalid-virtual-register invalid))
         (or (not (generic-register-field? field))
             (if (= nil-problem :ok) (accepted? (wrap (template-code op nil-value)))
               (refused? (wrap (template-code op nil-value)) nil-problem nil-value)))
         (or (not= field :gmir/maximum)
             (refused? (wrap (template-code op invalid)) :invalid-kernel-memory-maximum invalid)))))
(defn- window-tiers? [op :keyword instruction [:ref :gmir.node/value]] :bool
  (if (not (catalog/keyword-member? (gmir/kernel-window-operations) op)) true
    (let [all (gmir/kernel-window-maxima)]
      (loop [index 0]
        (if (>= index (vector-count all)) true
          (if (accepted? (wrap (template-code op (node/put-key instruction :gmir/maximum
                                (node/i64-value (typed-list-nth [:list :i64] all index))))))
            (recur (+ index 1)) false))))))
(defn- keyset-case [shape [:ref :gmir.catalog/keyset]] :bool
  (let [op (catalog/keyset-operation shape) instruction (template shape)
        extra (node/put-key instruction :fixture/extra (node/nil-value))
        fields (catalog/keyset-keys shape)]
    (and (accepted? (wrap (template-code op instruction)))
         (window-tiers? op instruction)
         (refused? (wrap (template-code op extra)) :non-canonical-instruction extra)
         (loop [index 0]
           (if (>= index (vector-count fields)) true
             (let [missing (without instruction (kw-value (typed-list-nth [:list :keyword] fields index)))]
               (if (and (refused? (wrap (template-code op missing)) :non-canonical-instruction missing)
                        (field-cases? op instruction (typed-list-nth [:list :keyword] fields index)))
                 (recur (+ index 1)) false)))))))
(defn- all-keysets? [] :bool
  (let [table (gmir/instruction-keysets)]
    (and (= (vector-count table) 92)
         (loop [index 0]
           (if (>= index (vector-count table)) true
             (if (arena-scope (keyset-case (typed-list-nth [:list [:ref :gmir.catalog/keyset]] table index)))
               (recur (+ index 1)) false))))))
(defn- arity-case [op :keyword field :keyword entry [:ref :gmir.catalog/arity] problem :keyword] :bool
  (let [count (catalog/arity-value entry) good (runtime op field (catalog/arity-name entry) count)
        bad (runtime op field (catalog/arity-name entry) (+ count 1))]
    (and (accepted? (flat 1 (vector1 good))) (refused? (flat 1 (vector1 bad)) problem bad)
         (or (= count 0)
             (let [short (runtime op field (catalog/arity-name entry) (- count 1))]
               (refused? (flat 1 (vector1 short)) problem short))))))
(defn- all-arities? [table [:list [:ref :gmir.catalog/arity]] op :keyword field :keyword problem :keyword] :bool
  (loop [index 0]
    (if (>= index (vector-count table)) true
      (if (arena-scope (arity-case op field (typed-list-nth [:list [:ref :gmir.catalog/arity]] table index) problem))
        (recur (+ index 1)) false))))

(defn- capability [kind :keyword wire :i64 count :i64] [:ref :gmir.node/value]
  (-> (ins :gmir/capability-call) (node/put-key :gmir/dst (reg 0))
      (node/put-key :gmir/capability (node/i64-value wire)) (node/put-key :gmir/kind (kw-value kind))
      (node/put-key :gmir/arguments (args count))))
(defn- capability-case [kind :keyword] :bool
  (let [low (capability kind 0 1) high (capability kind 255 1) bad-low (capability kind -1 1)
        bad-high (capability kind 256 1) empty (capability kind 0 0) two (capability kind 0 2)]
    (and (accepted? (flat 1 (vector1 low))) (accepted? (flat 1 (vector1 high)))
         (refused? (flat 1 (vector1 bad-low)) :invalid-capability-call bad-low)
         (refused? (flat 1 (vector1 bad-high)) :invalid-capability-call bad-high)
         (refused? (flat 1 (vector1 empty)) :invalid-capability-call empty)
         (refused? (flat 1 (vector1 two)) :invalid-capability-call two))))
(defn- all-capabilities? [] :bool
  (let [all (gmir/capability-kinds)]
    (and (= (vector-count all) 8)
      (loop [index 0]
        (if (>= index (vector-count all)) true
          (if (arena-scope (capability-case (catalog/arity-name
                            (typed-list-nth [:list [:ref :gmir.catalog/arity]] all index))))
            (recur (+ index 1)) false))))))

(defn fixture-count [] :i64 60)
(defn- fixture [index :i64] [:option [:ref :gmir.validation/case]]
  (let [test
    (case index
      0 (passes :empty-v1 (flat 1 (node/empty-vector)))
      1 (passes :empty-v2 (flat 2 (node/empty-vector)))
      2 (passes :module (wrap (vector1 (return0))))
      3 (let [value (node/nil-value)] (fixture-case :not-map value :non-canonical-program value))
      4 (let [p (flat 4 (node/empty-vector))] (fixture-case :bad-version p :non-canonical-program p))
      5 (let [p (node/put-key (flat 1 (node/empty-vector)) :extra (node/i64-value 0))]
          (fixture-case :extra-program p :non-canonical-program p))
      6 (fixture-case :not-vector (flat 1 (node/empty-list)) :non-canonical-instructions (node/empty-list))
      7 (let [i (ins :gmir/unknown)] (fixture-case :unknown (flat 1 (vector1 i)) :non-canonical-instruction i))
      8 (let [i (node/put-key (constant0) :gmir/dst (node/i64-value 0))]
          (fixture-case :bad-register (flat 1 (vector1 i)) :invalid-virtual-register i))
      9 (let [i (node/put-key (constant0) :gmir/value (node/string-value (node/string-text "1")))]
          (fixture-case :bad-constant (flat 1 (vector1 i)) :constant-not-i64 i))
      10 (let [i (node/put-key (node/put-key (constant0) :gmir/value (node/nil-value)) :gmir/dst (node/i64-value 1))]
           (fixture-case :register-before-constant (flat 1 (vector1 i)) :invalid-virtual-register i))
      11 (let [i (node/put-key (constant0) :gmir/dst (node/nil-value))]
           (passes :reference-nil-keep (flat 1 (vector1 i))))
      12 (let [i (argument (node/i64-value -1))] (fixture-case :negative-index (flat 1 (vector1 i)) :argument-index-invalid i))
      13 (passes :wide-flat-index (flat 1 (vector1 (argument (node/integer-value (node/string-text "18446744073709551616"))))))
      14 (let [i (address (sym "main"))] (fixture-case :address-needs-module (flat 1 (vector1 i)) :function-address-needs-a-module i))
      15 (let [i (call :gmir/call (sym "main") 1)] (fixture-case :v2-no-call (flat 2 (vector1 i)) :non-canonical-instruction i))
      16 (let [i (call :gmir/tail-call (sym "main") 1)] (fixture-case :v1-no-tail (flat 1 (vector1 i)) :non-canonical-instruction i))
      17 (let [i (call :gmir/call (sym "main") 65)] (fixture-case :call-bound (wrap (vector1 i)) :invalid-call i))
      18 (let [i (runtime :gmir/runtime-call :gmir/runtime :unknown 0)]
           (fixture-case :unknown-runtime (flat 1 (vector1 i)) :invalid-runtime-call i))
      19 (let [i (runtime :gmir/x86-privileged :gmir/action :unknown 0)]
           (fixture-case :unknown-action (flat 1 (vector1 i)) :invalid-x86-privileged i))
      20 (let [i (-> (ins :gmir/capability-call) (node/put-key :gmir/dst (reg 0))
                    (node/put-key :gmir/capability (node/i64-value 256)) (node/put-key :gmir/kind (kw-value :i64))
                    (node/put-key :gmir/arguments (args 1)))]
           (fixture-case :capability-wire (flat 1 (vector1 i)) :invalid-capability-call i))
      21 (let [i (-> (ins :gmir/capability-call) (node/put-key :gmir/dst (reg 0))
                    (node/put-key :gmir/capability (node/i64-value 0)) (node/put-key :gmir/kind (kw-value :bytes-v1))
                    (node/put-key :gmir/arguments (args 1)))]
           (fixture-case :unadmitted-kind (flat 1 (vector1 i)) :invalid-capability-call i))
      22 (let [i (-> (ins :gmir/data-address) (node/put-key :gmir/dst (reg 0)) (node/put-key :gmir/content (node/i64-value 0)))]
           (fixture-case :data-type (flat 1 (vector1 i)) :invalid-data-content i))
      23 (let [i (-> (ins :gmir/rodata-address) (node/put-key :gmir/dst (reg 0)) (node/put-key :gmir/rodata-encoding (kw-value :hex-bytes))
                    (node/put-key :gmir/content (node/string-value (node/string-text "0z"))))]
           (fixture-case :bad-rodata (flat 1 (vector1 i)) :invalid-rodata-content i))
      24 (let [i (node/put-key (ins :gmir/label) :gmir/id (kw-value :unqualified))]
           (fixture-case :label-namespace (flat 1 (vector1 i)) :invalid-label i))
      25 (let [code (vector2 (label :case/a) (label :case/a))
               labels (node/append (node/append (node/empty-list) (kw-value :case/a)) (kw-value :case/a))]
           (fixture-case :duplicate-label (flat 1 code) :duplicate-label (node/put-key (node/empty-map) :labels labels)))
      26 (fixture-case :unresolved-target (flat 1 (vector1 (jump :case/missing))) :unresolved-target
            (node/put-key (node/empty-map) :target (kw-value :case/missing)))
      27 (passes :phi (flat 2 (phi-code (good-phi))))
      28 (let [i (good-phi)] (fixture-case :phi-entry (flat 2 (vector1 i)) :phi-not-at-block-entry i))
      29 (let [i (phi (vector2 (incoming :case/a) (incoming :case/a)))]
           (fixture-case :phi-duplicate (flat 2 (phi-code i)) :invalid-phi-incomings i))
      30 (let [i (good-phi) code (-> (node/empty-vector) (node/append (label :case/a)) (node/append (jump :case/join))
                                   (node/append (label :case/b)) (node/append (jump :case/other))
                                   (node/append (label :case/join)) (node/append i) (node/append (label :case/other)))
               incoming (node/append (node/append (node/empty-set) (kw-value :case/a)) (kw-value :case/b))
               jumps (node/append (node/empty-set) (kw-value :case/a))]
           (fixture-case :phi-predecessors (flat 2 code) :phi-predecessor-mismatch
             (-> (node/empty-map) (node/put-key :join (kw-value :case/join)) (node/put-key :incoming incoming) (node/put-key :jumps jumps))))
      31 (let [i (good-phi) code (node/append (phi-code i) (branch :case/join))]
           (fixture-case :phi-critical (flat 2 code) :phi-critical-edge i))
      32 (let [i (good-phi) code (-> (node/empty-vector) (node/append (label :case/join)) (node/append i)
                   (node/append (label :case/a)) (node/append (jump :case/join))
                   (node/append (label :case/b)) (node/append (jump :case/join)))]
           (fixture-case :phi-fallthrough (flat 2 code) :phi-fallthrough-predecessor i))
      33 (let [p (module (sym "main") (node/empty-vector))] (fixture-case :empty-module p :non-canonical-module p))
      34 (let [f (function (sym "main") (node/i64-value 0) (node/empty-vector))
               names (vector2 (sym "main") (sym "main"))]
