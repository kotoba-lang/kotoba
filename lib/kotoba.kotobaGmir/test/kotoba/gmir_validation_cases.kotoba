                 (node/put-key :indices (vector2 (node/i64-value 0) (node/i64-value 0))))))
      38 (let [value (node/integer-value (node/string-text "18446744073709551616"))]
           (fixture-case :wide-module-index (wrap (vector1 (argument value))) :invalid-function-arguments
             (-> (node/empty-map) (node/put-key :function (sym "main")) (node/put-key :arity (node/i64-value 1))
                 (node/put-key :indices (vector1 value)))))
      39 (let [i (call :gmir/call (sym "missing") 1)] (fixture-case :callee-link (wrap (vector1 i)) :unresolved-callee i))
      40 (let [i (call :gmir/call (sym "main") 0)]
           (fixture-case :callee-arity (wrap (vector1 i)) :call-arity-mismatch
             (-> (node/empty-map) (node/put-key :function (sym "main")) (node/put-key :call i)
                 (node/put-key :expected (node/i64-value 1)))))
      41 (let [i (address (sym "missing"))]
           (fixture-case :address-link (wrap (vector1 i)) :unresolved-function-address
             (-> (node/empty-map) (node/put-key :function (sym "main")) (node/put-key :instruction i)
                 (node/put-key :declared (vector1 (sym "main"))))))
      42 (passes :tail-call (wrap (vector1 (call :gmir/tail-call (sym "main") 1))))
      43 (passes :long-code (flat 1 (loop [i 0 code (node/empty-vector)]
                  (if (= i 33) code (recur (+ i 1) (node/append code (return0)))))))
      44 (let [code (loop [i 0 out (node/empty-vector)]
                     (if (= i 64) out (recur (+ i 1) (node/append out (argument (node/i64-value i))))))]
           (passes :full-arity (module (sym "main") (vector1 (function (sym "main") (node/i64-value 64) code)))))
      45 (let [invalid (node/node :i64 1 (option-some-of [:option [:ref :gmir.node/text]] (node/empty-text))
                        (node/empty-text) (node/empty-children))
               i (node/put-key (constant0) :gmir/value invalid)]
           (fixture-case :extra-atom-payload (flat 1 (vector1 i)) :non-canonical-value invalid))
      46 (let [invalid (node/string-value (node/text (typed-list-conj [:list :bytes] (typed-list-new [:list :bytes])
                            (bytes-from-vector-i64 [227 129]))))
               i (-> (ins :gmir/data-address) (node/put-key :gmir/dst (reg 0)) (node/put-key :gmir/content invalid))]
           (fixture-case :invalid-text-representation (flat 1 (vector1 i)) :non-canonical-value invalid))
      47 (let [i (call :gmir/call (sym "later") 0)
               f (function (sym "main") (node/i64-value 0) (vector1 i))
               later (function (sym "later") (node/nil-value) (node/empty-vector))]
           (fixture-case :forward-signature-order (module (sym "main") (vector2 f later)) :call-arity-mismatch
             (-> (node/empty-map) (node/put-key :function (sym "main")) (node/put-key :call i) (node/put-key :expected (node/nil-value)))))
      48 (let [i (phi (node/append (node/append (node/empty-list) (incoming :case/a)) (incoming :case/b)))]
           (fixture-case :phi-container (flat 2 (phi-code i)) :invalid-phi-incomings i))
      49 (let [i (phi (node/empty-vector)) code (vector3 (label :case/a) (label :case/a) i)
               labels (node/append (node/append (node/empty-list) (kw-value :case/a)) (kw-value :case/a))]
           (fixture-case :labels-before-phi (flat 2 code) :duplicate-label (node/put-key (node/empty-map) :labels labels)))
      50 (let [i (phi (vector1 (node/empty-map))) code (vector3 (label :case/a) (label :case/a) i)]
           (fixture-case :incoming-before-labels (flat 2 code) :invalid-phi-incomings i))
      51 (passes :unlabeled-jump-is-dropped (flat 2 (-> (vector1 (jump :case/join))
                   (node/append (label :case/a)) (node/append (jump :case/join))
                   (node/append (label :case/b)) (node/append (jump :case/join))
                   (node/append (label :case/join)) (node/append (good-phi)))))
      52 (let [f (without (function (sym "main") (node/i64-value 0) (node/empty-vector)) (kw-value :gmir/name))]
           (fixture-case :names-before-function-shape (module (sym "main") (vector1 f)) :invalid-function-names (vector1 (node/nil-value))))
      53 (let [i (call :gmir/call (sym "main") 64)]
           (passes :full-call-arity (module (sym "main") (vector1 (function (sym "main") (node/i64-value 64) (vector1 i))))))
      54 (let [a (sym "x/y") b (node/symbol-parts
                  (option-some-of [:option [:ref :gmir.node/text]] (node/string-text "x")) (node/string-text "y"))
               f (function a (node/i64-value 0) (vector1 (call :gmir/call b 0)))
               g (function b (node/i64-value 0) (node/empty-vector))]
           (passes :namespace-parts-link (module a (vector2 f g))))
      55 (let [empty-ns (node/symbol-parts (option-some-of [:option [:ref :gmir.node/text]] (node/empty-text)) (node/string-text "a"))
               qualified (node/symbol-parts (option-some-of [:option [:ref :gmir.node/text]] (node/string-text "ns")) (node/string-text "z"))
               main (sym "m") astral (sym "😀") bmp (sym "") i (address (sym "missing"))
               functions (-> (node/empty-vector)
                 (node/append (function qualified (node/i64-value 0) (node/empty-vector)))
                 (node/append (function bmp (node/i64-value 0) (node/empty-vector)))
                 (node/append (function empty-ns (node/i64-value 0) (node/empty-vector)))
                 (node/append (function astral (node/i64-value 0) (node/empty-vector)))
                 (node/append (function main (node/i64-value 0) (vector1 i))))
               declared (-> (vector3 main astral bmp) (node/append empty-ns) (node/append qualified))]
           (fixture-case :sorted-declared-parts (module main functions) :unresolved-function-address
