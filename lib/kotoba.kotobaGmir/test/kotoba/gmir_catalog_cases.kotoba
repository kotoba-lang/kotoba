;; Canonical catalog self-check source; never substitutes for the root suites.
(ns kotoba.gmir-catalog-cases
  {:kotoba/export [main]}
  (:require [kotoba.gmir.catalog :as catalog]))

(defn- same-keywords? [left [:list :keyword] right [:list :keyword]] :bool
  (if (not= (vector-count left) (vector-count right)) false
    (loop [index 0]
      (if (>= index (vector-count left)) true
        (if (= (typed-list-nth [:list :keyword] left index) (typed-list-nth [:list :keyword] right index))
          (recur (+ index 1)) false)))))
(defn- unique-keywords? [values [:list :keyword]] :bool
  (loop [i 0 j 0]
    (cond
      (>= i (vector-count values)) true
      (>= j i) (recur (+ i 1) 0)
      (= (typed-list-nth [:list :keyword] values i) (typed-list-nth [:list :keyword] values j)) false
      :else (recur i (+ j 1)))))
(defn- expect-arity? [all [:list [:ref :gmir.catalog/arity]] name :keyword expected :i64] :bool
  (let [actual (catalog/arity-of all name)]
    (and (option-some?-of [:option :i64] actual)
         (= (option-value-of [:option :i64] actual -1) expected))))
(defn- arities? [all [:list [:ref :gmir.catalog/arity]] count :i64 maximum :i64] :bool
  (if (or (not= (vector-count all) count)
          (option-some?-of [:option :i64] (catalog/arity-of all :not-an-operation))) false
    (loop [index 0 names (typed-list-new [:list :keyword])]
      (if (>= index (vector-count all)) true
        (let [entry (typed-list-nth [:list [:ref :gmir.catalog/arity]] all index)
              name (catalog/arity-name entry) value (catalog/arity-value entry)]
          (if (or (catalog/keyword-member? names name) (< value 0) (> value maximum)
                  (not (expect-arity? all name value))) false
            (recur (+ index 1) (typed-list-conj [:list :keyword] names name))))))))
(defn- version-rule? [all [:list [:ref :gmir.catalog/keyset]] operation :keyword] :bool
  (and (not (catalog/operation-allowed-in? all 0 operation))
       (= (catalog/operation-allowed-in? all 1 operation)
          (and (not= operation :gmir/phi) (not= operation :gmir/tail-call)))
       (= (catalog/operation-allowed-in? all 2 operation)
          (and (not= operation :gmir/call) (not= operation :gmir/tail-call)))
       (catalog/operation-allowed-in? all 3 operation)
       (not (catalog/operation-allowed-in? all 4 operation))))
(defn- keysets? [all [:list [:ref :gmir.catalog/keyset]]] :bool
  (if (or (not= (vector-count all) 92)
          (option-some?-of [:option [:list :keyword]] (catalog/instruction-keys-in all :gmir/unknown))) false
    (loop [index 0 names (typed-list-new [:list :keyword])]
      (if (>= index (vector-count all)) true
        (let [entry (typed-list-nth [:list [:ref :gmir.catalog/keyset]] all index)
              name (catalog/keyset-operation entry) keys (catalog/keyset-keys entry)
              found (catalog/instruction-keys-in all name)]
          (if (and (not (catalog/keyword-member? names name))
                   (>= (vector-count keys) 2) (unique-keywords? keys)
                   (catalog/keyword-member? keys :gmir/op)
                   (option-some?-of [:option [:list :keyword]] found)
                   (same-keywords? keys (option-value-of [:option [:list :keyword]] found (typed-list-new [:list :keyword])))
                   (version-rule? all name))
            (recur (+ index 1) (typed-list-conj [:list :keyword] names name)) false))))))
(defn- family? [values [:list :keyword] count :i64] :bool
  (and (= (vector-count values) count) (unique-keywords? values)
       (loop [index 0]
         (if (>= index (vector-count values)) true
           (if (catalog/indexed-memory-operation? (typed-list-nth [:list :keyword] values index))
             (recur (+ index 1)) false)))))
(defn- expected-block-limit [operation :keyword] :i64
  (case operation
    :gmir/kernel-dequant-dot-q8-0 512
    :gmir/kernel-dequant-dot-q4-k 64
    :gmir/kernel-dequant-dot-q6-k 64
    :gmir/kernel-dequant-dot-iq4-xs 64
    :gmir/kernel-dequant-dot-iq2-s 64
    :gmir/kernel-dequant-dot-iq3-xxs 64
    :gmir/kernel-dequant-dot-iq3-s 64
    :gmir/kernel-dequant-dot-ptq1-0 128
    -1))
(defn- formats? [] :bool
  (let [all (catalog/kernel-dequant-dot-formats) operations (catalog/kernel-dequant-dot-operations)]
    (if (or (not= (vector-count all) 8) (not= (vector-count operations) 8)
            (not (unique-keywords? operations))
            (option-some?-of [:option :i64] (catalog/kernel-dequant-dot-block-limit :gmir/unknown))
            (option-some?-of [:option [:ref :gmir.catalog/format]] (catalog/format-of :gmir/unknown))) false
      (loop [index 0 names (typed-list-new [:list :keyword])]
        (if (>= index (vector-count all)) true
          (let [entry (typed-list-nth [:list [:ref :gmir.catalog/format]] all index)
                op (catalog/format-operation entry)
                packed (catalog/format-block-bytes entry)
                expanded (* 4 (catalog/format-block-elements entry))
                actual (catalog/kernel-dequant-dot-block-limit op)
                limit (option-value-of [:option :i64] actual -1)
                ceiling (catalog/kernel-dequant-dot-maximum)]
            (if (and (not (catalog/keyword-member? names op)) (catalog/keyword-member? operations op)
                     (option-some?-of [:option :i64] actual) (= limit (expected-block-limit op))
                     (> packed 0) (> expanded 0)
                     (<= (* limit packed) ceiling) (<= (* limit expanded) ceiling)
                     (or (> (* (+ limit 1) packed) ceiling) (> (* (+ limit 1) expanded) ceiling)))
              (recur (+ index 1) (typed-list-conj [:list :keyword] names op)) false)))))))

(defn main [] :i64
  (let [instructions (catalog/instruction-keysets) runtimes (catalog/runtime-operation-arities)
        actions (catalog/x86-privileged-action-arities) kinds (catalog/capability-kinds)
        versions (catalog/supported-versions) windows (catalog/kernel-window-maxima)]
    (cond
      (not (and (= (catalog/version) 3) (= (catalog/max-arity) 64)
                (= (catalog/slice-item-limit) 1099511627776)
                (= (catalog/kernel-dot-f32-maximum) 65536)
                (= (catalog/kernel-dot-f32-element-limit) 16384)
                (= (catalog/kernel-dequant-dot-maximum) 65536))) 1
      (not (and (= (vector-count versions) 3) (catalog/i64-member? versions 1)
                (catalog/i64-member? versions 2) (catalog/i64-member? versions 3)
                (not (catalog/i64-member? versions 0)) (not (catalog/i64-member? versions 4)))) 2
      (not (and (= (vector-count windows) 4) (catalog/i64-member? windows 512)
                (catalog/i64-member? windows 4096) (catalog/i64-member? windows 16384)
                (catalog/i64-member? windows 65536) (not (catalog/i64-member? windows 1024)))) 3
      (not (keysets? instructions)) 4
      (not (and (arities? runtimes 37 4) (arities? actions 55 8) (arities? kinds 8 7))) 5
      (not (and (expect-arity? kinds :i64 0) (expect-arity? kinds :string 1)
                (expect-arity? kinds :option-i64 2) (expect-arity? kinds :result-i64 3)
                (expect-arity? kinds :clock-v1 4) (expect-arity? kinds :dataspace-v1 5)
                (expect-arity? kinds :ui-commit-v1 6) (expect-arity? kinds :ui-event-v1 7))) 6
      (not (and (expect-arity? runtimes :pair 2) (expect-arity? runtimes :kgraph-assert! 3)
                (expect-arity? runtimes :vector-alloc 1) (expect-arity? runtimes :vector-assoc-in-place 3)
                (expect-arity? runtimes :string-from-utf8 1) (expect-arity? runtimes :bytes-from-vector 1)
                (expect-arity? runtimes :gas-charge 1) (expect-arity? runtimes :fuel-charge 0))) 7
      (not (and (expect-arity? actions :uefi-call2 4) (expect-arity? actions :uefi-call4 6)
                (expect-arity? actions :uefi-call6 8) (expect-arity? actions :uefi-alloc-region 6)
                (expect-arity? actions :scratch-region 0) (expect-arity? actions :isr-entry-address 1))) 8
      (not (and (family? (catalog/kernel-window-operations) 8) (family? (catalog/slice-operations) 8)
                (family? (catalog/kernel-atomic-ops) 6)
                (catalog/indexed-memory-operation? :gmir/kernel-try-lock-u32)
                (catalog/indexed-memory-operation? :gmir/kernel-unlock-u32)
                (not (catalog/indexed-memory-operation? :gmir/kernel-dot-f32)))) 9
      (not (formats?)) 10
      (or (catalog/operation-allowed-in? instructions 1 :gmir/unknown)
          (catalog/operation-allowed-in? instructions 2 :gmir/unknown)
          (catalog/operation-allowed-in? instructions 3 :gmir/unknown)) 11
      :else 0)))
