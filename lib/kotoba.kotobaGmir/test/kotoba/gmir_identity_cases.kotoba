;; Canonical boundary native self-checks; public target qualification remains open.
(ns kotoba.gmir-identity-cases
  {:kotoba/export [main large-collection-case]}
  (:require [kotoba.gmir.node :as node] [kotoba.gmir.identity :as identity]
            [kotoba.gmir.outcome :as outcome])
  (:schemas
   {:gmir.identity/integer-case [:record :gmir.identity/integer-case
      [[:input [:ref :gmir.node/value]] [:accepted :bool] [:expected :i64]]]}))

(defn- integer-text [value :string] [:ref :gmir.node/value]
  (node/integer-value (node/string-text value)))
(defn- check-integer? [value [:ref :gmir.node/value] accepted :bool expected :i64] :bool
  (let [actual (identity/integer-i64 value)]
    (and (= (identity/i64-value? value) accepted)
         (= (option-some?-of [:option :i64] actual) accepted)
         (or (not accepted) (= (option-value-of [:option :i64] actual 0) expected)))))
(defn- case-add [out [:list [:ref :gmir.identity/integer-case]] input [:ref :gmir.node/value]
                 accepted :bool expected :i64] [:list [:ref :gmir.identity/integer-case]]
  (typed-list-conj [:list [:ref :gmir.identity/integer-case]] out
    (record-new [:ref :gmir.identity/integer-case] input accepted expected)))
(defn- integers? [] :bool
  (let [all (-> (typed-list-new [:list [:ref :gmir.identity/integer-case]])
      (case-add (node/i64-value -9223372036854775808) true -9223372036854775808)
      (case-add (node/i64-value 9223372036854775807) true 9223372036854775807)
      (case-add (integer-text "-9223372036854775808") true -9223372036854775808)
      (case-add (integer-text "9223372036854775807") true 9223372036854775807)
      (case-add (integer-text "-9223372036854775809") false 0)
      (case-add (integer-text "9223372036854775808") false 0)
      (case-add (integer-text "18446744073709551616") false 0)
      (case-add (integer-text "0009223372036854775807") true 9223372036854775807)
      (case-add (integer-text "-0009223372036854775808") true -9223372036854775808)
      (case-add (integer-text "+00042") true 42)
      (case-add (integer-text "-00042") true -42)
      (case-add (integer-text "-0000") true 0)
      (case-add (integer-text "0") true 0)
      (case-add (integer-text "-1") true -1)
      (case-add (integer-text "") false 0)
      (case-add (integer-text "+") false 0)
      (case-add (integer-text "-") false 0)
      (case-add (integer-text "1.0") false 0)
      (case-add (integer-text "1e2") false 0)
      (case-add (integer-text "1z") false 0)
      (case-add (integer-text "１２") false 0)
      (case-add (node/f64-bits-value 0) false 0)
      (case-add (node/bool-value false) false 0)
      (case-add (node/nil-value) false 0)
      (case-add (node/string-value (node/string-text "1")) false 0))]
    (and (= (vector-count all) 25)
      (loop [index 0]
        (if (>= index (vector-count all)) true
          (let [test (typed-list-nth [:list [:ref :gmir.identity/integer-case]] all index)]
            (if (check-integer? (record-get [:ref :gmir.identity/integer-case] test :input)
                               (record-get [:ref :gmir.identity/integer-case] test :accepted)
                               (record-get [:ref :gmir.identity/integer-case] test :expected))
              (recur (+ index 1)) false)))))))
(defn- with-ns [ns :string name :string] [:ref :gmir.node/value]
  (node/keyword-parts (option-some-of [:option [:ref :gmir.node/text]] (node/string-text ns))
    (node/string-text name)))
(defn- bare [name :string] [:ref :gmir.node/value]
  (node/keyword-parts (option-none-of [:option [:ref :gmir.node/text]]) (node/string-text name)))
(defn- register-name [name :string] [:ref :gmir.node/value] (with-ns "kotoba.gmir.vreg" name))
(defn- constructed? [input [:ref :gmir.node/value] expected :string] :bool
  (let [result (identity/vreg input)]
    (and (result-ok?-of [:result [:ref :gmir.node/value] [:ref :gmir/refusal]] result)
         (let [actual (result-value-of [:result [:ref :gmir.node/value] [:ref :gmir/refusal]] result (node/nil-value))]
           (and (identity/vreg? actual) (identity/nonnegative-integer? input)
                (node/same-name? actual (register-name expected)))))))
(defn- rejected? [input [:ref :gmir.node/value]] :bool
  (let [result (identity/vreg input)
        error (result-error-of [:result [:ref :gmir.node/value] [:ref :gmir/refusal]] result
                (outcome/refusal :unexpected-success (node/nil-value)))]
    (and (not (result-ok?-of [:result [:ref :gmir.node/value] [:ref :gmir/refusal]] result))
         (not (identity/nonnegative-integer? input))
         (= (outcome/phase error) :gmir) (= (outcome/problem error) :invalid-virtual-register-index)
         (string=? (outcome/message error) "GMIR rejected: invalid-virtual-register-index")
         (node/has-key? (outcome/instruction error) :index)
         (= (node/kind (node/key (outcome/instruction error) :index)) (node/kind input))
         (= (node/number (node/key (outcome/instruction error) :index)) (node/number input))
         (node/text-equal? (node/name-of (node/key (outcome/instruction error) :index)) (node/name-of input)))))
(defn- registers? [] :bool
  (and (constructed? (node/i64-value 0) "0") (constructed? (node/i64-value 1) "1")
       (constructed? (node/i64-value 9223372036854775807) "9223372036854775807")
       (constructed? (integer-text "9223372036854775808") "9223372036854775808")
       (constructed? (integer-text "+000001") "1") (constructed? (integer-text "-0000") "0")
       (rejected? (node/i64-value -1)) (rejected? (integer-text "-9223372036854775809"))
       (rejected? (integer-text "-1")) (rejected? (integer-text "1z"))
       (rejected? (node/string-value (node/string-text "0"))) (rejected? (node/f64-bits-value 0))
       (rejected? (node/nil-value))
       (identity/vreg? (register-name "0")) (identity/vreg? (register-name "123"))
       (not (identity/vreg? (register-name ""))) (not (identity/vreg? (register-name "00")))
       (not (identity/vreg? (register-name "01"))) (not (identity/vreg? (register-name "+1")))
       (not (identity/vreg? (register-name "-1"))) (not (identity/vreg? (register-name "1z")))
       (not (identity/vreg? (register-name "１２"))) (not (identity/vreg? (with-ns "wrong" "1")))
       (not (identity/vreg? (bare "kotoba.gmir.vreg/1")))))
(defn- identities? [] :bool
  (let [none (option-none-of [:option [:ref :gmir.node/text]])
        some-empty (option-some-of [:option [:ref :gmir.node/text]] (node/empty-text))
        a (node/symbol-parts (option-some-of [:option [:ref :gmir.node/text]] (node/string-text "x")) (node/string-text "y"))
        b (node/symbol-parts none (node/string-text "x/y"))]
    (and (identity/label? (with-ns "test.label" "zero")) (identity/label? (with-ns "" ""))
         (not (identity/label? (bare "test.label/zero"))) (not (identity/label? (bare "/")))
         (not (identity/label? a)) (not (identity/label? (node/i64-value 0)))
         (identity/function-id? a) (identity/function-id? b)
         (identity/function-id? (node/symbol-parts none (node/string-text "/")))
         (identity/function-id? (node/symbol-parts some-empty (node/string-text "main")))
         (not (identity/function-id? (node/symbol-parts none (node/empty-text))))
         (not (identity/function-id? (node/symbol-parts some-empty (node/empty-text))))
         (not (identity/function-id? (bare "main")))
         (not (node/same-name? a b))
         (not (node/same-name? (node/symbol-parts none (node/string-text "main"))
                               (node/symbol-parts some-empty (node/string-text "main"))))
         (node/same-name? (node/keyword-literal :test.label/zero) (with-ns "test.label" "zero")))))
(defn- children? [] :bool
  (let [value (loop [index 0 out (node/empty-vector)]
                (if (= index 33) out (recur (+ index 1) (node/append out (node/i64-value index)))))]
    (and (= (node/child-count value) 33)
         (not (option-some?-of [:option [:ref :gmir.node/value]] (node/child value -1)))
         (not (option-some?-of [:option [:ref :gmir.node/value]] (node/child value 33)))
         (loop [index 0]
           (if (= index 33) true
             (let [item (node/child value index)]
               (if (and (option-some?-of [:option [:ref :gmir.node/value]] item)
                        (= (node/number (option-value-of [:option [:ref :gmir.node/value]] item (node/nil-value))) index))
                 (recur (+ index 1)) false)))))))

(defn- byte-chunk [out [:list :bytes] value :bytes] [:list :bytes]
  (typed-list-conj [:list :bytes] out value))
(defn- raw-valid? [bytes :vector-i64 expected :bool] :bool
  (= (node/text-valid? (node/text (byte-chunk (typed-list-new [:list :bytes]) (bytes-from-vector-i64 bytes)))) expected))
(defn- ordered? [left :string right :string expected :i64] :bool
  (let [value (node/text-compare-utf16 (node/string-text left) (node/string-text right))]
    (and (option-some?-of [:option :i64] value) (= (option-value-of [:option :i64] value 2) expected))))
(defn- unicode? [] :bool
  (and (raw-valid? (vector-new) true) (raw-valid? [0 65 127] true)
       (raw-valid? [194 128] true) (raw-valid? [223 191] true)
       (raw-valid? [224 160 128] true) (raw-valid? [239 191 191] true)
       (raw-valid? [240 144 128 128] true) (raw-valid? [244 143 191 191] true)
       (raw-valid? [192 175] false) (raw-valid? [224 128 175] false)
       (raw-valid? [240 128 128 175] false) (raw-valid? [237 160 128] false)
       (raw-valid? [244 144 128 128] false) (raw-valid? [128] false)
       (raw-valid? [240 159 152] false) (raw-valid? [255] false)
       (ordered? "" "" 0) (ordered? "a" "aa" -1) (ordered? "aa" "a" 1)
       (ordered? "😀" "" -1) (ordered? "😀" "😁" -1) (ordered? "😀" "𠀀" -1)
       (ordered? "􏿿" "￿" -1)))
(defn- text-and-map? [] :bool
  (let [split (node/text (-> (typed-list-new [:list :bytes])
                (byte-chunk (string-to-utf8 "A"))
                (byte-chunk (bytes-empty))
                (byte-chunk (bytes-from-vector-i64 [227]))
                (byte-chunk (bytes-from-vector-i64 [129 130]))
                (byte-chunk (string-to-utf8 "B"))))
        part (node/text-slice split 1 4)
        map (-> (node/empty-map) (node/put-key :gmir/version (node/i64-value 1))
                               (node/put-key :present (node/nil-value)))
        updated (node/put-key map :gmir/version (node/i64-value 3))
        malformed (node/text (typed-list-conj [:list :bytes] (typed-list-new [:list :bytes])
                              (bytes-from-vector-i64 [237 160 128])))
        order (node/text-compare-utf16 (node/string-text "😀") (node/string-text ""))
        decimal (node/integer-value (node/text (-> (typed-list-new [:list :bytes])
                    (byte-chunk (string-to-utf8 "-922337203"))
                    (byte-chunk (bytes-empty))
                    (byte-chunk (string-to-utf8 "6854775808")))))]
    (and (= (node/text-count split) 5) (= (node/text-at split -1) -1) (= (node/text-at split 5) -1)
         (node/text-valid? split) (not (node/text-valid? malformed))
         (not (option-some?-of [:option :i64] (node/text-compare-utf16 malformed split)))
         (option-some?-of [:option :i64] order) (= (option-value-of [:option :i64] order 0) -1)
         (node/text-equal? split (node/string-text "AあB"))
         (not (node/text-equal? split (node/string-text "AあC")))
         (option-some?-of [:option [:ref :gmir.node/text]] part)
         (node/text-equal? (option-value-of [:option [:ref :gmir.node/text]] part (node/empty-text)) (node/string-text "あ"))
         (not (option-some?-of [:option [:ref :gmir.node/text]] (node/text-slice split -1 0)))
         (not (option-some?-of [:option [:ref :gmir.node/text]] (node/text-slice split 2 1)))
         (not (option-some?-of [:option [:ref :gmir.node/text]] (node/text-slice split 0 6)))
         (= (node/child-count map) 4) (= (node/child-count updated) 4)
         (node/has-key? updated :present) (not (node/has-key? updated :missing))
         (= (node/number (node/key map :gmir/version)) 1)
         (= (node/number (node/key updated :gmir/version)) 3)
         (= (node/kind (node/key updated :present)) :nil)
         (check-integer? decimal true -9223372036854775808))))

;; A separate resource-sensitive source case: exercise a real full-page
;; rollover without serializing a huge vector through a generic document.
(defn large-collection-case [] :i64
  (let [items (loop [index 0 out (typed-list-new [:list [:ref :gmir.node/value]])]
                (if (= index 16384) out
                  (recur (+ index 1) (typed-list-conj [:list [:ref :gmir.node/value]] out (node/i64-value index)))))
        raw (node/node :vector 0 (option-none-of [:option [:ref :gmir.node/text]]) (node/empty-text)
              (typed-list-conj [:list [:ref :gmir.node/chunk]] (node/empty-children) (node/chunk items)))
        value (node/append raw (node/i64-value 16384))]
    (if (or (not= (node/child-count value) 16385) (not= (vector-count (node/pages value)) 2)) 1
      (loop [index 0]
        (if (= index 16385) 0
          (let [item (node/child value index)]
            (if (and (option-some?-of [:option [:ref :gmir.node/value]] item)
                     (= (node/number (option-value-of [:option [:ref :gmir.node/value]] item (node/nil-value))) index))
              (recur (+ index 1)) 2)))))))
(defn main [] :i64
  (cond (not (integers?)) 1 (not (registers?)) 2 (not (identities?)) 3
        (not (children?)) 4 (not (text-and-map?)) 5 (not (unicode?)) 6 :else 0))
