;; Typed analogue of the complete GMIR refusal facts, without host exceptions.
(ns kotoba.gmir.outcome
  {:kotoba/export [refusal problem instruction phase message]}
  (:require [kotoba.gmir.node :as node])
  (:schemas
   {:gmir/refusal [:record :gmir/refusal
      [[:phase :keyword] [:problem :keyword] [:message :string]
       [:instruction [:ref :gmir.node/value]]]]}))

(defn refusal [problem :keyword data [:ref :gmir.node/value]] [:ref :gmir/refusal]
  (record-new [:ref :gmir/refusal] :gmir problem
    (string-concat "GMIR rejected: " (keyword-name problem)) data))
(defn phase [value [:ref :gmir/refusal]] :keyword (record-get [:ref :gmir/refusal] value :phase))
(defn problem [value [:ref :gmir/refusal]] :keyword (record-get [:ref :gmir/refusal] value :problem))
(defn message [value [:ref :gmir/refusal]] :string (record-get [:ref :gmir/refusal] value :message))
(defn instruction [value [:ref :gmir/refusal]] [:ref :gmir.node/value]
  (record-get [:ref :gmir/refusal] value :instruction))
