      (arity :rdtscp 0)
      (arity :swapgs 0)
      (arity :system-table 0)
      (arity :load-ptr 2)
      (arity :uefi-call2 4)
      (arity :jump-to 2)
      (arity :uefi-call4 6)
      (arity :uefi-call6 8)
