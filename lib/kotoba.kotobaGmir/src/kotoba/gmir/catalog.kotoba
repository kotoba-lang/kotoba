    :gmir/f32-sqrt (option-some-of [:option [:list :keyword]] (-> (typed-list-new [:list :keyword]) (kw :gmir/op) (kw :gmir/dst) (kw :gmir/input)))
    :gmir/f32-equal (option-some-of [:option [:list :keyword]] (-> (typed-list-new [:list :keyword]) (kw :gmir/op) (kw :gmir/dst) (kw :gmir/left) (kw :gmir/right)))
