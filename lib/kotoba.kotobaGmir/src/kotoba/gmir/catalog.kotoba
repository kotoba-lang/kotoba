;; Canonical contract data. Transcribed from gmir.cljk at 1ae0811ec3591bf5a3e3d7bee069df928106feca.
;; Typed collections carry complete tables; no generic document size limit is changed.
;; This supporting module does not replace the root validator or qualify native execution.
(ns kotoba.gmir.catalog
  {:kotoba/export [version max-arity slice-item-limit kernel-dot-f32-maximum supported-versions kernel-window-operations kernel-window-maxima slice-operations kernel-atomic-ops instruction-keysets instruction-operations kernel-dot-f32-element-limit kernel-dequant-dot-formats kernel-dequant-dot-operations kernel-dequant-dot-maximum kernel-dequant-dot-block-limit capability-kinds runtime-operation-arities x86-privileged-action-arities keyword-member? i64-member? arity-name arity-value arity-of keyset-operation keyset-keys instruction-keys format-operation format-block-bytes format-block-elements format-of operation-allowed? indexed-memory-operation? instruction-keys-in operation-allowed-in?]}
  (:schemas
   {:gmir.catalog/arity [:record :gmir.catalog/arity [[:name :keyword] [:value :i64]]]
    :gmir.catalog/keyset [:record :gmir.catalog/keyset [[:operation :keyword] [:keys [:list :keyword]]]]
    :gmir.catalog/format [:record :gmir.catalog/format
      [[:operation :keyword] [:block-bytes :i64] [:block-elements :i64]]]}))

(defn version [] :i64 (arena-scope 3))
(defn max-arity [] :i64 (arena-scope 64))
(defn slice-item-limit [] :i64 (arena-scope 1099511627776))
(defn kernel-dot-f32-maximum [] :i64 (arena-scope 65536))
(defn kernel-dot-f32-element-limit [] :i64 (arena-scope (quot (kernel-dot-f32-maximum) 4)))
(defn kernel-dequant-dot-maximum [] :i64 (arena-scope (kernel-dot-f32-maximum)))

(defn- kw [out [:list :keyword] value :keyword] [:list :keyword]
  (typed-list-conj [:list :keyword] out value))
(defn- integer [out [:list :i64] value :i64] [:list :i64]
  (typed-list-conj [:list :i64] out value))

(defn supported-versions [] [:list :i64]
  (-> (typed-list-new [:list :i64])
      (integer 1)
      (integer 2)
      (integer 3)))

(defn kernel-window-operations [] [:list :keyword]
  (-> (typed-list-new [:list :keyword])
      (kw :gmir/kernel-load-u8)
      (kw :gmir/kernel-store-u8)
      (kw :gmir/kernel-load-u16)
      (kw :gmir/kernel-store-u16)
      (kw :gmir/kernel-load-u32)
      (kw :gmir/kernel-store-u32)
      (kw :gmir/kernel-load-u64)
      (kw :gmir/kernel-store-u64)))

(defn kernel-window-maxima [] [:list :i64]
  (-> (typed-list-new [:list :i64])
      (integer 512)
      (integer 4096)
      (integer 16384)
      (integer 65536)))

(defn slice-operations [] [:list :keyword]
  (-> (typed-list-new [:list :keyword])
      (kw :gmir/slice-load-u8)
      (kw :gmir/slice-store-u8)
      (kw :gmir/slice-load-u16)
      (kw :gmir/slice-store-u16)
      (kw :gmir/slice-load-u32)
      (kw :gmir/slice-store-u32)
      (kw :gmir/slice-load-u64)
      (kw :gmir/slice-store-u64)))

(defn kernel-atomic-ops [] [:list :keyword]
  (-> (typed-list-new [:list :keyword])
      (kw :gmir/kernel-atomic-add-u32)
      (kw :gmir/kernel-atomic-add-u64)
      (kw :gmir/kernel-xchg-u32)
      (kw :gmir/kernel-xchg-u64)
      (kw :gmir/kernel-cmpxchg-u32)
      (kw :gmir/kernel-cmpxchg-u64)))

(defn- shape [out [:list [:ref :gmir.catalog/keyset]] operation :keyword keys [:list :keyword]]
  [:list [:ref :gmir.catalog/keyset]]
  (typed-list-conj [:list [:ref :gmir.catalog/keyset]] out
    (record-new [:ref :gmir.catalog/keyset] operation keys)))

