(defn- format [out [:list [:ref :gmir.catalog/format]] op :keyword packed :i64 elements :i64]
  [:list [:ref :gmir.catalog/format]]
  (typed-list-conj [:list [:ref :gmir.catalog/format]] out
    (record-new [:ref :gmir.catalog/format] op packed elements)))

(defn kernel-dequant-dot-formats [] [:list [:ref :gmir.catalog/format]]
  (-> (typed-list-new [:list [:ref :gmir.catalog/format]])
      (format :gmir/kernel-dequant-dot-q8-0 34 32)
      (format :gmir/kernel-dequant-dot-q4-k 144 256)
      (format :gmir/kernel-dequant-dot-q6-k 210 256)
      (format :gmir/kernel-dequant-dot-iq4-xs 136 256)
      (format :gmir/kernel-dequant-dot-iq2-s 82 256)
      (format :gmir/kernel-dequant-dot-iq3-xxs 98 256)
      (format :gmir/kernel-dequant-dot-iq3-s 110 256)
      (format :gmir/kernel-dequant-dot-ptq1-0 28 128)))

(defn keyword-member? [values [:list :keyword] value :keyword] :bool
  (arena-scope (loop [index 0]
    (if (>= index (vector-count values)) false
      (if (= (typed-list-nth [:list :keyword] values index) value) true (recur (+ index 1)))))))
(defn i64-member? [values [:list :i64] value :i64] :bool
  (arena-scope (loop [index 0]
    (if (>= index (vector-count values)) false
      (if (= (typed-list-nth [:list :i64] values index) value) true (recur (+ index 1)))))))
(defn arity-name [entry [:ref :gmir.catalog/arity]] :keyword
  (record-get [:ref :gmir.catalog/arity] entry :name))
(defn arity-value [entry [:ref :gmir.catalog/arity]] :i64
  (arena-scope (record-get [:ref :gmir.catalog/arity] entry :value)))
(defn arity-of [values [:list [:ref :gmir.catalog/arity]] name :keyword] [:option :i64]
  (loop [index 0]
    (if (>= index (vector-count values)) (option-none-of [:option :i64])
      (let [entry (typed-list-nth [:list [:ref :gmir.catalog/arity]] values index)]
        (if (= (arity-name entry) name) (option-some-of [:option :i64] (arity-value entry))
          (recur (+ index 1)))))))
(defn keyset-operation [entry [:ref :gmir.catalog/keyset]] :keyword
  (record-get [:ref :gmir.catalog/keyset] entry :operation))
(defn keyset-keys [entry [:ref :gmir.catalog/keyset]] [:list :keyword]
  (record-get [:ref :gmir.catalog/keyset] entry :keys))
(defn instruction-keys-in [all [:list [:ref :gmir.catalog/keyset]] operation :keyword] [:option [:list :keyword]]
  (loop [index 0]
      (if (>= index (vector-count all)) (option-none-of [:option [:list :keyword]])
        (let [entry (typed-list-nth [:list [:ref :gmir.catalog/keyset]] all index)]
          (if (= (keyset-operation entry) operation)
            (option-some-of [:option [:list :keyword]] (keyset-keys entry)) (recur (+ index 1)))))))
(defn instruction-keys [operation :keyword] [:option [:list :keyword]]
  (case operation
    :gmir/argument (option-some-of [:option [:list :keyword]] (-> (typed-list-new [:list :keyword]) (kw :gmir/op) (kw :gmir/dst) (kw :gmir/index)))
    :gmir/constant (option-some-of [:option [:list :keyword]] (-> (typed-list-new [:list :keyword]) (kw :gmir/op) (kw :gmir/dst) (kw :gmir/value)))
    :gmir/data-address (option-some-of [:option [:list :keyword]] (-> (typed-list-new [:list :keyword]) (kw :gmir/op) (kw :gmir/dst) (kw :gmir/content)))
    :gmir/rodata-address (option-some-of [:option [:list :keyword]] (-> (typed-list-new [:list :keyword]) (kw :gmir/op) (kw :gmir/dst) (kw :gmir/content) (kw :gmir/rodata-encoding)))
    :gmir/function-address (option-some-of [:option [:list :keyword]] (-> (typed-list-new [:list :keyword]) (kw :gmir/op) (kw :gmir/dst) (kw :gmir/function)))
    :gmir/add (option-some-of [:option [:list :keyword]] (-> (typed-list-new [:list :keyword]) (kw :gmir/op) (kw :gmir/dst) (kw :gmir/left) (kw :gmir/right)))
    :gmir/subtract (option-some-of [:option [:list :keyword]] (-> (typed-list-new [:list :keyword]) (kw :gmir/op) (kw :gmir/dst) (kw :gmir/left) (kw :gmir/right)))
    :gmir/multiply (option-some-of [:option [:list :keyword]] (-> (typed-list-new [:list :keyword]) (kw :gmir/op) (kw :gmir/dst) (kw :gmir/left) (kw :gmir/right)))
    :gmir/quotient (option-some-of [:option [:list :keyword]] (-> (typed-list-new [:list :keyword]) (kw :gmir/op) (kw :gmir/dst) (kw :gmir/left) (kw :gmir/right)))
    :gmir/bit-and (option-some-of [:option [:list :keyword]] (-> (typed-list-new [:list :keyword]) (kw :gmir/op) (kw :gmir/dst) (kw :gmir/left) (kw :gmir/right)))
    :gmir/bit-or (option-some-of [:option [:list :keyword]] (-> (typed-list-new [:list :keyword]) (kw :gmir/op) (kw :gmir/dst) (kw :gmir/left) (kw :gmir/right)))
    :gmir/bit-xor (option-some-of [:option [:list :keyword]] (-> (typed-list-new [:list :keyword]) (kw :gmir/op) (kw :gmir/dst) (kw :gmir/left) (kw :gmir/right)))
    :gmir/shift-left (option-some-of [:option [:list :keyword]] (-> (typed-list-new [:list :keyword]) (kw :gmir/op) (kw :gmir/dst) (kw :gmir/left) (kw :gmir/right)))
    :gmir/shift-right-signed (option-some-of [:option [:list :keyword]] (-> (typed-list-new [:list :keyword]) (kw :gmir/op) (kw :gmir/dst) (kw :gmir/left) (kw :gmir/right)))
    :gmir/shift-right-unsigned (option-some-of [:option [:list :keyword]] (-> (typed-list-new [:list :keyword]) (kw :gmir/op) (kw :gmir/dst) (kw :gmir/left) (kw :gmir/right)))
    :gmir/f64-add (option-some-of [:option [:list :keyword]] (-> (typed-list-new [:list :keyword]) (kw :gmir/op) (kw :gmir/dst) (kw :gmir/left) (kw :gmir/right)))
    :gmir/f64-subtract (option-some-of [:option [:list :keyword]] (-> (typed-list-new [:list :keyword]) (kw :gmir/op) (kw :gmir/dst) (kw :gmir/left) (kw :gmir/right)))
    :gmir/f64-multiply (option-some-of [:option [:list :keyword]] (-> (typed-list-new [:list :keyword]) (kw :gmir/op) (kw :gmir/dst) (kw :gmir/left) (kw :gmir/right)))
    :gmir/f64-divide (option-some-of [:option [:list :keyword]] (-> (typed-list-new [:list :keyword]) (kw :gmir/op) (kw :gmir/dst) (kw :gmir/left) (kw :gmir/right)))
    :gmir/f64-min (option-some-of [:option [:list :keyword]] (-> (typed-list-new [:list :keyword]) (kw :gmir/op) (kw :gmir/dst) (kw :gmir/left) (kw :gmir/right)))
    :gmir/f64-max (option-some-of [:option [:list :keyword]] (-> (typed-list-new [:list :keyword]) (kw :gmir/op) (kw :gmir/dst) (kw :gmir/left) (kw :gmir/right)))
    :gmir/f64-sqrt (option-some-of [:option [:list :keyword]] (-> (typed-list-new [:list :keyword]) (kw :gmir/op) (kw :gmir/dst) (kw :gmir/input)))
    :gmir/f64-equal (option-some-of [:option [:list :keyword]] (-> (typed-list-new [:list :keyword]) (kw :gmir/op) (kw :gmir/dst) (kw :gmir/left) (kw :gmir/right)))
    :gmir/f64-less-than (option-some-of [:option [:list :keyword]] (-> (typed-list-new [:list :keyword]) (kw :gmir/op) (kw :gmir/dst) (kw :gmir/left) (kw :gmir/right)))
    :gmir/f64-less-or-equal (option-some-of [:option [:list :keyword]] (-> (typed-list-new [:list :keyword]) (kw :gmir/op) (kw :gmir/dst) (kw :gmir/left) (kw :gmir/right)))
    :gmir/f64-greater-than (option-some-of [:option [:list :keyword]] (-> (typed-list-new [:list :keyword]) (kw :gmir/op) (kw :gmir/dst) (kw :gmir/left) (kw :gmir/right)))
