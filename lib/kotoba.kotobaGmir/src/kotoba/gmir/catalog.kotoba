(defn- arity [out [:list [:ref :gmir.catalog/arity]] name :keyword value :i64]
  [:list [:ref :gmir.catalog/arity]]
  (typed-list-conj [:list [:ref :gmir.catalog/arity]] out
    (record-new [:ref :gmir.catalog/arity] name value)))

(defn capability-kinds [] [:list [:ref :gmir.catalog/arity]]
  (-> (typed-list-new [:list [:ref :gmir.catalog/arity]])
      (arity :i64 0)
      (arity :string 1)
      (arity :option-i64 2)
      (arity :result-i64 3)
      (arity :clock-v1 4)
      (arity :dataspace-v1 5)
      (arity :ui-commit-v1 6)
      (arity :ui-event-v1 7)))

(defn runtime-operation-arities [] [:list [:ref :gmir.catalog/arity]]
  (-> (typed-list-new [:list [:ref :gmir.catalog/arity]])
      (arity :pair 2)
      (arity :pair-first 1)
      (arity :pair-second 1)
      (arity :kgraph-assert! 3)
      (arity :kgraph-get 2)
      (arity :kgraph-count 1)
      (arity :kgraph-entity-at 2)
      (arity :string-byte-length 1)
      (arity :string=? 2)
      (arity :string-concat 2)
      (arity :string-substring 3)
      (arity :string-code-point-at 2)
      (arity :vector-new-empty 0)
      (arity :vector-conj 2)
      (arity :vector-count 1)
      (arity :vector-at 2)
      (arity :vector-assoc 3)
      (arity :vector-drop 2)
      (arity :vector-alloc 1)
      (arity :vector-assoc-in-place 3)
      (arity :string-index-of 2)
      (arity :arena-enter 0)
      (arity :arena-leave 0)
      (arity :string-compare 2)
      (arity :string-fold-ascii 1)
      (arity :string-find-blank 2)
      (arity :string-skip-blank 2)
      (arity :string-index-of-from 3)
      (arity :string-compare-lines 4)
      (arity :string-find-byte 3)
      (arity :string-append-range 4)
      (arity :string-from-utf8 1)
      (arity :bytes-from-vector 1)
      (arity :bytes-slice 3)
      (arity :bytes-concat 2)
      (arity :fuel-charge 0)
      (arity :gas-charge 1)))

(defn x86-privileged-action-arities [] [:list [:ref :gmir.catalog/arity]]
  (-> (typed-list-new [:list [:ref :gmir.catalog/arity]])
      (arity :boot-info 0)
      (arity :read-cr0 0)
      (arity :write-cr0 1)
      (arity :read-cr2 0)
      (arity :read-cr3 0)
      (arity :write-cr3 1)
      (arity :invlpg 1)
      (arity :read-cs 0)
      (arity :page-fault-handler-address 0)
      (arity :rt-timer-handler-address 0)
      (arity :page-fault-recovery-handler-address 0)
      (arity :configure-page-fault-recovery 2)
      (arity :load-idt 2)
      (arity :double-fault-handler-address 0)
      (arity :undefined-opcode-handler-address 0)
      (arity :configure-double-fault-ist 2)
      (arity :load-gdt-tss 2)
      (arity :probe-guard-write 0)
      (arity :probe-text-write 0)
      (arity :probe-nx-execute 0)
      (arity :probe-recoverable-guard-write 0)
      (arity :probe-double-fault 0)
      (arity :cli 0)
      (arity :sti 0)
      (arity :hlt 0)
      (arity :pause 0)
      (arity :out-u8 2)
      (arity :out-u32 2)
      (arity :in-u8 1)
      (arity :in-u32 1)
      (arity :read-msr 1)
      (arity :write-msr 2)
      (arity :cpuid-eax 2)
      (arity :cpuid-ebx 2)
      (arity :cpuid-ecx 2)
      (arity :cpuid-edx 2)
      (arity :xgetbv 1)
      (arity :read-cr4 0)
      (arity :write-cr4 1)
      (arity :xsetbv 2)
      (arity :fence-load 0)
      (arity :fence-store 0)
      (arity :fence-full 0)
