    :gmir/kernel-dequant-dot-q6-k (option-some-of [:option [:list :keyword]] (-> (typed-list-new [:list :keyword]) (kw :gmir/op) (kw :gmir/dst) (kw :gmir/base) (kw :gmir/length) (kw :gmir/second-base) (kw :gmir/second-length) (kw :gmir/count) (kw :gmir/maximum)))
    :gmir/kernel-dequant-dot-iq4-xs (option-some-of [:option [:list :keyword]] (-> (typed-list-new [:list :keyword]) (kw :gmir/op) (kw :gmir/dst) (kw :gmir/base) (kw :gmir/length) (kw :gmir/second-base) (kw :gmir/second-length) (kw :gmir/count) (kw :gmir/maximum)))
    :gmir/kernel-dequant-dot-iq2-s (option-some-of [:option [:list :keyword]] (-> (typed-list-new [:list :keyword]) (kw :gmir/op) (kw :gmir/dst) (kw :gmir/base) (kw :gmir/length) (kw :gmir/second-base) (kw :gmir/second-length) (kw :gmir/count) (kw :gmir/maximum)))
    :gmir/kernel-dequant-dot-iq3-xxs (option-some-of [:option [:list :keyword]] (-> (typed-list-new [:list :keyword]) (kw :gmir/op) (kw :gmir/dst) (kw :gmir/base) (kw :gmir/length) (kw :gmir/second-base) (kw :gmir/second-length) (kw :gmir/count) (kw :gmir/maximum)))
    :gmir/kernel-dequant-dot-iq3-s (option-some-of [:option [:list :keyword]] (-> (typed-list-new [:list :keyword]) (kw :gmir/op) (kw :gmir/dst) (kw :gmir/base) (kw :gmir/length) (kw :gmir/second-base) (kw :gmir/second-length) (kw :gmir/count) (kw :gmir/maximum)))
    :gmir/kernel-dequant-dot-ptq1-0 (option-some-of [:option [:list :keyword]] (-> (typed-list-new [:list :keyword]) (kw :gmir/op) (kw :gmir/dst) (kw :gmir/base) (kw :gmir/length) (kw :gmir/second-base) (kw :gmir/second-length) (kw :gmir/count) (kw :gmir/maximum)))
    :gmir/kernel-subregion (option-some-of [:option [:list :keyword]] (-> (typed-list-new [:list :keyword]) (kw :gmir/op) (kw :gmir/dst) (kw :gmir/base) (kw :gmir/length) (kw :gmir/offset) (kw :gmir/size)))
    :gmir/equal (option-some-of [:option [:list :keyword]] (-> (typed-list-new [:list :keyword]) (kw :gmir/op) (kw :gmir/dst) (kw :gmir/left) (kw :gmir/right)))
    :gmir/less-than (option-some-of [:option [:list :keyword]] (-> (typed-list-new [:list :keyword]) (kw :gmir/op) (kw :gmir/dst) (kw :gmir/left) (kw :gmir/right)))
    :gmir/greater-than (option-some-of [:option [:list :keyword]] (-> (typed-list-new [:list :keyword]) (kw :gmir/op) (kw :gmir/dst) (kw :gmir/left) (kw :gmir/right)))
    :gmir/less-or-equal (option-some-of [:option [:list :keyword]] (-> (typed-list-new [:list :keyword]) (kw :gmir/op) (kw :gmir/dst) (kw :gmir/left) (kw :gmir/right)))
    :gmir/greater-or-equal (option-some-of [:option [:list :keyword]] (-> (typed-list-new [:list :keyword]) (kw :gmir/op) (kw :gmir/dst) (kw :gmir/left) (kw :gmir/right)))
    :gmir/label (option-some-of [:option [:list :keyword]] (-> (typed-list-new [:list :keyword]) (kw :gmir/op) (kw :gmir/id)))
    :gmir/branch-zero (option-some-of [:option [:list :keyword]] (-> (typed-list-new [:list :keyword]) (kw :gmir/op) (kw :gmir/test) (kw :gmir/target)))
    :gmir/jump (option-some-of [:option [:list :keyword]] (-> (typed-list-new [:list :keyword]) (kw :gmir/op) (kw :gmir/target)))
    :gmir/phi (option-some-of [:option [:list :keyword]] (-> (typed-list-new [:list :keyword]) (kw :gmir/op) (kw :gmir/dst) (kw :gmir/incomings)))
    :gmir/call (option-some-of [:option [:list :keyword]] (-> (typed-list-new [:list :keyword]) (kw :gmir/op) (kw :gmir/dst) (kw :gmir/callee) (kw :gmir/arguments)))
    :gmir/tail-call (option-some-of [:option [:list :keyword]] (-> (typed-list-new [:list :keyword]) (kw :gmir/op) (kw :gmir/callee) (kw :gmir/arguments)))
    :gmir/runtime-call (option-some-of [:option [:list :keyword]] (-> (typed-list-new [:list :keyword]) (kw :gmir/op) (kw :gmir/dst) (kw :gmir/runtime) (kw :gmir/arguments)))
    :gmir/x86-privileged (option-some-of [:option [:list :keyword]] (-> (typed-list-new [:list :keyword]) (kw :gmir/op) (kw :gmir/dst) (kw :gmir/action) (kw :gmir/arguments)))
    :gmir/capability-call (option-some-of [:option [:list :keyword]] (-> (typed-list-new [:list :keyword]) (kw :gmir/op) (kw :gmir/dst) (kw :gmir/capability) (kw :gmir/kind) (kw :gmir/arguments)))
    :gmir/return (option-some-of [:option [:list :keyword]] (-> (typed-list-new [:list :keyword]) (kw :gmir/op) (kw :gmir/value)))
    (option-none-of [:option [:list :keyword]])))
(defn format-operation [entry [:ref :gmir.catalog/format]] :keyword
  (record-get [:ref :gmir.catalog/format] entry :operation))
(defn format-block-bytes [entry [:ref :gmir.catalog/format]] :i64
  (arena-scope (record-get [:ref :gmir.catalog/format] entry :block-bytes)))
(defn format-block-elements [entry [:ref :gmir.catalog/format]] :i64
  (arena-scope (record-get [:ref :gmir.catalog/format] entry :block-elements)))
(defn format-of [operation :keyword] [:option [:ref :gmir.catalog/format]]
  (let [all (kernel-dequant-dot-formats)]
    (loop [index 0]
      (if (>= index (vector-count all)) (option-none-of [:option [:ref :gmir.catalog/format]])
        (let [entry (typed-list-nth [:list [:ref :gmir.catalog/format]] all index)]
          (if (= (format-operation entry) operation)
            (option-some-of [:option [:ref :gmir.catalog/format]] entry) (recur (+ index 1))))))))
(defn kernel-dequant-dot-operations [] [:list :keyword]
  (let [all (kernel-dequant-dot-formats)]
    (loop [index 0 out (typed-list-new [:list :keyword])]
      (if (>= index (vector-count all)) out
        (recur (+ index 1) (kw out (format-operation
          (typed-list-nth [:list [:ref :gmir.catalog/format]] all index))))))))

;; Known formats retain the derived minimum of both independent spans. An
;; unknown operation has no numeric limit: callers must propagate None as a
;; refusal. It is never admitted with zero/a default. Root/caller adaptation
;; from the old throwing host API remains part of the whole-port acceptance.
(defn kernel-dequant-dot-block-limit [operation :keyword] [:option :i64]
  (let [found (format-of operation)]
    (if (not (option-some?-of [:option [:ref :gmir.catalog/format]] found)) (option-none-of [:option :i64])
      (let [entry (option-match [:option [:ref :gmir.catalog/format]] found (record-new [:ref :gmir.catalog/format] :none 1 1) found-value found-value)
            packed (quot (kernel-dequant-dot-maximum) (format-block-bytes entry))
            unpacked (quot (kernel-dequant-dot-maximum) (* 4 (format-block-elements entry)))]
        (option-some-of [:option :i64] (if (< packed unpacked) packed unpacked))))))

(defn operation-allowed-in? [all [:list [:ref :gmir.catalog/keyset]] program-version :i64 operation :keyword] :bool
  (arena-scope (and (>= program-version 1) (<= program-version (version))
       (option-some?-of [:option [:list :keyword]] (instruction-keys-in all operation))
       (case program-version
         1 (and (not= operation :gmir/phi) (not= operation :gmir/tail-call))
         2 (and (not= operation :gmir/call) (not= operation :gmir/tail-call))
         3 true
         false))))
(defn operation-allowed? [program-version :i64 operation :keyword] :bool
  (arena-scope (and (>= program-version 1) (<= program-version (version))
       (option-some?-of [:option [:list :keyword]] (instruction-keys operation))
       (case program-version
         1 (and (not= operation :gmir/phi) (not= operation :gmir/tail-call))
         2 (and (not= operation :gmir/call) (not= operation :gmir/tail-call))
         3 true false))))
(defn indexed-memory-operation? [operation :keyword] :bool
  (arena-scope (or (= operation :gmir/kernel-try-lock-u32) (= operation :gmir/kernel-unlock-u32)
      (keyword-member? (kernel-window-operations) operation)
      (keyword-member? (slice-operations) operation)
      (keyword-member? (kernel-atomic-ops) operation))))


;; Canonical names only; avoid materializing every keyset for a lookup.
(defn instruction-operations [] [:list :keyword]
  (-> (typed-list-new [:list :keyword])
      (kw :gmir/argument)
      (kw :gmir/constant)
      (kw :gmir/data-address)
      (kw :gmir/rodata-address)
      (kw :gmir/function-address)
      (kw :gmir/add)
      (kw :gmir/subtract)
      (kw :gmir/multiply)
      (kw :gmir/quotient)
      (kw :gmir/bit-and)
      (kw :gmir/bit-or)
      (kw :gmir/bit-xor)
      (kw :gmir/shift-left)
      (kw :gmir/shift-right-signed)
      (kw :gmir/shift-right-unsigned)
      (kw :gmir/f64-add)
      (kw :gmir/f64-subtract)
      (kw :gmir/f64-multiply)
      (kw :gmir/f64-divide)
      (kw :gmir/f64-min)
      (kw :gmir/f64-max)
      (kw :gmir/f64-sqrt)
      (kw :gmir/f64-equal)
      (kw :gmir/f64-less-than)
      (kw :gmir/f64-less-or-equal)
      (kw :gmir/f64-greater-than)
      (kw :gmir/f64-greater-or-equal)
      (kw :gmir/f64-unordered)
      (kw :gmir/f32-add)
      (kw :gmir/f32-subtract)
      (kw :gmir/f32-multiply)
      (kw :gmir/f32-divide)
      (kw :gmir/f32-sqrt)
      (kw :gmir/f32-equal)
      (kw :gmir/f32-less-than)
      (kw :gmir/f32-less-or-equal)
      (kw :gmir/f32-greater-than)
      (kw :gmir/f32-greater-or-equal)
      (kw :gmir/f32-unordered)
      (kw :gmir/f32-to-f64)
      (kw :gmir/f64-to-f32)
      (kw :gmir/i64-to-f32)
      (kw :gmir/i64-to-f64)
      (kw :gmir/kernel-load-u8)
      (kw :gmir/kernel-store-u8)
      (kw :gmir/kernel-load-u32)
      (kw :gmir/kernel-store-u32)
      (kw :gmir/kernel-load-u16)
      (kw :gmir/kernel-store-u16)
      (kw :gmir/kernel-load-u64)
      (kw :gmir/kernel-store-u64)
      (kw :gmir/slice-load-u8)
      (kw :gmir/slice-store-u8)
      (kw :gmir/slice-load-u16)
      (kw :gmir/slice-store-u16)
      (kw :gmir/slice-load-u32)
      (kw :gmir/slice-store-u32)
      (kw :gmir/slice-load-u64)
      (kw :gmir/slice-store-u64)
      (kw :gmir/kernel-try-lock-u32)
      (kw :gmir/kernel-unlock-u32)
      (kw :gmir/kernel-atomic-add-u32)
      (kw :gmir/kernel-atomic-add-u64)
      (kw :gmir/kernel-xchg-u32)
      (kw :gmir/kernel-xchg-u64)
      (kw :gmir/kernel-cmpxchg-u32)
      (kw :gmir/kernel-cmpxchg-u64)
      (kw :gmir/kernel-dot-f32)
      (kw :gmir/kernel-dequant-dot-q8-0)
      (kw :gmir/kernel-dequant-dot-q4-k)
      (kw :gmir/kernel-dequant-dot-q6-k)
      (kw :gmir/kernel-dequant-dot-iq4-xs)
      (kw :gmir/kernel-dequant-dot-iq2-s)
      (kw :gmir/kernel-dequant-dot-iq3-xxs)
      (kw :gmir/kernel-dequant-dot-iq3-s)
      (kw :gmir/kernel-dequant-dot-ptq1-0)
      (kw :gmir/kernel-subregion)
      (kw :gmir/equal)
      (kw :gmir/less-than)
      (kw :gmir/greater-than)
      (kw :gmir/less-or-equal)
      (kw :gmir/greater-or-equal)
      (kw :gmir/label)
      (kw :gmir/branch-zero)
      (kw :gmir/jump)
      (kw :gmir/phi)
      (kw :gmir/call)
      (kw :gmir/tail-call)
      (kw :gmir/runtime-call)
