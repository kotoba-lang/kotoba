    :gmir/kernel-load-u8 (option-some-of [:option [:list :keyword]] (-> (typed-list-new [:list :keyword]) (kw :gmir/op) (kw :gmir/dst) (kw :gmir/base) (kw :gmir/length) (kw :gmir/index) (kw :gmir/maximum)))
