;; Canonical identity/scalar boundary. Root/caller/CID migration and native
;; admission/execution are not established by this source candidate.
(ns kotoba.gmir.identity
  {:kotoba/export [vreg vreg? label? function-id? i64-value? integer-i64 nonnegative-integer? integer-form?]}
  (:require [kotoba.gmir.node :as node] [kotoba.gmir.outcome :as outcome]))

(defn- digit? [byte :i64] :bool (arena-scope (and (>= byte 48) (<= byte 57))))
(defn- sign-start [text [:ref :gmir.node/text]] :i64
  (arena-scope (if (or (= (node/text-at text 0) 45) (= (node/text-at text 0) 43)) 1 0)))
(defn- decimal? [text [:ref :gmir.node/text]] :bool
  (arena-scope (let [start (sign-start text) count (node/text-count text)]
    (if (>= start count) false
      (loop [index start]
        (if (>= index count) true
          (if (digit? (node/text-at text index)) (recur (+ index 1)) false)))))))

;; Accumulate negatively, so -2^63 never passes through an unrepresentable
;; positive intermediate. The pre-multiply threshold uses truncation toward
;; zero (ceil for a negative dividend); no wrapping arithmetic is accepted.
(defn- parse-i64 [text [:ref :gmir.node/text]] [:option :i64]
  (if (not (decimal? text)) (option-none-of [:option :i64])
    (let [negative (= (node/text-at text 0) 45)
          limit (if negative -9223372036854775808 -9223372036854775807)
          count (node/text-count text)]
      (loop [index (sign-start text) accumulator 0]
        (if (>= index count)
          (option-some-of [:option :i64] (if negative accumulator (- 0 accumulator)))
          (let [digit (- (node/text-at text index) 48)]
            (if (< accumulator (quot (+ limit digit) 10)) (option-none-of [:option :i64])
              (recur (+ index 1) (- (* accumulator 10) digit)))))))))
(defn integer-i64 [value [:ref :gmir.node/value]] [:option :i64]
  (case (node/kind value)
    :i64 (option-some-of [:option :i64] (node/number value))
    :integer (parse-i64 (node/name-of value))
    (option-none-of [:option :i64])))
(defn i64-value? [value [:ref :gmir.node/value]] :bool
  (arena-scope (option-some?-of [:option :i64] (integer-i64 value))))
(defn integer-form? [value [:ref :gmir.node/value]] :bool
  (arena-scope (or (= (node/kind value) :i64) (and (= (node/kind value) :integer) (decimal? (node/name-of value))))))

;; A nonnegative integer is not restricted to i64. Preserve very large
;; indices as decimal text, normalize zero/sign/leading zeros, and let actual
;; native value/arena bounds refuse resources rather than turning it into a
;; valid small index or inventing an extra GMIR index ceiling.
(defn- index-name [value [:ref :gmir.node/value]] [:option [:ref :gmir.node/text]]
  (case (node/kind value)
    :i64 (if (< (node/number value) 0) (option-none-of [:option [:ref :gmir.node/text]])
           (option-some-of [:option [:ref :gmir.node/text]]
             (node/string-text (string-from-i64 (node/number value)))))
    :integer
    (let [text (node/name-of value) count (node/text-count text)]
      (if (not (decimal? text)) (option-none-of [:option [:ref :gmir.node/text]])
        (loop [index (sign-start text)]
          (if (>= index count)
            (option-some-of [:option [:ref :gmir.node/text]] (node/string-text "0"))
            (if (= (node/text-at text index) 48) (recur (+ index 1))
              (if (= (node/text-at text 0) 45) (option-none-of [:option [:ref :gmir.node/text]])
                (node/text-slice text index count)))))))
    (option-none-of [:option [:ref :gmir.node/text]])))
(defn nonnegative-integer? [value [:ref :gmir.node/value]] :bool
  (arena-scope (option-some?-of [:option [:ref :gmir.node/text]] (index-name value))))
(defn vreg [index [:ref :gmir.node/value]] [:result [:ref :gmir.node/value] [:ref :gmir/refusal]]
  (let [name (index-name index)]
    (if (not (option-some?-of [:option [:ref :gmir.node/text]] name))
      (result-err-of [:result [:ref :gmir.node/value] [:ref :gmir/refusal]]
        (outcome/refusal :invalid-virtual-register-index (node/put-key (node/empty-map) :index index)))
      (result-ok-of [:result [:ref :gmir.node/value] [:ref :gmir/refusal]]
        (node/keyword-parts
          (option-some-of [:option [:ref :gmir.node/text]] (node/string-text "kotoba.gmir.vreg"))
          (option-match [:option [:ref :gmir.node/text]] name (node/empty-text) found-value found-value))))))
(defn vreg? [value [:ref :gmir.node/value]] :bool
  (arena-scope (let [name (node/name-of value) count (node/text-count name)]
    (and (= (node/kind value) :keyword) (node/has-namespace? value)
         (node/text-equal?
           (option-match [:option [:ref :gmir.node/text]] (node/namespace-of value) (node/empty-text) found-value found-value)
           (node/string-text "kotoba.gmir.vreg"))
         (> count 0)
         (if (= (node/text-at name 0) 48) (= count 1)
           (and (>= (node/text-at name 0) 49) (<= (node/text-at name 0) 57)
                (loop [index 1]
                  (if (>= index count) true
                    (if (digit? (node/text-at name index)) (recur (+ index 1)) false)))))))))
(defn label? [value [:ref :gmir.node/value]] :bool
  (arena-scope (and (= (node/kind value) :keyword) (node/has-namespace? value)
       (node/text-valid? (node/name-of value))
       (node/text-valid? (option-match [:option [:ref :gmir.node/text]] (node/namespace-of value) (node/empty-text) found-value found-value)))))
(defn function-id? [value [:ref :gmir.node/value]] :bool
  (arena-scope (and (= (node/kind value) :symbol) (> (node/text-count (node/name-of value)) 0)
       (node/text-valid? (node/name-of value))
       (or (not (node/has-namespace? value))
           (node/text-valid? (option-match [:option [:ref :gmir.node/text]] (node/namespace-of value) (node/empty-text) found-value found-value))))))
