;; Complete reference-check ordering transcribed to nominal paged data.
;; Source candidate: native admission, execution and corpus parity are open.
(ns kotoba.gmir.validation
  {:kotoba/export [validate!]}
  (:require [kotoba.gmir.node :as node] [kotoba.gmir.identity :as identity]
            [kotoba.gmir.catalog :as catalog] [kotoba.gmir.rodata :as rodata]
            [kotoba.gmir.outcome :as outcome]))

(defn- clean [] [:option [:ref :gmir/refusal]] (option-none-of [:option [:ref :gmir/refusal]]))
(defn- failure [problem :keyword data [:ref :gmir.node/value]] [:option [:ref :gmir/refusal]]
  (option-some-of [:option [:ref :gmir/refusal]] (outcome/refusal problem data)))
(defn- failed? [value [:option [:ref :gmir/refusal]]] :bool
  (arena-scope (option-some?-of [:option [:ref :gmir/refusal]] value)))
(defn- at [value [:ref :gmir.node/value] index :i64] [:ref :gmir.node/value]
  (option-match [:option [:ref :gmir.node/value]] (node/child value index) (node/nil-value) item item))
(defn- is-key? [value [:ref :gmir.node/value] key :keyword] :bool
  (arena-scope (node/keyword-is? value key)))
(defn- kw [out [:list :keyword] value :keyword] [:list :keyword]
  (typed-list-conj [:list :keyword] out value))
(defn- keys2 [a :keyword b :keyword] [:list :keyword]
  (kw (kw (typed-list-new [:list :keyword]) a) b))
(defn- keys3 [a :keyword b :keyword c :keyword] [:list :keyword] (kw (keys2 a b) c))
(defn- key-member? [value [:ref :gmir.node/value] keys [:list :keyword]] :bool
  (arena-scope (loop [index 0]
    (if (>= index (vector-count keys)) false
      (if (is-key? value (typed-list-nth [:list :keyword] keys index)) true (recur (+ index 1)))))))
(defn- same-fields? [value [:ref :gmir.node/value] expected [:list :keyword]] :bool
  (arena-scope (if (or (not= (node/kind value) :map) (not= (node/child-count value) (* 2 (vector-count expected)))) false
    (loop [index 0]
      (if (>= index (node/child-count value)) true
        (let [key (at value index)]
          (if (and (key-member? key expected)
                   (loop [previous 0]
                     (if (>= previous index) true
                       (if (node/same-name? key (at value previous)) false (recur (+ previous 2))))))
            (recur (+ index 2)) false)))))))
(defn- integer=? [value [:ref :gmir.node/value] expected :i64] :bool
  (arena-scope (let [n (identity/integer-i64 value)]
    (and (option-some?-of [:option :i64] n) (= (option-match [:option :i64] n 0 found-value found-value) expected)))))
(defn- bounded-integer? [value [:ref :gmir.node/value] low :i64 high :i64] :bool
  (arena-scope (let [n (identity/integer-i64 value)]
    (and (option-some?-of [:option :i64] n)
         (>= (option-match [:option :i64] n 0 found-value found-value) low) (<= (option-match [:option :i64] n 0 found-value found-value) high)))))
(defn- all-registers? [value [:ref :gmir.node/value]] :bool
  (arena-scope (and (= (node/kind value) :vector)
       (loop [index 0]
         (if (>= index (node/child-count value)) true
           (if (identity/vreg? (at value index)) (recur (+ index 1)) false))))))
(defn- general-registers? [instruction [:ref :gmir.node/value]] :bool
  (arena-scope (let [fields (-> (typed-list-new [:list :keyword])
                  (kw :gmir/dst) (kw :gmir/input) (kw :gmir/left) (kw :gmir/right)
                  (kw :gmir/test) (kw :gmir/base) (kw :gmir/length) (kw :gmir/stored)
                  (kw :gmir/expected) (kw :gmir/second-base) (kw :gmir/second-length)
                  (kw :gmir/count) (kw :gmir/offset) (kw :gmir/size))]
    (loop [index 0]
      (if (>= index (vector-count fields)) true
        (let [value (node/key instruction (typed-list-nth [:list :keyword] fields index))]
          ;; Reference `keep` skips nil, including an explicitly stored nil.
          ;; Repairing that existing admission rule is a separate change.
          (if (or (= (node/kind value) :nil) (identity/vreg? value)) (recur (+ index 1)) false)))))))
(defn- arity-for [table [:list [:ref :gmir.catalog/arity]] name [:ref :gmir.node/value]] [:option :i64]
  (loop [index 0]
    (if (>= index (vector-count table)) (option-none-of [:option :i64])
      (let [entry (typed-list-nth [:list [:ref :gmir.catalog/arity]] table index)]
        (if (is-key? name (catalog/arity-name entry))
          (option-some-of [:option :i64] (catalog/arity-value entry)) (recur (+ index 1)))))))
(defn- operation [table [:list :keyword] value [:ref :gmir.node/value]] [:option :keyword]
  (loop [index 0]
    (if (>= index (vector-count table)) (option-none-of [:option :keyword])
      (let [entry (typed-list-nth [:list :keyword] table index)]
        (if (is-key? value entry)
          (option-some-of [:option :keyword] entry) (recur (+ index 1)))))))
(defn- incoming? [value [:ref :gmir.node/value]] :bool
  (arena-scope (and (same-fields? value (keys2 :gmir/predecessor :gmir/value))
       (identity/label? (node/key value :gmir/predecessor)) (identity/vreg? (node/key value :gmir/value)))))
(defn- incoming-vector? [value [:ref :gmir.node/value]] :bool
  (arena-scope (and (= (node/kind value) :vector)
       (loop [index 0]
         (if (>= index (node/child-count value)) true
           (if (incoming? (at value index)) (recur (+ index 1)) false))))))
(defn- literal? [instruction [:ref :gmir.node/value]] :bool
  (arena-scope (let [encoding (node/key instruction :gmir/rodata-encoding) content (node/key instruction :gmir/content)
        kind (cond (is-key? encoding :utf-16le-nul) :utf-16le-nul
                   (is-key? encoding :guid-mixed-endian) :guid-mixed-endian
                   (is-key? encoding :hex-bytes) :hex-bytes :else :unknown)]
    (and (= (node/kind content) :string)
         (rodata/rodata-content? (rodata/keyword-input kind)
           (rodata/chunks-input (node/text-chunks (node/name-of content))))))))
(defn- window-maximum? [value [:ref :gmir.node/value]] :bool
  (arena-scope (let [n (identity/integer-i64 value)]
    (and (option-some?-of [:option :i64] n)
         (catalog/i64-member? (catalog/kernel-window-maxima) (option-match [:option :i64] n 0 found-value found-value))))))
(defn- runtime-call? [instruction [:ref :gmir.node/value] expected [:option :i64]] :bool
  (arena-scope (let [arguments (node/key instruction :gmir/arguments)]
    (and (identity/vreg? (node/key instruction :gmir/dst))
         (option-some?-of [:option :i64] expected) (= (node/kind arguments) :vector)
         (= (node/child-count arguments) (option-match [:option :i64] expected -1 found-value found-value))
         (all-registers? arguments)))))

(defn- instruction-error [version :i64 instruction [:ref :gmir.node/value]
                          table [:list :keyword]
                          runtimes [:list [:ref :gmir.catalog/arity]] actions [:list [:ref :gmir.catalog/arity]]]
  [:option [:ref :gmir/refusal]]
  (let [found (operation table (node/key instruction :gmir/op))
        op (option-match [:option :keyword] found :unknown found-value found-value)
        keys (catalog/instruction-keys op)
        arguments (node/key instruction :gmir/arguments) maximum (node/key instruction :gmir/maximum)]
    (cond
      (not (and (option-some?-of [:option :keyword] found)
                (catalog/operation-allowed? version op)
                (option-some?-of [:option [:list :keyword]] keys)
                (same-fields? instruction (option-match [:option [:list :keyword]] keys (typed-list-new [:list :keyword]) found-value found-value))))
      (failure :non-canonical-instruction instruction)
      (not (general-registers? instruction)) (failure :invalid-virtual-register instruction)
      (and (catalog/indexed-memory-operation? op) (not (identity/vreg? (node/key instruction :gmir/index))))
      (failure :invalid-virtual-register instruction)
      (and (= op :gmir/return) (not (identity/vreg? (node/key instruction :gmir/value))))
      (failure :invalid-virtual-register instruction)
      (and (or (= op :gmir/call) (= op :gmir/tail-call))
           (not (and (or (= op :gmir/tail-call) (identity/vreg? (node/key instruction :gmir/dst)))
                     (identity/function-id? (node/key instruction :gmir/callee))
                     (= (node/kind arguments) :vector) (<= (node/child-count arguments) (catalog/max-arity))
                     (all-registers? arguments)))) (failure :invalid-call instruction)
      (and (= op :gmir/runtime-call)
           (not (runtime-call? instruction (arity-for runtimes (node/key instruction :gmir/runtime)))))
      (failure :invalid-runtime-call instruction)
      (and (= op :gmir/x86-privileged)
           (not (runtime-call? instruction (arity-for actions (node/key instruction :gmir/action)))))
      (failure :invalid-x86-privileged instruction)
      (and (= op :gmir/capability-call)
           (not (and (identity/vreg? (node/key instruction :gmir/dst)) (= (node/kind arguments) :vector)
                     (= (node/child-count arguments) 1) (identity/vreg? (at arguments 0))
                     (bounded-integer? (node/key instruction :gmir/capability) 0 255)
                     (option-some?-of [:option :i64] (arity-for (catalog/capability-kinds) (node/key instruction :gmir/kind))))))
      (failure :invalid-capability-call instruction)
      (and (= op :gmir/phi) (not (incoming-vector? (node/key instruction :gmir/incomings))))
      (failure :invalid-phi-incomings instruction)
      (and (= op :gmir/constant) (not (identity/i64-value? (node/key instruction :gmir/value))))
      (failure :constant-not-i64 instruction)
      (and (= op :gmir/data-address) (not= (node/kind (node/key instruction :gmir/content)) :string))
      (failure :invalid-data-content instruction)
      (and (= op :gmir/rodata-address) (not (literal? instruction))) (failure :invalid-rodata-content instruction)
      (and (= op :gmir/function-address)
           (not (and (identity/vreg? (node/key instruction :gmir/dst))
                     (identity/function-id? (node/key instruction :gmir/function)))))
      (failure :invalid-function-address instruction)
      (and (= op :gmir/function-address) (not= version 3)) (failure :function-address-needs-a-module instruction)
      (and (= op :gmir/argument) (not (identity/nonnegative-integer? (node/key instruction :gmir/index))))
      (failure :argument-index-invalid instruction)
      (and (catalog/keyword-member? (catalog/kernel-window-operations) op) (not (window-maximum? maximum)))
      (failure :invalid-kernel-memory-maximum instruction)
      (and (catalog/keyword-member? (catalog/slice-operations) op) (not (integer=? maximum (catalog/slice-item-limit))))
      (failure :invalid-kernel-memory-maximum instruction)
      (and (or (= op :gmir/kernel-try-lock-u32) (= op :gmir/kernel-unlock-u32)) (not (integer=? maximum 4096)))
      (failure :invalid-kernel-memory-maximum instruction)
      (and (catalog/keyword-member? (catalog/kernel-atomic-ops) op) (not (integer=? maximum 4096)))
      (failure :invalid-kernel-memory-maximum instruction)
      (and (= op :gmir/kernel-dot-f32) (not (integer=? maximum (catalog/kernel-dot-f32-maximum))))
      (failure :invalid-kernel-memory-maximum instruction)
      (and (catalog/keyword-member? (catalog/kernel-dequant-dot-operations) op)
           (not (integer=? maximum (catalog/kernel-dequant-dot-maximum))))
      (failure :invalid-kernel-memory-maximum instruction)
      (and (or (= op :gmir/label) (= op :gmir/branch-zero) (= op :gmir/jump))
           (not (identity/label? (node/key instruction (if (= op :gmir/label) :gmir/id :gmir/target)))))
      (failure :invalid-label instruction)
      :else (clean))))

(defn- named-or-nil=? [left [:ref :gmir.node/value] right [:ref :gmir.node/value]] :bool
  (arena-scope (or (and (= (node/kind left) :nil) (= (node/kind right) :nil)) (node/same-name? left right))))
(defn- member-name? [values [:ref :gmir.node/value] value [:ref :gmir.node/value]] :bool
  (arena-scope (loop [index 0]
    (if (>= index (node/child-count values)) false
      (if (named-or-nil=? (at values index) value) true (recur (+ index 1)))))))
(defn- add-name [values [:ref :gmir.node/value] value [:ref :gmir.node/value]] [:ref :gmir.node/value]
  (if (member-name? values value) values (node/append values value)))
(defn- same-name-set? [left [:ref :gmir.node/value] right [:ref :gmir.node/value]] :bool
  (arena-scope (and (= (node/child-count left) (node/child-count right))
       (loop [index 0]
         (if (>= index (node/child-count left)) true
           (if (member-name? right (at left index)) (recur (+ index 1)) false))))))
(defn- instruction-is? [instruction [:ref :gmir.node/value] operation :keyword] :bool
  (arena-scope (is-key? (node/key instruction :gmir/op) operation)))
(defn- preceding-label [instructions [:ref :gmir.node/value] index :i64] [:ref :gmir.node/value]
  (loop [cursor (- index 1)]
    (if (< cursor 0) (node/nil-value)
      (let [instruction (at instructions cursor)]
        (cond (instruction-is? instruction :gmir/label) (node/key instruction :gmir/id)
              (instruction-is? instruction :gmir/phi) (recur (- cursor 1))
              :else (node/nil-value))))))
(defn- block-label-before [instructions [:ref :gmir.node/value] index :i64] [:ref :gmir.node/value]
  (loop [cursor (- index 1)]
    (if (< cursor 0) (node/nil-value)
      (let [instruction (at instructions cursor)]
        (if (instruction-is? instruction :gmir/label) (node/key instruction :gmir/id) (recur (- cursor 1)))))))
(defn- incoming-names [incomings [:ref :gmir.node/value]] [:ref :gmir.node/value]
  (loop [index 0 out (node/empty-set)]
    (if (>= index (node/child-count incomings)) out
      (recur (+ index 1) (add-name out (node/key (at incomings index) :gmir/predecessor))))))
(defn- jump-names [instructions [:ref :gmir.node/value] join [:ref :gmir.node/value]] [:ref :gmir.node/value]
  (loop [index 0 out (node/empty-set)]
    (if (>= index (node/child-count instructions)) out
      (let [instruction (at instructions index)]
        ;; Reference keep drops an unlabeled jump's nil predecessor.
        (if (and (instruction-is? instruction :gmir/jump) (node/same-name? join (node/key instruction :gmir/target)))
          (let [name (block-label-before instructions index)]
            (recur (+ index 1) (if (= (node/kind name) :nil) out (add-name out name))))
          (recur (+ index 1) out))))))
(defn- branch-to? [instructions [:ref :gmir.node/value] join [:ref :gmir.node/value]] :bool
  (arena-scope (loop [index 0]
    (if (>= index (node/child-count instructions)) false
      (let [instruction (at instructions index)]
        (if (and (instruction-is? instruction :gmir/branch-zero) (node/same-name? join (node/key instruction :gmir/target)))
          true (recur (+ index 1))))))))
(defn- label-index [instructions [:ref :gmir.node/value] label [:ref :gmir.node/value]] :i64
  (arena-scope (loop [index 0]
    (if (>= index (node/child-count instructions)) -1
      (let [instruction (at instructions index)]
        (if (and (instruction-is? instruction :gmir/label) (node/same-name? label (node/key instruction :gmir/id)))
          index (recur (+ index 1))))))))
(defn- phi-error [instructions [:ref :gmir.node/value] index :i64] [:option [:ref :gmir/refusal]]
  (let [instruction (at instructions index) incomings (node/key instruction :gmir/incomings)
        join (preceding-label instructions index) incoming (incoming-names incomings)
        jumps (jump-names instructions join) join-index (label-index instructions join)]
    (cond
      (= (node/kind join) :nil) (failure :phi-not-at-block-entry instruction)
      (not (and (incoming-vector? incomings) (>= (node/child-count incomings) 2)
                (= (node/child-count incomings) (node/child-count incoming))))
      (failure :invalid-phi-incomings instruction)
      (not (same-name-set? incoming jumps))
      (failure :phi-predecessor-mismatch (-> (node/empty-map) (node/put-key :join join)
        (node/put-key :incoming incoming) (node/put-key :jumps jumps)))
      (branch-to? instructions join) (failure :phi-critical-edge instruction)
      (or (<= join-index 0) (not (instruction-is? (at instructions (- join-index 1)) :gmir/jump)))
      (failure :phi-fallthrough-predecessor instruction)
      :else (clean))))
(defn- phis-error [instructions [:ref :gmir.node/value]] [:option [:ref :gmir/refusal]]
  (loop [index 0]
    (if (>= index (node/child-count instructions)) (clean)
      (let [error (if (instruction-is? (at instructions index) :gmir/phi) (phi-error instructions index) (clean))]
        (if (failed? error) error (recur (+ index 1)))))))
(defn- labels [instructions [:ref :gmir.node/value]] [:ref :gmir.node/value]
  (loop [index 0 out (node/empty-list)]
    (if (>= index (node/child-count instructions)) out
      (let [instruction (at instructions index)]
        (recur (+ index 1) (if (instruction-is? instruction :gmir/label)
                             (node/append out (node/key instruction :gmir/id)) out))))))
(defn- unique-names? [values [:ref :gmir.node/value]] :bool
  (arena-scope (loop [index 0 seen (node/empty-set)]
    (if (>= index (node/child-count values)) true
      (let [value (at values index)]
        (if (member-name? seen value) false (recur (+ index 1) (node/append seen value))))))))
(defn- targets-error [instructions [:ref :gmir.node/value] declared [:ref :gmir.node/value]] [:option [:ref :gmir/refusal]]
  (loop [index 0]
    (if (>= index (node/child-count instructions)) (clean)
      (let [target (node/key (at instructions index) :gmir/target)]
        (if (and (not= (node/kind target) :nil) (not (member-name? declared target)))
          (failure :unresolved-target (node/put-key (node/empty-map) :target target)) (recur (+ index 1)))))))
(defn- labels-error [version :i64 instructions [:ref :gmir.node/value]] [:option [:ref :gmir/refusal]]
  (let [declared (labels instructions)]
    (if (not (unique-names? declared)) (failure :duplicate-label (node/put-key (node/empty-map) :labels declared))
      (let [targets (targets-error instructions declared)]
        (if (failed? targets) targets (if (or (= version 2) (= version 3)) (phis-error instructions) (clean)))))))
(defn- instructions-error [version :i64 instructions [:ref :gmir.node/value]
                           table [:list :keyword]
                           runtimes [:list [:ref :gmir.catalog/arity]] actions [:list [:ref :gmir.catalog/arity]]]
  [:option [:ref :gmir/refusal]]
  (if (not= (node/kind instructions) :vector) (failure :non-canonical-instructions instructions)
    (loop [index 0]
      (if (>= index (node/child-count instructions)) (labels-error version instructions)
        (let [error (instruction-error version (at instructions index) table runtimes actions)]
          (if (failed? error) error (recur (+ index 1))))))))

(defn- function-names [functions [:ref :gmir.node/value]] [:ref :gmir.node/value]
  (loop [index 0 out (node/empty-vector)]
    (if (>= index (node/child-count functions)) out
      (recur (+ index 1) (node/append out (node/key (at functions index) :gmir/name))))))
(defn- all-function-names? [names [:ref :gmir.node/value]] :bool
  (arena-scope (loop [index 0]
    (if (>= index (node/child-count names)) true
      (if (identity/function-id? (at names index)) (recur (+ index 1)) false)))))
(defn- signature-index [functions [:ref :gmir.node/value] name [:ref :gmir.node/value]] :i64
  (arena-scope (loop [index 0]
    (if (>= index (node/child-count functions)) -1
      (if (node/same-name? name (node/key (at functions index) :gmir/name)) index (recur (+ index 1)))))))
(defn- symbol-order [left [:ref :gmir.node/value] right [:ref :gmir.node/value]] [:option :i64]
  (cond
    (and (not (node/has-namespace? left)) (node/has-namespace? right)) (option-some-of [:option :i64] -1)
    (and (node/has-namespace? left) (not (node/has-namespace? right))) (option-some-of [:option :i64] 1)
    (node/has-namespace? left)
    (let [ns-order (node/text-compare-utf16
                     (option-match [:option [:ref :gmir.node/text]] (node/namespace-of left) (node/empty-text) found-value found-value)
                     (option-match [:option [:ref :gmir.node/text]] (node/namespace-of right) (node/empty-text) found-value found-value))]
      (if (and (option-some?-of [:option :i64] ns-order) (= (option-match [:option :i64] ns-order 0 found-value found-value) 0))
        (node/text-compare-utf16 (node/name-of left) (node/name-of right)) ns-order))
    :else (node/text-compare-utf16 (node/name-of left) (node/name-of right))))
(defn- insert-name [sorted [:ref :gmir.node/value] name [:ref :gmir.node/value]] [:option [:ref :gmir.node/value]]
  (loop [index 0 placed false out (node/empty-vector)]
    (if (>= index (node/child-count sorted))
      (option-some-of [:option [:ref :gmir.node/value]] (if placed out (node/append out name)))
      (let [item (at sorted index)]
        (if placed (recur (+ index 1) true (node/append out item))
          (let [order (symbol-order name item)]
            (if (not (option-some?-of [:option :i64] order)) (option-none-of [:option [:ref :gmir.node/value]])
              (if (<= (option-match [:option :i64] order 0 found-value found-value) 0)
                (recur (+ index 1) true (node/append (node/append out name) item))
                (recur (+ index 1) false (node/append out item))))))))))
(defn- sorted-names [names [:ref :gmir.node/value]] [:option [:ref :gmir.node/value]]
  (loop [index 0 out (node/empty-vector)]
    (if (>= index (node/child-count names)) (option-some-of [:option [:ref :gmir.node/value]] out)
      (let [next (insert-name out (at names index))]
        (if (not (option-some?-of [:option [:ref :gmir.node/value]] next)) next
          (recur (+ index 1) (option-match [:option [:ref :gmir.node/value]] next (node/empty-vector) found-value found-value)))))))
(defn- argument-indices [instructions [:ref :gmir.node/value]] [:ref :gmir.node/value]
  (loop [index 0 out (node/empty-vector)]
    (if (>= index (node/child-count instructions)) out
      (let [instruction (at instructions index)]
        (recur (+ index 1) (if (instruction-is? instruction :gmir/argument)
                             (node/append out (node/key instruction :gmir/index)) out))))))
(defn- function-arguments-error [function [:ref :gmir.node/value] arity :i64 instructions [:ref :gmir.node/value]]
  [:option [:ref :gmir/refusal]]
  (let [indices (argument-indices instructions)]
    (loop [index 0 seen (typed-list-new [:list :i64])]
      (if (>= index (node/child-count indices)) (clean)
        (let [value (identity/integer-i64 (at indices index)) n (option-match [:option :i64] value -1 found-value found-value)]
          (if (or (not (option-some?-of [:option :i64] value)) (< n 0) (>= n arity) (catalog/i64-member? seen n))
            (failure :invalid-function-arguments (-> (node/empty-map)
              (node/put-key :function (node/key function :gmir/name))
              (node/put-key :arity (node/key function :gmir/arity)) (node/put-key :indices indices)))
            (recur (+ index 1) (typed-list-conj [:list :i64] seen n))))))))
(defn- addresses-error [function [:ref :gmir.node/value] instructions [:ref :gmir.node/value]
                       functions [:ref :gmir.node/value] names [:ref :gmir.node/value]]
  [:option [:ref :gmir/refusal]]
  (loop [index 0]
    (if (>= index (node/child-count instructions)) (clean)
      (let [instruction (at instructions index)]
        (if (and (instruction-is? instruction :gmir/function-address)
                 (< (signature-index functions (node/key instruction :gmir/function)) 0))
          (let [declared (sorted-names names)]
            (if (not (option-some?-of [:option [:ref :gmir.node/value]] declared))
              (failure :invalid-function-names names)
              (failure :unresolved-function-address (-> (node/empty-map)
                (node/put-key :function (node/key function :gmir/name)) (node/put-key :instruction instruction)
                (node/put-key :declared (option-match [:option [:ref :gmir.node/value]] declared (node/empty-vector) found-value found-value))))))
          (recur (+ index 1)))))))
(defn- calls-error [function [:ref :gmir.node/value] instructions [:ref :gmir.node/value]
                   functions [:ref :gmir.node/value]] [:option [:ref :gmir/refusal]]
  (loop [index 0]
    (if (>= index (node/child-count instructions)) (clean)
      (let [call (at instructions index)]
        (if (or (instruction-is? call :gmir/call) (instruction-is? call :gmir/tail-call))
          (let [callee (signature-index functions (node/key call :gmir/callee))]
            (if (< callee 0) (failure :unresolved-callee call)
              (let [expected (node/key (at functions callee) :gmir/arity)]
                (if (not (integer=? expected (node/child-count (node/key call :gmir/arguments))))
                  (failure :call-arity-mismatch (-> (node/empty-map)
                    (node/put-key :function (node/key function :gmir/name)) (node/put-key :call call)
                    (node/put-key :expected expected))) (recur (+ index 1))))))
          (recur (+ index 1)))))))
(defn- function-error [function [:ref :gmir.node/value] functions [:ref :gmir.node/value] names [:ref :gmir.node/value]
                       table [:list :keyword] runtimes [:list [:ref :gmir.catalog/arity]]
                       actions [:list [:ref :gmir.catalog/arity]]] [:option [:ref :gmir/refusal]]
  (if (not (and (same-fields? function (keys3 :gmir/name :gmir/arity :gmir/instructions))
                (identity/function-id? (node/key function :gmir/name))
                (bounded-integer? (node/key function :gmir/arity) 0 (catalog/max-arity))))
    (failure :non-canonical-function function)
    (let [instructions (node/key function :gmir/instructions)
          arity (option-match [:option :i64] (identity/integer-i64 (node/key function :gmir/arity)) -1 found-value found-value)
          code (instructions-error 3 instructions table runtimes actions)]
      (if (failed? code) code
        (let [arguments (function-arguments-error function arity instructions)]
          (if (failed? arguments) arguments
            (let [addresses (addresses-error function instructions functions names)]
              (if (failed? addresses) addresses (calls-error function instructions functions)))))))))
(defn- module-error [program [:ref :gmir.node/value] table [:list :keyword]
                     runtimes [:list [:ref :gmir.catalog/arity]] actions [:list [:ref :gmir.catalog/arity]]]
  [:option [:ref :gmir/refusal]]
  (let [entry (node/key program :gmir/entry) functions (node/key program :gmir/functions)]
    (if (not (and (same-fields? program (keys3 :gmir/version :gmir/entry :gmir/functions))
                  (identity/function-id? entry) (= (node/kind functions) :vector) (> (node/child-count functions) 0)))
      (failure :non-canonical-module program)
      (let [names (function-names functions)]
        (cond
          (not (and (all-function-names? names) (unique-names? names))) (failure :invalid-function-names names)
          (< (signature-index functions entry) 0) (failure :missing-entry-function (node/put-key (node/empty-map) :entry entry))
          :else
          (loop [index 0]
            (if (>= index (node/child-count functions)) (clean)
              (let [error (function-error (at functions index) functions names table runtimes actions)]
                (if (failed? error) error (recur (+ index 1)))))))))))

;; The nominal input is an explicit migration API. Atom tags alone must not
;; smuggle extra fields, malformed text or an invalid shape through a semantic
;; success. This pass runs after reference semantic checks, keeping their
;; rejection order for valid reader values; malformed nominal representations
;; get their own full-data refusal, not a success/default conversion.
(defn- atom-shape? [value [:ref :gmir.node/value]] :bool
  (arena-scope (and (not (node/has-namespace? value)) (= (vector-count (node/pages value)) 0))))
(defn- empty-name? [value [:ref :gmir.node/value]] :bool (arena-scope (= (node/text-count (node/name-of value)) 0)))
(defn- representation-shallow? [value [:ref :gmir.node/value]] :bool
  (arena-scope (let [tag (node/kind value) n (node/number value)]
    (case tag
      :nil (and (atom-shape? value) (= n 0) (empty-name? value))
      :bool (and (atom-shape? value) (or (= n 0) (= n 1)) (empty-name? value))
      :i64 (and (atom-shape? value) (empty-name? value))
      :integer (and (atom-shape? value) (= n 0) (identity/integer-form? value))
      :f64 (and (atom-shape? value) (empty-name? value))
      :bytes (and (atom-shape? value) (= n 0))
      :string (and (atom-shape? value) (= n 0) (node/text-valid? (node/name-of value)))
      :keyword (and (= n 0) (= (vector-count (node/pages value)) 0) (node/text-valid? (node/name-of value))
                    (or (not (node/has-namespace? value))
                        (node/text-valid? (option-match [:option [:ref :gmir.node/text]] (node/namespace-of value) (node/empty-text) found-value found-value))))
      :symbol (and (= n 0) (= (vector-count (node/pages value)) 0) (node/text-valid? (node/name-of value))
                   (or (not (node/has-namespace? value))
                       (node/text-valid? (option-match [:option [:ref :gmir.node/text]] (node/namespace-of value) (node/empty-text) found-value found-value))))
      :vector (and (= n 0) (not (node/has-namespace? value)) (empty-name? value))
      :list (and (= n 0) (not (node/has-namespace? value)) (empty-name? value))
      :set (and (= n 0) (not (node/has-namespace? value)) (empty-name? value))
      :map (and (= n 0) (not (node/has-namespace? value)) (empty-name? value) (= (bit-and (node/child-count value) 1) 0))
      false))))
(defn- representation-error [value [:ref :gmir.node/value]] [:option [:ref :gmir/refusal]]
  (if (not (representation-shallow? value)) (failure :non-canonical-value value)
    (loop [index 0]
      (if (>= index (node/child-count value)) (clean)
        (let [error (representation-error (at value index))]
          (if (failed? error) error (recur (+ index 1))))))))
(defn validate! [program [:ref :gmir.node/value]] [:result [:ref :gmir.node/value] [:ref :gmir/refusal]]
  (let [version (identity/integer-i64 (node/key program :gmir/version))
        number (option-match [:option :i64] version 0 found-value found-value)
        table (catalog/instruction-operations) runtimes (catalog/runtime-operation-arities)
        actions (catalog/x86-privileged-action-arities)
        error (cond
          (not (and (= (node/kind program) :map) (option-some?-of [:option :i64] version)
                    (catalog/i64-member? (catalog/supported-versions) number))) (failure :non-canonical-program program)
          (= number 3) (module-error program table runtimes actions)
          (not (same-fields? program (keys2 :gmir/version :gmir/instructions))) (failure :non-canonical-program program)
          :else (instructions-error number (node/key program :gmir/instructions) table runtimes actions))
        complete (if (failed? error) error (representation-error program))]
    (if (failed? complete)
      (result-err-of [:result [:ref :gmir.node/value] [:ref :gmir/refusal]]
        (option-match [:option [:ref :gmir/refusal]] complete (outcome/refusal :non-canonical-program program) found-value found-value))
      (result-ok-of [:result [:ref :gmir.node/value] [:ref :gmir/refusal]] program))))
