;; Owning canonical source entry. Typed migration APIs require explicit
;; caller/refusal/CID adapters. Compilation/execution/self-rebuild are open.
(ns kotoba.gmir
  {:kotoba/export [max-arity capability-kinds function-id? i64-value? instruction-keysets kernel-atomic-ops kernel-dequant-dot-block-limit kernel-dequant-dot-formats kernel-dequant-dot-maximum kernel-dequant-dot-operations kernel-dot-f32-element-limit kernel-dot-f32-maximum kernel-window-maxima kernel-window-operations label? rodata-alignment rodata-bytes rodata-content? rodata-encodings runtime-operation-arities slice-item-limit slice-operations supported-versions validate! version vreg vreg? x86-privileged-action-arities]}
  (:require [kotoba.gmir.catalog :as catalog] [kotoba.gmir.identity :as identity]
            [kotoba.gmir.rodata :as rodata] [kotoba.gmir.validation :as validation]))

(defn max-arity [] :i64 (catalog/max-arity))
(defn capability-kinds [] [:list [:ref :gmir.catalog/arity]] (catalog/capability-kinds))
(defn function-id? [value [:ref :gmir.node/value]] :bool (identity/function-id? value))
(defn i64-value? [value [:ref :gmir.node/value]] :bool (identity/i64-value? value))
(defn instruction-keysets [] [:list [:ref :gmir.catalog/keyset]] (catalog/instruction-keysets))
(defn kernel-atomic-ops [] [:list :keyword] (catalog/kernel-atomic-ops))
(defn kernel-dequant-dot-block-limit [operation :keyword] [:option :i64]
  (catalog/kernel-dequant-dot-block-limit operation))
(defn kernel-dequant-dot-formats [] [:list [:ref :gmir.catalog/format]] (catalog/kernel-dequant-dot-formats))
(defn kernel-dequant-dot-maximum [] :i64 (catalog/kernel-dequant-dot-maximum))
(defn kernel-dequant-dot-operations [] [:list :keyword] (catalog/kernel-dequant-dot-operations))
(defn kernel-dot-f32-element-limit [] :i64 (catalog/kernel-dot-f32-element-limit))
(defn kernel-dot-f32-maximum [] :i64 (catalog/kernel-dot-f32-maximum))
(defn kernel-window-maxima [] [:list :i64] (catalog/kernel-window-maxima))
(defn kernel-window-operations [] [:list :keyword] (catalog/kernel-window-operations))
(defn label? [value [:ref :gmir.node/value]] :bool (identity/label? value))
(defn rodata-alignment [] :i64 (rodata/rodata-alignment))
(defn rodata-bytes [encoding [:ref :gmir.rodata/input] content [:ref :gmir.rodata/input]]
  [:option [:ref :gmir.rodata/decoded]] (rodata/rodata-bytes encoding content))
(defn rodata-content? [encoding [:ref :gmir.rodata/input] content [:ref :gmir.rodata/input]] :bool
  (rodata/rodata-content? encoding content))
(defn rodata-encodings [] :document (rodata/rodata-encodings))
(defn runtime-operation-arities [] [:list [:ref :gmir.catalog/arity]] (catalog/runtime-operation-arities))
(defn slice-item-limit [] :i64 (catalog/slice-item-limit))
(defn slice-operations [] [:list :keyword] (catalog/slice-operations))
(defn supported-versions [] [:list :i64] (catalog/supported-versions))
(defn validate! [program [:ref :gmir.node/value]] [:result [:ref :gmir.node/value] [:ref :gmir/refusal]]
  (validation/validate! program))
(defn version [] :i64 (catalog/version))
(defn vreg [index [:ref :gmir.node/value]] [:result [:ref :gmir.node/value] [:ref :gmir/refusal]] (identity/vreg index))
(defn vreg? [value [:ref :gmir.node/value]] :bool (identity/vreg? value))
(defn x86-privileged-action-arities [] [:list [:ref :gmir.catalog/arity]] (catalog/x86-privileged-action-arities))
