#!/usr/bin/env kbb
;; loop-okugai-survey — 1 サイクル分の survey を実行して shard と evidence を書く。
;;
;;   kbb --backend sci --classpath "src:../okugai/src:../denchu/src:../org-openstreetmap-overpass/src:../com-mapillary-graph-api/src" \
;;       bin/survey.cljk --area-id chiyoda --jurisdiction JP-13 \
;;       --bbox 35.6790,139.7620,35.6830,139.7680 --media all --sources osm --out data
;;
;; --media all              観測タグを持つ全媒体（既定）
;; --media poles            電柱のみ
;; --media billboard,board  媒体を名指し
;; --sources osm|mapillary|both
(ns survey
  (:require ["fs" :as fs]
            ["path" :as path]
            [kotoba.lang.text :as str]
            [com-mapillary-graph-api.fetch :as mly-fetch]
            [denchu.datoms :as denchu-datoms]
            [denchu.enrich :as denchu-enrich]
            [loop-okugai-survey.core :as survey]
            [okugai.datoms :as okugai-datoms]
            [okugai.medium :as medium]
            [okugai.route :as route]
            [org-openstreetmap-overpass.fetch :as osm-fetch]))

(defn- args->map [argv]
  (into {} (for [[k v] (partition 2 argv) :when (str/starts-with? k "--")]
             [(keyword (subs k 2)) v])))

(defn- parse-bbox
  "--bbox south,west,north,east （地図から読む順）"
  [s]
  (let [[south west north east] (map js/parseFloat (str/split s #","))]
    (when (some js/isNaN [south west north east])
      (throw (ex-info "bbox must be south,west,north,east" {:given s})))
    {:south south :west west :north north :east east}))

(defn- ->mly-bbox [{:keys [south west north east]}]
  {:west west :south south :east east :north north})

(defn- parse-media [s]
  (case (or s "all")
    "all" survey/default-media
    "poles" [:utility-pole]
    (let [ids (mapv keyword (str/split s #","))
          unknown (remove medium/medium? ids)]
      (when (seq unknown)
        (throw (ex-info "unknown medium" {:unknown unknown
                                          :known (vec (sort (map name (keys medium/media))))})))
      ids)))

(defn- now-iso [] (.toISOString (js/Date.)))

(defn- write-edn! [file data header]
  (fs/mkdirSync (path/dirname file) #js {:recursive true})
  (fs/writeFileSync file (str header "\n" (pr-str data) "\n"))
  (println "wrote" file))

(defn- collect
  "指定 source から観測を集める Promise。失敗した source は握り潰さず `:errors` に
  残す —— 片方が落ちたのに全部揃ったように見えるのを防ぐ。"
  [bbox sources media]
  (let [tasks
        (cond-> []
          (contains? sources :osm)
          (conj (-> (osm-fetch/fetch-features
                     bbox {:selectors (medium/osm-selectors media)
                           :ways? true
                           :parse-opts {:classify medium/osm-tags->medium
                                        :attr :obs/medium}})
                    (.then (fn [r] {:source :osm :result r}))
                    (.catch (fn [e] {:source :osm :error (str e)}))))

          (contains? sources :mapillary)
          (conj (-> (mly-fetch/fetch-poles (->mly-bbox bbox))
                    (.then (fn [r]
                             ;; Mapillary クライアントは :obs/kind で返すので媒体面に写す
                             {:source :mapillary
                              :result (update r :observations
                                              (fn [os]
                                                (vec (keep (fn [o]
                                                             (when-let [m (medium/mapillary-object->medium
                                                                           (get-in o [:obs/tags "object_value"]))]
                                                               (-> o (dissoc :obs/kind) (assoc :obs/medium m))))
                                                           os))))}))
                    (.catch (fn [e] {:source :mapillary :error (str e)})))))]
    (-> (js/Promise.all (clj->js tasks))
        (.then (fn [rs]
                 (let [rs (js->clj rs)
                       ok (filter :result rs)
                       bad (filter :error rs)]
                   {:observations (vec (mapcat (comp :observations :result) ok))
                    :per-source (into {} (map (fn [r] [(:source r)
                                                       (dissoc (:result r) :observations)]) ok))
                    :errors (vec bad)}))))))

;; ── 実行 ────────────────────────────────────────────────────────────

(defn run! [argv]
  (let [{:keys [area-id jurisdiction bbox sources media out radius-m min-confidence note]}
        (args->map argv)]
    (when (or (nil? area-id) (nil? bbox) (nil? jurisdiction))
      (println "usage: survey.cljs --area-id <id> --jurisdiction <ISO-3166-2> --bbox s,w,n,e [--media all|poles|<ids>] [--sources osm|mapillary|both] [--out dir]")
      (js/process.exit 2))
    (let [bb (parse-bbox bbox)
          med (parse-media media)
          srcs (case (or sources "osm")
                 "osm" #{:osm} "mapillary" #{:mapillary} "both" #{:osm :mapillary}
                 (throw (ex-info "unknown --sources" {:given sources})))
          outdir (or out "data")
          a (survey/area {:id area-id :bbox bb :jurisdiction jurisdiction :note note})]
      (-> (collect bb srcs med)
          (.then
           (fn [{:keys [observations per-source errors]}]
             (when (seq errors) (println "WARNING: source(s) failed —" (pr-str errors)))
             (let [generated-at (now-iso)
                   enrich (comp denchu-enrich/site route/stamp)
                   {:keys [shard evidence measurements decision all-sources-failed]}
                   (survey/run {:areas [a] :observations observations :sources srcs
                                :source-errors errors
                                :media-requested med
                                :generated-at generated-at
                                :enrich enrich
                                :operator-resolver denchu-enrich/operator-resolver
                                :radius-m (if radius-m (js/parseFloat radius-m) 8.0)
                                :min-confidence (if min-confidence
                                                  (js/parseFloat min-confidence)
                                                  survey/default-min-confidence)})
                   evidence (assoc evidence :survey/per-source per-source
                                   :survey/source-errors errors)]
               (when all-sources-failed
                 (println "ERROR: 要求した source が全部失敗した。"
                          "0 件の shard を書くと『調べて無かった』と読まれるので書かない。"
                          "証跡だけ残す。")
                 (write-edn! (path/join outdir (str "survey-evidence-" area-id ".edn"))
                             evidence
                             ";; survey は失敗した。inventory shard は書いていない。")
                 (js/process.exit 1))
               (write-edn! (path/join outdir (str "okugai-inventory-" area-id ".datoms.edn"))
                           shard
                           (str ";; 生成物 — 手で編集しない。再生成: loop-okugai-survey bin/survey.cljk\n"
                                ";; area=" area-id " jurisdiction=" jurisdiction
                                " media=" (str/join "," (map name med))
                                " sources=" (str/join "," (map name (sort srcs)))
                                " generated-at=" generated-at "\n"
                                ";; ⚠ この shard は上記 area の中で、上記の媒体だけを見ている。"))
               (write-edn! (path/join outdir (str "survey-evidence-" area-id ".edn"))
                           evidence
                           ";; survey の証跡 — 入力・測定・閾値・落としたものを保持する。")
               ;; 静的カタログ（媒体・規制・電柱の代理店/掲出面）。area shard に
               ;; 混ぜると area 数だけ重複するので 1 本に固定する。
               (write-edn! (path/join outdir "okugai-catalog.datoms.edn")
                           (vec (concat (okugai-datoms/catalog-shard)
                                        (denchu-datoms/catalog-shard)))
                           (str ";; 生成物 — 手で編集しない。媒体・規制・電柱代理店/掲出面の静的カタログ。\n"
                                ";; 正本は okugai.medium / okugai.facts / denchu.media / denchu.slot。"))
               (println "observations:" (:observations measurements)
                        "sites:" (:sites measurements)
                        "by-medium:" (pr-str (:sites-by-medium measurements))
                        "accepted:" (count (:accepted decision))
                        "unknown-operator:" (:sites-unknown-operator measurements)
                        "route:" (pr-str (:sites-by-route-status measurements))))))
          (.catch (fn [e]
                    (println "survey failed:" (str e))
                    (js/process.exit 1)))))))

(run! *command-line-args*)
