;; ClojureScript → Node.js CLI build. Reuses deps.edn (with the :dev local
;; checkout of langchain-clj and the :cljs shadow toolchain alias).
{:deps  {:aliases [:dev :cljs]}
 :builds
 {:cli {:target     :node-script
        :main       auth.core/main
        :output-to  "target/authenticator.js"
        :compiler-options {:optimizations :simple}}}}
