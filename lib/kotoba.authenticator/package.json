{
  "name": "authenticator-clj",
  "version": "0.1.0",
  "description": "Authy-like TOTP/HOTP one-time-password manager CLI — ClojureScript + Datomic-API vault",
  "private": true,
  "bin": {
    "authenticator-clj": "bin/authenticator-clj"
  },
  "scripts": {
    "build": "amu compile --target wasm32-browser cli",
    "watch": "amu compile --target wasm32-browser cli",
    "start": "node target/authenticator.js",
    "test:webcrypto": "kbb --backend sci --classpath src test/webcrypto_parity.cljk"
  },
  "devDependencies": {
    "shadow-cljs": "^2.28.20"
  }
}
