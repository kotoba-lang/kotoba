{:paths ["src"]
 ;; The OTP vault is a Datomic-API store: langchain ships a pure-.cljc,
 ;; dependency-free, Datomic-shaped EAV/Datalog engine (langchain.db) that
 ;; runs unchanged on JVM Clojure, ClojureScript (Node), SCI and WASM. The CLI
 ;; itself targets ClojureScript/Node (see shadow-cljs.edn); every namespace is
 ;; .cljc so the same logic is unit-tested on the JVM test-runner.
 ;; Pinned at schema-from-tx-data, which auth.db uses to state the vault
 ;; schema once, in the Datomic installation tx-data dialect the rest of this
 ;; workspace's datom corpora are declared in.
 :deps {
        io.github.kotoba-lang/edn {:local/root "../kotoba.edn"}
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}
        io.github.kotoba-lang/langchain {:local/root "../kotoba.langchain"}}
 :aliases
 {;; local checkout for workspace development (orgs/kotoba-lang/*)
  :dev {:override-deps {io.github.kotoba-lang/langchain
                        {:local/root "../langchain"}}}
  :test {:extra-paths ["test"]}}}
