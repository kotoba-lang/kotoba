(ns hl7-v2.mllp
  "MLLP — Minimal Lower Layer Protocol, the de facto TCP framing almost
  every HL7 v2 interface engine actually uses (HL7's own MLLP block
  specification, and the near-universal Health Level Seven MLLP release
  2 profile): one ER7 message per TCP segmentation-independent frame,
  `0x0B` <message bytes> `0x1C` `0x0D`. There is no length prefix — the
  end block is how a reader who has to deal with TCP's own segmentation
  finds the boundary, which is also why `unwrap` has to scan for it
  rather than trust a byte count.

  Two representations are provided: string-level (`wrap`/`unwrap`), which
  is what most callers want since ER7 text is already a string once
  `parser/encode-message` has run; and byte-vector-level
  (`wrap-bytes`/`unwrap-bytes`, ints 0..255, matching `org-modbus`'s
  convention), for callers working with an actual socket buffer. The byte
  helpers here treat each character as one byte (Latin-1/ASCII code
  point) — correct for the 7-bit ASCII ER7 defaults to, and documented as
  a simplification for the rarer case (MSH-18 declaring UTF-8) where a
  character can be more than one byte.

  `code-at` exists because `(int (nth s i))` — the obvious way to read a
  character's numeric code point — gives the code point on the JVM and,
  under ClojureScript, either 0 or a broken coercion: a cljs string's
  `nth` returns a one-character *string*, not a char, and cljs's `int`
  does not parse a string. This is the same trap `org-modbus`'s README
  documents for `(map int \"123456789\")`; `code-at` is this library's
  fix rather than its own instance of it.")

(def start-block 0x0B)
(def end-block-1 0x1C)
(def end-block-2 0x0D)

(defn code-at
  "The numeric code point of `s`'s character at index `i` — portable
  across Clojure and ClojureScript. See namespace docstring."
  [s i]
  #?(:clj (int (nth s i))
     :cljs (.charCodeAt s i)))

;; ---------------------------------------------------------------------
;; String level

(defn wrap
  "Frame `message-text` (already-encoded ER7, `\\r`-terminated segments)
  for the wire: start block, the message, end block."
  [message-text]
  (str (char start-block) message-text (char end-block-1) (char end-block-2)))

(defn unwrap
  "Strip MLLP framing from `framed-text`, returning `{:message text}` or
  `[:error <reason>]`:
  `:hl7/mllp-missing-start-block`, `:hl7/mllp-missing-end-block`,
  `:hl7/mllp-frame-too-short`."
  [framed-text]
  (let [n (count framed-text)]
    (cond
      (< n 3) [:error :hl7/mllp-frame-too-short]
      (not= (code-at framed-text 0) start-block) [:error :hl7/mllp-missing-start-block]
      (not (and (= (code-at framed-text (- n 2)) end-block-1)
                (= (code-at framed-text (- n 1)) end-block-2)))
      [:error :hl7/mllp-missing-end-block]
      :else {:message (subs framed-text 1 (- n 2))})))

;; ---------------------------------------------------------------------
;; Byte-vector level (ints 0..255)

(defn str->bytes
  "`s` as a sequence of ints 0..255, one per character/code point."
  [s]
  (mapv #(code-at s %) (range (count s))))

(defn bytes->str
  "Inverse of `str->bytes`."
  [bs]
  (apply str (map char bs)))

(defn wrap-bytes
  [message-bytes]
  (vec (concat [start-block] message-bytes [end-block-1 end-block-2])))

(defn unwrap-bytes
  "Byte-vector counterpart of `unwrap`, same error reasons."
  [bs]
  (let [n (count bs)]
    (cond
      (< n 3) [:error :hl7/mllp-frame-too-short]
      (not= (nth bs 0) start-block) [:error :hl7/mllp-missing-start-block]
      (not (and (= (nth bs (- n 2)) end-block-1)
                (= (nth bs (- n 1)) end-block-2)))
      [:error :hl7/mllp-missing-end-block]
      :else {:message (subvec (vec bs) 1 (- n 2))})))
