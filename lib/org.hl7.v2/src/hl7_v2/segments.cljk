(ns hl7-v2.segments
  "Field-number -> name maps and accessors for the segments almost every
  HL7 v2 message is built from: MSH (message header), EVN (event type),
  PID (patient identification), NK1 (next of kin), PV1 (patient visit),
  OBR (observation request) and OBX (observation/result). Field numbers
  and names are from the HL7 v2.x standard segment definitions; this is
  structural coverage (every documented field number has a name and a
  slot) rather than semantic validation of what each field is allowed to
  contain, which is a table this codec deliberately does not own — see
  the README's 'what this is not'.

  Z-segments (site-defined, `Z..` by convention — v2.x §2.8.1) parse and
  encode with the same generic `parser/parse-segment` every other segment
  uses; they just have no entry in these name maps, because a Z-segment's
  field meanings are locally defined and this library cannot know them."
  (:require [hl7-v2.parser :as parser]))

(def msh-fields
  {1 :field-separator 2 :encoding-characters 3 :sending-application
   4 :sending-facility 5 :receiving-application 6 :receiving-facility
   7 :date-time-of-message 8 :security 9 :message-type
   10 :message-control-id 11 :processing-id 12 :version-id
   13 :sequence-number 14 :continuation-pointer
   15 :accept-acknowledgment-type 16 :application-acknowledgment-type
   17 :country-code 18 :character-set 19 :principal-language-of-message})

(def evn-fields
  {1 :event-type-code 2 :recorded-date-time 3 :date-time-planned-event
   4 :event-reason-code 5 :operator-id 6 :event-occurred
   7 :event-facility})

(def pid-fields
  {1 :set-id 2 :patient-id 3 :patient-identifier-list 4 :alternate-patient-id
   5 :patient-name 6 :mothers-maiden-name 7 :date-time-of-birth
   8 :administrative-sex 9 :patient-alias 10 :race 11 :patient-address
   12 :county-code 13 :phone-home 14 :phone-business 15 :primary-language
   16 :marital-status 17 :religion 18 :patient-account-number
   19 :ssn-number-patient 20 :drivers-license-number 21 :mothers-identifier
   22 :ethnic-group 23 :birth-place 24 :multiple-birth-indicator
   25 :birth-order 26 :citizenship 27 :veterans-military-status
   28 :nationality 29 :patient-death-date-time 30 :patient-death-indicator})

(def nk1-fields
  {1 :set-id 2 :name 3 :relationship 4 :address 5 :phone-number
   6 :business-phone-number 7 :contact-role 8 :start-date 9 :end-date
   10 :next-of-kin-job-title 11 :next-of-kin-job-code-class
   12 :next-of-kin-employee-number 13 :organization-name 14 :marital-status
   15 :administrative-sex 16 :date-time-of-birth})

(def pv1-fields
  {1 :set-id 2 :patient-class 3 :assigned-patient-location
   4 :admission-type 5 :preadmit-number 6 :prior-patient-location
   7 :attending-doctor 8 :referring-doctor 9 :consulting-doctor
   10 :hospital-service 11 :temporary-location 12 :preadmit-test-indicator
   13 :readmission-indicator 14 :admit-source 15 :ambulatory-status
   16 :vip-indicator 17 :admitting-doctor 18 :patient-type
   19 :visit-number 20 :financial-class 21 :charge-price-indicator
   22 :courtesy-code 23 :credit-rating 24 :contract-code
   36 :discharge-disposition 44 :admit-date-time 45 :discharge-date-time})

(def obr-fields
  {1 :set-id 2 :placer-order-number 3 :filler-order-number
   4 :universal-service-identifier 5 :priority 6 :requested-date-time
   7 :observation-date-time 8 :observation-end-date-time
   9 :collection-volume 10 :collector-identifier 15 :specimen-source
   16 :ordering-provider 22 :results-rpt-status-chng-date-time
   25 :result-status})

(def obx-fields
  {1 :set-id 2 :value-type 3 :observation-identifier 4 :observation-sub-id
   5 :observation-value 6 :units 7 :references-range 8 :abnormal-flags
   9 :probability 10 :nature-of-abnormal-test 11 :observation-result-status
   14 :date-time-of-observation 15 :producers-id 16 :responsible-observer})

(def field-name-maps
  {"MSH" msh-fields "EVN" evn-fields "PID" pid-fields "NK1" nk1-fields
   "PV1" pv1-fields "OBR" obr-fields "OBX" obx-fields})

(defn field-name
  "The documented name for `field-num` of segment `seg-id`, or `nil` for
  a Z-segment or an unmapped field number."
  [seg-id field-num]
  (get (get field-name-maps seg-id) field-num))

(defn segments-by-id
  "All parsed segments with the given three-letter ID, in message order —
  a message can carry many OBX or NK1 segments."
  [parsed-message seg-id]
  (filterv #(= seg-id (:id %)) (:segments parsed-message)))

(defn segment
  "The first segment with `seg-id`, or `nil`."
  [parsed-message seg-id]
  (first (segments-by-id parsed-message seg-id)))

(defn get-field
  "The raw field value (string or nested structure — see `hl7-v2.parser`)
  of field `field-num` in the `occurrence`-th (0-based) segment with
  `seg-id`. `nil` if that segment or field is absent."
  ([parsed-message seg-id field-num]
   (get-field parsed-message seg-id 0 field-num))
  ([parsed-message seg-id occurrence field-num]
   (when-let [seg (nth (segments-by-id parsed-message seg-id) occurrence nil)]
     (get (:fields seg) field-num))))

(defn get-value
  "`get-field`, collapsed to a plain string via `parser/field->string` —
  the common case of reading a scalar field's value."
  ([parsed-message seg-id field-num]
   (parser/field->string (get-field parsed-message seg-id field-num)))
  ([parsed-message seg-id occurrence field-num]
   (parser/field->string (get-field parsed-message seg-id occurrence field-num))))
