(ns hl7-v2.ack
  "General acknowledgment (v2.x §2.9.2, MSH + MSA): every HL7 v2 trigger
  event is acknowledged with the same two-segment shape, regardless of
  what the original message was. Application-level codes (MSA-1):
  `AA` accept, `AE` error, `AR` reject; the older commit-level codes `CA`
  `CE` `CR` exist for enhanced-mode acknowledgment and are accepted here
  too, but this library does not implement the original-mode/enhanced-
  mode negotiation itself (MSH-15/MSH-16) — that is transport/session
  policy, not codec.

  Deliberately not owned here: **generating** MSH-7's timestamp or
  MSH-10's control ID. Both need a clock or a counter, which would make
  `build-ack` impure and its output untestable byte-for-byte — the caller
  supplies both, the same way a caller supplies a nonce to a crypto
  function that must not roll its own randomness."
  (:require [hl7-v2.parser :as parser]))

(def ack-codes #{"AA" "AE" "AR" "CA" "CE" "CR"})

(defn- original-msh
  [original]
  (:fields (first (filter #(= "MSH" (:id %)) (:segments original)))))

(defn- trigger-event
  "The second component of MSH-9 (message type), e.g. \"A01\" out of
  \"ADT^A01^ADT_A01\" — used to shape the ACK's own MSH-9 as
  `ACK^<trigger>^ACK` (the common convention; a bare `ACK` is also valid
  per the standard and accepted on decode either way)."
  [msh]
  (let [mt (get msh 9)]
    (if (string? mt)
      nil
      (get-in mt [0 1 0]))))

(defn build-ack
  "Build a `{:delimiters :segments}` ACK/NAK message answering
  `original` (itself a parsed message, `hl7-v2.parser/parse-message`'s
  return value). `ack-code` is one of `ack-codes` (default `\"AA\"`).
  `text` (optional) becomes MSA-3 — required in practice for `AE`/`AR` to
  say why. `control-id` and `timestamp` are caller-supplied (see
  namespace docstring). Reuses `original`'s own delimiters, so a message
  that arrived with non-default separators is acknowledged with the same
  ones.

  Returns `[:error :hl7/ack-missing-msh]` if `original` has no MSH
  segment to answer, or `[:error :hl7/ack-bad-code]` if `ack-code` is not
  in `ack-codes`."
  [{:keys [original ack-code text control-id timestamp]
    :or {ack-code "AA"}}]
  (cond
    (not (contains? ack-codes ack-code)) [:error :hl7/ack-bad-code]
    :else
    (let [msh (original-msh original)]
      (if (nil? msh)
        [:error :hl7/ack-missing-msh]
        (let [trigger (trigger-event msh)
              msg-type (if trigger (parser/field "ACK" trigger "ACK") "ACK")
              orig-control-id (get msh 10)
              ack-msh
              {:id "MSH"
               :fields
               (cond-> {1 (get msh 1)
                        2 (get msh 2)
                        3 (get msh 5) 4 (get msh 6)
                        5 (get msh 3) 6 (get msh 4)
                        7 timestamp
                        9 msg-type
                        10 control-id
                        11 (get msh 11)
                        12 (get msh 12)})}
              ack-msa
              {:id "MSA"
               :fields (cond-> {1 ack-code 2 (if (string? orig-control-id)
                                                orig-control-id
                                                (parser/field->string orig-control-id))}
                         text (assoc 3 text))}]
          {:delimiters (:delimiters original)
           :segments [ack-msh ack-msa]})))))

(defn accept?
  [{:keys [segments]}]
  (= "AA" (get-in (first (filter #(= "MSA" (:id %)) segments)) [:fields 1])))
