(ns hl7-v2.escape
  "The HL7 v2 escape sequences (§2.7.3): a leaf value that needs to contain
  one of the message's own delimiter characters as data — a `^` in a free
  text field, say — writes it as an escape sequence instead, bracketed by
  the escape character on both sides. \\F\\ \\S\\ \\T\\ \\R\\ \\E\\ stand for
  field/component/subcomponent/repetition/escape; \\Xdd..\\ carries raw
  bytes as hex pairs, one output character per byte pair, for binary data
  ER7's own text encoding cannot carry directly.

  This has to run in a single left-to-right pass, not a sequence of
  find/replace calls: replacing the escape character first and then feeding
  the result through more replacements would re-escape the `\\` the first
  pass just inserted. Character-at-a-time is slower and correct.")

(defn- code->char
  [delims code]
  (case code
    "F" (:field delims)
    "S" (:component delims)
    "T" (:subcomponent delims)
    "R" (:repetition delims)
    "E" (:escape delims)
    nil))

(defn- hex-pair->int
  [hi lo]
  #?(:clj (Integer/parseInt (str hi lo) 16)
     :cljs (js/parseInt (str hi lo) 16)))

(defn- decode-hex-body
  "\\Xdd..\\ body (without the leading X, without the surrounding escape
  chars): pairs of hex digits, each pair one byte. HL7 v2 hex escape data
  is meant for byte-oriented payloads, so we render it back as characters
  by code point — round-trippable for the ASCII/Latin-1 range this codec
  targets."
  [hex-digits]
  (if (odd? (count hex-digits))
    nil
    (apply str
           (map (fn [[hi lo]] (char (hex-pair->int hi lo)))
                (partition 2 hex-digits)))))

(defn unescape
  "Replace `\\F\\` `\\S\\` `\\T\\` `\\R\\` `\\E\\` `\\Xdd..\\` escape
  sequences in `s` with their literal characters, using the escape
  character from `delims`. A sequence this function does not recognise
  (private `\\Zxxx\\`, highlighting `\\.sp\\`, an unterminated escape) is
  passed through byte-for-byte rather than guessed at — `escape` re-emits
  exactly this text on the way back out, so an unknown escape round-trips
  even though it is not interpreted."
  [s delims]
  (let [esc (:escape delims)
        n (count s)]
    (loop [i 0 out (transient [])]
      (if (>= i n)
        (apply str (persistent! out))
        (let [c (nth s i)]
          (if (= c esc)
            (let [close (loop [j (inc i)]
                          (cond
                            (>= j n) nil
                            (= (nth s j) esc) j
                            :else (recur (inc j))))]
              (if (nil? close)
                ;; unterminated escape: pass the rest through unchanged
                (recur n (reduce conj! out (seq (subs s i))))
                (let [body (subs s (inc i) close)
                      resolved
                      (cond
                        (code->char delims body) (str (code->char delims body))
                        (and (pos? (count body))
                             (contains? #{\X \x} (first body)))
                        (or (decode-hex-body (subs body 1)) (str esc body esc))
                        :else (str esc body esc))]
                  (recur (inc close) (reduce conj! out (seq resolved))))))
            (recur (inc i) (conj! out c))))))))

(defn escape
  "Replace literal delimiter characters (and the escape character itself)
  in `s` with their `\\F\\`/`\\S\\`/`\\T\\`/`\\R\\`/`\\E\\` escape
  sequences, so `s` can be embedded as a leaf value without its characters
  being mistaken for structure. Order matters: the escape character itself
  is escaped in the same single pass as everything else, so the sequences
  this function writes are never themselves re-escaped."
  [s delims]
  (if (nil? s)
    ""
    (let [{:keys [field component repetition escape subcomponent]} delims]
      (apply str
             (map (fn [c]
                    (cond
                      (= c escape) (str escape "E" escape)
                      (= c field) (str escape "F" escape)
                      (= c component) (str escape "S" escape)
                      (= c subcomponent) (str escape "T" escape)
                      (= c repetition) (str escape "R" escape)
                      :else (str c)))
                  (seq s))))))
