(ns hl7-v2.delimiters
  "MSH-1 and MSH-2: HL7 v2 is the protocol that declares its own alphabet in
  the message it is written in. MSH-1 is not a field like the others — it
  *is* the field separator, sitting in the character position right after
  the literal text \"MSH\". MSH-2 is the four (or more) encoding characters
  that follow, conventionally `^~\\&` (HL7 v2.x §2.7, MSH-1/MSH-2).

  Every other parser in this library takes a delimiter map rather than
  assuming `|^~\\&`, because Z-segments and some vendor interfaces run with
  different characters, and a codec that hardcodes the default is a codec
  that silently mis-splits the messages that do not use it.")

(def default-delimiters
  "The delimiters almost everyone uses, for building messages and tests.
  Real inbound messages must still be parsed with `parse` against their own
  MSH-1/MSH-2 — never assumed."
  {:field \|
   :component \^
   :repetition \~
   :escape \\
   :subcomponent \&})

(defn parse
  "Read the field/component/repetition/escape/subcomponent characters from
  the start of a raw ER7 message (or just its MSH segment) that begins with
  the three literal characters \"MSH\".

  Returns the delimiter map, or `[:error <reason>]`:
  `:hl7/not-msh-segment` — does not start with \"MSH\"
  `:hl7/msh-too-short`   — fewer than 3 encoding characters follow MSH-1
  `:hl7/msh2-truncated`  — MSH-2 runs to end of string with no terminator"
  [text]
  (cond
    (or (nil? text) (< (count text) 4))
    [:error :hl7/msh-too-short]

    (not (= "MSH" (subs text 0 3)))
    [:error :hl7/not-msh-segment]

    :else
    (let [field-sep (nth text 3)
          ;; MSH-2 runs from index 4 up to (not including) the next
          ;; occurrence of the field separator, or end of segment.
          rest-text (subs text 4)
          end (loop [i 0]
                (cond
                  (>= i (count rest-text)) i
                  (= (nth rest-text i) field-sep) i
                  (contains? #{\return \newline} (nth rest-text i)) i
                  :else (recur (inc i))))
          enc (subs rest-text 0 end)]
      (if (< (count enc) 4)
        [:error :hl7/msh-too-short]
        {:field field-sep
         :component (nth enc 0)
         :repetition (nth enc 1)
         :escape (nth enc 2)
         :subcomponent (nth enc 3)}))))

(defn error?
  [x]
  (and (vector? x) (= :error (first x))))
