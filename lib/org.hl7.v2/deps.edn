;; No dependencies. HL7 v2 (ER7) is delimiter-based text plus MLLP framing
;; over the raw bytes; a leaf that dragged an HTTP/socket/interface-engine
;; stack behind it would defeat the point, which is that the ER7 codec can
;; be used anywhere .cljc runs — including inside a WASM guest — without a
;; JVM or a network.
{:paths ["src"]
 :deps {
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}}
 :aliases
 {:test {:extra-paths ["test"]}
  :cljs {:extra-paths ["test"]}}}
