#!/usr/bin/env kbb
;; Run the suite on the ClojureScript side.
;;
;; Not a formality: `hl7-v2.mllp`'s `int`-of-char and `char`-of-int paths,
;; and the string-vs-vector polymorphism in `hl7-v2.parser`, are exactly
;; the kind of thing that reads correctly and diverges quietly between the
;; JVM and V8. See org-modbus's own copy of this script for the canonical
;; example of that going wrong.
;;
;;   kbb --backend sci --classpath "$(kbb -A:cljs -Spath)" scripts/verify-cljs.cljk
(ns verify-cljs
  (:require [kotoba.test :as t]
            [hl7-v2.core-test]))

(defmethod t/report [:cljs.test/default :end-run-tests] [m]
  (println)
  (if (t/successful? m)
    (println "all checks passed on the ClojureScript path")
    (do (println "FAILED on the ClojureScript path")
        (js/process.exit 1))))

(t/run-tests 'hl7-v2.core-test)
