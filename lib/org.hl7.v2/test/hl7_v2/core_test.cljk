(ns hl7-v2.core-test
  "Test vectors marked with a spec/RFC citation are the standard's own
  published examples or field-table values, transcribed by hand from the
  HL7 v2 Messaging Standard section 2 (ER7 encoding rules) and the widely
  published sample ADT^A01/ORU^R01 messages used across HL7 v2
  implementer documentation (e.g. HL7 v2.5.1 Chapter 3 ADT examples,
  HAPI's own test fixtures, Corepoint's/Caristix's public sample-message
  pages). Vectors marked `constructed, not a published spec vector` are
  built by hand to exercise a rule this suite could not independently
  verify against remembered spec text -- they are honest about being
  self-consistent rather than externally validated."
  (:require [kotoba.test :refer [deftest is testing]]
            [kotoba.lang.text :as str]
            [hl7-v2.delimiters :as delimiters]
            [hl7-v2.escape :as escape]
            [hl7-v2.parser :as parser]
            [hl7-v2.segments :as segments]
            [hl7-v2.mllp :as mllp]
            [hl7-v2.ack :as ack]))

;; A widely published sample ADT^A01 message (structurally standard --
;; this exact transcription is a common one seen across HL7 v2 tutorial
;; and interface-engine documentation sites, not verbatim from the base
;; standard's own text).
(def sample-adt-a01
  (str "MSH|^~\\&|ADT1|GOOD HEALTH HOSPITAL|GHH LAB, INC.|GOOD HEALTH HOSPITAL|"
       "198808181126|SECURITY|ADT^A01^ADT_A01|MSG00001|P|2.5\r"
       "EVN|A01|198808181123\r"
       "PID|1||PATID1234^5^M11^ADT1^MR^GOOD HEALTH HOSPITAL~123456789^^^USSSA^SS||"
       "EVERYMAN^ADAM^A^III||19610615|M||C|2222 HOME STREET^^GREENSBORO^NC^27401-1020|"
       "GL|(555) 555-2004|(555)555-2004||S||PATID12345001^2^M10^ADT1^AN^A|444333333|987654^NC\r"
       "NK1|1|NUCLEAR^NELDA^W|SPO^SPOUSE||||NK^NEXT OF KIN\r"
       "PV1|1|I|2000^2012^01||||004777^ATTEND^AARON^A|||SUR||||ADM|A0\r"))

(deftest delimiter-parsing
  (testing "MSH-1/MSH-2 (HL7 v2.x section 2.7) read from the message itself"
    (is (= {:field \| :component \^ :repetition \~ :escape \\ :subcomponent \&}
           (delimiters/parse "MSH|^~\\&|ADT1")))
    (testing "non-default separators are honoured, not assumed"
      (is (= {:field \# :component \@ :repetition \% :escape \$ :subcomponent \!}
             (delimiters/parse "MSH#@%$!#ADT1")))))
  (testing "errors are named, not thrown"
    (is (= [:error :hl7/not-msh-segment] (delimiters/parse "PID|1||")))
    (is (= [:error :hl7/msh-too-short] (delimiters/parse "MS")))
    (is (= [:error :hl7/msh-too-short] (delimiters/parse nil)))
    (is (= [:error :hl7/msh-too-short] (delimiters/parse "MSH|^~")))))

(deftest escape-sequences
  (let [d delimiters/default-delimiters]
    (testing "field/component/subcomponent/repetition/escape codes (HL7 v2.x section 2.7.3)"
      (is (= "a|b" (escape/unescape "a\\F\\b" d)))
      (is (= "a^b" (escape/unescape "a\\S\\b" d)))
      (is (= "a&b" (escape/unescape "a\\T\\b" d)))
      (is (= "a~b" (escape/unescape "a\\R\\b" d)))
      (is (= "a\\b" (escape/unescape "a\\E\\b" d))))
    (testing "hex escape \\Xdd..\\ -- constructed, not a published spec vector"
      (is (= "AB" (escape/unescape "\\X4142\\" d))))
    (testing "escape is the exact inverse of unescape over delimiter-bearing text"
      (is (= "5'8\" tall | wide" (escape/unescape (escape/escape "5'8\" tall | wide" d) d))))
    (testing "unknown escape sequences pass through unchanged rather than being guessed at"
      (is (= "\\Zlocal\\" (escape/unescape "\\Zlocal\\" d))))))

(deftest field-round-trip
  (let [d delimiters/default-delimiters]
    (testing "plain scalar field stays a plain string"
      (is (= "EVERYMAN" (parser/parse-field "EVERYMAN" d)))
      (is (= "" (parser/encode-field (parser/parse-field "" d) d))))
    (testing "components (HL7 v2.x section 2.7.1)"
      (is (= [[["PATID1234"] ["5"] ["M11"]]]
             (parser/parse-field "PATID1234^5^M11" d)))
      (is (= "PATID1234^5^M11" (parser/encode-field (parser/parse-field "PATID1234^5^M11" d) d))))
    (testing "repetitions (HL7 v2.x section 2.7.2, the PID-3 ~-repeated identifier list)"
      (is (= "PATID1234^5^M11^ADT1^MR^GOOD HEALTH HOSPITAL~123456789^^^USSSA^SS"
             (parser/encode-field
              (parser/parse-field
               "PATID1234^5^M11^ADT1^MR^GOOD HEALTH HOSPITAL~123456789^^^USSSA^SS" d)
              d))))
    (testing "subcomponents"
      (is (= "a&b&c" (parser/encode-field (parser/parse-field "a&b&c" d) d))))
    (testing "escaped delimiter inside a leaf survives the round trip"
      (let [text "5'8\\S\\ tall"]
        (is (= text (parser/encode-field (parser/parse-field text d) d)))))
    (testing "field->string reads the scalar value out of both shapes"
      (is (= "EVERYMAN" (parser/field->string "EVERYMAN")))
      (is (= "PATID1234" (parser/field->string (parser/parse-field "PATID1234^5" d)))))))

(deftest segment-round-trip
  (let [d delimiters/default-delimiters
        seg-line "PID|1||PATID1234^5^M11||EVERYMAN^ADAM^A^III||19610615|M"]
    (is (= seg-line (parser/encode-segment (parser/parse-segment seg-line d) d)))
    (testing "MSH field numbering: MSH-1 is the separator itself, MSH-2 is raw and unparsed"
      (let [seg (parser/parse-segment "MSH|^~\\&|ADT1|GOOD HEALTH HOSPITAL" d)]
        (is (= "|" (get-in seg [:fields 1])))
        (is (= "^~\\&" (get-in seg [:fields 2])))
        (is (= "ADT1" (get-in seg [:fields 3])))
        (is (= "GOOD HEALTH HOSPITAL" (get-in seg [:fields 4])))))
    (testing "segment too short is a named error, not a thrown exception"
      (is (= [:error :hl7/segment-too-short] (parser/parse-segment "PI" d))))))

(deftest message-round-trip
  (let [parsed (parser/parse-message sample-adt-a01)]
    (is (map? parsed))
    (is (= 5 (count (:segments parsed))))
    (is (= sample-adt-a01 (parser/encode-message parsed))
        "decode(encode(x)) == x over the full sample message"))
  (testing "trailing/leading blank lines and CRLF line endings are tolerated"
    (let [crlf (str/replace sample-adt-a01 "\r" "\r\n")
          parsed (parser/parse-message crlf)]
      (is (= 5 (count (:segments parsed))))))
  (testing "named errors, not exceptions"
    (is (= [:error :hl7/empty-message] (parser/parse-message "")))
    (is (= [:error :hl7/empty-message] (parser/parse-message "\r\r\r")))
    (is (= [:error :hl7/not-msh-segment] (parser/parse-message "PID|1||\r")))))

(deftest structural-segment-access
  (let [parsed (parser/parse-message sample-adt-a01)]
    (testing "MSH"
      (is (= "ADT1" (segments/get-value parsed "MSH" 3)))
      (is (= "MSG00001" (segments/get-value parsed "MSH" 10))))
    (testing "EVN"
      (is (= "A01" (segments/get-value parsed "EVN" 1))))
    (testing "PID -- first repetition of the repeated identifier list"
      (is (= "PATID1234" (segments/get-value parsed "PID" 3)))
      (is (= "EVERYMAN" (segments/get-value parsed "PID" 5))))
    (testing "NK1"
      (is (= "NUCLEAR" (segments/get-value parsed "NK1" 2))))
    (testing "PV1"
      (is (= "I" (segments/get-value parsed "PV1" 2))))
    (testing "field-name lookups cover the documented common segments"
      (is (= :patient-name (segments/field-name "PID" 5)))
      (is (= :message-type (segments/field-name "MSH" 9)))
      (is (nil? (segments/field-name "ZZZ" 1))
          "a Z-segment has no name-map entry, structurally correct"))))

(deftest z-segment-parses-generically
  (testing "Z-segments (v2.x section 2.8.1) use the same generic segment grammar"
    (let [d delimiters/default-delimiters
          zseg (parser/parse-segment "ZPI|1|LOCALVALUE|OTHER" d)]
      (is (= "ZPI" (:id zseg)))
      (is (= "LOCALVALUE" (get-in zseg [:fields 2])))
      (is (= "ZPI|1|LOCALVALUE|OTHER" (parser/encode-segment zseg d))))))

(deftest obr-obx-repeated-segments
  (let [msg (str "MSH|^~\\&|LAB|FAC|APP|FAC|20240101000000||ORU^R01|CTRL1|P|2.5\r"
                 "PID|1||PATID999||DOE^JOHN\r"
                 "OBR|1|ORD1|FIL1|CBC^COMPLETE BLOOD COUNT\r"
                 "OBX|1|NM|WBC^WHITE BLOOD COUNT||7.5|10*3/uL|4.0-11.0|N|||F\r"
                 "OBX|2|NM|RBC^RED BLOOD COUNT||4.9|10*6/uL|4.2-5.9|N|||F\r")
        parsed (parser/parse-message msg)]
    (is (= 2 (count (segments/segments-by-id parsed "OBX"))))
    (is (= "7.5" (segments/get-value parsed "OBX" 0 5)))
    (is (= "4.9" (segments/get-value parsed "OBX" 1 5)))
    (is (= "CBC" (segments/get-value parsed "OBR" 4))
        "get-value reads the first component (the coded identifier) of the composite OBR-4")
    (is (= "COMPLETE BLOOD COUNT"
           (get-in (segments/get-field parsed "OBR" 4) [0 1 0]))
        "the composite's second component (the text) is reachable via get-field")))

(deftest mllp-framing
  (testing "0x0B start block, 0x1C 0x0D end block"
    (let [framed (mllp/wrap "MSH|^~\\&|A\r")]
      (is (= 0x0B (mllp/code-at framed 0)))
      (is (= [0x1C 0x0D] [(mllp/code-at framed (- (count framed) 2))
                           (mllp/code-at framed (- (count framed) 1))]))
      (is (= {:message "MSH|^~\\&|A\r"} (mllp/unwrap framed)))))
  (testing "byte-vector level"
    (let [bs (mllp/str->bytes "MSH|1\r")
          framed (mllp/wrap-bytes bs)]
      (is (= 0x0B (first framed)))
      (is (= [0x1C 0x0D] (take-last 2 framed)))
      (is (= {:message bs} (mllp/unwrap-bytes framed)))))
  (testing "named errors"
    (is (= [:error :hl7/mllp-frame-too-short] (mllp/unwrap "")))
    (is (= [:error :hl7/mllp-missing-start-block] (mllp/unwrap (str "X" (char 0x1C) (char 0x0D)))))
    (is (= [:error :hl7/mllp-missing-end-block] (mllp/unwrap (str (char 0x0B) "XY"))))))

(deftest ack-construction
  (let [parsed (parser/parse-message sample-adt-a01)
        ack-msg (ack/build-ack {:original parsed :ack-code "AA"
                                 :control-id "ACKCTRL1" :timestamp "198808181130"})]
    (is (map? ack-msg))
    (is (= "AA" (segments/get-value ack-msg "MSA" 1)))
    (is (= "MSG00001" (segments/get-value ack-msg "MSA" 2))
        "MSA-2 echoes the original MSH-10 control id")
    (is (= "GHH LAB, INC." (segments/get-value ack-msg "MSH" 3))
        "ACK sending app = original's receiving app")
    (is (= "ADT1" (segments/get-value ack-msg "MSH" 5))
        "ACK receiving app = original's sending app")
    (is (= "ACK" (parser/field->string (segments/get-value ack-msg "MSH" 9)))
        "MSH-9.1 is literally ACK")
    (is (= "A01" (get-in (segments/get-field ack-msg "MSH" 9) [0 1 0]))
        "MSH-9.2 mirrors the original trigger event")
    (is (true? (ack/accept? ack-msg)))
    (let [encoded (parser/encode-message ack-msg)
          reparsed (parser/parse-message encoded)]
      (is (= "AA" (segments/get-value reparsed "MSA" 1))
          "the ACK itself round-trips through encode/parse")))
  (testing "NAK (AE) with an error text"
    (let [parsed (parser/parse-message sample-adt-a01)
          nak (ack/build-ack {:original parsed :ack-code "AE" :text "unknown patient"
                               :control-id "ACKCTRL2" :timestamp "198808181131"})]
      (is (= "AE" (segments/get-value nak "MSA" 1)))
      (is (= "unknown patient" (segments/get-value nak "MSA" 3)))
      (is (false? (ack/accept? nak)))))
  (testing "named errors"
    (is (= [:error :hl7/ack-bad-code]
           (ack/build-ack {:original (parser/parse-message sample-adt-a01) :ack-code "ZZ"})))
    (is (= [:error :hl7/ack-missing-msh]
           (ack/build-ack {:original {:delimiters delimiters/default-delimiters :segments []}
                            :ack-code "AA"})))))

;; ---------------------------------------------------------------------
;; Property test: decode(encode(x)) == x over a corpus of hand-built
;; field/segment/message shapes -- constructed, not a published spec
;; vector, but exercising the parser/encoder pair against itself rather
;; than a remembered constant.

(def field-corpus
  ["PLAIN"
   ""
   "PATID1234^5^M11"
   "A~B~C"
   "a^^c"
   "a&b^c&d&e~f"
   "5'8\\S\\ tall \\T\\ wide"])

(deftest field-corpus-round-trip
  (let [d delimiters/default-delimiters]
    (doseq [text field-corpus]
      (is (= text (parser/encode-field (parser/parse-field text d) d))
          (str "round trip failed for " (pr-str text))))))

(deftest unrecognised-escape-is-only-stable-across-two-passes
  ;; \.br\ (line break) and \Zxxx\ (private) are not in this codec's
  ;; recognised set (F/S/T/R/E/X -- HL7 v2.x section 2.7.3). unescape
  ;; passes the raw text through unchanged rather than guessing, which
  ;; means the *wire text* does not round-trip through a single
  ;; unescape->escape pass -- the backslash characters it left behind
  ;; get correctly re-escaped as \E\ on the way back out, because at
  ;; that point they are indistinguishable from a literal backslash a
  ;; caller put in real data. What *is* guaranteed, and is the more
  ;; important property for a leaf that a caller builds with a raw
  ;; string, is that encode/decode round-trips arbitrary *data*:
  ;; escaping a value and then unescaping it always recovers the
  ;; original value, even when that value itself contains a literal
  ;; backslash. Constructed, not a published spec vector.
  (let [d delimiters/default-delimiters]
    (testing "data round trip: unescape(escape(x)) == x, for x containing a literal backslash"
      (is (= "\\.br\\" (escape/unescape (escape/escape "\\.br\\" d) d))))
    (testing "unrecognised wire text is stable after a second pass"
      (let [once (escape/unescape "\\.br\\" d)
            twice (escape/unescape (escape/escape once d) d)]
        (is (= once twice))))))

(deftest message-corpus-round-trip
  (doseq [msg [sample-adt-a01
               (str "MSH|^~\\&|A|B|C|D|20240101120000||ORU^R01|CID1|P|2.3\r"
                    "OBX|1|ST|1^A||val\r")
               (str "MSH#@%$!#A#B#C#D#20240101120000##ORU@R01#CID1#P#2.3\r"
                    "OBX#1#ST#1@A##val\r")]]
    (let [parsed (parser/parse-message msg)]
      (is (map? parsed) (str "parse failed for " (pr-str msg)))
      (is (= msg (parser/encode-message parsed))))))
