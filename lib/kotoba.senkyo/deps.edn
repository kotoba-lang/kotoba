;; senkyo — 選挙ドメインの一般ライブラリ。
;; 手続きの型と期限の算法は kotoba-lang/tetsuzuki（一般行政手続き）に委譲する
;; —— 選挙だけが独自の期限算法を持つ理由は無い（ADR-2608079500）。
;; テストの第一経路は nbb:
;;   kbb --backend sci --classpath src:test:../tetsuzuki/src run_tests.cljk
{:paths ["src"]
 :deps {
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}
        io.github.kotoba-lang/tetsuzuki {:local/root "../kotoba.tetsuzuki"}}
 :aliases {:test {:extra-paths ["test"]}}}
