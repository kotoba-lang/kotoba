(ns senkyo.conformance-test
  "**この repo のカタログが `kotoba-lang/tetsuzuki` の形に適合しているか。**

  選挙の手続きは行政手続きの一分野であって、別の形を持つ理由が無い。
  適合が破れたら、それは選挙側が独自の語彙へ逸れ始めた合図である。

  この検査を書いた結果、tetsuzuki 側に 3 つ足りないものが見つかった
  （ADR-2608079500 に記録）:

  1. **`:sanction`** —— 選挙運動費用収支報告の徒過は権利を失うのではなく
     罰則の対象になる。`:forfeits-right` に丸めると刑事罰があることが消える。
  2. **`:before-or-on`** —— 供託は公示日「まで」であり、当日ちょうどではない。
  3. **基準点の分野拡張** —— `:poll-day` は一般行政に無く、
     `:disposition-known` は選挙の提出手続きに出てこない。基準点を単一の
     閉集合にすると、分野を足すたびに他分野と無関係な値が混ざるか、
     分野が適合できなくなる。

  **型は 1 つの分野だけでは検証されない。** 2 つ目の実カタログを載せて初めて
  分かることがある、という記録でもある。"
  (:require #?(:clj [kotoba.test :refer [deftest is testing]]
               :cljs [cljs.test :refer-macros [deftest is testing]])
            [senkyo.procedure :as procedure]
            [tetsuzuki.deadline :as tdeadline]
            [tetsuzuki.procedure :as tprocedure]
            [tetsuzuki.vocabulary :as tv]))

(def opts
  "選挙の基準点集合を渡す（一般行政の core には `:poll-day` が無い）。"
  {:anchors procedure/anchors})

(deftest senkyo-catalog-conforms-to-the-shared-full-shape
  (let [r (tprocedure/conform procedure/procedures :full opts)]
    (is (:ok? r) (str "違反: " (tprocedure/explain-violations r)))
    (is (= 14 (:procedures r)))))

(deftest procedure-ids-are-unique-across-jurisdictions
  (is (tprocedure/unique-ids? procedure/procedures)
      (str "重複: " (tprocedure/duplicate-ids procedure/procedures))))

(deftest every-election-deadline-binds-the-filer
  (testing "選挙の手続きは全部が提出側を縛る —— 行政庁側の期限は 1 つも無い。"
    (doseq [[iso3 ps] procedure/procedures [pid p] ps]
      (when-let [d (:proc/deadline p)]
        (is (= :filer (:binds d)) (str iso3 "/" pid)))))
  (testing "だから tetsuzuki 側（一般行政）で :authority が主役になる"
    (is (every? #(not (tdeadline/authority-side? %))
                (mapcat vals (vals procedure/procedures))))))

(deftest reporting-lapses-are-sanctions-not-forfeitures
  (testing "収支報告の徒過は権利を失うのではなく罰則の対象になる"
    (is (= :sanction (:proc/lapse-effect (procedure/procedure "JPN" :jp-expense-return))))
    (is (= :sanction (:proc/lapse-effect (procedure/procedure "GBR" :gb-expenses-return))))
    (is (= :sanction (:proc/lapse-effect (procedure/procedure "CAN" :ca-campaign-return)))))
  (testing "立候補の届出の徒過は失権"
    (is (= :forfeits-right
           (:proc/lapse-effect (procedure/procedure "JPN" :jp-candidacy-filing))))))

(deftest closed-vocabularies-hold
  (doseq [[iso3 ps] procedure/procedures [pid p] ps]
    (let [where (str iso3 "/" pid)]
      (is (contains? tv/procedure-kinds (:proc/kind p)) where)
      (is (contains? tv/lapse-effects (:proc/lapse-effect p)) where)
      (is (contains? tv/confidences (:proc/confidence p)) where)
      (when-let [d (:proc/deadline p)]
        (is (contains? tv/deadline-binds (:binds d)) where)
        (is (contains? tv/deadline-sources (:source d)) where)
        (is (contains? tv/day-units (:unit d)) where)
        (is (contains? tv/directions (:direction d)) where)))))

(deftest deadline-arithmetic-is-delegated-not-duplicated
  (testing "senkyo は算法を持たず tetsuzuki に委譲する"
    (let [p (procedure/procedure "JPN" :jp-expense-return)]
      (is (= (tdeadline/resolve-deadline (:proc/deadline p) {:anchors {:poll-day 20500}})
             (procedure/due-epoch-day p {:poll-day 20500})))
      (is (= 20515 (procedure/due-epoch-day p {:poll-day 20500})))
      (is (= :unknown-anchor (procedure/due-epoch-day p {}))))))

(deftest election-anchors-are-not-general-administration-anchors
  (testing "基準点は分野ごと —— 単一の閉集合にできない"
    (is (contains? procedure/anchors :poll-day))
    (is (not (contains? tv/anchors :poll-day))
        ":poll-day は一般行政の基準点ではない")
    (is (contains? tv/anchors :disposition-known))
    (is (not (contains? procedure/anchors :disposition-known))
        ":disposition-known は選挙の提出手続きに出てこない"))
  (testing "共有される基準点もある"
    (is (contains? procedure/anchors :calendar-year-end))
    (is (contains? tv/anchors :calendar-year-end))))

(deftest conformance-fails-loudly-when-the-shape-drifts
  (testing "壊れた entry は適合検査で捕まる（検査が飾りでないことの確認）"
    (let [broken (assoc-in procedure/procedures
                           ["JPN" :jp-expense-return :proc/lapse-effect] :made-up)
          r (tprocedure/conform broken :full opts)]
      (is (false? (:ok? r)))
      (is (some #(= :bad-lapse-effect (:rule %)) (:violations r))))))
