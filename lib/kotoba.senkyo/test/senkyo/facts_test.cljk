(ns senkyo.facts-test
  (:require #?(:clj [kotoba.test :refer [deftest is testing]]
               :cljs [cljs.test :refer-macros [deftest is testing]])
            [senkyo.facts :as facts]
            [senkyo.medium :as medium]))

(deftest categories-are-universal-instruments-are-not
  (testing "全 instrument の category が普遍カテゴリに収まっている"
    (is (= #{} (facts/assert-categories-are-universal))))
  (testing "instrument id は法域を跨いで一意 —— 重複は層の切り方の誤り"
    (let [ids (mapcat (comp keys val) facts/regulations)]
      (is (= (count ids) (count (distinct ids))))))
  (testing "decision 語彙が閉じている"
    (is (every? facts/decisions
                (map :reg/decision (mapcat vals (vals facts/regulations)))))))

(deftest every-instrument-cites-a-source
  (testing "根拠法と出典 URL の無い instrument を置かない（非創作の担保）"
    (doseq [[iso3 insts] facts/regulations [rid m] insts]
      (is (string? (:reg/legal-basis m)) (str iso3 "/" rid " に :reg/legal-basis が無い"))
      (is (seq (:reg/source-urls m)) (str iso3 "/" rid " に :reg/source-urls が無い"))
      (is (contains? #{:high :medium} (:reg/confidence m))
          (str iso3 "/" rid " の :reg/confidence が無効"))
      (is (string? (:reg/verified m)) (str iso3 "/" rid " に :reg/verified が無い")))))

(deftest coverage-is-honest
  (let [c (facts/coverage)]
    (is (= ["CAN" "DEU" "GBR" "JPN" "USA"] (:jurisdictions c)))
    (is (= 5 (:count c)))
    (testing "未収録の大人口法域を名指しで申告する"
      (is (<= 10 (count (:uncovered-large c))))
      (is (some #(re-find #"IND" %) (:uncovered-large c)))
      (is (some #(re-find #"BRA" %) (:uncovered-large c))))
    (testing "EU レベルの規制が無いこと・米国の連邦のみであることを明示する"
      (is (re-find #"EU レベルの選挙運動規制は存在しない" (:note c)))
      (is (re-find #"連邦分だけ" (:note c))))))

(deftest unknown-jurisdiction-is-nil-not-empty
  (testing "未収録法域は nil —— 「規制が無い」と「知らない」を同じ値にしない"
    (is (nil? (facts/instruments "ATL")))
    (is (nil? (facts/for-medium "ATL" :poster)))
    (is (false? (facts/jurisdiction-covered? "ATL")))))

(deftest opposite-laws-are-recorded-as-opposite
  (testing "戸別訪問: JPN は禁止、USA と CAN は保護 —— 同じテンプレートで扱えない"
    (is (= :prohibited (:reg/decision (facts/instrument "JPN" :jp-poll-138-door-to-door))))
    (is (= :protected (:reg/decision (facts/instrument "USA" :us-canvass-protected))))
    (is (= :protected (:reg/decision (facts/instrument "CAN" :ca-cea-building-access)))))
  (testing "GBR/DEU は手段でなく態様を縛る（:always で合法だが条件つき）"
    (is (= :always (:reg/decision (facts/instrument "GBR" :gb-canvass-permitted))))
    (is (= :always (:reg/decision (facts/instrument "DEU" :de-canvass-permitted))))))

(deftest every-jurisdiction-requires-attribution
  (testing "5 法域すべてで、掲示・頒布物に表示義務がある（普遍カテゴリの裏付け）"
    (doseq [iso3 (keys facts/regulations)]
      (let [attribution (filter (fn [[_ m]] (= :attribution (:reg/category m)))
                                (facts/instruments iso3))]
        (is (seq attribution) (str iso3 " に attribution instrument が無い"))))))

(deftest for-medium-filters-by-medium
  (testing "戸別訪問に紐づく instrument はポスターの表示義務を含まない"
    (let [d2d (facts/for-medium "JPN" :door-to-door)]
      (is (contains? d2d :jp-poll-138-door-to-door))
      (is (not (contains? d2d :jp-poll-143-display)))))
  (testing "手段に紐づかない instrument（寄附規制）は for-medium に出ない"
    (is (not (contains? (facts/for-medium "DEU" :poster) :de-partg-spenden)))))

(deftest high-confidence-filter-does-not-silently-drop
  (let [all (facts/for-medium "CAN" :poster)
        high (facts/high-confidence-only all)]
    (is (<= (count high) (count all)))
    (testing ":medium confidence の instrument が実在する（confidence が飾りでない）"
      (is (< (count high) (count all))))))

(deftest authority-units-join-to-ooyake-convention
  (testing "authority-unit は ooyake の gov.<iso3lc>.electoral 規約に従う"
    (doseq [[iso3 insts] facts/regulations [_ m] insts]
      (when-let [u (:reg/authority-unit m)]
        (is (re-matches #"gov\.[a-z]{3}\.electoral" u)
            (str iso3 " の authority-unit が規約外: " u))))))

(deftest category-index-covers-every-category-somewhere
  (let [idx (facts/category-index)]
    (testing "6 つの普遍カテゴリすべてに、少なくとも 1 法域の instrument がある"
      (doseq [c medium/categories]
        (is (seq (get idx c)) (str "カテゴリ " c " を担う instrument が 1 つも無い"))))))
