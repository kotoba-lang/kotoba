(ns senkyo.screen-test
  (:require #?(:clj [kotoba.test :refer [deftest is testing]]
               :cljs [cljs.test :refer-macros [deftest is testing]])
            [senkyo.screen :as screen]))

(deftest japan-door-to-door-is-prohibited-and-cannot-be-argued-away
  (let [r (screen/screen {:iso3 "JPN" :medium :door-to-door
                          :attrs {:within-campaign-period? true}})]
    (is (= :prohibited (:verdict r)))
    (testing "期間内であっても解けない —— 条件を足して通せる禁止ではない"
      (is (seq (:blocking r)))
      (is (some #(= :jp-poll-138-door-to-door (:reg-id %)) (:blocking r))))))

(deftest usa-door-to-door-is-not-prohibited
  (let [r (screen/screen {:iso3 "USA" :medium :door-to-door})]
    (is (not= :prohibited (:verdict r)))
    (testing "保護は informational であって義務でも障害でもない"
      (is (some #(and (= :us-canvass-protected (:reg-id %))
                      (= :informational (:status %)))
                (:findings r))))))

(deftest canada-door-to-door-is-protected
  (let [r (screen/screen {:iso3 "CAN" :medium :door-to-door})]
    (is (not= :prohibited (:verdict r)))))

(deftest unknown-never-becomes-permitted
  (testing "期間が与えられていなければ :undetermined で止まる"
    (let [r (screen/screen {:iso3 "JPN" :medium :leaflet})]
      (is (= :undetermined (:verdict r)))
      (is (seq (:unknown r)))
      (is (re-find #"「適法」として扱わない" (:note r)))))
  (testing ":local は国レベルで解けないので unknown のまま残る"
    (let [r (screen/screen {:iso3 "USA" :medium :poster
                            :attrs {:within-campaign-period? true}})]
      (is (= :undetermined (:verdict r)))
      (is (some #(= :us-sign-local (:reg-id %)) (:unknown r)))))
  (testing "下位当局を確認済みとすれば解ける"
    (let [r (screen/screen {:iso3 "USA" :medium :poster
                            :attrs {:within-campaign-period? true
                                    :local-authority-confirmed? true}})]
      (is (= :permitted-with-obligations (:verdict r)))
      (is (some #{"disclaimer-compliance-record"} (:required-evidence r))))))

(deftest uncovered-jurisdiction-is-no-spec-basis-not-permitted
  (let [r (screen/screen {:iso3 "IND" :medium :poster})]
    (is (= :no-spec-basis (:verdict r)))
    (is (re-find #"「規制が無い」ではない" (:note r)))
    (testing "証跡も findings も出さない —— 創作の入口を作らない"
      (is (empty? (:findings r)))
      (is (empty? (:required-evidence r))))))

(deftest unknown-medium-is-rejected
  (let [r (screen/screen {:iso3 "JPN" :medium :skywriting})]
    (is (= :no-spec-basis (:verdict r)))))

(deftest out-of-scope-intents-stop-the-screen
  (doseq [intent screen/out-of-scope-intents]
    (let [r (screen/screen {:iso3 "USA" :medium :leaflet :intents #{intent}})]
      (is (= :out-of-scope (:verdict r)) (str intent " が素通りした"))
      (is (nil? (:findings r)))))
  (testing "in-scope な意図は通る"
    (is (= :in-scope (screen/check-intent :disclosure-check)))))

(deftest out-of-scope-set-is-closed-and-named
  (testing "境界は共有ライブラリ側に 1 か所だけ定義される"
    (is (= #{:voter-targeting :vote-persuasion-script :candidate-ranking
             :turnout-operation :distribution-dispatch :opinion-profiling
             :eligibility-adjudication}
           screen/out-of-scope-intents))))

(deftest conditional-instrument-needs-its-condition
  (testing "TCPA: 条件キーが無ければ unknown"
    (let [r (screen/screen {:iso3 "USA" :medium :phone-outreach})]
      (is (some #(= :us-tcpa-calls (:reg-id %)) (:unknown r)))))
  (testing "条件が偽なら satisfied（効かない）として畳まれる"
    (let [r (screen/screen {:iso3 "USA" :medium :phone-outreach
                            :attrs {:autodialed-or-prerecorded-to-wireless false}})]
      (is (some #(and (= :us-tcpa-calls (:reg-id %)) (= :satisfied (:status %)))
                (:findings r)))))
  (testing "条件が真なら義務になる"
    (let [r (screen/screen {:iso3 "USA" :medium :phone-outreach
                            :attrs {:autodialed-or-prerecorded-to-wireless true}})]
      (is (some #{"tcpa-consent-record"} (:required-evidence r))))))

(deftest medium-confidence-is-deferred-not-dropped
  (let [r (screen/screen {:iso3 "GBR" :medium :poster
                          :attrs {:within-campaign-period? true}
                          :require-high-confidence? true})]
    (testing "除外ではなく :deferred 枠に出る —— 「その義務は無い」と読ませない"
      (is (seq (:deferred r)))
      (is (some #(= :gb-poster-advert-consent (:reg-id %)) (:deferred r))))))

(deftest plan-verdict-is-the-worst-medium
  (testing "禁止手段が 1 つ混ざれば計画全体が通らない"
    (let [r (screen/screen-plan {:iso3 "JPN" :media [:leaflet :door-to-door]
                                 :attrs {:within-campaign-period? true}})]
      (is (= :prohibited (:verdict r)))
      (is (= 2 (count (:per-medium r))))))
  (testing "同じ計画でも法域が違えば結論が変わる"
    (let [r (screen/screen-plan {:iso3 "CAN" :media [:leaflet :door-to-door]
                                 :attrs {:within-campaign-period? true}})]
      (is (not= :prohibited (:verdict r))))))
