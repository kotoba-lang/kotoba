(ns senkyo.procedure-test
  (:require #?(:clj [kotoba.test :refer [deftest is testing]]
               :cljs [cljs.test :refer-macros [deftest is testing]])
            [senkyo.procedure :as proc]))

(deftest every-procedure-cites-a-basis-and-declares-confidence
  (doseq [[iso3 ps] proc/procedures [pid p] ps]
    (is (string? (:proc/legal-basis p)) (str iso3 "/" pid " に根拠法が無い"))
    (is (contains? #{:high :medium} (:proc/confidence p))
        (str iso3 "/" pid " の confidence が無効"))
    (is (contains? proc/actors (:proc/actor p))
        (str iso3 "/" pid " の actor 語彙が閉じていない"))
    (when-let [d (:proc/deadline p)]
      (is (contains? proc/anchors (:anchor d))
          (str iso3 "/" pid " の anchor 語彙が閉じていない")))))

(deftest deadline-resolves-from-anchor
  (let [p (proc/procedure "JPN" :jp-expense-return)]
    (testing "投票日 = epoch-day 20500 なら 15 日後"
      (is (= 20515 (proc/due-epoch-day p {:poll-day 20500}))))
    (testing "基準日が無ければ :unknown-anchor —— 「期限なし」に倒さない"
      (is (= :unknown-anchor (proc/due-epoch-day p {})))))
  (testing ":before は基準日から引く"
    (let [p (proc/procedure "DEU" :de-wahlvorschlag)]
      (is (= (- 20500 69) (proc/due-epoch-day p {:poll-day 20500})))))
  (testing "期限を持たない手続きは :no-deadline（州法で決まる等）"
    (let [p (proc/procedure "USA" :us-ballot-access)]
      (is (= :no-deadline (proc/due-epoch-day p {:poll-day 20500}))))))

(deftest schedule-keeps-unresolved-rows
  (let [s (proc/schedule "JPN" {:poll-day 20500})
        u (proc/unresolved s)]
    (is (seq s))
    (testing "解けなかった行を落とさない —— 落とすと「期限が無い」と読める"
      (is (every? (fn [row] (contains? row :due)) s))
      (is (seq u) "公示日を与えていないので未解決が残るはず"))
    (testing "公示日も与えれば未解決が減る"
      (let [s2 (proc/schedule "JPN" {:poll-day 20500 :announcement-day 20488
                                     :calendar-year-end 20454})]
        (is (< (count (proc/unresolved s2)) (count u)))))))

(deftest receiving-side-and-filing-side-read-the-same-table
  (testing "選管が受け取る手続きだけを引ける（受領側 actor の入口）"
    (let [r (proc/received-by-election-authority "JPN")]
      (is (contains? r :jp-candidacy-filing))
      (is (contains? r :jp-expense-return))
      (testing "供託は法務局が受けるので選管の受領対象ではない"
        (is (not (contains? r :jp-deposit))))))
  (testing "受領側の形式審査項目が entry に入っている"
    (let [p (proc/procedure "JPN" :jp-candidacy-filing)]
      (is (seq (:proc/formal-review p)))
      (is (some #(re-find #"供託" %) (:proc/formal-review p))))))

(deftest by-actor-splits-obligations
  (testing "出納責任者と候補者では負う手続きが違う"
    (is (contains? (proc/by-actor "JPN" :treasurer) :jp-expense-return))
    (is (contains? (proc/by-actor "JPN" :candidate) :jp-candidacy-filing))
    (is (not (contains? (proc/by-actor "JPN" :candidate) :jp-expense-return)))))

(deftest candidacy-arises-differently-by-jurisdiction
  (testing "日本は届出で候補者になる、米国は金額で候補者になる"
    (is (= :announcement-day
           (:anchor (:proc/deadline (proc/procedure "JPN" :jp-candidacy-filing)))))
    (is (= :candidacy-threshold
           (:anchor (:proc/deadline (proc/procedure "USA" :us-statement-of-candidacy)))))))

(deftest coverage-names-what-needs-source-check
  (let [c (proc/coverage)]
    (is (= ["CAN" "DEU" "GBR" "JPN" "USA"] (:jurisdictions c)))
    (testing "confidence が :high でない手続きを名指しで返す"
      (is (seq (:needs-source-check c)))
      (is (some #(re-find #"JPN/" %) (:needs-source-check c))))
    (is (re-find #"期限を1日間違えると" (:note c)))))

(deftest uncovered-jurisdiction-is-nil
  (is (nil? (proc/for-jurisdiction "IND")))
  (is (nil? (proc/received-by-election-authority "IND"))))
