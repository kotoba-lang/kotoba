(ns senkyo.authority-test
  (:require #?(:clj [kotoba.test :refer [deftest is testing]]
               :cljs [cljs.test :refer-macros [deftest is testing]])
            [senkyo.authority :as authority]
            [senkyo.facts :as facts]))

;; ooyake の実データの形をなぞった最小 fixture。
;; 2026-08-07 実測: ooyake の electoral registry には USA / GBR はあるが
;; JPN / DEU / CAN が無い。その状態を再現している。
(def atlas-fixture
  [{:gov.unit/id "gov.usa.electoral"
    :gov.unit/jurisdiction "usa"
    :gov.unit/name-en "Federal Election Commission"
    :gov.unit/official-url "https://www.fec.gov"
    :gov.unit/wikidata "Q1396470"
    :gov.unit/atlas-did "did:web:etzhayyim.com:gov:usa:agency:electoral-commission"}
   {:gov.unit/id "gov.gbr.electoral"
    :gov.unit/jurisdiction "gbr"
    :gov.unit/name-en "Electoral Commission"
    :gov.unit/official-url "https://www.electoralcommission.org.uk"
    :gov.unit/wikidata "Q5357059"
    :gov.unit/atlas-did "did:web:etzhayyim.com:gov:gbr:agency:electoral-commission"}
   {:gov.unit/id "gov.ind.electoral"
    :gov.unit/jurisdiction "ind"
    :gov.unit/name-en "Election Commission of India"
    :gov.unit/official-url "https://eci.gov.in"
    :gov.unit/wikidata "Q1341545"
    :gov.unit/atlas-did "did:web:etzhayyim.com:gov:ind:agency:electoral-commission"}])

(deftest unit-id-follows-ooyake-convention
  (is (= "gov.jpn.electoral" (authority/unit-id "JPN")))
  (is (= "gov.usa.electoral" (authority/unit-id "USA")))
  (is (= "did:web:etzhayyim.com:gov:can:agency:electoral-commission"
         (authority/atlas-did "CAN"))))

(deftest atlas-resolution-prefers-atlas-then-falls-back-to-facts
  (let [idx (authority/index-atlas atlas-fixture)]
    (testing "atlas にあれば QID と公式 URL つきで返る"
      (let [a (authority/authority-of idx "USA")]
        (is (= :atlas (:source a)))
        (is (= "Q1396470" (:wikidata a)))
        (is (= "https://www.fec.gov" (:official-url a)))))
    (testing "atlas に無ければ facts の一次情報に落ち、同定が弱いことを申告する"
      (let [a (authority/authority-of idx "JPN")]
        (is (= :facts (:source a)))
        (is (seq (:names a)))
        (is (re-find #"Wikidata QID / 公式 URL による同定は付いていない" (:note a)))))
    (testing "どちらにも無ければ :none で、創作を禁じる文言を返す"
      (let [a (authority/authority-of idx "ATL")]
        (is (= :none (:source a)))
        (is (re-find #"創作してはならない" (:note a)))))))

(deftest join-report-counts-both-directions
  (let [r (authority/join-report atlas-fixture)]
    (testing "join できた法域"
      (is (= ["GBR" "USA"] (:joined r))))
    (testing "senkyo に規制はあるが atlas に選管が無い法域を隠さない"
      (is (= ["CAN" "DEU" "JPN"] (:senkyo-only r))))
    (testing "atlas に選管はあるが senkyo に規制カタログが無い法域も数える"
      (is (= ["IND"] (:atlas-only r))))
    (testing "片方向だけ報告するのは嘘だと note に明記されている"
      (is (re-find #"join できた数だけを報告するのは嘘になる" (:note r))))))

(deftest measured-atlas-gap-matches-the-recorded-observation
  (testing "2026-08-07 実測の欠落（JPN/DEU/CAN）が定数と fixture で一致する"
    (is (= authority/atlas-absent-as-of-2026-08-07
           (set (:senkyo-only (authority/join-report atlas-fixture)))))))

(deftest attach-authorities-marks-unresolved-explicitly
  (let [idx (authority/index-atlas atlas-fixture)
        insts (facts/for-medium "JPN" :poster)
        attached (authority/attach-authorities idx insts)]
    (testing "atlas に無い当局は :unresolved を明示して残す（黙って落とさない）"
      (is (every? #(contains? % :reg/authority-resolved) (vals attached)))
      (is (some #(:unresolved (:reg/authority-resolved %)) (vals attached))))
    (testing ":local な instrument は「国レベルに所管が無い」と説明される"
      (let [us (authority/attach-authorities idx (facts/for-medium "USA" :poster))]
        (is (some #(re-find #"国レベルに所管が無い"
                            (str (:note (:reg/authority-resolved %))))
                  (vals us)))))))

(deftest empty-atlas-does-not-break-resolution
  (testing "ooyake を渡さなくても facts 側で答えが出る（依存の非対称性）"
    (let [a (authority/authority-of "USA")]
      (is (= :facts (:source a)))
      (is (seq (:names a))))))
