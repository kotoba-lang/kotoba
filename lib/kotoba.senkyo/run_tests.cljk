;; nbb テストエントリ。
;;   kbb --backend sci --classpath src:test:../tetsuzuki/src run_tests.cljk
;; fleet-ci の `:nbb-test` gate はこれを呼ぶ。
(ns run-tests
  (:require [cljs.test :as t]
            [senkyo.authority-test]
            [senkyo.facts-test]
            [senkyo.procedure-test]
            [senkyo.conformance-test]
            [senkyo.screen-test]))

(defmethod t/report [:cljs.test/default :end-run-tests] [m]
  (println (str "\n" (if (t/successful? m) "PASS" "FAIL")
                " — " (:test m) " tests, " (:pass m) " assertions, "
                (:fail m) " failures, " (:error m) " errors"))
  (when-not (t/successful? m)
    (js/process.exit 1)))

(t/run-tests 'senkyo.facts-test
             'senkyo.screen-test
             'senkyo.procedure-test
             'senkyo.authority-test
             'senkyo.conformance-test)
