(ns senkyo.datoms
  "規制カタログと手続きカタログを **datom 面**へ projection する。

  superproject の `manifest/edn-query.cljs` が読む面と同じ形（属性は裸文字列、
  `\"source/dataset\"` で出自を区別する）にしてあるので、`ooyake` の
  `:gov.unit` や `repo-taxonomy` と 1 クエリで join できる。

  結合キー:
  - `\"senkyo.reg/authority-unit\"` = ooyake の `:gov.unit/id`
  - `\"senkyo.reg/jurisdiction\"`   = ISO3（大文字。ooyake は小文字なので
                                      join 時にどちらかへ揃える）

  **生成物であって正本ではない。** 正本は `senkyo.facts` / `senkyo.procedure` の
  Clojure データで、ここはその射影にすぎない。"
  (:require [kotoba.lang.text :as str]
            [senkyo.facts :as facts]
            [senkyo.procedure :as procedure]))

(def dataset "senkyo")

(defn- reg->datom [iso3 reg-id m]
  (cond-> {"source/dataset" dataset
           "senkyo.reg/id" (str iso3 "/" (name reg-id))
           "senkyo.reg/jurisdiction" iso3
           "senkyo.reg/category" (name (:reg/category m))
           "senkyo.reg/decision" (name (:reg/decision m))
           "senkyo.reg/name" (:reg/name m)
           "senkyo.reg/legal-basis" (:reg/legal-basis m)
           "senkyo.reg/authority" (:reg/authority m)
           "senkyo.reg/confidence" (name (:reg/confidence m))
           "senkyo.reg/verified" (:reg/verified m)
           "senkyo.reg/media" (str/join "," (sort (map name (:reg/media m))))}
    (:reg/authority-unit m) (assoc "senkyo.reg/authority-unit" (:reg/authority-unit m))
    (:reg/evidence-key m) (assoc "senkyo.reg/evidence-key" (:reg/evidence-key m))
    (:reg/penalty m) (assoc "senkyo.reg/penalty" (:reg/penalty m))
    (seq (:reg/source-urls m)) (assoc "senkyo.reg/source-url"
                                      (first (:reg/source-urls m)))))

(defn- proc->datom [iso3 proc-id p]
  (cond-> {"source/dataset" dataset
           "senkyo.proc/id" (str iso3 "/" (name proc-id))
           "senkyo.proc/jurisdiction" iso3
           "senkyo.proc/name" (:proc/name p)
           "senkyo.proc/actor" (name (:proc/actor p))
           "senkyo.proc/authority" (:proc/authority p)
           "senkyo.proc/legal-basis" (:proc/legal-basis p)
           "senkyo.proc/confidence" (name (:proc/confidence p))}
    (:proc/authority-unit p) (assoc "senkyo.proc/authority-unit" (:proc/authority-unit p))
    (:proc/received-by p) (assoc "senkyo.proc/received-by" (name (:proc/received-by p)))
    (:proc/deadline p) (assoc "senkyo.proc/deadline-anchor"
                              (name (:anchor (:proc/deadline p)))
                              "senkyo.proc/deadline-offset-days"
                              (:offset-days (:proc/deadline p))
                              "senkyo.proc/deadline-direction"
                              (name (:direction (:proc/deadline p))))))

(defn coverage-datom
  "**未索引を申告する entity。** 収録法域数だけを見せて世界を覆っているように
  読ませないために、カバレッジ自身を 1 entity として面に載せる
  （concept 索引の `:concept/coverage` と同じ規律）。"
  []
  (let [fc (facts/coverage) pc (procedure/coverage)]
    {"source/dataset" dataset
     "senkyo.coverage/id" "senkyo-coverage"
     "senkyo.coverage/regulation-jurisdictions" (count (:jurisdictions fc))
     "senkyo.coverage/instruments" (:instruments fc)
     "senkyo.coverage/procedure-jurisdictions" (count (:jurisdictions pc))
     "senkyo.coverage/procedures" (:procedures pc)
     "senkyo.coverage/uncovered-large" (str/join "," (map #(subs % 0 3) (:uncovered-large fc)))
     "senkyo.coverage/note" (:note fc)}))

(defn all
  "面に載せる entity 全部（regulation + procedure + coverage）。"
  []
  (vec (concat
        (for [[iso3 insts] facts/regulations [rid m] insts] (reg->datom iso3 rid m))
        (for [[iso3 ps] procedure/procedures [pid p] ps] (proc->datom iso3 pid p))
        [(coverage-datom)])))
