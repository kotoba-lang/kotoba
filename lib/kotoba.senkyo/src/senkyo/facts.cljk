;; ── 未収録の大人口法域（正直なカバレッジ報告のため名指しで持つ）────────

(def uncovered-large-jurisdictions
  "人口 1 億超で**未収録**の法域。収録法域数だけを見せて世界を覆っているように
  読ませないために名指しで持つ。`okugai.facts` と同じ規律。"
  [{:iso3 "IND" :name "India" :population 1428000000}
   {:iso3 "CHN" :name "China" :population 1425000000}
   {:iso3 "IDN" :name "Indonesia" :population 277000000}
   {:iso3 "PAK" :name "Pakistan" :population 240000000}
   {:iso3 "NGA" :name "Nigeria" :population 223000000}
   {:iso3 "BRA" :name "Brazil" :population 216000000}
   {:iso3 "BGD" :name "Bangladesh" :population 173000000}
   {:iso3 "RUS" :name "Russia" :population 144000000}
   {:iso3 "MEX" :name "Mexico" :population 128000000}
   {:iso3 "ETH" :name "Ethiopia" :population 127000000}
   {:iso3 "PHL" :name "Philippines" :population 117000000}
   {:iso3 "EGY" :name "Egypt" :population 113000000}])

(defn coverage
  "正直なカバレッジ報告。収録法域・instrument 数・未収録の大人口法域を返す。"
  []
  (let [covered (vec (sort (keys regulations)))
        n-inst (reduce + (map count (vals regulations)))]
    {:jurisdictions covered
     :count (count covered)
     :instruments n-inst
     :uncovered-large (mapv (fn [e] (str (:iso3 e) " (" (:name e) ", "
                                         (quot (:population e) 1000000) "M)"))
                            uncovered-large-jurisdictions)
     :note (str "収録 " (count covered) " 法域 / " n-inst " instrument。"
                "未収録の法域は spec-basis 無し —— advisor は要件を創作してはならず、"
                "governor は運動提案を保留する。人口 1 億超で未収録の法域が "
                (count uncovered-large-jurisdictions) " ある。"
                "**EU レベルの選挙運動規制は存在しない** —— DEU は加盟国法として収録した。"
                "米国は連邦（FEC）と州・自治体が別系統で、この表が持つのは連邦分だけ。")}))

;; ── 参照 ────────────────────────────────────────────────────────────

(defn jurisdiction-covered? [iso3] (contains? regulations iso3))

(defn instruments
  "`iso3` の instrument 全部。未収録法域は `nil`（空 map ではない —— 「規制が無い」と
  「知らない」を同じ値にしない）。"
  [iso3]
  (get regulations iso3))

(defn instrument [iso3 reg-id] (get-in regulations [iso3 reg-id]))

(defn for-medium
  "`iso3` で `medium-id` に効きうる instrument の {id instrument} map。
  `:reg/media` が空集合の instrument（手段に紐づかない寄附規制など）は含めない。
  未収録法域は `nil`。"
  [iso3 medium-id]
  (when-let [insts (instruments iso3)]
    (into {} (filter (fn [[_ m]] (contains? (:reg/media m) medium-id)) insts))))

(defn high-confidence-only
  "`:reg/confidence` が `:high` の instrument だけに絞る。"
  [inst-map]
  (into {} (filter (fn [[_ m]] (= :high (:reg/confidence m))) inst-map)))

(defn evidence-keys
  "instrument 群が要求する証跡キー（nil を除く）。"
  [inst-map]
  (vec (sort (remove nil? (map (comp :reg/evidence-key val) inst-map)))))

(defn authority-units
  "instrument 群が指す ooyake の `gov.unit/id`（`senkyo.authority` で join する）。
  `nil`（＝国レベルに所管が無い / 自治体が決める）は除く。"
  [inst-map]
  (vec (sort (distinct (remove nil? (map (comp :reg/authority-unit val) inst-map))))))

(defn describe [iso3 reg-id]
  (when-let [m (instrument iso3 reg-id)]
    (str iso3 " " (name reg-id) " — " (:reg/name m)
         " [" (name (:reg/category m)) "/" (name (:reg/decision m)) "] "
         (:reg/legal-basis m)
         (when (= :medium (:reg/confidence m)) " (confidence: medium — 原文確認要)"))))

(defn category-index
  "普遍カテゴリ -> それを担う {iso3 [reg-id ...]}。カテゴリが法域を跨いで
  同じ問いを指していることを確認するための逆引き。"
  []
  (reduce
   (fn [acc [iso3 insts]]
     (reduce (fn [a [rid m]] (update-in a [(:reg/category m) iso3] (fnil conj []) rid))
             acc insts))
   {} regulations))

(defn assert-categories-are-universal
  "全 instrument の `:reg/category` が `senkyo.medium/categories` に収まっているか。
  収まっていない id の集合を返す（空なら健全）。"
  []
  (into #{} (remove medium/categories
                    (map :reg/category (mapcat vals (vals regulations))))))
