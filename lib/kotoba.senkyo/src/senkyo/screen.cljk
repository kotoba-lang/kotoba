(ns senkyo.screen
  "**適法性 screen** —— 「この法域で、この手段を、この条件で使ってよいか」に
  5 値で答え、要求される証跡と、まだ決まらない点を返す。

  ## 判定は 5 値。`:permitted` を既定値にしない

  | verdict | 意味 |
  |---|---|
  | `:no-spec-basis` | その法域の規制カタログが無い。**「規制が無い」ではない** |
  | `:prohibited` | その手段自体が禁じられている（日本の戸別訪問など） |
  | `:undetermined` | 属性が足りず決まらない項目が残っている |
  | `:permitted-with-obligations` | 使ってよいが、履行すべき義務と証跡がある |
  | `:permitted` | 義務も未決も無い（実際にはほとんど出ない） |

  **`:undetermined` を `:permitted` に倒さない。** 分からないことは分からない
  ままにして、governor に保留させる。これが `okugai.facts` の「不明を『不要』に
  倒さない」と同じ規律である。

  ## この層が構造的に答えないこと（compliance-first の境界）

  `out-of-scope-intents` は **この repo が持たない語彙**を閉じた集合として
  宣言する。有権者個人のターゲティング、投票誘導の話法、候補者の優劣評価、
  配布・貼付の実行指揮 —— これらは「まだ実装していない」のではなく、
  **設計として持たない**。消費側の actor（`cloud-itonami-isic-9492` /
  `cloud-itonami-isic-8411-electoral`）はこの集合を governor の deny 側に
  そのまま使い、提案語彙にこれらを構築する経路を持たない。

  なぜ集合を**この共有ライブラリ側**に置くか: 境界を各 actor に書くと、actor が
  増えるたびに文言が分岐して、どれが正か分からなくなる。境界は 1 か所で定義し、
  全 consumer が同じ集合を参照する。"
  (:require [kotoba.lang.text :as str]
            [senkyo.facts :as facts]
            [senkyo.medium :as medium]))

;; ── 構造的に扱わない意図 ────────────────────────────────────────────

(def out-of-scope-intents
  "**この repo と、これを消費する actor が構造的に持たない意図。**
  「未実装」ではなく「設計として持たない」。governor はこれを deny 側の
  closed allowlist に使う。

  - `:voter-targeting`        有権者個人・世帯を対象に選別・名簿化すること
  - `:vote-persuasion-script` 投票行動を変えさせるための話法・台本の生成
  - `:candidate-ranking`      候補者・政党の優劣評価やランキング
  - `:turnout-operation`      投票する/しないを個人単位で動かす運用（GOTV 型）
  - `:distribution-dispatch`  配布・貼付・訪問の実行指揮（誰がどこへ行くか）
  - `:opinion-profiling`      政治的信条のプロファイリング・推定
  - `:eligibility-adjudication` 被選挙権・有効投票・当落の裁定"
  #{:voter-targeting :vote-persuasion-script :candidate-ranking
    :turnout-operation :distribution-dispatch :opinion-profiling
    :eligibility-adjudication})

(defn check-intent
  "意図が扱える範囲か。`:in-scope`、または理由つきの out-of-scope map。"
  [intent]
  (if (contains? out-of-scope-intents intent)
    {:out-of-scope intent
     :reason (str (name intent)
                  " はこのライブラリと消費側 actor が構造的に持たない意図である。"
                  "risk level で緩和されるゲートではなく、提案語彙に構築経路が無い。")}
    :in-scope))

(defn any-out-of-scope
  "意図の集合から out-of-scope なものを返す（空なら健全）。"
  [intents]
  (vec (sort (filter out-of-scope-intents intents))))

;; ── 1 instrument の判定 ─────────────────────────────────────────────

(defn- decide-one
  "1 instrument が `attrs` の下でどうなるか。
  `{:status :satisfied|:obligation|:blocking|:unknown|:informational :why \"...\"}`"
  [{:keys [reg/decision reg/condition reg/name] :as _inst}
   {:keys [within-campaign-period? local-authority-confirmed?] :as attrs}]
  (case decision
    :prohibited
    {:status :blocking
     :why (str name " —— この法域ではこの手段自体が禁じられている。条件を足しても解けない。")}

    :protected
    {:status :informational
     :why (str name " —— 積極的に保護されている。許可の取得を前提にしないこと。")}

    :always
    {:status :obligation
     :why (str name " —— この手段を使う以上、常に履行と証跡が要る。")}

    :window
    (cond
      (nil? within-campaign-period?)
      {:status :unknown
       :why (str name " —— 法定期間内かが与えられていない（`:within-campaign-period?`）。")}
      within-campaign-period?
      {:status :obligation
       :why (str name " —— 期間内。期間の起点・終点の記録を証跡として残すこと。")}
      :else
      {:status :blocking
       :why (str name " —— 法定期間外。期間外の運動はこの法域で違法。")})

    :conditional
    (let [v (get attrs condition)]
      (cond
        (nil? v) {:status :unknown
                  :why (str name " —— 条件 `" (str condition) "` の値が与えられていない。")}
        v {:status :obligation
           :why (str name " —— 条件が成立している。義務が生じる。")}
        :else {:status :satisfied
               :why (str name " —— 条件が成立しないので、この instrument は効かない。")}))

    :local
    (if local-authority-confirmed?
      {:status :obligation
       :why (str name " —— 下位当局の要件を確認済みとして扱う。確認先と回答を証跡に残すこと。")}
      {:status :unknown
       :why (str name " —— 国レベルでは決まらない。下位の自治体・州に当たること（`:local-authority-confirmed?`）。")})

    ;; 未知の decision 語彙は握り潰さず unknown にする
    {:status :unknown :why (str name " —— 未知の decision 語彙: " (str decision))}))

;; ── screen 本体 ─────────────────────────────────────────────────────

(defn screen
  "`{:iso3 .. :medium .. :attrs {..} :intents #{..} :require-high-confidence? bool}`
  を受けて verdict を返す。

  `:require-high-confidence?` が true のとき、`:reg/confidence` が `:high` でない
  instrument は判定から**除外せず**、`:deferred` として別枠で返す —— 除外して
  しまうと「その義務は無い」と読めてしまうため。"
  [{:keys [iso3 medium attrs intents require-high-confidence?]
    :or {attrs {} intents #{}}}]
  (let [oos (any-out-of-scope intents)
        insts (facts/for-medium iso3 medium)]
    (cond
      (seq oos)
      {:iso3 iso3 :medium medium :verdict :out-of-scope
       :out-of-scope oos
       :note (str "扱わない意図が含まれている: " (str/join ", " (map name oos))
                  "。screen は実行されない。")}

      (not (facts/jurisdiction-covered? iso3))
      {:iso3 iso3 :medium medium :verdict :no-spec-basis
       :findings [] :required-evidence [] :unknown []
       :note (str iso3 " の規制カタログが senkyo に無い。**spec-basis 無しは"
                  "「規制が無い」ではない。** 要件を創作してはならず、"
                  "governor はこの提案を保留すること。")}

      (nil? (medium/triggers medium))
      {:iso3 iso3 :medium medium :verdict :no-spec-basis
       :findings [] :required-evidence [] :unknown []
       :note (str "未知の手段: " (str medium) "。`senkyo.medium/media` に無い。")}

      :else
      (let [deferred (when require-high-confidence?
                       (remove (fn [[_ m]] (= :high (:reg/confidence m))) insts))
            active (if require-high-confidence? (facts/high-confidence-only insts) insts)
            findings (mapv (fn [[rid m]]
                             (merge {:reg-id rid
                                     :category (:reg/category m)
                                     :decision (:reg/decision m)
                                     :legal-basis (:reg/legal-basis m)
                                     :authority (:reg/authority m)
                                     :authority-unit (:reg/authority-unit m)
                                     :confidence (:reg/confidence m)
                                     :evidence-key (:reg/evidence-key m)}
                                    (decide-one m attrs)))
                           (sort-by key active))
            blocking (filterv #(= :blocking (:status %)) findings)
            unknown (filterv #(= :unknown (:status %)) findings)
            obligations (filterv #(= :obligation (:status %)) findings)
            verdict (cond
                      (seq blocking) :prohibited
                      (seq unknown) :undetermined
                      (seq obligations) :permitted-with-obligations
                      :else :permitted)]
        {:iso3 iso3 :medium medium
         :verdict verdict
         :findings findings
         :blocking blocking
         :unknown unknown
         :required-evidence (vec (sort (remove nil? (map :evidence-key obligations))))
         :deferred (vec (sort-by (comp str :reg-id)
                                 (map (fn [[rid m]]
                                        {:reg-id rid :confidence (:reg/confidence m)
                                         :legal-basis (:reg/legal-basis m)
                                         :why "confidence が :high でないため保留枠。除外ではない —— 原文で確認して判断すること。"})
                                      deferred)))
         :note (case verdict
                 :prohibited
                 (str "この法域ではこの手段を使えない。blocking: "
                      (str/join "; " (map :why blocking)))
                 :undetermined
                 (str "決まらない項目が " (count unknown) " 件残っている。"
                      "**`:undetermined` を「適法」として扱わないこと。**")
                 :permitted-with-obligations
                 (str "使えるが " (count obligations) " 件の義務がある。"
                      "証跡: " (str/join ", " (sort (remove nil? (map :evidence-key obligations)))))
                 "義務も未決も無い。")}))))

(defn screen-plan
  "複数手段の計画をまとめて screen する。
  `{:iso3 .. :media [..] :attrs {..} :intents #{..}}`

  計画全体の verdict は**最も悪い**個別 verdict になる（1 つでも禁止手段が
  混ざっていれば計画は通らない）。"
  [{:keys [iso3 media attrs intents require-high-confidence?] :or {media [] attrs {} intents #{}}}]
  (let [results (mapv #(screen {:iso3 iso3 :medium % :attrs attrs :intents intents
                                :require-high-confidence? require-high-confidence?})
                      media)
        rank {:out-of-scope 0 :no-spec-basis 1 :prohibited 2 :undetermined 3
              :permitted-with-obligations 4 :permitted 5}
        worst (when (seq results)
                (:verdict (apply min-key (comp rank :verdict) results)))]
    {:iso3 iso3
     :verdict (or worst :no-spec-basis)
     :per-medium results
     :required-evidence (vec (sort (distinct (mapcat :required-evidence results))))
     :note (str (count results) " 手段を screen した。計画の verdict は最も悪い"
                "個別 verdict（" (str worst) "）—— 1 つでも通らない手段が"
                "混ざっていれば計画は通らない。")}))
