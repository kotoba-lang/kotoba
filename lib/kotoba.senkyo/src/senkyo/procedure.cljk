;; ── 参照と期限計算 ──────────────────────────────────────────────────

(defn jurisdiction-covered? [iso3] (contains? procedures iso3))

(defn for-jurisdiction
  "`iso3` の手続き全部。未収録法域は `nil`。"
  [iso3]
  (get procedures iso3))

(defn procedure [iso3 proc-id] (get-in procedures [iso3 proc-id]))

(defn by-actor
  "`iso3` で `actor`（`:candidate` / `:agent` 等）が負う手続き。"
  [iso3 actor]
  (when-let [ps (for-jurisdiction iso3)]
    (into {} (filter (fn [[_ p]] (= actor (:proc/actor p))) ps))))

(defn received-by-election-authority
  "選挙管理機関・returning officer が**受け取る側**になる手続き。
  受領側 actor（`cloud-itonami-isic-8411-electoral`）が形式審査の対象を
  引くための入口。"
  [iso3]
  (when-let [ps (for-jurisdiction iso3)]
    (into {} (filter (fn [[_ p]] (contains? #{:election-commission :returning-officer}
                                            (:proc/received-by p)))
                     ps))))

(defn due-epoch-day
  "手続きの期限を epoch-day（1970-01-01 = 0）で解く。
  `anchor-epoch-days` は `{:poll-day 20500 :announcement-day 20488 ...}`。

  **算法は `tetsuzuki.deadline` に委譲する。** この repo が自前で持っていた
  実装は、一般行政手続きライブラリ `kotoba-lang/tetsuzuki` へ切り出した
  （ADR-2608079500）。選挙だけが独自の期限算法を持つ理由は無く、持てば
  営業日・暦月・徒過効果の扱いが分野ごとに分岐する。

  返り値（`tetsuzuki.deadline/resolve-deadline` と同じ）:
  - 整数              解けた期限
  - `:no-deadline`    この層では期限が決まらない（`:proc/deadline` が nil）
  - `:unknown-anchor` 基準日が与えられていない

  選挙の手続きは全件が暦日・提出側なので、実際に出るのはこの 3 つだけ
  である（`:needs-business-calendar` / `:needs-calendar-date` は一般行政側
  で出る）。**`:unknown-anchor` を「期限なし」に倒さない。**"
  [{:keys [proc/deadline]} anchor-epoch-days]
  (tdeadline/resolve-deadline deadline {:anchors anchor-epoch-days}))

(defn schedule
  "`iso3` の全手続きについて期限を解いた一覧。未解決のものも落とさずに返す
  （落とすと「期限が無い」と読めてしまうため）。"
  [iso3 anchor-epoch-days]
  (when-let [ps (for-jurisdiction iso3)]
    (->> ps
         (map (fn [[pid p]]
                {:id pid
                 :name (:proc/name p)
                 :actor (:proc/actor p)
                 :due (due-epoch-day p anchor-epoch-days)
                 :confidence (:proc/confidence p)
                 :received-by (:proc/received-by p)}))
         (sort-by (fn [m] [(if (integer? (:due m)) 0 1)
                           (if (integer? (:due m)) (:due m) 0)
                           (str (:id m))]))
         vec)))

(defn unresolved
  "`schedule` のうち期限が解けなかったもの。**呼び出し側はこれを空にしてから
  「期限管理ができている」と言うこと。**"
  [sched]
  (vec (remove (comp integer? :due) sched)))

(defn coverage []
  (let [covered (vec (sort (keys procedures)))
        n (reduce + (map count (vals procedures)))
        low (for [[iso3 ps] procedures [pid p] ps
                  :when (not= :high (:proc/confidence p))]
              (str iso3 "/" (name pid)))]
    {:jurisdictions covered
     :count (count covered)
     :procedures n
     :needs-source-check (vec (sort low))
     :note (str "収録 " (count covered) " 法域 / " n " 手続き。うち "
                (count low) " 件は :proc/confidence が :high でない —— "
                "**期限を1日間違えると失権や罰則に直結するので、拘束力のある"
                "期限管理の前に必ず原文へ当たること。** 未収録法域は spec-basis "
                "無しであって「手続きが無い」ではない。")}))

(defn describe [iso3 proc-id]
  (when-let [p (procedure iso3 proc-id)]
    (str iso3 " " (name proc-id) " — " (:proc/name p)
         " [" (name (:proc/actor p)) " → " (:proc/authority p) "] "
         (:proc/legal-basis p)
         (when (not= :high (:proc/confidence p)) " (confidence: medium — 原文確認要)"))))
