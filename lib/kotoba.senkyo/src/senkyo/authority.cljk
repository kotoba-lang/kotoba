(ns senkyo.authority
  "**所管当局の解決** —— `senkyo.facts` の instrument が指す当局を、
  `kotoba-lang/ooyake`（World Government Atlas）の `:gov.unit` へ join する層。

  ## なぜこの層が要るのか（この repo が生まれた理由そのもの）

  2026-08-07 の実測: `cloud-itonami-isic-9492`（政治団体 actor）は所管当局を
  `\"Federal Election Commission (FEC)\"` という**文字列**で持っており、ooyake が
  同じ当局を `gov.usa.electoral` + Wikidata QID + 公式 URL で持っていることと
  **何一つ結び付いていなかった**。両者を突き合わせる手段が無いので、
  「この法域の規制」と「この法域の選管」が別々に増えていく。

  この ns は文字列でなく **join key** を持つ。ただし **ooyake が完全であることに
  依存しない** —— 当局の名前・公式 URL・根拠法は `senkyo.facts` 側が一次情報として
  持ち、ooyake の unit-id は**任意の join key**として重ねるだけである。片方が
  欠けてももう片方は動く。

  ## atlas の欠落を隠さない

  実測（2026-08-07、ooyake `registry/gov-units.oversight-electoral.edn`）:
  **選挙管理機関 63 件が収録されているが、senkyo が規制を収録した 5 法域のうち
  atlas に unit があるのは USA と GBR の 2 つだけで、JPN・DEU・CAN は無い。**
  逆に atlas 側の 63 件のうち 61 件は senkyo に規制カタログが無い。

  `join-report` はこれを両方向で数えて返す。**「join できた分だけ」を見せて
  統合されているように読ませない。**"
  (:require [kotoba.lang.text :as str]
            [senkyo.facts :as facts]))

;; ── ooyake の id 規約 ───────────────────────────────────────────────

(defn unit-id
  "ISO3（大文字）-> ooyake の `:gov.unit/id` 規約。
  ooyake は小文字 iso3 を使う（`gov.usa.electoral`）。"
  [iso3]
  (str "gov." (str/lower iso3) ".electoral"))

(defn atlas-did
  "ooyake の `:gov.unit/atlas-did` 規約。"
  [iso3]
  (str "did:web:etzhayyim.com:gov:" (str/lower iso3)
       ":agency:electoral-commission"))

;; ── 2026-08-07 実測の atlas 欠落 ────────────────────────────────────

(def atlas-absent-as-of-2026-08-07
  "senkyo が規制を収録しているのに ooyake の electoral registry に unit が
  無かった法域（実測日付つき）。**この定数は観測であって仕様ではない** ——
  ooyake 側に unit が足された時点で古くなるので、実行時は必ず
  `join-report` に実データを渡して数え直すこと。"
  #{"JPN" "DEU" "CAN"})

;; ── 解決 ────────────────────────────────────────────────────────────

(defn index-atlas
  "ooyake の `:gov.unit` map の seq を `{unit-id unit}` に索引する。
  consumer が ooyake の registry EDN を読んで渡す（この repo は ooyake に
  依存しない —— この repo に ooyake への依存を持ち込まないため、データは
  注入させる）。"
  [units]
  (into {} (map (juxt :gov.unit/id identity)) units))

(defn resolve-unit
  "`iso3` の選挙管理機関を atlas 索引から引く。無ければ `nil`。"
  [atlas-index iso3]
  (get atlas-index (unit-id iso3)))

(defn authority-of
  "`iso3` の当局を、**atlas があればそれで、無ければ facts の一次情報で**返す。
  どちらから来た答えかを `:source` で明示する（`:atlas` / `:facts` / `:none`）。

  `:facts` 側は instrument が持つ `:reg/authority` 文字列を集約したもの ——
  Wikidata QID も公式 URL も持たないので、**atlas に無い法域は当局の同定が弱い**
  ことがこの戻り値から読み取れる。"
  ([iso3] (authority-of {} iso3))
  ([atlas-index iso3]
   (if-let [u (resolve-unit atlas-index iso3)]
     {:source :atlas
      :iso3 iso3
      :unit-id (:gov.unit/id u)
      :name-en (:gov.unit/name-en u)
      :name-local (:gov.unit/name-local u)
      :official-url (:gov.unit/official-url u)
      :wikidata (:gov.unit/wikidata u)
      :atlas-did (:gov.unit/atlas-did u)}
     (if-let [insts (facts/instruments iso3)]
       {:source :facts
        :iso3 iso3
        :unit-id (unit-id iso3)
        :names (vec (sort (distinct (remove nil? (map (comp :reg/authority val) insts)))))
        :note (str "ooyake の electoral registry に " (unit-id iso3)
                   " が無い。当局名は senkyo.facts の一次情報のみで、"
                   "Wikidata QID / 公式 URL による同定は付いていない。")}
       {:source :none
        :iso3 iso3
        :note (str iso3 " は senkyo にも ooyake にも収録が無い。"
                   "spec-basis 無し —— 要件を創作してはならない。")}))))

(defn attach-authorities
  "instrument map（`facts/for-medium` の戻り）の各 instrument に、解決済みの
  当局を `:reg/authority-resolved` として重ねる。"
  [atlas-index inst-map]
  (into {}
        (map (fn [[rid m]]
               [rid (if-let [uid (:reg/authority-unit m)]
                      (assoc m :reg/authority-resolved
                             (or (get atlas-index uid)
                                 {:unresolved uid
                                  :note "atlas に unit が無い。facts の :reg/authority を使う。"}))
                      (assoc m :reg/authority-resolved
                             {:unresolved nil
                              :note "国レベルに所管が無い（:local）。下位の自治体・州に当たる。"}))]))
        inst-map))

;; ── 両方向のカバレッジ報告 ──────────────────────────────────────────

(defn join-report
  "senkyo の規制カタログと ooyake の選挙管理機関 atlas の**両方向**のずれを数える。

  - `:senkyo-only` senkyo に規制はあるが atlas に unit が無い法域
  - `:atlas-only`  atlas に選管はあるが senkyo に規制カタログが無い法域
  - `:joined`      両方にある法域

  片方向だけ数えると「join できた分」しか見えない。統合の現在地は
  **両方の穴**である。"
  [units]
  (let [atlas-index (index-atlas units)
        atlas-iso3 (into #{} (comp (map :gov.unit/jurisdiction)
                                   (remove nil?)
                                   (map str/upper))
                         units)
        senkyo-iso3 (into #{} (keys facts/regulations))
        joined (sort (filter #(resolve-unit atlas-index %) senkyo-iso3))
        senkyo-only (sort (remove #(resolve-unit atlas-index %) senkyo-iso3))
        atlas-only (sort (remove senkyo-iso3 atlas-iso3))]
    {:joined (vec joined)
     :senkyo-only (vec senkyo-only)
     :atlas-only (vec atlas-only)
     :counts {:senkyo (count senkyo-iso3)
              :atlas (count atlas-iso3)
              :joined (count joined)}
     :note (str "senkyo " (count senkyo-iso3) " 法域 / atlas " (count atlas-iso3)
                " 法域 のうち join できたのは " (count joined) " 法域。"
                "senkyo にあって atlas に無い: " (str/join ", " senkyo-only) "。"
                "atlas にあって senkyo に規制カタログが無い: " (count atlas-only)
                " 法域。**この 2 つの穴が統合の現在地であり、join できた数だけを"
                "報告するのは嘘になる。**")}))
