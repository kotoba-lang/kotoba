{:schema "kotoba.connector.repository.v1",
 :connector/docs-url
 "https://developers.google.com/gmail/api/reference/rest",
 :connector/origin-domain "google.com",
 :connector/base-scopes ["openid" "email"],
 :connector/id "com.google.gmail",
 :connector/var "provider",
 :connector/scopes
 ["email"
  "https://www.googleapis.com/auth/gmail.modify"
  "https://www.googleapis.com/auth/gmail.readonly"
  "https://www.googleapis.com/auth/gmail.send"
  "openid"],
 :authority
 "90-docs/adr/2608097000-connector-plane-one-repo-per-connector.edn",
 :connector/namespace "google-gmail.connector",
 :connector/auth-kind :oauth2,
 :connector/auth-pkce? true,
 :connector/summary
 "Search a mailbox, read a message, file it under labels, send mail.",
 :connector/name "Gmail",
 :connector/client-id-env "GOOGLE_CLIENT_ID",
 :connector/tools
 [{:connector/name "gmail_get_message",
   :connector/effect :read,
   :connector/scopes
   ["https://www.googleapis.com/auth/gmail.readonly"],
   :connector/description
   "One message: headers always, body when format is \"full\"."}
  {:connector/name "gmail_list_labels",
   :connector/effect :read,
   :connector/scopes
   ["https://www.googleapis.com/auth/gmail.readonly"],
   :connector/description "The mailbox's labels, with their ids."}
  {:connector/name "gmail_modify_labels",
   :connector/effect :write,
   :connector/scopes ["https://www.googleapis.com/auth/gmail.modify"],
   :connector/description
   "File a message: add and/or remove labels. Moving to TRASH is reversible; nothing here deletes permanently."}
  {:connector/name "gmail_search_messages",
   :connector/effect :read,
   :connector/scopes
   ["https://www.googleapis.com/auth/gmail.readonly"],
   :connector/description
   "Search the mailbox with Gmail query syntax, e.g. from:jun@example.com is:unread newer_than:7d."}
  {:connector/name "gmail_send_message",
   :connector/effect :write,
   :connector/scopes ["https://www.googleapis.com/auth/gmail.send"],
   :connector/description
   "Send a message. `raw` is the RFC 5322 message, base64url-encoded, as the Gmail API requires."}]}
