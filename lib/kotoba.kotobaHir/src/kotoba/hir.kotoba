(ns kotoba.hir
  "Kotoba HIR envelope validation over Kotoba's recursive Form representation.
  The public result is :ok or a stable problem keyword; this module has no
  host exception or collection semantics."
  {:kotoba/export [module-problem validate! valid?]}
  (:schemas {:form/r [:record :form/r [[:tag :i64] [:s :string] [:n :i64] [:k :keyword]
                                      [:kids [:list [:ref :form/r]]] [:span :i64] [:data :bytes]]]
             :form/rd [:record :form/rd [[:form [:ref :form/r]] [:pos :i64]]]}))

(defn- nil-form [] [:ref :form/r]
  (record-new [:ref :form/r] 0 "" 0 :none
              (typed-list-new [:list [:ref :form/r]]) 0 (bytes-empty)))

(defn- tag-of [value [:ref :form/r]] :i64
  (record-get [:ref :form/r] value :tag))

(defn- kids-of [value [:ref :form/r]] [:list [:ref :form/r]]
  (record-get [:ref :form/r] value :kids))

(defn- int-value [value [:ref :form/r]] :i64
  (record-get [:ref :form/r] value :n))

(defn- keyword-value [value [:ref :form/r]] :keyword
  (record-get [:ref :form/r] value :k))

(defn- string-value [value [:ref :form/r]] :string
  (record-get [:ref :form/r] value :s))

(defn- is-nil? [value [:ref :form/r]] :bool (= 0 (tag-of value)))
(defn- is-bool? [value [:ref :form/r]] :bool (= 1 (tag-of value)))
(defn- is-int? [value [:ref :form/r]] :bool (= 2 (tag-of value)))
(defn- is-string? [value [:ref :form/r]] :bool (= 3 (tag-of value)))
(defn- is-keyword? [value [:ref :form/r]] :bool (= 4 (tag-of value)))
(defn- is-symbol? [value [:ref :form/r]] :bool (= 5 (tag-of value)))
(defn- is-vec? [value [:ref :form/r]] :bool (= 7 (tag-of value)))
(defn- is-set? [value [:ref :form/r]] :bool (= 8 (tag-of value)))
(defn- is-map? [value [:ref :form/r]] :bool (= 9 (tag-of value)))

(defn- count-of [value [:ref :form/r]] :i64
  (vector-count (kids-of value)))

(defn- nth-of [value [:ref :form/r] i :i64] [:ref :form/r]
  (if (and (>= i 0) (< i (count-of value)))
    (typed-list-nth [:list [:ref :form/r]] (kids-of value) i)
    (nil-form)))

;; HIR map keys, function names, parameters and effect members only need
;; keyword, symbol, integer and ordered type-form equality.
(defn- ordered-items-equal? [left [:list [:ref :form/r]] right [:list [:ref :form/r]] i :i64] :bool
  (if (not (= (vector-count left) (vector-count right)))
    false
    (if (>= i (vector-count left))
      true
      (and (eq (typed-list-nth [:list [:ref :form/r]] left i)
               (typed-list-nth [:list [:ref :form/r]] right i))
           (ordered-items-equal? left right (+ i 1))))))

(defn- eq [left [:ref :form/r] right [:ref :form/r]] :bool
  (let [tag (tag-of left)]
    (and (= tag (tag-of right))
         (cond
           (= tag 0) true
           (= tag 1) (= (record-get [:ref :form/r] left :n) (record-get [:ref :form/r] right :n))
           (= tag 2) (= (int-value left) (int-value right))
           (= tag 3) (string=? (string-value left) (string-value right))
           (= tag 4) (= (keyword-value left) (keyword-value right))
           (= tag 5) (string=? (string-value left) (string-value right))
           (or (= tag 6) (= tag 7))
           (ordered-items-equal? (kids-of left) (kids-of right) 0)
           :else false))))

(defn- keyword-form [key :keyword] [:ref :form/r]
  (record-new [:ref :form/r] 4 "" 0 key
              (typed-list-new [:list [:ref :form/r]]) 0 (bytes-empty)))

(defn- form-get [m [:ref :form/r] key [:ref :form/r]] [:ref :form/r]
  (let [items (kids-of m)
        n (vector-count items)]
    (loop [i 0]
      (if (>= (+ i 1) n)
        (nil-form)
        (if (eq (typed-list-nth [:list [:ref :form/r]] items i) key)
          (typed-list-nth [:list [:ref :form/r]] items (+ i 1))
          (recur (+ i 2)))))))

(defn- form-has? [m [:ref :form/r] key [:ref :form/r]] :bool
  (let [items (kids-of m)
        n (vector-count items)]
    (loop [i 0]
      (if (>= (+ i 1) n)
        false
        (if (eq (typed-list-nth [:list [:ref :form/r]] items i) key)
          true
          (recur (+ i 2)))))))

(defn- is-key? [value [:ref :form/r] key :keyword] :bool
  (eq value (keyword-form key)))

(defn- module-key? [key [:ref :form/r]] :bool
  (or (is-key? key :format) (is-key? key :namespace) (is-key? key :schemas)
      (is-key? key :schema-identities) (is-key? key :entry) (is-key? key :exports)
      (is-key? key :result) (is-key? key :effects) (is-key? key :named-operations)
      (is-key? key :language-profile) (is-key? key :functions)))

(defn- function-key? [key [:ref :form/r]] :bool
  (or (is-key? key :name) (is-key? key :params) (is-key? key :result)
      (is-key? key :effects) (is-key? key :body) (is-key? key :source-name)
      (is-key? key :param-types) (is-key? key :result-inferred?)
      (is-key? key :effects-ceiling) (is-key? key :closure-param-indexes)
      (is-key? key :i64-pair-chain-param-indexes) (is-key? key :closure-result?)
      (is-key? key :lazy-thunk?) (is-key? key :loop-helper?)
      (is-key? key :callable-param-contracts) (is-key? key :callable-result-contract)))

(defn- keys-allowed? [m [:ref :form/r] module? :bool i :i64] :bool
  (if (>= i (count-of m))
    true
    (if (>= (+ i 1) (count-of m))
      false
      (let [key (nth-of m i)
            allowed (if module? (module-key? key) (function-key? key))]
        (and allowed (keys-allowed? m module? (+ i 2)))))))

(defn- has-all-module-keys? [m [:ref :form/r]] :bool
  (and (form-has? m (keyword-form :format))
       (form-has? m (keyword-form :namespace))
       (form-has? m (keyword-form :schemas))
       (form-has? m (keyword-form :schema-identities))
       (form-has? m (keyword-form :entry))
       (form-has? m (keyword-form :exports))
       (form-has? m (keyword-form :result))
       (form-has? m (keyword-form :effects))
       (form-has? m (keyword-form :named-operations))
       (form-has? m (keyword-form :language-profile))
       (form-has? m (keyword-form :functions))))

(defn- has-all-function-keys? [f [:ref :form/r]] :bool
  (and (form-has? f (keyword-form :name))
       (form-has? f (keyword-form :params))
       (form-has? f (keyword-form :result))
       (form-has? f (keyword-form :effects))
       (form-has? f (keyword-form :body))))

(defn- vector-has? [items [:ref :form/r] value [:ref :form/r] i :i64] :bool
  (if (>= i (count-of items))
    false
    (if (eq (nth-of items i) value)
      true
      (vector-has? items value (+ i 1)))))

(defn- vector-unique? [items [:ref :form/r] i :i64 j :i64] :bool
  (if (>= i (count-of items))
    true
    (if (>= j (count-of items))
      (vector-unique? items (+ i 1) (+ i 2))
      (if (eq (nth-of items i) (nth-of items j))
        false
        (vector-unique? items i (+ j 1))))))

(defn- vector-symbols? [items [:ref :form/r] i :i64] :bool
  (if (>= i (count-of items))
    true
    (and (is-symbol? (nth-of items i))
         (vector-symbols? items (+ i 1)))))

(defn- keyword-set? [items [:ref :form/r] i :i64] :bool
  (if (>= i (count-of items))
    true
    (and (is-keyword? (nth-of items i))
         (keyword-set? items (+ i 1)))))

(defn- set-has? [items [:ref :form/r] value [:ref :form/r] i :i64] :bool
  (if (>= i (count-of items))
    false
    (if (eq (nth-of items i) value)
      true
      (set-has? items value (+ i 1)))))

(defn- nonnegative-int? [value [:ref :form/r]] :bool
  (and (is-int? value) (>= (int-value value) 0)))

(defn- effect? [effect [:ref :form/r]] :bool
  (or (is-key? effect :abort)
      (is-key? effect :state)
      (and (is-vec? effect)
           (= 2 (count-of effect))
           (is-key? (nth-of effect 0) :cap/call)
           (nonnegative-int? (nth-of effect 1)))))

(defn- effects-set? [effects [:ref :form/r] i :i64] :bool
  (if (>= i (count-of effects))
    true
    (and (effect? (nth-of effects i))
         (effects-set? effects (+ i 1)))))

(defn- effects-subset? [left [:ref :form/r] right [:ref :form/r] i :i64] :bool
  (if (>= i (count-of left))
    true
    (if (set-has? right (nth-of left i) 0)
      (effects-subset? left right (+ i 1))
      false)))

(defn- optional-bool? [f [:ref :form/r] key :keyword] :bool
  (if (form-has? f (keyword-form key))
    (is-bool? (form-get f (keyword-form key)))
    true))

(defn- result-inferred-valid? [f [:ref :form/r]] :bool
  (if (form-has? f (keyword-form :result-inferred?))
    (let [value (form-get f (keyword-form :result-inferred?))]
      (or (is-nil? value) (is-bool? value)))
    true))

(defn- indexes-valid? [indexes [:ref :form/r] param-count :i64] :bool
  (and (is-vec? indexes)
       (vector-unique? indexes 0 1)
       (indexes-in-range? indexes param-count 0)))

(defn- indexes-in-range? [indexes [:ref :form/r] param-count :i64 i :i64] :bool
  (if (>= i (count-of indexes))
    true
    (let [value (nth-of indexes i)]
      (and (is-int? value)
           (>= (int-value value) 0)
           (< (int-value value) param-count)
           (indexes-in-range? indexes param-count (+ i 1))))))

(defn- map-index-keys-valid? [m [:ref :form/r] param-count :i64 i :i64] :bool
  (if (>= i (count-of m))
    true
    (let [key (nth-of m i)]
      (and (is-int? key)
           (>= (int-value key) 0)
           (< (int-value key) param-count)
           (map-index-keys-valid? m param-count (+ i 2))))))

(defn- portable-children-count [items [:list [:ref :form/r]] depth :i64 total :i64 i :i64] :i64
  (if (>= i (vector-count items))
    total
    (let [next-total (portable-count (typed-list-nth [:list [:ref :form/r]] items i) depth total)]
      (if (< next-total 0)
        -1
        (portable-children-count items depth next-total (+ i 1))))))

(defn- portable-count [value [:ref :form/r] depth :i64 total :i64] :i64
  (let [next-total (+ total 1)
        tag (tag-of value)]
    (if (or (> depth 256) (> next-total 1000000))
      -1
      (cond
        (or (= tag 0) (= tag 1) (= tag 2) (= tag 3) (= tag 4) (= tag 5) (= tag 10)) next-total
        (= tag 6) (portable-children-count (kids-of value) (+ depth 1) next-total 0)
        (= tag 7) (portable-children-count (kids-of value) (+ depth 1) next-total 0)
        (= tag 8) (portable-children-count (kids-of value) (+ depth 1) next-total 0)
        (= tag 9) (if (= (count-of value) (* 2 (quot (count-of value) 2)))
                    (portable-children-count (kids-of value) (+ depth 1) next-total 0)
                    -1)
        :else -1))))

(defn- portable? [value [:ref :form/r]] :bool
  (>= (portable-count value 0 0) 0))

(defn- function-name [functions [:ref :form/r] name [:ref :form/r] i :i64] [:ref :form/r]
  (if (>= i (count-of functions))
    (nil-form)
    (let [f (nth-of functions i)]
      (if (eq (form-get f (keyword-form :name)) name)
        f
        (function-name functions name (+ i 1))))))

(defn- names-unique? [functions [:ref :form/r] i :i64 j :i64] :bool
  (if (>= i (count-of functions))
    true
    (if (>= j (count-of functions))
      (names-unique? functions (+ i 1) (+ i 2))
      (let [left (form-get (nth-of functions i) (keyword-form :name))
            right (form-get (nth-of functions j) (keyword-form :name))]
        (and (not (eq left right))
             (names-unique? functions i (+ j 1)))))))

(defn- function-problem [format [:ref :form/r] f [:ref :form/r]] :keyword
  (if (not (is-map? f))
    :function-not-map
    (if (not (has-all-function-keys? f))
      :missing-function-keys
      (if (not (keys-allowed? f false 0))
        :unknown-function-keys
        (let [name (form-get f (keyword-form :name))
              source-name (form-get f (keyword-form :source-name))
              params (form-get f (keyword-form :params))
              param-types (form-get f (keyword-form :param-types))
              effects (form-get f (keyword-form :effects))
              body (form-get f (keyword-form :body))
              param-count (count-of params)
              ceiling-key (keyword-form :effects-ceiling)
              ceiling (form-get f ceiling-key)
              contracts-key (keyword-form :callable-param-contracts)
              contracts (form-get f contracts-key)
              result-contract (form-get f (keyword-form :callable-result-contract))]
          (cond
            (not (is-symbol? name)) :invalid-function-name
            (not (or (is-nil? source-name) (is-symbol? source-name))) :invalid-source-name
            (not (is-vec? params)) :invalid-parameters
            (not (vector-symbols? params 0)) :invalid-parameters
            (not (vector-unique? params 0 1)) :invalid-parameters
            (not (is-set? effects)) :invalid-effects
            (not (effects-set? effects 0)) :invalid-effects
            (and (form-has? f ceiling-key)
                 (not (and (is-set? ceiling)
                           (effects-set? ceiling 0)
                           (effects-subset? effects ceiling 0)))) :effect-ceiling-exceeded
            (not (result-inferred-valid? f)) :invalid-result-inferred
            (not (optional-bool? f :closure-result?)) :invalid-boolean-annotation
            (not (optional-bool? f :lazy-thunk?)) :invalid-boolean-annotation
            (not (optional-bool? f :loop-helper?)) :invalid-boolean-annotation
            (or (form-has? f (keyword-form :closure-param-indexes))
                (form-has? f (keyword-form :i64-pair-chain-param-indexes)))
              (if (and (or (not (form-has? f (keyword-form :closure-param-indexes)))
                                (indexes-valid? (form-get f (keyword-form :closure-param-indexes)) param-count))
                           (or (not (form-has? f (keyword-form :i64-pair-chain-param-indexes)))
                                (indexes-valid? (form-get f (keyword-form :i64-pair-chain-param-indexes)) param-count)))
                :ok
                :invalid-parameter-indexes)
            (and (is-key? format :kotoba.hir/v3)
                 (not (and (is-vec? param-types) (= param-count (count-of param-types)))))
              :invalid-parameter-types
            (and (is-key? format :kotoba.hir/v2)
                 (form-has? f (keyword-form :param-types))) :v2-parameter-types
            (and (form-has? f contracts-key)
                 (not (and (is-map? contracts) (map-index-keys-valid? contracts param-count 0))))
              :invalid-callable-parameter-contracts
            (is-nil? body) :missing-function-body
            (not (portable? (form-get f (keyword-form :result)))) :non-portable-form
            (and (is-key? format :kotoba.hir/v3) (not (portable? param-types))) :non-portable-form
            (and (not (is-nil? result-contract)) (not (portable? result-contract))) :non-portable-form
            (and (form-has? f contracts-key) (not (portable? contracts))) :non-portable-form
            (not (portable? body)) :non-portable-form
            :else :ok))))))

(defn- functions-problem [format [:ref :form/r] functions [:ref :form/r] i :i64] :keyword
  (if (>= i (count-of functions))
    :ok
    (let [problem (function-problem format (nth-of functions i))]
      (if (= problem :ok)
        (functions-problem format functions (+ i 1))
        problem))))

(defn- exports-valid? [exports [:ref :form/r] functions [:ref :form/r] i :i64] :bool
  (if (>= i (count-of exports))
    true
    (let [export (nth-of exports i)]
      (and (is-symbol? export)
           (not (is-nil? (function-name functions export 0)))
           (exports-valid? exports functions (+ i 1))))))

(defn- named-operations-valid? [ops [:ref :form/r]] :bool
  (and (is-set? ops) (keyword-set? ops 0)))

(defn- function-effects-contain? [functions [:ref :form/r] effect [:ref :form/r] i :i64] :bool
  (if (>= i (count-of functions))
    false
    (if (set-has? (form-get (nth-of functions i) (keyword-form :effects)) effect 0)
      true
      (function-effects-contain? functions effect (+ i 1)))))

(defn- function-effects-in-module? [module-effects [:ref :form/r] functions [:ref :form/r] i :i64 j :i64] :bool
  (if (>= i (count-of functions))
    true
    (let [function-effects (form-get (nth-of functions i) (keyword-form :effects))]
      (if (>= j (count-of function-effects))
        (function-effects-in-module? module-effects functions (+ i 1) 0)
        (and (set-has? module-effects (nth-of function-effects j) 0)
             (function-effects-in-module? module-effects functions i (+ j 1)))))))

(defn- module-effects-in-functions? [module-effects [:ref :form/r] functions [:ref :form/r] i :i64] :bool
  (if (>= i (count-of module-effects))
    true
    (and (function-effects-contain? functions (nth-of module-effects i) 0)
         (module-effects-in-functions? module-effects functions (+ i 1)))))

(defn- module-effects-match? [module-effects [:ref :form/r] functions [:ref :form/r]] :bool
  (and (function-effects-in-module? module-effects functions 0 0)
       (module-effects-in-functions? module-effects functions 0)))

(defn module-problem [hir [:ref :form/r]] :keyword
  (if (not (is-map? hir))
    :module-not-map
    (if (not (has-all-module-keys? hir))
      :missing-module-keys
      (if (not (keys-allowed? hir true 0))
        :unknown-module-keys
        (let [format (form-get hir (keyword-form :format))
              namespace (form-get hir (keyword-form :namespace))
              schemas (form-get hir (keyword-form :schemas))
              identities (form-get hir (keyword-form :schema-identities))
              entry (form-get hir (keyword-form :entry))
              exports (form-get hir (keyword-form :exports))
              result (form-get hir (keyword-form :result))
              effects (form-get hir (keyword-form :effects))
              named-ops (form-get hir (keyword-form :named-operations))
              profile (form-get hir (keyword-form :language-profile))
              functions (form-get hir (keyword-form :functions))
              entry-function (if (is-symbol? entry) (function-name functions entry 0) (nil-form))
              function-problem* (if (is-vec? functions) (functions-problem format functions 0) :invalid-functions)]
          (cond
            (not (or (is-key? format :kotoba.hir/v2) (is-key? format :kotoba.hir/v3))) :unsupported-format
            (not (or (is-nil? namespace) (is-symbol? namespace))) :invalid-namespace
            (and (is-vec? functions) (= 0 (count-of functions)) (is-nil? namespace)) :empty-library-namespace
            (not (or (is-nil? schemas) (is-map? schemas))) :invalid-schemas
            (not (or (is-nil? identities) (is-map? identities))) :invalid-schema-identities
            (not (or (is-nil? profile) (is-keyword? profile))) :invalid-language-profile
            (not (is-vec? functions)) :invalid-functions
            (not (= function-problem* :ok)) function-problem*
            (not (names-unique? functions 0 1)) :duplicate-function-names
            (not (is-vec? exports)) :invalid-exports
            (not (vector-symbols? exports 0)) :invalid-exports
            (not (vector-unique? exports 0 1)) :invalid-exports
            (not (exports-valid? exports functions 0)) :invalid-exports
            (and (not (is-nil? entry))
                 (or (not (is-symbol? entry))
                     (is-nil? entry-function)
                     (not (vector-has? exports entry 0)))) :invalid-entry
            (and (is-nil? entry) (not (is-nil? result))) :entryless-result
            (and (is-symbol? entry)
                 (not (eq result (form-get entry-function (keyword-form :result))))) :entry-result-mismatch
            (not (is-set? effects)) :invalid-effects
            (not (effects-set? effects 0)) :invalid-effects
            (not (module-effects-match? effects functions)) :module-effects-mismatch
            (not (named-operations-valid? named-ops)) :invalid-named-operations
            (not (portable? schemas)) :non-portable-form
            (not (portable? identities)) :non-portable-form
            :else :ok))))))

(defn validate! "Return :ok or the first stable validation problem keyword."
  [hir [:ref :form/r]] :keyword
  (module-problem hir))

(defn valid? [hir [:ref :form/r]] :bool
  (= :ok (module-problem hir)))
