(ns face-liveness.datom-test (:export [main]) (:require [face-liveness.datom :as p]))

(defn- at0 [v :document] :document (option-or (document-vector-at v 0) (document-null)))
(defn- s [d :document k :keyword] :string
  (option-or (document-string-value (option-or (document-get d k) (document-null))) "<none>"))
(defn- i [d :document k :keyword] :i64
  (option-or (document-i64-value (option-or (document-get d k) (document-null))) -1))
(defn- b [d :document k :keyword] :bool
  (option-or (document-bool-value (option-or (document-get d k) (document-null))) false))

(defn main [] :i64
  (let [c (document-map :challenge/id (document-string "c1") :challenge/type (document-string "selfie")
                        :challenge/status (document-string "open") :challenge/issued-at (document-i64 10)
                        :challenge/expires-at (document-i64 20))
        r (document-map :challenge/id (document-string "c1") :challenge/type (document-string "selfie")
                        :result/status (document-string "pass") :result/confidence (document-i64 90)
                        :result/evidence (document-string "x") :result/scored-at (document-i64 30)
                        :result/non-adjudicating (document-bool true))
        r42 (document-map :challenge/id (document-i64 42) :result/confidence (document-i64 1))
        cd (at0 (p/challenge-datoms c))
        rd (at0 (p/result-datoms r))
        rd42 (at0 (p/result-datoms r42))]
    (+ (if (= (document-count (p/challenge-datoms c)) 1) 0 1)
       (if (string=? (s cd :db/id) "c1") 0 1)
       (if (string=? (s cd :challenge/status) "open") 0 1)
       (if (= (i cd :challenge/issued-at) 10) 0 1)
       (if (= (i cd :challenge/expires-at) 20) 0 1)
       (if (= (document-count (p/result-datoms r)) 1) 0 1)
       (if (string=? (s rd :db/id) "c1:result") 0 1)
       (if (string=? (s rd :result/status) "pass") 0 1)
       (if (= (i rd :result/confidence) 90) 0 1)
       (if (b rd :result/non-adjudicating) 0 1)
       (if (string=? (s rd42 :db/id) "42:result") 0 1))))
