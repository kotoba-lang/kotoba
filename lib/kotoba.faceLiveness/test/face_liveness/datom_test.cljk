(ns face-liveness.datom-test
  (:require [kotoba.test :refer [deftest is]]
            [face-liveness.datom :as datom]
            [face-liveness.model :as model]))

(deftest challenge-datoms-shape
  (let [c (model/challenge "c1" :blink {:issued-at 0})
        [d] (datom/challenge-datoms c)]
    (is (= "c1" (:db/id d)))
    (is (= :blink (:challenge/type d)))))

(deftest result-datoms-shape-and-distinct-db-id
  (let [c (model/challenge "c1" :blink {:issued-at 0})
        r (model/result c :verified {:confidence 1.0 :scored-at 100})
        [d] (datom/result-datoms r)]
    (is (= "c1:result" (:db/id d)))
    (is (= "c1" (:challenge/id d)))
    (is (true? (:result/non-adjudicating d)))))
