(ns face-liveness.geometry-test
  (:require [kotoba.test :refer [deftest is]]
            [face-liveness.geometry :as geo]))

(def open-eye {:p1 [0 0] :p4 [10 0] :p2 [3 2] :p6 [3 -2] :p3 [7 2] :p5 [7 -2]})
(def closed-eye {:p1 [0 0] :p4 [10 0] :p2 [3 0.2] :p6 [3 -0.2] :p3 [7 0.2] :p5 [7 -0.2]})

(deftest eye-aspect-ratio-open-vs-closed
  (is (< 0.35 (geo/eye-aspect-ratio open-eye) 0.45))
  (is (< (geo/eye-aspect-ratio closed-eye) 0.10))
  (is (> (geo/eye-aspect-ratio open-eye) (geo/eye-aspect-ratio closed-eye))))

(deftest eye-aspect-ratio-nil-on-missing-point
  (is (nil? (geo/eye-aspect-ratio (dissoc open-eye :p3))))
  (is (nil? (geo/eye-aspect-ratio {}))))

(deftest mouth-aspect-ratio-uses-the-same-shape
  (is (= (geo/eye-aspect-ratio open-eye) (geo/mouth-aspect-ratio open-eye))))

(def straight-on
  {:nose-tip [50 0] :left-eye-center [20 10] :right-eye-center [80 10]})
(def turned-toward-left-eye ; nose has moved toward the left-eye point
  {:nose-tip [25 0] :left-eye-center [20 10] :right-eye-center [80 10]})
(def turned-toward-right-eye
  {:nose-tip [75 0] :left-eye-center [20 10] :right-eye-center [80 10]})

(deftest yaw-proxy-zero-when-centered-nonzero-and-opposite-signs-when-turned
  (is (< (Math/abs (geo/yaw-proxy straight-on)) 1e-9))
  (is (> (geo/yaw-proxy turned-toward-left-eye) 0.5))
  (is (< (geo/yaw-proxy turned-toward-right-eye) -0.5))
  (is (< (Math/abs (- (- (geo/yaw-proxy turned-toward-left-eye)) (geo/yaw-proxy turned-toward-right-eye))) 1e-9)))

(deftest yaw-proxy-nil-on-missing-point
  (is (nil? (geo/yaw-proxy (dissoc straight-on :nose-tip)))))
