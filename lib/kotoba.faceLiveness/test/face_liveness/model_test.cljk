(ns face-liveness.model-test
  (:require [kotoba.test :refer [deftest is]]
            [face-liveness.model :as model]))

(deftest challenge-sets-expiry-from-issued-at-plus-ttl
  (let [c (model/challenge "c1" :blink {:issued-at 1000 :ttl-ms 5000})]
    (is (= :blink (:challenge/type c)))
    (is (= :issued (:challenge/status c)))
    (is (= 6000 (:challenge/expires-at c)))))

(deftest challenge-uses-default-ttl-when-unspecified
  (let [c (model/challenge "c1" :smile {:issued-at 0})]
    (is (= model/default-ttl-ms (:challenge/expires-at c)))))

(deftest challenge-rejects-unknown-type
  (is (thrown? #?(:clj AssertionError :cljs js/Error) (model/challenge "c1" :wink {:issued-at 0}))))

(deftest expired?-before-and-after-expiry
  (let [c (model/challenge "c1" :turn-left {:issued-at 1000 :ttl-ms 1000})]
    (is (not (model/expired? c 1999)))
    (is (model/expired? c 2001))))

(deftest result-carries-non-adjudicating-true-always
  (let [c (model/challenge "c1" :blink {:issued-at 0})
        r (model/result c :verified {:confidence 0.9 :scored-at 100})]
    (is (true? (:result/non-adjudicating r)))
    (is (= 0.9 (:result/confidence r)))))
