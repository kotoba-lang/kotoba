(ns face-liveness.core-test
  (:require [kotoba.test :refer [deftest is]]
            [face-liveness.core :as core]
            [face-liveness.model :as model]))

;; Synthetic (never real-face) landmark fixtures -- see face-liveness.geometry-test
;; for the EAR/MAR/yaw-proxy math these numbers were chosen to exercise.
(def open-eye {:p1 [0 0] :p4 [10 0] :p2 [3 2] :p6 [3 -2] :p3 [7 2] :p5 [7 -2]})
(def closed-eye {:p1 [0 0] :p4 [10 0] :p2 [3 0.2] :p6 [3 -0.2] :p3 [7 0.2] :p5 [7 -0.2]})
(def mouth-closed {:p1 [0 0] :p4 [10 0] :p2 [3 0.2] :p6 [3 -0.2] :p3 [7 0.2] :p5 [7 -0.2]})
(def mouth-smiling {:p1 [0 0] :p4 [10 0] :p2 [3 3] :p6 [3 -3] :p3 [7 3] :p5 [7 -3]})
(def centered {:nose-tip [50 0] :left-eye-center [20 10] :right-eye-center [80 10]})
(def turned-left-view {:nose-tip [25 0] :left-eye-center [20 10] :right-eye-center [80 10]})
(def turned-right-view {:nose-tip [75 0] :left-eye-center [20 10] :right-eye-center [80 10]})

(defn- frames [landmark-seq]
  (map-indexed (fn [i lm] (model/frame i lm)) landmark-seq))

(deftest blink-detects-dip-then-recover
  (let [challenge (model/challenge "c1" :blink {:issued-at 0})
        result (core/score-response challenge
                                     (frames (map #(hash-map :left-eye %) [open-eye open-eye closed-eye open-eye]))
                                     500)]
    (is (= :verified (:result/status result)))
    (is (= 1.0 (:result/confidence result)))
    (is (true? (get-in result [:result/evidence :left-detected?])))))

(deftest blink-fails-when-eye-never-closes
  (let [challenge (model/challenge "c1" :blink {:issued-at 0})
        result (core/score-response challenge
                                     (frames (map #(hash-map :left-eye %) [open-eye open-eye open-eye]))
                                     500)]
    (is (= :failed (:result/status result)))))

(deftest blink-fails-when-eye-closes-and-never-reopens
  (let [challenge (model/challenge "c1" :blink {:issued-at 0})
        result (core/score-response challenge
                                     (frames (map #(hash-map :left-eye %) [open-eye closed-eye closed-eye]))
                                     500)]
    (is (= :failed (:result/status result)))))

(deftest smile-detects-rise-above-threshold
  (let [challenge (model/challenge "c1" :smile {:issued-at 0})
        result (core/score-response challenge
                                     (frames (map #(hash-map :mouth %) [mouth-closed mouth-closed mouth-smiling]))
                                     500)]
    (is (= :verified (:result/status result)))))

(deftest smile-fails-when-already-smiling-at-start-no-real-transition
  (let [challenge (model/challenge "c1" :smile {:issued-at 0})
        result (core/score-response challenge
                                     (frames (map #(hash-map :mouth %) [mouth-smiling mouth-smiling]))
                                     500)]
    (is (= :failed (:result/status result))
        "starting already smiling proves nothing about a live commit gesture, same as turn-right-fails-if-never-centered-first")))

(deftest smile-fails-when-mouth-stays-closed
  (let [challenge (model/challenge "c1" :smile {:issued-at 0})
        result (core/score-response challenge
                                     (frames (map #(hash-map :mouth %) [mouth-closed mouth-closed]))
                                     500)]
    (is (= :failed (:result/status result)))))

(deftest turn-left-detects-centered-then-committed-toward-left-eye
  (let [challenge (model/challenge "c1" :turn-left {:issued-at 0})
        result (core/score-response challenge (frames [centered centered turned-left-view]) 500)]
    (is (= :verified (:result/status result)))))

(deftest turn-left-fails-if-turned-the-other-direction
  (let [challenge (model/challenge "c1" :turn-left {:issued-at 0})
        result (core/score-response challenge (frames [centered centered turned-right-view]) 500)]
    (is (= :failed (:result/status result)))))

(deftest turn-right-detects-centered-then-committed-toward-right-eye
  (let [challenge (model/challenge "c1" :turn-right {:issued-at 0})
        result (core/score-response challenge (frames [centered centered turned-right-view]) 500)]
    (is (= :verified (:result/status result)))))

(deftest turn-right-fails-if-never-centered-first
  (let [challenge (model/challenge "c1" :turn-right {:issued-at 0})
        result (core/score-response challenge (frames [turned-right-view turned-right-view]) 500)]
    (is (= :failed (:result/status result))
        "starting already at the extreme proves nothing about a live commit gesture")))

(deftest expired-challenge-returns-expired-not-failed
  (let [challenge (model/challenge "c1" :blink {:issued-at 0 :ttl-ms 1000})
        result (core/score-response challenge
                                     (frames (map #(hash-map :left-eye %) [open-eye closed-eye open-eye]))
                                     5000)]
    (is (= :expired (:result/status result)))))

(deftest empty-frames-returns-failed-with-no-frames-reason-not-expired
  (let [challenge (model/challenge "c1" :blink {:issued-at 0})
        result (core/score-response challenge [] 500)]
    (is (= :failed (:result/status result)))
    (is (= :no-frames (get-in result [:result/evidence :reason])))))
