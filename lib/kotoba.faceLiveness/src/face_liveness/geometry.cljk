(ns face-liveness.geometry
  "Pure landmark-point geometry: Eye Aspect Ratio, Mouth Aspect Ratio, and a
   head-yaw proxy. No I/O, no CV, no image data anywhere -- these functions
   only ever see already-detected 2D point coordinates (see
   face-liveness.ports/ILandmarkTracker for the seam that would produce
   them from a real image; not implemented in this repo).

   Eye Aspect Ratio is the real, published formula from Soukupová & Čech,
   'Real-Time Eye Blink Detection Using Facial Landmarks' (2016): given 6
   points around one eye (p1/p4 = the two horizontal corners, p2/p3 = upper
   lid, p5/p6 = lower lid, p2 paired vertically with p6 and p3 with p5),

     EAR = (‖p2-p6‖ + ‖p3-p5‖) / (2 · ‖p1-p4‖)

   A closed eye collapses the vertical distances toward zero while the
   horizontal distance stays roughly constant, so EAR drops sharply on a
   blink and recovers when the eye reopens. Mouth Aspect Ratio here uses
   the SAME 6-point geometric shape applied to a mouth contour (a common,
   documented simplification many open blink/yawn-detection
   implementations use rather than the full 8-point mouth EAR variant) --
   this repo does not claim a peer-reviewed citation for the mouth version
   specifically, only that it's the identical, well-understood ratio idea.

   The yaw proxy is NOT a real 3D head-pose estimate (that needs a
   calibrated camera model and a PnP solve, out of scope for six 2D
   points) -- it's a simple horizontal-symmetry heuristic: how far the nose
   tip sits toward one eye versus the other, as a dimensionless ratio in
   [-1 1]. Treat it as 'probably turned' at a threshold, never as a real
   angle.")

(defn- distance [[x1 y1] [x2 y2]]
  (when (and x1 y1 x2 y2)
    (Math/sqrt (+ (Math/pow (- x2 x1) 2) (Math/pow (- y2 y1) 2)))))

(defn- ear-shape
  "The Soukupová & Čech EAR formula over a {:p1..:p6} point map. Returns nil
   (never throws, never a bogus number) if any required point is missing --
   a caller (face-liveness.core) must treat nil as 'cannot score this
   frame for this signal', not as a zero."
  [{:keys [p1 p2 p3 p4 p5 p6]}]
  (when (and p1 p2 p3 p4 p5 p6)
    (let [horizontal (distance p1 p4)]
      (when (and horizontal (pos? horizontal))
        (/ (+ (distance p2 p6) (distance p3 p5)) (* 2.0 horizontal))))))

(defn eye-aspect-ratio [eye-points] (ear-shape eye-points))
(defn mouth-aspect-ratio [mouth-points] (ear-shape mouth-points))

(defn yaw-proxy
  "[-1 1] dimensionless nose/eye horizontal-symmetry ratio. 0 = nose
   equidistant from both eyes (straight-on); approaching +/-1 = nose very
   close to one eye (a strong turn toward the OTHER side). Sign convention:
   positive means the nose sits closer to `left-eye` (image-left, i.e. the
   subject's own right side facing the camera more) -- a caller mapping
   this to :turn-left/:turn-right must pick the convention matching its
   own capture setup; this ns does not assume one."
  [{:keys [nose-tip left-eye-center right-eye-center]}]
  (when (and nose-tip left-eye-center right-eye-center)
    (let [[nx _] nose-tip [lx _] left-eye-center [rx _] right-eye-center
          span (- rx lx)]
      (when (and span (not (zero? span)))
        (let [ratio (/ (- nx lx) span)] ; 0 at left eye, 1 at right eye, 0.5 centered
          (* 2.0 (- 0.5 ratio)))))))
