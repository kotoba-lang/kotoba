;; Port of face-liveness.datom (datom.cljk), Kotoba-native, :document maps.
;;
;; Audit datom emitters, mirroring ekyc.datom's shape. Each emitter returns a
;; :document vector of one flat-namespaced-attribute map, so the caller can
;; transact it into the same ledger seam the source uses.
;;
;; Named divergences from datom.cljk:
;;   - the challenge and result are :document maps. An absent key is kept as
;;     document-null, as nil is kept in the source.
;;   - :result/id text: (str (:challenge/id r) ":result") in the source. A
;;     string id is used as-is, nil is "", and any other value is its canonical
;;     EDN text (document-edn-print); Kotoba has no general str.

(ns face-liveness.datom
  (:export [challenge-datoms result-datoms]))

(defn- field [m :document k :keyword] :document
  (option-or (document-get m k) (document-null)))

(defn- null-doc? [d :document] :bool
  (string=? (document-edn-print d) (document-edn-print (document-null))))

(defn- id-text [v :document] :string
  (if (null-doc? v)
    ""
    (option-or (document-string-value v) (document-edn-print v))))

(defn challenge-datoms [c :document] :document
  (document-vector
   (document-map :db/id (field c :challenge/id)
                 :challenge/type (field c :challenge/type)
                 :challenge/status (field c :challenge/status)
                 :challenge/issued-at (field c :challenge/issued-at)
                 :challenge/expires-at (field c :challenge/expires-at))))

(defn result-datoms [r :document] :document
  (document-vector
   (document-map :db/id (document-string (string-concat (id-text (field r :challenge/id)) ":result"))
                 :challenge/id (field r :challenge/id)
                 :challenge/type (field r :challenge/type)
                 :result/status (field r :result/status)
                 :result/confidence (field r :result/confidence)
                 :result/evidence (field r :result/evidence)
                 :result/scored-at (field r :result/scored-at)
                 :result/non-adjudicating (field r :result/non-adjudicating))))
