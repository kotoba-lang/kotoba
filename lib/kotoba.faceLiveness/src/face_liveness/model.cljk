(ns face-liveness.model
  "Challenge-response liveness types + the neutral named-landmark-point
   schema every scoring function reads. Pure data, no I/O, no CV.

   HONESTY NOTE (do not remove, mirrors ekyc/aml's own convention): this
   defends against a static printed photo or a single still image
   presented to a camera (no motion exists to satisfy a challenge). It does
   NOT defend against a pre-recorded video replay of the correct challenge
   sequence, a 3D mask, or a deepfake/video-injection attack feeding a
   virtual camera. See README.md/MATURITY.md.

   Landmarks are a NAMED-POINT map, not positional indices into a specific
   detector's output array (dlib's 68-point scheme, MediaPipe's 468-point
   mesh, etc each number points differently) -- a real
   face-liveness.ports/ILandmarkTracker implementation is responsible for
   mapping its own detector's raw output into this neutral shape. This
   decouples the (real, tested) scoring math from any one detector.")

(def challenge-types #{:blink :turn-left :turn-right :smile})
(def statuses #{:issued :verified :failed :expired})

(def default-ttl-ms 30000)

;; Thresholds are named, not magic numbers scattered through core.cljc --
;; see face-liveness.geometry's module doc for where each ratio comes from.
(def default-thresholds
  {:ear-closed 0.20   ; below this, treated as "eye closed" (Soukupová & Čech 2016)
   :ear-open 0.25      ; above this, treated as "eye open" -- the recovery half of a blink
   :mar-smile 0.55     ; above this, treated as "smiling/mouth open wide"
   :yaw-asymmetry 0.30}) ; |yaw-proxy| (a dimensionless [-1 1] nose/eye-symmetry
                          ; ratio, NOT a real degree-accurate 3D pose estimate --
                          ; see face-liveness.geometry/yaw-proxy's module doc)

(defn challenge
  [id type opts]
  {:pre [(contains? challenge-types type)]}
  (let [issued-at (:issued-at opts)
        ttl (:ttl-ms opts default-ttl-ms)]
    {:challenge/id id
     :challenge/type type
     :challenge/status :issued
     :challenge/issued-at issued-at
     :challenge/expires-at (+ issued-at ttl)
     :challenge/thresholds (merge default-thresholds (:thresholds opts))}))

(defn expired? [challenge now-ms] (> now-ms (:challenge/expires-at challenge)))

(defn frame
  "One tracked video frame: a timestamp plus whatever named landmark points
   the tracker found (a partial map is fine -- a scoring function that
   needs a point this frame lacks simply can't score that frame, see
   face-liveness.geometry's nil-propagation discipline)."
  [at landmarks] {:frame/at at :frame/landmarks landmarks})

(defn result
  [challenge status opts]
  {:pre [(contains? statuses status)]}
  {:challenge/id (:challenge/id challenge)
   :challenge/type (:challenge/type challenge)
   :result/status status
   :result/confidence (:confidence opts)
   :result/evidence (:evidence opts)
   :result/scored-at (:scored-at opts)
   :result/non-adjudicating true})
