(ns face-liveness.datom
  "Audit datom emitters, mirroring ekyc.datom's shape (pure, one vector of
   flat-namespaced-attribute maps per event -- the caller transacts these
   into whatever ledger it uses, same seam ekyc.adapters.identity-bridge
   and aml.adapters.evidence-ledger both already consume).")

(defn challenge-datoms [c]
  [{:db/id (:challenge/id c)
    :challenge/type (:challenge/type c)
    :challenge/status (:challenge/status c)
    :challenge/issued-at (:challenge/issued-at c)
    :challenge/expires-at (:challenge/expires-at c)}])

(defn result-datoms [r]
  [{:db/id (str (:challenge/id r) ":result")
    :challenge/id (:challenge/id r)
    :challenge/type (:challenge/type r)
    :result/status (:result/status r)
    :result/confidence (:result/confidence r)
    :result/evidence (:result/evidence r)
    :result/scored-at (:result/scored-at r)
    :result/non-adjudicating (:result/non-adjudicating r)}])
