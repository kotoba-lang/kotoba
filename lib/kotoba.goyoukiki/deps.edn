{:paths ["src"]
 ;; langgraph brings langchain transitively (both zero-/single-dep,
 ;; all .cljc → portable to JVM / SCI / ClojureScript / GraalVM). Same runtime
 ;; kekkai/teian/koyomi/tayori ride on; a procurement-signal + bidder-matching
 ;; control plane is just another sealed-intelligence ⊣ independent-governor
 ;; StateGraph. goyoukiki's opportunity/candidate/match shapes are its own;
 ;; kotoba-lang/ontology only tags an already-built opportunity map with
 ;; provenance at the ingest boundary (jp.kkj/jp.geps). kotoba-lang/tayori is
 ;; a real cross-actor composition (goyoukiki.matchport.tayori), not a shared
 ;; data model, so still no :local/root sibling dependency either way.
 :deps {
        io.github.kotoba-lang/error {:local/root "../kotoba.error"}
        io.github.kotoba-lang/http-parse-url {:local/root "../kotoba.http"}
        io.github.kotoba-lang/bytes {:local/root "../kotoba.bytes"}
        io.github.kotoba-lang/io {:local/root "../kotoba.io"}
        io.github.kotoba-lang/coll {:local/root "../kotoba.coll"}
        io.github.kotoba-lang/edn {:local/root "../kotoba.edn"}
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}
        io.github.kotoba-lang/langgraph {:local/root "../kotoba.langgraph"}
        io.github.kotoba-lang/ed25519 {:local/root "../org.ietf.ed25519"}
        io.github.kotoba-lang/ipns {:local/root "../kotoba.techIpfsSpecsIpns"}
        io.github.kotoba-lang/ontology {:local/root "../kotoba.ontology"}
        io.github.kotoba-lang/tayori {:local/root "../kotoba.tayori"}}
 :aliases
 {;; offline workspace dev — pin transitive langchain to local checkout
  :dev {:override-deps
        {io.github.kotoba-lang/langchain {:local/root "../langchain"}}}
  :test {:extra-paths ["test"]}}}
