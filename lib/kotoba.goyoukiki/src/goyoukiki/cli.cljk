(ns goyoukiki.cli
  "Minimal JVM entrypoint for `goyoukiki.query` against an EDN-seeded
  MemStore — no StateGraph/checkpointer/advisor spun up, just a status read.
  For a process boundary consumer that needs one opportunity⟷candidate
  match's status without an in-process require across runtimes.

  Usage: `kbb -M -m goyoukiki.cli <ledger.edn> <opportunity-id>
  <candidate-id>` — prints the match status (\"proposed\"/\"shared\"/
  \"none\") and exits 0 on \"shared\", 1 otherwise (so callers can also just
  check the exit code).

  <ledger.edn> holds the same shape as `goyoukiki.store/demo-data`'s
  :opportunities/:candidates maps plus an optional :matches map (at minimum
  {:matches {\"<opp>::<cand>\" {:status :shared}}})."
  (:require [kotoba.lang.edn :as edn]
            [goyoukiki.query :as query]
            [goyoukiki.store :as store]))

(defn -main [ledger-path opportunity-id candidate-id]
  (let [data (edn/read-string (slurp ledger-path))
        st (store/->MemStore (atom (merge {:ledger [] :matches {}} data)))
        status (query/match-status st opportunity-id candidate-id)]
    (println status)
    (System/exit (if (= "shared" status) 0 1))))
