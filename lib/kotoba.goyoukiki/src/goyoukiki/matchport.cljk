(ns goyoukiki.matchport
  "MatchTarget port — where a proposed opportunity⟷candidate match becomes a
  *real* notification. A match-LLM proposal is data (a `:match` record) until
  a human approves it; `share!` is called exactly once, after that approval,
  by `goyoukiki.operation`'s commit step. `propose-match!` is the 'casual
  commit' analog (teian.deckport/propose-revision!): recording that a match
  candidate exists, no external effect yet.

  Structural safety property: `share!` takes the CANDIDATE's own registered
  ground fact (fetched from the store, `:contact` field) as its destination —
  there is no parameter anywhere in this protocol through which an
  opportunity's issuing AGENCY could be supplied as a destination. Contacting
  the agency (soliciting it, disclosing to it that a candidate is interested,
  or anything ex-parte during a live tender) is not a guarded case here, it is
  an ABSENT capability — goyoukiki only ever speaks to candidates already in
  its own qualified-vendor ground facts, never to the government side of an
  opportunity. This is the actor's fundamental scope boundary (see
  goyoukiki.governor docstring, ADR-2607070200).

  `mock-matchport` is the default — a deterministic in-memory target so the
  actor is runnable/testable with no network/creds. The Notifier is a plain
  injected fn — goyoukiki does not ship a live email/portal client; the
  default just records what WOULD have been notified."
  )

(defprotocol MatchTarget
  (fetch-match [mt opportunity candidate] "the currently-shared match content, or nil")
  (propose-match! [mt opportunity candidate content] "record `content` as a match candidate — not yet shared. Returns a map (e.g. {:receipt ...}) to be merged onto the match so share! knows what was proposed.")
  (share! [mt opportunity candidate match] "notify the candidate of an already human-approved match — the actuation. Resolves the destination from the CANDIDATE's own :contact, never from a caller-supplied field."))

(defn mock-matchport
  "A deterministic in-memory MatchTarget: `shared` is an atom of
  {[opportunity-id candidate-id] -> match} so tests/sim can assert on what
  WOULD have been shared, without any network call. `notify-fn` is called
  exactly once per share! with {:opportunity :candidate :contact :match} —
  the default is a no-op (a real Notifier — email/portal/etc — is caller-
  injected; not shipped here)."
  ([] (mock-matchport (atom {}) (fn [_] nil)))
  ([shared] (mock-matchport shared (fn [_] nil)))
  ([shared notify-fn]
   (reify MatchTarget
     (fetch-match [_ opportunity candidate] (get @shared [(:id opportunity) (:id candidate)]))
     (propose-match! [_ opportunity candidate _content]
       {:receipt (str "goyoukiki/" (:id opportunity) "/" (:id candidate))})
     (share! [_ opportunity candidate match]
       (notify-fn {:opportunity (:id opportunity) :candidate (:id candidate)
                   :contact (:contact candidate) :match match})
       (swap! shared assoc [(:id opportunity) (:id candidate)] match)
       match))))
