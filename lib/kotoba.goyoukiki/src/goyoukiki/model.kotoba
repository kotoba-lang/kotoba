;; Port of goyoukiki.model (model.cljk), Kotoba-native, :document maps.
;;
;; Named divergences from model.cljk:
;;   - the multi-arity constructors are split: opportunity / opportunity-with,
;;     candidate / candidate-with, match / match-with (E2138).
;;   - #{} defaults are :document sets (document-set with no members).
;;   - :silence-period? false and :score/:confidence 0.0 are typed literals
;;     (bool, f64); :rationale nil is document-null.
;;   - match-id's str: a string value is used as is, any other value gives its
;;     EDN text (a keyword keeps its leading colon, as Clojure's str does), and
;;     nil gives "".

(ns goyoukiki.model
  (:export [opportunity opportunity-with candidate candidate-with
            match match-with match-id]))

(defn- null-doc? [d :document] :bool
  (string=? (document-edn-print d) (document-edn-print (document-null))))

(defn- attrs-of [a :document] :document
  (if (null-doc? a) (document-map) a))

(defn- str-of [v :document] :string
  (if (null-doc? v)
    ""
    (option-or (document-string-value v) (document-edn-print v))))

(defn opportunity-with [id :document agency :document kind :document attrs :document] :document
  (document-merge (document-map :id id
                                :agency agency
                                :kind kind
                                :title (document-null)
                                :cofog (document-null)
                                :unspsc (document-null)
                                :required-categories (document-set)
                                :min-rank (document-null)
                                :deadline (document-null)
                                :value (document-null)
                                :silence-period? (document-bool false)
                                :status (if (document-equal? kind (document-keyword :forecast))
                                          (document-keyword :forecast)
                                          (document-keyword :open)))
                  (attrs-of attrs)))

(defn opportunity [id :document agency :document kind :document] :document
  (opportunity-with id agency kind (document-map)))

(defn candidate-with [id :document name :document attrs :document] :document
  (document-merge (document-map :id id
                                :name name
                                :categories (document-set)
                                :rank (document-null)
                                :unspsc-tags (document-set)
                                :contact (document-null)
                                :status (document-keyword :qualified))
                  (attrs-of attrs)))

(defn candidate [id :document name :document] :document
  (candidate-with id name (document-map)))

(defn match-with [opportunity-id :document candidate-id :document attrs :document] :document
  (document-merge (document-map :opportunity-id opportunity-id
                                :candidate-id candidate-id
                                :score (document-f64 0.0)
                                :rationale (document-null)
                                :confidence (document-f64 0.0)
                                :cites (document-vector)
                                :redactions (document-vector)
                                :status (document-keyword :proposed))
                  (attrs-of attrs)))

(defn match [opportunity-id :document candidate-id :document] :document
  (match-with opportunity-id candidate-id (document-map)))

(defn match-id [opportunity-id :document candidate-id :document] :document
  (document-string (string-concat (string-concat (str-of opportunity-id) "::")
                                  (str-of candidate-id))))
