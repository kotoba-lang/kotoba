(ns goyoukiki.jp.geps
  "Real ingestion connector for 落札実績オープンデータ (Successful-Bid Open
  Data), served by 調達ポータル / 政府電子調達(GEPS), Digital Agency. Unlike
  goyoukiki.jp.kkj (live open 入札公告 across ministries AND organizations),
  this feed is AWARDED/closed-tender history restricted to the 53 official
  府省コード bodies (全省庁 — guaranteed-complete coverage BY CONSTRUCTION:
  ministry-name below is the closed, official code table the format itself
  defines, spanning all three branches of government plus independent
  agencies, e.g. 会計検査院/人事院). Awarded-bid history is a stronger
  eligibility/capability signal than a self-declared qualification rank
  alone — it records who has actually WON what, not just who claims to be
  able to. Verified against the real, documented file format (落札実績
  オープンデータファイル仕様 令和8年3月版) and a real downloaded diff file
  2026-07. JVM-only (java.net.http + java.util.zip + a minimal quoted-CSV
  parse)."
  (:require [kotoba.lang.text :as str]
            [goyoukiki.model :as model]
            [goyoukiki.operation :as op]
            [kotoba.ontology.connector :as connector])
  (:import [java.net URI]
           [java.net.http HttpClient HttpRequest HttpResponse$BodyHandlers]
           [java.util.zip ZipInputStream]
           [java.io ByteArrayInputStream ByteArrayOutputStream]))

(def ^:private download-base "https://api.p-portal.go.jp/pps-web-biz/UAB03/OAB0301")

(def ministry-name
  "The full, official 府省コード table (ファイル仕様 §3.1) — the closed set of
  values the CSV's 5th column can take. 'All ministries' coverage for this
  feed is complete by construction: there is no 54th code to miss."
  {"A1" "衆議院" "B1" "参議院" "C1" "国立国会図書館" "D1" "最高裁判所"
   "E1" "会計検査院" "F1" "人事院" "F2" "国家公務員倫理審査会"
   "G1" "内閣官房" "H1" "内閣法制局" "I1" "安全保障会議" "J1" "内閣府"
   "J2" "宮内庁" "J3" "公正取引委員会" "J4" "国家公安委員会" "J5" "警察庁"
   "J6" "金融庁" "J7" "消費者庁" "J8" "個人情報保護委員会" "J9" "カジノ管理委員会"
   "K1" "総務省" "K2" "公害等調整委員会" "K3" "消防庁"
   "L1" "法務省" "L2" "検察庁" "L3" "公安審査委員会" "L4" "公安調査庁"
   "M1" "外務省" "N1" "財務省" "N2" "国税庁"
   "O1" "文部科学省" "O2" "文化庁" "O3" "スポーツ庁"
   "P1" "厚生労働省" "P2" "中央労働委員会"
   "Q1" "農林水産省" "Q2" "林野庁" "Q3" "水産庁"
   "R1" "経済産業省" "R2" "資源エネルギー庁" "R3" "特許庁" "R4" "中小企業庁"
   "S1" "国土交通省" "S2" "運輸安全委員会" "S3" "観光庁" "S4" "気象庁" "S5" "海上保安庁"
   "T1" "環境省" "T2" "原子力安全庁"
   "U1" "防衛省" "V1" "復興庁" "W1" "デジタル庁"
   "JA" "こども家庭庁" "JB" "サイバー通信情報監理委員会"})

(def bidding-method-name
  "入札方式コード table (ファイル仕様 §3.2)."
  {"8002010" "一般競争入札・最低価格" "8002020" "一般競争入札・最高価格"
   "8002040" "一般競争入札・総合評価" "8002050" "一般競争入札・複数落札"
   "8003010" "指名競争入札・最低価格" "8003020" "指名競争入札・最高価格"
   "8003040" "指名競争入札・総合評価" "8003050" "指名競争入札・複数落札"
   "8004025" "随意契約方式・複数業者" "8001010" "随意契約方式・オープンカウンタ"
   "8004020" "随意契約方式・特定業者" "8004030" "随意契約方式・公募型プロポーザル方式"
   "8014025" "随意契約方式・複数業者・少額" "8011010" "随意契約方式・オープンカウンタ・少額"
   "8014020" "随意契約方式・特定業者・少額" "8014030" "随意契約方式・公募型プロポーザル方式・少額"})

(defn download-zip-bytes
  "GET the direct download URL discovered from the download page's own
  `doDownload` JS (uab02FileDownloadUrl + filename) — a real, unauthenticated
  api.p-portal.go.jp endpoint, verified 2026-07. `filename` is one of the
  `successful_bid_record_info_{all_<year>|diff_<yyyymmdd>}.zip` names listed
  on https://www.p-portal.go.jp/pps-web-biz/UAB02/OAB0201."
  ^bytes [filename]
  (let [req  (-> (HttpRequest/newBuilder (URI/create (str download-base "?fileversion=v001&filename=" filename)))
                 (.GET) (.build))
        resp (.send (HttpClient/newHttpClient) req (HttpResponse$BodyHandlers/ofByteArray))]
    (.body resp)))

(defn unzip-first-entry-text
  "The GEPS zip holds exactly one CSV entry — read and UTF-8 decode it (the
  spec mandates UTF-8 with a BOM; strip the BOM if present)."
  [^bytes zip-bytes]
  (with-open [zis (ZipInputStream. (ByteArrayInputStream. zip-bytes))]
    (.getNextEntry zis)
    (let [out (ByteArrayOutputStream.)
          buf (byte-array 8192)]
      (loop []
        (let [n (.read zis buf)]
          (when (pos? n) (.write out buf 0 n) (recur))))
      (let [s (.toString out "UTF-8")]
        (if (str/starts-with? s "﻿") (subs s 1) s)))))

(defn- parse-quoted-csv-line
  "Every field is \"...\"-quoted, comma-separated (ファイル仕様 §2.1) — no
  embedded-quote escaping is documented for this format, so splitting on the
  literal `\",\"` boundary between quoted columns is correct as long as no
  field contains a literal unescaped double-quote (the spec's own coded,
  government-controlled fields never do)."
  [line]
  (let [trimmed (str/replace line #"\r$" "")]
    (when (seq trimmed)
      (-> trimmed (subs 1 (dec (count trimmed))) (str/split #"\",\"" -1)))))

(defn parse-csv
  "Parse the raw (already-unzipped, BOM-stripped) CSV text into a seq of raw
  maps, one per row, per the fixed 8-column order (ファイル仕様 §2.2)."
  [csv-text]
  (vec (for [line (str/split-lines csv-text)
             :when (seq (str/trim line))
             :let [[item-no item-name bid-date price ministry-cd method-cd trade-name corp-no]
                   (parse-quoted-csv-line line)]]
         {:procurement-item-no item-no :procurement-item-name item-name
          :successful-bid-date bid-date :successful-bid-price price
          :ministry-cd ministry-cd :bidding-method-cd method-cd
          :trade-name trade-name :corporation-no corp-no})))

(defn ->opportunity
  "Map one raw GEPS row into a goyoukiki.model/opportunity ground fact,
  :status :awarded (this feed is history, never an open invitation to bid).
  The winning vendor is recorded as metadata (:awarded-to/
  :awarded-corporation-no) on the opportunity itself, NOT auto-created as a
  goyoukiki.model/candidate — 'won a contract once' and 'is a 全省庁統一資格
  pre-qualified registrant' are different ground truths, and candidate
  records specifically carry that registry's :categories/:rank, which this
  feed does not provide."
  [{:keys [procurement-item-no procurement-item-name successful-bid-date
           successful-bid-price ministry-cd bidding-method-cd trade-name corporation-no]}]
  (model/opportunity (str "geps-" procurement-item-no)
                      (get ministry-name ministry-cd ministry-cd) :tender
    {:title procurement-item-name
     :value (when (seq successful-bid-price) (bigdec successful-bid-price))
     :status :awarded
     :source :geps-opendata
     :awarded-date successful-bid-date
     :awarded-to trade-name
     :awarded-corporation-no (not-empty corporation-no)
     :procedure-type (get bidding-method-name bidding-method-cd bidding-method-cd)}))

(defn ingest!
  "Download + unzip + parse + register every row of `filename` as an
  :opportunity/register ground fact against `store` (via
  goyoukiki.operation/register! — no checkpointer thread per row). The
  registered :value is tagged with kotoba.ontology.connector provenance
  (:ontology/type :tender :ontology/source :jp.geps) before it lands in the
  store. Returns the count registered. REAL network call — not part of any
  test or the default `:run` demo."
  [store filename]
  (let [rows (parse-csv (unzip-first-entry-text (download-zip-bytes filename)))]
    (doseq [raw rows]
      (let [opp (connector/tag :jp.geps (->opportunity raw))]
        (op/register! store {:op :opportunity/register :opportunity (:id opp) :value opp})))
    (count rows)))

(defn -main
  "kbb -M -m goyoukiki.jp.geps <filename> — real, live ingest run against
  a fresh MemStore, printing a summary. Manual/ops entrypoint, not wired into
  CI. Example filename: successful_bid_record_info_diff_20260523.zip"
  [filename]
  (require 'goyoukiki.store)
  (let [store ((resolve 'goyoukiki.store/seed-db))
        n (ingest! store filename)]
    (println n "opportunities registered from GEPS open data" filename)
    (doseq [o ((resolve 'goyoukiki.store/all-opportunities) store)]
      (println " " (:id o) "-" (:agency o) "-" (:title o) "-" (:awarded-to o)))))
