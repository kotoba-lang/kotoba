(ns goyoukiki.policy
  "Pure checks over goyoukiki's published facts (cross-candidate
  confidentiality redaction requirements, candidate eligibility against an
  opportunity's declared qualification floor) — no I/O, no store: shared by
  ProcurementGovernor and the mock match-LLM so both reason over the same
  facts without coupling the censor to the proposer (the goyoukiki analog of
  teian.policy / tayori.policy).

  `sensitive-categories` — cross-candidate confidentiality is the domain-
  specific redaction concern here (never let one candidate's rationale carry
  another candidate's proprietary capability/pricing, or an agency's
  internal-only budget detail, into a match record)."
  (:require [kotoba.lang.coll :as set]
            [kotoba.lang.text :as str]))

(def sensitive-categories #{:other-candidate-capability :other-candidate-pricing :agency-internal-budget})

(defn sensitive-cite? [cite] (contains? sensitive-categories cite))

(defn missing-redactions
  "Sensitive cites the proposal did not list in :redactions."
  [cites redactions]
  (vec (remove (set redactions) (filter sensitive-cite? cites))))

(def ^:private rank-order {:A 4 :B 3 :C 2 :D 1})

(defn rank-satisfies?
  "Does a candidate's 全省庁統一資格 rank meet-or-exceed the opportunity's
  declared floor? No floor means no rank requirement."
  [candidate-rank min-rank]
  (or (nil? min-rank) (>= (get rank-order candidate-rank 0) (get rank-order min-rank 0))))

(defn- digits-only
  [x]
  (when (some? x)
    (let [s (str/replace (str x) #"\D" "")]
      (when (pos? (count s)) s))))

(defn unspsc-satisfies?
  "When opportunity declares `:unspsc`, candidate must carry a matching
  `:unspsc-tags` entry — exact 8-digit commodity and/or 2-digit segment
  (product-party projection shape). No declared unspsc → no barrier."
  [opportunity candidate]
  (let [code (digits-only (:unspsc opportunity))
        tags (set (map str (:unspsc-tags candidate #{})))]
    (cond
      (nil? code) true
      :else (or (contains? tags code)
                (and (>= (count code) 2)
                     (contains? tags (subs code 0 2)))))))

(defn eligible?
  "Is `candidate` actually qualified to bid on `opportunity`? No implicit
  allow — a match naming an unqualified vendor is exactly the defect a
  matching engine must not produce. :required-categories is a SET because an
  opportunity can require more than one qualification category at once
  (e.g. both 役務 and 工事) — candidate's :categories must cover ALL of
  them (subset?), not merely overlap with one. Checks are declarative
  ground facts (opportunity's :required-categories/:min-rank/:unspsc,
  candidate's :categories/:rank/:unspsc-tags), never re-derived from the
  LLM's own claim."
  [opportunity candidate]
  (boolean
   (and candidate
        (set/subset? (:required-categories opportunity #{}) (:categories candidate #{}))
        (rank-satisfies? (:rank candidate) (:min-rank opportunity))
        (unspsc-satisfies? opportunity candidate))))
