(ns goyoukiki.sim
  "Demo: drive a forecast→match→share flow through one MatchActor.

    ingest         register a forecast (先回り — 経産省クラウド基盤整備・調達予定)
    propose meti   clean, eligible candidate → phase 3 auto-commits (a casual commit)
    share meti     notifying is always high-stakes → human sign-off → mock-matchport shares
    phase 0        propose in ingest-only phase → held (phase-disabled)
    silence period a share attempt while the opportunity is silence-flagged → held

  Run: kbb -M:dev:run"
  (:require [langgraph.graph :as g]
            [goyoukiki.store :as store]
            [goyoukiki.matchport :as matchport]
            [goyoukiki.operation :as op]))

(defn- line [& xs] (println (apply str xs)))

(defn- drive [actor tid req phase approve?]
  (let [res (g/run* actor {:request req :context {:phase phase}} {:thread-id tid})]
    (if (= :interrupted (:status res))
      (do (line "   ⏸  human sign-off — review (reason: "
                (-> res :state :audit last :reason) ")")
          (let [r2 (g/run* actor {:approval {:status (if approve? :approved :rejected)
                                             :by "cpo-hana"}}
                           {:thread-id tid :resume? true})]
            (line "   ▶  " (if approve? "承認" "却下") " → " (get-in r2 [:state :disposition]))
            r2))
      (do (line "   → " (get-in res [:state :disposition])
                (when-let [pr (-> res :state :audit last :phase-reason)] (str " (" pr ")")))
          res))))

(defn -main [& _]
  (let [st     (store/seed-db)
        shared (atom {})
        mp     (matchport/mock-matchport shared)
        actor  (op/build st {:matchport mp})]

    (line "── ingest 先回り (経産省クラウド基盤整備の調達予定を観測 → ground fact) ──")
    (drive actor "i1" {:op :opportunity/register :opportunity "opp-nict-satellite-2028"
                       :value {:id "opp-nict-satellite-2028" :agency "総務省" :kind :forecast
                               :title "衛星通信基盤(調達予定)" :cofog "04.5" :unspsc "81112000"
                               :required-categories #{:役務} :min-rank :B}} 3 true)
    (line "  registered opportunities: " (mapv :id (store/all-opportunities st)))

    (line "\n── propose opp-meti-cloud-2027 (適格候補を発見 → phase 3 auto-commit) ──")
    (drive actor "p-meti" {:op :match/propose :opportunity "opp-meti-cloud-2027"} 3 true)
    (let [m (store/matches-for-opportunity st "opp-meti-cloud-2027")]
      (line "  match: " (mapv (juxt :candidate-id :status) m)))

    (line "\n── share opp-meti-cloud-2027 ⟷ 藤寺 (通知は常にhigh-stakes → 人間承認) ──")
    (drive actor "s-meti" {:op :match/share :opportunity "opp-meti-cloud-2027"
                           :candidate "cand-fujitera"} 3 true)
    (line "  match status: " (:status (store/match-for st "opp-meti-cloud-2027" "cand-fujitera")))
    (line "  shared (mock-matchport): " (contains? @shared ["opp-meti-cloud-2027" "cand-fujitera"]))

    (line "\n── 段階導入: propose を phase 0 (ingest-only) で ──")
    (drive actor "p-p0" {:op :match/propose :opportunity "opp-meti-cloud-2027"} 0 true)

    (line "\n── 沈黙期間中の案件は share できない (入札談合等関与行為防止法) ──")
    (store/record-datom! st {:kind :opportunity :id "opp-mod-radar-2026" :value {:silence-period? true}})
    (drive actor "p-mod" {:op :match/propose :opportunity "opp-mod-radar-2026"} 3 true)
    (drive actor "s-mod" {:op :match/share :opportunity "opp-mod-radar-2026"
                          :candidate "cand-fujitera"} 3 true)

    (line "\n── マッチング監査台帳 (append-only) ──")
    (doseq [f (store/ledger st)] (line "  " (store/ledger-line f)))

    (line "\n── バックエンド差し替え: DatomicStore でも同一契約 ──")
    (let [ds (store/datomic-seed-db) da (op/build ds {:matchport mp})]
      (drive da "d1" {:op :match/propose :opportunity "opp-meti-cloud-2027"} 3 true)
      (line "  DatomicStore match: " (mapv :status (store/matches-for-opportunity ds "opp-meti-cloud-2027"))))
    (line "\ndone.")))
