(ns goyoukiki.query
  "Pure status lookups for a goyoukiki Store.

  No LLM/governor involved — `goyoukiki.operation`'s MatchActor is how a
  match GETS to `:shared` (match-LLM proposes, ProcurementGovernor censors,
  sharing always routes to a human). This ns only READS already-committed
  ground facts, for callers that need to gate on current status without
  running the actor (e.g. a downstream document-drafting actor — teian/
  tayori — checking whether an opportunity already has a shared match before
  drafting a bid-response outline)."
  (:require [goyoukiki.store :as store]))

(defn match-status
  "\"proposed\"/\"shared\", or \"none\" if no match has ever been proposed
  for this opportunity⟷candidate pairing."
  [st opportunity-id candidate-id]
  (name (or (:status (store/match-for st opportunity-id candidate-id)) :none)))

(defn shared? [st opportunity-id candidate-id]
  (= :shared (:status (store/match-for st opportunity-id candidate-id))))
