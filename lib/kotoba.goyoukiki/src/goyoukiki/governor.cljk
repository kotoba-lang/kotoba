(ns goyoukiki.governor
  "ProcurementGovernor — the independent censor that earns match-LLM the
  right to *propose* a candidate⟷opportunity pairing. The LLM has no notion
  of qualification floors, cross-candidate confidentiality, bid-silence
  windows, or the no-actuation charter, so this MUST be a separate system
  (rules over the store's ground facts) able to *reject* a proposal and fall
  back to HOLD — the goyoukiki analog of teian's BriefingGovernor / tayori's
  ComplianceGovernor.

  The actor is **propose → match only**. It never notifies a candidate
  itself; notifying (`:match/share`) is ALWAYS routed to a human (the
  goyoukiki analog of teian's :deck/publish / robotaxi's MRC). Below, HARD
  invariants force HOLD; a clean share still routes to a human (high-stakes),
  at every phase.

  A structural note this governor does NOT need a rule for: goyoukiki has no
  code path to contact the issuing AGENCY at all — `:match/share`'s
  destination is always resolved from the matched CANDIDATE's own registered
  `:contact` (a separate store collection from `opportunity`); no request
  field ever supplies an arbitrary destination. This forecloses the
  ex-parte-contact / unsolicited-proposal-to-government risk class by
  construction rather than by a checked rule (see goyoukiki.matchport). What
  the governor DOES enforce below is the risk that remains: don't propose/
  share an ineligible or non-existent candidate, don't leak one candidate's
  confidential facts into another's rationale, and don't share (even a
  perfectly eligible match) while the opportunity is in a declared bid-
  silence window — 官製談合防止法/入札談合等関与行為防止法 concerns, i.e.
  never let this actor become a channel through which bidders coordinate or
  gain information asymmetry during a live competitive process.

  HARD invariants:
    :match/propose
      1. Subject exists   — the opportunity must already be a registered
                             ground fact (an LLM can hallucinate an id; the
                             governor never trusts confidence alone).
      2. No-actuation     — proposal :effect must be :draft (a control-plane
                             record), never :shared.
      3. Nomination        — the proposal must actually name a :candidate
                             (never trust confidence alone — a nil-candidate
                             proposal reaching commit would corrupt the store).
      4. Eligibility       — the nominated candidate must exist AND satisfy
                             the opportunity's declared category/rank floor
                             (goyoukiki.policy/eligible?) — a match to a
                             nonexistent or unqualified vendor is exactly the
                             defect a matching engine must not produce.
      5. Redaction         — every sensitive-category cite (:other-candidate-
                             capability/:other-candidate-pricing/:agency-
                             internal-budget) must appear in :redactions.
    :match/share
      1. Subject exists    — the opportunity must already be registered.
      2. Candidate exists  — the candidate must already be registered.
      3. Match exists      — a match must already have been committed (you
                             cannot share what was never proposed).
      4. Eligibility (recheck)    — re-runs eligibility against the CURRENTLY
                             STORED candidate/opportunity (ground truth,
                             not the incoming proposal) — a candidate's
                             qualification can lapse between propose-time and
                             share-time.
      5. Redaction (recheck)     — same recheck, against the currently
                             stored match's cites/redactions.
      6. Silence-period    — if the opportunity is currently flagged
                             `:silence-period?` (a declared bid-silence/cone-
                             of-silence window), sharing is a hard violation
                             — un-overridable, regardless of how clean the
                             match otherwise is. Proposing (no external
                             effect) is unaffected; only the external
                             disclosure is blocked during silence.
    (any op) — an unrecognized :op is itself a hard violation (fail-closed).
  SOFT:
    Confidence floor → escalate.
    `:match/share` is high-stakes → ALWAYS human, independent of phase."
  (:require [goyoukiki.policy :as policy]
            [goyoukiki.store :as store]))

(def confidence-floor 0.6)

;; ───────────────────────── invariant checks ─────────────────────────

(defn- missing-opportunity-violations [st opportunity-id]
  (when (nil? (store/opportunity st opportunity-id))
    [{:rule :no-opportunity :detail (str "未登録opportunity: " opportunity-id)}]))

(defn- missing-candidate-violations [st candidate-id]
  (when (nil? (store/candidate st candidate-id))
    [{:rule :no-candidate :detail (str "未登録candidate: " candidate-id)}]))

(defn- missing-match-violations [st opportunity-id candidate-id]
  (when (nil? (store/match-for st opportunity-id candidate-id))
    [{:rule :no-match :detail (str "未commitのmatch: " opportunity-id "⟷" candidate-id)}]))

(defn- actuation-violations [proposal expected]
  (when (not= expected (:effect proposal))
    [{:rule :no-actuation
      :detail (str "この段階のeffectは" expected "固定(propose→"
                   (name expected) "のみ)。実際=" (:effect proposal))}]))

(defn- nomination-violations
  "A `:match/propose` proposal MUST nominate a candidate id — never trust a
  high confidence score alone (a hallucinating LLM could in principle claim
  confidence without a nomination); fail closed rather than let a nil
  candidate reach pending-record/commit."
  [proposal]
  (when (nil? (:candidate proposal))
    [{:rule :no-nomination :detail "候補が提案されていない(candidate=nil)"}]))

(defn- eligibility-violations [st opportunity-id candidate-id]
  (when candidate-id
    (let [opp (store/opportunity st opportunity-id)
          cand (store/candidate st candidate-id)]
      (when-not (policy/eligible? opp cand)
        [{:rule :ineligible-candidate
          :detail (str candidate-id " は " opportunity-id " の要件(区分/格付)を満たさない")}]))))

(defn- redaction-violations [proposal]
  (let [missing (policy/missing-redactions (:cites proposal) (:redactions proposal))]
    (when (seq missing)
      [{:rule :missing-redaction :detail (str "機微引用にredaction無し: " missing)}])))

(defn- silence-period-violations [st opportunity-id]
  (when (:silence-period? (store/opportunity st opportunity-id))
    [{:rule :silence-period :detail (str opportunity-id " は入札談合等関与行為防止法の"
                                        "対象となりうる沈黙期間中 — shareできない")}]))

(defn check
  "Censors a match-LLM proposal for a goyoukiki op. Returns
   {:ok? :violations :confidence :hard? :escalate? :high-stakes?}.

   Hard violations force HOLD and cannot be overridden. Sharing a match
   (`:match/share`) is high-stakes → human sign-off even when clean."
  [request proposal st]
  (let [op          (:op request)
        opportunity-id (:opportunity request)
        candidate-id   (:candidate request (:candidate proposal))
        hard (vec (case op
                    :match/propose
                    (concat (missing-opportunity-violations st opportunity-id)
                            (actuation-violations proposal :draft)
                            (nomination-violations proposal)
                            (eligibility-violations st opportunity-id (:candidate proposal))
                            (redaction-violations proposal))
                    :match/share
                    (let [current-match (store/match-for st opportunity-id candidate-id)]
                      (concat (missing-opportunity-violations st opportunity-id)
                              (missing-candidate-violations st candidate-id)
                              (missing-match-violations st opportunity-id candidate-id)
                              (eligibility-violations st opportunity-id candidate-id)
                              (when current-match (redaction-violations current-match))
                              (silence-period-violations st opportunity-id)))
                    [{:rule :unrecognized-op :detail (str "未対応op: " op)}]))
        conf    (:confidence proposal 0.0)
        low?    (< conf confidence-floor)
        stakes? (= :match/share op)
        hard?   (boolean (seq hard))]
    {:ok?          (and (not hard?) (not low?) (not stakes?))
     :violations   hard
     :confidence   conf
     :hard?        hard?
     :escalate?    (and (not hard?) (or low? stakes?))
     :high-stakes? stakes?}))

(defn hold-fact [request verdict]
  {:t :goyoukiki-hold :op (:op request) :subject (:opportunity request)
   :disposition :hold :basis (mapv :rule (:violations verdict))
   :violations (:violations verdict) :confidence (:confidence verdict)})
