(ns goyoukiki.model
  "Pure data shapes goyoukiki holds. Two ground-fact kinds:

    opportunity — a 調達 ground fact, either a pre-publication `:forecast`
                  (調達予定 — an agency's advance disclosure of planned spend,
                  required budget-execution disclosure, NOT insider info) or a
                  published `:tender` (入札公告/公示). `materialize` (forecast
                  → tender) is just a `:kind`/`:status` transition on the same
                  id, so anticipatory (先回り) tracking and live tracking share
                  one ledger.
    candidate  — a 団体 ground fact: a pre-qualified vendor (全省庁統一資格
                 registrant — Japan's government-wide unified qualification
                 for competitive bidding), its declared categories/rank/
                 UNSPSC capability tags.

  `match` is the actor's own control-plane record (the teian analog of
  `draft`) — a PROPOSED opportunity⟷candidate pairing. It is never the bid
  response itself (drafting a response document is out of scope, delegated to
  `kotoba-lang/teian`/`tayori` consuming this match as their own itonami
  activity input — ADR-2607070200).")

(defn opportunity
  ([id agency kind] (opportunity id agency kind {}))
  ([id agency kind attrs]
   (merge {:id id :agency agency :kind kind ; :forecast | :tender
           :title nil :cofog nil :unspsc nil
           :required-categories #{} :min-rank nil
           :deadline nil :value nil
           :silence-period? false
           :status (if (= kind :forecast) :forecast :open)}
          attrs)))

(defn candidate
  ([id name] (candidate id name {}))
  ([id name attrs]
   (merge {:id id :name name :categories #{} :rank nil :unspsc-tags #{}
           :contact nil :status :qualified}
          attrs)))

(defn match
  ([opportunity-id candidate-id] (match opportunity-id candidate-id {}))
  ([opportunity-id candidate-id attrs]
   (merge {:opportunity-id opportunity-id :candidate-id candidate-id
           :score 0.0 :rationale nil :confidence 0.0
           :cites [] :redactions [] :status :proposed}
          attrs)))

(defn match-id [opportunity-id candidate-id]
  (str opportunity-id "::" candidate-id))
