(ns goyoukiki.matchport.tayori
  "A real MatchTarget: goyoukiki.matchport/share! -- called exactly once,
  after a human has ALREADY approved sharing a match -- drives a tayori
  CorrespondenceActor to DRAFT (never send) an outreach message to the
  candidate. tayori's own ComplianceGovernor still gates the actual
  :reply/send behind a SEPARATE, later human approval that this namespace
  never triggers: goyoukiki's 'should we share this match' governance and
  tayori's 'should this message actually go out' governance layer, neither
  short-circuits the other. Bookkeeping (fetch-match/propose-match!) mirrors
  goyoukiki.matchport/mock-matchport exactly; only share! differs.

  Framing note: tayori's charter is drafting REPLIES to inbound
  correspondence; a goyoukiki share is really the FIRST outbound contact
  about a new match, not a reply to something the candidate said. This
  reuses tayori's reply-drafting machinery (a thread + one seeded
  system-context message standing in for the 'incoming' side) for that
  first-contact case rather than inventing a separate outbound-drafting op
  in tayori -- a reasonable reuse, not a perfect semantic fit, so it is
  documented here rather than left implicit."
  (:require [langgraph.graph :as g]
            [tayori.store :as tstore]
            [tayori.operation :as top]
            [goyoukiki.matchport :as matchport]))

(defn- thread-id [opportunity candidate]
  (str "goyoukiki-share-" (:id opportunity) "-" (:id candidate)))

(defn- system-note
  "The seeded 'inbound' message tayori's reply-LLM drafts against. Carries
  the underlying opportunity's ontology provenance (when tagged by a
  registered connector, e.g. kotoba-lang/goyoukiki's own jp.kkj/jp.geps) into
  the text tayori's own governor/redaction checks see, so a downstream
  reviewer can tell a connector-sourced match from an internally-proposed
  one without a separate side channel."
  [opportunity]
  (cond-> (str "新規マッチ通知: " (:title opportunity) "(" (:agency opportunity) ")")
    (:ontology/source opportunity)
    (str " [出所: " (name (:ontology/source opportunity))
         ", 種別: " (name (:ontology/type opportunity)) "]")))

(defn draft-outreach!
  "Register the candidate's contact + a thread + one synthetic system-context
  message, then run tayori's :reply/draft at phase 3 (drafts auto-commit;
  :reply/send stays a separate, always-human step this fn never triggers).
  Returns {:tayori-store :thread-id :draft :run}."
  ([opportunity candidate] (draft-outreach! (tstore/seed-db) opportunity candidate))
  ([tayori-store opportunity candidate]
   (let [tid   (thread-id opportunity candidate)
         cid   (:id candidate)
         actor (top/build tayori-store)
         ctx   {:context {:phase 3}}]
     (g/run* actor (merge {:request {:op :contact/register :contact cid
                                     :value {:id cid :channel :email
                                             :address (:contact candidate)
                                             :consent :known :first-contact? true}}}
                          ctx)
             {:thread-id (str tid ":contact")})
     (g/run* actor (merge {:request {:op :thread/register :thread tid
                                     :value {:id tid :channel :email :external-id tid
                                             :participants [cid] :tenant "goyoukiki"
                                             :status :open}}}
                          ctx)
             {:thread-id (str tid ":thread")})
     (g/run* actor (merge {:request {:op :message/ingest :thread tid
                                     :value {:thread-id tid :from :goyoukiki-system :ts 0
                                             :direction :inbound :body (system-note opportunity)}}}
                          ctx)
             {:thread-id (str tid ":message")})
     (let [run (g/run* actor (merge {:request {:op :reply/draft :thread tid}} ctx)
                       {:thread-id tid})]
       {:tayori-store tayori-store :thread-id tid
        :draft (tstore/draft-of tayori-store tid) :run run}))))

(defn match-target
  "A MatchTarget wrapping goyoukiki.matchport/mock-matchport's bookkeeping
  (fetch-match/propose-match! -- no I/O, deterministic, identical to the
  mock) but driving draft-outreach! on share! instead of a no-op notify-fn."
  ([] (match-target (atom {}) (tstore/seed-db)))
  ([shared tayori-store]
   (reify matchport/MatchTarget
     (fetch-match [_ opportunity candidate]
       (get @shared [(:id opportunity) (:id candidate)]))
     (propose-match! [_ opportunity candidate _content]
       {:receipt (str "goyoukiki/" (:id opportunity) "/" (:id candidate))})
     (share! [_ opportunity candidate match]
       (draft-outreach! tayori-store opportunity candidate)
       (swap! shared assoc [(:id opportunity) (:id candidate)] match)
       match))))
