(ns goyoukiki.matchllm
  "match-LLM — the contained intelligence node. It reads an opportunity's
  ground facts (forecast/tender + its declared category/rank floor) and the
  registered candidate pool, and returns a PROPOSAL: which candidate (団体) it
  recommends matching, or (for `:match/share`) a pass-through recommendation
  over the already-committed match. It NEVER notifies anyone — every output
  is censored by `goyoukiki.governor` before anything is recorded, and
  sharing (`:match/share`) always routes to a human (charter: propose→match
  only, no actuation).

  Advisor is injected (mock | real LLM via langchain.model), same as
  teian.deckllm / tayori.replyllm.

  Proposal shape:
    {:recommendation kw   ; :propose | :share
     :candidate str       ; the candidate id this proposal nominates (nil if none eligible)
     :score 0..1 :rationale str
     :summary str :cites [kw ..] :redactions [kw ..]
     :effect kw           ; :draft | :shared
     :confidence 0..1}"
  (:require #?(:clj  [kotoba.lang.edn :as edn]
               :cljs [cljs.reader :as edn])
            [kotoba.lang.text :as str]
            [langchain.model :as model]
            [goyoukiki.policy :as policy]
            [goyoukiki.store :as store]))

;; ───────────────────────── deterministic mock ─────────────────────────

(def ^:private rank-value {:A 4 :B 3 :C 2 :D 1})

(defn- best-eligible
  "The mock never invents a candidate: it only ever nominates one that is
  ALREADY a registered, eligible ground fact — the highest-rank eligible
  candidate wins, ties broken by id for determinism."
  [opp candidates]
  (->> candidates
       (filter #(policy/eligible? opp %))
       (sort-by (fn [c] [(- (get rank-value (:rank c) 0)) (:id c)]))
       first))

(defn- propose-match [st {:keys [opportunity]}]
  (let [opp   (store/opportunity st opportunity)
        cands (store/all-candidates st)]
    (if-let [best (and opp (best-eligible opp cands))]
      {:recommendation :propose :candidate (:id best) :score 0.8
       :rationale (str (:name best) " は区分" (:required-categories opp)
                       "・格付" (:rank best) " で案件の要件を満たす")
       :summary (str opportunity " に対する候補案")
       :cites [:opportunity :candidate-registry] :redactions []
       :effect :draft :confidence (if opp 0.8 0.0)}
      {:recommendation :propose :candidate nil :score 0.0
       :rationale "適格候補なし" :summary "候補なし"
       :cites [] :redactions [] :effect :draft :confidence 0.0})))

(defn- share-match [st {:keys [opportunity candidate]}]
  (let [m (store/match-for st opportunity candidate)]
    (if m
      {:recommendation :share :candidate candidate :score (:score m 0.0)
       :rationale "承認済みmatchのshare" :summary (str opportunity "⟷" candidate " をshare")
       :cites (:cites m []) :redactions (:redactions m []) :effect :shared
       :confidence (:confidence m 0.0)}
      {:recommendation :share :candidate candidate :score 0.0
       :rationale (str opportunity) :summary "match未作成"
       :cites [] :redactions [] :effect :shared :confidence 0.0})))

(defn infer [st {:keys [op] :as req}]
  (case op
    :match/propose (propose-match st req)
    :match/share   (share-match st req)
    {:recommendation :unknown :summary "未対応" :rationale (str op)
     :cites [] :redactions [] :effect :noop :confidence 0.0}))

;; ───────────────────────── Advisor protocol ─────────────────────────

(defprotocol Advisor
  (-advise [advisor store request]))

(defn mock-advisor [] (reify Advisor (-advise [_ st req] (infer st req))))

(def ^:private system-prompt
  (str "あなたは政府調達の案件(調達予定/入札公告)に対し、適格な団体を推薦する"
       "助言者です。与えられた事実(登録済み案件・候補団体の格付/区分)のみに"
       "基づき、提案を1つ EDN マップで返します。EDN だけを出力。\n"
       "キー: :recommendation(:propose|:share) :candidate(候補id、無ければnil) "
       ":score(0..1) :rationale :summary :cites :redactions "
       ":effect(:draft 固定 — :shared は自称しない) :confidence(0..1)。\n"
       "重要: あなたは候補への通知(share)をしない(propose→matchのみ)。他候補の"
       "非公開情報・発注機関の内部予算に言及するときは必ず :redactions に列挙する。"
       "存在しない候補を捏造しない — 登録済みcandidateのみ推薦できる。"))

(defn- facts-for [st {:keys [opportunity candidate]}]
  {:opportunity (store/opportunity st opportunity)
   :candidates (store/all-candidates st)
   :match (when candidate (store/match-for st opportunity candidate))})

(defn- parse-proposal
  "Defensive EDN parse of an LLM response — an unparseable / non-map response
  degrades to a confidence-0 noop the governor will hold/escalate (mirrors
  teian.deckllm/tayori.replyllm's parse-proposal exactly)."
  [content]
  (let [p (try (edn/read-string (str/trim (str content)))
               (catch #?(:clj Exception :cljs :default) _ nil))]
    (if (map? p)
      (-> p (update :cites #(vec (or % [])))
            (update :redactions #(vec (or % [])))
            (update :confidence #(if (number? %) (double %) 0.0))
            (update :effect #(or % :noop)))
      {:recommendation :unknown :summary "LLM応答を解釈できません" :rationale (str content)
       :cites [] :redactions [] :effect :noop :confidence 0.0})))

(defn llm-advisor
  "Advisor backed by a langchain.model/ChatModel (Anthropic / OpenAI-compatible
  / mock-model). Output is parsed defensively — an unparseable response is a
  confidence-0 noop the governor will hold/escalate."
  ([chat-model] (llm-advisor chat-model {}))
  ([chat-model gen-opts]
   (reify Advisor
     (-advise [_ st req]
       (let [resp (model/-generate chat-model
                    [{:role :system :content system-prompt}
                     {:role :user :content (str "操作:" (:op req)
                                                "\n事実:" (pr-str (facts-for st req)))}]
                    gen-opts)]
         (parse-proposal (:content resp)))))))

(defn trace [request proposal]
  {:t :matchllm-proposal :op (:op request) :subject (:opportunity request)
   :recommendation (:recommendation proposal) :candidate (:candidate proposal)
   :summary (:summary proposal) :rationale (:rationale proposal)
   :cites (:cites proposal) :confidence (:confidence proposal)})
