(ns goyoukiki.policy-test
  "Direct unit coverage for goyoukiki.policy/eligible? -- the hard,
  un-overridable :ineligible-candidate gate. Previously only exercised
  indirectly through governor_contract_test's rank-floor scenarios; this
  file adds direct coverage for :required-categories, since that's the
  field the governor-contract tests never varied."
  (:require [kotoba.test :refer [deftest is testing]]
            [goyoukiki.policy :as policy]))

(deftest eligible-requires-every-required-category-not-just-one
  (testing "an opportunity requiring MULTIPLE categories must have ALL of
            them covered by the candidate -- regression: eligible? used
            set/intersection (any overlap = eligible) instead of
            set/subset? (every required category covered), so a candidate
            qualified in only ONE of several required categories was
            incorrectly accepted. :required-categories is declared as a
            SET specifically because an opportunity can require more than
            one qualification at once (e.g. 役務 AND 工事)"
    (let [opp {:required-categories #{:役務 :工事} :min-rank :B}]
      (is (policy/eligible? opp {:categories #{:役務 :工事} :rank :A})
          "qualified in both required categories -> eligible")
      (is (not (policy/eligible? opp {:categories #{:役務} :rank :A}))
          "qualified in only one of two required categories -> NOT eligible")
      (is (not (policy/eligible? opp {:categories #{:工事} :rank :A}))
          "qualified in only the other one -> NOT eligible")
      (is (not (policy/eligible? opp {:categories #{:清掃} :rank :A}))
          "qualified in neither -> NOT eligible")
      (is (policy/eligible? opp {:categories #{:役務 :工事 :清掃} :rank :A})
          "qualified in more than required -> still eligible")))
  (testing "single-category opportunities are unaffected"
    (let [opp {:required-categories #{:役務} :min-rank :B}]
      (is (policy/eligible? opp {:categories #{:役務} :rank :A}))
      (is (not (policy/eligible? opp {:categories #{:工事} :rank :A})))))
  (testing "no category requirement means no category barrier"
    (is (policy/eligible? {:required-categories #{} :min-rank :B}
                          {:categories #{:anything} :rank :A}))
    (is (policy/eligible? {:min-rank :B} {:categories #{} :rank :A})
        "missing :required-categories key entirely behaves like an empty set"))
  (testing "rank floor is still enforced independently of category coverage"
    (is (not (policy/eligible? {:required-categories #{:役務 :工事} :min-rank :B}
                               {:categories #{:役務 :工事} :rank :D}))))
  (testing "nil candidate is never eligible"
    (is (not (policy/eligible? {:required-categories #{} :min-rank :B} nil)))))

(deftest unspsc-satisfies-segment-or-commodity
  (testing "no opportunity unspsc → no tag barrier"
    (is (true? (policy/unspsc-satisfies? {} {:unspsc-tags #{}})))
    (is (true? (policy/unspsc-satisfies? {:unspsc nil} {:unspsc-tags #{}}))))
  (testing "exact 8-digit commodity match"
    (is (true? (policy/unspsc-satisfies?
                {:unspsc "43191501"}
                {:unspsc-tags #{"43191501"}}))))
  (testing "2-digit segment match (product-party projection)"
    (is (true? (policy/unspsc-satisfies?
                {:unspsc "43191501"}
                {:unspsc-tags #{"43"}}))))
  (testing "mismatched tags are not eligible"
    (is (false? (policy/unspsc-satisfies?
                 {:unspsc "43191501"}
                 {:unspsc-tags #{"50" "50202301"}})))
    (is (false? (policy/unspsc-satisfies?
                 {:unspsc "43191501"}
                 {:unspsc-tags #{}}))))
  (testing "eligible? composes unspsc with category/rank"
    (let [opp {:required-categories #{:役務} :min-rank :B :unspsc "43191501"}
          good {:categories #{:役務} :rank :A :unspsc-tags #{"43" "43191501"}}
          bad-tag {:categories #{:役務} :rank :A :unspsc-tags #{"50"}}]
      (is (policy/eligible? opp good))
      (is (not (policy/eligible? opp bad-tag))))))
