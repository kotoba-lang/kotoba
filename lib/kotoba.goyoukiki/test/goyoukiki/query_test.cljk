(ns goyoukiki.query-test
  (:require [kotoba.test :refer [deftest is testing]]
            [goyoukiki.model :as model]
            [goyoukiki.query :as query]
            [goyoukiki.store :as store]))

(defn- backends [] [["MemStore" (store/seed-db)] ["DatomicStore" (store/datomic-seed-db)]])

(deftest match-status-and-shared?
  (doseq [[label s] (backends)]
    (testing label
      (is (= "none" (query/match-status s "opp-meti-cloud-2027" "cand-fujitera")))
      (is (not (query/shared? s "opp-meti-cloud-2027" "cand-fujitera")))

      (store/record-datom! s {:kind :match :id (model/match-id "opp-meti-cloud-2027" "cand-fujitera")
                              :value {:status :proposed}})
      (is (= "proposed" (query/match-status s "opp-meti-cloud-2027" "cand-fujitera")))
      (is (not (query/shared? s "opp-meti-cloud-2027" "cand-fujitera")) "proposed is not shared")

      (store/record-datom! s {:kind :match :id (model/match-id "opp-meti-cloud-2027" "cand-fujitera")
                              :value {:status :shared}})
      (is (= "shared" (query/match-status s "opp-meti-cloud-2027" "cand-fujitera")))
      (is (query/shared? s "opp-meti-cloud-2027" "cand-fujitera"))

      (is (= "none" (query/match-status s "opp-never-matched" "cand-never-matched")))
      (is (not (query/shared? s "opp-never-matched" "cand-never-matched"))
          "deny-by-default for never-matched pairings"))))
