(ns goyoukiki.matchport.tayori-test
  (:require [kotoba.lang.text :as str]
            [kotoba.test :refer [deftest is]]
            [goyoukiki.matchport :as matchport]
            [goyoukiki.matchport.tayori :as gt]
            [goyoukiki.model :as model]
            [kotoba.ontology.connector :as connector]
            [tayori.store :as tstore]))

(deftest draft-outreach-produces-a-clean-auto-committed-draft
  (let [opp    (model/opportunity "opp-1" "国立大学法人岡山大学" :tender {:title "テスト案件"})
        cand   (model/candidate "cand-1" "テスト業者" {:contact "vendor@example.com"})
        result (gt/draft-outreach! opp cand)]
    (is (= :proposed (:status (:draft result))))
    (is (some? (:text (:draft result))))
    (is (= {:id "cand-1" :channel :email :address "vendor@example.com"
            :consent :known :first-contact? true}
           (tstore/contact (:tayori-store result) "cand-1"))
        "the candidate's own :contact was registered as a tayori ground fact")))

(deftest draft-outreach-carries-ontology-provenance-into-the-seeded-message
  (let [opp    (connector/tag :jp.kkj (model/opportunity "opp-2" "総務省" :tender {:title "案件2"}))
        cand   (model/candidate "cand-2" "業者2" {:contact "biz@example.com"})
        result (gt/draft-outreach! opp cand)
        msgs   (tstore/messages-of (:tayori-store result) (:thread-id result))]
    (is (some #(str/includes? (:body %) "jp.kkj") msgs))
    (is (some #(str/includes? (:body %) "tender") msgs))))

(deftest draft-outreach-omits-provenance-note-for-an-untagged-opportunity
  (let [opp    (model/opportunity "opp-3" "内部提案" :tender {:title "内部案件"})
        cand   (model/candidate "cand-3" "業者3" {:contact "c@example.com"})
        result (gt/draft-outreach! opp cand)
        msgs   (tstore/messages-of (:tayori-store result) (:thread-id result))]
    (is (not-any? #(str/includes? (:body %) "出所") msgs))))

(deftest match-target-fetch-and-propose-mirror-mock-matchport-bookkeeping
  (let [mt   (gt/match-target)
        opp  (model/opportunity "opp-4" "agency" :tender {})
        cand (model/candidate "cand-4" "biz" {:contact "x@example.com"})]
    (is (nil? (matchport/fetch-match mt opp cand)))
    (is (string? (:receipt (matchport/propose-match! mt opp cand {}))))))

(deftest match-target-share-drafts-outreach-and-records-it-without-sending
  (let [mt     (gt/match-target)
        opp    (model/opportunity "opp-5" "agency" :tender {:title "案件5"})
        cand   (model/candidate "cand-5" "biz" {:contact "y@example.com"})
        m      (model/match "opp-5" "cand-5")
        result (matchport/share! mt opp cand m)]
    (is (= m result) "share! returns the match unchanged, same contract as mock-matchport")
    (is (= m (matchport/fetch-match mt opp cand)) "share! recorded the match as shared")))
