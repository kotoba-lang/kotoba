(ns goyoukiki.model-test (:export [main]) (:require [goyoukiki.model :as p]))

(defn- fedn [d :document k :keyword] :string
  (document-edn-print (option-or (document-get d k) (document-null))))

(defn- fstr [d :document k :keyword] :string
  (option-or (document-string-value (option-or (document-get d k) (document-null))) "?"))

(defn- fcount [d :document k :keyword] :i64
  (document-count (option-or (document-get d k) (document-null))))

(defn- main-case [] :i64
  (let [f (p/opportunity (document-string "O1") (document-string "agency") (document-keyword :forecast))
        t (p/opportunity-with (document-string "O2") (document-string "agency") (document-keyword :tender)
                              (document-map :title (document-string "T")))
        c (p/candidate (document-string "C1") (document-string "Vendor"))
        m (p/match (document-string "O1") (document-string "C1"))
        m2 (p/match-with (document-string "O2") (document-string "C2")
                         (document-map :status (document-keyword :accepted)))]
    (+ (if (string=? (fedn f :status) ":forecast") 0 1)
       (if (string=? (fedn t :status) ":open") 0 1)
       (if (string=? (fstr t :title) "T") 0 1)
       (if (string=? (fedn f :silence-period?) "false") 0 1)
       (if (= (fcount f :required-categories) 0) 0 1)
       (if (string=? (fedn c :status) ":qualified") 0 1)
       (if (string=? (fedn m :status) ":proposed") 0 1)
       (if (string=? (fedn m :score) "0.0") 0 1)
       (if (string=? (fedn m2 :status) ":accepted") 0 1)
       (if (string=? (fstr (document-map :x (p/match-id (document-string "O1") (document-string "C1"))) :x) "O1::C1") 0 1))))

(defn main [] :i64
  (main-case))
