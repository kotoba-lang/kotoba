(ns goyoukiki.jp.geps-test
  "Fixture-based tests against REAL rows captured from an actual downloaded
  落札実績オープンデータ diff file (successful_bid_record_info_diff_20260523,
  2026-07-06) — no live network call in this test; `download-zip-bytes` (the
  only network I/O) is not exercised, but `unzip-first-entry-text` IS
  exercised against a real in-memory zip built here."
  (:require [kotoba.bytes :as kbytes] [kotoba.lang.text :as str]
            [kotoba.test :refer [deftest is testing]]
            [goyoukiki.jp.geps :as geps]
            [kotoba.ontology.connector :as connector])
  (:import [java.io ByteArrayOutputStream]
           [java.util.zip ZipEntry ZipOutputStream]))

;; two real rows, byte-for-byte as downloaded (UTF-8, quoted, comma-separated,
;; no header — see ADR follow-up for provenance).
(def ^:private sample-csv-text
  "\"0000000000000559155\",\"令和８年度法令編集・管理機能等に係る共通情報検索システムの機能向上開発\",\"2026-05-22\",\"322300000.00\",\"W1\",\"8002040\",\"アイビー・システム株式会社\",\"9430001000237\"\r\n\"0000000000000579270\",\"尿試験紙(10項目)外104件(単価契約)\",\"2026-05-22\",\"25599170.00\",\"U1\",\"8002010\",\"株式会社日栄東海\",\"6011201003719\"\r\n")

(defn- zip-of ^bytes [entry-name ^String text]
  (let [baos (ByteArrayOutputStream.)]
    (with-open [zos (ZipOutputStream. baos)]
      (.putNextEntry zos (ZipEntry. entry-name))
      (.write zos (kbytes/utf8-bytes text))
      (.closeEntry zos))
    (.toByteArray baos)))

(deftest unzip-first-entry-text-strips-bom-and-decodes-utf8
  (let [zipped (zip-of "successful_bid_record_info_diff_20260523.csv"
                       (str "﻿" sample-csv-text))
        out    (geps/unzip-first-entry-text zipped)]
    (is (not (str/starts-with? out "﻿")))
    (is (str/includes? out "アイビー・システム株式会社"))))

(deftest parse-csv-extracts-fixed-8-column-order
  (let [[r1 r2] (geps/parse-csv sample-csv-text)]
    (is (= 2 (count (geps/parse-csv sample-csv-text))))
    (is (= "0000000000000559155" (:procurement-item-no r1)))
    (is (= "2026-05-22" (:successful-bid-date r1)))
    (is (= "322300000.00" (:successful-bid-price r1)))
    (is (= "W1" (:ministry-cd r1)))
    (is (= "8002040" (:bidding-method-cd r1)))
    (is (= "アイビー・システム株式会社" (:trade-name r1)))
    (is (= "9430001000237" (:corporation-no r1)))
    (is (= "U1" (:ministry-cd r2)))))

(deftest opportunity-mapping-is-awarded-status-with-official-ministry-name
  (let [[raw] (geps/parse-csv sample-csv-text)
        opp   (geps/->opportunity raw)]
    (is (= :tender (:kind opp)))
    (is (= :awarded (:status opp)) "GEPS open data is always history, never an open invitation")
    (is (= "デジタル庁" (:agency opp)) "W1 resolves via the official 府省コード table")
    (is (= "アイビー・システム株式会社" (:awarded-to opp)))
    (is (= 322300000.00M (:value opp)))
    (is (= "一般競争入札・総合評価" (:procedure-type opp)))
    (is (str/starts-with? (:id opp) "geps-"))))

(deftest unrecognized-ministry-code-falls-back-to-the-raw-code
  (testing "a code not in the (closed, official) table degrades to itself rather than throwing"
    (let [opp (geps/->opportunity {:procurement-item-no "x" :procurement-item-name "n"
                                    :ministry-cd "ZZ" :successful-bid-price ""})]
      (is (= "ZZ" (:agency opp)))
      (is (nil? (:value opp)) "an empty price string is not coerced to a bogus 0"))))

(deftest ministry-name-table-has-all-53-official-codes
  (is (= 53 (count geps/ministry-name))))

(deftest ingest-tags-opportunity-with-ontology-provenance
  (let [[raw] (geps/parse-csv sample-csv-text)
        opp   (connector/tag :jp.geps (geps/->opportunity raw))]
    (is (= :tender (:ontology/type opp)))
    (is (= :jp.geps (:ontology/source opp)))
    (is (true? (connector/tagged-conforms? :jp.geps opp))
        "a real GEPS awarded-bid fact conforms to the :tender object type once tagged")))
