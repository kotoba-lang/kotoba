(ns goyoukiki.jp.kkj-test
  "Fixture-based tests against a REAL (trimmed) kkj.go.jp API response
  captured 2026-07 — no live network call in this test; `fetch-xml` (the only
  I/O boundary) is not exercised here, only the pure parse/map functions."
  (:require [kotoba.lang.error :as kerror] [kotoba.lang.text :as str]
            [kotoba.test :refer [deftest is testing]]
            [goyoukiki.jp.kkj :as kkj]
            [kotoba.ontology.connector :as connector]))

;; a trimmed, real two-result response (岡山大学病院時間外受付業務 is a genuine
;; live tender captured 2026-07-06 — see ADR follow-up for provenance) plus a
;; second synthetic result exercising Certification/Category variety.
(def ^:private sample-xml
  "<?xml version=\"1.0\" encoding=\"utf-8\" ?>
<Results>
<Version>1.0</Version>
<SearchResults>
<SearchHits>343405</SearchHits>
<SearchResult>
<ResultId>1</ResultId>
<Key><![CDATA[b2theWFtYS9va2F5YW1hX3VfYWMvMjAyNi8yMDI2MDcwOV8wMDEzMgo=]]></Key>
<ExternalDocumentURI><![CDATA[https://keiyaku.ccsv.okayama-u.ac.jp/example.pdf]]></ExternalDocumentURI>
<ProjectName>岡山大学病院時間外受付業務</ProjectName>
<Date>2026-06-30T19:05:32+09:00</Date>
<FileType>pdf</FileType>
<FileSize>239116</FileSize>
<LgCode>33</LgCode>
<PrefectureName>岡山県</PrefectureName>
<CityCode>331007</CityCode>
<CityName>岡山市</CityName>
<OrganizationName>国立大学法人岡山大学</OrganizationName>
<Certification>A B C D</Certification>
<CftIssueDate>2026-07-09T00:00:00+09:00</CftIssueDate>
<PeriodEndTime>2026-09-30T00:00:00+09:00</PeriodEndTime>
<Category>役務</Category>
<ProcedureType>一般競争入札</ProcedureType>
</SearchResult>
<SearchResult>
<ResultId>2</ResultId>
<Key><![CDATA[dGVzdC1rZXktMg==]]></Key>
<ProjectName>庁舎清掃業務委託</ProjectName>
<OrganizationName>総務省</OrganizationName>
<Certification>A B</Certification>
<CftIssueDate>2026-07-01T00:00:00+09:00</CftIssueDate>
<Category>役務</Category>
</SearchResult>
</SearchResults>
</Results>")

(def ^:private error-xml
  "<?xml version=\"1.0\" encoding=\"utf-8\" ?><Results><Error>invalid sort</Error></Results>")

(deftest parse-results-extracts-every-field
  (let [[r1 r2] (kkj/parse-results sample-xml)]
    (is (= 2 (count (kkj/parse-results sample-xml))))
    (is (= "岡山大学病院時間外受付業務" (:project-name r1)))
    (is (= "国立大学法人岡山大学" (:organization-name r1)))
    (is (= "A B C D" (:certification r1)))
    (is (= "役務" (:category r1)))
    (is (= "2026-07-09T00:00:00+09:00" (:cft-issue-date r1)))
    (is (= "総務省" (:organization-name r2)))
    (is (nil? (:external-uri r2)) "an absent optional tag parses to nil, not empty string")))

(deftest parse-results-throws-on-error-response
  (is (thrown-with-msg? kerror/ExceptionInfo #"invalid sort"
                        (kkj/parse-results error-xml))))

(deftest opportunity-mapping-is-live-tender-open-status
  (let [[raw] (kkj/parse-results sample-xml)
        opp   (kkj/->opportunity raw)]
    (is (= :tender (:kind opp)))
    (is (= :open (:status opp)) "kkj.go.jp results are live/current, never awarded")
    (is (= "国立大学法人岡山大学" (:agency opp)))
    (is (= "岡山大学病院時間外受付業務" (:title opp)))
    (is (= #{:役務} (:required-categories opp)))
    (is (str/starts-with? (:id opp) "kkj-"))))

(deftest min-rank-picks-the-lowest-accepted-grade-not-the-highest
  (testing "Certification \"A B C D\" accepts everyone down to D -> floor is D"
    (let [opp (kkj/->opportunity (first (kkj/parse-results sample-xml)))]
      (is (= :D (:min-rank opp)))))
  (testing "Certification \"A B\" excludes C/D -> floor is B"
    (let [opp (kkj/->opportunity (second (kkj/parse-results sample-xml)))]
      (is (= :B (:min-rank opp))))))

(deftest missing-certification-yields-nil-min-rank
  (let [opp (kkj/->opportunity {:key "k" :project-name "p" :organization-name "o"})]
    (is (nil? (:min-rank opp)))
    (is (= #{} (:required-categories opp)) "an unrecognized/absent Category maps to no requirement")))

(deftest ingest-tags-opportunity-with-ontology-provenance
  (let [[raw] (kkj/parse-results sample-xml)
        opp   (connector/tag :jp.kkj (kkj/->opportunity raw))]
    (is (= :tender (:ontology/type opp)))
    (is (= :jp.kkj (:ontology/source opp)))
    (is (true? (connector/tagged-conforms? :jp.kkj opp))
        "a real kkj.go.jp fact conforms to the :tender object type once tagged")))
