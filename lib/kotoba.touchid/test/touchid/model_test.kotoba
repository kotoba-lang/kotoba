(ns touchid.model-test (:export [main]) (:require [touchid.model :as m]))

(defn- fld [d :document k :keyword] :document
  (option-or (document-get d k) (document-null)))

(defn- same [a :document b :document] :bool
  (string=? (document-edn-print a) (document-edn-print b)))

(defn main [] :i64
  (let [opts (document-map :challenge (document-string "c1") :rp-id (document-string "example.com") :subject (document-string "u1"))
        req (m/request (document-string "r1") opts)
        exp-req (document-map :touchid/id (document-string "r1") :touchid/purpose (document-keyword :step-up)
                              :touchid/challenge (document-string "c1") :touchid/rp-id (document-string "example.com")
                              :touchid/subject (document-string "u1") :touchid/created-at (document-null))
        att (m/attestation req true (document-map :device-id (document-string "d1")))
        exp-att (document-map :touchid/id (document-string "r1") :touchid/ok? (document-bool true)
                              :touchid/purpose (document-keyword :step-up) :touchid/subject (document-string "u1")
                              :touchid/device-id (document-string "d1") :touchid/credential-id (document-null)
                              :touchid/provider (document-null) :touchid/evidence-ref (document-null)
                              :touchid/attested-at (document-null))
        pur (m/purposes)
        fk (m/forbidden-keys)
        purp (document-map :purpose (document-keyword :sign))
        req2 (m/request (document-string "r2") purp)]
    (+ (if (same req exp-req) 0 1)
       (if (same att exp-att) 0 1)
       (if (document-set-contains? pur (document-keyword :sign)) 0 1)
       (if (document-set-contains? pur (document-keyword :bogus)) 1 0)
       (if (document-set-contains? fk (document-keyword :raw-fingerprint)) 0 1)
       (if (same (fld req2 :touchid/purpose) (document-keyword :sign)) 0 1)
       (if (same (fld (m/attestation req2 false (document-map)) :touchid/ok?) (document-bool false)) 0 1))))
