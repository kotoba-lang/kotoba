;; Port of touchid.model (model.cljk), Kotoba-native, :document maps.
;;
;; Named divergences from model.cljk:
;;   - purposes and forbidden-keys are sets of keywords, built with
;;     document-edn-read (zero-arg fns, since def cannot be exported).
;;   - (get opts k default) is option-or of document-get; a missing key and a
;;     nil key both map to document-null, as nil does in the source.

(ns touchid.model
  (:export [purposes forbidden-keys request attestation]))

(defn purposes [] :document
  (document-edn-read "#{:unlock :step-up :consent :reveal :sign}"))

(defn forbidden-keys [] :document
  (document-edn-read "#{:raw-fingerprint :fingerprint-template :touch-template :biometric-template}"))

(defn- fld [m :document k :keyword] :document
  (option-or (document-get m k) (document-null)))

(defn request [id :document opts :document] :document
  (document-map
    :touchid/id id
    :touchid/purpose (option-or (document-get opts :purpose) (document-keyword :step-up))
    :touchid/challenge (fld opts :challenge)
    :touchid/rp-id (fld opts :rp-id)
    :touchid/subject (fld opts :subject)
    :touchid/created-at (fld opts :created-at)))

(defn attestation [req :document ok? :bool opts :document] :document
  (document-map
    :touchid/id (fld req :touchid/id)
    :touchid/ok? (document-bool ok?)
    :touchid/purpose (fld req :touchid/purpose)
    :touchid/subject (fld req :touchid/subject)
    :touchid/device-id (fld opts :device-id)
    :touchid/credential-id (fld opts :credential-id)
    :touchid/provider (fld opts :provider)
    :touchid/evidence-ref (fld opts :evidence-ref)
    :touchid/attested-at (fld opts :attested-at)))
