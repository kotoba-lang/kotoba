(ns touchid.datom
  ;; Kotoba port of touchid.datom/attestation-datoms (parity slice, ADR-2608261100).
  ;; Classification: portable pure — one attestation value maps to one datom
  ;; record; no host capability, no interop.
  ;;
  ;; Shape note: the cljc original returns a one-element vector of datom maps.
  ;; Kotoba's js-browser safe profile has no homogeneous vector-of-record, so
  ;; this port returns the single datom record itself; the parity test
  ;; (touchid.datom-parity-test) compares it against the first (and only)
  ;; element of the cljc result.
  (:export [attestation-datoms])
  (:schemas {:touchid/attestation [:record :touchid/attestation
                                   [[:touchid/id :string]
                                    [:touchid/ok? :bool]
                                    [:touchid/purpose :keyword]
                                    [:touchid/subject :string]
                                    [:touchid/device-id :string]
                                    [:touchid/credential-id :string]
                                    [:touchid/provider :keyword]
                                    [:touchid/evidence-ref :string]
                                    [:touchid/attested-at :string]]]
             :touchid/datom [:record :touchid/datom
                             [[:db/id :string]
                              [:touchid/ok? :bool]
                              [:touchid/purpose :keyword]
                              [:touchid/subject :string]
                              [:touchid/device-id :string]
                              [:touchid/credential-id :string]
                              [:touchid/provider :keyword]
                              [:touchid/evidence-ref :string]
                              [:touchid/attested-at :string]]]}))

(defn attestation-datoms [a [:ref :touchid/attestation]] [:ref :touchid/datom]
  (record-new [:ref :touchid/datom]
              (record-get a :touchid/id)
              (record-get a :touchid/ok?)
              (record-get a :touchid/purpose)
              (record-get a :touchid/subject)
              (record-get a :touchid/device-id)
              (record-get a :touchid/credential-id)
              (record-get a :touchid/provider)
              (record-get a :touchid/evidence-ref)
              (record-get a :touchid/attested-at)))
