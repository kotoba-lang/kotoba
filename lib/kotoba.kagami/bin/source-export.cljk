#!/usr/bin/env kbb
(ns source-export.cli (:require [kagami.source-export-io :as export]))
(try (println (pr-str (export/main (vec *command-line-args*))))
     (catch :default e
       (binding [*print-fn* *print-err-fn*] (println (pr-str {:error (ex-message e) :data (ex-data e)})))
       (set! (.-exitCode js/process) 1)))
