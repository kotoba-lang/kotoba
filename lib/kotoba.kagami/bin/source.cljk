#!/usr/bin/env kbb
(ns source.cli (:require [kagami.source-cli :as source]))
(try
  (println (pr-str (source/main (vec *command-line-args*))))
  (catch :default e
    (binding [*print-fn* *print-err-fn*]
      (println (pr-str {:error (ex-message e) :data (ex-data e)})))
    (set! (.-exitCode js/process) 1)))
