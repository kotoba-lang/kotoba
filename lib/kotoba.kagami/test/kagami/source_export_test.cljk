(ns kagami.source-export-test
  (:require [kotoba.test :refer [deftest is]]
            [kagami.source-export :as e] [kagami.source-export-io :as export]
            [kagami.source-io :as io] [kagami.source-publication-io :as publication]
            [kagami.source-test :as st]))

(deftest github-transport-equivalence-is-host-and-repository-scoped
  (is (= "kotoba-lang/test" (e/github-id "https://github.com/kotoba-lang/test.git")))
  (is (= (io/remote-identity "https://github.com/Kotoba-Lang/test.git")
         (io/remote-identity "git@github.com:kotoba-lang/test.git")
         (io/remote-identity "ssh://git@github.com/kotoba-lang/test")))
  (is (not= (io/remote-identity "https://example.com/kotoba-lang/test.git")
            (io/remote-identity "git@github.com:kotoba-lang/test.git")))
  (is (not= (io/remote-identity "git@github.com:kotoba-lang/other.git")
            (io/remote-identity "git@github.com:kotoba-lang/test.git")))
  (is (nil? (e/github-id "https://github.com.evil/kotoba-lang/test.git"))))

(deftest exporter-reports-committed-declarations-without-selecting-package-versions
  (let [data {:deps {'io.github.kotoba-lang/test {:git/sha st/new}
                     'org.clojure/clojure {:mvn/version "1.12.0"}
                     'local/foo {:local/root "../foo"}}
              :aliases {:dev {:extra-deps {'unknown/pkg {:git/tag "moving"}}}}}
        deps (e/declarations data (constantly "kotoba-lang/foo"))]
    (is (= #{"kotoba-lang/test" "kotoba-lang/foo"} (set (keep :source deps))))
    (is (= st/new (:git/sha (first (filter #(= :git (:kind %)) deps)))))
    (is (= "1.12.0" (:mvn/version (first (filter #(= :maven (:kind %)) deps))))))
  (is (= :unsupported-source-dependency
         (st/reason #(e/declarations {:deps {'io.github.a/b {:git/sha "abc"}}} identity))))
  (is (= :unsupported-dependency
         (st/reason #(e/declarations {:deps {'a/b {:git/tag "moving"}}} identity)))))

(deftest descriptors-must-be-regular-committed-files
  (is (= :unsupported-descriptor-mode
         (with-redefs [io/git (fn [& _] "120000 blob symlink")]
           (st/reason #(export/optional-at "repo" st/old "deps.edn")))))
  (is (nil? (with-redefs [io/git (fn [& _] "")]
              (export/optional-at "repo" st/old "deps.edn")))))

(deftest explicit-key-provider-is-direct-and-must-be-absolute
  (is (= :invalid-key-provider
         (st/reason #(publication/key! {:kagi "specific-item" :root "/forest" :kagi-command "relative"}))))
  (is (= :invalid-key-provider
         (st/reason #(publication/key! {:key "pem" :kagi-command "/provider"}))))
  (is (= ["/provider" "get" "specific-item" "--compartment" "personal"]
         (with-redefs [io/run (fn [argv _] argv)]
           (publication/key! {:kagi "specific-item" :root "/forest" :kagi-command "/provider"})))))
