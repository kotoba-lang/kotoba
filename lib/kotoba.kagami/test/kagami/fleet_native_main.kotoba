(defn test-chain-into [heads :document invalid :document out :vector-i64] :bool
  (let [expected (hex-bytes "86a82f14803b4534cf4fcf2b19074135cbee71e7e546ae43527b5072b8f6af8d")]
    (and (loop [i 0]
           (if (= i 32) true
             (and (verify-edn-chain-into out heads 124 "bb74d1a4a818133cbe9ff0409b3eebfb9adefddd637203d958d48692620f0278" "did:key:z6MknGPnq6WLT1g5UoB3SP31wdnBbm6BKF1QreX2qneHTJEQ")
                  (bytes=? out expected) (recur (+ i 1)))))
         (not (verify-edn-chain-into out invalid 124 "bb74d1a4a818133cbe9ff0409b3eebfb9adefddd637203d958d48692620f0278" "did:key:z6MknGPnq6WLT1g5UoB3SP31wdnBbm6BKF1QreX2qneHTJEQ"))
         (bytes=? out expected)
         (not (verify-edn-chain-into (vector-alloc 31) heads 124 "bb74d1a4a818133cbe9ff0409b3eebfb9adefddd637203d958d48692620f0278" "did:key:z6MknGPnq6WLT1g5UoB3SP31wdnBbm6BKF1QreX2qneHTJEQ")))))

