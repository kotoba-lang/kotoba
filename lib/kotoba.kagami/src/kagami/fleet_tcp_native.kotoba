;; Experimental framed transport adapter. This consumes an already-connected
;; noise.tcp handle; it does not perform a Noise handshake, authenticate a peer,
;; discover peers, provision trust, or define a production fleet wire protocol.
(ns kagami.fleet-tcp-native
  (:require [noise.tcp :as tcp] [kagami.fleet-announce-edn :as ingress])
  (:export [receive-successor valid-utf8?]))

(defn cont? [b :i64] :bool (and (>= b 128) (<= b 191)))
;; Reject malformed UTF-8, overlong forms, surrogates and > U+10FFFF before
;; string-from-utf8. The EDN ingress separately caps and validates the text.
(defn valid-utf8? [v :vector-i64] :bool
  (let [n (vector-count v)]
    (if (or (= n 0) (> n 8192)) false
      (loop [i 0]
        (if (= i n) true
          (let [a (vector-at v i)
                b (if (< (+ i 1) n) (vector-at v (+ i 1)) -1)
                c (if (< (+ i 2) n) (vector-at v (+ i 2)) -1)
                d (if (< (+ i 3) n) (vector-at v (+ i 3)) -1)]
            (cond (and (>= a 0) (<= a 127)) (recur (+ i 1))
                  (and (>= a 194) (<= a 223) (cont? b)) (recur (+ i 2))
                  (and (>= a 224) (<= a 239) (cont? b) (cont? c)
                       (or (not= a 224) (>= b 160)) (or (not= a 237) (< b 160))) (recur (+ i 3))
                  (and (>= a 240) (<= a 244) (cont? b) (cont? c) (cont? d)
                       (or (not= a 240) (>= b 144)) (or (not= a 244) (<= b 143))) (recur (+ i 4))
                  :else false)))))))

(defn receive-successor [out :vector-i64 base :string seq :i64 hash :string value :string signer :string handle :string ms :i64] :string
  (if (or (< ms 1) (> ms 30000)) "invalid"
    (let [body (tcp/recv-frame handle ms)]
      (if (not (valid-utf8? body)) "invalid"
        (ingress/advance-successor-edn out base seq hash value signer (string-from-utf8 (bytes-from-vector-i64 body)))))))
