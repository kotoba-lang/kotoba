(ns kagami.source-cli
  (:require [kagami.source-io :as io]
            [kagami.source-publication-io :as publication]))

(defn main [argv]
  (let [[command & args] argv]
    (case command
      "publish-prepare"
      (publication/prepare!
        (io/needed! (io/options args #{:manifest :expected :base :snapshot :revision :lock :evidence :reviews
                                      :key :kagi :kagi-command :root :remote :out :message})
                    [:manifest :expected :base :snapshot :revision :lock :evidence :reviews :root :out]))
      "publish-apply"
      (publication/publish! (io/needed! (io/options args #{:manifest :prepared :root :out}) [:manifest :prepared :root]))
      "evidence"
      (publication/attest! :ci (io/needed! (io/options args #{:manifest :expected :snapshot :revision :checks :key :kagi :kagi-command :root :out})
                                          [:manifest :expected :snapshot :revision :checks :out]))
      "review"
      (publication/attest! :review (io/needed! (io/options args #{:manifest :expected :snapshot :revision :repos :key :kagi :kagi-command :root :out})
                                              [:manifest :expected :snapshot :revision :repos :out]))
      (io/main argv))))
