(ns kagami.fleet-announce-edn
  (:export [advance-edn])
  (:require [kagami.fleet-store-native :as store]
            [kotoba-harness.data :as data]))

;; Bounded EDN ingress for the existing head-announce map. This accepts the
;; explicit-keyword EDN representation (:pin/name etc.), not namespaced-map
;; sugar (#:pin{...}); no transport, trust provisioning or key rotation.
;; The caller supplies an independently trusted anchor and signer; candidate
;; links may be untrusted and are verified before any checkpoint update.
(defn delimiter? [c :i64] :bool
  (or (= c 32) (= c 9) (= c 10) (= c 13) (= c 44)
      (= c 123) (= c 125) (= c 91) (= c 93)))
(defn keyword-end [v :vector-i64 i :i64 n :i64] :i64
  (if (or (= i n) (delimiter? (vector-at v i))) i (keyword-end v (+ i 1) n)))
(defn keyword-allowed? [s :string] :bool
  (or (string=? s ":type") (string=? s ":head-announce") (string=? s ":graph")
      (string=? s ":head-cid") (string=? s ":seq") (string=? s ":origin")
      (string=? s ":from") (string=? s ":fleet-head") (string=? s ":record")
      (string=? s ":pin/name") (string=? s ":pin/value") (string=? s ":pin/sequence")
      (string=? s ":pin/parent") (string=? s ":pin/valid-until")
      (string=? s ":signature") (string=? s ":signer")))
(defn lexical-safe? [raw :string] :bool
  (let [v (vector-i64-from-bytes (string-to-utf8 raw)) n (vector-count v)]
    (if (or (= n 0) (> n 8192)) false
      (loop [i 0 quoted false escaped false]
        (if (= i n) (and (not quoted) (not escaped))
          (let [c (vector-at v i)]
            (cond quoted (cond escaped (recur (+ i 1) true false)
                               (= c 92) (recur (+ i 1) true true)
                               (= c 34) (recur (+ i 1) false false)
                               :else (recur (+ i 1) true false))
                  (= c 34) (recur (+ i 1) true false)
                  (or (= c 91) (= c 93)) false
                  (= c 58) (let [end (keyword-end v (+ i 1) n)]
                             (if (keyword-allowed? (string-substring raw i end))
                               (recur end false false) false))
                  (or (delimiter? c) (and (>= c 48) (<= c 57)) (= c 45)
                      (= c 110) (= c 105) (= c 108)) (recur (+ i 1) false false)
                  :else false)))))))
(defn advance-edn [out :vector-i64 base :string seq :i64 hash :string value :string signer :string
                   heads :document raw :string] :string
  (if (not (lexical-safe? raw)) "invalid"
    (let [parsed (data/read-edn raw)]
      (if (or (not (string=? (data/error parsed) "")) (not (map? (data/value parsed))))
        "invalid"
        (store/advance-message out base seq hash value signer heads (data/value parsed))))))
