(ns kagami.source-export
  "Project committed owner dependency declarations into a source-checkout graph.
   This does not select package versions or replace the language resolver."
  (:require [kotoba.lang.text :as str]
            [kagami.source :as s]))

(def contract
  {:resolver/version 1 :resolver/profile :cljk-operational
   :resolver/descriptors ["deps.edn" "nbb.edn"] :resolver/aliases []
   :resolver/graph :declared-source-repositories
   :resolver/artifacts :resolved-by-existing-package-tools})

(defn github-id [url]
  (when (string? url)
    (some-> (re-matches #"(?:https://github\.com/|ssh://git@github\.com/|git@github\.com:)([A-Za-z0-9._-]+/[A-Za-z0-9._-]+)" (str/replace url #"\.git$" ""))
            second)))

(defn dependency [coordinate spec local-id]
  (s/require! (map? spec) :unsupported-dependency {:coordinate (str coordinate)})
  (cond
    (:local/root spec)
    {:source (local-id (:local/root spec)) :coordinate (str coordinate) :kind :local}
    (:git/sha spec)
    (let [derived (when (and (symbol? coordinate) (str/starts-with? (or (namespace coordinate) "") "io.github."))
                    (str (subs (namespace coordinate) 10) "/" (name coordinate)))
          id (if (:git/url spec) (github-id (:git/url spec)) derived)]
      (s/require! (and (s/repo-id? id) (s/oid? (:git/sha spec)))
                  :unsupported-source-dependency {:coordinate (str coordinate)})
      {:source id :coordinate (str coordinate) :kind :git :git/sha (:git/sha spec)})
    (:mvn/version spec)
    {:coordinate (str coordinate) :kind :maven :mvn/version (:mvn/version spec)}
    :else (throw (ex-info "dependency needs its owning resolver" {:reason :unsupported-dependency :coordinate (str coordinate)}))))

(defn declarations [data local-id]
  (s/require! (and (map? data) (or (nil? (:deps data)) (map? (:deps data)))) :invalid-dependency-descriptor {})
  (mapv (fn [[coordinate spec]] (dependency coordinate spec local-id))
        (sort-by (comp str key) (:deps data))))
