;; Experimental responder for the existing Noise XXhfs identity framing.
;; The caller supplies fresh secure randomness and an independently trusted
;; 1984-byte peer identity; no secret generation, key storage, roster or
;; production endpoint policy is provided here. Implementations used by this
;; path are not yet qualified constant-time. Close the handle on failure.
(ns kagami.fleet-noise-handshake
  (:require [noise.native :as noise] [noise.identity :as identity] [noise.tcp :as tcp])
  (:export [accept-peer]))

(defn bytes? [v :vector-i64 n :i64] :bool
  (and (= (vector-count v) n)
       (loop [i 0] (if (= i n) true
         (and (>= (vector-at v i) 0) (<= (vector-at v i) 255) (recur (+ i 1)))))))
(defn head [v :vector-i64] :vector-i64
  (let [n (noise/state-size)]
    (if (< (vector-count v) n) (vector-i64)
      (loop [i 0 out (vector-alloc n)]
        (if (= i n) out (recur (+ i 1) (vector-assoc! out i (vector-at v i))))))))
(defn tail [v :vector-i64] :vector-i64
  (let [n (noise/state-size) len (- (vector-count v) n)]
    (if (< len 0) (vector-i64)
      (loop [i 0 out (vector-alloc len)]
        (if (= i len) out (recur (+ i 1) (vector-assoc! out i (vector-at v (+ n i)))))))))

(defn accept-peer [handle :string ms :i64 static :vector-i64 ephemeral :vector-i64 kem-m :vector-i64
                   ed-seed :vector-i64 dsa-seed :vector-i64 expected :vector-i64 prologue :vector-i64] [:option :vector-i64]
  (if (or (< ms 1) (> ms 30000) (not (bytes? static 32)) (not (bytes? ephemeral 32))
          (not (bytes? kem-m 32)) (not (bytes? ed-seed 32)) (not (bytes? dsa-seed 32))
          (not (bytes? expected 1984)) (> (vector-count prologue) 256)
          (not (bytes? prologue (vector-count prologue)))) (option-none-of [:option :vector-i64])
    (let [state (noise/set-kem (noise/initialize 3 false static ephemeral (vector-i64) prologue) (vector-i64) kem-m)
          first (noise/read-message state (tcp/recv-frame handle ms))]
      (if (< (vector-count first) (noise/state-size)) (option-none-of [:option :vector-i64])
        (let [tokens (noise/write-tokens (head first))]
          (if (< (vector-count tokens) (noise/state-size)) (option-none-of [:option :vector-i64])
            (let [payload (identity/payload ed-seed dsa-seed (noise/handshake-hash-now (head tokens)))
                  message (noise/write-payload (head tokens) (tail tokens) payload)]
              (if (or (not (= (vector-count payload) (identity/payload-size)))
                      (< (vector-count message) (noise/state-size))
                      (not (= (tcp/send-frame handle (tail message)) 0))) (option-none-of [:option :vector-i64])
                (let [received (noise/read-tokens (head message) (tcp/recv-frame handle ms))]
                  (if (< (vector-count received) (noise/state-size)) (option-none-of [:option :vector-i64])
                    (let [hash (noise/handshake-hash-now (head received))
                          done (noise/read-payload (head received) (tail received))]
                      (if (and (>= (vector-count done) (noise/state-size))
                               (identity/verify-payload (tail done) hash expected)
                               (= (vector-count (noise/handshake-hash (head done))) 32))
                        (option-some-of [:option :vector-i64] (head done))
                        (option-none-of [:option :vector-i64])))))))))))))
