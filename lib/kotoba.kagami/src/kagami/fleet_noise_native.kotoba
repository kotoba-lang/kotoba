;; Experimental Noise transport integration. The caller MUST finish the
;; handshake, verify the peer identity against an independently provisioned
;; roster, and own a single-use session state before calling this function.
;; This function does not perform or assert peer authentication or key setup.
(ns kagami.fleet-noise-native
  (:require [noise.native :as noise] [noise.tcp :as tcp]
            [kagami.fleet-tcp-native :as raw] [kagami.fleet-announce-edn :as ingress])
  (:export [receive-successor]))

;; After an authenticated frame decrypts, next-state is always written even
;; when the fleet record is rejected: reusing the old receive nonce is unsafe.
;; On malformed ciphertext, invalid state, or read failure returns
;; channel-invalid, leaves next-state untouched, and the caller must close the
;; session. The caller owns both output
;; buffers and must serialize calls and persist its trusted checkpoint itself.
(defn receive-successor [out :vector-i64 next-state :vector-i64 state :vector-i64
                         base :string seq :i64 hash :string value :string signer :string
                         handle :string ms :i64] :string
  (if (or (not (= (vector-count out) 64)) (not (= (vector-count next-state) (noise/state-size)))
          (not (= (vector-count state) (noise/state-size))) (< ms 1) (> ms 30000)) "channel-invalid"
    (let [role (vector-at state 293) done (vector-at state 295)
          nonce (vector-at state (if (= role 1) 361 328))]
     (if (or (not (or (= role 0) (= role 1))) (not (= done 1)) (< nonce 0) (= nonce 9223372036854775807)) "channel-invalid"
      (let [frame (tcp/recv-frame handle ms) n (vector-count frame)]
      (if (or (< n 16) (> n 8208)) "channel-invalid"
        (let [decoded (noise/transport-decrypt state frame) size (noise/state-size)]
          (if (< (vector-count decoded) size) "channel-invalid"
            (let [length (- (vector-count decoded) size) body (vector-alloc length)
                  copied (loop [i 0]
                           (if (= i size) true
                             (let [x (vector-assoc! next-state i (vector-at decoded i))] (recur (+ i 1)))))
                  copied-body (loop [i 0]
                                (if (= i length) true
                                  (let [x (vector-assoc! body i (vector-at decoded (+ size i)))] (recur (+ i 1)))))]
              (if (not (raw/valid-utf8? body)) "invalid"
                (ingress/advance-successor-edn out base seq hash value signer (string-from-utf8 (bytes-from-vector-i64 body)))))))))))))
