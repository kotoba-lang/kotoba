(ns kagami.source-workspace
  "Pure fixed-Snapshot working-set planner. IO reuses the forest factory and
   detached Git worktrees; the canonical owner checkout never switches."
  (:require [kagami.source :as source]))

(defn plan [snapshot roots {:keys [root agent task]}]
  (source/require! (and (string? root) (source/segment? agent) (source/segment? task))
                   :invalid-workspace-scope {})
  (let [s (source/kind! snapshot :snapshot)
        ids (set (source/closure snapshot roots))
        repos (filterv #(ids (:repo/id %)) (:snapshot/repos s))]
    (doseq [r repos]
      (source/require! (= :git (:repo/materialization r))
                       :unsupported-materialization {:repo (:repo/id r) :kind (:repo/materialization r)}))
    {:workspace/version 1 :workspace/snapshot (:source/cid snapshot)
     :workspace/root root :workspace/agent agent :workspace/task task
     :workspace/roots roots :workspace/repos repos}))
