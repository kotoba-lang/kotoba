#!/usr/bin/env kbb
;; CLJS（kbb）で回す。判断は全部 .cljk なので JVM でも同じテストが走る。
;;
;;   kbb --backend sci --classpath "src:test:<kad-dht>/src:<sha2>/src:<text>/src:<test>/src" run-tests.cljk
(ns run-tests
  (:require [cljs.test :as t]
            [nuno.core-test]))

(defmethod t/report [:cljs.test/default :end-run-tests] [m]
  (println)
  (println (str "Ran " (:test m) " tests, " (:pass m) " assertions passed, "
                (:fail m) " failures, " (:error m) " errors."))
  (when-not (t/successful? m)
    (js/process.exit 1)))

(t/run-tests 'nuno.core-test)
