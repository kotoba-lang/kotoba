{:paths ["src"]
 ;; 布（nuno）。keyspace は kad-dht の kad.key だけを使う。検証・通信・ハッシュは
 ;; 全部 host から注入するので、ここに crypto も socket も clock も無い。
 :deps {
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}
        io.github.kotoba-lang/io-libp2p-specs-kad-dht {:local/root "../kotoba.ioLibp2pSpecsKadDht"}}
 :aliases
 {:local {:override-deps
          {io.github.kotoba-lang/io-libp2p-specs-kad-dht {:local/root "../io-libp2p-specs-kad-dht"}}}
  ;; SHA-256 はテストでだけ要る（本番では host が注入する）。
  :test {:extra-paths ["test"]
         :extra-deps {io.github.kotoba-lang/org-nist-sha2
                      {:git/url "https://github.com/kotoba-lang/org-nist-sha2.git"
                       :git/sha "59e0ccb99106dd3e4f8a5047346001e38708b084"}
                      io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}}}
