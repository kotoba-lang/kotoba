;; en — EN native currency unit riding on kotoba-lang/engi's L1 (ADR-2607993000).
;;
;; `src/en/core.cljk` is pure (no I/O, no crypto, no wall clock) and depends
;; only on `engi.core` (also pure) — reused unchanged rather than
;; duplicating its invariant-checking replay logic. No kotobase.net I/O
;; layer exists yet in this repo (that's follow-up, once a real
;; block-resolution/witness-transport consumer is needed) — see README
;; "Deliberately NOT implemented (v1 scope)".
{:paths ["src"]
 :deps {
        io.github.kotoba-lang/inga
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "af1a7179b7de6f29f6b816ecdbd2e98e6165d203"
         :deps/root "lib/kotoba.ingaCore"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/engi {:local/root "../kotoba.engi"}}
 :aliases
 {:test {:extra-paths ["test"]}
}}
