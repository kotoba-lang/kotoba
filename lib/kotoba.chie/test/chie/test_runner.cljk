(ns chie.test-runner
  (:require [kotoba.io :as io]
            [kotoba.test :as test]))

(defn- file-ns [file]
  (with-open [r (java.io.PushbackReader. (io/reader file))]
    (second (read {:read-cond :allow :features #{:clj}} r))))

(defn -main [& _]
  (let [files (->> (io/file-seq (io/file "lib/kotoba.chie/test/chie"))
                   (filter #(io/file? %))
                   (filter #(re-find #"\.clj(c)?$" (io/file-name %)))
                   (remove #(= "test_runner.clj" (io/file-name %)))
                   (sort-by str))
        namespaces (mapv file-ns files)]
    (doseq [file files] (load-file (str file)))
    (let [{:keys [fail error]} (apply test/run-tests namespaces)]
      (shutdown-agents)
      (when (pos? (+ fail error)) (System/exit 1)))))
