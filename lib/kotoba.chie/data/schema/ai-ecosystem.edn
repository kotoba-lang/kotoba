;; chie (智慧) kotoba EAVT schema — AI-ecosystem KG mirror (ADR-2606171200)
;; db/ident form for kqe + etzhayyim.kotoba.ingest. The rich ontology (axes / forbidden /
;; bridge) lives in 20-actors/chie/kotoba/ontology.edn; this declares the attribute vocabulary
;; so the seed ingests into the root kotoba Datom log with zero undeclared-attr drift.
;; G4 INVARIANT: there is NO :trade / :forecast / :ai/score attribute — unrepresentable.
{:schema/id "ai-ecosystem-ontology"
 :schema/adr "ADR-2606171200"
 :attributes
 [;; ── nodes (:organism/* + :ai/* facets) ──────────────────────────────────────
 {:db/ident :organism/id        :db/valueType :db.type/string  :db/cardinality :db.cardinality/one :db/unique :db.unique/identity}
 {:db/ident :organism/kind      :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one}   ;; :ai.org/lab :ai.org/company :ai.org/funder :ai.org/state :ai.org/standards :ai.org/research :ai.role/person :ai.invest/round :ai.policy/instrument :ai.asset/model :ai.asset/compute
 {:db/ident :organism/label     :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}
 {:db/ident :organism/sourcing  :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one}   ;; :representative | :authoritative
 {:db/ident :organism/nests-in  :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}   ;; child → parent org id

 {:db/ident :ai/sector          :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one}   ;; :frontier-lab :chip :foundry :cloud :vc :swf :regulator :open-weights :cluster :round …
 {:db/ident :ai/open?           :db/valueType :db.type/boolean :db/cardinality :db.cardinality/one}   ;; open-weights/compute/standard — OPENING-routing basis
 {:db/ident :ai/role            :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}   ;; public role descriptor (:ai.role/person)
 {:db/ident :ai/round-amount-usd :db/valueType :db.type/long   :db/cardinality :db.cardinality/one}   ;; DISCLOSED funding-round amount (fact, N3) — set by ingest

 ;; ── 縁 (edges) — 取 lives ONLY here (N1) ─────────────────────────────────────
 {:db/ident :en/from            :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}
 {:db/ident :en/to              :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}
 {:db/ident :en/kind            :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one}   ;; :invests-in :compute-deal :talent-flow :governs :sets-standard :partners :holds-role :depends-on
 {:db/ident :en/grasping-load   :db/valueType :db.type/double  :db/cardinality :db.cardinality/one}   ;; ∈ [0,1] lock-in/dependency weight
 {:db/ident :en/sourcing        :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one}   ;; :representative | :authoritative
 {:db/ident :en/disclosed-src   :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}]} ;; primary-source URL (ingest provenance, G7 leg)
