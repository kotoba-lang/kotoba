;; Native facade; host aliases retain their existing .cljk implementation.
(ns kotoba.async
  (:export [chan fixed-chan closed? can-put? can-take? put channel-take close drain scope scope-spawn scope-close scope-complete scope-fail scope-cancel scope-join-ready? scope-summary])
  (:require [kotoba.lang.async :as impl]))

(defn chan [kind :keyword capacity :i64] :document
  (impl/chan kind capacity))

(defn fixed-chan [capacity :i64] :document
  (impl/fixed-chan capacity))

(defn closed? [state :document] :bool
  (impl/closed? state))

(defn can-put? [state :document] :bool
  (impl/can-put? state))

(defn can-take? [state :document] :bool
  (impl/can-take? state))

(defn put [state :document value :document] :document
  (impl/put state value))

(defn channel-take [state :document] :document
  (impl/channel-take state))

(defn close [state :document] :document
  (impl/close state))

(defn drain [state :document] :document
  (impl/drain state))

(defn scope [] :document
  (impl/scope))

(defn scope-spawn [state :document task :document] :document
  (impl/scope-spawn state task))

(defn scope-close [state :document] :document
  (impl/scope-close state))

(defn scope-complete [state :document id :i64 value :document] :document
  (impl/scope-complete state id value))

(defn scope-fail [state :document id :i64 error :document] :document
  (impl/scope-fail state id error))

(defn scope-cancel [state :document reason :document] :document
  (impl/scope-cancel state reason))

(defn scope-join-ready? [state :document] :bool
  (impl/scope-join-ready? state))

(defn scope-summary [state :document] :document
  (impl/scope-summary state))
