;; Port of kotoba.async.scope-summary (scope_summary.cljk), Kotoba-native, :document maps.
;;
;; Named divergences from scope_summary.cljk:
;;   - select-keys is written out: each of :status :children :failure is copied
;;     when the key is present in s (a present nil copies as document-null).
;;   - s must be a :document map; the source's nil input (select-keys nil => {})
;;     is not modelled.

(ns kotoba.async.scope-summary
  (:export [scope-summary]))

(defn- copy-key [out :document s :document k :keyword] :document
  (if (document-contains s k)
    (document-assoc out k (option-or (document-get s k) (document-null)))
    out))

(defn scope-summary [s :document] :document
  (copy-key (copy-key (copy-key (document-map) s :status) s :children) s :failure))
