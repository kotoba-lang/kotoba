(ns kotoba.async.close
  "close -- addressed on its own.

  Split out of kotoba.lang.async on 2026-09-09 (ADR-2609091200). The unit
  here is the DEFINITION, and this repo's deps.edn names exactly the
  definitions it reaches -- nothing else.
"
  (:refer-clojure :exclude [close])
  )

(defn close
  "Mark `ch` closed. Further puts are refused; remaining buffered values may
  still be taken."
  [ch]
  (assoc ch :closed? true))
