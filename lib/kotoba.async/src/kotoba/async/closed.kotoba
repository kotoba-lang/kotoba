;; Port of kotoba.async.closed (closed.cljk), Kotoba-native.
;;
;; `closed?` is `(true? (:closed? ch))`: true only when the :closed? field is
;; exactly the boolean true. A missing field, nil, or any non-boolean is false.
;; The channel is a :document map.

(ns kotoba.async.closed
  (:export [closed?]))

(defn closed? [ch :document] :bool
  (option-or (document-bool-value
              (option-or (document-get ch (document-keyword :closed?)) (document-null)))
             false))
