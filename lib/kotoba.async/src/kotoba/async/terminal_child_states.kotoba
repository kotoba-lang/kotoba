;; Port of kotoba.async.terminal-child-states (terminal_child_states.cljk),
;; Kotoba-native, :document sets.
;;
;; Named divergences from terminal_child_states.cljk:
;;   - the set #{:ok :error :cancelled} is a :document set of keywords, and
;;     Kotoba has no top-level def export, so it is the zero-arg fn
;;     terminal-child-states.
;;   - terminal-child-state? is added as the membership test the set is used for;
;;     it uses document-set-contains?, since document-contains traps on sets (SIGTRAP in run).

(ns kotoba.async.terminal-child-states
  (:export [terminal-child-states terminal-child-state?]))

(defn terminal-child-states [] :document
  (document-set (document-keyword :ok) (document-keyword :error) (document-keyword :cancelled)))

(defn terminal-child-state? [s :keyword] :bool
  (document-set-contains? (terminal-child-states) (document-keyword s)))
