(ns kotoba.async.scope-cancel
  "scope-cancel -- addressed on its own.

  Split out of kotoba.lang.async on 2026-09-09 (ADR-2609091200). The unit
  here is the DEFINITION, and this repo's deps.edn names exactly the
  definitions it reaches -- nothing else.
"
  (:require [kotoba.async.cancel-running :refer [cancel-running]]
            [kotoba.async.terminal-scope-states :refer [terminal-scope-states]])
)

(defn scope-cancel [s reason]
  (if (contains? terminal-scope-states (:status s))
    s
    (assoc s :children (cancel-running (:children s))
             :status :cancelled :failure reason)))
