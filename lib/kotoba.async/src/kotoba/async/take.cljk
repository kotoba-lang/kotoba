(ns kotoba.async.take
  "take -- addressed on its own.

  Split out of kotoba.lang.async on 2026-09-09 (ADR-2609091200). The unit
  here is the DEFINITION, and this repo's deps.edn names exactly the
  definitions it reaches -- nothing else.
"
  (:refer-clojure :exclude [take])
  )

(defn take
  "Remove the front value from `ch`. Returns `[ch' val]`, or `[ch' nil]` when
  nothing is available (the caller would block). Taking from a closed, empty
  channel returns nil."
  [ch]
  (let [buf (:buffer ch)]
    (if (pos? (count buf))
      [(assoc ch :buffer (subvec buf 1)) (first buf)]
      [ch nil])))
