(ns kotoba.async.all-terminal
  "all-terminal? -- addressed on its own.

  Split out of kotoba.lang.async on 2026-09-09 (ADR-2609091200). The unit
  here is the DEFINITION, and this repo's deps.edn names exactly the
  definitions it reaches -- nothing else.
"
  (:require [kotoba.async.terminal-child-states :refer [terminal-child-states]])
)

(defn all-terminal? [children]
  (every? #(contains? terminal-child-states (:state %)) children))
