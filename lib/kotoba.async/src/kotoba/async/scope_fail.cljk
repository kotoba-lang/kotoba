(ns kotoba.async.scope-fail
  "scope-fail -- addressed on its own.

  Split out of kotoba.lang.async on 2026-09-09 (ADR-2609091200). The unit
  here is the DEFINITION, and this repo's deps.edn names exactly the
  definitions it reaches -- nothing else.
"
  (:require [kotoba.async.cancel-running :refer [cancel-running]]
            [kotoba.async.require-running-index :refer [require-running-index]])
)

(defn scope-fail
  "Fail one child and cancel every running sibling (fail-fast nursery rule)."
  [s id error]
  (let [i (require-running-index s id)
        failed (assoc-in s [:children i] {:id id :state :error :value error})]
    (assoc failed
           :children (cancel-running (:children failed))
           :status :failed
           :failure error)))
