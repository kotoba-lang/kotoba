(ns kotoba.async.scope-join-ready
  "scope-join-ready? -- addressed on its own.

  Split out of kotoba.lang.async on 2026-09-09 (ADR-2609091200). The unit
  here is the DEFINITION, and this repo's deps.edn names exactly the
  definitions it reaches -- nothing else.
"
  (:require [kotoba.async.terminal-scope-states :refer [terminal-scope-states]])
)

(defn scope-join-ready?
  "True only when the scope reached a terminal state. A host/durable loop may
  poll this without threads or wall-clock authority."
  [s]
  (contains? terminal-scope-states (:status s)))
