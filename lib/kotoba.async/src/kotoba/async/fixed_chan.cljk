(ns kotoba.async.fixed-chan
  "fixed-chan -- addressed on its own.

  Split out of kotoba.lang.async on 2026-09-09 (ADR-2609091200). The unit
  here is the DEFINITION, and this repo's deps.edn names exactly the
  definitions it reaches -- nothing else.
"
  (:require [kotoba.async.chan :refer [chan]])
)

(defn fixed-chan
  "A fixed-buffer channel of capacity `cap`; the guest's `fixed-chan`."
  [cap]
  (chan :fixed cap))
