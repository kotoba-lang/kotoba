{:paths ["src"]
 :version "0.1.0"
 ;; kotoba-lang/async — Layer 2 (cap/effect) of the kotoba foundational stdlib.
 ;; Bounded channels as pure state machines: put/take are pure transitions a
 ;; host/loop drives, with NO threads and NO wall-clock — the WASM-safe CSP
 ;; foundation the ADR promised.
 ;; See ADR-kotoba-lang-foundational-stdlib.md.
 :deps {
        ;; kotoba.lang.error replaced clojure.lang.ExceptionInfo here (2026-09-25).
        ;; An explicit floor: tools.deps takes the NEWEST sha it is shown.
        io.github.kotoba-lang/error {:local/root "../kotoba.error"}
        ;; kotoba.bytes replaced java.util.Base64 here (2026-09-24). An explicit
        ;; floor: tools.deps takes the NEWEST sha it is shown.
        io.github.kotoba-lang/bytes {:local/root "../kotoba.bytes"}
        ;; kotoba.process replaced clojure.java.shell here (2026-09-24). An explicit
        ;; floor: kotoba.process/sh parses clojure.java.shell's options from db49ea9,
        ;; and tools.deps takes the NEWEST sha it is shown.
        io.github.kotoba-lang/process {:local/root "../kotoba.process"}
        ;; kotoba.test (clojure.test-compatible surface), not clojure.test --
        ;; scripts/migrate-clojure-test-to-kotoba-test.cljk. Explicit floor.
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
}
 :aliases
 {:test {:extra-paths ["test"]
         ;; kotoba-lang/amu is a TEST-ONLY dependency, for the parity gate
         ;; that compiles src/kotoba/lang/async.kotoba and requires it to agree
         ;; with src/kotoba/lang/async.cljk (docs/adr/0001 as amended, and
         ;; ADR-2608130900 in com-junkawasaki/root). Consumers require only the
         ;; .cljc and must not be made to drag the compiler in behind it —
         ;; kotoba-lang/css sets the same boundary.
         :extra-deps {
                      io.github.kotoba-lang/amu
                      {:git/url "https://github.com/kotoba-lang/amu.git"
                       :git/sha "06fad55aa0c27add13f41603a573068b51db0ca2"}}}}}
