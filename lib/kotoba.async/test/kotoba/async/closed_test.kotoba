;; Acceptance test for kotoba.async.closed (port of closed.cljk).
;; main returns the number of failed cases (0 = all pass).
(ns kotoba.async.closed-test
  (:export [main])
  (:require [kotoba.async.closed :as cl]))

(defn- chk [ok :bool] :i64 (if ok 0 1))
(defn- kv [m :document k :keyword v :document] :document
  (document-assoc m (document-keyword k) v))

(defn main [] :i64
  (let [a (chk (cl/closed? (kv (document-map) :closed? (document-bool true))))
        b (chk (not (cl/closed? (kv (document-map) :closed? (document-bool false)))))
        c (chk (not (cl/closed? (document-map))))
        d (chk (not (cl/closed? (kv (document-map) :closed? (document-i64 1)))))
        e (chk (not (cl/closed? (kv (document-map) :closed? (document-null)))))
        f (chk (not (cl/closed? (kv (document-map) :closed? (document-string "true")))))]
    (+ a (+ b (+ c (+ d (+ e f)))))))
