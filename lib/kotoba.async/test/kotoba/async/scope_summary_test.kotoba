(ns kotoba.async.scope-summary-test (:export [main]) (:require [kotoba.async.scope-summary :as p]))

(defn- same [a :document b :document] :bool
  (string=? (document-edn-print a) (document-edn-print b)))

(defn main [] :i64
  (let [full (document-map :status (document-keyword :running) :children (document-vector) :failure (document-null) :extra (document-i64 1))
        part (document-map :status (document-keyword :done) :extra (document-i64 2))
        exp-full (document-map :status (document-keyword :running) :children (document-vector) :failure (document-null))
        exp-part (document-map :status (document-keyword :done))]
    (+ (if (same (p/scope-summary full) exp-full) 0 1)
       (if (same (p/scope-summary part) exp-part) 0 1)
       (if (same (p/scope-summary (document-map)) (document-map)) 0 1))))
