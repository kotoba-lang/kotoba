(ns kotoba.async.terminal-child-states-test
  (:export [main])
  (:require [kotoba.async.terminal-child-states :as t]))

(defn main [] :i64
  (+ (if (t/terminal-child-state? :ok) 0 1)
     (if (t/terminal-child-state? :error) 0 1)
     (if (t/terminal-child-state? :cancelled) 0 1)
     (if (t/terminal-child-state? :running) 1 0)
     (if (= (document-count (t/terminal-child-states)) 3) 0 1)))
