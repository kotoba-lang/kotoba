;; Port of kotoba.geo.billboard (billboard.cljk), Kotoba-native, :document maps.
;;
;; Named divergences from billboard.cljk:
;;   - billboard-def is multi-arity in the source; the default is the zero-arg
;;     billboard-def and the overridden form is billboard-def-with.
;;   - vectors of floats are :document vectors of :f64 values (carried, not computed).
;;   - billboard-def->instance is billboard-def->instance (same name) over a :document.

(ns kotoba.geo.billboard
  (:export [billboard-def billboard-def-with billboard-def->instance]))

(defn billboard-def [] :document
  (document-map :position (document-vector (document-f64 0.0) (document-f64 0.0) (document-f64 0.0))
                :size (document-vector (document-f64 16.0) (document-f64 16.0))
                :anchor (document-vector (document-f64 0.0) (document-f64 0.0))
                :color (document-vector (document-f64 1.0) (document-f64 1.0) (document-f64 1.0) (document-f64 1.0))
                :atlas-index (document-i64 0)))

(defn billboard-def-with [overrides :document] :document
  (document-merge (billboard-def) overrides))

(defn- fld [m :document k :keyword] :document
  (option-or (document-get m k) (document-null)))

(defn billboard-def->instance [b :document] :document
  (document-map :position (fld b :position)
                :atlas-index (fld b :atlas-index)
                :size (fld b :size)
                :anchor (fld b :anchor)
                :color (fld b :color)))
