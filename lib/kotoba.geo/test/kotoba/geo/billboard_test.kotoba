(ns kotoba.geo.billboard-test (:export [main]) (:require [kotoba.geo.billboard :as b]))

(defn- fld [d :document k :keyword] :document
  (option-or (document-get d k) (document-null)))

(defn- same [a :document b :document] :bool
  (string=? (document-edn-print a) (document-edn-print b)))

(defn main [] :i64
  (let [d0 (b/billboard-def)
        d1 (b/billboard-def-with (document-map :position (document-vector (document-f64 1.0) (document-f64 2.0) (document-f64 3.0))
                                              :atlas-index (document-i64 3)))
        i0 (b/billboard-def->instance d0)
        i1 (b/billboard-def->instance d1)
        exp-i0 (document-map :position (document-vector (document-f64 0.0) (document-f64 0.0) (document-f64 0.0))
                             :atlas-index (document-i64 0)
                             :size (document-vector (document-f64 16.0) (document-f64 16.0))
                             :anchor (document-vector (document-f64 0.0) (document-f64 0.0))
                             :color (document-vector (document-f64 1.0) (document-f64 1.0) (document-f64 1.0) (document-f64 1.0)))]
    (+ (if (same i0 exp-i0) 0 1)
       (if (same (fld d1 :position) (document-vector (document-f64 1.0) (document-f64 2.0) (document-f64 3.0))) 0 1)
       (if (same (fld d1 :atlas-index) (document-i64 3)) 0 1)
       (if (same (fld d1 :size) (document-vector (document-f64 16.0) (document-f64 16.0))) 0 1)
       (if (same (fld (b/billboard-def->instance d1) :color) (fld d0 :color)) 0 1)
       (if (same (fld (b/billboard-def->instance d1) :size) (fld d0 :size)) 0 1))))
