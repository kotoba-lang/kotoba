{:paths ["src"]
 :deps {}
 :aliases
 {:test {:extra-paths ["test"]
         :main-opts ["-e"
                     "(require 'kami.ongaku.sequencer-test 'kami.ongaku.sequencer.smf-test) (let [r (clojure.test/run-tests 'kami.ongaku.sequencer-test 'kami.ongaku.sequencer.smf-test)] (System/exit (if (zero? (+ (:fail r) (:error r))) 0 1)))"]}
  ;; Real-browser AudioWorklet SMF-round-trip-to-playback E2E
  ;; (scripts/build-e2e-bundles.sh + test/e2e/run_e2e.cljk). Only this alias
