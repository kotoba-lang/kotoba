;; Port of soukai.phase (phase.cljk), Kotoba-native, :document maps.
;;
;; Named divergences from phase.cljk:
;;   - The phase table and the constant sets are zero-argument functions
;;     (phases, assess-ops, record-ops, drafting-ops, default-phase). The
;;     source's private drafting-ops is a private zero-argument function here.
;;   - Phase keys are :document i64 values. A missing phase falls back to the
;;     default phase (3), as in the source.
;;   - Dispositions and reasons are :document keywords; a nil reason is
;;     document-null.
;;   - Clojure truthiness: only null and false are falsy. A non-boolean value
;;     is truthy here as well.

(ns soukai.phase
  (:export [record-ops assess-ops phases default-phase record-op? gate verdict->disposition]))

(defn record-ops [] :document
  (document-set (document-keyword :meeting/register) (document-keyword :record-date/snapshot)
                (document-keyword :agenda/register) (document-keyword :vote/record)))

(defn assess-ops [] :document
  (document-set (document-keyword :convocation/draft) (document-keyword :convocation/send)
                (document-keyword :resolution/finalize) (document-keyword :minutes/draft)
                (document-keyword :minutes/finalize)))

(defn- drafting-ops [] :document
  (document-set (document-keyword :convocation/draft) (document-keyword :resolution/finalize)
                (document-keyword :minutes/draft)))

(defn default-phase [] :i64 3)

(defn phases [] :document
  (document-map (document-i64 0) (document-map :label (document-string "ingest-only")
                                               :assess (document-set)
                                               :auto (document-set))
                (document-i64 1) (document-map :label (document-string "assisted")
                                               :assess (assess-ops)
                                               :auto (document-set))
                (document-i64 2) (document-map :label (document-string "assisted-draft")
                                               :assess (assess-ops)
                                               :auto (drafting-ops))
                (document-i64 3) (document-map :label (document-string "supervised")
                                               :assess (assess-ops)
                                               :auto (drafting-ops))))

(defn record-op? [op :document] :bool
  (document-set-contains? (record-ops) op))

(defn- field [m :document k :keyword] :document
  (option-or (document-get m k) (document-null)))

(defn- phase-spec [phase :i64] :document
  (option-or (document-get (phases) (document-i64 phase))
             (option-or (document-get (phases) (document-i64 (default-phase))) (document-map))))

(defn- truthy-field? [v :document k :keyword] :bool
  (let [x (field v k)]
    (cond (= (document-kind x) :null) false
          (= (document-kind x) :bool) (option-or (document-bool-value x) false)
          :else true)))

(defn- verdict-map [disposition :document reason :document] :document
  (document-map :disposition disposition :reason reason))

(defn gate [phase :i64 context :document disposition :document] :document
  (let [spec (phase-spec phase)
        assess (field spec :assess)
        auto (field spec :auto)
        op (field context :op)]
    (cond
      (document-equal? disposition (document-keyword :hold))
        (verdict-map (document-keyword :hold) (document-null))
      (not (document-set-contains? assess op))
        (verdict-map (document-keyword :hold) (document-keyword :phase-disabled))
      (and (document-equal? disposition (document-keyword :commit))
           (not (document-set-contains? auto op)))
        (verdict-map (document-keyword :escalate) (document-keyword :phase-approval))
      :else (verdict-map disposition (document-null)))))

(defn verdict->disposition [v :document] :document
  (cond (truthy-field? v :hard?) (document-keyword :hold)
        (truthy-field? v :escalate?) (document-keyword :escalate)
        :else (document-keyword :commit)))
