(ns soukai.phase-test
  (:export [main])
  (:require [soukai.phase :as p]))

(defn- expect [got :bool want :bool] :i64
  (if (= got want) 0 1))

(defn- field [m :document k :keyword] :document
  (option-or (document-get m k) (document-null)))

(defn- ctx [op :keyword] :document
  (document-map :op (document-keyword op)))

(defn- disp-is [r :document want :keyword] :i64
  (if (document-equal? (field r :disposition) (document-keyword want)) 0 1))

(defn- kw-is [d :document want :keyword] :i64
  (if (document-equal? d (document-keyword want)) 0 1))

(defn- reason-is [r :document want :keyword] :i64
  (if (document-equal? (field r :reason) (document-keyword want)) 0 1))

(defn- reason-null [r :document] :i64
  (if (= (document-kind (field r :reason)) :null) 0 1))

(defn main [] :i64
  (let [draft (ctx :convocation/draft)
        send (ctx :convocation/send)
        mdraft (ctx :minutes/draft)
        mfin (ctx :minutes/finalize)
        rec (ctx :meeting/register)
        g0 (p/gate 0 draft (document-keyword :commit))
        g1 (p/gate 1 mdraft (document-keyword :commit))
        g2 (p/gate 2 draft (document-keyword :commit))
        g2s (p/gate 2 send (document-keyword :commit))
        g3 (p/gate 3 (ctx :resolution/finalize) (document-keyword :commit))
        g3f (p/gate 3 mfin (document-keyword :commit))
        g7 (p/gate 7 (ctx :resolution/finalize) (document-keyword :commit))
        g0r (p/gate 0 rec (document-keyword :commit))
        gh (p/gate 3 send (document-keyword :hold))]
    (+ (disp-is g0 :hold) (reason-is g0 :phase-disabled)
       (disp-is g1 :escalate) (reason-is g1 :phase-approval)
       (disp-is g2 :commit) (reason-null g2)
       (disp-is g2s :escalate) (reason-is g2s :phase-approval)
       (disp-is g3 :commit) (reason-null g3)
       (disp-is g3f :escalate) (reason-is g3f :phase-approval)
       (disp-is g7 :commit) (reason-null g7)
       (disp-is g0r :hold) (reason-is g0r :phase-disabled)
       (disp-is gh :hold) (reason-null gh)
       (expect (p/record-op? (document-keyword :vote/record)) true)
       (expect (p/record-op? (document-keyword :minutes/draft)) false)
       (expect (= (p/default-phase) 3) true)
       (kw-is (p/verdict->disposition (document-map :hard? (document-bool true))) :hold)
       (kw-is (p/verdict->disposition (document-map :escalate? (document-bool true))) :escalate)
       (kw-is (p/verdict->disposition (document-map)) :commit)
       (expect (= (document-count (p/assess-ops)) 5) true))))
