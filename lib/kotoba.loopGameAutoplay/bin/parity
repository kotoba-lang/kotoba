#!/bin/sh
# The parity gate, both stages. Run from the repo root.
#
# Stage 1 (JVM): shugyo.policy/act-batch computes the expected actions.
# Stage 2 (nbb): the real driver, in a real browser, must reproduce them.
set -e
kbb -M:parity
exec kbb --backend sci --classpath "src:../shinka/src" test/policy_parity_test.cljk
