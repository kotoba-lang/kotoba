(ns denrei.query
  ;; Portable status lookups for a denrei channel-posting draft.
  ;;
  ;; The original (denrei.query/draft-status, denrei.query/posted?) read the
  ;; already-committed draft's :status from a Store over a message id and
  ;; reduced it to a greeting-like string (or "none") / a boolean. Those store
  ;; reads are host-side plumbing; the *product semantics* this module owns are
  ;; the two pure reductions below, expressed as ordinary Clojure-shaped
  ;; values: the caller hands in the draft's :status verbatim (as a string, or
  ;; the empty string when no draft has ever been committed) and gets back the
  ;; same observable "proposed"/"posted"/"none" and posted? that the Clojure
  ;; slice returned.
  ;;
  ;; reference shape: kotoba-lang/amu examples/todo-app.kotoba (maps, strings,
  ;; records, cond). No capability ids — nothing here crosses a host boundary.
  (:export [draft-status posted?]))

(defn draft-status [status :string] :string
  (if (string=? status "")
    "none"
    status))

(defn posted? [status :string] :bool
  (string=? status "posted"))