;; Port of denrei.model (model.cljk), Kotoba-native, :document maps.
;;
;; Named divergences from model.cljk:
;;   - the 3/4-arity and 1/2-arity defns are split: draft / draft-with and
;;     contact / contact-with (multi-arity defns are not expressible, E2138).
;;   - :confidence 0.0 is a :document f64; merge is right-biased as in the
;;     source (attrs override the defaults).
;;   - a nil attrs is read as the empty map.

(ns denrei.model
  (:export [draft draft-with contact contact-with]))

(defn- null-doc? [d :document] :bool
  (string=? (document-edn-print d) (document-edn-print (document-null))))

(defn- attrs-of [a :document] :document
  (if (null-doc? a) (document-map) a))

(defn draft-with [activity-id :document message-id :document content :document attrs :document] :document
  (document-merge (document-map :activity-id activity-id
                                :message-id message-id
                                :content content
                                :confidence (document-f64 0.0)
                                :cites (document-vector)
                                :redactions (document-vector)
                                :status (document-keyword :proposed))
                  (attrs-of attrs)))

(defn draft [activity-id :document message-id :document content :document] :document
  (draft-with activity-id message-id content (document-map)))

(defn contact-with [handle :document attrs :document] :document
  (document-merge (document-map :handle handle
                                :consent (document-keyword :known)
                                :first-contact? (document-bool false))
                  (attrs-of attrs)))

(defn contact [handle :document] :document
  (contact-with handle (document-map)))
