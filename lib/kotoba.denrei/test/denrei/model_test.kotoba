(ns denrei.model-test (:export [main]) (:require [denrei.model :as p]))

(defn- fedn [d :document k :keyword] :string
  (document-edn-print (option-or (document-get d k) (document-null))))

(defn- fcount [d :document k :keyword] :i64
  (document-count (option-or (document-get d k) (document-null))))

(defn- main-case [] :i64
  (let [d (p/draft (document-string "act") (document-string "msg") (document-map :body (document-string "hi")))
        d2 (p/draft-with (document-string "act") (document-string "msg") (document-map)
                         (document-map :status (document-keyword :posted)))
        c (p/contact (document-string "@ann"))
        c2 (p/contact-with (document-string "@bob") (document-map :consent (document-keyword :blocked)))]
    (+ (if (string=? (fedn d :activity-id) "\"act\"") 0 1)
       (if (string=? (fedn d :status) ":proposed") 0 1)
       (if (string=? (fedn d :confidence) "0.0") 0 1)
       (if (= (fcount d :cites) 0) 0 1)
       (if (= (fcount d :redactions) 0) 0 1)
       (if (string=? (fedn d2 :status) ":posted") 0 1)
       (if (string=? (fedn d2 :message-id) "\"msg\"") 0 1)
       (if (string=? (fedn c :consent) ":known") 0 1)
       (if (string=? (fedn c :first-contact?) "false") 0 1)
       (if (string=? (fedn c2 :consent) ":blocked") 0 1)
       (if (string=? (fedn c2 :handle) "\"@bob\"") 0 1))))

(defn main [] :i64
  (main-case))
