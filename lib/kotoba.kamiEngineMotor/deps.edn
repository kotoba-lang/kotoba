 ;; kami-emag magnetostatic FEA registers :emag-fea on the same contract later.
 :deps {
        io.github.kotoba-lang/test
        {:local/root "../kotoba.test"}io.github.kotoba-lang/datom
        {:local/root "../kotoba.datom"}
        io.github.kotoba-lang/kami-engine-cae-solver {:local/root "../kotoba.kamiEngineCaeSolver"}}
 :aliases
 {:test {:extra-paths ["test"]}}}
