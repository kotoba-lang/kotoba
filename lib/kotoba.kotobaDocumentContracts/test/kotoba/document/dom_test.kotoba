(ns kotoba.document.dom-test
  (:export [main])
  (:require [kotoba.document.dom :as d]))

(defn- expect [got :bool want :bool] :i64
  (if (= got want) 0 1))

(defn- el [id :i64 children :document] :document
  (document-map :node/id (document-i64 id)
                :tag (document-keyword :div)
                :attrs (document-map :class (document-string "box"))
                :children children))

(defn main [] :i64
  (let [ok-el (el 1 (document-vector (document-i64 2) (document-i64 3)))
        txt (document-map :node/id (document-i64 2) :text/content (document-string "hi"))
        zero-id (document-map :node/id (document-i64 0) :tag (document-keyword :div)
                              :attrs (document-map) :children (document-vector))
        bad-tag (document-map :node/id (document-i64 1) :tag (document-string "div")
                              :attrs (document-map) :children (document-vector))
        bad-attrs (document-map :node/id (document-i64 1) :tag (document-keyword :div)
                                :attrs (document-vector) :children (document-vector))
        bad-child (el 1 (document-vector (document-i64 0)))
        bad-children (document-map :node/id (document-i64 1) :tag (document-keyword :div)
                                   :attrs (document-map) :children (document-map))
        no-content (document-map :node/id (document-i64 2) :text/content (document-i64 5))]
    (+ (expect (d/element-node? ok-el) true)
       (expect (d/element-node? txt) false)
       (expect (d/text-node? txt) true)
       (expect (d/text-node? ok-el) false)
       (expect (d/node? ok-el) true)
       (expect (d/node? txt) true)
       (expect (d/node? (document-string "x")) false)
       (expect (d/element-node? zero-id) false)
       (expect (d/element-node? bad-tag) false)
       (expect (d/element-node? bad-attrs) false)
       (expect (d/element-node? bad-child) false)
       (expect (d/element-node? bad-children) false)
       (expect (d/text-node? no-content) false)
       (expect (d/node? (document-vector)) false))))
