;; Port of kotoba.document.dom (dom.cljk), Kotoba-native, :document maps.
;;
;; Named divergences from dom.cljk:
;;   - pos-int? is (integer kind and value > 0); any other kind is not a
;;     positive integer, as nil is not in the source.
;;   - map? is the :map document kind; keyword? is the :keyword kind;
;;     vector? is the :vector kind; string? is the :string kind.

(ns kotoba.document.dom
  (:export [element-node? text-node? node?]))

(defn- field [m :document k :keyword] :document
  (option-or (document-get m k) (document-null)))

(defn- pos-int-doc? [x :document] :bool
  (and (= (document-kind x) :i64)
       (> (option-or (document-i64-value x) 0) 0)))

(defn- all-pos-ints? [xs :document] :bool
  (loop [i 0]
    (cond (>= i (document-count xs)) true
          (pos-int-doc? (option-or (document-vector-at xs i) (document-null))) (recur (+ i 1))
          :else false)))

(defn element-node? [x :document] :bool
  (and (= (document-kind x) :map)
       (pos-int-doc? (field x :node/id))
       (= (document-kind (field x :tag)) :keyword)
       (= (document-kind (field x :attrs)) :map)
       (= (document-kind (field x :children)) :vector)
       (all-pos-ints? (field x :children))))

(defn text-node? [x :document] :bool
  (and (= (document-kind x) :map)
       (pos-int-doc? (field x :node/id))
       (= (document-kind (field x :text/content)) :string)))

(defn node? [x :document] :bool
  (or (element-node? x) (text-node? x)))
