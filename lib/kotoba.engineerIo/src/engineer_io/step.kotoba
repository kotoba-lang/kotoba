(ns engineer-io.step
  ;; Parity guest for src/engineer_io/step.cljk (STEP AP214 header/footer
  ;; generator, AP214 subset). Same two exports, same strings, byte for byte:
  ;; the .cljc stays the oracle until a human retires it. Portable pure --
  ;; string concatenation only, no capabilities, no host boundary.
  (:export [generate-header generate-footer]))

(defn generate-header [filename :string author :string] :string
  (string-concat
   "ISO-10303-21;\nHEADER;\n"
   (string-concat
    "FILE_DESCRIPTION(('KAMI Engineering SDK export'), '2;1');\n"
    (string-concat
     "FILE_NAME('"
     (string-concat filename
      (string-concat
       "', '2026-04-09', ('"
       (string-concat author
        (string-concat
         "'), "
         (string-concat
          "('etzhayyim'), 'KAMI-ENG-SDK', 'kami-cad', '');\n"
          (string-concat
           "FILE_SCHEMA(('AUTOMOTIVE_DESIGN'));\n"
           "ENDSEC;\nDATA;\n"))))))))))

(defn generate-footer [] :string
  "ENDSEC;\nEND-ISO-10303-21;\n")
