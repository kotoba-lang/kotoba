(ns content-address.app-schema-test
  "Fixtures are shapes the fleet actually has: the published appview map
  (with `:published` location bookkeeping), the actor placement map, the
  tx-data vector, and the ADR-2610082200 `:app` shape this schema adds."
  (:require [cljs.test :refer [deftest is testing]]
            [content-address.app-schema :as schema]
            [content-address.core :as ca]))

(def cid "bafkreigpvrijgdm36vjt6xvqsi7ahvzslv6yymdqzbozi2id3wgorvgnp4")

(def appview-manifest
  {:kotoba.app/id "cloud.itonami.isic-3091"
   :kotoba.app/kind "appview"
   :kotoba.app/bundle-cid cid
   :kotoba.app/embed-url (str "ipfs://" cid)
   :published {:archive "https://kotobase.net/ipfs/x" :size 1 :put-status 201 :get-status 200}})

(def placement-manifest
  {:kotoba.app/name "hoshimori"
   :kotoba.app/version "0.1.0"
   :kotoba.app/components [{:name "hoshimori" :src "methods/mesh.clj" :scale 1}]
   :kotoba.app/placement {:spread :zone :require {:tier "edge"}}})

(def tx-data-manifest
  [{:db/id -1 :kotoba.app/name "moushibumi" :kotoba.app/version "0.1.0"}])

(def app-shape-manifest
  {:kotoba.app/name "aozora-catalog"
   :kotoba.app/kind :app
   :kotoba.app/did "did:key:z6Mk"
   :kotoba.app/roles [{:role :catalog :mon cid :logic [cid] :clone-limit 0}]
   :kotoba.app/ui {:bundle cid :entry "index.html"}
   :kotoba.app/provides [{:iface cid :caps #{:app/call}}]
   :kotoba.app/requires [{:app "did:key:z6Mx" :iface cid :caps #{:ito/append}}]
   :kotoba.app/bundle-cid cid})

(deftest every-existing-shape-is-readable
  (is (schema/readable? appview-manifest))
  (is (schema/readable? placement-manifest))
  (is (schema/readable? tx-data-manifest))
  (is (schema/readable? app-shape-manifest))
  ;; a map is one entity even when it carries almost nothing — that is a
  ;; finding, not an unreadable verdict.
  (is (schema/readable? {:kotoba.app/id "x"}))
  (is (not (schema/readable? [])))
  (is (not (schema/readable? 42))))

(deftest the-app-kind-conforms-without-findings
  (is (= [] (schema/schema-problems app-shape-manifest)))
  (is (= [] (schema/file-schema-problems app-shape-manifest))))

(deftest legacy-kind-is-readable-but-reported
  (is (= [{:problem :legacy-kind :value "appview"
           :detail "readable; canonical kind is a keyword"}]
         (schema/schema-problems appview-manifest))))

(deftest missing-kind-has-no-default
  (is (= [{:problem :no-kind :detail "kind has no default (ADR-2609092600)"}]
         (schema/schema-problems placement-manifest))))

(deftest unknown-keys-are-findings-not-refusals
  (let [problems (schema/schema-problems (assoc placement-manifest :kotoba.app/quantum 1))]
    (is (= [{:problem :no-kind :detail "kind has no default (ADR-2609092600)"}
            {:problem :unknown-key :key :kotoba.app/quantum}]
           problems))))

(deftest an-entity-without-identity-is-reported
  (is (some #(= :no-identity (:problem %))
            (schema/schema-problems {:kotoba.app/kind :service}))))

(deftest findings-name-the-entity-across-both-shapes
  (is (= ["moushibumi"]
         (map :kotoba.app/id (schema/file-schema-problems tx-data-manifest))))
  (is (= [nil]
         (map :kotoba.app/id (schema/file-schema-problems {:kotoba.app/kind :service})))))
