{:paths ["src"]
 ;; No dependencies on purpose. Addressing is arithmetic over bytes; the
 ;; libraries that own the layers around it (kotoba-protocol, chain,
 ;; tech-ipfs-specs-ipns, tech-ipfs-specs-http-gateway) depend on this
 ;; direction being one-way — an application composes them, and none of
 ;; them has to know that an archive exists.
 :deps {
        io.github.kotoba-lang/bytes {:local/root "../kotoba.bytes"}
        io.github.kotoba-lang/io {:local/root "../kotoba.io"}
        io.github.kotoba-lang/edn {:local/root "../kotoba.edn"}
        io.github.kotoba-lang/pprint {:local/root "../kotoba.pprint"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}}
 ;; There is deliberately NO :test alias here. The tests are ClojureScript
 ;; (`test/run_tests.cljk`, run under nbb — the runtime the appview build
 ;; steps actually use). A `kbb -M:test` that found zero tests and
 ;; exited 0 would be the failure this workspace keeps finding: a check
 ;; that could not run returning the same value as a check that passed.
 ;;
 ;;   kbb --backend sci --classpath src:test test/run_tests.cljk
 ;;
 ;; The compiler is dev-only and must not reach a consumer: `:kir` compiles
 ;; kotoba/address_core.kotoba into the artifact this library ships. What a
 ;; consumer gets is the artifact plus kotoba.kir, the interpreter.
 :aliases
 {:kir {:extra-paths ["tools"]
        :extra-deps {io.github.kotoba-lang/amu
                     {:git/url "https://github.com/kotoba-lang/amu.git"
                      :git/sha "b88cb6c0f276ab8f98bd2b62adeef0ae5ec7ffcd"}}
        :main-opts ["-m" "emit-kir"]}}}
