(ns content-address.app-schema
  "The one schema for `kotoba.app.edn` — root ADR-2610082200 (P1).

  Two systems wrote `kotoba.app.edn` before this: the placement system
  (`:kotoba.app/name` + `:kotoba.app/components` + `:kotoba.app/placement`)
  and the kind/addressing system (`:kotoba.app/id` + `:kotoba.app/kind` +
  `:kotoba.app/bundle-cid`). The ADR folds both into one schema and adds the
  `:app` kind (roles/ui/provides/requires/did). This namespace is the shape
  gate for that union: it *reads* every manifest that exists today and
  *reports* what is legacy or missing rather than refusing it — a reader that
  understands one system and calls the other unreadable is the failure mode
  `content-address.core` was built to stop.

  Reports, never throws. Parse failures and empty entity sets are the only
  unreadable verdicts; everything else is a finding."
  (:require [kotoba.lang.text :as str]
            [content-address.core :as ca]))

(def canonical-kinds
  "ADR §7: kind is 4 values, no default (ADR-2609092600 stays)."
  #{:document :service :placement :app})

(def legacy-kind-values
  "What the 595 published appviews actually carry. Readable, reported."
  #{"appview"})

(def identity-keys
  "An entity says who it is with one of these."
  [:kotoba.app/id :kotoba.app/name])

(def schema-keys
  "Every top-level key the union schema understands.

  placement system   :kotoba.app/name :kotoba.app/version :kotoba.app/components
                     :kotoba.app/placement
  kind/addressing    :kotoba.app/id :kotoba.app/kind :kotoba.app/bundle-cid
                     :kotoba.app/embed-url :kotoba.app/latest :kotoba.graph/cid
  document system    :kotoba.app/document :kotoba.app/build :kotoba.app/entry
                     :kotoba.app/artifacts :kotoba.app/upstream
  app system (ADR 7) :kotoba.app/did :kotoba.app/roles :kotoba.app/ui
                     :kotoba.app/provides :kotoba.app/requires
  tolerated          :kotoba.app/note :published :db/id :kind"
  #{:kotoba.app/id :kotoba.app/name :kotoba.app/kind :kotoba.app/version
    :kotoba.app/components :kotoba.app/placement :kotoba.app/bundle-cid
    :kotoba.app/embed-url :kotoba.app/latest :kotoba.graph/cid
    :kotoba.app/document :kotoba.app/build :kotoba.app/entry
    :kotoba.app/artifacts :kotoba.app/upstream :kotoba.app/note
    :kotoba.app/did :kotoba.app/roles :kotoba.app/ui :kotoba.app/provides
    :kotoba.app/requires
    ;; tolerated, not schema: location bookkeeping, tx-data identity, and the
    ;; legacy un-namespaced :kind the placement scaffolds carry.
    :published :db/id :kind})

(defn- identity-present? [entity]
  (some #(let [v (get entity %)] (and (string? v) (seq v))) identity-keys))

(defn- kind-problems [entity]
  (let [kind (:kotoba.app/kind entity)]
    (cond
      (nil? kind)
      [{:problem :no-kind :detail "kind has no default (ADR-2609092600)"}]

      (contains? canonical-kinds kind) []

      (contains? legacy-kind-values kind)
      [{:problem :legacy-kind :value kind
        :detail "readable; canonical kind is a keyword"}]

      :else
      [{:problem :unknown-kind :value kind}])))

(defn schema-problems
  "Everything the union schema has to say about one entity. Empty = conforms.

  A finding is not a refusal: :no-kind and :legacy-kind report the state of
  the fleet, they do not make a manifest unreadable."
  [entity]
  (cond-> []
    (not (identity-present? entity))
    (conj {:problem :no-identity :detail "neither :kotoba.app/id nor :kotoba.app/name carries a string"})

    true (into (kind-problems entity))

    true (into (for [k (sort-by str (remove schema-keys (keys entity)))]
                 {:problem :unknown-key :key k}))))

(defn file-schema-problems
  "Schema findings for every entity in a parsed manifest, either shape."
  [parsed]
  (into [] (mapcat (fn [e] (map #(assoc % :kotoba.app/id (or (:kotoba.app/id e)
                                                             (:kotoba.app/name e)))
                                (schema-problems e))))
        (ca/entities parsed)))

(defn readable?
  "A parsed manifest is readable when at least one application entity is in
  it. This is the P1 acceptance predicate: every `kotoba.app.edn` in the
  fleet must answer here."
  [parsed]
  (boolean (seq (ca/entities parsed))))
