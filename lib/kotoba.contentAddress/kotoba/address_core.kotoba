(ns address-core
  (:export [raw-cid-shape? dag-cbor-shape? cid-shape? same-object?
            over-cap? refusal-code embed-url ipfs-scheme
            cid-length raw-prefix dag-cbor-prefix digest-start max-object-bytes]))

;; The decisions this library makes, as a decision core (ADR-2608157000).
;;
;; Every question below is answered from a CID *string* and two integers, so
;; it needs no collections and no capability. The octet arithmetic — base32,
;; sha2-256, the multihash header — stays in `content-address.core`, which is
;; where collections belong. This is the split the workspace calls a decision
;; core: the judgement moves, the assembly does not.
;;
;; Why the string form is exact rather than a shortcut. A CIDv1 with
;; sha2-256 is multibase `b` + base32(0x01 codec 0x12 0x20 || digest). The
;; four header bytes are 32 bits; the first six base32 characters carry 30 of
;; them, so every such CID begins with a seven-character constant that names
;; its codec — `bafkrei` for raw (0x55), `bafyrei` for dag-cbor (0x71). The
;; two header bits that spill into character eight are the low bits of 0x20,
;; the digest length, which is the same for both codecs. That is why two CIDs
;; over the same bytes are identical from character eight onward, and why
;; `same-object?` can compare suffixes instead of decoding.
;;
;; Parity: test/content_address/oracle_test.cljk runs this artifact and
;; `content-address.core` over the same inputs and requires the same answers.

(defn cid-length [] :i64 59)
(defn digest-start [] :i64 7)
(defn raw-prefix [] :string "bafkrei")
(defn dag-cbor-prefix [] :string "bafyrei")
(defn ipfs-scheme [] :string "ipfs://")
(defn max-object-bytes [] :i64 4194304)

(defn has-prefix? [s :string p :string] :bool
  (if (= (string-byte-length s) (cid-length))
    (string=? (string-substring s 0 (digest-start)) p)
    false))

(defn raw-cid-shape? [s :string] :bool
  (has-prefix? s (raw-prefix)))

(defn dag-cbor-shape? [s :string] :bool
  (has-prefix? s (dag-cbor-prefix)))

(defn cid-shape? [s :string] :bool
  (if (raw-cid-shape? s) true (dag-cbor-shape? s)))

;; One object under two codecs is one identity, not two (ADR-2608148200).
(defn same-object? [a :string b :string] :bool
  (if (cid-shape? a)
    (if (cid-shape? b)
      (string=? (string-substring a (digest-start) (cid-length))
                (string-substring b (digest-start) (cid-length)))
      false)
    false))

(defn over-cap? [size :i64] :bool
  (> size (max-object-bytes)))

;; The archive's refusals, in the order `content-address.archive/refusals`
;; reports them. 0 means it will take the object.
;;   1 not-raw-sha256   2 over-archive-cap   3 no-size   4 no-token
(defn refusal-code [cid :string size :i64 has-size? :bool has-token? :bool] :i64
  (if (not (raw-cid-shape? cid))
    1
    (if (and has-size? (over-cap? size))
      2
      (if (not has-size?)
        3
        (if (not has-token?)
          4
          0)))))

(defn embed-url [cid :string] :string
  (if (cid-shape? cid)
    (string-concat (ipfs-scheme) cid)
    ""))
