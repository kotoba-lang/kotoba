{
  "name": "@etzhayyim/vite-plugin-safe-builder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Unified build safety plugin for all SvelteKit apps. Integrates svelte5-compat, mcp-guard, route-canonical, ssg-validate.",
  "repository": "https://github.com/etzhayyim/com-etzhayyim-vite-plugin-safe-builder",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./ssg-validate": {
      "import": "./dist/ssg-validate.js",
      "types": "./dist/ssg-validate.d.ts"
    }
  },
  "bin": {
    "ssg-validate": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "type-check": "tsc --noEmit"
  },
  "peerDependencies": {
    "vite": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.19.17",
    "typescript": "^5.9.3",
    "vite": "^6.4.2"
  }
}
