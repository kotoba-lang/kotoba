{:paths ["src"]
 ;; real git pins for standalone (non-monorepo) consumption; :dev overrides to
 ;; sibling :local/root when checked out inside the com-junkawasaki west
 ;; superproject (same convention as kotoba-lang/inference's own deps.edn).
 :deps {
        io.github.kotoba-lang/error {:local/root "../kotoba.error"}
        io.github.kotoba-lang/http-parse-url {:local/root "../kotoba.http"}
        io.github.kotoba-lang/io {:local/root "../kotoba.io"}
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/edn {:local/root "../kotoba.edn"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}
        io.github.kotoba-lang/json {:local/root "../kotoba.json"}
        io.github.kotoba-lang/inference {:local/root "../kotoba.inference"}
        io.github.kotoba-lang/http {:local/root "../kotoba.http"}}

 :aliases
 {;; local monorepo dev (checked out at orgs/kotoba-lang/murakumo-studio,
  ;; sibling to orgs/kotoba-lang/inference): `kbb -M:dev:engine`.
  :dev {:override-deps {io.github.kotoba-lang/inference {:local/root "../inference"}}}



  :test {:extra-paths ["test"]}}}
