;; murakumo-studio as data, for `kotoba-lang/shell`.
;;
;; This replaces an 89-line Tauri crate (tauri/src-tauri, removed 2026-08-11).
;; That crate registered no Tauri commands and its own header said "No business
;; logic lives in Rust" — it existed to open a window and to start and stop the
;; engine sidecar. Both are contracts `shell` already owns, so the app says what
;; it needs and the host decides how.
;;
;;   bin/kotoba-shell app check --target macos --manifest app.kotoba.edn --json
;;   bin/kotoba-shell app run   --target macos --manifest app.kotoba.edn --execute
;;
;; `murakumo-studio.tauri` (the IPC helper) went with it: nothing required it,
;; because the UI's whole data path is HTTP to 127.0.0.1 — see
;; src/murakumo_studio/client.cljk.

{:app/id "net.kotoba-lang.murakumo-studio"
 :app/name "murakumo-studio"
 :app/version "0.1.0"
 :macos/bundle-id "net.kotoba-lang.murakumo-studio"

 ;; The window, carried over verbatim from tauri.conf.json.
 :window/title "murakumo-studio"
 :window/url "index.html"
 :window/root "desktop/dist"
 :window/width 1080
 :window/height 760
 :window/min-width 720
 :window/min-height 480

 ;; The engine: a JVM process the UI talks to over HTTP. The window is useless
 ;; without it, so it lives and dies with the app.
 ;;
 ;; `:sidecar/find-root-marker` rather than a fixed depth because the Tauri CLI
 ;; moved the working directory between versions and the crate had already been
 ;; taught to walk upward for deps.edn. Unlike the crate, a failed search is an
 ;; error here, not a fallback to $HOME — starting the engine in the wrong
 ;; directory and reporting success is worse than not starting it.
 :sidecar/command ["kbb" "-M:engine"]
 :sidecar/find-root-marker "deps.edn"

 ;; The two things a host may vary, named by the app rather than discovered by
 ;; reading the launcher. `:dev:engine` picks up the sibling :local/root
 ;; override when checked out inside the west superproject; a standalone clone
 ;; uses the published pin via plain `:engine`.
 :sidecar/env-overrides {"MURAKUMO_STUDIO_REPO" :sidecar/dir
                         "MURAKUMO_STUDIO_ENGINE_ALIAS" :sidecar/alias}}
