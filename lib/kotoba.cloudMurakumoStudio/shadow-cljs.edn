;; shadow-cljs ビルド設定。frontend は src/murakumo_studio/{desktop,ui,state}.cljs(c)。
;; 出力は shell の WebKit window host が読む desktop/dist/js/
;; (desktop/dist/index.html が読み込む)。Tauri crate は 2026-08-11 に撤去。
{:deps {:aliases [:cljs]}
 :nrepl {:port 9631}

 :builds
 {:app
  {:target :browser
   :output-dir "desktop/dist/js"
   :asset-path "js"
   :modules {:main {:init-fn murakumo-studio.desktop/init!}}
   :devtools {:watch-dir "desktop/dist"}}}}
