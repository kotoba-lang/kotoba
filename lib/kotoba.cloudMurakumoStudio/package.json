{
  "name": "murakumo-studio",
  "private": true,
  "version": "0.1.0",
  "description": "Local inference desktop app (kotoba-lang/inference based, LM Studio-like)",
  "scripts": {
    "gui:watch": "amu compile --target wasm32-browser app",
    "gui:release": "amu compile --target wasm32-browser app",
    "gui:compile": "amu compile --target wasm32-browser app",
    "task": "kbb --backend sci scripts/run-task.cljk",
    "tasks": "kbb --backend sci scripts/run-task.cljk",
    "test": "kbb --backend sci scripts/run-task.cljk test"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "shadow-cljs": "^2.28.20"
  }
}
