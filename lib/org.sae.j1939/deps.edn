;; No dependencies. J1939 is a 29-bit identifier, a PGN derivation and a
;; multi-frame transport protocol reassembly rule; a leaf that dragged a
;; SocketCAN or vendor CAN-driver binding behind it would defeat the point.
{:deps {
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}}
 :paths ["src"]
 :aliases
 {:test {:extra-paths ["test"]}
  :cljs {:extra-paths ["test"]}}}
