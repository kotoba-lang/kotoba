{:paths ["src"]

 ;; No dependencies, on purpose. This library is the gate 376 actors route
 ;; every write, disclosure, filing and payment through — anything it depends
 ;; on becomes part of that gate's trusted base. It reads nothing, writes
 ;; nothing, calls nothing, and takes values already read by its caller rather
 ;; than a store, so it never has to know any of the 376 Store protocols.
 :deps {
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}}

 :aliases
 {:lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test" "--fail-level" "error"]}

  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]}}}
