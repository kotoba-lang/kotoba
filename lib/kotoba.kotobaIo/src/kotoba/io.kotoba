(ns kotoba.io
  "Pure path-character helpers core in Kotoba. All filesystem effects are host
  capabilities (Node fs / browser OPFS / kotobase blocks); this module holds
  only pure logic over i64 char codes. Richer path utilities land once the
  stdlib string family admits them (compat.edn documents that gap)."
  (:export [is-sep is-dot main]))

(defn is-sep [c] :i64 (if (= c 47) 1 0))

(defn is-dot [c] :i64 (if (= c 46) 1 0))

(defn main [] :i64 (+ (if (= 1 (is-sep 47)) 0 1) (if (= 1 (is-dot 46)) 0 1) (if (= 0 (is-sep 65)) 0 1)))
