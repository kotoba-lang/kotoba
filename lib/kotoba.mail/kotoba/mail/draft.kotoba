;; mail.draft — Pure Kotoba guest (oracle: src/mail/draft.cljk).
;;
;; A draft that must be approved before a send effect exists. The oracle
;; throws on send-before-approve; throw is not in the language
;; (ADR-2608650000), so send-effect returns an effect with
;; :mail.effect/status :blocked and the reason. The caller branches.
;;
;; Compile (single file, JVM-free):
;;   kotoba compile kotoba/mail/draft.kotoba --target wasm32-browser --output draft.wasm

(ns mail.draft
  (:export [draft approve approved? send-effect draft-fact]))

(defn- dg [d k :keyword] :document
  (option-value-of [:option :document] (document-get d k) (document-null)))

(defn- dk [d k :keyword] :keyword
  (option-value-of [:option :keyword]
                   (document-keyword-value (dg d k)) :none))

(defn draft [id :string mail-message :document] :document
  (document-map
   :mail.draft/type (document-keyword :mail/draft)
   :mail.draft/id (document-string id)
   :mail.draft/status (document-keyword :draft)
   :mail.draft/message mail-message
   :mail.draft/approvals (document-vector)))

(defn approve [d :document approval :document] :document
  (document-assoc
   (document-assoc d :mail.draft/approvals
                   (document-vector-conj (dg d :mail.draft/approvals) approval))
   :mail.draft/status (document-keyword :approved)))

(defn approved? [d :document] :bool
  (= (dk d :mail.draft/status) :approved))

(defn send-effect [d :document] :document
  (if (approved? d)
    (document-map
     :itonami.effect/type (document-keyword :external-send)
     :mail.effect/type (document-keyword :mail/send)
     :mail.effect/draft-id (dg d :mail.draft/id)
     :mail.effect/message (dg d :mail.draft/message)
     :mail.effect/status (document-keyword :proposed))
    (document-map
     :itonami.effect/type (document-keyword :external-send)
     :mail.effect/type (document-keyword :mail/send)
     :mail.effect/draft-id (dg d :mail.draft/id)
     :mail.effect/message (dg d :mail.draft/message)
     :mail.effect/status (document-keyword :blocked)
     :mail.effect/error (document-string "mail draft must be approved before send-effect"))))

(defn draft-fact [d :document] :document
  (document-map
   :kotoba/type (document-keyword :mail/draft)
   :mail/draft d))
