;; mail.mailbox — Pure Kotoba guest (oracle: src/mail/mailbox.cljk).
;;
;; Portable mailbox/thread/label state. This slice covers the structural
;; core: deliver (idempotent), set-read, add-label, remove-label, trash,
;; sealed?, and the used-bytes ledger. The oracle's search/sort and its
;; set/valscan operations stay in the host — mechanism over a value plane
;; the guest cannot hold (a mailbox is unbounded; :container-items 32
;; binds first, measured on pop3's 2000-line control).
;;
;; Boxes are :document. Deliver is idempotent by construction: the entry
;; is written only when :mailbox.message/id is absent (same rule as the
;; oracle's get-in guard).
;;
;; Compile (single file, JVM-free):
;;   kotoba compile kotoba/mail/mailbox.kotoba --target wasm32-browser --output mailbox.wasm

(ns mail.mailbox
  (:export [mailbox message-entry sealed? deliver set-read add-label
            remove-label trash]))

(defn- dg [d k :keyword] :document
  (option-value-of [:option :document] (document-get d k) (document-null)))

(defn- ds [d k :keyword] :string
  (option-value-of [:option :string] (document-string-value (dg d k)) ""))

(defn- di [d k :keyword] :i64
  (option-value-of [:option :i64] (document-i64-value (dg d k)) (- 0 1)))

(defn mailbox [id :string address :string] :document
  (document-map
   :mailbox/id (document-string id)
   :mailbox/address (document-string address)
   :mailbox/messages (document-map)
   :mailbox/threads (document-map)
   :mailbox/used-bytes (document-i64 0)))

(defn message-entry [id :string thread-id :string message :document size-bytes :i64] :document
  (document-map
   :mailbox.message/id (document-string id)
   :mailbox.message/thread-id (document-string thread-id)
   :mailbox.message/message message
   :mailbox.message/labels (document-vector (document-keyword :inbox))
   :mailbox.message/read (document-keyword :unread)
   :mailbox.message/size-bytes (document-i64 size-bytes)))

(defn sealed? [entry :document] :bool
  (if (string=? (ds entry :mailbox.message/sealed) "") false true))


(defn deliver [box :document entry :document] :document
  (let [id (ds entry :mailbox.message/id)
        thread-id (ds entry :mailbox.message/thread-id)
        existing (dg (dg box :mailbox/messages) :mailbox.message/id)]
    (if (if (string=? (ds existing :mailbox.message/id) "") false true)
      box
      (let [messages (document-assoc (dg box :mailbox/messages)
                                     :mailbox.message/id entry)
            old-thread (dg (dg box :mailbox/threads) :mailbox.thread/id)
            ids (if (if (string=? (ds old-thread :mailbox.thread/id) "") false true)
                  (document-vector-conj (dg old-thread :mailbox.thread/message-ids)
                                        (document-string id))
                  (document-vector (document-string id)))
            new-thread (document-map
                        :mailbox.thread/id (document-string thread-id)
                        :mailbox.thread/message-ids ids)
            threads (document-assoc (dg box :mailbox/threads)
                                    :mailbox.thread/id new-thread)
            used (+ (di box :mailbox/used-bytes)
                    (di entry :mailbox.message/size-bytes))]
        (document-map
         :mailbox/id (dg box :mailbox/id)
         :mailbox/address (dg box :mailbox/address)
         :mailbox/messages messages
         :mailbox/threads threads
         :mailbox/used-bytes (document-i64 used))))))

(defn set-read [box :document message-id :string read :keyword] :document
  (let [messages (dg box :mailbox/messages)
        entry (dg messages :mailbox.message/id)
        entry2 (document-assoc entry :mailbox.message/read (document-keyword read))]
    (document-assoc box :mailbox/messages (document-assoc messages :mailbox.message/id entry2))))

(defn add-label [box :document message-id :string label :keyword] :document
  (let [messages (dg box :mailbox/messages)
        entry (dg messages :mailbox.message/id)
        entry2 (document-assoc entry :mailbox.message/labels
                               (document-vector-conj (dg entry :mailbox.message/labels)
                                                     (document-keyword label)))]
    (document-assoc box :mailbox/messages (document-assoc messages :mailbox.message/id entry2))))

;; GAP, stated: the :document builtin set has no "remove element from
;; vector", so remove-label cannot yet reproduce the oracle's disj. The
;; oracle remains authoritative for removal; this function reports the
;; gap instead of silently keeping the label. Removal: when a
;; document-vector-remove builtin is admitted.
(defn- labels-without [labels :document label :keyword i :i64 acc :document] :document
  (if (>= i (document-count labels)) acc
      (labels-without labels label (+ i 1)
                      (if (= (option-value-of [:option :keyword]
                                              (document-keyword-value (option-value-of [:option :document] (document-vector-at labels i) (document-null))) :none)
                             label)
                        acc
                        (document-vector-conj acc (option-value-of [:option :document] (document-vector-at labels i) (document-null)))))))

(defn remove-label [box :document message-id :string label :keyword] :document
  (let [messages (dg box :mailbox/messages)
        entry (dg messages :mailbox.message/id)
        kept (labels-without (dg entry :mailbox.message/labels) label 0 (document-vector))]
    (document-assoc box :mailbox/messages
                    (document-assoc messages :mailbox.message/id
                                    (document-assoc entry :mailbox.message/labels kept)))))

(defn trash [box :document message-id :string] :document
  (add-label (remove-label box message-id :inbox) message-id :trash))
