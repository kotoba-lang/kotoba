;; mail.receipt — Pure Kotoba guest (oracle: src/mail/receipt.cljk).
;;
;; An outbound acknowledgement. The oracle throws when a provider result
;; carries no message-id; throw is not in the language (ADR-2608650000),
;; so a missing id returns a receipt with status :error and the reason.
;; The caller can branch on status — the refusal is a value, not a crash.
;;
;; Compile (single file, JVM-free):
;;   kotoba compile kotoba/mail/receipt.kotoba --target wasm32-browser --output receipt.wasm

(ns mail.receipt
  (:export [receipt receipt-fact]))

(defn- dg [d k :keyword] :document
  (option-value-of [:option :document] (document-get d k) (document-null)))

(defn- ds [d k :keyword] :string
  (option-value-of [:option :string] (document-string-value (dg d k)) ""))

(defn receipt [effect :document provider :keyword result :document] :document
  (let [message-id (ds result :message-id)]
    (if (string=? message-id "")
      (document-map
       :mail.receipt/type (document-keyword :mail/receipt)
       :mail.receipt/provider (document-keyword provider)
       :mail.receipt/provider-message-id (document-string "")
       :mail.receipt/draft-id (document-string (ds effect :mail.effect/draft-id))
       :mail.receipt/status (document-keyword :error)
       :mail.receipt/error (document-string "mail receipt requires provider message-id"))
      (document-map
       :mail.receipt/type (document-keyword :mail/receipt)
       :mail.receipt/provider (document-keyword provider)
       :mail.receipt/provider-message-id (document-string message-id)
       :mail.receipt/draft-id (document-string (ds effect :mail.effect/draft-id))
       :mail.receipt/status (document-keyword :accepted)))))

(defn receipt-fact [r] :document
  (document-map
   :kotoba/type (document-keyword :mail/receipt)
   :mail/receipt r))
