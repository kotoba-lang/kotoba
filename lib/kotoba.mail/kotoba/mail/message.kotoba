;; mail.message — Pure Kotoba guest (oracle: src/mail/message.cljk).
;;
;; Product semantics live here: what an address is, whether it is valid,
;; what a message is, who its recipients are, and which rules a message
;; violates. The regex email-pattern and throw stay in the host —
;; mechanism. Validation errors are RETURNED, never thrown (ADR-2608650000).
;;
;; Addresses and messages are :document values (document-* builtins).
;;
;; The oracle's email regex becomes a positional scan: an address is valid
;; when it has exactly one '@', no whitespace or angle brackets anywhere,
;; and a '.' somewhere after the '@'. RFC 5321's practical shape; the
;; oracle's regex is the same shape without claiming full RFC 5322.
;;
;; Compile (single file, JVM-free):
;;   kotoba compile kotoba/mail/message.kotoba --target wasm32-browser --output message.wasm

(ns mail.message
  (:export [normalize-address normalize-addresses valid-address?
            body-part message recipients validation-errors
            valid-message?]))

;; --- address helpers ------------------------------------------------------

;; Positional email scan replacing the oracle's regex
;; #"(?i)^[^@\s<>]+@[^@\s<>]+\.[^@\s<>]+$".
(defn- address-char-ok [c :string] :bool
  (if (string=? c "@") false
      (if (string=? c ".") true
          (if (string=? c "<") false
              (if (string=? c ">") false
                  (if (string=? c " ") false
                      true))))))

(defn- char-at [s :string i :i64] :string
  (string-substring s i (+ i 1)))

(defn- find-at [s :string n :i64 i :i64] :i64
  (if (>= i n) (- 0 1)
      (if (string=? (char-at s i) "@") i (find-at s n (+ i 1)))))

(defn- find-dot-after [s :string n :i64 at :i64 i :i64] :i64
  (if (>= i n) (- 0 1)
      (if (string=? (char-at s i) ".") i (find-dot-after s n at (+ i 1)))))

(defn- address-loop [s :string n :i64 i :i64] :bool
  (if (>= i n) true
      (if (address-char-ok (string-substring s i (+ i 1)))
          (address-loop s n (+ i 1))
          false)))

(defn- email-valid-text [s :string] :bool
  (let [n (string-length s)
        at (find-at s n 0)]
    (if (< at 1) false
        (if (>= (+ at 2) n) false
            (let [dot (find-dot-after s n at (+ at 1))]
              (if (< dot 1) false
                  (address-loop s n 0)))))))


;; nil-safe: a missing address is invalid, not an error.
(defn- dg [d k :keyword] :document
  (option-value-of [:option :document] (document-get d k) (document-null)))

(defn- ds [d k :keyword] :string
  (option-value-of [:option :string] (document-string-value (dg d k)) ""))

(defn valid-address? [address] :bool
  (let [s (ds address :mail.address/email)]
    (if (string=? s "") false (email-valid-text s))))

(defn normalize-address [address] :document
  (document-map :mail.address/email (document-string (ds address :mail.address/email))))

(defn normalize-addresses [addresses :document] :document
  (normalize-loop addresses (document-count addresses) 0 (document-vector)))

(defn- normalize-loop [addresses n i acc] :document
  (if (>= i n) acc
      (normalize-loop addresses n (+ i 1)
                      (document-vector-conj acc (normalize-address (option-value-of [:option :document] (document-vector-at addresses i) (document-null)))))))

;; --- message construction --------------------------------------------------

(defn body-part [content-type body] :document
  (document-map :mail.part/content-type (document-string content-type)
                :mail.part/body (document-string body)))

(defn message [attrs] :document
  (let [from (normalize-address (dg attrs :from))
        to (normalize-addresses (dg attrs :to))
        cc (normalize-addresses (dg attrs :cc))
        bcc (normalize-addresses (dg attrs :bcc))
        text (ds attrs :text)
        html (ds attrs :html)
        parts (if (string=? text "")
                (if (string=? html "")
                  (document-vector)
                  (document-vector (body-part "text/html; charset=utf-8" html)))
                (if (string=? html "")
                  (document-vector (body-part "text/plain; charset=utf-8" text))
                  (document-vector (body-part "text/plain; charset=utf-8" text)
                                   (body-part "text/html; charset=utf-8" html))))]
    (document-map
     :mail/type (document-keyword :mail/message)
     :mail/from from
     :mail/to to
     :mail/cc cc
     :mail/bcc bcc
     :mail/subject (document-string (ds attrs :subject))
     :mail/parts parts)))

(defn recipients [m] :document
  (concat-vectors (dg m :mail/to) (dg m :mail/cc) (dg m :mail/bcc)))

(defn- append-vector [acc :document src :document i :i64] :document
  (if (< i (document-count src))
    (append-vector (document-vector-conj acc (option-value-of [:option :document] (document-vector-at src i) (document-null))) src (+ i 1))
    acc))

(defn- concat-vectors [a :document b :document c :document] :document
  (append-vector (append-vector a b 0) c 0))

;; --- validation -------------------------------------------------------------
;; The oracle's five error shapes, returned (never thrown):

(defn validation-errors [m] :document
  (let [from (dg m :mail/from)
        to (dg m :mail/to)
        subject (ds m :mail/subject)
        parts (dg m :mail/parts)
        errs (document-vector)]
    (if (not (valid-address? from))
      (document-vector-conj
       (document-map :mail.error/code (document-keyword :invalid-from)
                     :mail.error/message (document-string "from must be a valid email address"))
       errs)
      (if (= (document-count to) 0)
        (document-vector-conj
         (document-map :mail.error/code (document-keyword :missing-to)
                       :mail.error/message (document-string "at least one to recipient is required"))
         errs)
        (if (string=? subject "")
          (document-vector-conj
           (document-map :mail.error/code (document-keyword :missing-subject)
                         :mail.error/message (document-string "subject is required"))
           errs)
          (if (= (document-count parts) 0)
            (document-vector-conj
             (document-map :mail.error/code (document-keyword :missing-body)
                           :mail.error/message (document-string "text or html body is required"))
             errs)
            (document-vector)))))))

(defn valid-message? [m] :bool
  (= (document-count (validation-errors m)) 0))
