;; mail.inbound — Pure Kotoba guest (oracle: src/mail/inbound.cljk).
;;
;; A received message. The oracle throws when a provider message-id is
;; missing; throw is not in the language (ADR-2608650000), so a missing id
;; returns the record with :mail.inbound/status :error. The host parses
;; MIME and hands a message document here — this namespace does not parse
;; wire formats.
;;
;; Compile (single file, JVM-free):
;;   kotoba compile kotoba/mail/inbound.kotoba --target wasm32-browser --output inbound.wasm

(ns mail.inbound
  (:export [inbound authenticated? inbound-fact]))

(defn- dg [d k :keyword] :document
  (option-value-of [:option :document] (document-get d k) (document-null)))

(defn- ds [d k :keyword] :string
  (option-value-of [:option :string] (document-string-value (dg d k)) ""))

(defn inbound [provider :keyword provider-message-id :string envelope :document received-at :string] :document
  (if (string=? provider-message-id "")
    (document-map
     :mail.inbound/type (document-keyword :mail/inbound)
     :mail.inbound/provider (document-keyword provider)
     :mail.inbound/provider-message-id (document-string "")
     :mail.inbound/message envelope
     :mail.inbound/status (document-keyword :error)
     :mail.inbound/error (document-string "mail inbound requires a provider message-id"))
    (document-map
     :mail.inbound/type (document-keyword :mail/inbound)
     :mail.inbound/provider (document-keyword provider)
     :mail.inbound/provider-message-id (document-string provider-message-id)
     :mail.inbound/message envelope
     :mail.inbound/received-at (document-string received-at)
     :mail.inbound/status (document-keyword :accepted))))

(defn authenticated? [i :document] :bool
  (if (string=? (ds i :mail.inbound/spf) "pass")
    (string=? (ds i :mail.inbound/dkim) "pass")
    false))

(defn inbound-fact [i :document] :document
  (document-map
   :kotoba/type (document-keyword :mail/inbound)
   :mail/inbound i))
