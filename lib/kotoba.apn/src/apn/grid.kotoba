;; Port of apn.grid (grid.cljk), Kotoba-native. PARTIAL.
;;
;; Ported: channel-count, spacing-ghz, channels, valid-channel?.
;; Skipped (not ported): anchor-thz and channel->frequency-thz. Both are
;; floating-point (f64 literals and arithmetic); the Kotoba f64 surface has
;; no arithmetic or comparison, so they have no faithful port yet.
;; Named divergences:
;;   - the source's constants are def values; Kotoba cannot export a def
;;     (E2005), so they are zero-argument functions returning the same value.
;;   - valid-channel? takes an :i64. The source also accepts non-integers
;;     and answers false for them; that input cannot be expressed here.
(ns apn.grid
  (:export [channel-count spacing-ghz channels valid-channel?]))

(defn channel-count [] :i64
  96)

(defn spacing-ghz [] :i64
  50)

(defn channels [] :vector-i64
  (let [n (channel-count)]
    (loop [i 1 acc (vector-alloc 0)]
      (if (> i n)
        acc
        (recur (+ i 1) (vector-conj acc i))))))

(defn valid-channel? [ch :i64] :bool
  (and (>= ch 1) (<= ch (channel-count))))
