(ns apn.rwa
  "Routing and Wavelength Assignment (RWA) — the core APN provisioning
  algorithm: given a topology and a (src, dst) demand, find a path across
  photonic links and a single wavelength free on every hop of that path
  (the wavelength-continuity constraint: apn.model represents a lightpath
  with exactly one wavelength for its whole path, so there is no per-hop
  conversion to reason about). Pure functions, no I/O — portable .cljc."
  (:require [kotoba.lang.coll :as set]
            [apn.model :as m]))

(defn- link-weight
  [l]
  (or (:apn/distance-km l) 1))

(defn path-cost
  [sys path]
  (reduce + (map #(link-weight (m/link-by-id sys %)) path)))

(defn- neighbors
  [sys node-id excluded-link-ids]
  (->> (m/links-at sys node-id)
       (remove #(excluded-link-ids (:apn/id %)))
       (map (fn [l] {:apn/link-id (:apn/id l)
                     :apn/to (m/other-end l node-id)
                     :apn/weight (link-weight l)}))))

(defn dijkstra
  "Shortest path from src to dst as a vector of link ids (empty vector if
  src = dst), or nil if unreachable. excluded-link-ids (a set) is skipped
  entirely when building the graph — used to generate alternate routes."
  ([sys src dst] (dijkstra sys src dst #{}))
  ([sys src dst excluded-link-ids]
   (if (= src dst)
     []
     (loop [frontier (sorted-set [0 src])
            dist     {src 0}
            prev     {}
            visited  #{}]
       (if (empty? frontier)
         nil
         (let [[d node] (first frontier)
               frontier (disj frontier [d node])]
           (cond
             (or (visited node) (not= d (get dist node)))
             (recur frontier dist prev visited)

             (= node dst)
             (loop [n dst path ()]
               (if-let [{:apn/keys [via-link from]} (get prev n)]
                 (recur from (cons via-link path))
                 (vec path)))

             :else
             (let [visited' (conj visited node)
                   nbrs (neighbors sys node excluded-link-ids)
                   [frontier' dist' prev']
                   (reduce
                    (fn [[fr ds pv] {:apn/keys [link-id to weight]}]
                      (if (visited' to)
                        [fr ds pv]
                        (let [nd (+ d weight)]
                          (if (< nd (get ds to ##Inf))
                            [(conj fr [nd to]) (assoc ds to nd)
                             (assoc pv to {:apn/via-link link-id :apn/from node})]
                            [fr ds pv]))))
                    [frontier dist prev] nbrs)]
               (recur frontier' dist' prev' visited')))))))))

(defn alternate-paths
  "Up to k loopless candidate paths from src to dst, ordered by ascending
  cost. NOT a full k-shortest-paths algorithm (e.g. Yen's): the shortest
  path is found first, then up to (count path0) further alternates are
  generated by excluding one link of path0 at a time and re-running
  Dijkstra. Duplicates and unreachable deviations are dropped."
  ([sys src dst] (alternate-paths sys src dst 3))
  ([sys src dst k]
   (if-let [path0 (dijkstra sys src dst)]
     (let [deviations (->> path0
                           (map #(dijkstra sys src dst #{%}))
                           (remove nil?))]
       (->> (cons path0 deviations)
            distinct
            (sort-by #(path-cost sys %))
            (take k)
            vec))
     [])))

(defn free-wavelengths
  "The set of channels free (not in :apn/occupied) on every link of path."
  [sys path]
  (if (empty? path)
    #{}
    (apply set/intersection
           (map (fn [link-id]
                  (let [l (m/link-by-id sys link-id)]
                    (set/difference (:apn/channels l) (set (keys (:apn/occupied l))))))
                path))))

(defn assign
  "Find a path and a wavelength free on every hop, trying alternate routes
  in ascending-cost order and first-fit (lowest-numbered) wavelength on
  each candidate. Returns {:apn/ok? true :apn/path [...] :apn/wavelength
  ch} or {:apn/ok? false :apn/reason :same-node|:no-path|:no-common-wavelength}."
  ([sys src dst] (assign sys src dst 3))
  ([sys src dst k]
   (if (= src dst)
     {:apn/ok? false :apn/reason :same-node}
     (let [candidates (alternate-paths sys src dst k)]
       (if (empty? candidates)
         {:apn/ok? false :apn/reason :no-path}
         (or (some (fn [path]
                     (when-let [ch (first (sort (free-wavelengths sys path)))]
                       {:apn/ok? true :apn/path path :apn/wavelength ch}))
                   candidates)
             {:apn/ok? false :apn/reason :no-common-wavelength}))))))
