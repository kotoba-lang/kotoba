#!/usr/bin/env kbb
;; The operator quickstart (docs/operator-quickstart.md) as one runnable file.
;;
;;   kbb --backend sci --classpath src docs/quickstart.cljk   # from the repo root
;;
;; Every step prints what it got AND checks it against what the quickstart
;; says it should get. A mismatch prints `MISMATCH` and exits 1, so the
;; walkthrough cannot drift from the library without someone noticing.
;; The last line is `quickstart: <n> checks, <k> mismatches` -- n = 0 would
;; mean nothing ran, not that everything held.
;;
;; The script has to live inside this repo: kbb reads :deps (kotoba.lang.coll)
;; from the nearest nbb.edn above the script, not from the current directory.
(require '[apn.model :as m]
         '[apn.grid :as grid]
         '[apn.validate :as v]
         '[apn.rwa :as rwa]
         '[apn.provision :as p]
         '[apn.runner :as runner])

(def checks (atom 0))
(def mismatches (atom 0))

(defn step [label got expected]
  (swap! checks inc)
  (prn label got)
  (when (not= got expected)
    (swap! mismatches inc)
    (println "  MISMATCH expected" (pr-str expected))))

;; 1. A topology: three ROADM sites in a line, each fibre carrying only two
;;    DWDM channels, so the third lightpath has nowhere to go.
(def sys
  (-> (m/system)
      (m/add-node (m/node "tokyo-1" {}))
      (m/add-node (m/node "nagoya-1" {}))
      (m/add-node (m/node "osaka-1" {}))
      (m/add-link (m/link "tokyo-nagoya" "tokyo-1" "nagoya-1"
                          {:apn/distance-km 350.0 :apn/channels #{1 2}}))
      (m/add-link (m/link "nagoya-osaka" "nagoya-1" "osaka-1"
                          {:apn/distance-km 180.0 :apn/channels #{1 2}}))))

(def path ["tokyo-nagoya" "nagoya-osaka"])

;; 2. The grid the channel numbers index into.
(step :grid [(count (grid/channels)) (grid/channel->frequency-thz 1)] [96 190.725])

;; 3. Validate before routing anything.
(step :valid? (v/valid? sys) true)
(step :broken (v/validate (m/add-link sys (m/link "x" "tokyo-1" "kyoto-1" {:apn/channels #{1}})))
      [{:apn/error :dangling-link-endpoint :apn/link "x" :apn/end :apn/z :apn/node "kyoto-1"}])

;; 4. RWA alone: a path plus one wavelength free on every hop. Nothing changes.
(step :assign (rwa/assign sys "tokyo-1" "osaka-1")
      {:apn/ok? true :apn/path path :apn/wavelength 1})

;; 5. Provision until the fibre is full.
(def r1 (p/request sys "lp-1" "tokyo-1" "osaka-1"))
(step :lp-1 (:apn/event r1)
      {:apn/t :provisioned :apn/lightpath "lp-1" :apn/path path :apn/wavelength 1})
(def r2 (p/request (:apn/system' r1) "lp-2" "tokyo-1" "osaka-1"))
(step :lp-2 (:apn/event r2)
      {:apn/t :provisioned :apn/lightpath "lp-2" :apn/path path :apn/wavelength 2})
(def r3 (p/request (:apn/system' r2) "lp-3" "tokyo-1" "osaka-1"))
(step :lp-3 (:apn/event r3)
      {:apn/t :blocked :apn/lightpath "lp-3" :apn/reason :no-common-wavelength})
(step :blocked-mutates? (= (:apn/system' r3) (:apn/system' r2)) true)

;; 6. Tear one down; the freed wavelength is reusable.
(def t1 (p/teardown (:apn/system' r3) "lp-1"))
(step :teardown (:apn/event t1) {:apn/t :torn-down :apn/lightpath "lp-1"})
(step :lp-3-retry (:apn/event (p/request (:apn/system' t1) "lp-3" "tokyo-1" "osaka-1"))
      {:apn/t :provisioned :apn/lightpath "lp-3" :apn/path path :apn/wavelength 1})

;; 7. The same three demands as one offline what-if batch.
(step :dry-run (mapv (juxt :apn/lightpath :apn/t)
                     (:apn/trace (runner/dry-run sys (for [id ["a" "b" "c"]]
                                                       {:apn/id id :apn/src "tokyo-1" :apn/dst "osaka-1"}))))
      [["a" :provisioned] ["b" :provisioned] ["c" :blocked]])

(println (str "quickstart: " @checks " checks, " @mismatches " mismatches"))
(when (or (zero? @checks) (pos? @mismatches))
  (set! (.-exitCode js/process) 1))
