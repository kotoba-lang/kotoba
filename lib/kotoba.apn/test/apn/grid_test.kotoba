;; Test for apn.grid (ported part). main returns the number of failed cases.
(ns apn.grid-test
  (:export [main])
  (:require [apn.grid :as g]))

(defn- chk [ok :bool] :i64
  (if ok 0 1))

(defn- shape [] :i64
  (let [cs (g/channels)]
    (+ (chk (= (g/channel-count) 96))
       (+ (chk (= (g/spacing-ghz) 50))
          (+ (chk (= (vector-count cs) 96))
             (+ (chk (= (vector-at cs 0) 1))
                (chk (= (vector-at cs 95) 96))))))))

(defn- validity [] :i64
  (+ (chk (g/valid-channel? 1))
     (+ (chk (g/valid-channel? 96))
        (+ (chk (not (g/valid-channel? 0)))
           (+ (chk (not (g/valid-channel? 97)))
              (chk (not (g/valid-channel? -5))))))))

(defn main [] :i64
  (+ (shape) (validity)))
