(ns kami.sprite2d-prims-test
  "The painter's primitives against a recording canvas: every assertion reads the exact
   sequence of 2D-context calls a part produced, so a primitive that silently draws nothing
   (or draws the wrong thing) fails by name. Runs on nbb — there is no real canvas here, and
   Path2D is stubbed so the memoisation can be counted."
  (:require [cljs.test :refer [deftest is testing]]
            [kami.sprite2d :as s]))

(defn- rec-ctx
  "A fake CanvasRenderingContext2D that appends [method args…] (and [:set prop value]) to a log."
  []
  (let [log (atom [])
        ctx #js {}
        method (fn [k] (fn [& args] (swap! log conj (into [k] args)) nil))]
    (doseq [k [:beginPath :closePath :moveTo :lineTo :arc :ellipse :fill :stroke :fillRect
               :save :restore :translate :rotate :scale :drawImage]]
      (aset ctx (name k) (method k)))
    (set! (.-globalAlpha ctx) 1)
    [ctx log]))

(defn- ops [log] (mapv first @log))

(def path2d-made (atom 0))
(set! (.-Path2D js/globalThis) (fn [d] (swap! path2d-made inc) #js {:d d}))

(deftest poly-traces-closes-and-fills
  (let [[ctx log] (rec-ctx)]
    (s/prim! ctx [:poly {:dx 10 :dy 0 :pts [[0 0] [4 0] [0 4]] :fill [1 0 0]}] 0 0)
    (is (= [:beginPath :moveTo :lineTo :lineTo :closePath :fill] (ops log)))
    (is (= [:moveTo 10 0] (nth @log 1)) "points are offset by :dx/:dy")
    (is (= "rgba(255,0,0,1)" (.-fillStyle ctx)))))

(deftest line-strokes-and-never-fills
  (let [[ctx log] (rec-ctx)]
    (s/prim! ctx [:line {:pts [[0 0] [5 5]] :fill [1 1 1] :stroke [0 0 1] :w 3}] 0 0)
    (is (= [:beginPath :moveTo :lineTo :stroke] (ops log)) "a :fill on a :line is ignored")
    (is (= 3 (.-lineWidth ctx)))))

(deftest path-parses-once-and-paints-the-parsed-path
  (reset! path2d-made 0)
  (let [[ctx log] (rec-ctx) part [:path {:d "M0 0L10 0L5 8Z" :fill [0 1 0] :dx 2 :dy 3}]]
    (s/prim! ctx part 0 0)
    (s/prim! ctx part 0 0)
    (is (= 1 @path2d-made) "the same :d is parsed once, not per frame")
    (is (= [:save :translate :fill :restore :save :translate :fill :restore] (ops log)))
    (is (= [:translate 2 3] (nth @log 1)))
    (is (= "M0 0L10 0L5 8Z" (.-d (second (nth @log 2)))) "fill receives the parsed path")))

(deftest fill-only-circle-is-unchanged-from-v1
  (let [[ctx log] (rec-ctx)]
    (s/prim! ctx [:circle {:dx 1 :dy 2 :r 3 :fill [0 0 0]}] 0 0)
    (is (= [[:beginPath] [:arc 1 2 3 0 (* 2 js/Math.PI)] [:fill]] @log))))

(deftest stroked-circle-outlines
  (let [[ctx log] (rec-ctx)]
    (s/prim! ctx [:circle {:r 3 :stroke [1 1 1] :w 2}] 0 0)
    (is (= [:beginPath :arc :stroke] (ops log)))))

(deftest alpha-is-scoped-and-multiplies
  (let [[ctx log] (rec-ctx)]
    (set! (.-globalAlpha ctx) 0.5)
    (s/prim! ctx [:poly {:pts [[0 0] [1 0] [0 1]] :fill [1 1 1] :alpha 0.5}] 0 0)
    (is (= :save (first (ops log))))
    (is (= :restore (last (ops log))))
    (is (= 0.25 (.-globalAlpha ctx)) "alpha multiplies the inherited alpha (restore is a fake here)")))

(deftest blink-closes-only-inside-its-window
  (testing "inside the window: y-scale 0.12"
    (let [[ctx log] (rec-ctx)]
      (s/prim! ctx [:circle {:r 2 :fill [0 0 0] :anim {:blink [3 0.2]}}] 3.1 0)
      (is (some #(= [:scale 1 0.12] %) @log))))
  (testing "outside the window: no squash"
    (let [[ctx log] (rec-ctx)]
      (s/prim! ctx [:circle {:r 2 :fill [0 0 0] :anim {:blink [3 0.2]}}] 1.5 0)
      (is (not-any? #(= :scale (first %)) @log)))))

(deftest sprite-shadow-is-optional
  (let [[ctx log] (rec-ctx)]
    (s/draw-sprite! ctx [[:circle {:r 1 :fill [0 0 0]}]] 0 0 1)
    (is (= 1 (count (filter #(= :ellipse (first %)) @log))) "default arity keeps the ground shadow"))
  (let [[ctx log] (rec-ctx)]
    (s/draw-sprite! ctx [[:circle {:r 1 :fill [0 0 0]}]] 0 0 1 0 0 {:shadow? false :rot 0.5})
    (is (zero? (count (filter #(= :ellipse (first %)) @log))) "{:shadow? false} draws none")
    (is (some #(= [:rotate 0.5] %) @log))))
