(ns kotoba.hash.sha1)

(defn sha1-rol [value amount]
  (bit-or (bit-shift-left value amount)
          (unsigned-bit-shift-right value (- 32 amount))))

(defn sha1-store-word! [ptr offset value]
  (let [a (byte-store! ptr offset (bit-and (unsigned-bit-shift-right value 24) 255))
        b (byte-store! ptr (+ offset 1) (bit-and (unsigned-bit-shift-right value 16) 255))
        c (byte-store! ptr (+ offset 2) (bit-and (unsigned-bit-shift-right value 8) 255))]
    (byte-store! ptr (+ offset 3) (bit-and value 255))))

(defn sha1-word [ptr offset]
  (bit-or (bit-shift-left (mem-byte-at ptr offset) 24)
          (bit-shift-left (mem-byte-at ptr (+ offset 1)) 16)
          (bit-shift-left (mem-byte-at ptr (+ offset 2)) 8)
          (mem-byte-at ptr (+ offset 3))))

(defn sha1-padded-byte [input-ptr input-length padded-length index]
  (if (< index input-length)
    (mem-byte-at input-ptr index)
    (if (= index input-length)
      128
      (let [length-start (- padded-length 8)
            length-index (- index length-start)
            bit-length (* input-length 8)]
        (if (< index length-start)
          0
          (if (< length-index 4)
            0
            (bit-and (unsigned-bit-shift-right bit-length
                                               (* (- 7 length-index) 8))
                     255)))))))

(defn sha1-load-initial-words! [input-ptr input-length padded-length
                                block-start workspace word-index]
  (if (>= word-index 16)
    16
    (let [source (+ block-start (* word-index 4))
          value (bit-or
                 (bit-shift-left (sha1-padded-byte input-ptr input-length padded-length source) 24)
                 (bit-shift-left (sha1-padded-byte input-ptr input-length padded-length (+ source 1)) 16)
                 (bit-shift-left (sha1-padded-byte input-ptr input-length padded-length (+ source 2)) 8)
                 (sha1-padded-byte input-ptr input-length padded-length (+ source 3)))
          stored (sha1-store-word! workspace (* word-index 4) value)]
      (sha1-load-initial-words! input-ptr input-length padded-length
                                block-start workspace (+ word-index 1)))))

(defn sha1-expand-words! [workspace word-index]
  (if (>= word-index 80)
    80
    (let [value (sha1-rol
                 (bit-xor (sha1-word workspace (* (- word-index 3) 4))
                          (sha1-word workspace (* (- word-index 8) 4))
                          (sha1-word workspace (* (- word-index 14) 4))
                          (sha1-word workspace (* (- word-index 16) 4)))
                 1)
          stored (sha1-store-word! workspace (* word-index 4) value)]
      (sha1-expand-words! workspace (+ word-index 1)))))

(defn sha1-f [round b c d]
  (if (< round 20)
    (bit-or (bit-and b c) (bit-and (bit-xor b -1) d))
    (if (< round 40)
      (bit-xor b c d)
      (if (< round 60)
        (bit-or (bit-and b c) (bit-and b d) (bit-and c d))
        (bit-xor b c d)))))

(defn sha1-k [round]
  (if (< round 20)
    1518500249
    (if (< round 40)
      1859775393
      (if (< round 60) -1894007588 -899497514))))

(defn sha1-rounds! [workspace out-ptr round a b c d e]
  (if (>= round 80)
    (let [s0 (sha1-store-word! out-ptr 0 (+ (sha1-word out-ptr 0) a))
          s1 (sha1-store-word! out-ptr 4 (+ (sha1-word out-ptr 4) b))
          s2 (sha1-store-word! out-ptr 8 (+ (sha1-word out-ptr 8) c))
          s3 (sha1-store-word! out-ptr 12 (+ (sha1-word out-ptr 12) d))
          s4 (sha1-store-word! out-ptr 16 (+ (sha1-word out-ptr 16) e))]
      20)
    (let [temp (+ (sha1-rol a 5)
                  (sha1-f round b c d)
                  e
                  (sha1-k round)
                  (sha1-word workspace (* round 4)))]
      (sha1-rounds! workspace out-ptr (+ round 1)
                    temp a (sha1-rol b 30) c d))))

(defn sha1-blocks! [input-ptr input-length padded-length out-ptr workspace block-start]
  (if (>= block-start padded-length)
    20
    (let [loaded (sha1-load-initial-words! input-ptr input-length padded-length
                                           block-start workspace 0)
          expanded (sha1-expand-words! workspace 16)
          compressed (sha1-rounds! workspace out-ptr 0
                                   (sha1-word out-ptr 0)
                                   (sha1-word out-ptr 4)
                                   (sha1-word out-ptr 8)
                                   (sha1-word out-ptr 12)
                                   (sha1-word out-ptr 16))]
      (sha1-blocks! input-ptr input-length padded-length out-ptr workspace
                    (+ block-start 64)))))

(defn sha1! [input-ptr input-length out-ptr out-cap workspace workspace-cap]
  (if (or (< input-length 0) (> input-length 16777216)
          (< out-cap 20) (< workspace-cap 320))
    -1
    (let [h0 (sha1-store-word! out-ptr 0 1732584193)
          h1 (sha1-store-word! out-ptr 4 -271733879)
          h2 (sha1-store-word! out-ptr 8 -1732584194)
          h3 (sha1-store-word! out-ptr 12 271733878)
          h4 (sha1-store-word! out-ptr 16 -1009589776)
          padded-length (* (/ (+ input-length 72) 64) 64)]
      (sha1-blocks! input-ptr input-length padded-length out-ptr workspace 0))))

(defn sha1-equal? [input-ptr input-length expected-ptr workspace workspace-cap]
  (let [digest-ptr (+ workspace 320)
        digest-cap (- workspace-cap 320)
        hashed (sha1! input-ptr input-length digest-ptr digest-cap workspace 320)]
    (if (= hashed 20)
      (sha1-bytes-equal? digest-ptr expected-ptr 20 0)
      0)))

(defn sha1-bytes-equal? [left-ptr right-ptr length index]
  (if (>= index length)
    1
    (if (= (mem-byte-at left-ptr index) (mem-byte-at right-ptr index))
      (sha1-bytes-equal? left-ptr right-ptr length (+ index 1))
      0)))
