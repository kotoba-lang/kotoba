;; No dependencies. MIL-STD-1553B is a 20-bit word, a handful of packed
;; bitfields, and a mode-code lookup table — a leaf that dragged in a
;; bus-controller SDK or a hardware interface library would defeat the
;; point, which is that this codec has to be checkable on both the JVM
;; and ClojureScript.
{:deps {
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}}
 :paths ["src"]
 :aliases
 {:test {:extra-paths ["test"]}
  :cljs {:extra-paths ["test"]}}}
