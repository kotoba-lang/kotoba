;; Port of mil1553.data (data.cljk), Kotoba-native.
;;
;; Named divergences from data.cljk:
;;   - The result vectors [:ok v] and [:error kw v] are :document vectors of the
;;     same shape.
;;   - value must be an integer (:i64). The 0xFFFF bound is written as 65535.

(ns mil1553.data
  (:export [pack unpack]))

(defn- payload-ok? [value :i64] :bool
  (and (>= value 0) (<= value 65535)))

(defn pack [value :i64] :document
  (if (payload-ok? value)
    (document-vector (document-keyword :ok) (document-i64 value))
    (document-vector (document-keyword :error) (document-keyword :mil1553/payload-out-of-range) (document-i64 value))))

(defn unpack [payload :i64] :document
  (if (payload-ok? payload)
    (document-vector (document-keyword :ok) (document-i64 payload))
    (document-vector (document-keyword :error) (document-keyword :mil1553/payload-out-of-range) (document-i64 payload))))
