(ns mil1553.data-test
  (:export [main])
  (:require [mil1553.data :as d]))

(defn- edn-is [got :document want :string] :i64
  (if (string=? (document-edn-print got) want) 0 1))

(defn main [] :i64
  (+ (edn-is (d/pack 0) "[:ok 0]")
     (edn-is (d/pack 65535) "[:ok 65535]")
     (edn-is (d/pack 1234) "[:ok 1234]")
     (edn-is (d/pack 65536) "[:error :mil1553/payload-out-of-range 65536]")
     (edn-is (d/pack -1) "[:error :mil1553/payload-out-of-range -1]")
     (edn-is (d/unpack 42) "[:ok 42]")
     (edn-is (d/unpack 70000) "[:error :mil1553/payload-out-of-range 70000]")))
