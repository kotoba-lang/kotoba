;; Port of kami.eizo.compositor.roto (roto.cljk), Kotoba-native.
;;
;; A polygon is a :document vector of [x y] :document vectors of i64, straight
;; edges only. point-in-polygon? is the ray-casting test: a ray from the point
;; towards +x counts edge crossings, and an odd count is inside. It is correct
;; for non-convex polygons.
;;
;; Named divergences from roto.cljk:
;;   - coordinates are i64. The source divides in (x-xi)... ratio arithmetic
;;     (exact for integer points); here the same crossing test is evaluated by
;;     cross-multiplication, which is exact for integer coordinates and gives
;;     the same answer as the source's exact ratio.
;;   - a vertex or coordinate that is not an i64 reads as 0 (the source throws).
;;   - make-polygon returns the points vector unchanged, or document-null when
;;     there are fewer than 3 points (the source's nil).

(ns kami.eizo.compositor.roto
  (:export [point-in-polygon? make-polygon]))

(defn- seq-count [d :document] :i64
  (if (vector? d) (document-count d) 0))

(defn- vertex [polygon :document i :i64] :document
  (if (vector? polygon)
    (option-or (document-vector-at polygon i) (document-null))
    (document-null)))

(defn- coord [p :document i :i64] :i64
  (if (vector? p)
    (option-or (document-i64-value (option-or (document-vector-at p i) (document-null))) 0)
    0))

(defn- edge-crosses? [xi :i64 yi :i64 xj :i64 yj :i64 x :i64 y :i64] :bool
  (let [above-i (> yi y)
        above-j (> yj y)]
    (if (if above-i above-j (not above-j))
      false
      (let [dy (- yj yi)
            lhs (* (- x xi) dy)
            rhs (* (- xj xi) (- y yi))]
        (if (> dy 0) (< lhs rhs) (> lhs rhs))))))

(defn point-in-polygon? [polygon :document pt :document] :bool
  (let [n (seq-count polygon)
        x (coord pt 0)
        y (coord pt 1)]
    (loop [i 0 j (- n 1) inside false]
      (if (>= i n)
        inside
        (let [xi (coord (vertex polygon i) 0)
              yi (coord (vertex polygon i) 1)
              xj (coord (vertex polygon j) 0)
              yj (coord (vertex polygon j) 1)]
          (recur (+ i 1) i (if (edge-crosses? xi yi xj yj x y) (not inside) inside)))))))

(defn make-polygon [points :document] :document
  (if (>= (seq-count points) 3)
    points
    (document-null)))
