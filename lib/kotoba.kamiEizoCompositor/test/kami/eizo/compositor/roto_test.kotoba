(ns kami.eizo.compositor.roto-test (:export [main]) (:require [kami.eizo.compositor.roto :as p]))

(defn- pt [x :i64 y :i64] :document (document-vector (document-i64 x) (document-i64 y)))

(defn- square [] :document
  (document-vector (pt 0 0) (pt 10 0) (pt 10 10) (pt 0 10)))

;; L-shape: the notch is x in (4,10), y in (4,10).
(defn- l-shape [] :document
  (document-vector (pt 0 0) (pt 10 0) (pt 10 4) (pt 4 4) (pt 4 10) (pt 0 10)))

(defn- inside-case [poly :document x :i64 y :i64 want :bool] :i64
  (if (= (p/point-in-polygon? poly (pt x y)) want) 0 1))

(defn- square-case [] :i64
  (+ (inside-case (square) 5 5 true)
     (inside-case (square) 15 5 false)
     (inside-case (square) -1 5 false)
     (inside-case (square) 5 11 false)))

(defn- concave-case [] :i64
  (+ (inside-case (l-shape) 2 8 true)
     (inside-case (l-shape) 8 8 false)
     (inside-case (l-shape) 8 2 true)
     (inside-case (l-shape) 12 2 false)))

(defn- make-case [] :i64
  (+ (if (string=? (document-edn-print (p/make-polygon (document-vector (pt 0 0) (pt 1 0)))) "nil") 0 1)
     (if (= (document-count (p/make-polygon (square))) 4) 0 1)))

(defn main [] :i64
  (+ (square-case) (concave-case) (make-case)))
