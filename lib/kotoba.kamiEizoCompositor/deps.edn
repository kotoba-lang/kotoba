{:paths ["src"]
 :deps {
        io.github.kotoba-lang/test
        {:local/root "../kotoba.test"}}
 :aliases
 {:test {:extra-paths ["test"]}
  ;; Real-browser real-pixel-data proof (test/e2e/, ADR-2607121400): compiles
  ;; kami.eizo.compositor.e2e.entry, which pulls in both this repo's own
  ;; chroma-key + blend compositing math and org-w3-webcodecs's raw WebCodecs
  ;; binding, into one browser bundle via scripts/build-e2e-bundle.sh. See
  ;; test/e2e/ and the README's "Real-browser real-pixel-data proof" section.
  :e2e {:extra-paths ["test/e2e/src"]
        :extra-deps {io.github.kotoba-lang/org-w3-webcodecs
        {:local/root "../org.w3.webcodecs"}}}}}
