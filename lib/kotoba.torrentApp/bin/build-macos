#!/bin/sh
set -eu
app_dir="${1:-target/KotobaTorrent.app}"
mkdir -p "$app_dir/Contents/MacOS" "$app_dir/Contents/Resources"
/usr/bin/swiftc native/macos/KotobaTorrent.swift -o "$app_dir/Contents/MacOS/KotobaTorrent" -framework AppKit
/bin/cp native/macos/Info.plist "$app_dir/Contents/Info.plist"
echo "$app_dir"
