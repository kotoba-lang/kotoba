;; Test for kotoba.torrent-app. main returns the number of failed cases.
(ns kotoba.torrent-app-test
  (:export [main])
  (:require [kotoba.torrent-app :as t]))

(defn- chk [ok :bool] :i64
  (if ok 0 1))

(defn- op [ops :document i :i64] :document
  (option-value-of [:option :document] (document-vector-at ops i) (document-null)))

(defn- shape-checks [d :document ops :document] :i64
  (+ (chk (= (document-count d) 1))
     (+ (chk (= (document-count ops) 20))
        (chk (document-equal? (op ops 20) (document-null))))))

(defn- op-checks [ops :document] :i64
  (+ (chk (document-equal? (op ops 0) (document-edn-read "[:dom/create-element 1 :main]")))
     (+ (chk (document-equal? (op ops 1) (document-edn-read "[:dom/set-attr 1 :class \"liquid-glass__panel\"]")))
        (+ (chk (document-equal? (op ops 11) (document-edn-read "[:dom/set-attr 6 :data-action \"torrent/pick-file\"]")))
           (chk (document-equal? (op ops 19) (document-edn-read "[:dom/set-root 1]")))))))

(defn main [] :i64
  (let [d (t/start)
        ops (option-value-of [:option :document] (document-get d (document-keyword :kotoba.app/surface-ops)) (document-null))]
    (+ (shape-checks d ops) (op-checks ops))))
