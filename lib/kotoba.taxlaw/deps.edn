{:paths ["src"]
 ;; Deliberately dependency-free, for the same reason `kotoba-lang/worklaw`
 ;; is: an actor that needs to know what a tax record must carry should not
 ;; thereby acquire a ledger, a wage calculator, or a network client.
 ;;
 ;; The e-Gov corpus (`kotoba-lang/jp.go.e-gov.elaws`) is NOT a dependency
 ;; either. `tools/verify_citations.cljk` reads its index when it is present
 ;; on disk and refuses to report a verdict when it is not — verification is
 ;; an operator's step, not something a consumer of this library carries.
 :deps {
        io.github.kotoba-lang/coll {:local/root "../kotoba.coll"}
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/edn {:local/root "../kotoba.edn"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
