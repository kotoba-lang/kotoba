;; Port of autodrive.classes (classes.cljk), Kotoba-native, :document maps.
;;
;; Named divergences from classes.cljk:
;;   - vehicle-classes is a zero-arg fn returning a :document vector of keywords.
;;   - limits: the source's case has no default and throws on an unknown class;
;;     throw is not available in Kotoba, so an unknown class returns document-null.
;;   - the float limits are :f64 document values (carried, not computed).

(ns autodrive.classes
  (:export [vehicle-classes limits]))

(defn vehicle-classes [] :document
  (document-vector (document-keyword :car) (document-keyword :ship)
                   (document-keyword :drone) (document-keyword :aircraft)))

(defn limits [vclass :keyword] :document
  (if (document-equal? (document-keyword vclass) (document-keyword :car))
    (document-map :max-speed (document-f64 25.0) :max-accel (document-f64 4.0)
                  :max-decel (document-f64 8.0) :wheelbase (document-f64 2.7)
                  :max-steer (document-f64 0.61) :turn-radius-ref (document-f64 4.5)
                  :footprint-radius (document-f64 1.3))
  (if (document-equal? (document-keyword vclass) (document-keyword :ship))
    (document-map :max-speed (document-f64 8.0) :max-accel (document-f64 0.5)
                  :max-decel (document-f64 1.0) :wheelbase (document-f64 30.0)
                  :max-steer (document-f64 0.52) :turn-radius-ref (document-f64 40.0)
                  :footprint-radius (document-f64 6.0))
  (if (document-equal? (document-keyword vclass) (document-keyword :drone))
    (document-map :max-speed (document-f64 15.0) :max-accel (document-f64 6.0)
                  :max-decel (document-f64 6.0) :wheelbase (document-f64 0.5)
                  :max-steer (document-f64 1.20) :turn-radius-ref (document-f64 2.5)
                  :footprint-radius (document-f64 0.6))
  (if (document-equal? (document-keyword vclass) (document-keyword :aircraft))
    (document-map :max-speed (document-f64 60.0) :max-accel (document-f64 3.0)
                  :max-decel (document-f64 4.0) :wheelbase (document-f64 15.0)
                  :max-steer (document-f64 0.35) :turn-radius-ref (document-f64 250.0)
                  :footprint-radius (document-f64 8.0))
    (document-null))))))
