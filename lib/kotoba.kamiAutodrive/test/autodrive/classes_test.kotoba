(ns autodrive.classes-test (:export [main]) (:require [autodrive.classes :as c]))

(defn- fld [d :document k :keyword] :document
  (option-or (document-get d k) (document-null)))

(defn- same [a :document b :document] :bool
  (string=? (document-edn-print a) (document-edn-print b)))

(defn main [] :i64
  (let [ship (c/limits :ship)
        car (c/limits :car)]
    (+ (if (= (document-count (c/vehicle-classes)) 4) 0 1)
       (if (same (option-or (document-vector-at (c/vehicle-classes) 1) (document-null)) (document-keyword :ship)) 0 1)
       (if (same (fld car :max-speed) (document-f64 25.0)) 0 1)
       (if (same (fld ship :turn-radius-ref) (document-f64 40.0)) 0 1)
       (if (same (fld (c/limits :aircraft) :footprint-radius) (document-f64 8.0)) 0 1)
       (if (same (fld (c/limits :drone) :wheelbase) (document-f64 0.5)) 0 1)
       (if (same (c/limits :bogus) (document-null)) 0 1)
       (if (= (document-count ship) 7) 0 1))))
