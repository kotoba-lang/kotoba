(ns update-policy
 (:require [grant.update-lifecycle :as lifecycle]
           ["node:fs" :as fs]))
;; One JSON message per invocation. Local privileged adapter supplies current
;; owner policy + manifest-bound evidence; downloaded input cannot call this port.
(let [request (js->clj (js/JSON.parse (.readFileSync fs 0 "utf8")) :keywordize-keys true)
      result (if (= "trial" (:operation request))
               (lifecycle/trial-decision (update (:evidence request) :local-health keyword))
               (lifecycle/decide
                (-> (:release request)
                    (update :channel keyword) (update :security-risk keyword) (update :apply-risk keyword))
                (cond-> (:policy request)
                  (get-in request [:policy :mode]) (update :mode keyword)
                  (get-in request [:policy :channel]) (update :channel keyword)
                  (get-in request [:policy :max-apply-risk]) (update :max-apply-risk keyword))
                (:evidence request) (:now request)))]
 (println (js/JSON.stringify (clj->js result))))
