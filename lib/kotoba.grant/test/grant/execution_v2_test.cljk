(ns grant.execution-v2-test
  (:require #?(:clj [kotoba.test :refer [deftest is]] :cljs [cljs.test :refer [deftest is]])
            [grant.execution-v2 :as issuer] [grant.graph :as graph] [grant.policy :as policy]
            [kotoba.artifact.execution :as blocks] [kotoba.core.execution :as core]
            [kotoba.abi.target :as target]))
(def cid (:cid (blocks/block :policy {:policy :issuance-test})))
(def context {:target :js-kotoba-v1 :profile :sync :artifact-cid cid :interface-cid cid
              :runtime-identity cid :layout (:layout (get target/profiles :js-kotoba-v1))})
(def binding (blocks/binding-block :js-kotoba-v1 :sync cid cid cid (:layout context)))
(def invocation (issuer/issue-invocation (apply str (repeat 64 "a"))))
(def intent (blocks/intent-block binding context
              (assoc (zipmap core/execution-intent-keys (repeat cid))
                     :format :kotoba.execution-intent/v2 :profile-binding-cid (:cid binding)
                     :grant-cids [cid] :approval-cids [] :invocation-cid (:cid invocation))))
(def plan {:format :kotoba.plan/v1 :plan-cid cid :code-closure-cid cid :artifact-cid cid
           :compiler-contract cid :input-cid cid :requested-effects #{:log/write}
           :requested-resources #{cid} :budget {:fuel 1024}})
(def authority-input
  {:decision-input {:plan plan :decision-cid cid :policy-cid cid :db-basis cid
                    :issued-at "2026-10-11T00:00:00Z" :expires-at "2026-10-11T00:01:00Z"
                    :manifest {:aiueos/component :agent/clean :aiueos/kind :agent
                               :aiueos/imports #{:log/write}}
                    :graph (graph/build []) :policy policy/default-policy}
   :intent intent :invocation invocation :now-iso "2026-10-11T00:00:01Z"
   :permissions {cid {:grant-cid cid :resource-cid cid :purpose :log/write
                      :expires-at "2026-10-11T00:01:00Z" :max-uses 1
                      :transfer :non-transferable :max-delegation-depth 0}}
   :requested [{:capability-cid cid :resource-cid cid :purpose :log/write
                :expires-at "2026-10-11T00:01:00Z" :uses 1 :transfer :non-transferable :delegation-depth 0}]})
(defn refused? [f] (try (f) false (catch #?(:clj Exception :cljs :default) _ true)))
(deftest the-authority-derives-permit-instead-of-taking-a-guest-result
  (let [issued (issuer/decide-and-issue authority-input)]
    (is (= :permit (get-in issued [:decision :result])))
    (is (= 1 (count (:leases issued))))
    (is (= (:cid intent) (:execution-identity-cid (blocks/verify-block :lease (first (:leases issued)))))))
  (is (refused? #(issuer/decide-and-issue (assoc-in authority-input [:decision-input :result] :permit))))
  (is (refused? #(issuer/decide-and-issue
                  (assoc-in authority-input [:decision-input :manifest]
                            {:aiueos/component :agent/unsafe :aiueos/kind :agent :aiueos/effects #{:network}}))))
  (is (refused? #(issuer/decide-and-issue (assoc-in authority-input [:requested 0 :uses] 2)))))
(deftest validity-windows-are-strict-and-closed
  (doseq [text ["2026-02-30T00:00:00Z" "2026-10-11" "2026-10-11T00:00:00+00:00" "NaN"]]
    (is (nil? (issuer/instant-ms text))))
  (is (= 1791676800000 (issuer/instant-ms "2026-10-11T00:00:00Z")))
  (is (refused? #(issuer/decide-and-issue (assoc authority-input :now-iso "2026-10-11T00:01:00Z")))))
