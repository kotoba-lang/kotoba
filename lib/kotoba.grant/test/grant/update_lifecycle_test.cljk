(ns grant.update-lifecycle-test
  (:require [grant.update-lifecycle :as u]
            [kotoba.test :refer [deftest is]]))
(def release {:sequence 2 :channel :stable :security-risk :high :apply-risk :medium})
(def evidence {:signature-valid? true :owner-policy-current? true :compatible? true
 :fresh? true :time-trusted? true :rollout-admitted? true :installed-sequence 1 :noticed-at 0 :closure-verified? true
 :previous-preserved? true :boot-recovery-qualified? true :space-ok? true
 :owner-peers-updating 0 :drained? true :maintenance-window? true})
(defn d [r p e n] (u/decide r p e n))
(deftest normal-and-deadline
 (is (= :trial-boot (:action (d release {} evidence 1))))
 (is (= :hold (:action (d release {:mode :manual} evidence 1))))
 (is (= :security-deadline (:reason (d release {:mode :manual} evidence 259200000))))
 (is (= :drain-and-refuse-new-jobs (:fleet (d release {} evidence 259200000))))
 (is (= :hold (:action (d release {:semi-mandatory? false :mode :manual} evidence 999999999))))
 (is (= :scheduled (:reason (d (assoc release :security-risk :low) {} evidence 999999999))))
 (is (= :hold (:action (d release {} (assoc evidence :defer-until 999999) 100))))
 (is (= :trial-boot (:action (d release {} (assoc evidence :defer-until 999999999) 259200000)))))
(deftest deadline-never-bypasses-safety
 (doseq [k [:signature-valid? :owner-policy-current? :compatible? :fresh? :time-trusted? :rollout-admitted?]]
  (is (= :refuse (:action (d release {} (assoc evidence k false) 999999999))))
  (is (= :none (:fleet (d release {} (assoc evidence k false) 999999999)))))
 (doseq [k [:previous-preserved? :boot-recovery-qualified? :space-ok?]]
  (is (= :hold (:action (d release {} (assoc evidence k false) 999999999)))))
 (is (= :manual-review (:action (d (assoc release :apply-risk :high) {} evidence 999999999))))
 (is (= :drain (:action (d release {} (assoc evidence :drained? false) 999999999))))
 (is (= :hold (:action (d release {} (assoc evidence :owner-peers-updating 1) 999999999)))))
(deftest immutable-notice-and-expiry
 (is (= :notify (:action (d release {} (dissoc evidence :noticed-at) 1))))
 (is (= 259200000 (:deadline (d (assoc release :required-by 1) {} evidence 1))))
 (is (= :refuse (:action (d (assoc release :sequence 0) {} evidence 1))))
 (is (= :none (:action (d (assoc release :sequence 1) {} evidence 1))))
 (is (= :stage (:action (d release {} (assoc evidence :closure-verified? false) 1)))))
(deftest bounded-local-recovery
 (let [e {:local-health :unknown :elapsed-ms 1 :timeout-ms 120000 :attempts 1 :max-attempts 2}]
  (is (= :wait (:action (u/trial-decision e))))
  (is (= :rollback (:action (u/trial-decision (assoc e :elapsed-ms 120000)))))
  (is (= :rollback (:action (u/trial-decision (assoc e :local-health :fail)))))
  (is (= :commit (:action (u/trial-decision (assoc e :local-health :pass :internet? false)))))
  (is (= :refuse (:action (u/trial-decision (dissoc e :timeout-ms)))))))
