(ns grant.acoustic-onboard-test
  "What the three runtimes must agree on, pinned as literals taken from
  `test/vectors/acoustic-onboard.edn` (regenerate and cross-check with
  `node test/vectors/acoustic-onboard.mjs print|verify|webcrypto`). A test that
  rebuilt these strings with the same code under test would agree with any
  framing, including a broken one.

  Every refusal names its own reason, so a check that stops discriminating
  cannot pass by refusing for a different cause."
  (:require [grant.acoustic-onboard :as ao]
            [kotoba.bytes :as kbytes]
            [kotoba.test :refer [deftest is testing]]))

(def code "K7QX3M")
(def fp "2c3b85f8")
(def label-secret "AAECAwQFBgcICQoLDA0ODw")
(def device-key "1ekGUFKTlUnQVazwPzSCAFeOPtK2XrapZWRHF2G6T1Q")
(def profile {:ssid "Home-WiFi-5G" :security :wpa2-personal :passphrase "correct horse battery"})

(def plaintext-hex "01486f6d652d576946692d354700636f727265637420686f7273652062617474657279")
(def ephemeral-hex "4a52f593172fa3a7184e79ec52ffddcf8b6062c9a69054a606f07532e255746d")
(def ciphertext-hex "3deb7673ad933e36d654e0c43b37ec1d18187c40f19675d84c3fb967f57295bd261e283f0e6603c4115ddb37889cc0bb0f1459")
(def message-hex "574a52f593172fa3a7184e79ec52ffddcf8b6062c9a69054a606f07532e255746d3deb7673ad933e36d654e0c43b37ec1d18187c40f19675d84c3fb967f57295bd261e283f0e6603c4115ddb37889cc0bb0f1459")
(def okm-hex "3116d7df3bb5d9d3da1e9e7ebc529dc272582070c22689b22a0a10680ac75508ea27802172bbbb62a626f108")

(deftest the-beacon-is-pinned
  (is (= "mk1|K7QX3M|2c3b85f8|1ekGUFKTlUnQVazwPzSCAFeOPtK2XrapZWRHF2G6T1Q"
         (ao/beacon {:code code :fp fp :key device-key})))
  (testing "a listener gets back exactly what was sent"
    (is (= {:code code :fp fp :key device-key}
           (ao/parse-beacon (ao/beacon {:code code :fp fp :key device-key}))))))

(deftest a-beacon-with-a-bad-field-names-that-field
  (is (= {:error :bad-code} (ao/parse-beacon (str "mk1|K7QX3|" fp "|" device-key)))
      "five characters")
  (is (= {:error :bad-code} (ao/parse-beacon (str "mk1|K7QX3O|" fp "|" device-key)))
      "O is not in the alphabet; the code is read aloud")
  (is (= {:error :bad-fingerprint} (ao/parse-beacon (str "mk1|" code "|2C3B85F8|" device-key)))
      "fingerprints are lowercase hex")
  (is (= {:error :bad-device-key} (ao/parse-beacon (str "mk1|" code "|" fp "|short")))
      "too short")
  (is (= {:error :bad-device-key}
         (ao/parse-beacon (str "mk1|" code "|" fp "|" (subs device-key 0 42) "B")))
      "43 characters whose last one cannot end a 32-byte key")
  (testing "the last character of a real key: any multiple of 4, not only A Q g w"
    ;; these three come from generated X25519 keys; the first two end in k and E
    (doseq [k ["dG_QpelgxnJjSD959joCryi9zha-uPl5EQdW6_5QwEk"
               "-UbcLemQEGjZnTkV4l-Wz5LRM0pH_d6J3uWPq3P-UmE"
               "Iqax8FHUtAkL0z9dDrcG-7YfIP6oLJN54PfSOg0WngQ"]]
      (is (= {:code code :fp fp :key k} (ao/parse-beacon (str "mk1|" code "|" fp "|" k))) k))))

(deftest anything-that-is-not-a-beacon-is-not-a-beacon
  (doseq [heard ["" "hello" "mk2|K7QX3M|2c3b85f8|x" "ack|K7QX3M" nil 42
                 (str "mk1|" code "|" fp "|" device-key "|extra")]]
    (is (= {:error :not-a-beacon} (ao/parse-beacon heard)) (pr-str heard))))

(deftest the-acknowledgement-round-trips
  (is (= "ack|K7QX3M" (ao/ack code)))
  (is (= {:code code} (ao/parse-ack "ack|K7QX3M")))
  (is (= {:error :not-an-ack} (ao/parse-ack (ao/beacon {:code code :fp fp :key device-key}))))
  (is (= {:error :bad-code} (ao/parse-ack "ack|short"))))

(deftest what-hkdf-is-fed-is-pinned
  (is (= {:aad "aiueos-wifi-profile-v1-acoustic\nK7QX3M\n2c3b85f8"
          :salt "AAECAwQFBgcICQoLDA0ODw"}
         (ao/binding {:code code :fp fp :label-secret label-secret}))
      "changing this invalidates every envelope")
  (testing "the label secret is the salt and the broadcast code is not: two sessions differ only in aad"
    (is (= (:salt (ao/binding {:code code :fp fp :label-secret label-secret}))
           (:salt (ao/binding {:code "ABCDEF" :fp fp :label-secret label-secret}))))
    (is (not= (:aad (ao/binding {:code code :fp fp :label-secret label-secret}))
              (:aad (ao/binding {:code "ABCDEF" :fp fp :label-secret label-secret})))))
  (testing "a field that could forge the framing is refused, not escaped"
    (is (= {:error :bad-code} (ao/binding {:code "K7QX\n3" :fp fp :label-secret label-secret})))
    (is (= {:error :bad-fingerprint} (ao/binding {:code code :fp "2c3b85f\n" :label-secret label-secret})))
    (is (= {:error :bad-label-secret} (ao/binding {:code code :fp fp :label-secret "short"})))
    (is (= {:error :bad-label-secret} (ao/binding {:code code :fp fp :label-secret "AAECAwQFBgcICQoLDA0ODk"}))
        "22 characters ending in k: a 16-byte secret ends in one of A Q g w")))

(deftest hkdf-output-splits-into-key-and-iv
  (let [okm (kbytes/unhex okm-hex)
        parts (ao/split-okm okm)]
    (is (= 44 (count okm)))
    (is (= (kbytes/hex (subvec okm 0 32)) (kbytes/hex (:key parts))))
    (is (= "ea27802172bbbb62a626f108" (kbytes/hex (:iv parts)))
        "the last 12 bytes, pinned"))
  (is (= {:error :bad-okm-length} (ao/split-okm (vec (repeat 43 0))))))

(deftest the-plaintext-is-pinned-and-round-trips
  (is (= plaintext-hex (kbytes/hex (ao/encode-plaintext profile)))
      "security byte, SSID, NUL, passphrase")
  (is (= profile (ao/decode-plaintext (kbytes/unhex plaintext-hex))))
  (testing "an open network ends at the NUL and has no passphrase"
    (let [open {:ssid "CafeNet" :security :open}]
      (is (= (vec (concat [0] (kbytes/utf8-encode "CafeNet") [0])) (ao/encode-plaintext open)))
      (is (= open (ao/decode-plaintext (ao/encode-plaintext open))))))
  (testing "non-ASCII survives by bytes, not by characters"
    (let [p {:ssid "うちのWiFi" :security :wpa3-personal :passphrase "ぱすわーど1234"}]
      (is (= p (ao/decode-plaintext (ao/encode-plaintext p)))))))

(deftest a-profile-that-cannot-be-sent-names-why
  (is (= :ssid-length (ao/profile-problem (assoc profile :ssid ""))))
  (is (= :ssid-length (ao/profile-problem (assoc profile :ssid (apply str (repeat 33 "a"))))))
  (is (= :ssid-contains-nul (ao/profile-problem (assoc profile :ssid "a\u0000b"))))
  (is (= :passphrase-length (ao/profile-problem (assoc profile :passphrase "short"))))
  (is (= :passphrase-length (ao/profile-problem (assoc profile :passphrase (apply str (repeat 64 "a"))))))
  (is (= :passphrase-missing (ao/profile-problem (dissoc profile :passphrase))))
  (is (= :unknown-security (ao/profile-problem (assoc profile :security :wep))))
  (is (= :passphrase-on-open-network
         (ao/profile-problem {:ssid "x" :security :open :passphrase "12345678"})))
  (testing "the sound limit is on the pair, not on each field"
    (is (nil? (ao/profile-problem {:ssid (apply str (repeat 25 "a")) :security :wpa2-personal
                                   :passphrase (apply str (repeat 62 "b"))}))
        "25 + 1 + 62 = 88 bytes fits")
    (is (= :too-long-for-sound
           (ao/profile-problem {:ssid (apply str (repeat 26 "a")) :security :wpa2-personal
                                :passphrase (apply str (repeat 62 "b"))}))
        "89 bytes does not")))

(deftest a-box-does-not-apply-what-it-would-not-have-accepted
  (is (= {:error :unknown-security} (ao/decode-plaintext [9 65 0 66])))
  (is (= {:error :malformed-plaintext} (ao/decode-plaintext [1 65 66])) "no NUL")
  (is (= {:error :malformed-plaintext} (ao/decode-plaintext [1])))
  (is (= {:error :not-utf8} (ao/decode-plaintext [1 0xff 0 0x31 0x32 0x33 0x34 0x35 0x36 0x37 0x38])))
  (is (= {:error :passphrase-length}
         (ao/decode-plaintext (vec (concat [1] (kbytes/utf8-encode "ssid") [0] (kbytes/utf8-encode "short")))))))

(deftest the-message-is-pinned
  (let [message (ao/frame {:ephemeral-public-key (kbytes/unhex ephemeral-hex)
                           :ciphertext (kbytes/unhex ciphertext-hex)})]
    (is (= message-hex (kbytes/hex message)))
    (is (= 84 (count message)))
    (is (= 0x57 (first message))))
  (testing "parsing gives back the two halves"
    (let [parsed (ao/parse-frame (kbytes/unhex message-hex))]
      (is (= ephemeral-hex (kbytes/hex (:ephemeral-public-key parsed))))
      (is (= ciphertext-hex (kbytes/hex (:ciphertext parsed)))))))

(deftest a-frame-that-does-not-fit-or-is-not-one-is-refused
  (is (= {:error :not-a-profile} (ao/parse-frame (kbytes/utf8-encode (ao/beacon {:code code :fp fp :key device-key}))))
      "its own beacon heard back from the speaker")
  (is (= {:error :not-a-profile} (ao/parse-frame [])))
  (is (= {:error :not-a-profile} (ao/parse-frame (vec (cons 0x57 (repeat 40 1))))) "too short")
  (is (= {:error :bad-ephemeral-key-length}
         (ao/frame {:ephemeral-public-key (vec (repeat 31 0)) :ciphertext (vec (repeat 20 0))})))
  (is (= {:error :ciphertext-too-short}
         (ao/frame {:ephemeral-public-key (vec (repeat 32 0)) :ciphertext (vec (repeat 16 0))}))
      "a tag with no plaintext")
  (testing "the largest legal profile still fits ggwave's 140 bytes"
    (let [max-profile {:ssid (apply str (repeat 25 "a")) :security :wpa2-personal
                       :passphrase (apply str (repeat 62 "b"))}
          pt (ao/encode-plaintext max-profile)
          ;; AES-GCM: plaintext length + 16-byte tag
          message (ao/frame {:ephemeral-public-key (vec (repeat 32 0))
                             :ciphertext (vec (repeat (+ (count pt) 16) 0))})]
      (is (= 138 (count message)))
      (is (<= (count message) ao/max-message-bytes))))
  (is (= {:error :too-long-for-sound}
         (ao/frame {:ephemeral-public-key (vec (repeat 32 0)) :ciphertext (vec (repeat 108 0))}))
      "141 bytes"))
