;; What "what time is it" means on a machine that may not have a clock.
;;
;; Freshness is two questions wearing one name. Rejecting needs only a lower
;; bound, which every machine has (its own image was built at some instant, and
;; time does not run backwards). Accepting needs a reading. So decide-freshness
;; has three answers and :undecidable is never folded into either of the others.
[{:db/id -1
  :aiueos.clock/id :aiueos/default-clock
  :aiueos.clock/source-files ["src/grant/clock.cljk"]
  :aiueos.clock/sources [:signed :rtc :build-stamp :none]
  :aiueos.clock/readings #{:signed :rtc}
  :aiueos.clock/confidences #{:signed :rtc :lower-bound :none}
  :aiueos.clock/freshness-answers #{:fresh :stale :undecidable}
  :aiueos.clock/reject-needs :lower-bound
  :aiueos.clock/accept-needs :reading
  :aiueos.clock/reading-below-bound-is-rejected? true
  :aiueos.clock/anchor-requires-a-reading? true
  :aiueos.clock/consumers ["src/grant/publisher.cljk"]
  :aiueos.clock/assurance-gaps
  ["An RTC is a real reading and an attacker with physical access can set it.
    It is ranked below a signed timestamp for that reason, and a reading below
    the image build stamp is refused outright rather than believed."
   "Nothing here obtains a time. Reading an RTC, fetching a signed timestamp
    and sampling the monotonic timer are provider mechanism."]}]
