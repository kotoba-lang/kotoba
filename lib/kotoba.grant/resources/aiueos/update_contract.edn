;; What "update it without taking the customer down" means, as checkable data.
;;
;; Three classes, because what can be swapped live depends on what changed.
;; Only :ab-reboot costs a reboot, and it is gated on idleness, a maintenance
;; window, or explicit consent -- never on "probably fine".
[{:db/id -1
  :aiueos.update/id :aiueos/default-update
  :aiueos.update/source-files ["src/grant/update.cljk"]
  :aiueos.update/artifact-kinds [:component :guest :kernel :loader]
  :aiueos.update/kind->class "{:component :live, :guest :blue-green, :kernel :ab-reboot, :loader :ab-reboot}"
  :aiueos.update/classes #{:live :blue-green :ab-reboot}
  :aiueos.update/steps [:idle :fetched :staged :probing :committed]
  :aiueos.update/terminal #{:rolled-back :refused}
  :aiueos.update/health-values #{:pass :fail :unknown}
  :aiueos.update/decision-shapes #{:grant :deny}
  :aiueos.update/deny-reasons #{:unknown-artifact-kind :not-admitted-by-publisher
                                :no-previous-version-preserved :health-unknown
                                :health-failed :machine-busy :outside-maintenance-window
                                :consent-required :peer-updating
                                :rollback-window-too-small :bad-step}
  :aiueos.update/previous-preserved-until :committed
  :aiueos.update/unanswered-probe-is-failure? true
  :aiueos.update/assurance-gaps
  ["A kernel or loader change costs one reboot. Service continuity for that
    class comes from draining fleet work to other nodes, not from avoiding the
    reboot; live kernel patching is explicitly not a goal."
   "The mechanism keeps exactly one previous version (:rollback-window 1).
    Staged rollout across more than one prior version needs the bare-metal
    catalog bound (capacity 4 / 12 KiB per app / rollback-window 1) to move
    first -- see root ADR-2608012050 section 4."]}]
