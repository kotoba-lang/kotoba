;; What "power it on, scan the label, and it is yours" means, as checkable data.
;;
;; The QR on the label is static and photographable, so nothing it carries is a
;; secret. What bounds a claim is the state the device is in when the token is
;; presented -- see the aiueos.enroll docstring.
[{:db/id -1
  :aiueos.enroll/id :aiueos/default-enroll
  :aiueos.enroll/source-files ["src/grant/enroll.cljk"]
  :aiueos.enroll/states #{:factory :claimed :released}
  :aiueos.enroll/transitions "{:factory #{:claimed}, :claimed #{:released}, :released #{:factory}}"
  :aiueos.enroll/qr-scheme "aiueos"
  :aiueos.enroll/qr-version 1
  :aiueos.enroll/qr-required-fields [:did :model :endpoint :token]
  :aiueos.enroll/qr-carries-no-secret? true
  :aiueos.enroll/trust-grades #{:attested :tofu}
  :aiueos.enroll/decision-shapes #{:grant :deny}
  :aiueos.enroll/deny-reasons #{:not-in-factory-state :token-mismatch :window-expired
                                :no-proof-of-possession :device-did-mismatch
                                :attestation-required :attestation-invalid
                                :already-claimed :owner-missing}
  :aiueos.enroll/rebind-evidence #{:owner-signature :physical-reset}
  :aiueos.enroll/key-generated-on-device? true
  :aiueos.enroll/private-key-leaves-device? false
  :aiueos.enroll/assurance-gaps
  ["No sealed key storage is assumed: the operational private key is held by
    whatever the storage provider offers. A TPM/secure-element binding is not
    modelled here and a device whose disk is removed loses this property."
   "Attestation is optional by default, so a fleet without a factory
    provisioning station enrols at :tofu. The verdict says which grade was
    reached; it does not make them equivalent."]}]
