;; The grant plane: who may do what, decided as pure data.
;;
;; Deliberately narrower than the repository it came out of. There is no Wasm
;; runtime here and no engine dependency of any kind -- `aiueos.execute`'s
;; Chicory dependency stayed with the machine, because deciding whether a
;; component may run is not the same act as running it (root ADR-2608219500).
;;
;; `security` supplies redaction / ABAC / crypto-policy / hardware predicates;
;; `abi` supplies the shared component contract. Nothing else is needed, and
;; adding an engine here would put the decision plane behind one.
{:paths ["src" "resources"]
 :deps {
        io.github.kotoba-lang/artifact {:local/root "../kotoba.artifact"}
        io.github.kotoba-lang/kotoba-core-contracts
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "b94158fd48ec541b70d3c455912a06f407537ddc"
         :deps/root "lib/kotoba.kotobaCoreContracts"}
        io.github.kotoba-lang/error {:local/root "../kotoba.error"}
        io.github.kotoba-lang/bytes {:local/root "../kotoba.bytes"}
        io.github.kotoba-lang/io {:local/root "../kotoba.io"}
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}
        io.github.kotoba-lang/security {:local/root "../kotoba.security"}
        io.github.kotoba-lang/abi
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "b94158fd48ec541b70d3c455912a06f407537ddc"
         :deps/root "lib/kotoba.abi"}
        io.github.kotoba-lang/authority {:local/root "../kotoba.authority"}
        io.github.kotoba-lang/identity {:local/root "../kotoba.identity"}
        io.github.kotoba-lang/org-biscuitsec {:local/root "../org.biscuitsec.biscuit"}
        io.github.kotoba-lang/coll {:local/root "../kotoba.coll"}
        io.github.kotoba-lang/edn {:local/root "../kotoba.edn"}}
 :aliases
 {:test {:extra-paths ["test"]}}}
