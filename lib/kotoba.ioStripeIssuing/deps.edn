{:paths ["src"]
 ;; The contract this implements lives in kotoba-lang/card. Named by git
 ;; coordinate, not :local/root -- a provider that cannot be consumed from outside
 ;; a monorepo checkout is not a provider (measured across this family 2026-07-30).
 ;; JVM-only provider: java.net.http for the transport, data.json to read
 ;; Stripe's responses. The contract library it implements is portable .cljc; this
 ;; provider is not, and does not pretend to be.
 :deps {
        io.github.kotoba-lang/http-parse-url {:local/root "../kotoba.http"}
        io.github.kotoba-lang/pprint {:local/root "../kotoba.pprint"}
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}
        io.github.kotoba-lang/json {:local/root "../kotoba.json"}
        io.github.kotoba-lang/card {:local/root "../kotoba.card"}}
 :aliases
 {;; kbb -M:exercise -- run the write paths against Stripe TEST MODE once.
  ;; Needs STRIPE_TEST_KEY (sk_test_…). It cannot touch live: the mode check refuses a
  ;; key whose own prefix disagrees, before any request is built.
  :exercise {:main-opts ["-m" "io.stripe.issuing.exercise"]}
  :dev {:override-deps
        {io.github.kotoba-lang/card {:local/root "../card"}}}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}
                      ;; TEST-ONLY. Parity compiles the two-module graph
                      ;; kotoba/io/stripe/issuing/state.{kotoba,cljk} +
                      ;; kotoba.card.lifecycle to KIR and runs it against
                      ;; io.stripe.issuing.state. Nothing in :paths depends on
                      ;; either; `:test-pure` runs the .cljc suites without them.
                      ;; Pins are the west pair and advance together.
                      io.github.kotoba-lang/amu
                      {:git/url "https://github.com/kotoba-lang/amu.git"
                       :git/sha "3ef1a709f01a672b451981de42022158fe23d1e5"}
                      io.github.kotoba-lang/osaho
                      {:git/url "https://github.com/kotoba-lang/osaho.git"
                       :git/sha "8085b60354041752aaab7a7d0f131eab94c9d44a"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}

  ;; The .cljc suites alone, with no compiler dependency.
  ;;
  ;; A NAMESPACE regex, not `-e :kotoba-parity`: the runner LOADS every test
  ;; namespace before filtering by var metadata, so excluding the parity vars
  ;; still requires `kotoba.compiler.core` on the classpath. The negative
  ;; lookahead keeps new pure suites in automatically -- naming them one by one is
  ;; the drift this repository's own tests warn about.
  :test-pure
  {:extra-paths ["test"]
   :extra-deps {io.github.cognitect-labs/test-runner
                {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
   :main-opts ["-m" "cognitect.test-runner"
               "-r" "^(?!.*kotoba-parity).*-test$"]}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
