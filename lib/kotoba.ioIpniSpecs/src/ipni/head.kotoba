(ns ipni.head
  ;; Kotoba port of the portable core of `ipni.head`'s `signed-head` -- the
  ;; publisher's current advertisement-chain tip served at `GET /ipni/v1/head`.
  ;;
  ;; The original takes `{:ad-cid ... :sign-fn ...}` where `sign-fn` is an
  ;; INJECTED function (the namespace owns no key). Kotoba has no first-class
  ;; function values -- a capability kit handles effects at the host boundary,
  ;; and a plain module cannot admit a callback -- so the port takes the
  ;; signature the signer produced as a plain `:string` value. On this side the
  ;; `ifn?`/`sign-fn-required` clause is unrepresentable: a `:string` parameter
  ;; is always present and always a function-shaped value, so typed admission
  ;; plays the role the `ifn?` check played. That gap is disclosed, not hidden.
  ;;
  ;; What IS ported, and what the parity test pins: the ad-cid validation (the
  ;; original checks `(string? ad-cid)` and answers
  ;; `{:error :invalid-ad-cid :value ad-cid}`), and the success record
  ;; `{:schema :ipni.signed-head :ad-cid ... :signature ...}`. `ad-cid`
  ;; arrives as a `:document` precisely so the string-kind check is a real
  ;; branch, not vacuous: a CID that is not a string reaches this branch the
  ;; way a malformed map reached the original's `(string? ...)` clause.
  (:export [signed-head]))

(defn signed-head [ad-cid :document signature :string] :document
  (cond
    (not (= (document-kind ad-cid) :string))
    (document-map :error (document-keyword :invalid-ad-cid)
                  :value ad-cid)
    :else
    (document-map :schema (document-keyword :ipni.signed-head)
                  :ad-cid ad-cid
                  :signature (document-string signature))))
