(ns ipni.hamt
  "Parity port of ipni.hamt (see ADR-2608261100). HAMT-as-set is an
   alternative encoding of advertisement Entries (ipni/specs IPNI.md).
   It is specified. It is not implemented here.

   A missing implementation must not look like an empty set. Callers that
   need a HAMT get `:not-yet-implemented`, not `{:ok? true :entries []}`.

   The Clojure original returns `{:ok? false :error :not-yet-implemented
   :encoding :hamt-as-set}`. The js-browser subset rejected the literal
   keyword-valued map (`:kotoba.error/subset-reject`, \"expected i64, got
   keyword\") and both `:record`-typed function returns and keyword-typed
   record fields (`:kotoba.error/value-type-outside-profile`), so the
   result is carried as a `:document` with the same three fields, the two
   discriminants as strings."
  (:export [as-set]))

(defn as-set [multihashes :document] :document
  (document-map :ok? (document-bool false)
                :error (document-string "not-yet-implemented")
                :encoding (document-string "hamt-as-set")))
