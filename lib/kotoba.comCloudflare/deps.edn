{:paths ["src" "resources"]
 :deps {
        io.github.kotoba-lang/bytes {:local/root "../kotoba.bytes"}
        io.github.kotoba-lang/io {:local/root "../kotoba.io"}
        io.github.kotoba-lang/pprint {:local/root "../kotoba.pprint"}
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}
        io.github.kotoba-lang/json {:local/root "../kotoba.json"}
        io.github.kotoba-lang/osaho
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "b94158fd48ec541b70d3c455912a06f407537ddc"
         :deps/root "lib/kotoba.osaho"}}
 :aliases
 {:test {:extra-paths ["test"]
         ;; kotoba-lang/amu is TEST-ONLY for the W6 pure-request oracle
         ;; parity gate + product-shell artifact gen. Override abi to the pin
         ;; compiler expects so component/wit loads cleanly in the test JVM.
         :override-deps
         {io.github.kotoba-lang/abi
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "b94158fd48ec541b70d3c455912a06f407537ddc"
         :deps/root "lib/kotoba.abi"}}
         ;; kotoba-lang/edn is TEST-ONLY too: `kotoba-oracle-gen` lives under
         ;; test/ and post-processes its pprint output through
         ;; `escape-controls`, so the KIR artefacts cannot be written with raw
         ;; control bytes. Both aliases that put test/ on the path need it.
         :extra-deps {io.github.kotoba-lang/edn
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "b94158fd48ec541b70d3c455912a06f407537ddc"
         :deps/root "lib/kotoba.edn"}
                      io.github.kotoba-lang/amu
                      {:git/url "https://github.com/kotoba-lang/amu.git"
                       :git/sha "b0095427fdc1b52153b285e6443591f2196c20a6"}}}

  ;; Regenerate product-shell KIR (does not run test-runner).
  :oracle-gen {:extra-paths ["test"]
               :override-deps
               {io.github.kotoba-lang/abi
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "b94158fd48ec541b70d3c455912a06f407537ddc"
         :deps/root "lib/kotoba.abi"}}
               :extra-deps {io.github.kotoba-lang/edn
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "b94158fd48ec541b70d3c455912a06f407537ddc"
         :deps/root "lib/kotoba.edn"}
                            io.github.kotoba-lang/amu
                            {:git/url "https://github.com/kotoba-lang/amu.git"
                             :git/sha "b0095427fdc1b52153b285e6443591f2196c20a6"}}
               :main-opts ["-m" "cloudflare.kotoba-oracle-gen"]}

}}
