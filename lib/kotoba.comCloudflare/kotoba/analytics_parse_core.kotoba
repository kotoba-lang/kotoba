(ns analytics-parse-core
  (:schemas {;; T5.2 native guest record: multi-arg pure → single record
             :parse/pair [:record :parse/pair [[:a :i64] [:b :i64]]]
             :parse/triple [:record :parse/triple [[:a :i64] [:b :i64] [:c :i64]]]
             :parse/quad [:record :parse/quad
                          [[:a :i64] [:b :i64] [:c :i64] [:d :i64]]]
             :parse/str-get [:record :parse/str-get
                             [[:m [:map :string :i64]] [:k :string]]]
             :parse/str-add [:record :parse/str-add
                             [[:m [:map :string :i64]] [:k :string] [:n :i64]]]
             :parse/i64-get [:record :parse/i64-get
                             [[:m [:map :i64 :i64]] [:k :i64]]]
             :parse/i64-add [:record :parse/i64-add
                             [[:m [:map :i64 :i64]] [:k :i64] [:n :i64]]]})
  (:export [empty-string-tally empty-i64-tally
            string-tally-get string-tally-add
            i64-tally-get i64-tally-add
            sum2 sum3 sum4
            report-ok?]))

;; W6 analytics parse oracle — tally/sum core of cloudflare.analytics parse-*.
;; Host projects response rows (JSON→fields); guest folds tallies + totals.
;; Full path-report-rows vector assembly and GraphQL transport stay cljc.
;; T5.2: multi-arg pure folded into single guest records.
;; Parity: test/cloudflare/analytics_parse_kotoba_parity_test.cljk

(defn empty-string-tally [] [:map :string :i64]
  (typed-map-new [:map :string :i64]))

(defn empty-i64-tally [] [:map :i64 :i64]
  (typed-map-new [:map :i64 :i64]))

(defn string-tally-get [x [:ref :parse/str-get]] :i64
  ;; T5.2: m+k on one guest record
  (let [m (record-get x :m)
        k (record-get x :k)]
    (match-option (typed-map-get [:map :string :i64] m k)
      [:option :i64]
      (none 0)
      (some v v))))

(defn string-tally-add [x [:ref :parse/str-add]] [:map :string :i64]
  ;; cljc: (update acc k (fnil + 0) count)
  ;; T5.2: m+k+n on one guest record
  (let [m (record-get x :m)
        k (record-get x :k)
        n (record-get x :n)]
    (typed-map-assoc [:map :string :i64] m k
                     (+ (string-tally-get (record-new [:ref :parse/str-get] m k)) n))))

(defn i64-tally-get [x [:ref :parse/i64-get]] :i64
  ;; T5.2: m+k on one guest record
  (let [m (record-get x :m)
        k (record-get x :k)]
    (match-option (typed-map-get [:map :i64 :i64] m k)
      [:option :i64]
      (none 0)
      (some v v))))

(defn i64-tally-add [x [:ref :parse/i64-add]] [:map :i64 :i64]
  (let [m (record-get x :m)
        k (record-get x :k)
        n (record-get x :n)]
    (typed-map-assoc [:map :i64 :i64] m k
                     (+ (i64-tally-get (record-new [:ref :parse/i64-get] m k)) n))))

(defn sum2 [p [:ref :parse/pair]] :i64
  ;; T5.2: a+b on one guest record
  (+ (record-get p :a) (record-get p :b)))

(defn sum3 [t [:ref :parse/triple]] :i64
  (+ (record-get t :a) (+ (record-get t :b) (record-get t :c))))

(defn sum4 [q [:ref :parse/quad]] :i64
  (+ (record-get q :a)
     (+ (record-get q :b) (+ (record-get q :c) (record-get q :d)))))

(defn report-ok? [has-errors :i64] :i64
  ;; cljc: (if-let [errors (seq (:errors response))] false …) → host projects 0/1
  (if (= has-errors 1) 0 1))
