(ns zones-path-core
  (:schemas {;; T5.2 native guest record: multi-arg pure → single record
             :zones/kv [:record :zones/kv [[:k :string] [:v :string]]]
             :zones/path-qs [:record :zones/path-qs
                             [[:path :string] [:qs :string]]]
             :zones/zone-name [:record :zones/zone-name
                               [[:zone-id :string] [:name :string]]]
             :zones/match [:record :zones/match
                           [[:expected :string] [:actual :string]]]})
  (:export [list-zones-path list-zones-per-page list-zones-query list-zones-request-path
            dns-records-path dns-name-query-pair dns-records-path-with-name
            query-pair with-query hostname-matches?]))

;; W6 cloudflare-pure-request-v1 — zones query strings + hostname match
;; for zone-by-name / custom-domains / pages domain discovery.
;; Base workers/zones/pages path strings: kotoba/workers_path_core.kotoba.
;; HTTP rest! / getenv stay host.
;; Parity: test/cloudflare/zones_path_kotoba_parity_test.cljk

(defn list-zones-path [] :string
  "/zones")

(defn list-zones-per-page [] :string
  ;; cljc list-zones: hard-coded per_page=50
  "50")

(defn query-pair [x [:ref :zones/kv]] :string
  ;; client/rest! builds (str (name k) "=" v)
  ;; T5.2: k+v on one guest record
  (string-concat (record-get x :k) (string-concat "=" (record-get x :v))))

(defn with-query [x [:ref :zones/path-qs]] :string
  ;; T5.2: path+qs on one guest record
  (let [path (record-get x :path)
        qs (record-get x :qs)]
    (if (string=? qs "")
      path
      (string-concat path (string-concat "?" qs)))))

(defn list-zones-query [] :string
  (query-pair (record-new [:ref :zones/kv] "per_page" (list-zones-per-page))))

(defn list-zones-request-path [] :string
  ;; exact path string zones/list-zones passes to client/rest!
  (with-query (record-new [:ref :zones/path-qs]
                          (list-zones-path)
                          (list-zones-query))))

(defn dns-records-path [zone-id :string] :string
  (string-concat "/zones/" (string-concat zone-id "/dns_records")))

(defn dns-name-query-pair [name :string] :string
  ;; zones/dns-records :query {:name name}
  (query-pair (record-new [:ref :zones/kv] "name" name)))

(defn dns-records-path-with-name [x [:ref :zones/zone-name]] :string
  ;; T5.2: zone-id+name on one guest record
  (with-query (record-new [:ref :zones/path-qs]
                          (dns-records-path (record-get x :zone-id))
                          (dns-name-query-pair (record-get x :name)))))

(defn hostname-matches? [x [:ref :zones/match]] :i64
  ;; zone-by-name: (= name (:name zone))
  ;; workers/custom-domains filter: (= hostname (:hostname binding))
  ;; pages/project-by-domain: (some #{domain} (:domains project))
  ;; T5.2: expected+actual on one guest record
  (if (string=? (record-get x :expected) (record-get x :actual)) 1 0))
