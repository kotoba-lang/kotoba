(ns analytics-core
  (:export [daily-query path-query path-query-declares-host? path-query-filters-host?]))

;; W6 cloudflare-pure-request-v1 — GraphQL query text core of cloudflare.analytics.
;; Tally/sum folds: kotoba/analytics_parse_core.kotoba (ADR 0009).
;; JSON row projection + *! / iso-date clocks stay host.
;; Parity: test/cloudflare/analytics_kotoba_parity_test.cljk

(defn daily-query [] :string
  "query DailyTraffic($zoneTag: String!, $since: String!, $until: String!) { viewer { zones(filter: {zoneTag: $zoneTag}) { httpRequests1dGroups(limit: 31, filter: {date_geq: $since, date_leq: $until}) { sum { requests pageViews bytes } uniq { uniques } dimensions { date } } } } }")

(defn path-query [host? :i64] :string
  ;; host? 1 = declare $host + clientRequestHTTPHost filter (cljc some? host)
  (if (= host? 1)
    "query PathTraffic($zoneTag: String!, $since: Time!, $until: Time!, $host: String!) { viewer { zones(filter: {zoneTag: $zoneTag}) { httpRequestsAdaptiveGroups(limit: 100, filter: {datetime_geq: $since, datetime_leq: $until, clientRequestHTTPHost: $host}) { count dimensions { clientRequestPath clientDeviceType clientCountryName edgeResponseStatus } } } } }"
    "query PathTraffic($zoneTag: String!, $since: Time!, $until: Time!) { viewer { zones(filter: {zoneTag: $zoneTag}) { httpRequestsAdaptiveGroups(limit: 100, filter: {datetime_geq: $since, datetime_leq: $until}) { count dimensions { clientRequestPath clientDeviceType clientCountryName edgeResponseStatus } } } } }"))

(defn path-query-declares-host? [host? :i64] :i64
  (if (string-contains? (path-query host?) "$host: String!") 1 0))

(defn path-query-filters-host? [host? :i64] :i64
  (if (string-contains? (path-query host?) "clientRequestHTTPHost: $host") 1 0))
