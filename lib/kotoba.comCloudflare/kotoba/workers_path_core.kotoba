(ns workers-path-core
  (:export [zone-routes-path custom-domains-path scripts-path
            list-zones-path dns-records-path pages-projects-path]))

;; W6 cloudflare-pure-request-v1 — pure REST path construction for
;; workers / zones / pages product surfaces (no HTTP).
;; Parity: test/cloudflare/workers_path_kotoba_parity_test.cljk

(defn zone-routes-path [zone-id :string] :string
  (string-concat "/zones/" (string-concat zone-id "/workers/routes")))

(defn custom-domains-path [account-id :string] :string
  (string-concat "/accounts/" (string-concat account-id "/workers/domains")))

(defn scripts-path [account-id :string] :string
  (string-concat "/accounts/" (string-concat account-id "/workers/scripts")))

(defn list-zones-path [] :string
  "/zones")

(defn dns-records-path [zone-id :string] :string
  (string-concat "/zones/" (string-concat zone-id "/dns_records")))

(defn pages-projects-path [account-id :string] :string
  (string-concat "/accounts/" (string-concat account-id "/pages/projects")))
