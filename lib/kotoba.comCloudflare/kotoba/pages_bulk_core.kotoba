(ns pages-bulk-core
  (:schemas {;; T5.2 native guest record: multi-arg pure → single record
             :pages/account-project [:record :pages/account-project
                                     [[:account-id :string] [:project-name :string]]]
             :pages/ends-with [:record :pages/ends-with
                               [[:s :string] [:suffix :string]]]
             :pages/hash-known [:record :pages/hash-known
                                [[:hash :string] [:known0 :string] [:known1 :string]]]})
  (:export [max-pages-assets max-asset-path max-asset-bytes
            blank? ws? asset-char? asset-body-ok?
            validate-asset-path
            pages-upload-token-suffix pages-upload-token-path
            content-type-for-path
            missing-hash? hash-known?
            post-method get-method
            upload-assets-path]))

;; W6 Pages bulk Direct Upload oracle — pure path/hash helpers from
;; cloudflare.deploy (ADR 0007). Manifest assembly / base64 / *! HTTP stay cljc.
;; validate-asset-path: empty string ≡ cljc nil (ok); else bare error tag.
;; Parity: test/cloudflare/pages_bulk_kotoba_parity_test.cljk

(defn max-pages-assets [] :i64 512)
(defn max-asset-path [] :i64 512)
(defn max-asset-bytes [] :i64 2097152)

(defn ws? [c :string] :i64
  (if (string=? c " ")
    1
    (if (string=? c "\n")
      1
      (if (string=? c "\t")
        1
        (if (string=? c "\r") 1 0)))))

(defn blank? [s :string] :i64
  (let [n (string-byte-length s)]
    (if (= n 0)
      1
      (if (= (ws? (string-substring s 0 1)) 1)
        (blank? (string-substring s 1 n))
        0))))

(defn asset-char? [c :string] :i64
  ;; first char: [A-Za-z0-9]; rest also _./@+-
  (if (string-contains? "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_./@+-" c)
    1 0))

(defn asset-first-char? [c :string] :i64
  (if (string-contains? "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789" c)
    1 0))

(defn asset-body-ok? [s :string] :i64
  (let [n (string-byte-length s)]
    (if (= n 0)
      1
      (if (= (asset-char? (string-substring s 0 1)) 1)
        (asset-body-ok? (string-substring s 1 n))
        0))))

(defn contains-dotdot? [s :string] :i64
  (let [n (string-byte-length s)]
    (if (< n 2)
      0
      (if (string=? (string-substring s 0 2) "..")
        1
        (contains-dotdot? (string-substring s 1 n))))))

(defn contains-backslash? [s :string] :i64
  (let [n (string-byte-length s)]
    (if (= n 0)
      0
      (if (string=? (string-substring s 0 1) "\\")
        1
        (contains-backslash? (string-substring s 1 n))))))

(defn contains-nul? [s :string] :i64
  (let [n (string-byte-length s)]
    (if (= n 0)
      0
      (if (string=? (string-substring s 0 1) "\0")
        1
        (contains-nul? (string-substring s 1 n))))))

(defn validate-asset-path [rel :string] :string
  ;; mirrors cloudflare.deploy/validate-asset-path error keywords (bare tags)
  (if (= (blank? rel) 1)
    "empty-asset-path"
    (if (< (max-asset-path) (string-byte-length rel))
      "asset-path-too-long"
      (if (= (contains-nul? rel) 1)
        "null-byte"
        (if (= (contains-backslash? rel) 1)
          "backslash"
          (if (string=? (string-substring rel 0 1) "/")
            "absolute-asset"
            (if (string=? (string-substring rel 0 1) "~")
              "home-escape"
              (if (= (contains-dotdot? rel) 1)
                "asset-escape"
                (if (= (asset-first-char? (string-substring rel 0 1)) 0)
                  "bad-asset-path"
                  (if (= (asset-body-ok? (string-substring rel 1 (string-byte-length rel))) 1)
                    ""
                    "bad-asset-path"))))))))))

(defn pages-upload-token-suffix [] :string "/upload-token")

(defn pages-upload-token-path [x [:ref :pages/account-project]] :string
  ;; T5.2: account-id+project-name on one guest record
  (string-concat
   (string-concat
    (string-concat "/accounts/" (record-get x :account-id))
    (string-concat "/pages/projects/" (record-get x :project-name)))
   (pages-upload-token-suffix)))

(defn ends-with? [x [:ref :pages/ends-with]] :i64
  ;; T5.2: s+suffix on one guest record
  (let [s (record-get x :s)
        suffix (record-get x :suffix)
        n (string-byte-length s)
        m (string-byte-length suffix)]
    (if (< n m)
      0
      (if (string=? (string-substring s (- n m) n) suffix)
        1 0))))

(defn content-type-for-path [path :string] :string
  ;; pages-bulk-deploy-plan extension map
  (if (= (ends-with? (record-new [:ref :pages/ends-with] path ".html")) 1)
    "text/html"
    (if (= (ends-with? (record-new [:ref :pages/ends-with] path ".css")) 1)
      "text/css"
      (if (= (ends-with? (record-new [:ref :pages/ends-with] path ".js")) 1)
        "application/javascript"
        (if (= (ends-with? (record-new [:ref :pages/ends-with] path ".json")) 1)
          "application/json"
          (if (= (ends-with? (record-new [:ref :pages/ends-with] path ".svg")) 1)
            "image/svg+xml"
            "application/octet-stream"))))))

(defn get-method [] :string "get")
(defn post-method [] :string "post")
(defn upload-assets-path [] :string "/pages/assets/upload")

(defn hash-known? [x [:ref :pages/hash-known]] :i64
  ;; bit-pack free: host passes up to 2 known hashes for membership probe
  ;; T5.2: hash+known0+known1 on one guest record
  (let [hash (record-get x :hash)
        known0 (record-get x :known0)
        known1 (record-get x :known1)]
    (if (string=? hash known0)
      1
      (if (string=? hash known1) 1 0))))

(defn missing-hash? [x [:ref :pages/hash-known]] :i64
  (if (= (hash-known? x) 1) 0 1))
