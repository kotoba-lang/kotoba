;; tenken-policy — 設定制約の宣言面 (.cljc)
;;
;; 規則 (ADR-2809151400):
;; - policy は EDN データで宣言する。規則が禁止するとき、規則の literal を名指す。
;; - 譲れない不変条件は :fail-closed true。
;; - :nature は :property (性質。理由が規則の中で閉じている) か
;;   :implementation-state (実装状態。測ってから従う) を必ず持つ (ADR-2809041200)。
(ns tenken.policy
  (:require [clojure.string :as str]))

;; 禁止 binding キー (awai checker 実測の 3 形: jsonc キー / toml キー / toml 配列テーブル)
(def state-store-keys
  #{:d1_databases :durable_objects :kv_namespaces})

(def state-store-key-prefixes
  "toml 配列テーブルのドット付き形 ([[durable_objects.bindings]] 等)。
   完全一致キーに加え、この prefix で始まるキーも違反とする。"
  ["d1_databases." "durable_objects." "kv_namespaces."])

(defn- has-state-store-binding?
  [data]
  (or (boolean (some (fn [k] (contains? data k)) state-store-keys))
      (boolean (some (fn [kk] (some (fn [k] (str/starts-with? (name k) kk)) (keys data)))
                     state-store-key-prefixes))))

;; policy 1 件 = {:tenken.policy/id
;;               :tenken.policy/description
;;               :tenken.policy/nature :property|:implementation-state
;;               :tenken.policy/fail-closed true
;;               :tenken.policy/scope {:org-prefix "orgs/network-awai" 等の集合}
;;               :tenken.policy/predicate (fn [config] → {:tenken/verdict ... :tenken/reason ...})}
(def awai-no-single-vendor-state
  {:tenken.policy/id "awai-no-single-vendor-state"
   :tenken.policy/description "D1 / Durable Object / Workers KV binding は禁止 (ADR-2609132007、awai network 全域)"
   :tenken.policy/nature :property
   :tenken.policy/fail-closed true
   :tenken.policy/scope {:path-prefix "orgs/network-awai/"}
   :tenken.policy/predicate
   (fn [config]
     (let [data (:tenken/data config)
           status (:tenken/status config)]
       (cond
         (= status :unreadable)
         {:tenken/verdict :UNVERIFIED
          :tenken/reason "config unreadable"
          :tenken/rule "fail-closed: 読めない設定は緑にしない"}
         (map? data)
         (let [hit (seq (filter (fn [k] (contains? data k)) state-store-keys))
               hit-prefix (when-not hit
                            (seq (for [kk state-store-key-prefixes
                                       k (keys data)
                                       :when (str/starts-with? (name k) kk)]
                                   k)))]
           (cond
             hit
             {:tenken/verdict :VIOLATED
              :tenken/rule "d1_databases / durable_objects / kv_namespaces は禁止"
              :tenken/reason (str "binding keys present: " (pr-str (vec hit)))}
             hit-prefix
             {:tenken/verdict :VIOLATED
              :tenken/rule "d1_databases / durable_objects / kv_namespaces は禁止"
              :tenken/reason (str "binding table keys present: " (pr-str (vec hit-prefix)))}
             :else
             {:tenken/verdict :SATISFIED
              :tenken/rule "d1_databases / durable_objects / kv_namespaces は禁止"
              :tenken/reason "no state-store binding present"}))
         :else
         {:tenken/verdict :UNVERIFIED
          :tenken/reason "config data is not a map"
          :tenken/rule "fail-closed: 未知 shape は nil にしない"})))})

(def all-policies
  "現在地: awai state-store policy の 1 種。検査の 8 問: 0 件走査は緑にしない。"
  [awai-no-single-vendor-state])
