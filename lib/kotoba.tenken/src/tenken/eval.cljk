#!/usr/bin/env kbb
;; tenken-eval — 実測 wrangler 設定 × policy の宣言的評価 (ADR-2809151400)
;;
;; 使い方:
;;   kbb --backend sci --classpath src <this-file> --root <superproject-root> [--policy awai-no-single-vendor-state]
;;
;; 検査の 8 問 (repo-wide mandatory) をこの出力に直接載せる:
;; - SCANNED<TAB>n を必ず出す (0 件を clean と読ませない → 0 件は FAIL)
;; - 読めない設定 / parse 失敗は FAIL (:unreadable は緑にしない)
;; - VIOLATION 行は規則の literal を名指す
;; - exit 0 = 合格 / 1 = 違反または検査不能 / 2 = 使用方法誤り
;;
;; 出力:
;;   SCANNED<TAB>n
;;   VIOLATED<TAB><path>...<reason>
;;   UNVERIFIED<TAB><path>...<reason>
;;   SUMMARY<TAB>satisfied=<n> violated=<n> unverified=<n>
(ns tenken.eval
  (:require [tenken.model :as model]
            [tenken.policy :as policy]
            [clojure.string :as str]))

(def args (vec *command-line-args*))
(defn flag [n default]
  (let [i (.indexOf args n)]
    (if (neg? i) default (nth args (inc i) default))))

(def root (js/require "path") (def path (js/require "path")))

(def excluded
  #{".git" "node_modules" ".shadow-cljs" ".cpcache" "out" "dist" "public" "target" ".wrangler"})

(defn fail-exit [n & msgs]
  (doseq [m msgs] (println "FAIL:" m))
  (.exit js/process n))

(defn- path-prefix-match?
  [p prefix]
  (str/starts-with? p prefix))

(defn -main
  []
  (let [root-abs (.resolve path (flag "--root" "."))
        policy-id (flag "--policy" "awai-no-single-vendor-state")
        pol (first (filter (fn [p] (= (:tenken.policy/id p) (keyword policy-id)))
                           policy/all-policies))]
    (when (nil? pol)
      (fail-exit 2 (str "unknown policy: " policy-id
                        " (known: " (pr-str (mapv :tenken.policy/id policy/all-policies)) ")")))
    (let [scan-root (.join path root-abs "orgs")
          _ (when-not (js/fs.existsSync scan-root)
              (fail-exit 1 (str "scan root missing: orgs under " root-abs)))
          configs (model/walk-configs root-abs scan-root excluded)
          n (count configs)
          _ (println "SCANNED" (str "\t" n))
          _ (when (zero? n)
              (fail-exit 1 "0 設定は clean でなく走査不能 (検査の 8 問 1・2)"))
          ;; scope filter: policy の path-prefix に合う設定だけを評価
          prefix (get-in pol [:tenken.policy/scope :path-prefix])
          in-scope (if prefix
                     (filter (fn [c] (path-prefix-match? (subs (:tenken/path c) (inc (count root-abs))) prefix)) configs)
                     configs)
          results (map (fn [c] {:config c :verdict ((:tenken.policy/predicate pol) c)}) in-scope)
          violated (filter (fn [r] (= :VIOLATED (:tenken/verdict (:verdict r)))) results)
          unverified (filter (fn [r] (= :UNVERIFIED (:tenken/verdict (:verdict r)))) results)
          satisfied (filter (fn [r] (= :SATISFIED (:tenken/verdict (:verdict r)))) results)]
      (doseq [r violated]
        (println "VIOLATED" (str "\t" (:tenken/path (:config r)))
                 (str "\t" (:tenken/reason (:verdict r)))))
      (doseq [r unverified]
        (println "UNVERIFIED" (str "\t" (:tenken/path (:config r)))
                 (str "\t" (:tenken/reason (:verdict r)))))
      (println "SUMMARY" (str "\t" (str "satisfied=" (count satisfied)
                                        " violated=" (count violated)
                                        " unverified=" (count unverified))))
      (cond
        (seq unverified) (.exit js/process 1)
        (seq violated) (.exit js/process 1)
        :else (.exit js/process 0)))))

(when-not (empty? *command-line-args*)
  (-main))
