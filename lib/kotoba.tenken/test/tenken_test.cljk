;; tenken の両方向検査 (検査の 8 問 #5・#6・#7)
;; 走らせ方: kbb --backend sci --classpath src test/tenken_test.cljk
;; 出力: PASS/FAIL 行 + SUMMARY。exit 0 = 全緑 / 1 = 赤。
(ns tenken-test
  (:require ["node:fs" :as fs]
            [tenken.model :as m]
            [tenken.policy :as p]
            [clojure.string :as str]))

(def pass-count (atom 0))
(def fail-count (atom 0))

(defn check [name cond]
  (if cond
    (do (println "PASS" name) (swap! pass-count inc))
    (do (println "FAIL" name) (swap! fail-count inc))))

(defn tmpfile [name content]
  (let [p (str "/tmp/tenken-test-" name)]
    (fs/writeFileSync p content)
    p))

(def tmp-jsonc (tmpfile "clean.jsonc" (str "// comment\n{\"name\": \"x\"}")))
(def tmp-badjsonc (tmpfile "bad.jsonc" "{\"name\": \"x\",,}"))
(def tmp-toml-clean (tmpfile "clean.toml" (str "name = \"x\"\n[[r2_buckets]]\nbinding = \"Y\"\n")))
(def tmp-toml-d1 (tmpfile "d1.toml" (str "name = \"x\"\n[[d1_databases]]\nbinding = \"DB\"\n")))
(def tmp-toml-do-dot (tmpfile "dodot.toml" (str "name = \"x\"\n[[durable_objects.bindings]]\nname = \"O\"\n")))
(def tmp-toml-kv (tmpfile "kv.toml" (str "name = \"x\"\nkv_namespaces = []\n")))
(def tmp-toml-array-end (tmpfile "arrend.toml" (str "routes = [\n  { pattern = \"a\", custom_domain = true },\n]\n")))
(def tmp-jsonc-trailing (tmpfile "trail.jsonc" "{\"vars\": {\"A\": \"1\",},}"))
(def tmp-empty (tmpfile "empty.toml" ""))

(defn verdict-for [path]
  ((:tenken.policy/predicate p/awai-no-single-vendor-state) (m/read-config path)))

;; model 層
(check "jsonc-strip-comments" (= "x" (get (:tenken/data (m/read-config tmp-jsonc)) :name)))
(check "jsonc-parse-error-is-unreadable" (= :unreadable (:tenken/status (m/read-config tmp-badjsonc))))
(check "toml-clean-ok" (= :ok (:tenken/status (m/read-config tmp-toml-clean))))
(check "toml-array-table-dot-key" (some (fn [k] (str/starts-with? (name k) "durable_objects.bindings")) (keys (:tenken/data (m/read-config tmp-toml-do-dot)))))
(check "toml-bare-key" (contains? (:tenken/data (m/read-config tmp-toml-kv)) :kv_namespaces))
(check "toml-array-close-line-no-crash" (= :ok (:tenken/status (m/read-config tmp-toml-array-end))))
(check "jsonc-trailing-comma-ok" (= :ok (:tenken/status (m/read-config tmp-jsonc-trailing))))
(check "empty-file-unreadable" (= :unreadable (:tenken/status (m/read-config tmp-empty))))

;; policy 層 (awai-no-single-vendor-state)
(check "clean-config-satisfied" (= :SATISFIED (:tenken/verdict (verdict-for tmp-jsonc))))
(check "d1-array-table-violated" (= :VIOLATED (:tenken/verdict (verdict-for tmp-toml-d1))))
(check "do-dotted-table-violated" (= :VIOLATED (:tenken/verdict (verdict-for tmp-toml-do-dot))))
(check "kv-bare-key-violated" (= :VIOLATED (:tenken/verdict (verdict-for tmp-toml-kv))))
(check "unreadable-is-unverified-fail-closed" (= :UNVERIFIED (:tenken/verdict (verdict-for tmp-badjsonc))))
(check "unreadable-has-reason" (not (str/blank? (:tenken/reason (verdict-for tmp-empty)))))
(check "every-verdict-carries-rule-literal" (every? (fn [p] (and (:tenken/rule p) (:tenken/reason p)))
                                                    (map verdict-for [tmp-jsonc tmp-toml-d1 tmp-badjsonc])))

;; policy 自体の宣言要件
(check "policy-declares-nature" (contains? p/awai-no-single-vendor-state :tenken.policy/nature))
(check "policy-declares-fail-closed" (:tenken.policy/fail-closed p/awai-no-single-vendor-state))
(check "policy-declares-scope" (contains? p/awai-no-single-vendor-state :tenken.policy/scope))

(println "SUMMARY" (str "\t" "pass=" @pass-count " fail=" @fail-count))
(.exit js/process (if (zero? @fail-count) 0 1))
