(ns xml.core-test
  (:require [kotoba.test :refer [deftest is testing]]
            [kotoba.xml :as kxml]
            [xml.core :as xml]
            [xml.parse :as parse]))

(deftest hiccup-to-xml
  (is (= "<input name=\"value\" type=\"color3\" value=\"1, 0, 0\" />"
         (xml/xml [:input {:name "value" :type "color3" :value "1, 0, 0"}])))
  (is (= "<output name=\"out\" type=\"color3\" nodename=\"c\" />"
         (xml/xml [:output {:name "out" :type "color3" :nodename "c"}])))
  (is (= "<nodegraph name=\"NG\">\n  <output name=\"o\" type=\"color3\" />\n</nodegraph>"
         (xml/xml [:nodegraph {:name "NG"} [:output {:name "o" :type "color3"}]])))
  (is (= "<a title=\"x&quot;y\">\n  ok\n</a>" (xml/xml [:a {:title "x\"y"} "ok"])))
  (is (= "<a role=\"node\" />" (xml/xml [:a {:role :node}]))))

(deftest compatibility-namespace
  (is (= (xml/xml [:a "x"]) (kxml/xml [:a "x"]))))

(deftest compact-inserts-no-whitespace
  (testing "element content that is a value survives byte-for-byte"
    (is (= "<clTRID>ABC-12345</clTRID>" (xml/compact [:clTRID "ABC-12345"])))
    (is (= "\n  ABC-12345\n" (-> [:clTRID "ABC-12345"] xml/xml parse/parse parse/el-text))
        "the indented emitter puts the indentation inside the value")
    (is (= "ABC-12345" (-> [:clTRID "ABC-12345"] xml/compact parse/parse parse/el-text))))
  (testing "nesting, attributes and empty elements"
    (is (= "<a x=\"1\"><b>t</b><c/></a>"
           (xml/compact [:a {"x" "1"} [:b "t"] [:c]]))))
  (testing "escaping is unchanged"
    (is (= "<a>&lt;&amp;&gt;</a>" (xml/compact [:a "<&>"]))))
  (testing "namespaced keywords keep their prefix"
    (is (= "<domain:name>x</domain:name>" (xml/compact [:domain/name "x"]))))
  (testing "reachable through the compatibility facade too"
    (is (= "<a>1</a>" (kxml/compact [:a "1"])))))
