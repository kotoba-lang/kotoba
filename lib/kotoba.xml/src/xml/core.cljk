(ns xml.core
  "Hiccup to XML emitter."
  (:require [kotoba.lang.text :as str]))

(defn- qualified-name
  "The full \"prefix:local\" tag/attr name for a namespaced keyword
  (:p/sp -> \"p:sp\"), or just its name for a plain one (:workbook ->
  \"workbook\") -- Clojure's own namespace/name split maps directly onto
  XML's prefix:localname syntax, so a namespace-prefixed OOXML tag
  round-trips through xml.parse -> xml.core correctly instead of silently
  losing its prefix."
  [k]
  (if-let [ns (namespace k)] (str ns ":" (name k)) (name k)))

(defn- esc [s] (-> (str s) (str/replace "&" "&amp;") (str/replace "<" "&lt;") (str/replace ">" "&gt;")))
(defn- esc-attr [s] (str/replace (esc s) "\"" "&quot;"))
(defn- attrs [m]
  (apply str (for [[k v] m]
               (str " " (if (keyword? k) (qualified-name k) (name k))
                    "=\"" (esc-attr (if (keyword? v) (qualified-name v) v)) "\""))))

(declare emit)
(defn- emit [form ind]
  (let [pad (apply str (repeat ind "  "))]
    (if (vector? form)
      (let [[tag & more] form
            attr (when (map? (first more)) (first more))
            children (if attr (rest more) more)
            tag-name (qualified-name tag)]
        (if (seq children)
          (str pad "<" tag-name (attrs attr) ">\n"
               (str/join "\n" (map #(emit % (inc ind)) children))
               "\n" pad "</" tag-name ">")
          (str pad "<" tag-name (attrs attr) " />")))
      (str pad (esc form)))))

(defn- emit-compact [form]
  (if (vector? form)
    (let [[tag & more] form
          attr (when (map? (first more)) (first more))
          children (if attr (rest more) more)
          tag-name (qualified-name tag)]
      (if (seq children)
        (str "<" tag-name (attrs attr) ">"
             (apply str (map emit-compact children))
             "</" tag-name ">")
        (str "<" tag-name (attrs attr) "/>")))
    (esc form)))

(defn xml
  "Compile a hiccup form to an indented XML string."
  [form]
  (emit form 0))

(defn compact
  "Compile a hiccup form to XML with **no** inserted whitespace.

  `xml` indents for readability, which is right for documents whose element
  content is other elements — OOXML, the case this library was written for.
  It is wrong wherever element content is a *value*, because the indentation
  becomes part of that value: `[:clTRID \"ABC-1\"]` emits as
  `<clTRID>\\n  ABC-1\\n</clTRID>`, whose text content is `\"\\n  ABC-1\\n\"`
  and not `\"ABC-1\"`.

  For a document that is only read by humans and by parsers that trim, that is
  harmless. For a wire protocol it is a defect: EPP's `clTRID` correlates a
  response with the command that caused it, and a registrar comparing the
  echoed value against the one it sent gets a mismatch. Same for a DNS zone
  serial, a signature value, or any content that is compared rather than
  displayed.

  So the two are separate functions rather than a flag with a default: a
  caller emitting protocol XML has to say so, and a caller emitting a document
  keeps the pretty output it already relies on."
  [form]
  (emit-compact form))
