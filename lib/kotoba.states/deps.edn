{:paths ["src"]
 ;; Portable .cljc runtime deps only.
 :deps {
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/dsl-core {:local/root "../kotoba.dslCore"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {
                      io.github.kotoba-lang/amu
                      {:git/url "https://github.com/kotoba-lang/amu.git"
                       :git/sha "1e6dbb17d314cf45d3dd6796a6a9d5cb84b437b2"}}
         :exec-args {:dirs ["test"]}}
  :kotoba {:replace-paths ["src"]
           :replace-deps {io.github.kotoba-lang/amu
                          {:git/url "https://github.com/kotoba-lang/amu.git"
                           :git/sha "1e6dbb17d314cf45d3dd6796a6a9d5cb84b437b2"}}
           :main-opts ["-m" "kotoba.compiler.cli"]}}}
