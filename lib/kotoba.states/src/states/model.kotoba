;; Port of states.model (model.cljk), Kotoba-native, :document maps.
;;
;; Named divergences from model.cljk:
;;   - state-types and terminal-types are zero-arg functions (sets).
;;   - state-ids returns a :document vector of the state names, not a set:
;;     no set-building primitive is available in the document library here.
;;     Use document-set-contains? on the vector's elements or document-equal?
;;     for membership.
;;   - terminal? reads :states/end as truthy only when it is neither null nor
;;     false.

(ns states.model
  (:export [state-types terminal-types state-ids state start-at terminal?]))

(defn- field [m :document k :keyword] :document
  (if (map? m)
    (option-or (document-get m k) (document-null))
    (document-null)))

(defn- falsy-doc? [d :document] :bool
  (or (document-equal? d (document-null))
      (document-equal? d (document-bool false))))

(defn state-types [] :document
  (document-set (document-keyword :task)
                (document-keyword :choice)
                (document-keyword :pass)
                (document-keyword :wait)
                (document-keyword :succeed)
                (document-keyword :fail)
                (document-keyword :parallel)
                (document-keyword :map)))

(defn terminal-types [] :document
  (document-set (document-keyword :succeed)
                (document-keyword :fail)))

(defn- ids-loop [states :document i :i64 acc :document] :document
  (if (>= i (document-count states))
    acc
    (let [pair (option-or (document-map-entry-at states i) (document-vector))]
      (ids-loop states (+ i 1)
                (document-vector-conj acc (option-or (document-vector-at pair 0) (document-null)))))))

(defn state-ids [machine :document] :document
  (ids-loop (field machine :states/states) 0 (document-vector)))

(defn state [machine :document id :document] :document
  (option-or (document-get (field machine :states/states) id) (document-null)))

(defn start-at [machine :document] :document
  (field machine :states/start-at))

(defn terminal? [state-map :document] :bool
  (or (document-set-contains? (terminal-types) (field state-map :states/type))
      (not (falsy-doc? (field state-map :states/end)))))
