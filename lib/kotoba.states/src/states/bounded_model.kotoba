(ns states.bounded-model
  (:export [make-empty add-task-state add-terminal-state
            state-count contains-state? get-state
            state-kind state-next-name terminal? start-at-of
            check-a check-b check-c main]))

;; Capability-free bounded port of states.model (ASL-as-EDN state machine
;; queries), scoped to the shape states.core-test's own linear-machine
;; fixture uses: :task states carrying a single :next transition, plus
;; :succeed/:fail terminal states -- :choice/:parallel/:map states and
;; conditional routing stay out of scope (states.execute's full ASL
;; interpreter is a separate, much larger undertaking, not attempted).
;;
;; This is the first bounded-profile migration this session to use
;; kotoba-lang/compiler's canonical typed-map ([:map key value],
;; max-typed-map-entries 31, already production-qualified by
;; kotoba-lang/crdt's orset/document CRDTs) for a genuinely
;; string-keyed, open-shaped legacy domain -- every earlier "open map"
;; finding this session (search/sheets/atprotocol/states/sigma/
;; edu-berkeley-spice) was retained specifically because no bounded-map
;; precedent existed yet in the reviewed portion of the fleet.

(def state-value-type
  [:record :states/state
   [[:kind :keyword] [:next-name :string] [:end :bool]]])
(def states-map-type [:map :string state-value-type])
(def machine-type
  [:record :states/machine [[:start-at :string] [:states states-map-type]]])

(defn make-empty [start-at :string] [:alias machine-type]
  (record machine-type start-at (typed-map-new states-map-type)))

(defn add-task-state
  [machine [:alias machine-type] name :string next-name :string]
  [:alias machine-type]
  (record machine-type (record-get machine-type machine :start-at)
    (typed-map-assoc states-map-type (record-get machine-type machine :states)
      name (record state-value-type :task next-name false))))

(defn add-terminal-state
  [machine [:alias machine-type] name :string kind :keyword]
  [:alias machine-type]
  (record machine-type (record-get machine-type machine :start-at)
    (typed-map-assoc states-map-type (record-get machine-type machine :states)
      name (record state-value-type kind "" true))))

(defn state-count [machine [:alias machine-type]] :i64
  (typed-map-count states-map-type (record-get machine-type machine :states)))

(defn contains-state? [machine [:alias machine-type] name :string] :bool
  (typed-map-contains states-map-type (record-get machine-type machine :states) name))

(defn get-state [machine [:alias machine-type] name :string] [:alias state-value-type]
  (option-or
    (typed-map-get states-map-type (record-get machine-type machine :states) name)
    (record state-value-type :fail "" true)))

(defn state-kind [s [:alias state-value-type]] :keyword
  (record-get state-value-type s :kind))
(defn state-next-name [s [:alias state-value-type]] :string
  (record-get state-value-type s :next-name))

(defn terminal? [s [:alias state-value-type]] :bool
  (if (record-get state-value-type s :end) true
    (if (= (record-get state-value-type s :kind) :succeed) true
      (if (= (record-get state-value-type s :kind) :fail) true false))))

(defn start-at-of [machine [:alias machine-type]] :string
  (record-get machine-type machine :start-at))

;; --- self-conformance, replaying states.core-test/linear-machine's own
;; A->B->C task chain fixture (task A -next-> task B -next-> succeed C) ---

(defn linear-machine [] [:alias machine-type]
  (add-terminal-state
    (add-task-state
      (add-task-state (make-empty "A") "A" "B")
      "B" "C")
    "C" :succeed))

(defn check-a [] :i64
  (let [m (linear-machine)]
    (if (= (state-count m) 3)
      (if (contains-state? m "A")
        (if (contains-state? m "C")
          (if (string=? (start-at-of m) "A") 42 4)
          3)
        2)
      1)))

(defn check-b [] :i64
  (let [sa (get-state (linear-machine) "A")]
    (if (= (state-kind sa) :task)
      (if (string=? (state-next-name sa) "B")
        (if (terminal? sa) 3 42)
        2)
      1)))

(defn check-c [] :i64
  (let [sc (get-state (linear-machine) "C")]
    (if (= (state-kind sc) :succeed)
      (if (terminal? sc) 42 3)
      1)))

(defn main [] :i64
  (if (= 42 (check-a))
    (if (= 42 (check-b))
      (if (= 42 (check-c)) 42 3)
      2)
    1))
