(ns states.model-test (:export [main]) (:require [states.model :as p]))

(defn- ok [b :bool] :i64
  (if b 0 1))

(defn- machine [] :document
  (document-map :states/comment (document-string "Order pipeline")
                :states/start-at (document-string "Validate")
                :states/states
                (document-map (document-string "Validate")
                              (document-map :states/type (document-keyword :task)
                                            :states/next (document-string "Route"))
                              (document-string "Route")
                              (document-map :states/type (document-keyword :choice)
                                            :states/default (document-string "Reject"))
                              (document-string "Ship")
                              (document-map :states/type (document-keyword :succeed))
                              (document-string "Reject")
                              (document-map :states/type (document-keyword :fail)))))

(defn- lookup-checks [] :i64
  (+ (ok (= (document-count (p/state-ids (machine))) 4))
     (ok (document-equal? (p/start-at (machine)) (document-string "Validate")))
     (ok (document-equal? (p/state (machine) (document-string "Route"))
                          (document-map :states/type (document-keyword :choice)
                                        :states/default (document-string "Reject"))))
     (ok (document-equal? (p/state (machine) (document-string "Nope")) (document-null)))))

(defn- terminal-checks [] :i64
  (+ (ok (p/terminal? (p/state (machine) (document-string "Ship"))))
     (ok (p/terminal? (p/state (machine) (document-string "Reject"))))
     (ok (not (p/terminal? (p/state (machine) (document-string "Route")))))
     (ok (not (p/terminal? (p/state (machine) (document-string "Validate")))))
     (ok (p/terminal? (document-map :states/type (document-keyword :pass) :states/end (document-bool true))))))

(defn main [] :i64
  (+ (lookup-checks) (terminal-checks)))
