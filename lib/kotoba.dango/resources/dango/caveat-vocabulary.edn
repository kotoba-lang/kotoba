{:format :dango.caveat-vocabulary/v1
 :decision "adr-2609242100-capability-chain-is-ipld-sexpr-biscuit-is-an-adapter"
 :form "a vector whose head is an operator keyword: [:and [:<= :req/bytes 10] [:prefix? :req/path \"ds/\"]] -- never a list"
 :operators {:and 0 :or 0 :not 1 := 2 :< 2 :<= 2 :> 2 :>= 2 :prefix? 2 :member? 2}
 ;; arity 0 = variadic. Nothing else is callable: no recursion, no user
 ;; functions, no eval, no I/O, no database lookup.
 :facts #{:req/path :req/bytes :req/now :req/kind :req/resource :req/holder}
 ;; per-surface facts (storage / graph / inference) are OPEN -- see the ADR gaps.
 :combination :conjunction-across-blocks
 ;; Every reason dango.chain/verify and dango.caveat/problems can return. There
 ;; is no :cid-mismatch: a block's CID is computed from the bytes received, so
 ;; it cannot disagree with them -- tampering shows up as :bad-signature.
 :refusals [:dango/malformed-block :dango/malformed-caveat :dango/unknown-operator
            :dango/unknown-fact :dango/caveat-too-large :dango/empty-chain
            :dango/chain-too-long :dango/broken-link :dango/bad-signature :dango/bad-seal
            :dango/holder-readdressed :dango/revoked :dango/malformed-request
            :dango/not-covered :dango/expired :dango/wrong-holder :dango/caveat-false]}
