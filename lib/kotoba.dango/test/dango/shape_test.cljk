(ns dango.shape-test
  (:require [cljs.test :refer [deftest is]]
            [dango.bytes :as b]
            [dango.shape :as shape]))

(def good
  {:prev nil
   :grant {:caps #{[:data/read "kotoba://storage/did:key:z6Mk/ds"]}
           :holder "did:key:z6Mk" :before 1790000000}
   :caveats [[:prefix? :req/path "ds/raw/"]]
   :next-key (b/->bytes (range 32))})

(deftest well-formed-block-has-no-findings
  (is (= [] (shape/findings good))))

;; Each negative case pins the REASON, not just "non-empty".
(deftest refusals-name-their-reason
  (is (= [[:dango/malformed-block :not-a-map]] (shape/findings [1 2])))
  (is (= [[:dango/malformed-block [:missing [:next-key]]]] (shape/findings (dissoc good :next-key))))
  (is (= [[:dango/malformed-block [:unknown-keys [:extra]]]] (shape/findings (assoc good :extra 1))))
  (is (= [[:dango/malformed-block :caps-not-a-non-empty-set-of-kind-resource]]
         (shape/findings (assoc-in good [:grant :caps] #{}))))
  (is (= [[:dango/malformed-block :caps-not-a-non-empty-set-of-kind-resource]]
         (shape/findings (assoc-in good [:grant :caps] #{[:read "x"]}))))
  (is (= [[:dango/malformed-block :before-not-epoch-seconds]]
         (shape/findings (assoc-in good [:grant :before] "2026-09-24"))))
  (is (= [[:dango/malformed-block :before-not-epoch-seconds]]
         (shape/findings (assoc-in good [:grant :before] -1))))
  (is (= [[:dango/malformed-block :caveats-not-a-vector]]
         (shape/findings (assoc good :caveats '(x)))))
  (is (= [[:dango/malformed-block :next-key-not-32-bytes]]
         (shape/findings (assoc good :next-key (b/->bytes (range 31))))))
  (is (= [[:dango/malformed-block :prev-not-a-link]]
         (shape/findings (assoc good :prev "bafy…")))))
