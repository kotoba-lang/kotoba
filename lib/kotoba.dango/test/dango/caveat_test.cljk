(ns dango.caveat-test
  (:require [cljs.test :refer [deftest is]]
            [dango.caveat :as c]))

(def req {:req/path "ds/raw/a.parquet" :req/bytes 1000 :req/now 1700000000
          :req/kind :data/read})

(deftest predicates-hold-and-fail
  (is (true? (c/holds? [:prefix? :req/path "ds/raw/"] req)))
  (is (false? (c/holds? [:prefix? :req/path "ds/cooked/"] req)))
  (is (true? (c/holds? [:and [:<= :req/bytes 1000] [:not [:= :req/kind :data/write]]] req)))
  ;; the boundary itself: 1000 <= 1000 holds, 1000 < 1000 does not
  (is (false? (c/holds? [:< :req/bytes 1000] req)))
  (is (true? (c/holds? [:or [:> :req/bytes 5000] [:member? :req/kind #{:data/read}]] req))))

(deftest undecidable-is-false-not-an-error
  (is (false? (c/holds? [:< :req/holder 5] req)) "absent fact")
  (is (false? (c/holds? [:< :req/path 5] req)) "string against integer")
  ;; the fail-open this guards: two-valued `not` turned "undecidable" into true
  (is (false? (c/holds? [:not [:< :req/holder 5]] req)) "not of unknown")
  (is (false? (c/holds? [:not [:= :req/holder "did:key:zX"]] req)) "not of an absent fact")
  (is (false? (c/holds? [:or [:not [:< :req/path 5]] false] req)) "unknown through or")
  (is (false? (c/holds? [:and true [:not [:< :req/holder 5]]] req)) "unknown through and")
  (is (true? (c/holds? [:or [:< :req/holder 5] [:= :req/bytes 1000]] req))
      "or is true when one side is true, whatever the other"))

(deftest shape-refusals-name-their-reason
  (is (= [[:dango/unknown-operator :eval]] (c/problems [:eval "x"])))
  (is (= [[:dango/unknown-fact :req/secret]] (c/problems [:= :req/secret 1])))
  (is (= [[:dango/malformed-caveat [:arity := 3]]] (c/problems [:= 1 2 3])))
  (is (= [[:dango/malformed-caveat [:no-arguments :and]]] (c/problems [:and])))
  (is (= [[:dango/malformed-caveat [:not-a-term "(and true)"]]] (c/problems '(and true)))
      "a list is not a caveat form: the wire form is the keyword-headed vector")
  (is (= :dango/caveat-too-large
         (ffirst (c/problems (reduce (fn [f _] [:not f]) true (range 20))))))
  (is (= [[:dango/caveat-too-large [:nodes 256]]]
         (c/problems (into [:and] (repeat 300 true)))))
  (is (false? (c/holds? [:eval "x"] req)) "a malformed form never holds"))
