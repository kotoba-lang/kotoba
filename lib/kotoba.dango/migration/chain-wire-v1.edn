{:schema :kotoba.text-migration/v1
 :profile :dango/chain-wire-v1
 :date "2026-10-09"
 :authority "root ADR-2610082200 §16 (everything below the kotoba app runs in pure Kotoba)"
 :legacy
 {:source "src/dango/chain.cljk"
  :status :retained-general-oracle
  :support ["src/dango/bytes.cljk" "src/dango/shape.cljk"]
  :note "dango.chain stays as the oracle the native verifier is measured against
         (test/native_chain_parity.cljk). dango.bytes and dango.shape exist only
         for it: the host byte-array <-> int-vector shuttle ed25519.sign needs,
         and the block-shape check minting runs."}
 :canonical
 {:source "src/dango/chain_wire.kotoba"
  :authority :kotoba
  :support ["src/dango/sha256.kotoba"]
  :required-capabilities [[:cap/call 2]]
  :capability-note "identity/verify (wire 2): Ed25519 over spans of the granted
                    region; the provider is kotoba-lang/amu#1075."}
 :ported [:verify]
 :evidence "42 real presentations agree 42/42 on aarch64-macos
            (test/native_chain_parity.cljk); --control drops the expiry check
            and exactly the 2 expired cases disagree."
 :not-ported
 {:root "mints a root block: signing needs an identity.sign capability"
  :attenuate "appends a block: signing by the parent's next-key"
  :present "seals a token: signing by the last next-key"
  :encode-token "kotoba.value.v1 encoding of a whole token"
  :decode-token "kotoba.value.v1 decoding of a whole token"
  :cap->scope "a cap vector to an authority.scope vector; the pure lattice is
               authority.lattice, which works on the resource string"
  :why "the holder side signs. In ADR-2610082200 the holder is a hata (機)
        with a device key behind a capability, so these move when hata does."}
 :not-enforced-natively
 [:canonical-cbor "the native reader takes the first of a duplicated key; the
                   oracle refuses. Every such block is still signed by the key
                   allowed to sign it, so this cannot widen authority."]
 :targets {:aarch64-macos :measured
           :wasm32-browser "not yet: unsupported typed Wasm expression"}}
