;; dango.sha256 -- FIPS 180-4 SHA-256 over bytes held in a granted region,
;; in the Kotoba guest subset (ADR adr-2609242100-capability-chain-is-ipld-
;; sexpr-biscuit-is-an-adapter, staged plan: the CID half of the chain check
;; runs in the guest; only signature verification is a capability).
;;
;; ALLOCATION-FREE. The eight state words and a sliding 16-word window of the
;; message schedule are function PARAMETERS, the round constants a function,
;; the digest a scalar record. The first version kept them in vector-i64s;
;; every vector-assoc copies, so one 64-byte block cost ~650 vectors and three
;; small blocks exhausted the loader's 4,096-vector table (measured
;; 2026-09-24: KEXE_TRAP :vector-table-exhausted). The window works because
;; round t needs w[t] and the new word w[t+16] = s1(w[t+14]) + w[t+9] +
;; s0(w[t+1]) + w[t], all of which are inside [w[t], w[t+15]].
;;
;; Words are 32-bit values held in i64 and masked after every addition. The
;; message is read from a slice and padded VIRTUALLY (`vbyte`); a guest
;; cannot build a :bytes or :string from region bytes. Shift counts are
;; literals (a guest rule), so every rotation is written out.
(ns dango.sha256
  (:export [digest-matches digest-eq-region])
  (:schemas {:dango/h8 [:record :dango/h8 [[:a :i64] [:b :i64] [:c :i64] [:d :i64] [:e :i64] [:f :i64] [:g :i64] [:h :i64]]]}))

(def mask32 4294967295)

(defn at [m [:slice :u8] p :i64] :i64
  (if (and (>= p 0) (< p (slice-length m))) (slice-get m p) -1))

(defn kt [t :i64] :i64
  (cond
        (= t 0) 1116352408
        (= t 1) 1899447441
        (= t 2) 3049323471
        (= t 3) 3921009573
        (= t 4) 961987163
        (= t 5) 1508970993
        (= t 6) 2453635748
        (= t 7) 2870763221
        (= t 8) 3624381080
        (= t 9) 310598401
        (= t 10) 607225278
        (= t 11) 1426881987
        (= t 12) 1925078388
        (= t 13) 2162078206
        (= t 14) 2614888103
        (= t 15) 3248222580
        (= t 16) 3835390401
        (= t 17) 4022224774
        (= t 18) 264347078
        (= t 19) 604807628
        (= t 20) 770255983
        (= t 21) 1249150122
        (= t 22) 1555081692
        (= t 23) 1996064986
        (= t 24) 2554220882
        (= t 25) 2821834349
        (= t 26) 2952996808
        (= t 27) 3210313671
        (= t 28) 3336571891
        (= t 29) 3584528711
        (= t 30) 113926993
        (= t 31) 338241895
        (= t 32) 666307205
        (= t 33) 773529912
        (= t 34) 1294757372
        (= t 35) 1396182291
        (= t 36) 1695183700
        (= t 37) 1986661051
        (= t 38) 2177026350
        (= t 39) 2456956037
        (= t 40) 2730485921
        (= t 41) 2820302411
        (= t 42) 3259730800
        (= t 43) 3345764771
        (= t 44) 3516065817
        (= t 45) 3600352804
        (= t 46) 4094571909
        (= t 47) 275423344
        (= t 48) 430227734
        (= t 49) 506948616
        (= t 50) 659060556
        (= t 51) 883997877
        (= t 52) 958139571
        (= t 53) 1322822218
        (= t 54) 1537002063
        (= t 55) 1747873779
        (= t 56) 1955562222
        (= t 57) 2024104815
        (= t 58) 2227730452
        (= t 59) 2361852424
        (= t 60) 2428436474
        (= t 61) 2756734187
        (= t 62) 3204031479
        (= t 63) 3329325298
        :else 0))

(defn rotr2 [x :i64] :i64 (bit-and (bit-or (u64-shift-right x 2) (i64-shift-left x 30)) mask32))
(defn rotr6 [x :i64] :i64 (bit-and (bit-or (u64-shift-right x 6) (i64-shift-left x 26)) mask32))
(defn rotr7 [x :i64] :i64 (bit-and (bit-or (u64-shift-right x 7) (i64-shift-left x 25)) mask32))
(defn rotr11 [x :i64] :i64 (bit-and (bit-or (u64-shift-right x 11) (i64-shift-left x 21)) mask32))
(defn rotr13 [x :i64] :i64 (bit-and (bit-or (u64-shift-right x 13) (i64-shift-left x 19)) mask32))
(defn rotr17 [x :i64] :i64 (bit-and (bit-or (u64-shift-right x 17) (i64-shift-left x 15)) mask32))
(defn rotr18 [x :i64] :i64 (bit-and (bit-or (u64-shift-right x 18) (i64-shift-left x 14)) mask32))
(defn rotr19 [x :i64] :i64 (bit-and (bit-or (u64-shift-right x 19) (i64-shift-left x 13)) mask32))
(defn rotr22 [x :i64] :i64 (bit-and (bit-or (u64-shift-right x 22) (i64-shift-left x 10)) mask32))
(defn rotr25 [x :i64] :i64 (bit-and (bit-or (u64-shift-right x 25) (i64-shift-left x 7)) mask32))

(defn big-s0 [x :i64] :i64 (bit-xor (rotr2 x) (bit-xor (rotr13 x) (rotr22 x))))
(defn big-s1 [x :i64] :i64 (bit-xor (rotr6 x) (bit-xor (rotr11 x) (rotr25 x))))
(defn small-s0 [x :i64] :i64 (bit-xor (rotr7 x) (bit-xor (rotr18 x) (u64-shift-right x 3))))
(defn small-s1 [x :i64] :i64 (bit-xor (rotr17 x) (bit-xor (rotr19 x) (u64-shift-right x 10))))
(defn ch [x :i64 y :i64 z :i64] :i64 (bit-and (bit-xor (bit-and x y) (bit-and (bit-xor x mask32) z)) mask32))
(defn maj [x :i64 y :i64 z :i64] :i64 (bit-xor (bit-and x y) (bit-xor (bit-and x z) (bit-and y z))))
(defn add32 [a :i64 b :i64] :i64 (bit-and (+ a b) mask32))

;; the padded message's total length in bytes
(defn padded-length [len :i64] :i64 (* 64 (quot (+ len 72) 64)))
(defn pow256 [k :i64 acc :i64] :i64 (if (= k 0) acc (pow256 (- k 1) (* acc 256))))

;; byte i of the PADDED message [off, off+len) without building it
(defn vbyte [m [:slice :u8] off :i64 len :i64 i :i64] :i64
  (let [total (padded-length len)]
    (cond
      (< i len) (at m (+ off i))
      (= i len) 128
      (>= i (- total 8))
      ;; byte k of the 64-bit big-endian bit length; 256^k stays below 2^63
      ;; for k <= 7, 256^(k+1) would not -- so the remainder is taken from the
      ;; same quotient rather than from a second, larger power
      (let [k (- (- total 1) i) q (quot (* len 8) (pow256 k 1))]
        (- q (* 256 (quot q 256))))
      :else 0)))

(defn word [m [:slice :u8] off :i64 len :i64 i :i64] :i64
  (+ (* 16777216 (vbyte m off len i))
     (+ (* 65536 (vbyte m off len (+ i 1)))
        (+ (* 256 (vbyte m off len (+ i 2))) (vbyte m off len (+ i 3))))))

(defn h8 [a :i64 b :i64 c :i64 d :i64 e :i64 f :i64 g :i64 h :i64] [:record :dango/h8 [[:a :i64] [:b :i64] [:c :i64] [:d :i64] [:e :i64] [:f :i64] [:g :i64] [:h :i64]]]
  (record-new [:record :dango/h8 [[:a :i64] [:b :i64] [:c :i64] [:d :i64] [:e :i64] [:f :i64] [:g :i64] [:h :i64]]] a b c d e f g h))
(defn hget [s [:record :dango/h8 [[:a :i64] [:b :i64] [:c :i64] [:d :i64] [:e :i64] [:f :i64] [:g :i64] [:h :i64]]] k :i64] :i64
  (cond (= k 0) (record-get [:record :dango/h8 [[:a :i64] [:b :i64] [:c :i64] [:d :i64] [:e :i64] [:f :i64] [:g :i64] [:h :i64]]] s :a) (= k 1) (record-get [:record :dango/h8 [[:a :i64] [:b :i64] [:c :i64] [:d :i64] [:e :i64] [:f :i64] [:g :i64] [:h :i64]]] s :b)
        (= k 2) (record-get [:record :dango/h8 [[:a :i64] [:b :i64] [:c :i64] [:d :i64] [:e :i64] [:f :i64] [:g :i64] [:h :i64]]] s :c) (= k 3) (record-get [:record :dango/h8 [[:a :i64] [:b :i64] [:c :i64] [:d :i64] [:e :i64] [:f :i64] [:g :i64] [:h :i64]]] s :d)
        (= k 4) (record-get [:record :dango/h8 [[:a :i64] [:b :i64] [:c :i64] [:d :i64] [:e :i64] [:f :i64] [:g :i64] [:h :i64]]] s :e) (= k 5) (record-get [:record :dango/h8 [[:a :i64] [:b :i64] [:c :i64] [:d :i64] [:e :i64] [:f :i64] [:g :i64] [:h :i64]]] s :f)
        (= k 6) (record-get [:record :dango/h8 [[:a :i64] [:b :i64] [:c :i64] [:d :i64] [:e :i64] [:f :i64] [:g :i64] [:h :i64]]] s :g) :else (record-get [:record :dango/h8 [[:a :i64] [:b :i64] [:c :i64] [:d :i64] [:e :i64] [:f :i64] [:g :i64] [:h :i64]]] s :h)))

;; 64 rounds over one block; w0..w15 is w[t..t+15]
(defn rounds [a :i64 b :i64 c :i64 d :i64 e :i64 f :i64 g :i64 h :i64
              w0 :i64 w1 :i64 w2 :i64 w3 :i64 w4 :i64 w5 :i64 w6 :i64 w7 :i64 w8 :i64 w9 :i64 w10 :i64 w11 :i64 w12 :i64 w13 :i64 w14 :i64 w15 :i64 t :i64] [:record :dango/h8 [[:a :i64] [:b :i64] [:c :i64] [:d :i64] [:e :i64] [:f :i64] [:g :i64] [:h :i64]]]
  (if (= t 64)
    (h8 a b c d e f g h)
    (let [t1 (add32 (add32 h (big-s1 e)) (add32 (ch e f g) (add32 (kt t) w0)))
          t2 (add32 (big-s0 a) (maj a b c))
          nw (add32 (add32 (small-s1 w14) w9) (add32 (small-s0 w1) w0))]
      (rounds (add32 t1 t2) a b c (add32 d t1) e f g
              w1 w2 w3 w4 w5 w6 w7 w8 w9 w10 w11 w12 w13 w14 w15 nw (+ t 1)))))

(defn compress [m [:slice :u8] off :i64 len :i64 base :i64 s [:record :dango/h8 [[:a :i64] [:b :i64] [:c :i64] [:d :i64] [:e :i64] [:f :i64] [:g :i64] [:h :i64]]]] [:record :dango/h8 [[:a :i64] [:b :i64] [:c :i64] [:d :i64] [:e :i64] [:f :i64] [:g :i64] [:h :i64]]]
  (let [r (rounds (hget s 0) (hget s 1) (hget s 2) (hget s 3) (hget s 4) (hget s 5) (hget s 6) (hget s 7)
                  (word m off len (+ base 0)) (word m off len (+ base 4)) (word m off len (+ base 8)) (word m off len (+ base 12)) (word m off len (+ base 16)) (word m off len (+ base 20)) (word m off len (+ base 24)) (word m off len (+ base 28)) (word m off len (+ base 32)) (word m off len (+ base 36)) (word m off len (+ base 40)) (word m off len (+ base 44)) (word m off len (+ base 48)) (word m off len (+ base 52)) (word m off len (+ base 56)) (word m off len (+ base 60)) 0)]
    (h8 (add32 (hget s 0) (hget r 0)) (add32 (hget s 1) (hget r 1))
        (add32 (hget s 2) (hget r 2)) (add32 (hget s 3) (hget r 3))
        (add32 (hget s 4) (hget r 4)) (add32 (hget s 5) (hget r 5))
        (add32 (hget s 6) (hget r 6)) (add32 (hget s 7) (hget r 7)))))

(defn blocks [m [:slice :u8] off :i64 len :i64 base :i64 s [:record :dango/h8 [[:a :i64] [:b :i64] [:c :i64] [:d :i64] [:e :i64] [:f :i64] [:g :i64] [:h :i64]]]] [:record :dango/h8 [[:a :i64] [:b :i64] [:c :i64] [:d :i64] [:e :i64] [:f :i64] [:g :i64] [:h :i64]]]
  (if (>= base (padded-length len))
    s
    (blocks m off len (+ base 64) (compress m off len base s))))

;; SHA-256 of region bytes [off, off+len)
(defn sha256 [m [:slice :u8] off :i64 len :i64] [:record :dango/h8 [[:a :i64] [:b :i64] [:c :i64] [:d :i64] [:e :i64] [:f :i64] [:g :i64] [:h :i64]]]
  (blocks m off len 0 (h8 1779033703 3144134277 1013904242 2773480762 1359893119 2600822924 528734635 1541459225)))

(defn word-at [m [:slice :u8] p :i64] :i64
  (+ (* 16777216 (at m p)) (+ (* 65536 (at m (+ p 1))) (+ (* 256 (at m (+ p 2))) (at m (+ p 3))))))

;; the 32 bytes at p equal digest s
(defn digest-eq [m [:slice :u8] p :i64 s [:record :dango/h8 [[:a :i64] [:b :i64] [:c :i64] [:d :i64] [:e :i64] [:f :i64] [:g :i64] [:h :i64]]] t :i64] :i64
  (cond (= t 8) 1
        (= (hget s t) (word-at m (+ p (* 4 t)))) (digest-eq m p s (+ t 1))
        :else 0))

;; test entry: region = message ++ 32-byte expected digest; 1 when they match
(defn digest-matches [base :i64 len :i64 split :i64] :i64
  (let [m (slice-of-u8 base len)]
    (if (= (- len split) 32)
      (digest-eq m split (sha256 m 0 split) 0)
      3)))

;; region interface for dango.chain-wire: SHA-256 of [off, off+mlen) equals
;; the 32 bytes at p (1) or not (0)
(defn digest-eq-region [base :i64 len :i64 off :i64 mlen :i64 p :i64] :i64
  (let [m (slice-of-u8 base len)]
    (digest-eq m p (sha256 m off mlen) 0)))
