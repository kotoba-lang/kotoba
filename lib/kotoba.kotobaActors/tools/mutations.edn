;; One mutation per invariant. `:find` must occur EXACTLY ONCE in `:file`.
;;
;; ## SCOPE
;;
;; Covers the 2026-08-18 `.clj` → `.cljc` conversion of this library ONLY:
;; the two Java string-interop calls that became `clojure.string`, the host
;; read that became a reader conditional, the path resolver that now answers
;; nil instead of a guess, and the nil-vs-empty discipline that keeps a seed
;; nobody could read from turning into a complete-looking empty graph.
;;
;; It does NOT cover the analysis surface — the eleven actor namespaces and
;; their pinned seed counts. Those have 97 assertions above and no mutations
;; here, so a clean run means "the portability invariants are measured" and
;; NOT "this library is measured".
;;
;; ⚠ BASELINE IS RED, BY DATA. com-etzhayyim-kadode and com-etzhayyim-tsugite
;; have no `data/` tracked in git, so 12 assertions error on missing files
;; before anything is mutated — identically on both runtimes. The harness
;; records that set and scores only NEW failures. See difference 1 in
;; tools/mutate.cljk.
;;
;; ⚠ RUN THE TABLE TWICE. `MUTATE_CMD` picks the suite:
;;
;;   KOTOBA_ACTORS_ETZHAYYIM_ROOT=<…> kbb --backend sci tools/mutate.cljk
;;   KOTOBA_ACTORS_ETZHAYYIM_ROOT=<…> MUTATE_CMD='kbb --backend sci --classpath src:test test/run_portable.cljk' \
;;     kbb --backend sci tools/mutate.cljk
;;
;; A reader conditional has two branches and a one-runtime harness can only
;; see one of them. `:the-clj-read-opens-the-path-it-was-given` and
;; `:the-cljs-read-opens-the-path-it-was-given` are each a guaranteed
;; SURVIVOR under the other runtime; that is the harness's blind spot being
;; reported rather than hidden, and it is why both runs are recorded.

[{:id :the-clj-read-opens-the-path-it-was-given
  :invariant "the JVM branch of the host read reads the seed it was handed"
  :file "src/kotoba_actors/datomic.cljk"
  :find "#?(:clj (slurp path)"
  :replace "#?(:clj (slurp (str path \".missing\"))"}

 {:id :the-cljs-read-opens-the-path-it-was-given
  :invariant "the ClojureScript branch of the host read reads the same seed"
  :file "src/kotoba_actors/datomic.cljk"
  :find "(.toString (fs/readFileSync path))"
  :replace "(.toString (fs/readFileSync (str path \".missing\")))"}

 {:id :a-logic-var-is-a-question-mark-PREFIX
  :invariant "`?e` binds and `e` does not — the whole datalog rests on it"
  :file "src/kotoba_actors/datomic.cljk"
  :find "(and (symbol? x) (str/starts-with? (name x) \"?\"))"
  :replace "(and (symbol? x) (str/ends-with? (name x) \"?\"))"}

 ;; A mutation was written and RETARGETED here, with its reason, because
 ;; deleting one to tidy the table is what this harness exists to prevent:
 ;;
 ;;   flipping `str/ends-with?` to `str/starts-with?` on the id-key test is
 ;;   a SEMANTIC NO-OP. The candidates are namespaced keywords — :company/id,
 ;;   :organism/id, :genome/id — and `(name :company/id)` is the bare string
 ;;   "id", which both starts and ends with "id". The same shape of no-op
 ;;   (`([] (f (registry)))` → `([] (:key (registry)))`) was written and
 ;;   removed in kotoba-lang/technology and again in kotoba-lang/iso3166.
 ;;   Retargeted at the SUFFIX ITSELF, which is what a careless edit to that
 ;;   line would actually look like.
 {:id :the-entity-id-is-the-key-whose-name-ends-in-id
  :invariant "rows are keyed on their domain */id, not on a synthetic index"
  :file "src/kotoba_actors/datomic.cljk"
  :find "(str/ends-with? (name %) \"id\")"
  :replace "(str/ends-with? (name %) \"ids\")"}

 {:id :rows-that-were-never-read-do-not-become-an-empty-index
  :invariant "nil rows propagate as nil; (map-indexed f nil) is ()"
  :file "src/kotoba_actors/datomic.cljk"
  :find "  (when (some? rows)\n    (apply concat"
  :replace "  (when true\n    (apply concat"}

 {:id :datoms-that-were-never-read-do-not-become-an-empty-db
  :invariant "nil datoms propagate as nil; (reduce f {} nil) is {}"
  :file "src/kotoba_actors/datomic.cljk"
  :find "  (when (some? datoms)\n    (let [index"
  :replace "  (when true\n    (let [index"}

 {:id :load-rows-refuses-an-unresolved-path
  :invariant "an unknown seed path is refused, not read as nothing"
  :file "src/kotoba_actors/datomic.cljk"
  :find "  (when (nil? path)\n    (throw (ex-info \"kotoba-actors: no seed path"
  :replace "  (when false\n    (throw (ex-info \"kotoba-actors: no seed path"}

 {:id :q-refuses-a-nil-db
  :invariant "querying nothing is not the same as querying an empty graph"
  :file "src/kotoba_actors/datomic.cljk"
  :find "  (when (nil? db)\n    (throw (ex-info \"kotoba-actors: query against a nil db"
  :replace "  (when false\n    (throw (ex-info \"kotoba-actors: query against a nil db"}

 {:id :config-answers-nil-rather-than-guessing-a-path
  :invariant "an unresolved root yields nil, never a path built from nil"
  :file "src/kotoba_actors/config.cljk"
  :find "   (when root\n     (str root"
  :replace "   (when true\n     (str root"}

 {:id :the-seed-path-still-names-the-sibling-checkout
  :invariant "config composes root + com-etzhayyim-<actor> + relative path"
  :file "src/kotoba_actors/config.cljk"
  :find "\"/com-etzhayyim-\" actor \"/\" relative-path"
  :replace "\"/com-etzhayyim\" actor \"/\" relative-path"}]
