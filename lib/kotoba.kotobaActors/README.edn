{:project/name "kotoba-actors"
 :project/org "kotoba-lang"
 :project/language :clojure
 :project/role :shared-actor-datom-library
 :migration/source "etzhayyim/root/20-actors/kotoba-actors-clj"
 :migration/history-preserved true
 :data-boundary
 {:ownership :actor-repositories
  :lookup "orgs/etzhayyim/com-etzhayyim-<actor>"
  :override-env "KOTOBA_ACTORS_ETZHAYYIM_ROOT"
  :library-writes-actor-data false
  :query-location :local
  :remote-query-capability false
  :public-seed-policy :explicit-classification-required
  :private-runtime-policy :kagi-chunked-edn-via-host}
 :format-policy
 {:canonical #{:edn}
  :external-wire-only #{:json :jsonl :json-ld}}
 :deprecated-languages
 {:go :pruned
  :tinygo :pruned}

 ;; 2026-08-18: every source and test file is `.cljc` and the suite runs on
 ;; the JVM and on nbb with identical results.
 :portability
 {:runtimes #{:clj :cljs}
  :suite {:jvm "kbb -M:test -m cognitect.test-runner"
          :nbb "kbb --backend sci --classpath src:test test/run_portable.cljk"}
  :mutation-harness {:preflight "kbb --backend sci tools/check-mutations.cljk"
                     :run "kbb --backend sci tools/mutate.cljk"
                     :run-under-nbb
                     "MUTATE_CMD='kbb --backend sci --classpath src:test test/run_portable.cljk' kbb --backend sci tools/mutate.cljk"}
  ;; The engine — rows->datoms / build-db / q — is pure and hosts nothing.
  ;; The one host edge is `kotoba-actors.datomic/read-text`: `slurp` on the
  ;; JVM, `node:fs` under ClojureScript.
  :host-edge "kotoba-actors.datomic/read-text"
  ;; NOT compiled in, on purpose. The seeds belong to the actor repositories
  ;; (see :data-boundary above), so embedding them here the way
  ;; kotoba-lang/technology embedded its registry would copy another org's
  ;; data into this repo and create two copies that can disagree. The data
  ;; stays where it is; this library keeps a filesystem on both runtimes.
  :why-not-embedded :data-is-owned-by-the-actor-repositories
  ;; The paths are absolute, resolved once by `kotoba-actors.config`, so the
  ;; suite gives the same answer from any working directory.
  :cwd-independent true
  :known-red
  {:tests 12
   :cause "com-etzhayyim-kadode and com-etzhayyim-tsugite have no data/ tracked in git"
   :note "identical under both runtimes; not a code defect and not fixable from this repo"}}}
