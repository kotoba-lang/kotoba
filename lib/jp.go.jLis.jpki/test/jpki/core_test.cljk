(ns jpki.core-test
  "**fixture は本物の署名用電子証明書ではない。** 実物は個人情報を含み公開リポジトリに
  置けないので、JPKI と同じ形（nonRepudiation のみ、基本4情報の otherName、
  J-LIS 風の発行者名）に作った合成証明書を使っている。したがってここで検証されて
  いるのは構造の読み取りと拒否条件であって、実カードとの相互運用性ではない。"
  (:require [kotoba.lang.text :as str]
            [kotoba.test :refer [deftest is testing]]
            [asn1.core :as asn1]
            [cms.core :as cms]
            [cms.jvm :as jvm]
            [jpki.core :as jpki]
            [x509.core :as x509]))

(def cert-der (asn1/unhex ""))
(def signature-der (asn1/unhex ""))
(def root-der (asn1/unhex ""))
(def content (asn1/unhex "6b6f746f626120657369676e207465737420636f6e74656e740a"))

(def certificate (x509/parse cert-der))
(def root (x509/parse root-der))
(def signed-data (cms/parse-signed-data signature-der))
(def opts {:content content :roots [root] :digest-fn jvm/digest :verify-fn jvm/verify})

(deftest reads-the-certificate-without-reading-the-person
  (let [parsed (jpki/parse-certificate cert-der)]
    (is (:jpki/shaped? parsed))
    (is (:jpki/issuer-hint-matches? parsed))
    (is (= #{:non-repudiation} (:jpki/key-usage parsed)))
    (testing "and the 基本4情報 are NOT in what parse returns"
      (let [text (pr-str parsed)]
        (is (not (str/includes? text "山田")))
        (is (not (str/includes? text "19850312")))
        (is (not (str/includes? text "霞が関")))))))

(deftest basic-four-is-read-only-when-it-is-asked-for
  (let [four (jpki/basic-four certificate)]
    (is (= #{:name :birth-date :sex :address} (set (keys four))))
    (is (= "19850312" (:birth-date four)))
    (testing "and the sex code is returned as the code, not translated"
      (is (= "1" (:sex four))))))

(deftest the-shape-check-is-a-shape-check
  (testing "a certificate without nonRepudiation is not a signature certificate"
    (is (not (jpki/signature-certificate-shaped?
              (assoc certificate :x509/extensions
                     (remove #(= :key-usage (:name %)) (:x509/extensions certificate)))))))
  (testing "nor is one with no 基本4情報 otherName"
    (is (not (jpki/signature-certificate-shaped?
              (assoc certificate :x509/extensions
                     (remove #(= :subject-alt-name (:name %))
                             (:x509/extensions certificate)))))))
  (testing "nor a CA"
    (is (not (jpki/signature-certificate-shaped? root)))))

(deftest verifies-a-signature-made-by-that-certificate
  (let [result (jpki/verify-signature signed-data (assoc opts :at "2026-08-01T00:00:00Z"))]
    (is (:verified result) (pr-str result))
    (is (true? (boolean (:basic-four-available? result))))
    (testing "and says, every time, that it did not check revocation"
      (is (= :not-checked (:revocation result)))
      (is (some? (jpki/revocation-note result)))
      (is (str/includes? (jpki/presumption-note result) "失効確認をしていない")))))

(deftest without-roots-it-refuses-rather-than-verifying-nothing
  ;; A verification against an empty trust set succeeds trivially and means
  ;; nothing, which is the worst of both.
  (is (thrown-with-msg? clojure.lang.ExceptionInfo #"何も検証しません"
                        (jpki/verify-signature signed-data (assoc opts :roots [])))))

(deftest the-refusals
  (testing "a certificate no supplied root issued"
    (let [other (x509/parse (asn1/unhex ""))]
      (is (= :not-issued-by-a-trusted-root
             (:reason (jpki/verify-signature signed-data (assoc opts :roots [other])))))))

  (testing "a signing time outside the certificate's validity"
    (is (= :certificate-not-valid-at-signing-time
           (:reason (jpki/verify-signature signed-data (assoc opts :at "2020-01-01T00:00:00Z"))))))

  (testing "the wrong content"
    (is (= :message-digest-mismatch
           (:reason (jpki/verify-signature signed-data
                                           (assoc opts :content (asn1/unhex "00")))))))

  (testing "and every refusal still reports revocation as unchecked"
    (doseq [result [(jpki/verify-signature signed-data (assoc opts :content (asn1/unhex "00")))
                    (jpki/verify-signature signed-data (assoc opts :at "2020-01-01T00:00:00Z"))]]
      (is (= :not-checked (:revocation result))))))
