;; Port of kotobase.protocols.http (http.cljk), Kotoba-native.
;;
;; Ring-shaped request/response plumbing shared by every protocol surface in
;; kotobase-protocols.
;;
;; A request is plain data (a :document map):
;;   {:method  :get|:put|:post|:head|:delete
;;    :host    "s3.kotobase.net"          ; optional (router uses it)
;;    :path    "/bucket/key"
;;    :query   {"prefix" "a/"}            ; string keys, string values
;;    :headers {"content-type" "..."}     ; lower-case string keys
;;    :body    "..."}                     ; string body (v0.1; binary is a follow-up)
;;
;; A response is {:status int :headers {...} :body string-or-nil}, also a
;; :document map. Handlers are pure: (handle ctx req) -> resp.
;;
;; Named divergences from http.cljk:
;;   - header lookup lower-cases with `ascii-lower` (kotoba.lang.text). The
;;     source uses host-locale `str/lower`; Kotoba has no host-locale lower.
;;     HTTP header names are ASCII, so the result is identical for them.
;;   - the header/query/response maps are :document values. Dynamic string keys
;;     are kept as string documents (`document-string`), not converted to
;;     keywords: `keyword-from-string` is closed-world on amu (a runtime keyword
;;     traps at run time), so it cannot key a map built from input text.
;;   - nil is expressed as [:option ...] (option-or supplies the source's
;;     `(or x "")` / nil defaults).
;;
;; Blockers (see also the comment above `response`):
;;   B1 multi-arity export (amu E2138): `response` and `not-found` cannot be
;;      exported; they are unexported here. Acceptance cases that need them
;;      from outside (response 2-arity, not-found with no argument) are blocked.
;;   B2 dependency: `(:require [kotoba.lang.text :as str])`. The public
;;      `amu check` takes one source file (no explicit source paths), so
;;      E6002 "required module kotoba.lang.text is missing from the explicit
;;      source paths" is raised. The module itself also fails `amu check`
;;      (E2104 type mismatch in 'join').
;;   B3 export return type: on this host an exported function must return
;;      :i64 (verified: exports returning :string, :bool, :document or a list
;;      fail with E2104 "expected :i64"; :i64 and string-parameter exports
;;      pass). Every export of this module returns a non-i64 value, so the
;;      module cannot pass `amu check` on this host even with B2 resolved.
;;   The `keyword-from-string` route was rejected during the port: it is
;;   closed-world on amu and traps at run time (see the map-key comment).

(ns kotobase.protocols.http
  (:export [segments query-param header text method-not-allowed xml-escape])
  (:require [kotoba.lang.text :as str]))

(defn- map-key [name :string] :document
  (document-string name))

(defn- doc-field [m :document k :keyword] :document
  (option-or (document-get m k) (document-null)))

(defn- doc-key [m :document k :document] :document
  (option-or (document-get m k) (document-null)))

(defn segments
  "Path -> vector of decoded, non-empty segments: \"/a//b\" -> [\"a\" \"b\"]."
  [path [:option :string]] [:list :string]
  (let [parts (str/split (option-or path "") "/")
        n (count parts)]
    (loop [i 0 acc (typed-list-new [:list :string])]
      (if (>= i n)
        acc
        (let [part (typed-list-nth [:list :string] parts i)]
          (recur (+ i 1)
                 (if (str/blank? part)
                   acc
                   (typed-list-conj [:list :string] acc part))))))))

(defn query-param [req :document k :string] [:option :string]
  (document-string-value (doc-key (doc-field req :query) (map-key k))))

(defn header [req :document k :string] [:option :string]
  (document-string-value
   (doc-key (doc-field req :headers) (map-key (str/ascii-lower k)))))

;; BLOCKER (multi-arity export, amu E2138): `response` (arities 3 and 2) and
;; `not-found` (arities 1 and 0) are multi-arity. amu accepts multi-arity
;; definitions but refuses to export them ("a multi-arity or variadic function
;; cannot be exported"). They are therefore ported unexported below, so they
;; are not part of this module's public surface until amu can export them.
;; Consequence: the acceptance cases `response` 2-arity and `not-found` with no
;; argument cannot be called from outside this module yet.
(defn- response
  ([status :i64 headers :document body :document] :document
   (document-map :status (document-i64 status)
                 :headers headers
                 :body body))
  ([status :i64 body :document] :document
   (response status (document-map) body)))

(defn text [status :i64 body :string] :document
  (response status
            (document-assoc (document-map) (map-key "content-type")
                          (document-string "text/plain; charset=utf-8"))
            (document-string body)))

(defn- not-found
  ([] :document (not-found "not found"))
  ([msg :string] :document (text 404 msg)))

(defn method-not-allowed [] :document
  (text 405 "method not allowed"))

(defn xml-escape [s [:option :string]] :string
  (let [a (str/replace (option-or s "") "&" "&amp;")
        b (str/replace a "<" "&lt;")
        c (str/replace b ">" "&gt;")]
    (str/replace c "\"" "&quot;")))
