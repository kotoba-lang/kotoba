;; Oracle acceptance test for kotobase.protocols.http (port of http.cljk).
;; main returns the number of failed cases (0 = all pass).
;; Check/compile/run needs `amu compile ENTRY --source-path <src> --source-path <root with
;; kotoba.lang.text and its kotoba.string deps>` (amu#1827, JUN-838); the shipped
;; bin/amu rejects --source-path until that lands. Cases needing the private
;; `response` and `not-found` are omitted until amu can export multi-arity
;; functions (JUN-840). No cljk oracle comparison has been recorded yet (JUN-828).
(ns kotobase.protocols.http-oracle-test
  (:export [main])
  (:require [kotobase.protocols.http :as http]))

(defn- chk-str [got :string want :string] :i64
  (if (string=? got want) 0 1))
(defn- lst [xs [:list :string]] :string
  (let [n (count xs)]
    (loop [i 0 acc "["]
      (if (>= i n)
        (string-concat acc "]")
        (recur (+ i 1)
               (string-concat (if (= i 0) acc (string-concat acc ","))
                              (typed-list-nth [:list :string] xs i)))))))
(defn- chk-list [got [:list :string] want :string] :i64
  (chk-str (lst got) want))
(defn- sopt [o [:option :string]] :string (option-or o "<none>"))
(defn main [] :i64
  (let [a (chk-list (http/segments (option-some-of [:option :string] "/a//b")) "[a,b]")
        b (chk-list (http/segments (option-some-of [:option :string] "")) "[]")
        c (chk-list (http/segments (option-some-of [:option :string] "/")) "[]")
        d (chk-list (http/segments (option-some-of [:option :string] "a/b/")) "[a,b]")
        e (chk-list (http/segments (option-some-of [:option :string] "///")) "[]")
        hdrs (document-assoc (document-map) (document-string "content-type") (document-string "x"))
        req (document-assoc (document-map) :headers hdrs)
        f (chk-str (sopt (http/header req "Content-Type")) "x")
        n (chk-str (http/xml-escape (option-some-of [:option :string] "a&b<c>\"d")) "a&amp;b&lt;c&gt;&quot;d")]
    (+ a (+ b (+ c (+ d (+ e (+ f n))))))))
