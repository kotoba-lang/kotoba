{:paths ["src"]
 ;; src needs three things and no more: the block port and HTTP/JSON shapes
 ;; from protocol-core, the selector and Data Model from io-ipld, and the CAR
 ;; framing from io-ipld-car. Every pin below is a commit on that repo's
 ;; default branch — an unmerged SHA is a dependency that disappears when its
 ;; branch does (root AGENTS.md, `deps.edn` pins have no `verify-west-pins`).
 :deps {
        ;; kotoba.bytes replaced UTF-8 .getBytes / String. here (2026-09-24). An explicit
        ;; floor: tools.deps takes the NEWEST sha it is shown.
        io.github.kotoba-lang/bytes {:git/sha "d5259f35ab7c4f5a66e63ca29ed4dcf7ba3f1ac5"}
        ;; kotoba.test (clojure.test-compatible surface), not clojure.test --
        ;; scripts/migrate-clojure-test-to-kotoba-test.cljk. Explicit floor.
        io.github.kotoba-lang/test {:git/url "https://github.com/kotoba-lang/test.git"
                                    :git/sha "2ab4885f99fd25552d380d0f6b0b54c5a72eb7ae"}
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
        ;; A floor for `sha256-provider`, not a new dependency: io-ipld
        ;; already brings multiformats in, and what it brought was old enough
        ;; that a consumer could not ASK which digest it was paying for.
        ;; That question is the whole point here — the portable SHA-256 costs
        ;; 202 ms a file under SCI against 0.7 ms to read the file, measured
        ;; on 82 real documents, and `fs-cli` now installs the host digest
        ;; through `install-sha256!`. An install nobody can verify took
        ;; effect is an install nobody has checked.
        io.github.kotoba-lang/io-multiformats {:git/sha "dbb877ed22e87ba68d74d995dd8cbe6cf8f24970"}
       ;; Tracks protocol-core's `main` tip; it is not held back for a reason.
        ;; A reader who finds this behind the default branch should advance it
        ;; rather than look for the justification that would have to be written
        ;; here if it were deliberately frozen (root AGENTS.md: a pin's default
        ;; state is the upstream default-branch tip).
        io.github.kotoba-lang/kotobase-protocol-core
        {:git/sha "ca3874d2dababed63bb1c357722c8a38e4a3a812"}
        ;; Floor, not a preference. Before 2200e3c0 `ipld/get-verified-block`
        ;; threw `block codec is not dag-cbor` for every other codec, so
        ;; `ipld.graph` -- this handler's traversal core -- could not cross a
        ;; link into a RAW block. Raw is the ordinary shape of a byte leaf, and
        ;; the live surface answered HTTP 500 for exactly that selector while
        ;; answering 200 for a string one position away (measured 2026-09-08,
        ;; io-ipld#35). Below this SHA the handler is correct and the traversal
        ;; under it is not.
        ;; 9bf07ce7 (2026-09-11) lifts the second version of that same
        ;; failure: a block whose CID declares dag-json is now verified under
        ;; its own codec and decoded, so a traversal crosses into it instead of
        ;; raising `:ipld/unsupported-codec` -- which this handler had, until
        ;; the day before, re-thrown as a Cloudflare 500. Below this SHA the
        ;; refusal is named correctly and the traversal still stops there.
        ;; 1b210253 additionally carries versioned ADL enforcement on the
        ;; representation->logical and logical->representation paths. The IPQ
        ;; filesystem adapter names KotobaFsSnapshot v1; below this SHA a v2
        ;; capability under the same name is silently accepted as v1.
        io.github.kotoba-lang/io-ipld
        {:git/sha "1b21025327e63652e533b54303b5e7b8e11f59ba"}
        ;; Floor, not a preference: `ipld.car.trustless/replay-selection` and
        ;; the bounded CARv2 index reads landed on 2026-09-06 and this surface
        ;; is meaningless without the first of them — a CAR nobody can replay
        ;; is not a proof.
        io.github.kotoba-lang/io-ipld-car
        {:git/sha "6a67a81f2c47e8dc5945c19d289a9043afdbb2eb"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
