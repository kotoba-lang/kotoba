{:paths ["src"]
 ;; kotobase.query.surfaces composes the four query surfaces onto one router
 ;; ctx. Each surface is its own repository (a consumer of the shared query
 ;; bridge, ayatori.query); this library is the composition the deployments
 ;; (graph.kotoba.cloud, yataverse.com) mount. Pinned by full sha as explicit
 ;; floors: tools.deps takes the NEWEST sha it is shown, so without a floor
 ;; here this repo silently rides whatever a sibling happens to name.
 :deps {org.clojure/clojure {:mvn/version "1.12.4"}
        io.github.kotoba-lang/text
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "b94158fd48ec541b70d3c455912a06f407537ddc"
         :deps/root "lib/kotoba.text"}
        io.github.kotoba-lang/ayatori
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "b94158fd48ec541b70d3c455912a06f407537ddc"
         :deps/root "lib/kotoba.ayatori"}
        io.github.kotoba-lang/org-opencypher-cypher
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "b94158fd48ec541b70d3c455912a06f407537ddc"
         :deps/root "lib/org.opencypher.cypher"}
        io.github.kotoba-lang/org-w3-sparql-protocol
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "b94158fd48ec541b70d3c455912a06f407537ddc"
         :deps/root "lib/org.w3.sparqlProtocol"}
        io.github.kotoba-lang/org-apache-tinkerpop-gremlin
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "b94158fd48ec541b70d3c455912a06f407537ddc"
         :deps/root "lib/org.apache.tinkerpopGremlin"}
        io.github.kotoba-lang/org-graphql-http
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "b94158fd48ec541b70d3c455912a06f407537ddc"
         :deps/root "lib/org.graphql.http"}
        ;; kotobase.protocols.http / .json — the shared bottom of the protocol
        ;; stack (public since 2026-09-17, ADR-2609171500 step 1)
        io.github.kotoba-lang/kotobase-protocol-core
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "b94158fd48ec541b70d3c455912a06f407537ddc"
         :deps/root "lib/kotoba.kotobaseProtocolCore"}
        io.github.kotoba-lang/kotobase
        {:git/url "https://github.com/kotoba-lang/kotobase.git"
         :git/sha "3c016dc833649db1f6ab4076a5c319c8c40aa90e"}}
 ;; First-class runtime is kbb/cljs. In the west workspace every dependency
 ;; is a sibling checkout, so the test command lists their src dirs:
 ;;   kbb --backend sci --classpath "src:test:../text/src:../ayatori/src:../org-opencypher-cypher/src:../org-w3-sparql-protocol/src:../org-apache-tinkerpop-gremlin/src:../org-graphql-http/src:../kotobase-protocol-core/src:../kotobase/src:../kotobase-query/src:../arrangement/src:../prolly-tree/src:../io-ipld/src:../io-multiformats/src:../org-nist-sha2/src:../org-ietf-cbor/src:../dev-protobuf/src:../datalog/src:../io-ipni-specs/src:../sparql/src:../graphql/src:../datom/src:../datom-source/src:../kotobase-projection/src:../chain/src:../kotobase-block-codec/src:../org-ietf-deflate/src:../kotobase-peer/src:../kotobase-lake/src:../kotobase-client/src" bin/run_tests.cljk
 ;; (bin/run_tests.cljk lists the full chain it needs.)
 :aliases {:test {:extra-paths ["test"]}}}
