index 0000000..37d9a0b
--- /dev/null
+++ b/bin/ipq_fs_materialize.cljk
@@ -0,0 +1,12 @@
+(ns ipq-fs-materialize
+  (:require [kotobase.protocols.ipq.fs-cli :as cli]))
+
+(try
+  (println (pr-str (cli/run! *command-line-args*)))
+  (catch :default e
+    (let [data (ex-data e)]
+      (binding [*print-fn* *print-err-fn*]
+        (println (str "REFUSE\t" (name (or (:problem data) :unexpected))
+                      "\t" (.-message e))))
