+    (is (= "1" (fs/app-data mount "/workspace/docs/readme.txtEXISTS_SEP")))
+    (is (= "0" (fs/app-data mount "/workspace/missingEXISTS_SEP")))
+    (is (= "0 10 0 0" (fs/app-data mount "/workspace/root.txtSTAT_SEP")))
