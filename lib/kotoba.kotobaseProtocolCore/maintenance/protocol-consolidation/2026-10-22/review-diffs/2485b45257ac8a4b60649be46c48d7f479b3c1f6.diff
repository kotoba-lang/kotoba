+(def snapshot
+  {"version" 1
+   "entries" [{"path" "/workspace" "type" "directory"}
+              {"path" "/workspace/docs" "type" "directory"}
+              {"path" "/workspace/docs/readme.txt" "type" "file"
+               "text" "alpha\nbeta\nalpha\n"}
+              {"path" "/workspace/root.txt" "type" "file" "text" "root 😀\n"}]})
+
+(defn snapshot-adl []
+  {:version 1
+   :validate-representation (fn [value]
+                              (try (do (bytes/bcount value) true)
+                                   (catch #?(:clj Exception :cljs :default) _ false)))
+   :decode ipld/decode
+   :encode ipld/encode
+   :validate-logical map?
+   :fuel-costs {:validate-representation 1 :decode 1 :encode 1 :validate-logical 1}})
+
+(defn base64url [b]
+  (-> (dag-json/base64-encode b)
+      (str/replace "+" "-")
+      (str/replace "/" "_")
+      (str/replace "=" "")))
+
+(defn fixture-for [logical]
+  (let [representation (ipld/encode logical)
+        root (mf/cidv1-raw representation)
+        ctx {:blocks {:get (fn [cid]
+                             (when (= cid root)
+                               {:bytes representation
+                                :content-type "application/vnd.ipld.raw"}))}}
+        response (ipq/handle ctx
+                             {:method :get
+                              :path (str "/ipq/v1/selection/" root)
+                              :headers {}
+                              :query {"selector" (base64url fs/snapshot-selector-bytes)}})
+        car-bytes (bytes/as-bytes (dag-json/base64-decode (:body response)))]
+    {:root root :response response :car-bytes car-bytes}))
+
+(defn fixture [] (fixture-for snapshot))
+
+(defn mounted []
+  (let [{:keys [root car-bytes]} (fixture)]
+    (fs/mount {:car-bytes car-bytes :root root :scope-root "/workspace"
+               :adl-capability (snapshot-adl)})))
+
+(defn problem [f]
+  (try (do (f) nil)
+       (catch js/Error e
+         (or (:problem (ex-data e)) (:type (ex-data e))))))
+
+(deftest ipq-car-adl-and-filesystem-capabilities-form-one-verified-path
+  (let [{:keys [response]} (fixture)
+        mount (mounted)
+        providers (fs/provider-registry mount)]
+    (is (= 200 (:status response)) "the fixture really crossed the IPQ handler")
+    (is (= #?(:clj :kotobase.ipq/fs-mount-v1
+              :cljs :kotobase.ipq/fs-disk-mount-v1)
+           (:format mount)))
+    #?(:cljs (do (is (string? (:local-root mount)))
+                 (is (nil? (get-in mount [:entries "/workspace/root.txt" "text"])))
+                 (is (every? #(nil? (get % "text"))
+                             (mapcat val (:children-by-parent mount))))
+                 (is (= "root 😀\n"
+                        (.readFileSync node-fs-test
+                                       (.join node-path-test (:local-root mount) "root.txt")
+                                       "utf8"))))
+       :clj nil)
+    (is (= 1 (:ipq-profile mount)))
+    (is (= [(:root mount)] (get-in mount [:receipt :loaded])))
+    (is (true? (get-in mount [:receipt :adl-determinism-checked?])))
+    (is (= #{34 35} (set (keys providers))))
+    (is (= "docs\t1\nroot.txt\t0" (fs/browse mount "/workspace")))
+    (is (= "readme.txt\t0" (fs/browse mount "/workspace/docs")))
+    (is (= "alpha\nbeta\nalpha\n"
