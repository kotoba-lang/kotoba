+(deftest naming-every-file-gives-the-same-cid-as-walking-for-them
+  ;; The root CID is a function of the encoded entries, so the two routes
+  ;; have to agree about their order or the same tree would have two
+  ;; identities depending on which flag produced it.
+  (let [temp (.mkdtempSync node-fs (.join node-path (.tmpdir node-os) "ipq-fs-same-"))
+        tree (.join node-path temp "tree")
+        docs (.join node-path tree "docs")
+        listed (.join node-path temp "paths.txt")]
+    (try
+      (.mkdirSync node-fs docs #js {:recursive true})
+      (.writeFileSync node-fs (.join node-path tree "b.txt") "b\n")
+      (.writeFileSync node-fs (.join node-path tree "a.txt") "a\n")
+      (.writeFileSync node-fs (.join node-path docs "c.txt") "c\n")
+      (.writeFileSync node-fs listed "b.txt\na.txt\ndocs/c.txt\n")
+      (let [walked (cli/run! ["snapshot" "--tree" tree "--scope-root" "/w"
+                              "--car" (.join node-path temp "w.car")
+                              "--blocks-dir" (.join node-path temp "wb")])
+            named (cli/run! ["snapshot" "--tree" tree "--scope-root" "/w"
+                             "--car" (.join node-path temp "n.car")
+                             "--blocks-dir" (.join node-path temp "nb")
+                             "--paths" listed])]
+        (is (= (:entries walked) (:entries named)))
+        (is (= (:root walked) (:root named))))
+      (finally
+        (fixture/test-make-writable! temp)
+        (.rmSync node-fs temp #js {:recursive true :force true})))))
