+      (.writeFileSync node-fs (.join node-path tree "wanted.txt") "a\n")
+      (.writeFileSync node-fs (.join node-path docs "wanted.txt") "b\n")
+      (.writeFileSync node-fs (.join node-path tree "ignored.bin") "c\n")
+      (.writeFileSync node-fs listed
+                      "# the two documents, not the third file\nwanted.txt\ndocs/wanted.txt\n")
+      (let [written (cli/run! ["snapshot" "--tree" tree "--scope-root" "/w"
+                               "--car" (.join node-path temp "a.car")
+                               "--blocks-dir" blocks "--paths" listed])]
