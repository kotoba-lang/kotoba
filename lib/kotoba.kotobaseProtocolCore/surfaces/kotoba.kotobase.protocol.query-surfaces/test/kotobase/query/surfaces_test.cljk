(ns kotobase.query.surfaces-test
  "Host-free checks on the composition. Ported from the deployment shell's
  core_test (cloud-kotoba/control-plane/protocols-worker) on 2026-09-17."
  (:require [cljs.test :refer [deftest is testing]]
            [kotobase.query.surfaces :as surfaces]))

(def four #{"sparql" "cypher" "gremlin" "graphql"})

(deftest the-four-surfaces-are-mounted-once-each
  (testing "surfaces (by name) and path-surfaces (by mount path) name the same four"
    (is (= four (set (keys surfaces/surfaces))))
    (is (= four (set (vals surfaces/path-surfaces))))
    (is (= 5 (count surfaces/path-surfaces))
        "five mount paths: SPARQL is reachable at its own endpoint AND at the RDF4J repository path")))

(deftest capabilities-name-the-four-surfaces
  (testing "the capabilities document a deployment serves at /capabilities lists each surface"
    (let [text (pr-str surfaces/capabilities)]
      (doseq [s four]
        (is (re-find (re-pattern s) text) (str s " must appear in capabilities"))))))

(deftest rdf4j-compatibility-names-only-the-default-repository
  (let [ctx {:visible? (constantly true)}
        unknown (surfaces/sparql-handle ctx {:method :post
                                             :path "/repositories/tenant-a"
                                             :headers {"content-type" "application/sparql-query"}
                                             :body "ASK { ?s ?p ?o }"})]
    (is (= 404 (:status unknown)))
    (is (re-find #"repositories/default" (:body unknown))))
  (is (true? (surfaces/rdf4j-default-path? "/repositories/default")))
  (is (true? (surfaces/rdf4j-default-path? "/repositories/default/")))
  (is (false? (surfaces/rdf4j-default-path? "/repositories/tenant-a"))))

(deftest a-visible-predicate-is-required-not-defaulted
  (testing "visible-everything is an explicit deployment decision, exported as a value"
    (is (fn? surfaces/visible-everything))
    (is (true? (surfaces/visible-everything {:e 1 :a :x :v 2})))))

(deftest enrich-derives-surfaces-from-an-empty-store-without-a-host
  (testing "enrich runs on every request with no host: an empty in-memory state is enough"
    (let [ctx (surfaces/enrich {:store nil} {:docs {}})]
      (is (map? ctx))
      (is (= four (set (keys (:surfaces ctx)))))
      (is (= four (set (vals (:path-surfaces ctx)))))
      (is (fn? (:visible? ctx)) "the deployment decision travels with the ctx")
      (is (nil? (:query-memo ctx)) "no surface named -> no memo offered (both halves or neither)"))
    (let [ctx (surfaces/enrich {:store nil} {:docs {}} "sparql")]
      (is (some? (:query-memo ctx)) "a read-only surface gets the memo")
      (is (some? (:query-version ctx))))))
