(ns kotobase.lfs.pointer
  "The Git LFS pointer file — the thing that is actually committed to the
  repository in place of the bytes.

      version https://git-lfs.github.com/spec/v1
      oid sha256:4d7a214614ab2935c943f9e0ff69d22eadbb8f32b1258daaa5e2ca24d17e2393
      size 12345

  The format is deliberately rigid: keys after `version` are sorted, every
  line ends with LF, and the file must end with one. A pointer that differs
  by a byte is a different blob with a different Git OID, so generating a
  variant spelling of the same pointer silently makes the repository dirty
  for every other client.

  Pure and dependency-free: parsing a pointer is how the server learns which
  object a ref needs, and that must work in a Worker."
  (:require [kotoba.lang.text :as str]))

(def spec-version "https://git-lfs.github.com/spec/v1")

(def ^:private oid-re #"^sha256:([0-9a-f]{64})$")

;; The spec caps a pointer at 200 bytes for the required keys; real pointers
;; with extensions can be larger. This bound exists so a caller cannot be made
;; to parse a 4 GB "pointer" — it is a denial-of-service limit, not a format
;; claim.
(def ^:const max-pointer-bytes 4096)

(defn parse
  "Pointer text → {:oid hex :size n :extensions {…}}, or {:error kw}.

  Returns `:error :not-a-pointer` for anything that does not start with the
  version line, which is the check LFS itself uses to decide whether a blob
  is a pointer at all — so this must not throw on ordinary file content."
  [text]
  (cond
    (not (string? text)) {:error :not-a-string}
    (> (count text) max-pointer-bytes) {:error :too-large}
    :else
    (let [lines (str/split text #"\n")
          kvs (keep (fn [l]
                      (when (seq l)
                        (let [i (str/index-of l " ")]
                          (when (and i (pos? i))
                            [(subs l 0 i) (subs l (inc i))]))))
                    lines)
          m (into {} kvs)]
      (cond
        (not= spec-version (get m "version")) {:error :not-a-pointer}
        (not (contains? m "oid")) {:error :missing-oid}
        (not (contains? m "size")) {:error :missing-size}
        :else
        (let [[_ hex] (re-matches oid-re (get m "oid"))
              size-str (get m "size")
              size #?(:clj (try (Long/parseLong size-str) (catch Exception _ nil))
                      :cljs (when (re-matches #"^[0-9]+$" size-str)
                              (js/parseInt size-str 10)))]
          (cond
            (nil? hex) {:error :unsupported-oid}
            (or (nil? size) (neg? size)) {:error :bad-size}
            :else {:oid hex
                   :size size
                   :extensions (dissoc m "version" "oid" "size")}))))))

(defn pointer?
  "Cheap test used to decide whether a blob is a pointer at all."
  [text]
  (and (string? text) (str/starts-with? text (str "version " spec-version "\n"))))

(defn render
  "{:oid hex :size n} → the canonical pointer text.

  Byte-exact: version first, remaining keys sorted, LF endings, trailing LF."
  [{:keys [oid size extensions]}]
  (when-not (re-matches #"^[0-9a-f]{64}$" (str oid))
    (throw (ex-info "LFS pointer oid must be lower-case sha256 hex"
                    {:type :kotobase.lfs/invalid-oid :oid oid})))
  (when-not (and (integer? size) (not (neg? size)))
    (throw (ex-info "LFS pointer size must be a non-negative integer"
                    {:type :kotobase.lfs/invalid-size :size size})))
  (->> (concat [["version" spec-version]]
               (sort-by first (concat [["oid" (str "sha256:" oid)]
                                       ["size" (str size)]]
                                      (seq extensions))))
       (map (fn [[k v]] (str k " " v "\n")))
       (apply str)))
