(ns kotobase.lfs.pointer-test
  (:require #?(:clj [kotoba.test :refer [deftest is testing]]
               :org.babashka/nbb [kotoba.test :refer [deftest is testing]]
               :cljs [kotoba.test.cljs :refer-macros [deftest is testing]])
            [kotobase.lfs.pointer :as pointer]))

(def hex "039058c6f2c0cb492c533b0a4d14ef77cc0f78abccced5287d84a1a2011cfb81")

(def text
  (str "version https://git-lfs.github.com/spec/v1\n"
       "oid sha256:" hex "\n"
       "size 3\n"))

(deftest round-trips-byte-exactly
  (is (= {:oid hex :size 3 :extensions {}} (pointer/parse text)))
  (is (= text (pointer/render {:oid hex :size 3})))
  (testing "a pointer that differs by a byte is a different Git blob, so
            render must not invent a spelling"
    (is (= text (pointer/render (pointer/parse text))))))

(deftest ordinary-file-content-is-not-a-pointer
  (testing "LFS calls this on every blob; it must answer, not throw"
    (is (= {:error :not-a-pointer} (pointer/parse "#!/bin/sh\necho hi\n")))
    (is (= {:error :not-a-pointer} (pointer/parse "")))
    (is (false? (pointer/pointer? "oid sha256:x\n")))
    (is (true? (pointer/pointer? text)))))

(deftest malformed-pointers-are-named-not-guessed
  (is (= {:error :missing-oid}
         (pointer/parse "version https://git-lfs.github.com/spec/v1\nsize 3\n")))
  (is (= {:error :missing-size}
         (pointer/parse (str "version https://git-lfs.github.com/spec/v1\noid sha256:" hex "\n"))))
  (is (= {:error :unsupported-oid}
         (pointer/parse (str "version https://git-lfs.github.com/spec/v1\n"
                             "oid sha512:" hex "\nsize 3\n"))))
  (is (= {:error :bad-size}
         (pointer/parse (str "version https://git-lfs.github.com/spec/v1\n"
                             "oid sha256:" hex "\nsize -1\n"))))
  (is (= {:error :too-large} (pointer/parse (apply str (repeat 5000 "x")))))
  (is (= {:error :not-a-string} (pointer/parse nil))))

(deftest render-refuses-what-it-cannot-spell
  (is (thrown? #?(:clj Exception :cljs js/Error)
               (pointer/render {:oid "ABC" :size 3})))
  (is (thrown? #?(:clj Exception :cljs js/Error)
               (pointer/render {:oid hex :size -1}))))

(deftest extensions-survive
  (let [t (str "version https://git-lfs.github.com/spec/v1\n"
               "ext-0-foo sha256:" hex "\n"
               "oid sha256:" hex "\n"
               "size 3\n")]
    (is (= {(str "ext-0-foo") (str "sha256:" hex)}
           (:extensions (pointer/parse t))))
    (is (= t (pointer/render (pointer/parse t)))
        "keys after version are sorted, so an extension round-trips in place")))
