(ns kotobase.lfs.batch-test
  "What the wire layer owes callers independently of any store."
  (:require #?(:clj [kotoba.test :refer [deftest is testing]]
               :org.babashka/nbb [kotoba.test :refer [deftest is testing]]
               :cljs [kotoba.test.cljs :refer-macros [deftest is testing]])
            [kotobase.lfs.batch :as batch]))

(def oid "039058c6f2c0cb492c533b0a4d14ef77cc0f78abccced5287d84a1a2011cfb81")

(deftest the-media-type-gate
  (is (true? (batch/accepts? "application/vnd.git-lfs+json")))
  (is (true? (batch/accepts? "application/vnd.git-lfs+json; charset=utf-8")))
  (is (false? (batch/accepts? "application/json")))
  (is (false? (batch/accepts? nil))))

(deftest an-error-carries-its-status-because-lfs-reads-status
  (testing "this is not XRPC: a 200 with a failure body reads as success to
            every LFS client, and the datom plane on the same host uses the
            opposite convention"
    (let [e (batch/error 507 "quota exhausted" "req-1")]
      (is (= 507 (:status e)))
      (is (= {:message "quota exhausted" :request_id "req-1"} (:body e))))))

(defn- leaf-values
  "Values only. Keys are keywords by design — they become JSON object names."
  [x]
  (cond
    (map? x) (mapcat leaf-values (vals x))
    (sequential? x) (mapcat leaf-values x)
    :else [x]))

(deftest wire-values-are-strings-and-numbers-only
  (testing "a keyword value becomes a JSON string that never round-trips back
            to a keyword, so the map means something different after one hop"
    (let [body (batch/response
                [(batch/object-with-actions
                  {:oid oid :size 3}
                  {:download (batch/action {:href "https://x.invalid/o"
                                            :expires-in 60})})
                 (batch/object-error {:oid oid :size 3} 404 "Object does not exist")])]
      (is (seq (leaf-values body)))
      (is (every? (fn [v] (or (string? v) (number? v) (boolean? v)))
                  (leaf-values body))))))

(deftest a-default-batch-needs-no-transfers-field
  (testing "the field is optional; absent means basic"
    (is (= "download" (:operation (batch/parse-request
                                   {:operation "download"
                                    :objects [{:oid oid :size 3}]}))))))

(deftest the-ref-name-is-carried-through
  (is (= "refs/heads/main"
         (:ref (batch/parse-request {:operation "download"
                                     :objects [{:oid oid :size 3}]
                                     :ref {:name "refs/heads/main"}})))))
