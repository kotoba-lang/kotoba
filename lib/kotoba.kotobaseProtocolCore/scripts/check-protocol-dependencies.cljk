(ns check-protocol-dependencies
  (:require [cljs.reader :as edn] [clojure.walk :as walk]
            ["node:fs" :as fs] ["node:path" :as path]))
(def root (.cwd js/process))
(def imports (js->clj (js/JSON.parse (fs/readFileSync (path/join root "maintenance/protocol-source-imports.json") "utf8")) :keywordize-keys true))
(defn read-edn [file] (edn/read-string (fs/readFileSync file "utf8")))
(defn localize [value]
  (walk/postwalk (fn [v] (if (and (map? v) (contains? v 'io.github.kotoba-lang/kotobase-protocol-core))
                          (assoc v 'io.github.kotoba-lang/kotobase-protocol-core {:local/root "../.."}) v)) value))
(assert (= (mapv #(select-keys % [:id :coordinate :imported-sha :sha]) (:dependency-compatibility-overrides imports))
           [{:id "kotoba.kotobase.protocol.lfs" :coordinate "io.github.kotoba-lang/kotobase-storage"
             :imported-sha "84abcc4007fd5d547b15dc36844c6b7e5f42e7ff" :sha "d4f0ac224af5309d326be0b59a2e74b6993d8e82"}]))
(doseq [origin (:imports imports)]
  (let [original-dir (path/join root "maintenance/original-configs" (:id origin))
        old (read-edn (path/join original-dir "deps.edn"))
        old-sci (if (fs/existsSync (path/join original-dir "nbb.edn")) (read-edn (path/join original-dir "nbb.edn")) {})
        current (read-edn (path/join root (:path origin) "deps.edn"))
        sci (read-edn (path/join root (:path origin) "nbb.edn"))]
    (assert (= (:needs-owner origin) (contains? (:deps old) 'io.github.kotoba-lang/kotobase-protocol-core)))
    (assert (= current (if (= (:id origin) "kotoba.kotobase.protocol.lfs")
                         (assoc-in (localize old) [:deps 'io.github.kotoba-lang/kotobase-storage :git/sha] "d4f0ac224af5309d326be0b59a2e74b6993d8e82")
                         (localize old))) (str "external dependency/alias drift: " (:id origin)))
    (assert (= sci (assoc old-sci :paths (or (:paths old-sci) (:paths old)) :deps (:deps current))) (str "SCI graph drift: " (:id origin)))))
(println "Three protocol projects: selected core roots localized; one reviewed LFS storage compiler floor; all other external EDN dependencies/aliases unchanged; SCI graphs explicit.")
