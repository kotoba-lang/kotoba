{:paths ["src" "resources"]
 ;; The mounting layer for kotoba-lang/byoubu backdrops. Deliberately does NOT
 ;; depend on shitsuke / liquid-glass-ui / kotoba-ui: `theme-for` returns the
 ;; plain theme map kotoba-ui.core/theme-css already takes, so the dependency
 ;; arrow points one way (kotoba-ui may consume this; this consumes neither)
 ;; and an app that does not use the design system can still mount a plate.
 ;; Nor does it depend on the kami render stack — that belongs to byoubu's
 ;; :render alias, not to anything a browser loads.
 ;; Runtime deps: byoubu (catalog + facts + plate data) and kotoba-lang/css
 ;; (rules are EDN rendered by css.core, not hand-typed CSS strings — same
 ;; :git/sha liquid-glass-ui and kotoba-ui pin).
 ;; Git coordinates, not :local/root — a downstream consumer that pulls this
 ;; repo as a git dep cannot resolve a sibling path inside ~/.gitlibs. The
 ;; :local alias below is the sibling-checkout workflow.
 :deps {
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}
        io.github.kotoba-lang/byoubu {:local/root "../kotoba.byoubu"}
        io.github.kotoba-lang/css {:local/root "../kotoba.css"}}
 :aliases
 {:test {:extra-paths ["test"]}

  :local {:override-deps {io.github.kotoba-lang/byoubu {:local/root "../byoubu"}
                          io.github.kotoba-lang/css {:local/root "../css"}}}
}}
