{:paths ["src"]
 ;; Zero runtime deps. Resolution planes, the cache and the HTTP client are all
 ;; injected, so this library holds no DHT client, no DNS resolver, no registry
 ;; credentials and no clock — and the whole caching policy is testable without
 ;; any of them.
 :deps {
        io.github.kotoba-lang/http-parse-url {:local/root "../kotoba.http"}
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}}
 :aliases
 {:test {:extra-paths ["test"]}}}
