(ns shomen.coverage
  "正直なカバレッジ報告。

  カタログが答えられることと答えられないことを、**同じ表に**出す。route ごとの
  件数だけを出すと `:unverified` が他と同じ 1 行に見える —— それは「測っていない」
  であって分類ではないので、別の段に出す。"
  (:require [shomen.classify :as c]
            [shomen.requirement :as req]))

(defn summarize
  "entries → `{:entries n :by-route {..} :by-confidence {..} :unverified [ids]
  :undelegable [ids] :conform {..}}`"
  [entries]
  (let [cls (map c/classify entries)]
    {:entries (count entries)
     :by-route (frequencies (map :route cls))
     :by-confidence (frequencies (map :req/confidence entries))
     :unverified (vec (keep #(when (= :unverified (:route %)) (:req/id %)) cls))
     :undelegable (vec (keep #(when (false? (get-in % [:interim :delegable?])) (:req/id %)) cls))
     :conform (select-keys (req/conform entries :full) [:ok? :violations])}))

(defn report
  "人が読む 1 画面。"
  [entries]
  (let [{:keys [entries by-route by-confidence unverified undelegable conform]} (summarize entries)
        line (fn [k v] (str "  " (name k) (apply str (repeat (max 1 (- 22 (count (name k)))) " ")) v))]
    (str "shomen catalog: " entries " entries\n"
         "route\n"
         (apply str (map (fn [[k v]] (str (line k v) "\n")) (sort-by (comp name key) by-route)))
         "confidence\n"
         (apply str (map (fn [[k v]] (str (line k v) "\n")) by-confidence))
         "unverified (route refused, not classified): " (count unverified)
         (when (seq unverified) (str " " (pr-str unverified))) "\n"
         "undelegable interim (principal must act): " (count undelegable)
         (when (seq undelegable) (str " " (pr-str undelegable))) "\n"
         "conform :full " (if (:ok? conform) "ok" (str "VIOLATIONS " (count (:violations conform)))) "\n")))
