(ns shomen.requirement
  "手続き entry の**形**と、その形への適合検査。

  entry は「この手続きは何に縛られ、誰がそう言い、電子の道はどこまで開いて
  いるか」を 1 つの map で言う:

  ```clojure
  {:req/id         :jp-naturalisation-application
   :req/name       \"帰化許可申請\"
   :req/jurisdiction \"JPN\"
   :req/authority  :legal-affairs-bureau
   :req/kind       :application
   :req/analog     [{:a/kind :paper    :a/source :ministerial-ordinance
                     :a/legal-basis \"国籍法施行規則 §2 ①\"}
                    {:a/kind :presence :a/source :ministerial-ordinance
                     :a/legal-basis \"国籍法施行規則 §2 ①（自ら出頭して）\"}]
   :req/electronic {:e/status :not-permitted
                    :e/legal-basis \"同条が書面・出頭を明示\"
                    :e/removes #{}}
   :req/fee        {:fee/channels #{:none}}
   :req/source-urls [\"https://…\"]
   :req/confidence :unverified-seed
   :req/verified   \"2026-08-23\"}
  ```

  ## 2 段階の適合

  - **`core`** — 名前・所管・analog 制約（各々 kind と source と根拠）・電子の状態・
    確度。これを欠くものは『書面要件のカタログ』ではない。
  - **`full`** — さらに種類・出典 URL・確認日・手数料の納付経路。

  `conform` は**違反を全部返す**（最初の 1 件で止めない）。"
  (:require [shomen.vocabulary :as v]))

(def core-keys
  #{:req/id :req/name :req/authority :req/analog :req/electronic :req/confidence})

(def full-keys
  #{:req/kind :req/source-urls :req/verified :req/fee})

(defn- analog-violations [pid analog]
  (if-not (sequential? analog)
    [{:req-id pid :rule :analog-not-a-sequence
      :detail ":req/analog が列でない（空列は『analog 制約が無い』、nil は『知らない』—— 分ける）"}]
    (vec
     (for [[i a] (map-indexed vector analog)
           viol (cond-> []
                  (not (contains? v/analog-kinds (:a/kind a)))
                  (conj {:rule :bad-analog-kind
                         :detail (str "analog[" i "] :a/kind が " (pr-str v/analog-kinds) " に無い")})
                  (not (contains? v/requirement-sources (:a/source a)))
                  (conj {:rule :bad-analog-source
                         :detail (str "analog[" i "] :a/source が閉じた語彙に無い —— 誰がそう言っているか不明な制約は提言の宛先を持たない")})
                  (not (string? (:a/legal-basis a)))
                  (conj {:rule :missing-analog-legal-basis
                         :detail (str "analog[" i "] :a/legal-basis が無い —— 根拠の無い制約は創作である")}))]
       (assoc viol :req-id pid)))))

(defn- electronic-violations [pid e]
  (cond-> []
    (not (map? e))
    (conj {:req-id pid :rule :missing-electronic
           :detail ":req/electronic が無い —— 『知らない』なら {:e/status :unknown} と書く"})

    (and (map? e) (not (contains? v/electronic-statuses (:e/status e))))
    (conj {:req-id pid :rule :bad-electronic-status
           :detail (str ":e/status が " (pr-str v/electronic-statuses) " に無い")})

    (and (map? e) (= :in-force (:e/status e)) (not (set? (:e/removes e))))
    (conj {:req-id pid :rule :in-force-without-removes
           :detail ":e/status :in-force なのに :e/removes（電子の道が消す analog 種類の集合）が無い —— 何が残るかを言えない電子化は『電子化済み』と読まれる"})

    (and (map? e) (= :in-force (:e/status e)) (not (string? (:e/legal-basis e))))
    (conj {:req-id pid :rule :in-force-without-legal-basis
           :detail ":e/status :in-force の根拠法令が無い"})

    (and (map? e) (= :enacted-not-in-force (:e/status e)) (not (string? (:e/commencement e))))
    (conj {:req-id pid :rule :enacted-without-commencement
           :detail ":enacted-not-in-force なのに :e/commencement（施行日・施行期限）が無い —— 『いつまで待つか』を言えない"})))

(defn- v-core [pid p]
  (-> (cond-> []
        (not (keyword? (:req/id p)))
        (conj {:req-id pid :rule :missing-id :detail ":req/id が keyword でない"})

        (not (string? (:req/name p)))
        (conj {:req-id pid :rule :missing-name :detail ":req/name が文字列でない"})

        (not (contains? v/authorities (:req/authority p)))
        (conj {:req-id pid :rule :bad-authority
               :detail (str ":req/authority が " (pr-str v/authorities) " に無い")})

        (not (contains? v/confidences (:req/confidence p)))
        (conj {:req-id pid :rule :bad-confidence
               :detail (str ":req/confidence が " (pr-str v/confidences) " に無い")}))
      (into (analog-violations pid (:req/analog p)))
      (into (electronic-violations pid (:req/electronic p)))))

(defn- v-full [pid p]
  (cond-> []
    (not (contains? v/procedure-kinds (:req/kind p)))
    (conj {:req-id pid :rule :bad-kind :detail ":req/kind が閉じた語彙に無い"})

    (not (seq (:req/source-urls p)))
    (conj {:req-id pid :rule :missing-source-urls
           :detail ":req/source-urls が無い —— 出典の無い記述は検証できない"})

    (not (string? (:req/verified p)))
    (conj {:req-id pid :rule :missing-verified
           :detail ":req/verified（最終確認日）が無い —— 法令は改正される"})

    (not (set? (get-in p [:req/fee :fee/channels])))
    (conj {:req-id pid :rule :missing-fee-channels
           :detail ":req/fee :fee/channels が集合でない（手数料無しは #{:none}）"})

    (let [ch (get-in p [:req/fee :fee/channels])]
      (and (set? ch) (not (every? v/fee-channels ch))))
    (conj {:req-id pid :rule :bad-fee-channel :detail ":fee/channels に閉じた語彙の外の値がある"})

    (let [ch (get-in p [:req/fee :fee/channels])]
      (and (set? ch) (contains? ch :revenue-stamp)
           (not (contains? v/cancel-by (get-in p [:req/fee :fee/cancel-by])))))
    (conj {:req-id pid :rule :stamp-without-cancel-by
           :detail "収入印紙で納める手続きなのに :fee/cancel-by が無い —— 誰が消印するかを言わない印紙の記述は、印紙を無効にする"})))

(defn conform
  "entry の列が形に適合しているかを検査する。`level` は `:core`（既定）か `:full`。
  **違反を全部返す。**

  戻り値: `{:level .. :entries n :violations [..] :ok? bool}`"
  ([entries] (conform entries :core))
  ([entries level]
   (let [vs (vec (mapcat (fn [p]
                           (let [pid (:req/id p)]
                             (cond-> (v-core pid p)
                               (= level :full) (into (v-full pid p)))))
                         entries))]
     {:level level :entries (count entries) :violations vs :ok? (empty? vs)})))

(defn by-id
  "`{id entry}` に引き直す。id 重複は throw せず `:duplicates` で返す。"
  [entries]
  (let [ids (map :req/id entries)
        dup (->> (frequencies ids) (filter (fn [[_ n]] (> n 1))) (map first) set)]
    {:index (into {} (map (juxt :req/id identity) entries))
     :duplicates dup}))
