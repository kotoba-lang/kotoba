                 {:a/kind :revenue-stamp :a/source :statute
                  :a/legal-basis "登録免許税法 §22（印紙納付）・別表第一 二十四号"
                  :a/law-id "342AC0000000035"}]
    :req/electronic {:e/status :in-force
                     :e/legal-basis "商業登記規則 §101 以下（電子情報処理組織による登記の申請）・登録免許税法 §24の2（電子納付）"
                     :e/system "登記・供託オンライン申請システム"
                     :e/removes #{:paper :seal :revenue-stamp}}
    :req/fee {:fee/kind :registration-tax
              :fee/rule "登録免許税法 別表第一 二十四号(一)イ: 資本金の額の 1000 分の 7（15 万円に満たないときは 15 万円）"
              :fee/channels #{:electronic-payment :revenue-stamp :cash-at-counter}
              :fee/cancel-by :receiving-office}
