(ns shomen.classify-test
  (:require [kotoba.test :refer [deftest is testing]]
            [shomen.classify :as c]))

(def base
  {:req/id :t :req/name "t" :req/jurisdiction "JPN" :req/authority :legal-affairs-bureau
   :req/kind :application :req/confidence :unverified-seed :req/verified "2026-08-23"
   :req/source-urls ["x"] :req/fee {:fee/channels #{:none}}})

(defn entry [analog electronic & [fee]]
  (cond-> (assoc base :req/analog analog :req/electronic electronic)
    fee (assoc :req/fee fee)))

(def stamp-statute {:a/kind :revenue-stamp :a/source :statute :a/legal-basis "法 §1"})
(def stamp-order   {:a/kind :revenue-stamp :a/source :cabinet-order :a/legal-basis "令 §1"})
(def paper-rule    {:a/kind :paper :a/source :ministerial-ordinance :a/legal-basis "規則 §1"})
(def presence-rule {:a/kind :presence :a/source :ministerial-ordinance :a/legal-basis "規則 §1"})
(def paper-practice {:a/kind :paper :a/source :notice-or-practice :a/legal-basis "窓口様式"})

(deftest unknown-refuses
  (testing ":unknown は他のどれにも畳まれない —— 分類も提言も繋ぎも拒否"
    (let [e (entry [stamp-statute] {:e/status :unknown})]
      (is (= :unverified (c/route e)))
      (is (= :unverified (:refused (c/advocacy e))))
      (is (= :unverified (:refused (c/interim e))))))
  (testing ":e/status が無い entry も :unknown と同じ"
    (is (= :unverified (c/route (entry [stamp-statute] {}))))))

(deftest electronic-now
  (let [e (entry [stamp-statute paper-rule]
                 {:e/status :in-force :e/legal-basis "規則 §100" :e/removes #{:revenue-stamp :paper}})]
    (is (= :electronic-now (c/route e)))
    (is (empty? (c/remaining-analog e)))
    (is (nil? (c/advocacy e)) "求めるものが無い")
    (is (nil? (c/interim e)) "繋ぎが要らない")))

(deftest in-force-but-stamp-remains-by-cabinet-order
  (testing "申請はオンライン、手数料は政令で印紙のまま → 宛先は大臣（命令等）"
    (let [e (entry [paper-rule presence-rule stamp-order]
                   {:e/status :in-force :e/legal-basis "x" :e/removes #{:paper :presence}}
                   {:fee/channels #{:revenue-stamp} :fee/cancel-by :receiving-office :fee/amount-jpy 6000})]
      (is (= [:revenue-stamp] (mapv :a/kind (c/remaining-analog e))))
      (is (= :ask-ministry (c/route e)))
      (let [a (c/advocacy e)]
        (is (= :ministry (:target a)))
        (is (contains? (:channels a) :public-comment))
        (is (= ["令 §1"] (:legal-bases a)) "残る制約の根拠だけを提言に載せる"))
      (let [i (c/interim e)]
        (is (true? (:delegable? i)))
        (is (= [:receive-principal-documents :buy-revenue-stamp :affix-revenue-stamp
                :enclose :post :archive-receipt]
               (mapv :task (:tasks i))))
        (is (= 6000 (:amount-jpy (second (:tasks i)))))
        (is (= :receiving-office (:cancel-by (nth (:tasks i) 2))) "裁判所・官署の印紙は消印しない")))))

(deftest heaviest-source-decides
  (testing "省令の書面と法律の印紙が残れば、宛先は国会"
    (is (= :ask-legislature (c/route (entry [paper-rule stamp-statute] {:e/status :not-permitted :e/removes #{}})))))
  (testing "省令だけなら大臣"
    (is (= :ask-ministry (c/route (entry [paper-rule presence-rule] {:e/status :not-permitted :e/removes #{}})))))
  (testing "運用だけなら行政"
    (is (= :ask-administration (c/route (entry [paper-practice] {:e/status :not-permitted :e/removes #{}}))))))

(deftest enacted-not-in-force
  (let [e (entry [stamp-statute paper-rule]
                 {:e/status :enacted-not-in-force :e/commencement "公布から 5 年以内"}
                 {:fee/channels #{:revenue-stamp} :fee/cancel-by :receiving-office :fee/amount-jpy 4000})]
    (is (= :electronic-soon (c/route e)))
    (is (nil? (c/advocacy e)) "成立済みなら求めない。待つ")
    (is (true? (get-in (c/interim e) [:delegable?])) "繋ぎは飛脚に渡せる")))

(deftest permitted-not-provided
  (let [e (entry [{:a/kind :paper :a/source :statute :a/legal-basis "法 §27"}]
                 {:e/status :permitted-not-provided :e/legal-basis "デジタル手続法 §6"})]
    (is (= :ask-administration (c/route e)) "法律が紙と書いていても、包括法が許すなら宛先は行政")
    (is (= :administration (:target (c/advocacy e))))))

(deftest presence-is-undelegable
  (testing "出頭・押印・公証が残る手続きは繋ぎ自体が成立しない"
    (let [e (entry [paper-rule presence-rule] {:e/status :not-permitted :e/removes #{}})
          i (c/interim e)]
      (is (false? (:delegable? i)))
      (is (= [:presence] (:blocked i)))
      (is (= [:principal-must-act] (mapv :task (:tasks i)))))))

(deftest applicant-cancels-tax-stamps
  (let [e (entry [stamp-statute] {:e/status :not-permitted :e/removes #{}}
                 {:fee/channels #{:revenue-stamp} :fee/cancel-by :applicant})
        affix (nth (:tasks (c/interim e)) 2)]
    (is (= :affix-revenue-stamp (:task affix)))
    (is (= :applicant (:cancel-by affix)))))
