(ns shomen.catalog-test
  (:require [kotoba.test :refer [deftest is testing]]
            [shomen.catalog :as cat]
            [shomen.classify :as c]
            [shomen.coverage :as cov]
            [shomen.requirement :as req]))

(deftest catalog-conforms
  (let [r (req/conform cat/entries :full)]
    (is (:ok? r) (pr-str (:violations r)))
    (is (= 10 (:entries r)))
    (is (empty? (:duplicates (req/by-id cat/entries))))))

(deftest all-seed
  (testing "seed は seed と名乗る —— 1 件でも verified を名乗ったら、それは検証の記録が要る"
    (is (every? #(= :unverified-seed (:req/confidence %)) cat/entries))))

(deftest routes-of-known-entries
  (is (= :electronic-now (c/route (cat/entry :jp-commercial-registration-incorporation))))
  (is (= :electronic-now (c/route (cat/entry :jp-registry-certificate-request)))
      "法律は印紙と書くが省令で電子納付に道を開いている")
  (is (= :ask-ministry (c/route (cat/entry :jp-immigration-residence-permission-fee)))
      "申請はオンライン、手数料は政令で収入印紙のまま")
  (is (= :unverified (c/route (cat/entry :jp-civil-suit-filing)))
      "施行済みかを測っていないので分類しない")
  (is (= :electronic-soon (c/route (cat/entry :jp-civil-execution-attachment-petition))))
  (is (= :electronic-now (c/route (cat/entry :jp-articles-of-incorporation-notarisation)))
      "電子定款にすれば印紙税 4 万円は課税されない")
  (is (= :unverified (c/route (cat/entry :jp-notarial-deed))))
  (is (= :ask-ministry (c/route (cat/entry :jp-naturalisation-application)))
      "書面・出頭は省令（国籍法施行規則 §2）")
  (is (= :ask-administration (c/route (cat/entry :jp-birth-notification)))
      "法律が紙と書いていてもデジタル手続法 §6 が許す")
  (is (= :electronic-now (c/route (cat/entry :jp-contract-stamp-duty)))))

(deftest immigration-interim-is-a-stamp-job
  (let [i (c/interim (cat/entry :jp-immigration-residence-permission-fee))]
    (is (true? (:delegable? i)))
    (is (some #(= :buy-revenue-stamp (:task %)) (:tasks i)))))

(deftest naturalisation-is-undelegable
  (let [i (c/interim (cat/entry :jp-naturalisation-application))]
    (is (false? (:delegable? i)))
    (is (= #{:presence} (set (:blocked i))))))

(deftest coverage-is-honest
  (let [s (cov/summarize cat/entries)]
    (is (= 10 (:entries s)))
    (is (= 2 (count (:unverified s))) "測っていない 2 件は分類に混ぜない")
    (is (= #{:jp-civil-suit-filing :jp-notarial-deed} (set (:unverified s))))
    (is (= 0 (get-in s [:by-route :ask-legislature] 0))
        "seed 時点で法律レベルの実例は見つけていない —— これは『無い』ではない")
    (is (re-find #"unverified \(route refused, not classified\): 2" (cov/report cat/entries)))))
