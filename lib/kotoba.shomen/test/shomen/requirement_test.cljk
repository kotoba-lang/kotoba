(ns shomen.requirement-test
  (:require [kotoba.test :refer [deftest is testing]]
            [shomen.requirement :as req]))

(def ok
  {:req/id :x :req/name "x" :req/authority :court :req/kind :court-filing
   :req/analog [{:a/kind :revenue-stamp :a/source :statute :a/legal-basis "法 §8"}]
   :req/electronic {:e/status :not-permitted :e/removes #{}}
   :req/fee {:fee/channels #{:revenue-stamp} :fee/cancel-by :receiving-office}
   :req/source-urls ["u"] :req/confidence :unverified-seed :req/verified "2026-08-23"})

(deftest conform-passes-a-good-entry
  (is (:ok? (req/conform [ok] :full))))

(deftest conform-returns-every-violation
  (testing "最初の 1 件で止めない"
    (let [bad (-> ok (dissoc :req/name) (assoc :req/confidence :sure)
                  (assoc-in [:req/analog 0 :a/source] :hearsay))
          rules (set (map :rule (:violations (req/conform [bad]))))]
      (is (= #{:missing-name :bad-confidence :bad-analog-source} rules)))))

(deftest source-is-mandatory
  (testing "誰がそう言っているか不明な制約は提言の宛先を持たない"
    (is (some #(= :bad-analog-source (:rule %))
              (:violations (req/conform [(assoc-in ok [:req/analog 0] {:a/kind :paper :a/legal-basis "x"})]))))))

(deftest in-force-needs-removes
  (is (some #(= :in-force-without-removes (:rule %))
            (:violations (req/conform [(assoc ok :req/electronic {:e/status :in-force :e/legal-basis "x"})])))))

(deftest enacted-needs-commencement
  (is (some #(= :enacted-without-commencement (:rule %))
            (:violations (req/conform [(assoc ok :req/electronic {:e/status :enacted-not-in-force})])))))

(deftest stamp-needs-cancel-by
  (is (some #(= :stamp-without-cancel-by (:rule %))
            (:violations (req/conform [(assoc ok :req/fee {:fee/channels #{:revenue-stamp}})] :full)))))

(deftest nil-analog-is-not-empty-analog
  (testing "『analog 制約が無い』(空列) と『知らない』(nil) を分ける"
    (is (:ok? (req/conform [(assoc ok :req/analog [])])))
    (is (some #(= :analog-not-a-sequence (:rule %))
              (:violations (req/conform [(assoc ok :req/analog nil)]))))))
