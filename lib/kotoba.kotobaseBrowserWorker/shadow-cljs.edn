;; kotobase-peer's browser shell (sibling to kotobase-cljc-worker, which is
;; the Cloudflare/R2 shell): wires the SAME kotobase-peer engine +
;; kotobase-cljc-worker's pure XRPC handler + block-miss trampoline to
;; IndexedDB instead of R2, so the whole datom-plane surface
;; (transact/datoms/q/pull/fold) runs entirely inside a browser tab
;; (ADR-2607051700, app-aozora).
;;
;; build-test: npm run build-test  (amu compile --target wasm32-browser browser-test →
;;             out/browser-test/index.html, open in an actual browser)
{:source-paths
 ["src" "test"
  ;; same dep closure kotobase-cljc-worker/shadow-cljs.edn uses, relative to
  ;; orgs/kotoba-lang/kotobase-browser-worker -> orgs/kotoba-lang/<dep>
  "../kotobase-peer/src"
  "../datom/src"
  "../arrangement/src"
  "../prolly-tree/src"
  "../chain/src"
  "../io-ipld/src"
  "../io-multiformats/src"
  "../org-ietf-cbor/src" ; renamed from dag-cbor 2026-07-06
  ;; reuse the pure XRPC handler + backend-agnostic block-miss trampoline
  ;; verbatim -- this repo only adds the IndexedDB IO primitives, no engine
  ;; or dispatch logic is duplicated.
  "../kotobase-cljc-worker/src"]

 :dependencies []

 :builds
 {;; node-test of the pure IndexedDB-independent bits (none today -- the IDB
  ;; primitives themselves need a real browser; kept for parity/future pure
  ;; helpers).
  :test {:target :node-test
         :output-to "out/node-tests.js"
         :ns-regexp "-test$"}

  ;; the actual proof: run the SAME test namespaces against a REAL IndexedDB
  ;; in an actual browser tab.
  :browser-test
  {:target :browser-test
   :test-dir "out/browser-test"
   :ns-regexp "-test$"}}}
