;; Port of kotoba.cam.tool (tool.cljk, kami-cam src/tool.rs), Kotoba-native, :document maps.
;;
;; A tool is a :document map (see the source for its fields). The library is a
;;   :document map from the tool's :id (a document-i64 key) to the tool.
;;
;; Named divergences from tool.cljk:
;;   - add / remove-tool return a two-item :document vector [library' previous].
;;   - list-tools returns a :document vector sorted by :id (the source returns a seq).
;;   - tool-types / tool-materials are zero-arg fns returning a :document set.
;;   - a tool's :id must be an i64 (document-i64) key.

(ns kotoba.cam.tool
  (:export [tool-types tool-materials empty-library add get-tool remove-tool
            list-tools lib-count empty-lib?]))

(defn tool-types [] :document
  (document-edn-read "#{:end-mill :ball-nose :bull-nose :drill :tap :face-mill :chamfer-mill :lathe}"))

(defn tool-materials [] :document
  (document-edn-read "#{:hss :carbide :ceramic :cbn :pcd}"))

(defn empty-library [] :document
  (document-map))

(defn- tool-id [t :document] :document
  (option-or (document-get t :id) (document-null)))

(defn- id-of [t :document] :i64
  (option-or (document-i64-value (tool-id t)) 0))

(defn- elt [v :document i :i64] :document
  (option-or (document-vector-at v i) (document-null)))

(defn add [library :document tool :document] :document
  (let [tid (tool-id tool)
        prev (option-or (document-get library tid) (document-null))]
    (document-vector (document-assoc library tid tool) prev)))

(defn get-tool [library :document id :document] :document
  (option-or (document-get library id) (document-null)))

(defn remove-tool [library :document id :document] :document
  (let [removed (option-or (document-get library id) (document-null))]
    (document-vector (document-dissoc library id) removed)))

(defn- insert-sorted [v :document t :document] :document
  (let [n (document-count v)]
    (loop [i 0 acc (document-vector) placed false]
      (if (< i n)
        (let [x (elt v i)]
          (if (and (not placed) (< (id-of t) (id-of x)))
            (recur (+ i 1) (document-vector-conj (document-vector-conj acc t) x) true)
            (recur (+ i 1) (document-vector-conj acc x) placed)))
        (if placed acc (document-vector-conj acc t))))))

(defn list-tools [library :document] :document
  (let [n (document-count library)]
    (loop [i 0 acc (document-vector)]
      (if (< i n)
        (recur (+ i 1)
               (insert-sorted acc (elt (option-or (document-map-entry-at library i) (document-vector)) 1)))
        acc))))

(defn lib-count [library :document] :i64
  (document-count library))

(defn empty-lib? [library :document] :bool
  (= (document-count library) 0))
