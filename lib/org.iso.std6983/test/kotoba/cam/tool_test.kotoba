(ns kotoba.cam.tool-test (:export [main]) (:require [kotoba.cam.tool :as t]))

(defn- same [a :document b :document] :bool
  (string=? (document-edn-print a) (document-edn-print b)))

(defn- at [v :document i :i64] :document
  (option-or (document-vector-at v i) (document-null)))

(defn- tool [id :i64 nm :string d :i64] :document
  (document-map :id (document-i64 id) :name (document-string nm)
                :tool-type (document-keyword :end-mill) :diameter (document-i64 d)
                :coating (document-null)))

(defn main [] :i64
  (let [lib0 (t/empty-library)
        t1 (tool 1 "EM10" 10)
        t1b (tool 1 "EM10b" 12)
        t2 (tool 2 "EM6" 6)
        t3 (tool 3 "EM4" 4)
        r1 (t/add lib0 t1)
        lib1 (at r1 0)
        r2 (t/add lib1 t2)
        lib2 (at r2 0)
        r3 (t/add lib2 t1b)
        lib3 (at r3 0)
        rm (t/remove-tool lib3 (document-i64 2))
        lib4 (at rm 0)
        rm2 (t/remove-tool lib4 (document-i64 9))
        lib5 (at (t/add (at (t/add (at (t/add (t/empty-library) t3) 0) t1) 0) t2) 0)]
    (+ (if (t/empty-lib? lib0) 0 1)
       (if (same (at r1 1) (document-null)) 0 1)
       (if (= (t/lib-count lib1) 1) 0 1)
       (if (same (at r2 1) (document-null)) 0 1)
       (if (= (t/lib-count lib2) 2) 0 1)
       (if (same (at r3 1) t1) 0 1)
       (if (= (t/lib-count lib3) 2) 0 1)
       (if (same (t/get-tool lib3 (document-i64 1)) t1b) 0 1)
       (if (same (t/get-tool lib3 (document-i64 9)) (document-null)) 0 1)
       (if (same (at rm 1) t2) 0 1)
       (if (= (t/lib-count lib4) 1) 0 1)
       (if (same (at rm2 1) (document-null)) 0 1)
       (if (= (t/lib-count lib4) 1) 0 1)
       (if (same (t/list-tools lib3) (document-vector t1b t2)) 0 1)
       (if (same (t/list-tools lib5) (document-vector t1 t2 t3)) 0 1)
       (if (= (document-count (t/tool-types)) 8) 0 1)
       (if (= (document-count (t/tool-materials)) 5) 0 1)
       (if (t/empty-lib? (t/empty-library)) 0 1))))
