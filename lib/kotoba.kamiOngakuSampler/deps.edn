{:paths ["src"]
 :deps {
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]}
  ;; Real-browser AudioWorklet trigger E2E (scripts/build-e2e-bundles.sh +
  ;; test/e2e/run_e2e.cljk). Only this alias needs the ClojureScript compiler
  ;; and test-only (pinned-SHA) git dependencies on kotoba-lang/audio (real
  ;; oscillator/ADSR DSP -- this repo has none of its own) and
  ;; kotoba-lang/org-w3-webaudio (the AudioContext/AudioWorkletNode binding
  ;; layer + its proven :optimizations :advanced + self-polyfill worklet
  ;; recipe, reused rather than reinvented). Bump the SHAs when those repos
  ;; advance.
  :e2e {:extra-paths ["test/e2e/src"]
        :extra-deps {org.clojure/clojurescript {:mvn/version "1.11.132"}
                     io.github.kotoba-lang/audio
                     {:git/sha "cf2f56a4b417b5e7a46100aff0a23f65d30963d6"}
                     io.github.kotoba-lang/org-w3-webaudio
                     {:git/sha "e554d853d6403c35b1ffe1c4adb37d2a1d557451"}}}}}
