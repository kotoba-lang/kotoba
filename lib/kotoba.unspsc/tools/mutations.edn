;; One mutation per invariant. `:find` must occur EXACTLY ONCE in `:file` —
;; `tools/mutate.cljk` refuses otherwise, because a mutation that landed in a
;; comment or a second call site produces a red suite that proves nothing.
;;
;; ## SCOPE
;;
;; Covers the 2026-08-18 `.clj` → `.cljc` conversion of `kotoba.unspsc` only:
;; that the registry is compiled in rather than read at runtime, that the
;; generated projection cannot drift from the EDN unnoticed, that the tx-data
;; reconstitution is really happening, and that a registry handed in as nil
;; does not flatten into a complete-looking empty lookup. It does NOT cover
;; readiness, execution-plan, maturity tiers, or ANY of
;; `kotoba.unspsc.product` — the product twin has its own assertions and no
;; mutations here, so a clean run of this table means "the portability
;; invariants are measured" and NOT "this library is measured".
;;
;; ⚠ These mutations drive `kbb -M:test`. The `:cljs` half is exercised
;; by `test/run_portable.cljk`, which this harness does not run — a mutation
;; that broke only a `:cljs` branch would survive here. Both were run by
;; hand; see the conversion commit message for the counts.
;;
;; NOT written, with the reason: replacing `([] (segments (registry)))` with
;; `([] (:unspsc (registry)))`. It is a semantic no-op — the one-arg body IS
;; `(:unspsc reg)` — so it reddens nothing for every input including nil. The
;; single-path form is still worth having (a guard added to the one-arg form
;; cannot be skipped by the zero-arg one) but it is not an invariant anything
;; can observe today. The same no-op was written and removed in
;; `kotoba-lang/technology` and `kotoba-lang/iso3166`.
[{:id :the-projection-cannot-drift-unnoticed
  :invariant "the generated namespace matches the EDN a human edits"
  :file "src/kotoba/unspsc/embedded.cljk"
  :find "Organizations and Clubs"
  :replace "Organizations and Clubs DRIFTED"}

 {:id :the-drift-check-refuses-when-it-cannot-read
  :invariant "a check that could not run must not report a pass"
  :file "test/kotoba/unspsc_test.cljk"
  :find "#?(:clj (try (slurp path) (catch Exception _ nil))"
  :replace "#?(:clj (try (slurp (str path \".missing\")) (catch Exception _ nil))"}

 {:id :by-segment-does-not-invent-an-empty-index
  :invariant "(into {} …) over nil yields {} — an index over no data"
  :file "src/kotoba/unspsc.cljk"
  :find "  ([reg] (when-let [segs (segments reg)]\n           (into {} (map (juxt :segment identity)) segs))))"
  :replace "  ([reg] (into {} (map (juxt :segment identity)) (segments reg))))"}

 {:id :by-segment-is-keyed-on-the-segment-code
  :invariant "the index key is :segment and not some other field"
  :file "src/kotoba/unspsc.cljk"
  :find "(map (juxt :segment identity)) segs)"
  :replace "(map (juxt :name identity)) segs)"}

 {:id :the-registry-is-the-embedded-one
  :invariant "the library reads the projection and not something else"
  :file "src/kotoba/unspsc.cljk"
  :find "  (let [entity (first embedded/registry-tx)]"
  :replace "  (let [entity (first [])]"}

 {:id :the-blob-is-actually-unblobbed
  :invariant "the pr-str'd :unspsc blob is parsed back into a vector of maps"
  :file "src/kotoba/unspsc.cljk"
  :find "        (assoc :unspsc (edn/read-string (:kotoba.unspsc/unspsc entity))))))"
  :replace "        (assoc :unspsc (:kotoba.unspsc/unspsc entity)))))"}

 {:id :reconstitution-drops-the-tempid-and-the-blob
  :invariant ":db/id and the raw blob key are transaction artefacts"
  :file "src/kotoba/unspsc.cljk"
  :find "        (dissoc :db/id :kotoba.unspsc/unspsc)"
  :replace "        (dissoc :kotoba.unspsc/unspsc)"}]
