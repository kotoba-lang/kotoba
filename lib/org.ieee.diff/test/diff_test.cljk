;; test/diff_test.cljk -- build the command and compare it with the system
;; diff, byte for byte, on stdout, stderr AND exit status.
;;
;;   AMU_HOME=<amu checkout> kbb --backend sci test/diff_test.cljk
;;
;; Exits 0 when every case matches, 1 on any difference, 2 when it could not
;; run at all.
(ns diff-test
  (:require [clojure.string :as str] ["fs" :as fs] ["path" :as path] ["os" :as os]))

(def cp (js/require "node:child_process"))

(defn- run [cmd args opts]
  (let [r (.spawnSync cp cmd (clj->js args) (clj->js (merge {:encoding "buffer" :maxBuffer 67108864} opts)))]
    {:status (.-status r) :out (.-stdout r) :err (.-stderr r)}))

(defn- refuse [message]
  (println (pr-str {:ok false :phase :setup :message message}))
  (.exit js/process 2))

(def amu-home
  (or (.-AMU_HOME js/process.env)
      (let [guess (.resolve path (.cwd js/process) ".." ".." "kotoba-lang" "amu")]
        (when (.existsSync fs (.join path guess "bin" "amu")) guess))))

(def system-diff "/usr/bin/diff")

(defn- lines [& xs] (str (str/join "\n" xs) "\n"))

;; A 3,000-line file and a copy with 40 scattered edits (a change, a
;; deletion and an insertion every 75 lines): the Myers trace is (D+1)^2
;; words, and this is the case that says the budget arithmetic holds past
;; toy sizes.
(def big-a (apply lines (map #(str "line " % " of the corpus") (range 3000))))
(def big-b (apply lines (mapcat (fn [i] (cond (= 0 (mod i 75)) [(str "LINE " i " changed")]
                                               (= 25 (mod i 75)) []
                                               (= 50 (mod i 75)) [(str "line " i " of the corpus") "inserted after it"]
                                               :else [(str "line " i " of the corpus")]))
                                (range 3000))))

(def fixtures
  {"a1" (lines "a" "b" "c" "d")
   "b1" (lines "a" "x" "c" "d" "e")
   "same" (lines "a" "b" "c" "d")
   "empty" ""
   "one" (lines "z")
   "two" (lines "z" "y")
   ;; No trailing newline, on either side and on both.
   "nonl-a" "a\nb"
   "nonl-b" "a\nb\nc"
   "nonl-same-text" "a\nb\nc"
   "nl-same-text" (lines "a" "b" "c")
   ;; Repeated lines, where a naive alignment picks the wrong match.
   "rep-a" (lines "x" "x" "x" "y")
   "rep-b" (lines "x" "y" "x" "x")
   ;; Everything changes.
   "all-a" (lines "1" "2" "3")
   "all-b" (lines "4" "5" "6")
   ;; A change in the middle, and at both ends.
   "mid-a" (lines "h1" "h2" "old" "t1" "t2")
   "mid-b" (lines "h1" "h2" "new" "t1" "t2")
   "ends-a" (lines "first" "keep" "last")
   "ends-b" (lines "FIRST" "keep" "LAST")
   ;; Blank lines are lines.
   "blank-a" (lines "a" "" "b")
   "blank-b" (lines "a" "b")
   ;; Multi-byte.
   "utf8-a" (lines "日本語" "テスト")
   "utf8-b" (lines "日本語" "試験")
   "big-a" big-a
   "big-b" big-b})

;; Each case is an argv over fixture names (flags pass through).
(def cases
  [["a1" "b1"] ["b1" "a1"] ["a1" "same"] ["empty" "empty"] ["empty" "a1"] ["a1" "empty"]
   ["empty" "one"] ["one" "empty"] ["empty" "two"] ["one" "two"] ["two" "one"]
   ["nonl-a" "a1"] ["a1" "nonl-a"] ["nonl-a" "nonl-b"] ["nonl-b" "nonl-a"]
   ["nonl-same-text" "nl-same-text"] ["nl-same-text" "nonl-same-text"]
   ["rep-a" "rep-b"] ["rep-b" "rep-a"] ["all-a" "all-b"]
   ["mid-a" "mid-b"] ["ends-a" "ends-b"] ["blank-a" "blank-b"] ["blank-b" "blank-a"]
   ["utf8-a" "utf8-b"]
   ["big-a" "big-b"] ["big-b" "big-a"] ["big-a" "big-a"]
   ;; -q, both answers.
   ["-q" "a1" "b1"] ["-q" "a1" "same"] ["-q" "big-a" "big-b"] ["-q" "empty" "empty"]
   ;; Missing operands: reported on stderr, exit 2.
   ["a1" "missing"] ["missing" "a1"] ["-q" "missing" "a1"]
   ;; Usage.
   ["a1"] []])

;; Not compared: the expected bytes are written out.
(def divergences
  [{:argv ["-u" "a1" "b1"] :out "" :exit 2
    :err "diff: -u needs the files' mtimes in the local time zone, which this build cannot read\n"}])

(when-not amu-home (refuse "set AMU_HOME to an amu checkout"))
(let [amu (.join path amu-home "bin" "amu")
      packager (.join path amu-home "scripts" "package-command.cljk")
      kbb (.join path amu-home "bin" "kbb")]
  (when-not (.existsSync fs amu) (refuse (str "no amu at " amu)))
  (when-not (.existsSync fs system-diff) (refuse (str "no " system-diff)))
  (let [tmp (.mkdtempSync fs (.join path (.tmpdir os) "org-ieee-diff-"))
        src (.resolve path (.cwd js/process) "diff" "core.kotoba")
        policy (.join path tmp "policy.edn")
        kexe (.join path tmp "diff.kexe")
        blob (.join path tmp "diff.bin")
        exe (.join path tmp "diff")
        data (.join path tmp "data")]
    (.mkdirSync fs data)
    (doseq [[name content] fixtures] (.writeFileSync fs (.join path data name) content "utf8"))
    (.writeFileSync fs policy "{:allow #{[:cap/call 35] [:cap/call 37] [:cap/call 38] [:cap/call 39]}}" "utf8")
    (let [c (run "node" [amu "compile" src "--target" "aarch64-macos" "--jvm-free" "--policy" policy "--output" kexe] {})]
      (when (not= 0 (:status c)) (refuse (str "compile failed: " (str (:err c)) (str (:out c))))))
    (let [e (run "node" [amu "extract-native" kexe "--symbol" "main" "--output" blob] {})
          _ (when (not= 0 (:status e)) (refuse (str "extract failed: " (str (:err e)))))
          offset (second (re-find #":offset (\d+)" (str (:out e))))]
      (when-not offset (refuse "no :offset in the extract report"))
      ;; The trace is (D+1)^2 words, capped by the guest at 2^22; the big
      ;; case has D = 120 and n + m about 6,000, so the cap is what is
      ;; allocated and the item budget must hold it plus the rows and S.
      (let [p (run "node" [kbb "--backend" "sci" packager "--code" blob "--offset" offset "--isa" "aarch64"
                           ;; /dev/fd in the scope: "the descriptors the caller connected",
                           ;; so `diff <(a) <(b)` works (amu #1019).
                           "--allow" "35,37,38,39" "--fs-scope" (str (.realpathSync fs data) ":/dev/fd")
                           "--fuel" "4000000000" "--pairs" "2000000" "--string-pool" "64000000"
                           "--vectors" "1024" "--vector-items" "8388608" "--output" exe] {})]
        (when (not= 0 (:status p)) (refuse (str "package failed: " (str (:err p)))))))
    (let [real (.realpathSync fs data)
          argv-of (fn [names] (mapv #(if (str/starts-with? % "-") % (.join path real %)) names))
          b64 (fn [buf] (.toString buf "base64"))
          results
          (for [names cases]
            (let [argv (argv-of names)
                  k (run exe argv {})
                  s (run system-diff argv {})
                  same? (and (= (b64 (:out k)) (b64 (:out s)))
                             (= (b64 (:err k)) (b64 (:err s)))
                             (= (:status k) (:status s)))]
              {:argv names :ok same? :kotoba (.toString (:out k) "utf8") :system (.toString (:out s) "utf8")
               :kotoba-err (.toString (:err k) "utf8") :system-err (.toString (:err s) "utf8")
               :exit [(:status k) (:status s)]}))
          div-results
          (for [d divergences]
            (let [k (run exe (argv-of (:argv d)) {})
                  ok? (and (= (.toString (:out k) "utf8") (:out d))
                           (= (.toString (:err k) "utf8") (:err d))
                           (= (:status k) (:exit d)))]
              {:argv [(:argv d) :divergence] :ok ok? :kotoba (.toString (:out k) "utf8") :system "(not compared)"
               :kotoba-err (.toString (:err k) "utf8") :system-err (:err d) :exit [(:status k) (:exit d)]}))
          ;; Process substitution, the shape 316 of the 888 measured diff
          ;; calls take: both operands are /dev/fd/N pipes. Through bash, on
          ;; both binaries, compared like every other case.
          psub-results
          (for [[a b] [["a1" "b1"] ["a1" "same"] ["empty" "one"] ["big-a" "big-b"]]]
            (let [cmd (fn [exe'] (str "'" exe' "' <(cat '" (.join path real a) "') <(cat '" (.join path real b) "')"))
                  k (run "bash" ["-c" (cmd exe)] {})
                  s (run "bash" ["-c" (cmd system-diff)] {})
                  ;; The operand names differ between the two runs
                  ;; (/dev/fd/63 vs /dev/fd/62 is whatever bash picked), and
                  ;; only -q prints them -- normal output never does.
                  same? (and (= (b64 (:out k)) (b64 (:out s))) (= (b64 (:err k)) (b64 (:err s)))
                             (= (:status k) (:status s)))]
              {:argv [:psub a b] :ok same? :kotoba (.toString (:out k) "utf8") :system (.toString (:out s) "utf8")
               :kotoba-err (.toString (:err k) "utf8") :system-err (.toString (:err s) "utf8")
               :exit [(:status k) (:status s)]}))
          all (concat results psub-results div-results)
          bad (remove :ok all)]
      (doseq [r all]
        (println (str (if (:ok r) "  ok   " "  FAIL ") (pr-str (:argv r))
                      " -> " (pr-str (subs (:kotoba r) 0 (min 80 (count (:kotoba r)))))
                      (when-not (:ok r) (str " but " system-diff " says " (pr-str (subs (:system r) 0 (min 80 (count (:system r)))))
                                             " exits " (pr-str (:exit r))
                                             " stderr " (pr-str (:kotoba-err r)) " vs " (pr-str (:system-err r)))))))
      (println (pr-str {:ok (empty? bad) :cases (count all) :compared (+ (count results) (count psub-results))
                        :divergences (count div-results) :failed (count bad)}))
      (.exit js/process (if (seq bad) 1 0)))))
