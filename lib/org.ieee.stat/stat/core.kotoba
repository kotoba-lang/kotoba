;; stat -- BSD stat(1), the `-f FORMAT` form, as a Kotoba command.
;;
;;   stat -f FORMAT FILE...     one line per operand; %z size, %m mtime
;;                              (epoch seconds), %N name, %p mode (octal,
;;                              with the type bits, as BSD prints it), %%
;;
;; ## Measured, 2026-09-16
;;
;; 267 invocations in 1,268,018 agent Bash calls (superproject
;; ADR-2609161710): `-f %Sm` 61 (local time), `-f %m` 23, `-f %z` 18, GNU
;; `-c %Y` 18. `%m` needed a loader form -- wire 35's STAT answers mode,
;; size, blocks and is-dir, and org-ieee-du reads its fourth field to the
;; end of the string, so mtime became its own MTIME form (amu #1017) rather
;; than a fifth field.
;;
;; Refused with a message, exit 1 (named divergences): `%Sm` and every other
;; `%S...` (local time needs the zone database), the default line without
;; `-f` (uid names, device numbers, local times), `-c` (GNU), and any other
;; conversion.
;;
;; Capabilities: :cli/args (38), :fs/app-data (35), :io/write (37),
;; :io/write-error (39).
(ns stat.core (:export [main]))

(defn arg [i :string] :string
  (typed-cap-call :cli/args :string :string i))

(defn emit [s :string] :string
  (typed-cap-call :io/write :string :string s))

(defn emit-error [s :string] :string
  (typed-cap-call :io/write-error :string :string s))

(defn fsq [s :string] :string
  (typed-cap-call :fs/app-data :string :string s))

(defn nl [] :string "\n")

(defn digit-text [d :i64] :string
  (string-substring "0123456789" d (+ d 1)))

(defn decimal-of [n :i64] :string
  (if (< n 10)
    (digit-text n)
    (string-concat (decimal-of (quot n 10)) (digit-text (- n (* 10 (quot n 10)))))))

(defn- octal-of [n :i64] :string
  (if (< n 8)
    (digit-text n)
    (string-concat (octal-of (quot n 8)) (digit-text (- n (* 8 (quot n 8)))))))

(defn argc-from [k :i64 total :string] :i64
  (if (string=? (decimal-of k) total) k (argc-from (+ k 1) total)))

(defn argc [] :i64 (argc-from 0 (arg "")))

(defn- digit-value [s :string i :i64] :i64
  (let [c (string-code-point-at s i)]
    (if (< c 48) -1 (if (> c 57) -1 (- c 48)))))

(defn- text->i64 [s :string i :i64 n :i64 acc :i64] :i64
  (if (>= i n)
    acc
    (let [d (digit-value s i)]
      (if (< d 0) acc (text->i64 s (+ i 1) n (+ (* acc 10) d))))))

;; STAT's answer "<mode> <size> <blocks> <isdir>": the k-th field.
(defn- field [s :string k :i64 from :i64] :string
  (let [sp (string-find-byte s 32 from)]
    (if (= k 0)
      (string-substring s from (if (< sp 0) (string-byte-length s) sp))
      (if (< sp 0) "" (field s (- k 1) (+ sp 1))))))

(defn- num-of [s :string] :i64 (text->i64 s 0 (string-byte-length s) 0))

;; One conversion for PATH given its STAT answer; "" for one this refuses.
(defn- conv [c :i64 path :string st :string] :string
  (if (= c 122) (field st 1 0)
    (if (= c 109) (fsq (string-concat path "MTIME_SEP"))
      (if (= c 78) path
        (if (= c 112)
          ;; %p is the whole st_mode in octal: the permission bits STAT
          ;; answers, under 100000 for a file and 040000 for a directory.
          (octal-of (+ (num-of (field st 0 0)) (if (string=? (field st 3 0) "1") 16384 32768)))
          (if (= c 37) "%" ""))))))

;; Are all conversions in FMT ones this answers? "" means refused.
(defn- supported? [fmt :string i :i64] :bool
  (let [n (string-byte-length fmt)]
    (if (>= i n)
      true
      (if (= (string-code-point-at fmt i) 37)
        (if (>= (+ i 1) n)
          false
          (let [c (string-code-point-at fmt (+ i 1))]
            (if (if (= c 122) true (if (= c 109) true (if (= c 78) true (if (= c 112) true (= c 37)))))
              (supported? fmt (+ i 2))
              false)))
        (supported? fmt (+ i 1))))))

(defn- render [fmt :string i :i64 path :string st :string] :string
  (let [n (string-byte-length fmt)]
    (if (>= i n)
      ""
      (if (if (= (string-code-point-at fmt i) 37) (< (+ i 1) n) false)
        (string-concat (conv (string-code-point-at fmt (+ i 1)) path st)
                       (render fmt (+ i 2) path st))
        (string-concat (string-substring fmt i (+ i 1)) (render fmt (+ i 1) path st))))))

(defn- complain [path :string] :i64
  (do (emit-error "stat: ") (emit-error path) (emit-error ": stat: No such file or directory") (emit-error (nl)) 1))

(defn- each [fmt :string i :i64 n :i64 worst :i64] :i64
  (if (>= i n)
    worst
    (let [path (arg (decimal-of i))
          st (fsq (string-concat path "STAT_SEP"))]
      (if (= 0 (string-byte-length st))
        (do (complain path) (each fmt (+ i 1) n 1))
        (do (emit (render fmt 0 path st)) (emit (nl)) (each fmt (+ i 1) n worst))))))

(defn- refuse [message :string] :i64
  (do (emit-error "stat: ") (emit-error message) (emit-error (nl)) 1))

(defn main [] :i64
  (let [n (argc)]
    (if (< n 1)
      (refuse "the default line needs uid names, device numbers and local times this build cannot read; use -f")
      (if (string=? (arg "0") "-c")
        (refuse "-c is GNU stat; this is BSD stat, use -f")
        (if (string=? (arg "0") "-f")
          (if (< n 3)
            (refuse "-f needs a format and at least one file")
            (if (supported? (arg "1") 0)
              (each (arg "1") 2 n 0)
              (refuse "only %z %m %N %p %% are supported (%S... needs the zone database)")))
          (refuse "the default line needs uid names, device numbers and local times this build cannot read; use -f"))))))
