{:paths ["src"]
 :version "0.3.0"
 ;; kotoba-lang/test — Layer 4 (tooling) of the kotoba foundational stdlib.
 ;; Property testing + assertion helpers. Consumes the sibling kotoba-lang/spec
 ;; (first-party, zero-dep) for generators, so a spec is also a test generator —
 ;; making kotoba-lang/test a consumer of spec (M5 for spec). No third-party deps.
 ;; .cljc. See ADR-kotoba-lang-foundational-stdlib.md.
 :deps {
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}

io.github.kotoba-lang/spec {:local/root "../kotoba.spec"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
       ;; clj-kondo as a Clojars lib (no Homebrew/system install needed).
       :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}
       ;; Non-negotiable self-verification for the deftest/is/testing/are/
       ;; run-tests layer (kotoba.lang.test.selftest-run): asserts the
       ;; harness correctly detects deliberately-planted failures/errors AND
       ;; reports 0 for an all-passing suite. `kbb -M:selftest`.
       :selftest {:extra-paths ["test"]
                  :main-opts ["-m" "kotoba.lang.test.selftest-run"]}
       ;; kotoba.test's clojure.test-compatible surface: the planted-failure
       ;; suite run by the SAME runner a migrated repo uses (must exit
       ;; non-zero), and the selftest that asserts its exact counts.
       ;; `kbb -M:compat-selftest`.
       :compat-negative {:extra-paths ["test"]
                         :main-opts ["-m" "cognitect.test-runner" "-n" "kotoba.test.compat-negative"]}
       :compat-selftest {:extra-paths ["test"]
                         :main-opts ["-m" "kotoba.test.compat-selftest"]}}}
