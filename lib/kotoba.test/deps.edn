{:paths ["src"]
 :version "0.3.0"
 ;; kotoba-lang/test — Layer 4 (tooling) of the kotoba foundational stdlib.
 ;; Property testing + assertion helpers. Consumes the sibling kotoba-lang/spec
 ;; (first-party, zero-dep) for generators, so a spec is also a test generator —
 ;; making kotoba-lang/test a consumer of spec (M5 for spec). No third-party deps.
 ;; .cljc. See ADR-kotoba-lang-foundational-stdlib.md.
 :deps {
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}

io.github.kotoba-lang/spec {:local/root "../kotoba.spec"}}
 :aliases
 {:test {:extra-paths ["test"]}}}
