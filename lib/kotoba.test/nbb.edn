;; nbb.edn -- the kbb engine reads THIS file for :deps; it does not read
;; deps.edn's git coordinates (kbb -M:test puts only :local/root deps on the
;; classpath). :deps below is a copy of deps.edn :deps -- keep the two in step.
{:paths ["src" "test"]
 :deps {
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}

io.github.kotoba-lang/spec {:local/root "../kotoba.spec"}}
}
