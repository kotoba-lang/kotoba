(ns kotoba.test.rng
  "RNG -- addressed on its own.

  Split out of kotoba.lang.test on 2026-09-09 (ADR-2609091200). The unit
  here is the DEFINITION, and this repo's deps.edn names exactly the
  definitions it reaches -- nothing else.
"
  ;; Export: the module's public surface is the RNG record definition
  ;; itself -- without an :export the project link refuses it with
  ;; "project module kotoba.test.rng exports nothing" (selfhost scoreboard,
  ;; 2026-10-19).
  #?(:kotoba (:export [RNG]))
  (:require [kotoba.lang.spec :as spec])
  #?(:clj  (:require [kotoba.lang.spec :as spec])
     :cljs (:require [kotoba.lang.spec :as spec])))

(defrecord RNG [state])
