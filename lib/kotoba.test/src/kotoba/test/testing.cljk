(ns kotoba.test.testing
  "testing -- addressed on its own.

  Split out of kotoba.lang.test on 2026-09-09 (ADR-2609091200). The unit
  here is the DEFINITION, and this repo's deps.edn names exactly the
  definitions it reaches -- nothing else.
"
  (:require [kotoba.lang.spec :as spec]
            [kotoba.test.-starcontexts-star :refer [*contexts*]])
  #?(:clj  (:require [kotoba.lang.spec :as spec])
     :cljs (:require [kotoba.lang.spec :as spec])))

(defmacro testing
  "Push `msg` onto the `testing` context stack for the duration of `body`;
  any `is` failure/error inside prints it. Nested `testing` blocks compose,
  innermost last, joined with \" > \"."
  [msg & body]
  `(binding [*contexts* (conj *contexts* ~msg)]
     ~@body))
