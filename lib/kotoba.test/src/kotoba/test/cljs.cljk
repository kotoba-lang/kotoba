(ns kotoba.test.cljs
  "Compiled ClojureScript test bridge. Require macros explicitly from this
  namespace; kotoba.test retains its JVM/SCI function-shaped runner."
  (:require [cljs.test :as host]))

#?(:clj
   (do
     (defmacro deftest [name & body]
       `(host/deftest ~name ~@body))
     (defmacro is
       ([form] `(host/is ~form))
       ([form message] `(host/is ~form ~message)))
     (defmacro are [arguments expression & values]
       `(host/are ~arguments ~expression ~@values))
     (defmacro testing [label & body]
       `(host/testing ~label ~@body))
     (defmacro async [done & body]
       `(host/async ~done ~@body))
     (defmacro use-fixtures [kind & fixtures]
       `(host/use-fixtures ~kind ~@fixtures))
     (defmacro run-tests [& namespaces]
       `(host/run-tests ~@namespaces))))

#?(:cljs
   (do
     (def report host/report)
     (def successful? host/successful?)))
