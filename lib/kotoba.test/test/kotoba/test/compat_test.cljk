(ns kotoba.test.compat-test
  "The clojure.test-compatible surface of kotoba.test, run by the repo's own
  runner (`kbb -M:test`) exactly the way a migrated call site is run. Every
  assertion here passes; the failing half lives in compat_negative.cljk,
  which the :test runner never discovers (not `*_test`) and
  compat_selftest.cljk drives on purpose."
  (:require [kotoba.test :as t :refer [deftest is are testing use-fixtures]]))

(def ^:private each-count (atom 0))
(def ^:private once-count (atom 0))

(use-fixtures :once (fn [f] (swap! once-count inc) (f)))
(use-fixtures :each (fn [f] (swap! each-count inc) (f)))

(deftest plain-is
  (is (= 4 (+ 2 2)))
  (is (= 4 (+ 2 2)) "with a message"))

(deftest thrown-forms
  (is (thrown? #?(:clj ArithmeticException :cljs js/Error)
               (throw #?(:clj (ArithmeticException. "boom") :cljs (js/Error. "boom")))))
  (is (thrown-with-msg? js/Error
                        #"bo+m"
                        (throw (ex-info "boom" {})))))

(deftest testing-and-are
  (testing "outer"
    (testing "inner"
      (is (= "cba" (apply str (reverse "abc"))))))
  (are [x y] (= x y)
    1 1
    2 2
    (+ 1 2) 3))

(deftest fixtures-ran
  ;; :each has run for this test (and possibly others before it); :once once.
  (is (pos? @each-count))
  (is (= 1 @once-count)))

(deftest host-values-are-the-host-objects
  (is (true? (t/successful? {:fail 0 :error 0})))
  (is (false? (t/successful? {:fail 1 :error 0})))
  (is (fn? t/run-tests)))
