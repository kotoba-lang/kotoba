(ns kotoba.test.split-definitions-test
  (:require [kotoba.test :refer [deftest is]]
            [kotoba.test.are :as split-are]
            [kotoba.test.deftest :as split-deftest]
            [kotoba.test.eq-form :as eq-form]
            [kotoba.test.is :as split-is]
            [kotoba.test.testing :as split-testing]
            [kotoba.test.thrown-form :as thrown-form]
            [kotoba.test.test-registry :as registry]
            [kotoba.test.run-tests-report :as report]))

(deftest split-macros-use-the-existing-registry-and-report-bindings
  (with-redefs [registry/test-registry (atom {})]
    (split-deftest/deftest split-success
      (split-testing/testing "positive context"
        (split-are/are [a b] (= a b) 1 1 2 2)
        (split-is/is (= 3 (+ 1 2)))
        (split-is/is (thrown? #?(:clj Exception :cljs js/Error)
                             (throw (ex-info "expected" {}))))))
    (split-deftest/deftest split-negative
      (split-testing/testing "retained context"
        (split-is/is (= 1 2) "deliberate inequality")
        (split-is/is (throw (ex-info "deliberate error" {})))))
    (let [result (atom nil)
          output (with-out-str
                   (reset! result
                           (report/run-tests-report 'kotoba.test.split-definitions-test)))
          details (:details @result)]
      (is (= {:test 2 :pass 4 :fail 1 :error 1 :assertions 6}
             (dissoc @result :details)))
      (is (= [:fail :error] (mapv :type details)))
      (is (= ["retained context" "retained context"] (mapv :context details)))
      (is (= 1 (:expected (first details))))
      (is (= 2 (:actual (first details))))
      (is (= "deliberate inequality" (:msg (first details))))
      (is (every? pos-int? (map :line details)))
      (is (re-find #"2 tests, 6 assertions, 1 failures, 1 errors" output)))))

(deftest split-assertion-shape-predicates-remain-exact
  (is (eq-form/eq-form? '(= expected actual)))
  (is (not (eq-form/eq-form? '(= a b c))))
  (is (thrown-form/thrown-form? '(thrown? Error body)))
  (is (not (thrown-form/thrown-form? '(thrown-with-msg? Error #"x" body)))))
