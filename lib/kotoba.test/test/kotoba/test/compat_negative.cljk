(ns kotoba.test.compat-negative
  "DELIBERATELY FAILING. Planted failures for the clojure.test-compatible
  surface of kotoba.test. Not `*_test`, so `kbb -M:test` never discovers it;
  compat_selftest.cljk runs it on purpose and asserts the EXACT counts below,
  in-process and through the fleet runner (`kbb -M:compat-negative`, which
  must exit non-zero).

  Planted: 5 tests, 7 assertions = 2 pass, 4 fail, 1 error."
  (:require [kotoba.test :refer [deftest is are testing]]))

(deftest one-pass
  (is (= 1 1)))                                          ; pass

(deftest two-fails
  (testing "equality"
    (is (= 1 2)))                                        ; fail
  (is (thrown? #?(:clj Exception :cljs js/Error) (+ 1 1)))) ; fail: nothing thrown

(deftest one-error
  (is (= 1 (throw (ex-info "planted error" {})))))       ; error

(deftest wrong-message
  (is (thrown-with-msg? js/Error
                        #"never matches"
                        (throw (ex-info "boom" {})))))   ; fail

(deftest are-one-of-two
  (are [x y] (= x y)
    1 1                                                  ; pass
    1 2))                                                ; fail
