(ns kotoba.test.compat-selftest
  "Self-verification of kotoba.test's clojure.test-compatible surface.
  `kbb -M:compat-selftest`. Exit 0 only when ALL of:

    1. in-process: running the planted suite (compat_negative.cljk) through
       kotoba.test/run-tests, with the :end-run-tests hook installed THROUGH
       kotoba.test/report, yields exactly 5 tests / 2 pass / 4 fail / 1 error;
    2. through the fleet runner: `kbb -M:compat-negative` EXITS NON-ZERO and
       prints `kbb test: 5 test(s), 2 pass, 4 fail, 1 error`;
    3. through the fleet runner: `kbb -M:test` (the green suite, which
       includes compat_test.cljk) exits 0 and reports a non-zero test count.

  (2) is the property the migration rests on: a failing `is` written against
  kotoba.test makes the repo's run fail. (3) guards the other direction --
  green because tests ran, not because none were found."
  (:require [kotoba.test :as t]
            [kotoba.test.compat-negative]))

(def cp (js/require "child_process"))

(def ^:private summary (atom nil))
(def ^:private failures (atom []))

(defn- check! [label ok? detail]
  (println (if ok? "  ok  " "  FAIL") label (if ok? "" (str "-- " detail)))
  (when-not ok? (swap! failures conj label)))

(defn- kbb [alias]
  (let [r (.spawnSync cp "kbb" (clj->js [(str "-M" alias)]) #js {:encoding "utf8"})]
    {:status (.-status r) :out (str (.-stdout r) (.-stderr r))}))

(defn- counts-line [out]
  (re-find #"kbb test: (\d+) test\(s\), (\d+) pass, (\d+) fail, (\d+) error" out))

(defn -main [& _]
  (println "compat selftest")
  ;; 1. in-process, hook installed through kotoba.test/report
  (defmethod t/report [:cljs.test/default :end-run-tests] [m] (reset! summary m))
  (binding [*print-fn* (fn [& _])]          ; the planted failures print; mute them
    (t/run-tests 'kotoba.test.compat-negative))
  (let [m @summary]
    (check! "in-process summary reached the hook installed via kotoba.test/report"
            (map? m) "hook never ran")
    (check! "in-process counts 5 tests / 2 pass / 4 fail / 1 error"
            (= [5 2 4 1] (mapv #(get m %) [:test :pass :fail :error]))
            (pr-str (select-keys m [:test :pass :fail :error])))
    (check! "successful? is false for the planted suite" (false? (t/successful? m)) (pr-str m)))
  ;; 2. fleet runner, planted suite
  (let [{:keys [status out]} (kbb ":compat-negative")]
    (check! "kbb -M:compat-negative exits non-zero" (and (number? status) (pos? status)) (str "exit " status))
    (check! "kbb -M:compat-negative reports 5 test(s), 2 pass, 4 fail, 1 error"
            (= ["5" "2" "4" "1"] (some-> (counts-line out) rest vec)) (or (counts-line out) "no counts line")))
  ;; 3. fleet runner, green suite
  (let [{:keys [status out]} (kbb ":test")
        [_ n] (counts-line out)]
    (check! "kbb -M:test exits 0" (= 0 status) (str "exit " status))
    (check! "kbb -M:test ran a non-zero number of tests" (and n (pos? (js/parseInt n))) (or (counts-line out) "no counts line")))
  (if (seq @failures)
    (do (println "COMPAT SELFTEST FAILED:" (count @failures) "check(s)") (js/process.exit 1))
    (do (println "COMPAT SELFTEST OK") (js/process.exit 0))))
