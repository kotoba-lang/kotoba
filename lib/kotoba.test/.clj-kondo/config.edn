;; kotoba.lang.test's deftest/is/testing/are are hand-rolled macros (see
;; src/kotoba/lang/test.cljk), not clojure.test's — but they have the same
;; binding-and-body shapes, so telling clj-kondo to lint them AS the
;; clojure.test equivalents it already understands avoids a wall of false
;; "unresolved symbol" errors on template/body locals it can't otherwise see
;; are bound. Recommended for any consumer namespace adopting this library
;; too (copy this file, or merge these entries into an existing one).
{:lint-as
 {kotoba.lang.test/deftest clojure.test/deftest
  kotoba.lang.test/is clojure.test/is
  kotoba.lang.test/testing clojure.test/testing
  kotoba.lang.test/are clojure.test/are}
 ;; clj-kondo's `(is (thrown? ...))` non-flagging of `thrown?` is wired to
 ;; the literal var clojure.test/is, not to :lint-as targets of it — so
 ;; `thrown?` inside OUR `is` still reads as an unresolved symbol even
 ;; though it is a real, deliberately-supported special form (see `is`'s
 ;; docstring in src/kotoba/lang/test.cljk). Excluded here rather than
 ;; worked around in source.
 :linters {:unresolved-symbol {:exclude [thrown?]}}}
