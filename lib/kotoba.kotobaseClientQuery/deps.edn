;; Pinned to upstream default-branch tips, measured 2026-09-06 with
;; `gh api repos/kotoba-lang/<repo>/commits/main`. Superproject AGENTS.md:
;; a `:git/sha` must be reachable from the upstream default branch, and there
;; is no gate for deps.edn pins the way there is for west pins — so they are
;; recorded here with how they were obtained.
{;; shadow-cljs takes :source-paths from HERE when :deps is used (it warns
 ;; and ignores the ones in shadow-cljs.edn). kotobase-client and
 ;; org-nist-sha2 are consumed as bare source paths, not artifacts —
 ;; kotobase-client has no deps.edn on purpose (consumers add its `src` to
 ;; their own paths), so this is the supported way to reach it. The paths
 ;; point into the sibling repositories in the github forest.
 :paths ["src"
         "../kotobase-client/src"
         "../org-nist-sha2/src"]
 :deps {
        io.github.kotoba-lang/kotobase-engine
        {:git/url "https://github.com/kotoba-lang/kotobase-engine.git"
         :git/sha "b8b163e889341cdf49217570380872e0575fcbdd"}
        io.github.kotoba-lang/kotobase-storage {:local/root "../kotoba.kotobaseStorage"}
        io.github.kotoba-lang/kotobase-storage-ipfs
        {:git/url "https://github.com/kotoba-lang/kotobase-storage-ipfs.git"
         :git/sha "ca5207637bbeb185a85b24ff429ee7f5a9e9fea7"}}
 :aliases {}}
