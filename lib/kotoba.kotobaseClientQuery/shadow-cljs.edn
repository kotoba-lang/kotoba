;; Source paths live in deps.edn: shadow-cljs ignores the ones here when
;; :deps is set, and says so loudly rather than silently — but the namespace
;; it then cannot find reads like a missing library, so the note stays.
{:deps {:aliases [:cljs]}
 :builds
 {:acceptance {:target :node-script
               :output-to "out/acceptance.js"
               :main kotobase-client-query.acceptance/main}}}
