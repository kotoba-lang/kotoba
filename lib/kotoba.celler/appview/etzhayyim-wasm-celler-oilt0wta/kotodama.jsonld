{
  "@context": "https://etzhayyim.com/ns/kotodama/v1",
  "@id": "did:web:celler.kotoba-lang.org",
  "architecture": "design-e-reactive-pipeline",
  "build": {
    "guestLanguage": "go"
  },
  "component": {
    "env": {
      "FREESWITCH_URL": "",
      "STUN_URL": "stun:stun.celler.kotoba-lang.org:3478",
      "TELNYX_API_KEY": "",
      "TELNYX_MESSAGING_PROFILE_ID": "",
      "TELNYX_SIP_CONNECTION_ID": "",
      "TURN_URL": "turn:turn.celler.kotoba-lang.org:3478"
    },
    "path": "/wasm/component.wasm"
  },
  "convoSystemPrompt": "You are Celler, an AI agent managing a DID-addressed encrypted telephone network. You help users make calls, manage their phone numbers, provision eSIMs, monitor mesh network health, and troubleshoot connectivity. You can initiate calls, look up DIDs, provide network status, and optimize call costs via Local Breakout routing — connecting international calls through local SIP trunks in each country to avoid expensive international rates (80-95% savings).",
  "duties": [
    "勤労の義務"
  ],
  "entities": [
    {
      "category": "gateway",
      "did": "did:web:celler.kotoba-lang.org:gw_starlink_primary",
      "displayName": "Starlink Primary Gateway",
      "slug": "gw_starlink_primary"
    },
    {
      "category": "cell",
      "did": "did:web:celler.kotoba-lang.org:cell_default",
      "displayName": "Default Cell",
      "slug": "cell_default"
    },
    {
      "category": "infrastructure",
      "did": "did:web:celler.kotoba-lang.org:sip_gateway",
      "displayName": "SIP Gateway (FreeSWITCH)",
      "slug": "sip_gateway"
    }
  ],
  "governance": {
    "classification": "internal",
    "raci": "responsible"
  },
  "interfaces": {
    "package": "kotoba-lang:celler@1.0.0"
  },
  "kpi": [
    "credits の獲得"
  ],
  "name": "celler",
  "nanoid": "oilt0wta",
  "performerType": "service",
  "profile": {
    "agentType": "autonomous",
    "capabilities": [
      "InitiateCall",
      "ProvisionNumber",
      "ProvisionEsim",
      "RegisterDevice",
      "RegisterGateway",
      "GetTopology",
      "TranscribeVoicemail",
      "TranslateCall",
      "NetworkHealth",
      "CalculateCheapestRoute",
      "ListRegionalTrunks",
      "InitiateLocalBreakoutCall",
      "ProvisionRegionalTrunk",
      "EstimateCallCost"
    ],
    "description": "DID-addressed encrypted telephony over Starlink mesh. Telnyx SIP+eSIM, FreeSWITCH, Signal Protocol E2E.",
    "displayName": "Celler",
    "isBot": true,
    "operator": "kotoba-lang.org"
  },
  "project": "celler",
  "routes": [
    {
      "host": "celler.kotoba-lang.org",
      "paths": [
        "/"
      ],
      "tls": true
    }
  ],
  "runtimeType": "worker",
  "space": {
    "channels": [
      {
        "description": "Network events and call activity",
        "name": "celler-feed"
      },
      {
        "description": "Mesh topology updates",
        "name": "celler-mesh"
      },
      {
        "description": "Network health alerts",
        "name": "celler-alerts"
      }
    ],
    "name": "Celler"
  },
  "stream": {
    "exports": [
      {
        "RequireRole": "subscriber",
        "RequireTrustLevel": "low",
        "description": "Real-time call events stream",
        "method": "stream-calls"
      },
      {
        "RequireRole": "subscriber",
        "RequireTrustLevel": "low",
        "description": "Mesh topology change stream",
        "method": "stream-mesh"
      }
    ]
  },
  "subDidCommand": "RegisterEntities",
  "triggers": {
    "subscribeRepos": {
      "collections": [
        "app.bsky.feed.post",
        "app.bsky.feed.like",
        "app.bsky.graph.follow",
        "org.kotoba-lang.apps.celler.device",
        "org.kotoba-lang.apps.celler.call",
        "org.kotoba-lang.apps.celler.gateway",
        "org.kotoba-lang.apps.celler.cell",
        "org.kotoba-lang.apps.celler.mesh_link",
        "org.kotoba-lang.apps.celler.phone_number",
        "org.kotoba-lang.apps.celler.esim_profile",
        "org.kotoba-lang.apps.celler.regional_trunk"
      ]
    }
  },
  "uiType": "iframe"
}
