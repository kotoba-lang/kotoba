(ns power.estimation
  "Static and dynamic power estimation. Restored from kami-power's
  `estimation` module (deleted PR #82).")

(defn power-breakdown [leakage-uw internal-uw switching-uw total-uw]
  {:leakage-uw leakage-uw :internal-uw internal-uw :switching-uw switching-uw :total-uw total-uw})

(defn power-estimate [total-mw by-domain by-hierarchy]
  {:total-mw total-mw :by-domain by-domain :by-hierarchy by-hierarchy})

(defn estimate-static-power
  "Estimate static (leakage) power in µW. Leakage scales exponentially
  with technology node shrink and linearly with temperature above a
  reference (25°C): `P_leak = cell_count * base_leak * voltage * temp_factor`."
  [cell-count tech-node-nm voltage temperature-c]
  (let [base-leak-nw (cond
                        (<= tech-node-nm 5) 50.0
                        (<= tech-node-nm 7) 30.0
                        (<= tech-node-nm 14) 15.0
                        (<= tech-node-nm 28) 8.0
                        (<= tech-node-nm 65) 4.0
                        :else 2.0)
        temp-factor (Math/pow 2.0 (/ (- temperature-c 25.0) 10.0))]
    (/ (* cell-count base-leak-nw voltage temp-factor) 1000.0)))

(defn estimate-dynamic-power
  "Estimate dynamic (switching + internal) power in µW:
  `P_dynamic = alpha * C_load * V^2 * f` per cell, summed. `toggle-rate`
  (alpha) is the fraction of cells switching per cycle, `clock-freq-mhz`
  is clock frequency in MHz, `load-cap-pf` is average load capacitance
  per cell in pF."
  [cell-count toggle-rate clock-freq-mhz voltage load-cap-pf]
  (* cell-count toggle-rate load-cap-pf voltage voltage clock-freq-mhz))
