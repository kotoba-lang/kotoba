(ns power.em
  "Electromigration (EM) rule checking. Restored from kami-power's `em`
  module (deleted PR #82).")

(defn em-rule [layer max-avg-current-ma-per-um max-peak-current-ma-per-um max-rms-current-ma-per-um]
  {:layer layer :max-avg-current-ma-per-um max-avg-current-ma-per-um
   :max-peak-current-ma-per-um max-peak-current-ma-per-um
   :max-rms-current-ma-per-um max-rms-current-ma-per-um})

(defn wire-info [net-name layer width-um length-um avg-current-ma]
  {:net-name net-name :layer layer :width-um width-um :length-um length-um :avg-current-ma avg-current-ma})

(defn check-em
  "Check EM rules against `wires`. For each wire, the average current
  density (mA/µm) is compared against the matching layer rule's
  `:max-avg-current-ma-per-um` limit. Returns violations with the
  computed margin (negative = violation)."
  [wires rules]
  (vec
   (keep
    (fn [w]
      (when-let [rule (some #(when (= (:layer %) (:layer w)) %) rules)]
        (let [limit-ma (* (:max-avg-current-ma-per-um rule) (:width-um w))]
          (when (> (:avg-current-ma w) limit-ma)
            {:net-name (:net-name w) :layer (:layer w) :wire-width-um (:width-um w)
             :current-ma (:avg-current-ma w) :limit-ma limit-ma
             :margin (/ (- limit-ma (:avg-current-ma w)) limit-ma)}))))
    wires)))
