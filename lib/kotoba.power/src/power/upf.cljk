(ns power.upf
  "Unified Power Format (UPF) power intent description and validation.
  Restored from kami-power's `upf` module (kami-engine/kami-power/src/
  lib.rs, deleted PR #82)."
  (:require [kotoba.lang.text :as str]))

(def clamp-values #{:high-z :zero :one :latch})
(def isolation-locations #{:from :to})
(def shifter-directions #{:low-to-high :high-to-low})

(defn upf-design
  "A fresh, empty UPF design."
  []
  {:domains [] :switches [] :isolations [] :retentions [] :level-shifters []})

(defn- flag-value
  "The value following `flag` in `tokens` (e.g. `-supply VDD` -> \"VDD\")."
  [tokens flag]
  (when-let [idx (first (keep-indexed (fn [i t] (when (= t flag) i)) tokens))]
    (when (< (inc idx) (count tokens))
      (nth tokens (inc idx)))))

(defn parse-upf
  "Parse a simplified UPF text format. Supported commands (one per line):
  `create_power_domain`/`create_power_switch`/`set_isolation`/
  `set_retention`/`set_level_shifter`."
  [input]
  (reduce
   (fn [design line]
     (let [line (str/trim line)]
       (if (or (str/blank? line) (str/starts-with? line "#"))
         design
         (let [tokens (str/split line #"\s+")]
           (if (empty? tokens)
             design
             (let [name (nth tokens 1 "")]
               (case (nth tokens 0)
                 "create_power_domain"
                 (update design :domains conj
                         {:name name
                          :supply-net (or (flag-value tokens "-supply") "")
                          :ground-net (or (flag-value tokens "-ground") "")
                          :elements (if-let [e (flag-value tokens "-elements")]
                                      (str/split e #",")
                                      [])
                          :default-retention (boolean (some #{"-retention"} tokens))})

                 "create_power_switch"
                 (update design :switches conj
                         {:name name
                          :domain (or (flag-value tokens "-domain") "")
                          :control-signal (or (flag-value tokens "-control") "")
                          :ack-signal (or (flag-value tokens "-ack") "")})

                 "set_isolation"
                 (update design :isolations conj
                         {:name name
                          :domain (or (flag-value tokens "-domain") "")
                          :location (case (flag-value tokens "-location") "to" :to :from)
                          :clamp-value (case (flag-value tokens "-clamp")
                                         "zero" :zero "one" :one "latch" :latch :high-z)})

                 "set_retention"
                 (update design :retentions conj
                         {:name name
                          :domain (or (flag-value tokens "-domain") "")
                          :save-signal (or (flag-value tokens "-save") "")
                          :restore-signal (or (flag-value tokens "-restore") "")})

                 "set_level_shifter"
                 (update design :level-shifters conj
                         {:name name
                          :from-domain (or (flag-value tokens "-from") "")
                          :to-domain (or (flag-value tokens "-to") "")
                          :direction (case (flag-value tokens "-direction")
                                       "high_to_low" :high-to-low :low-to-high)})

                 design)))))))
   (upf-design)
   (str/split-lines input)))

(defn validate
  "Validate `design`, returning a vector of warning/error message strings
  for any switch/isolation/retention/level-shifter referencing an unknown
  domain."
  [design]
  (let [domain-names (into #{} (map :name (:domains design)))]
    (vec
     (concat
      (for [sw (:switches design) :when (not (domain-names (:domain sw)))]
        (str "Power switch '" (:name sw) "' references unknown domain '" (:domain sw) "'"))
      (for [iso (:isolations design) :when (not (domain-names (:domain iso)))]
        (str "Isolation cell '" (:name iso) "' references unknown domain '" (:domain iso) "'"))
      (for [ret (:retentions design) :when (not (domain-names (:domain ret)))]
        (str "Retention cell '" (:name ret) "' references unknown domain '" (:domain ret) "'"))
      (mapcat
       (fn [ls]
         (cond-> []
           (not (domain-names (:from-domain ls)))
           (conj (str "Level shifter '" (:name ls) "' references unknown from_domain '" (:from-domain ls) "'"))
           (not (domain-names (:to-domain ls)))
           (conj (str "Level shifter '" (:name ls) "' references unknown to_domain '" (:to-domain ls) "'"))))
       (:level-shifters design))))))
