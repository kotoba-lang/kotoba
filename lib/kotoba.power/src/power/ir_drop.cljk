(ns power.ir-drop
  "IR drop analysis on a resistive power grid. Restored from kami-power's
  `ir_drop` module (deleted PR #82). A simplified power grid where supply
  pads are at the perimeter and current is drawn at each internal node,
  solved via iterative relaxation (Gauss-Seidel).")

(defn- is-pad? [rows cols r c]
  (or (= r 0) (= r (dec rows)) (= c 0) (= c (dec cols))))

(defn- current-at [current-map r c]
  (or (get-in current-map [r c]) 0.0))

(defn analyze-ir-drop
  "Analyze IR drop on a `grid-rows` x `grid-cols` uniform resistive grid.
  `supply-v` is nominal supply voltage (V), `current-map` is current draw
  at each grid node (A, `[[row]...]`), `resistance-per-unit` is the
  resistance between adjacent grid nodes (ohms)."
  [grid-rows grid-cols supply-v current-map resistance-per-unit]
  (let [v0 (vec (repeat grid-rows (vec (repeat grid-cols supply-v))))
        max-iter 500
        final-v
        (loop [iter 0 v v0]
          (if (>= iter max-iter)
            v
            (let [[v max-delta]
                  (reduce
                   (fn [[v max-delta] [r c]]
                     (if (is-pad? grid-rows grid-cols r c)
                       [v max-delta]
                       (let [neighbors (cond-> []
                                          (> r 0) (conj (get-in v [(dec r) c]))
                                          (< (inc r) grid-rows) (conj (get-in v [(inc r) c]))
                                          (> c 0) (conj (get-in v [r (dec c)]))
                                          (< (inc c) grid-cols) (conj (get-in v [r (inc c)])))
                             cnt (count neighbors)
                             sum (reduce + 0.0 neighbors)
                             current (current-at current-map r c)
                             new-v (- (/ sum cnt) (/ (* current resistance-per-unit) cnt))
                             delta (Math/abs (- new-v (get-in v [r c])))]
                         [(assoc-in v [r c] new-v) (max max-delta delta)])))
                   [v 0.0]
                   (for [r (range grid-rows) c (range grid-cols)] [r c]))]
              (if (< max-delta 1e-9)
                v
                (recur (inc iter) v)))))
        hotspot-threshold-mv (* supply-v 0.05 1000.0)]
    (let [entries (for [r (range grid-rows) c (range grid-cols)]
                    [r c (* (- supply-v (get-in final-v [r c])) 1000.0)])
          max-entry (apply max-key #(nth % 2) entries)
          total-drop (reduce + 0.0 (map #(nth % 2) entries))
          count-n (count entries)
          hotspots (vec (for [[r c d] entries :when (> d hotspot-threshold-mv)] [r c d]))]
      {:max-drop-mv (nth max-entry 2)
       :avg-drop-mv (if (pos? count-n) (/ total-drop count-n) 0.0)
       :worst-node [(nth max-entry 0) (nth max-entry 1)]
       :hotspots hotspots})))
