(ns power-test
  "Restoration-fidelity tests — one per original kami-power Rust test
  (kami-engine/kami-power/src/lib.rs `mod tests`, deleted PR #82)."
  (:require [kotoba.test :refer [deftest is testing]]
            [kotoba.lang.text :as str]
            [power]
            [power.upf :as upf]
            [power.estimation :as estimation]
            [power.ir-drop :as ir-drop]
            [power.em :as em]))

(deftest namespace-loads
  (testing "the restored CLJC namespace loads"
    (is (some? (find-ns 'power)))))

;; mirrors `upf_parse_basic_domains`
(deftest upf-parse-basic-domains
  (let [input "
# Power intent
create_power_domain PD_TOP -supply VDD -ground VSS -elements core,mem
create_power_domain PD_IO -supply VDDIO -ground VSS
create_power_switch SW1 -domain PD_TOP -control pwr_en -ack pwr_ack
set_isolation ISO1 -domain PD_TOP -location from -clamp zero
set_retention RET1 -domain PD_TOP -save save_sig -restore restore_sig
set_level_shifter LS1 -from PD_TOP -to PD_IO -direction low_to_high
"
        design (upf/parse-upf input)]
    (is (= 2 (count (:domains design))))
    (is (= "PD_TOP" (:name (first (:domains design)))))
    (is (= "VDD" (:supply-net (first (:domains design)))))
    (is (= ["core" "mem"] (:elements (first (:domains design)))))
    (is (= 1 (count (:switches design))))
    (is (= 1 (count (:isolations design))))
    (is (= :zero (:clamp-value (first (:isolations design)))))
    (is (= 1 (count (:retentions design))))
    (is (= 1 (count (:level-shifters design))))
    (is (= :low-to-high (:direction (first (:level-shifters design)))))
    (is (empty? (upf/validate design)))))

;; mirrors `upf_validate_unknown_domain`
(deftest upf-validate-unknown-domain
  (let [input "create_power_switch SW1 -domain MISSING -control en -ack ack"
        design (upf/parse-upf input)
        errors (upf/validate design)]
    (is (= 1 (count errors)))
    (is (str/includes? (first errors) "MISSING"))))

;; mirrors `dynamic_power_formula`
(deftest dynamic-power-formula
  (let [p (estimation/estimate-dynamic-power 1000 0.1 1000.0 1.0 0.01)]
    (is (< (Math/abs (- p 1000.0)) 0.01))))

;; mirrors `ir_drop_uniform_grid`
(deftest ir-drop-uniform-grid
  (let [rows 5 cols 5 supply 1.0 r 0.1
        current-map (assoc-in (vec (repeat rows (vec (repeat cols 0.0)))) [2 2] 0.01)
        result (ir-drop/analyze-ir-drop rows cols supply current-map r)]
    (is (= [2 2] (:worst-node result)))
    (is (> (:max-drop-mv result) 0.0))
    (is (>= (:avg-drop-mv result) 0.0))))

;; mirrors `em_violation_detection`
(deftest em-violation-detection
  (let [rules [(em/em-rule "M1" 1.0 3.0 2.0)]
        wires [(em/wire-info "net_ok" "M1" 2.0 100.0 1.5)
               (em/wire-info "net_bad" "M1" 0.5 50.0 1.0)]
        violations (em/check-em wires rules)]
    (is (= 1 (count violations)))
    (is (= "net_bad" (:net-name (first violations))))
    (is (< (:margin (first violations)) 0.0))
    (is (< (Math/abs (- (:limit-ma (first violations)) 0.5)) 0.001))))

;; mirrors `power_breakdown_total`
(deftest power-breakdown-total
  (let [b (estimation/power-breakdown 100.0 200.0 300.0 600.0)]
    (is (< (Math/abs (- (:total-uw b) (+ (:leakage-uw b) (:internal-uw b) (:switching-uw b)))) 0.01))))

;; mirrors `static_power_scales_with_temperature`
(deftest static-power-scales-with-temperature
  (let [p25 (estimation/estimate-static-power 1000 7 0.8 25.0)
        p85 (estimation/estimate-static-power 1000 7 0.8 85.0)]
    (is (> p85 (* p25 3.0)))))
