;; TS SDK は prune 済み（owner 決定 2026-10-20: kotoba + amu selfhost に一本化）。
;; ソースカタログは kotoba 側の生成物を指す。実行面は amu selfhost。
#:kotodama.host.sdk{:source-catalog :sdk-source-catalog,
                    :authority [:kotoba-clj :edn],
                    :sdk-root ".",
                    :source-root "src/kotodama",
                    :default-policy :cljc-authority-only,
                    :sources
                    [#:kotodama.host.sdk{:path
                                         "src/kotodama/host_facade.cljc",
                                         :language :cljc,
                                         :role :generated-adapter,
                                         :authority? true}]}
