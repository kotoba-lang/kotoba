(ns kotodama.facade-parity-test
  "JUN-133 スライス②: facade の実行手前の parity（drift 検出）。
  facade（生成物）↔ boundary.edn（guest 境界権威）↔ wit（コンポーネント出力）
  の 3 者が一致することを検証する。TS SDK は prune 済み（owner 決定
  2026-10-20）で、実行面は kotoba + amu selfhost。"
  (:require [clojure.test :refer [deftest is testing]]
            [clojure.edn :as edn]
            [clojure.string :as str]
            [kotodama.host-facade :as facade]))

(def boundary (edn/read-string (slurp "lib/kotoba.kotodamaHost/resources/kotodama_host/boundary.edn")))
(def wit-src (slurp "lib/kotoba.kotodamaHost/wit/kotodama-host.wit"))
(def sdk-pruned? (not (.existsSync (js/require "node:fs") "sdk/kotodama-host-sdk")))

(defn- exports-by-name [edn-map]
  (into {} (map (fn [e] [(get e (keyword "kotodama.host" "name")) e])
                (get edn-map (keyword "kotodama.host" "exports")))))

(deftest facade-ops-match-boundary-exports
  (testing "facade の component-export は boundary.edn の export 集合と一致"
    (let [bex (exports-by-name boundary)]
      (is (= (set (map :component-export facade/sdk-operations))
             (set (keys bex))))
      (doseq [op facade/sdk-operations]
        (let [entry (get bex (:component-export op))]
          (is (some? entry) (str "boundary に " (:component-export op) " が無い"))
          (is (= (:request op) (get entry (keyword "kotodama.host" "request"))))
          (is (= (:response op) (get entry (keyword "kotodama.host" "response")))))))))

(deftest facade-ops-match-wit-exports
  (testing "facade の component-export は WIT の export に対応する（/ → -）"
    (doseq [op facade/sdk-operations]
      (let [x (:component-export op)
              wit-name (str (namespace x) "-" (name x))]
        (is (str/includes? wit-src (str "export " wit-name ":"))
            (str "WIT に export " wit-name " が無い"))))))

(deftest ts-sdk-is-pruned
  (testing "TS SDK は prune 済み（owner 決定 2026-10-20: kotoba + amu selfhost）"
    (is sdk-pruned?
        "sdk/kotodama-host-sdk が残っている — kotoba/amu selfhost 方針に反する")))
