(ns kotodama.host-facade-gen-test
  "CLJC facade 生成器のテスト（JUN-133 スライス①）。"
  (:require [clojure.test :refer [deftest is testing]]
            [clojure.edn :as edn]
            [kotodama.host-facade-gen :as gen]
            [kotodama.host-facade :as facade]))

(def facade-edn (edn/read-string (slurp "lib/kotoba.kotodamaHost/resources/kotodama_host/sdk_facade.edn")))

(deftest regeneration-is-idempotent
  (testing "生成物は committed の host_facade.cljc と一致（再生成の冪等）"
    (is (= (slurp gen/generated-path)
           (gen/generate-facade facade-edn)))))

(deftest generated-facade-shape
  (testing "operations は EDN 権威と一致"
    (is (= 4 (count facade/sdk-operations)))
    (is (= [:create-host-sdk :dispatch :cancel :health]
           facade/operation-names)))
  (testing "find-operation / operation?"
    (is (= :actor/dispatch-request
           (:request (facade/find-operation :dispatch))))
    (is (facade/operation? :health))
    (is (not (facade/operation? :no-such-op)))
    (is (nil? (facade/find-operation :no-such-op))))
  (testing "provenance ヘッダがある"
    (is (re-find #"GENERATED FILE. DO NOT EDIT"
                 (slurp gen/generated-path))))
  (testing "package と authority は EDN から"
    (is (= "@etzhayyim/kotoba-kotodama-host-sdk" facade/sdk-package))
    (is (= [:kotoba-clj :edn] facade/sdk-authority))))

(deftest edn-authority-paths-point-at-reality
  (testing "edn の :generated / :runtime-entry は実在の生成物を指す"
    (let [gen-path (get facade-edn (keyword "kotodama.host.sdk" "generated"))
          rt-path (get facade-edn (keyword "kotodama.host.sdk" "runtime-entry"))]
      (is (= "src/kotodama/host_facade.cljc" gen-path rt-path)))))
