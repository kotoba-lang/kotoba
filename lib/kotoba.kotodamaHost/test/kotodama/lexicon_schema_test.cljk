(ns kotodama.lexicon-schema-test
  "LEXICON_INPUT_SCHEMA 実データ（lexicon_input_schema.edn）のテスト
  （JUN-133 スライス⑦）。履歴の生成物からの機械変換を実データで固定する。"
  (:require [clojure.test :refer [deftest is testing]]
            [clojure.edn :as edn]
            [kotodama.host-surface :as lx]))

(def data (edn/read-string (slurp "lib/kotoba.kotodamaHost/resources/kotodama_host/lexicon_input_schema.edn")))
(def schema (:kotodama.host.lexicon/input-schema data))

(deftest data-shape
  (testing "変換後の規模（生成物と一致: 502 NSIDs）"
    (is (= 502 (count schema))))
  (testing "entry 形状"
    (let [e (get schema "com.etzhayyim.host.core.logAppend")]
      (is (= "object" (:type e)))
      (is (= {"stream" "string" "payload" "string"} (:properties e)))
      (is (= ["stream" "payload"] (:required e))))))

(deftest real-schema-validation
  (testing "実スキーマで parse-lexicon-input が動く"
    (is (= {"stream" "s" "payload" "p"}
           (lx/parse-lexicon-input schema "com.etzhayyim.host.core.logAppend"
                                   "{\"stream\":\"s\",\"payload\":\"p\"}")))
    (let [r (lx/try-parse-lexicon-input schema "com.etzhayyim.host.core.logAppend"
                                        "{\"stream\":\"s\"}")]
      (is (false? (:ok r)))
      (is (= ["missing required property 'payload'"] (:issues r)))))
  (testing "governance.registerManifest（manifest: string）"
    (is (= {"manifest" "{}"}
           (lx/parse-lexicon-input schema "com.etzhayyim.governance.registerManifest"
                                   "{\"manifest\":\"{}\"}")))
    (is (= ["property 'manifest': expected string, got integer"]
           (:issues (lx/try-parse-lexicon-input
                     schema "com.etzhayyim.governance.registerManifest"
                     "{\"manifest\":1}")))))
  (testing "スキーマ無し NSID は検証なし"
    (is (= {"x" 1}
           (lx/parse-lexicon-input schema "com.example.unknown" "{\"x\":1}")))))
