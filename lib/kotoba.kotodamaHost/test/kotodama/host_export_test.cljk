(ns kotodama.host-export-test
  "Worker/export 系のテスト（JUN-133 スライス③）。"
  (:require [clojure.test :refer [deftest is testing]]
            [kotodama.host-export :as x]))

(deftest tool-spec-shape
  (testing "as-agent-tool"
    (is (= {:kotodama.host.export/type :agent-tool :description "d"}
           (x/as-agent-tool "d")))
    (is (nil? (x/as-agent-tool "")))
    (is (nil? (x/as-agent-tool 42))))
  (testing "with-capability-tags"
    (is (= {:kotodama.host.export/type :capability-tags :tags ["write" "itonami"]}
           (x/with-capability-tags "write" "itonami")))
    (is (nil? (x/with-capability-tags)))
    (is (nil? (x/with-capability-tags "write" "")))))

(deftest registry-building
  (testing "create-worker-export + command の純粋な登録"
    (let [reg (x/create-worker-export
               (fn [b]
                 (-> b
                     (x/command "com.example.doThing" (fn [_c _body] :ok)
                                (x/as-agent-tool "does a thing")
                                (x/with-capability-tags "write"))
                     (x/command "com.example.listThings" (fn [_c _body] :ok)
                                (x/as-agent-tool "lists things")
                                (x/with-capability-tags "read" "itonami")))))]
      (is (= 2 (count (:commands reg))))
      (is (= ["com.example.doThing" "com.example.listThings"]
             (mapv :name (:commands reg))))
      (is (= ["write"] (:tags (first (:commands reg)))))
      (is (= "lists things" (:description (second (:commands reg))))))))

(deftest fail-closed
  (testing "不正入力は例外"
    (is (thrown? js/Error
                 (x/command (x/empty-registry) "not-an-nsid" (fn [_ _])
                            (x/as-agent-tool "d") (x/with-capability-tags "t"))))
    (is (thrown? js/Error
                 (x/command (x/empty-registry) "com.example.x" :not-a-fn
                            (x/as-agent-tool "d") (x/with-capability-tags "t"))))
    (is (thrown? js/Error
                 (x/command (x/empty-registry) "com.example.x" (fn [_ _])
                            {:bad true} (x/with-capability-tags "t"))))
    (is (thrown? js/Error
                 (x/command (x/empty-registry) "com.example.x" (fn [_ _])
                            (x/as-agent-tool "d") {:bad true})))
    (is (thrown? js/Error
                 (-> (x/empty-registry)
                     (x/command "com.example.x" (fn [_ _])
                                (x/as-agent-tool "d") (x/with-capability-tags "t"))
                     (x/command "com.example.x" (fn [_ _])
                                (x/as-agent-tool "d") (x/with-capability-tags "t")))))
    (is (thrown? js/Error (x/create-worker-export :not-a-fn)))
    (is (thrown? js/Error (x/create-worker-export (fn [_b] :nope))))))
