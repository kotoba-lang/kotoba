(ns kotodama.host-cadence-test
  "cadence 判定カーネル / resolveModelId のテスト（JUN-133 スライス⑤）。
  TS 正本（06e57cf^）の値・分岐を固定する。"
  (:require [clojure.test :refer [deftest is testing]]
            [kotodama.host-surface :as c]
            [kotodama.host-surface :as m]))

(def joucho {:joy 80 :calm 60 :stress 30 :gratitude 50 :focus 70})

(deftest mood-determination
  (is (= :stressed (c/determine-mood (assoc joucho :stress 70))))
  (is (= :stressed (c/determine-mood (assoc joucho :stress 90))))
  (is (= :joyful (c/determine-mood joucho)))
  (is (= :neutral (c/determine-mood {:joy 30 :calm 40 :stress 10
                                     :gratitude 20 :focus 59})))
  (is (= :focused (c/determine-mood {:joy 50 :calm 60 :stress 10
                                     :gratitude 55 :focus 61}))))

(deftest cadence-table
  (testing "joyful の表（TS の値）"
    (let [cd (c/mood->cadence :joyful)]
      (is (= 1800000 (:post-cooldown-ms cd)))
      (is (= 10800000 (:analyze-cooldown-ms cd)))
      (is (false? (:drill-enabled cd)))))
  (testing "stressed は post/engage 無効"
    (let [cd (c/mood->cadence :stressed)]
      (is (false? (:post-enabled cd)))
      (is (false? (:engage-enabled cd)))))
  (testing "neutral は default 分岐と同じ"
    (let [cd (c/mood->cadence :neutral)]
      (is (= 7200000 (:post-cooldown-ms cd)))
      (is (every? true? [(:post-enabled cd) (:analyze-enabled cd)
                         (:drill-enabled cd) (:validate-enabled cd)
                         (:engage-enabled cd)]))))
  (testing "未知 mood は default"
    (is (= (c/mood->cadence :neutral) (c/mood->cadence :unknown-mood)))))

(deftest stress-scaling
  (testing "stress < 50 は不変"
    (let [cd (c/mood->cadence :calm)]
      (is (= cd (c/apply-stress-scaling cd 49)))))
  (testing "stress 75 は scale 1.5（post/engage のみ拡大）"
    (let [cd (c/apply-stress-scaling (c/mood->cadence :calm) 75)]
      (is (= 10800000 (:post-cooldown-ms cd)))   ; 7200000 * 1.5
      (is (= 5400000 (:engage-cooldown-ms cd)))  ; 3600000 * 1.5
      (is (= 3600000 (:analyze-cooldown-ms cd))))) ; 不変
  (testing "scale は Math.round（TS と同じ）"
    (let [cd (c/apply-stress-scaling (c/mood->cadence :joyful) 51)]
      (is (= 1836000 (:post-cooldown-ms cd)))))) ; 1800000 * 1.02

(def registry
  {"gemma-4-e4b-it" {:available true :cf-model "@cf/google/gemma-4-e4b-it"}
   "maxwell-1" {:available true :cf-model "huggingface:etzhayyim/maxwell-1-gemma4-e4b"}
   "old-model" {:available false :cf-model "@cf/old"}})
(def aliases {"maxwell" "maxwell-1"})
(def uc-defaults {"summarize" "gemma-4-e4b-it" "unavailable-uc" "old-model"})

(deftest model-resolution
  (testing "hint 直接"
    (is (= "maxwell-1" (m/resolve-model-id registry aliases uc-defaults "maxwell-1" nil))))
  (testing "alias（小文字）"
    (is (= "maxwell-1" (m/resolve-model-id registry aliases uc-defaults "MAXWELL" nil))))
  (testing "cf-model 一致（大小無視）"
    (is (= "maxwell-1" (m/resolve-model-id registry aliases uc-defaults
                                           "HuggingFace:Etzhayyim/Maxwell-1-Gemma4-E4B" nil))))
  (testing "unavailable hint は use-case へフォールスルー"
    (is (= "gemma-4-e4b-it"
           (m/resolve-model-id registry aliases uc-defaults "old-model" "summarize"))))
  (testing "use-case 既定"
    (is (= "gemma-4-e4b-it"
           (m/resolve-model-id registry aliases uc-defaults nil "summarize"))))
  (testing "use-case の既定が unavailable ならフォールバック"
    (is (= "gemma-4-e4b-it"
           (m/resolve-model-id registry aliases uc-defaults nil "unavailable-uc"))))
  (testing "最終フォールバック"
    (is (= "gemma-4-e4b-it"
           (m/resolve-model-id registry aliases uc-defaults "nope" "nope")))
    (is (= "gemma-4-e4b-it"
           (m/resolve-model-id registry aliases uc-defaults nil nil)))))
