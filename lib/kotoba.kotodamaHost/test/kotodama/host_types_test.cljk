(ns kotodama.host-types-test
  "型 3 つのテスト（JUN-133 スライス⑧）。TS 正本（06e57cf^）の形状を固定。"
  (:require [clojure.test :refer [deftest is testing]]
            [kotodama.host-surface :as t]))

(def commit
  {:seq 42 :repo "did:plc:abc" :collection "app.bsky.feed.post"
   :rkey "3kx2" :action "create" :cid "bafy..." :rev "rev1" :time "2026-10-20T00:00:00.000Z"})

(deftest commit-shape
  (is (t/com-atproto-sync-subscribe-repos-commit? commit))
  (is (t/com-atproto-sync-subscribe-repos-commit? (assoc commit :cid nil :rev nil)))
  (testing "fail closed"
    (is (not (t/com-atproto-sync-subscribe-repos-commit? (dissoc commit :seq))))
    (is (not (t/com-atproto-sync-subscribe-repos-commit? (assoc commit :seq -1))))
    (is (not (t/com-atproto-sync-subscribe-repos-commit? (assoc commit :repo ""))))
    (is (not (t/com-atproto-sync-subscribe-repos-commit? (assoc commit :cid 5))))
    (is (not (t/com-atproto-sync-subscribe-repos-commit? "x")))))

(deftest app-def-shape
  (is (t/app-def? {:id "itonami" :name "Itonami"}))
  (is (t/app-def? {:id "a" :name "b" :description "d"
                   :agent {:system-prompt "s" :model "gemma-4-e4b-it"}}))
  (testing "fail closed"
    (is (not (t/app-def? {:id "a"})))
    (is (not (t/app-def? {:id "a" :name "b" :agent {:model "m"}})))
    (is (not (t/agent-config? {:system-prompt "s"})))
    (is (t/agent-config? {:system-prompt "s" :model "m"}))))

(deftest host-sdk-shape
  (let [handle {:app {} :env {} :host-imports {} :pds {} :router {}
                :handle-request (fn [_req] :resp)
                :wit-exports {:http-handler {:handle (fn [_] :r)}
                              :w-handler {:handle-com-atproto-sync-subscribe-repos-commit
                                          (fn [_] {:tag "ok"})}
                              :serve-handler {:handle (fn [_ _] :r)}
                              :shinka-handler {:on-heartbeat (fn [_] :r)}}}]
    (is (t/host-sdk? handle))
    (testing "fail closed"
      (is (not (t/host-sdk? (dissoc handle :pds))))
      (is (not (t/host-sdk? (assoc handle :handle-request :not-a-fn))))
      (is (not (t/host-sdk? (assoc handle :wit-exports {}))))
      (is (not (t/host-sdk? (assoc-in handle [:wit-exports :http-handler :handle] :nope)))))))
