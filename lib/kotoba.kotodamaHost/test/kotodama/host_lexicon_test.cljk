(ns kotodama.host-lexicon-test
  "parseLexiconInput 系 / heartbeat 系のテスト（JUN-133 スライス④）。
  TS 正本（06e57cf^）のメッセージ形式・判定を固定する。"
  (:require [clojure.test :refer [deftest is testing]]
            [kotodama.host-surface :as lx]
            [kotodama.host-surface :as hb]))

(def schema
  {:required ["id"]
   :properties {"id" "string"
                "count" "integer"
                "ratio" "number"
                "flag" "boolean"
                "meta" "object"
                "any" "unknown"}})

(deftest type-of-value-mapping
  (is (= "unknown" (lx/type-of-value nil)))
  (is (= "unknown" (lx/type-of-value js/undefined)))
  (is (= "string" (lx/type-of-value "s")))
  (is (= "boolean" (lx/type-of-value true)))
  (is (= "integer" (lx/type-of-value 5)))
  (is (= "number" (lx/type-of-value 5.5)))
  (is (= "array" (lx/type-of-value [1 2])))
  (is (= "object" (lx/type-of-value {"a" 1}))))

(deftest validate-messages
  (testing "TS と同文の issue メッセージ"
    (is (= ["input is not an object (got string)"]
           (lx/validate-against-schema "x" schema)))
    (is (= ["missing required property 'id'"]
           (lx/validate-against-schema {"count" 1} schema)))
    (is (= ["missing required property 'id'"]
           (lx/validate-against-schema {"id" nil} schema)))
    (is (= ["property 'count': expected integer, got string"]
           (lx/validate-against-schema {"id" "a" "count" "s"} schema))))
  (testing "型の寛容性（unknown は何でも、number は integer を受ける）"
    (is (= [] (lx/validate-against-schema {"id" "a" "count" 2 "ratio" 3
                                           "flag" true "meta" {} "any" [1]}
                                          schema)))
    (is (= ["property 'ratio': expected number, got string"]
           (lx/validate-against-schema {"id" "a" "ratio" "s"} schema)))
    (is (= ["property 'count': expected integer, got number"]
           (lx/validate-against-schema {"id" "a" "count" 1.5} schema))))
  (testing "未指定プロパティは検証しない"
    (is (= [] (lx/validate-against-schema {"id" "a" "extra" "x"} schema)))))

(deftest parse-and-try-parse
  (let [registry {"com.example.thing" schema}]
    (testing "スキーマ無し NSID は検証せず decode のみ"
      (is (= {"x" 1} (lx/parse-lexicon-input registry "com.example.void" "{\"x\":1}"))))
    (testing "妥当な入力"
      (is (= {"id" "a"} (lx/parse-lexicon-input registry "com.example.thing" "{\"id\":\"a\"}"))))
    (testing "不正は例外（parse）/ issues（try）"
      (is (thrown? js/Error
                   (lx/parse-lexicon-input registry "com.example.thing" "{}")))
      (let [r (lx/try-parse-lexicon-input registry "com.example.thing" "{}")]
        (is (false? (:ok r)))
        (is (= ["missing required property 'id'"] (:issues r)))))
    (testing "try の成功形"
      (let [r (lx/try-parse-lexicon-input registry "com.example.thing" "{\"id\":\"a\"}")]
        (is (true? (:ok r)))
        (is (= {"id" "a"} (:input r)))))))

(deftest heartbeat-factories
  (testing "create-inbox-buffer（TS と同じ構造）"
    (is (= {:inbound-commits [] :reactions [] :prev-joucho nil
            :follower-snapshots {}}
           (hb/create-inbox-buffer))))
  (testing "create-cadence-state（7 フィールド）"
    (is (= {:last-post-at 0 :last-analyze-at 0 :last-drill-at 0
            :last-validate-at 0 :last-engage-at 0 :last-reward-at 0
            :recent-post-types []}
           (hb/create-cadence-state)))))
