(ns kotodama.model-registry-test
  "MODEL_REGISTRY 実データ（model_registry.edn）のテスト（JUN-133 スライス⑥）。
  履歴（06e57cf^）からの機械変換を実データで固定する。"
  (:require [clojure.test :refer [deftest is testing]]
            [clojure.edn :as edn]
            [kotodama.host-surface :as m]))

(def data (edn/read-string (slurp "lib/kotoba.kotodamaHost/resources/kotodama_host/model_registry.edn")))
(def registry (:kotodama.host.model/registry data))
(def aliases (:kotodama.host.model/aliases data))
(def uc-defaults (:kotodama.host.model/use-case-defaults data))

(deftest data-shape
  (testing "変換後の規模（元実装と一致）"
    (is (= 13 (count registry)))
    (is (= 12 (count aliases)))
    (is (= 25 (count uc-defaults))))
  (testing "定数（元実装の SSoT）"
    (is (= "gemma-4-e4b-it" (:kotodama.host.model/murakumo-default-model data)))
    (is (= "maxwell-1" (:kotodama.host.model/maxwell-default-weight data))))
  (testing "kebab 変換されたフィールド"
    (let [m (get registry "gemma4-runpod")]
      (is (= "openai/gemma-4-e4b-it" (:cf-model m)))
      (is (= 8192 (:max-tokens m)))
      (is (= 128000 (:context-window m)))
      (is (true? (:available m))))))

(deftest resolution-with-real-data
  (testing "maxwell-1 は R0 で unavailable → use-case 経由で gemma-4-e4b-it"
    (is (false? (get-in registry ["maxwell-1" :available])))
    (is (= "gemma-4-e4b-it"
           (m/resolve-model-id registry aliases uc-defaults "maxwell" "general"))))
  (testing "alias 経由（gemma-4-e4b → gemma-4-e4b-it）"
    (is (= "gemma-4-e4b-it"
           (m/resolve-model-id registry aliases uc-defaults "gemma-4-e4b" nil))))
  (testing "cf-model 一致（qwen2.5-coder-32b は unavailable → use-case へ）"
    (is (false? (get-in registry ["qwen2.5-coder-32b" :available])))
    (is (= "qwen3-30b"
           (m/resolve-model-id registry aliases uc-defaults
                               "@cf/qwen/qwen2.5-coder-32b-instruct" "extraction"))))
  (testing "use-case 既定（実データ）"
    (is (= "qwen3-30b" (m/resolve-model-id registry aliases uc-defaults nil "kyumei-koji")))
    (is (= "qwq-32b" (m/resolve-model-id registry aliases uc-defaults nil "reasoning")))
    (is (= "gemma-3-12b" (m/resolve-model-id registry aliases uc-defaults nil "translation")))
    (is (= "gemma-4-e4b-base"
           (m/resolve-model-id registry aliases uc-defaults nil "training-base"))))
  (testing "未知 hint + 未知 use-case は最終フォールバック"
    (is (= "gemma-4-e4b-it"
           (m/resolve-model-id registry aliases uc-defaults "zzz" "zzz")))))
