(ns kotodama.host-types
  "差替え面の型判定 guest 核（JUN-149 スライス②: amu 適格化）。
  typed guest 覇約（型注釈必須・host interop 禁止・:export 必須）。
  形状判定は canonical typed map（[:map key-type value-type]）のフィールド検証に
  落とす（混在値のマップは持てない —— 実測）。関数値フィールドを持つ
  HostSDK 形は guest では表せないため oracle（host_surface.cljk）側に残す。
  返り値はスカラー（:i64 の 1/0、guest ABI）。意味の正本は本モジュール。"
  (:export [main seq-ok? text-ok? commit-shape-ok? agent-config-ok? app-def-shape-ok?
            test-seq-ok test-seq-bad test-text-ok test-text-bad
            test-commit-ok test-commit-missing-time test-commit-bad-seq
            test-agent-config-ok test-agent-config-bad
            test-app-def-ok test-app-def-bad]))

(defn main [] :i64 0)

(defn seq-ok? [s :i64] :i64
  ;; ComAtprotoSyncSubscribeReposCommit の seq（0 以上の整数）。
  (if (>= s 0) 1 0))

(defn text-ok? [t :string] :i64
  ;; 必須文字列（空でない）。
  (if (>= (string-byte-length t) 1) 1 0))

(defn- five-fields-ok? [f [:map :string :string] a :string b :string c :string d :string e :string] :i64
  ;; 5 つの必須文字列フィールド（:vec は safe profile 外のため明示展開 —— 実測）。
  (if (= 1 (text-ok? (get f a "")))
    (if (= 1 (text-ok? (get f b "")))
      (if (= 1 (text-ok? (get f c "")))
        (if (= 1 (text-ok? (get f d "")))
          (text-ok? (get f e ""))
          0)
        0)
      0)
    0))

(defn- two-fields-ok? [f [:map :string :string] a :string b :string] :i64
  (if (= 1 (text-ok? (get f a "")))
    (text-ok? (get f b ""))
    0))

(defn commit-shape-ok?
  "ComAtprotoSyncSubscribeReposCommit 形の判定。f は文字列フィールド
  （repo / collection / rkey / action / time / cid / rev）。cid / rev は
  任意（欠落 = nil 扱い、存在するなら文字列であることは map 型が保証）。
  seq は別引数（混在値マップを持てないため）。妥当なら 1、不正なら 0。"
  [f [:map :string :string] s :i64] :i64
  (if (= 1 (seq-ok? s))
    (five-fields-ok? f "repo" "collection" "rkey" "action" "time")
    0))

(defn agent-config-ok?
  "AgentConfig 形: systemPrompt / model の両方が必須（f は文字列マップ）。"
  [f [:map :string :string]] :i64
  (two-fields-ok? f "systemPrompt" "model"))

(defn app-def-shape-ok?
  "AppDef 形: id / name 必須。description は任意。agent は別判定
  （agent-config-ok?）。"
  [f [:map :string :string]] :i64
  (two-fields-ok? f "id" "name"))

;; ---- amu test（guest 覇約: 1 test = 1 呼び出し・戻り :i64 の 1/0）----

(defn test-seq-ok [] :i64 (if (= 1 (seq-ok? 42)) 1 0))
(defn test-seq-bad [] :i64 (if (= 0 (seq-ok? -1)) 1 0))
(defn test-text-ok [] :i64 (if (= 1 (text-ok? "a")) 1 0))
(defn test-text-bad [] :i64 (if (= 0 (text-ok? "")) 1 0))

(defn test-commit-ok [] :i64
  (if (= 1 (commit-shape-ok? {"repo" "did:plc:abc" "collection" "app.bsky.feed.post"
                              "rkey" "3kx2" "action" "create" "time" "2026-10-20"}
                            42))
    1 0))

(defn test-commit-missing-time [] :i64
  (if (= 0 (commit-shape-ok? {"repo" "x" "collection" "y" "rkey" "z" "action" "a"} 1))
    1 0))

(defn test-commit-bad-seq [] :i64
  (if (= 0 (commit-shape-ok? {"repo" "x" "collection" "y" "rkey" "z"
                              "action" "a" "time" "t"} -1))
    1 0))

(defn test-agent-config-ok [] :i64
  (if (= 1 (agent-config-ok? {"systemPrompt" "s" "model" "m"})) 1 0))

(defn test-agent-config-bad [] :i64
  (if (= 0 (agent-config-ok? {"model" "m"})) 1 0))

(defn test-app-def-ok [] :i64
  (if (= 1 (app-def-shape-ok? {"id" "itonami" "name" "Itonami"})) 1 0))

(defn test-app-def-bad [] :i64
  (if (= 0 (app-def-shape-ok? {"id" "a"})) 1 0))
