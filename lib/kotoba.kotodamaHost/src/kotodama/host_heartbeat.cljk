(ns kotodama.host-heartbeat
  "heartbeat 系の guest 核（JUN-149 スライス⑥: amu 適格化）。
  typed guest 覇約（型注釈必須・host interop 禁止・:export 必須）。
  CadenceState の i64 6 フィールドは canonical typed map（[:map :string :i64]）
  で表せる。recentPostTypes（ベクタ）と InboxBuffer（ベクタ・ネスト・nil）
  は guest ABI に無いため oracle（host_surface）側に残す。
  意味の正本は本モジュール（TS 正本: 06e57cf^ の heartbeat-cadence.ts）。"
  (:export [main create-cadence-state
            test-cadence-state-zeros test-cadence-state-fields]))

(defn main [] :i64 0)

(defn create-cadence-state
  "CadenceState の初期状態（TS の createCadenceState の i64 6 フィールド、
  全て 0）。recentPostTypes（ベクタ）は host 側。キーは文字列、値は i64。"
  [] [:map :string :i64]
  {"last-post-at" 0
   "last-analyze-at" 0
   "last-drill-at" 0
   "last-validate-at" 0
   "last-engage-at" 0
   "last-reward-at" 0})

;; ---- amu test（guest 覇約: 1 test = 1 呼び出し・戻り :i64 の 1/0）----

(defn test-cadence-state-zeros [] :i64
  (if (= 0 (get (create-cadence-state) "last-post-at" 1)) 1 0))

(defn test-cadence-state-fields [] :i64
  (if (= 0 (get (create-cadence-state) "last-reward-at" 1)) 1 0))
