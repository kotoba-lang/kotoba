(ns kotodama.host-surface
  "appview 差替え面の自由型ユーティリティ（JUN-149: kbb / ホスト側表面）。
  guest 核（host_util、typed）は kbb から読めないため、判定は
  **oracle/guest の双子**（bounded_text 流儀: host 側の oracle が意味を担保し、
  guest 側が同じベクタで amu test される）。amu 適格化の対象外。"
  #?(:default (:require [clojure.string :as cstr])))

(defn str'
  "文字列への中立な変換。文字列以外は空文字（appview 側の str ヘルパと同じ
  意味: 'typeof v === string ? v : empty'）。"
  [v]
  (if (string? v) v ""))

(defn- full-match? [pattern text]
  (boolean (re-matches (re-pattern pattern) text)))

(defn nsid
  "NSID 形の検証。妥当なら文字列をそのまま返し、不正なら nil。
  （appview の validate 用途。判定は guest 核 host_util/nsid-valid? の
  oracle と同じベクタで検証される。）"
  [v]
  (when (string? v)
    (let [parts (cstr/split v #"\.")]
      (when (and (>= (count parts) 2)
                 (<= (count v) 253)
                 (every? #(full-match? "[a-z][a-z0-9-]{0,62}" %) (butlast parts))
                 (full-match? "[a-zA-Z][a-zA-Z0-9]*" (last parts)))
        v))))

;; ---- 型 3 つの oracle（自由型のマップ形状述語。guest 核 host_types の双子。
;; HostSDK 形は関数値フィールドを持つため guest では表せず、oracle 専用）----

(defn- str+ [v] (and (string? v) (not (empty? v))))
(defn- str-or-nil? [v] (or (nil? v) (string? v)))

(defn com-atproto-sync-subscribe-repos-commit?
  "ComAtprotoSyncSubscribeReposCommit（TS の型と同一形状）:
  {:seq bigint/int :repo :collection :rkey :action :time 文字列、
   :cid :rev は文字列か nil}。seq は 0 以上の整数。"
  [m]
  (and (map? m)
       (contains? m :seq)
       (let [s (:seq m)]
         (and (integer? s) (not (neg? s))))
       (str+ (:repo m))
       (str+ (:collection m))
       (str+ (:rkey m))
       (str+ (:action m))
       (str+ (:time m))
       (str-or-nil? (:cid m))
       (str-or-nil? (:rev m))))

(defn agent-config?
  "AgentConfig: {:system-prompt str :model str}（両方必須）。"
  [m]
  (and (map? m) (str+ (:system-prompt m)) (str+ (:model m))))

(defn app-def?
  "AppDef（TS と同一形状）: {:id str :name str
  :description? str :agent? AgentConfig}。"
  [m]
  (and (map? m)
       (str+ (:id m))
       (str+ (:name m))
       (or (not (contains? m :description)) (str-or-nil? (:description m)))
       (or (not (contains? m :agent)) (nil? (:agent m)) (agent-config? (:agent m)))))

(defn host-sdk?
  "HostSDK ハンドル（TS のインターフェースと同一の必須キー）:
  {:app :env :host-imports :pds :router :handle-request :wit-exports}。
  wit-exports は {:http-handler :w-handler :serve-handler :shinka-handler}
  を持つ。:handle-request と各 handler は実関数（IFn ではない）。"
  [m]
  (and (map? m)
       (every? #(contains? m %)
               [:app :env :host-imports :pds :router :handle-request :wit-exports])
       (fn? (:handle-request m))
       (let [w (:wit-exports m)]
         (and (map? w)
              (every? #(contains? w %)
                      [:http-handler :w-handler :serve-handler :shinka-handler])
              (fn? (get-in w [:http-handler :handle]))
              (fn? (get-in w [:w-handler :handle-com-atproto-sync-subscribe-repos-commit]))
              (fn? (get-in w [:serve-handler :handle]))
              (fn? (get-in w [:shinka-handler :on-heartbeat]))))))

;; ---- cadence 判定カーネルの oracle（キーワード版。guest 核 host_cadence の
;; 双子 —— mood コード対応: 0=joyful 1=calm 2=stressed 3=grateful 4=focused
;; 5=neutral）。TS 正本は 06e57cf^ の heartbeat-cadence.ts。

(defn determine-mood
  "Joucho スコアから mood を決める（TS の determineMood と同じ）。
  stress >= 70 → :stressed。最上位軸スコア < 60 → :neutral。他は最上位軸。"
  [{:keys [joy calm stress gratitude focus]}]
  (if (>= stress 70)
    :stressed
    (let [axes [[:joyful joy] [:calm calm] [:grateful gratitude] [:focused focus]]
          [top-mood top-score] (apply max-key second axes)]
      (if (< top-score 60)
        :neutral
        top-mood))))

(defn mood->cadence
  "mood → クールダウン/有効フラグ表（TS の moodToCadence と同じ 11 フィールド）。
  :neutral は default 分岐と同じ。"
  [mood]
  (case mood
    :joyful {:post-cooldown-ms 1800000 :analyze-cooldown-ms 10800000
             :drill-cooldown-ms 14400000 :validate-cooldown-ms 7200000
             :engage-cooldown-ms 900000 :reward-cooldown-ms 600000
             :post-enabled true :analyze-enabled true :drill-enabled false
             :validate-enabled true :engage-enabled true}
    :calm {:post-cooldown-ms 7200000 :analyze-cooldown-ms 3600000
           :drill-cooldown-ms 7200000 :validate-cooldown-ms 2700000
           :engage-cooldown-ms 3600000 :reward-cooldown-ms 1800000
           :post-enabled true :analyze-enabled true :drill-enabled true
           :validate-enabled true :engage-enabled true}
    :stressed {:post-cooldown-ms 21600000 :analyze-cooldown-ms 14400000
               :drill-cooldown-ms 1800000 :validate-cooldown-ms 3600000
               :engage-cooldown-ms 10800000 :reward-cooldown-ms 3600000
               :post-enabled false :analyze-enabled true :drill-enabled true
               :validate-enabled true :engage-enabled false}
    :grateful {:post-cooldown-ms 3600000 :analyze-cooldown-ms 7200000
               :drill-cooldown-ms 10800000 :validate-cooldown-ms 7200000
               :engage-cooldown-ms 600000 :reward-cooldown-ms 300000
               :post-enabled true :analyze-enabled true :drill-enabled false
               :validate-enabled true :engage-enabled true}
    :focused {:post-cooldown-ms 10800000 :analyze-cooldown-ms 2700000
              :drill-cooldown-ms 3600000 :validate-cooldown-ms 1800000
              :engage-cooldown-ms 7200000 :reward-cooldown-ms 3600000
              :post-enabled true :analyze-enabled true :drill-enabled true
              :validate-enabled true :engage-enabled false}
    ;; :neutral / default
    {:post-cooldown-ms 7200000 :analyze-cooldown-ms 10800000
     :drill-cooldown-ms 7200000 :validate-cooldown-ms 5400000
     :engage-cooldown-ms 3600000 :reward-cooldown-ms 1800000
     :post-enabled true :analyze-enabled true :drill-enabled true
     :validate-enabled true :engage-enabled true}))

(defn apply-stress-scaling
  "stress >= 50 なら post/engage のクールダウンを拡大する（TS と同じ）。
  scale = 1.0 + (stress - 50) / 50、Math.round 相当。"
  [cadence stress]
  (if (< stress 50)
    cadence
    (let [scale (+ 1.0 (/ (- stress 50) 50.0))]
      (-> cadence
          (update :post-cooldown-ms #(js/Math.round (* % scale)))
          (update :engage-cooldown-ms #(js/Math.round (* % scale)))))))

;; ---- resolveModelId の oracle（レジストリ走査版。guest 核 host_model の双子
;; —— 優先順位と正規化の意味は host_model が正本）。TS 正本 06e57cf^。

(def default-fallback-model "gemma-4-e4b-it")

(defn resolve-model-id
  "hint / use-case からモデル ID を決める（TS の resolveModelId と同じ順序）。
  1. hint: 直接 ID（available）→ alias（小文字）→ cf-model 一致。
     レジストリに在るが unavailable なら use-case へフォールスルー。
  2. use-case 既定（available のもの）。
  3. gemma-4-e4b-it。
  registry: {id {:available bool :cf-model str}}
  aliases: {lower id}
  use-case-defaults: {useCase id}"
  [registry aliases use-case-defaults hint use-case]
  (let [available? (fn [id] (boolean (get-in registry [id :available])))]
    (or
     (when (and hint (not (empty? (cstr/trim hint))))
       (let [trimmed (cstr/trim hint)]
         (or
          (when (available? trimmed) trimmed)
          (when-let [aliased (get aliases (cstr/lower-case trimmed))]
            (when (available? aliased) aliased))
          (some (fn [[id def]]
                  (when (and (available? id)
                             (= (cstr/lower-case (:cf-model def))
                                (cstr/lower-case trimmed)))
                    id))
                registry))))
     (when use-case
       (when-let [uc (get use-case-defaults use-case)]
         (when (available? uc) uc)))
     default-fallback-model)))

;; ---- lexicon 検証の oracle（スキーマ走査 + JSON デコード版。guest 核
;; host_lexicon の双子 —— 型寛容性ルールと required 判定の意味は host_lexicon
;; が正本）。TS 正本 06e57cf^ の lexicon-validator.ts。

(defn type-of-value
  "値の型名（TS の typeOfValue と同じ 7 値）。"
  [v]
  (cond
    (or (nil? v) (= js/undefined v)) "unknown"
    (string? v) "string"
    (boolean? v) "boolean"
    (number? v) (if (and (js/Number.isInteger v) (not (js/Number.isNaN v)))
                  "integer" "number")
    (or (array? v) (sequential? v)) "array"
    (= (type v) js/Object) "object"
    (map? v) "object"
    :else "unknown"))

(defn- matches-expected [actual expected]
  (cond
    (= expected "unknown") true
    (and (= expected "number") (= actual "integer")) true
    (and (= expected "integer") (= actual "integer")) true
    :else (= actual expected)))

(defn validate-against-schema
  "スキーマ（{:required [...] :properties {key type}}）でオブジェクトを
  検証し、issue 文字列のベクタを返す（空 = 妥当）。TS の validateAgainstSchema
  とメッセージ形式を一致させる。"
  [value schema]
  (if (or (nil? value)
          (= js/undefined value)
          (not (map? value))
          (array? value))
    [(str "input is not an object (got " (type-of-value value) ")")]
    (let [required (or (:required schema) [])
          properties (or (:properties schema) {})]
      (into
       (vec (for [key required
                  :when (or (not (contains? value key))
                            (nil? (get value key))
                            (= js/undefined (get value key)))]
              (str "missing required property '" key "'")))
       (for [[key expected] properties
             :let [present? (contains? value key)]
             :when present?
             :let [actual (type-of-value (get value key))]
             :when (not (and (= actual "unknown")
                             (= js/undefined (get value key))))
             :when (not (matches-expected actual expected))]
         (str "property '" key "': expected " expected ", got " actual))))))

(defn parse-lexicon-input
  "body（JSON 文字列またはバイト列）をスキーマで検証してデータを返す。
  スキーマ無しなら検証せず decode のみ（TS の parseLexiconInput と同じ）。
  不正なら :kotodama.host.lexicon/validation-error を含む例外（issues 付き）。"
  [registry nsid body]
  (let [schema (get registry nsid)
        decoded (cond
                  (string? body) (js->clj (js/JSON.parse body))
                  (array? body) (js->clj (js/JSON.parse (.decode (js/TextDecoder.) body)))
                  (map? body) body
                  :else nil)
        decoded (if (nil? decoded) {} decoded)]
    (if (nil? schema)
      decoded
      (let [issues (validate-against-schema decoded schema)]
        (if (seq issues)
          (throw (ex-info "lexicon validation failed"
                          {:kotodama.host.lexicon/validation-error true
                           :nsid nsid :issues issues}))
          decoded)))))

(defn try-parse-lexicon-input
  "parse-lexicon-input の例外なし版。{:ok true :input ...} か
  {:ok false :issues [...]} を返す（TS の tryParseLexiconInput と同じ）。"
  [registry nsid body]
  (try
    {:ok true :input (parse-lexicon-input registry nsid body)}
    (catch :default e
      (let [data (ex-data e)]
        (if (:kotodama.host.lexicon/validation-error data)
          {:ok false :issues (:issues data)}
          (throw e))))))

;; ---- heartbeat 系の oracle（InboxBuffer とキーワード版 CadenceState。
;; guest 核 host_heartbeat の双子 —— i64 6 フィールドの意味は host_heartbeat
;; が正本。recentPostTypes ベクタと InboxBuffer 構造は host 側）。TS 正本
;; 06e57cf^ の heartbeat-cadence.ts。

(defn create-inbox-buffer
  "InboxBuffer の初期状態（TS の createInboxBuffer と同じ構造）。"
  []
  {:inbound-commits []
   :reactions []
   :prev-joucho nil
   :follower-snapshots {}})

(defn create-cadence-state
  "CadenceState の初期状態（TS の createCadenceState と同じ 7 フィールド、
  キーワードキー版）。"
  []
  {:last-post-at 0
   :last-analyze-at 0
   :last-drill-at 0
   :last-validate-at 0
   :last-engage-at 0
   :last-reward-at 0
   :recent-post-types []})
