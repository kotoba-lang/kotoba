(ns kotodama.host-effects
  "appview 差替え面の効果ユーティリティ（JUN-149: host capability 側）。
  時刻・乱数・JSON は guest が持てない効果のため、amu 適格化の対象外モジュール
  （guest は純粋のみ）。kbb / JS ホストで動かす。意味の正本は本モジュール。")

(defn now-iso
  "現在時刻の ISO 8601（UTC、ミリ秒 3 桁、Z 付き）。例:
  \"2026-10-20T09:15:00.000Z\"。"
  []
  (.toISOString (js/Date.)))

(defn gen-id
  "ユニーク ID（UUID 文字列）。実行環境の乱数に依存するため決定的ではない。"
  []
  (str (random-uuid)))

(defn decode-json
  "JSON 文字列をデータへ（キーは文字列のまま、不正なら nil）。"
  [s]
  (when (string? s)
    (try
      (js->clj (js/JSON.parse s))
      (catch :default _ nil))))
