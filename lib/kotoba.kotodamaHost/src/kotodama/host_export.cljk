(ns kotodama.host-export
  "appview 差替え面の Worker/export 系（JUN-133: createWorkerExport /
  asAgentTool / withCapabilityTags の kotoba 側）。TS SDK は prune 済みのため
  意味はここで定義する。appview の使用形（builder.command(nsid, handler,
  asAgentTool(desc), withCapabilityTags(...tags))）に対応する純粋な登録 API。"
  (:require [kotodama.host-surface :as surface]))

(defn as-agent-tool
  "ツール宣言（説明文字列 1 つ）。不正なら nil（fail closed）。"
  [description]
  (when (and (string? description) (not (empty? description)))
    {:kotodama.host.export/type :agent-tool
     :description description}))

(defn with-capability-tags
  "capability タグ（1 つ以上の文字列）。不正なら nil（fail closed）。"
  [& tags]
  (when (and (seq tags) (every? #(and (string? %) (not (empty? %))) tags))
    {:kotodama.host.export/type :capability-tags
     :tags (vec tags)}))

(defn empty-registry
  "コマンド登録簿の初期状態。"
  []
  {:kotodama.host.export/type :registry
   :commands []})

(defn command
  "登録簿にコマンドを 1 件追加して返す（純粋）。
  name は NSID 形（host-util/nsid で検証）、handler は関数、
  tool-spec は as-agent-tool、tag-spec は with-capability-tags の返り値。
  いずれかが不正なら例外（fail closed — 黙って通さない）。"
  [registry name handler tool-spec tag-spec]
  (when-not (= :registry (:kotodama.host.export/type registry))
    (throw (ex-info "command: registry ではない" {:registry registry})))
  (when-not (surface/nsid name)
    (throw (ex-info "command: name は NSID 形である必要がある" {:name name})))
  ;; handler は関数（キーワード等の IFn は不可 — ifn? で通さない）
  (when-not (fn? handler)
    (throw (ex-info "command: handler は関数である必要がある" {:name name})))
  (when-not (= :agent-tool (:kotodama.host.export/type tool-spec))
    (throw (ex-info "command: tool-spec は as-agent-tool の返り値である必要がある"
                    {:name name :tool-spec tool-spec})))
  (when-not (= :capability-tags (:kotodama.host.export/type tag-spec))
    (throw (ex-info "command: tag-spec は with-capability-tags の返り値である必要がある"
                    {:name name :tag-spec tag-spec})))
  (when (some #(= name (:name %)) (:commands registry))
    (throw (ex-info "command: 重複した name" {:name name})))
  (update registry :commands conj
          {:name name
           :handler handler
           :description (:description tool-spec)
           :tags (:tags tag-spec)}))

(defn create-worker-export
  "setup 関数（登録簿を受け取り、command を重ねて返す）から最終の登録簿を作る。
  TS 側の createWorkerExport((sdk) => builder.command(...)) に対応する純粋版。"
  [setup]
  (when-not (fn? setup)
    (throw (ex-info "create-worker-export: setup は関数である必要がある" {})))
  (let [registry (setup (empty-registry))]
    (when-not (= :registry (:kotodama.host.export/type registry))
      (throw (ex-info "create-worker-export: setup が登録簿を返していない"
                      {:registry registry})))
    registry))
