(ns kotodama.host-cadence
  "cadence 判定カーネル guest 核（JUN-149 スライス③: amu 適格化）。
  typed guest 覇約（型注釈必須・host interop 禁止・:export 必須）。js/Math は
  使わず整数演算で round を構成（guest ABI = i64/direct）。mood はスカラー
  コード（0=joyful 1=calm 2=stressed 3=grateful 4=focused 5=neutral）、
  cadence は canonical typed map（[:map :string :i64]、enabled は 0/1）。
  意味の正本は本モジュール（TS 正本: 06e57cf^ の heartbeat-cadence.ts）。
  oracle（キーワード版）は host_surface.cljk。resolveHeartbeatCadence 本体は
  DB 結合のため対象外（ADR-2605111200）。"
  (:export [main determine-mood-code mood-cadence apply-stress-scaling
            test-mood-stressed test-mood-joyful test-mood-neutral
            test-mood-focused test-cadence-joyful-post test-cadence-stressed-post
            test-cadence-neutral-drill test-scale-mid test-scale-unchanged
            test-scale-joyful-51]))

(defn main [] :i64 0)

(defn determine-mood-code
  "Joucho スコアから mood コードを決める（TS determineMood と同じ分岐）。
  stress >= 70 → 2（stressed）。最上位軸スコア < 60 → 5（neutral）。
  他は最上位軸（同点は先勝ち = TS の stable sort と同じ）。"
  [joy :i64 calm :i64 stress :i64 gratitude :i64 focus :i64] :i64
  (if (>= stress 70)
    2
    (if (>= joy (max calm (max gratitude focus)))
      (if (< joy 60) 5 0)
      (if (>= calm (max gratitude focus))
        (if (< calm 60) 5 1)
        (if (>= gratitude focus)
          (if (< gratitude 60) 5 3)
          (if (< focus 60) 5 4))))))

(defn mood-cadence
  "mood コード → 11 フィールド表（TS moodToCadence の数値 verbatim）。
  enabled は 1/0。未知コードは 5（neutral = default）と同じ。"
  [mood :i64] [:map :string :i64]
  (if (= mood 0)
    {"post-cooldown-ms" 1800000 "analyze-cooldown-ms" 10800000
     "drill-cooldown-ms" 14400000 "validate-cooldown-ms" 7200000
     "engage-cooldown-ms" 900000 "reward-cooldown-ms" 600000
     "post-enabled" 1 "analyze-enabled" 1 "drill-enabled" 0
     "validate-enabled" 1 "engage-enabled" 1}
    (if (= mood 1)
      {"post-cooldown-ms" 7200000 "analyze-cooldown-ms" 3600000
       "drill-cooldown-ms" 7200000 "validate-cooldown-ms" 2700000
       "engage-cooldown-ms" 3600000 "reward-cooldown-ms" 1800000
       "post-enabled" 1 "analyze-enabled" 1 "drill-enabled" 1
       "validate-enabled" 1 "engage-enabled" 1}
      (if (= mood 2)
        {"post-cooldown-ms" 21600000 "analyze-cooldown-ms" 14400000
         "drill-cooldown-ms" 1800000 "validate-cooldown-ms" 3600000
         "engage-cooldown-ms" 10800000 "reward-cooldown-ms" 3600000
         "post-enabled" 0 "analyze-enabled" 1 "drill-enabled" 1
         "validate-enabled" 1 "engage-enabled" 0}
        (if (= mood 3)
          {"post-cooldown-ms" 3600000 "analyze-cooldown-ms" 7200000
           "drill-cooldown-ms" 10800000 "validate-cooldown-ms" 7200000
           "engage-cooldown-ms" 600000 "reward-cooldown-ms" 300000
           "post-enabled" 1 "analyze-enabled" 1 "drill-enabled" 0
           "validate-enabled" 1 "engage-enabled" 1}
          (if (= mood 4)
            {"post-cooldown-ms" 10800000 "analyze-cooldown-ms" 2700000
             "drill-cooldown-ms" 3600000 "validate-cooldown-ms" 1800000
             "engage-cooldown-ms" 7200000 "reward-cooldown-ms" 3600000
             "post-enabled" 1 "analyze-enabled" 1 "drill-enabled" 1
             "validate-enabled" 1 "engage-enabled" 0}
            {"post-cooldown-ms" 7200000 "analyze-cooldown-ms" 10800000
             "drill-cooldown-ms" 7200000 "validate-cooldown-ms" 5400000
             "engage-cooldown-ms" 3600000 "reward-cooldown-ms" 1800000
             "post-enabled" 1 "analyze-enabled" 1 "drill-enabled" 1
             "validate-enabled" 1 "engage-enabled" 1}))))))

(defn- round-half-up [a :i64 b :i64] :i64
  ;; a/b を正の数として四捨五入（Math.round と同じ floor(x+0.5)）。
  (quot (+ a (quot b 2)) b))

(defn apply-stress-scaling
  "stress >= 50 なら post/engage のクールダウンを拡大（TS と同じ）。
  scale = stress/50（= 1 + (stress-50)/50）。round は整数演算で構成。"
  [c [:map :string :i64] stress :i64] [:map :string :i64]
  (if (< stress 50)
    c
    (let [post (get c "post-cooldown-ms" 0)
          engage (get c "engage-cooldown-ms" 0)]
      (assoc (assoc c "post-cooldown-ms"
                    (round-half-up (* 2 (* post stress)) 100))
             "engage-cooldown-ms"
             (round-half-up (* 2 (* engage stress)) 100)))))

;; ---- amu test（guest 覇約: 1 test = 1 呼び出し・戻り :i64 の 1/0）----

(defn test-mood-stressed [] :i64 (if (= 2 (determine-mood-code 80 60 70 50 70)) 1 0))
(defn test-mood-joyful [] :i64 (if (= 0 (determine-mood-code 80 60 30 50 70)) 1 0))
(defn test-mood-neutral [] :i64 (if (= 5 (determine-mood-code 30 40 10 20 59)) 1 0))
(defn test-mood-focused [] :i64 (if (= 4 (determine-mood-code 50 60 10 55 61)) 1 0))

(defn test-cadence-joyful-post [] :i64
  (if (= 1800000 (get (mood-cadence 0) "post-cooldown-ms" 0)) 1 0))

(defn test-cadence-stressed-post [] :i64
  (if (= 0 (get (mood-cadence 2) "post-enabled" 1)) 1 0))

(defn test-cadence-neutral-drill [] :i64
  (if (= 1 (get (mood-cadence 5) "drill-enabled" 0)) 1 0))

(defn test-scale-mid [] :i64
  ;; calm post 7200000 × stress 75 = 10800000（scale 1.5）
  (if (= 10800000 (get (apply-stress-scaling (mood-cadence 1) 75) "post-cooldown-ms" 0))
    1 0))

(defn test-scale-unchanged [] :i64
  (if (= 7200000 (get (apply-stress-scaling (mood-cadence 1) 49) "post-cooldown-ms" 0))
    1 0))

(defn test-scale-joyful-51 [] :i64
  ;; joyful post 1800000 × stress 51 = 1836000（scale 1.02、round）
  (if (= 1836000 (get (apply-stress-scaling (mood-cadence 0) 51) "post-cooldown-ms" 0))
    1 0))
