(ns kotodama.host-model
  "resolveModelId の判定核 guest 核（JUN-149 スライス④: amu 適格化）。
  typed guest 覇約（型注釈必須・host interop 禁止・:export 必須）。
  レジストリ走査（マップ反復）は guest ABI に無いため oracle（host_surface）
  側に残し、guest は **優先順位つき候補選択**（TS resolveModelId と同じ
  順序: hint 直接 → alias → cf-model → use-case → fallback）と
  正規化（trim + fold-case）を担う。意味の正本は本モジュール
  （TS 正本: 06e57cf^ の llm-model-registry.ts）。"
  (:require #?(:kotoba [kotoba.lang.bounded-text :as bt]))
  (:export [main normalize-hint choose-model-id
            test-normalize-hint test-choose-direct test-choose-alias
            test-choose-cf test-choose-uc test-choose-fallback]))

(defn main [] :i64 0)

(defn normalize-hint
  "hint の正規化（trim + 小文字化）。alias / cf-model の照合キー。
  TS の hint.trim() / toLowerCase() と同じ（fold-case で代替）。"
  [s :string] :string
  (bt/fold-case (bt/trim-text s)))

(defn choose-model-id
  "候補（ホストがレジストリから解決済み）を TS resolveModelId と同じ
  優先順位で選ぶ。各候補は id 文字列 + 利用可フラグ（1/0）。
  全て無ければ最終フォールバック \"gemma-4-e4b-it\"（TS の定数と同じ）。"
  [hint-id :string hint-ok :i64
   alias-id :string alias-ok :i64
   cf-id :string cf-ok :i64
   uc-id :string uc-ok :i64] :string
  (if (= 1 hint-ok)
    hint-id
    (if (= 1 alias-ok)
      alias-id
      (if (= 1 cf-ok)
        cf-id
        (if (= 1 uc-ok)
          uc-id
          "gemma-4-e4b-it")))))

;; ---- amu test（guest 覇約: 1 test = 1 呼び出し・戻り :i64 の 1/0）----

(defn test-normalize-hint [] :i64
  (if (= "maxwell" (normalize-hint "  Maxwell ")) 1 0))

(defn test-choose-direct [] :i64
  (if (= "a" (choose-model-id "a" 1 "b" 1 "c" 1 "d" 1)) 1 0))

(defn test-choose-alias [] :i64
  (if (= "b" (choose-model-id "a" 0 "b" 1 "c" 1 "d" 1)) 1 0))

(defn test-choose-cf [] :i64
  (if (= "c" (choose-model-id "a" 0 "b" 0 "c" 1 "d" 1)) 1 0))

(defn test-choose-uc [] :i64
  (if (= "d" (choose-model-id "a" 0 "b" 0 "c" 0 "d" 1)) 1 0))

(defn test-choose-fallback [] :i64
  (if (= "gemma-4-e4b-it" (choose-model-id "a" 0 "b" 0 "c" 0 "d" 0)) 1 0))
