(ns kotodama.host-lexicon
  "lexicon 検証の判定核 guest 核（JUN-149 スライス⑤: amu 適格化）。
  typed guest 覇約（型注釈必須・host interop 禁止・:export 必須）。
  スキーマ走査（マップ反復）と JSON デコードは guest ABI に無いため
  oracle（host_surface）側に残し、guest は **フィールド単位の判定核**を担う:
  型寛容性ルール（TS matchesExpected と同じ）と required 存在判定。
  意味の正本は本モジュール（TS 正本: 06e57cf^ の lexicon-validator.ts）。"
  (:export [main field-type-ok? required-present?
            test-type-unknown test-type-number-accepts-integer
            test-type-integer-strict test-type-equal test-type-mismatch
            test-type-number-from-string test-required-present
            test-required-missing]))

(defn main [] :i64 0)

(defn field-type-ok?
  "型寛容性ルール（TS の matchesExpected と同じ）:
  expected \"unknown\" は何でも可。expected \"number\" は \"integer\" を受ける。
  expected \"integer\" は \"integer\" のみ。他は等価。戻り 1/0。"
  [actual :string expected :string] :i64
  (if (= expected "unknown")
    1
    (if (= expected "number")
      (if (or (= actual "integer") (= actual "number")) 1 0)
      (if (= expected "integer")
        (if (= actual "integer") 1 0)
        (if (= actual expected) 1 0)))))

(defn required-present?
  "required プロパティの存在判定（TS の必須チェックと同じ: キーの存在が
  唯一の条件。値の空文字は許容）。戻り 1/0。"
  [f [:map :string :string] k :string] :i64
  (if (contains? f k) 1 0))

;; ---- amu test（guest 覇約: 1 test = 1 呼び出し・戻り :i64 の 1/0）----

(defn test-type-unknown [] :i64 (if (= 1 (field-type-ok? "string" "unknown")) 1 0))
(defn test-type-number-accepts-integer [] :i64 (if (= 1 (field-type-ok? "integer" "number")) 1 0))
(defn test-type-integer-strict [] :i64 (if (= 0 (field-type-ok? "number" "integer")) 1 0))
(defn test-type-equal [] :i64 (if (= 1 (field-type-ok? "boolean" "boolean")) 1 0))
(defn test-type-mismatch [] :i64 (if (= 0 (field-type-ok? "string" "integer")) 1 0))
(defn test-type-number-from-string [] :i64 (if (= 0 (field-type-ok? "string" "number")) 1 0))
(defn test-required-present [] :i64 (if (= 1 (required-present? {"id" "a"} "id")) 1 0))
(defn test-required-missing [] :i64 (if (= 0 (required-present? {"x" "a"} "id")) 1 0))
