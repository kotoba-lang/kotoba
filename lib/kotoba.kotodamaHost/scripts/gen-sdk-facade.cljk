#!/usr/bin/env kbb
;; scripts/gen-sdk-facade.cljk — sdk_facade.edn → src/kotodama/host_facade.cljc
;; 使い方: kbb --backend sci --classpath src scripts/gen-sdk-facade.cljk
(require '[clojure.edn :as edn]
         '[kotodama.host-facade-gen :as gen])

(let [facade (edn/read-string (slurp "resources/kotodama_host/sdk_facade.edn"))
      src (gen/generate-facade facade)]
  (spit gen/generated-path src)
  (println "wrote" gen/generated-path (str "(" (count src) " chars)")))
