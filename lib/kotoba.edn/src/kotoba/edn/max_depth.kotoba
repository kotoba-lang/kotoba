;; Kotoba port of lib/kotoba.edn/src/kotoba/edn/max_depth.cljk (JUN-829).
;;
;; Named divergence: the Clojure constant `(def max-depth 128)` is exposed as
;; the zero-argument fn `max-depth`, returning 128. amu admits only exported
;; fns across modules (a qualified constant reference is E6004), and a library
;; module needs at least one export (E6009). Callers write `(max-depth)` where
;; the original reads `max-depth`.
(ns kotoba.edn.max-depth
  (:export [max-depth]))

(defn max-depth [] :i64 128)
