;; Port of kotoba.edn.closing (closing.cljk), Kotoba-native, :document maps.
;;
;; Named divergences from closing.cljk:
;;   - Kotoba has no character type. The argument is a one-character string,
;;     and the test is string=? against ")" "]" "}". A longer string is never
;;     a closing delimiter, as a Clojure character never equals a multi-char
;;     value.

(ns kotoba.edn.closing
  (:export [closing?]))

(defn closing? [ch :string] :bool
  (or (string=? ch ")") (string=? ch "]") (string=? ch "}")))
