;; Kotoba port of src/kotoba/edn/max_edn_bytes.cljk (product semantics only).
;;
;; Named divergence: the .cljk is `(def max-edn-bytes (* 8 1024 1024))`. A def
;; cannot be exported (E2005) and cross-module constants fail (E6004), so the
;; constant is a zero-arg function with the same name and the same value.
(ns kotoba.edn.max-edn-bytes
  (:export [max-edn-bytes]))

(defn max-edn-bytes [] :i64 (* 8 1024 1024))
