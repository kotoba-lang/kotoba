;; Port of kotoba.edn.max-nodes (max_nodes.cljk), Kotoba-native.
;;
;; Named divergences from max_nodes.cljk:
;;   - a def cannot be exported and cross-module constants fail (E2005/E6004),
;;     so max-nodes is a zero-arg fn returning the same 200000.

(ns kotoba.edn.max-nodes
  (:export [max-nodes]))

(defn max-nodes [] :i64
  200000)
