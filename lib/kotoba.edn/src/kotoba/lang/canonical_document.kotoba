(ns kotoba.lang.canonical-document
  (:export [encode-canonical decode-canonical
            write-string read-string textual-roundtrip? reject-tag reject-general-duplicate
            symbol-roundtrip? list-roundtrip? set-roundtrip? general-map-roundtrip?
            roundtrip? main]))

;; Kotoba-native structured-data storage codec. This is the compiler-owned,
;; deterministic document encoding. Textual EDN is a separate, closed compiler
;; operation so storage identity never gets confused with presentation syntax.

(defn encode-canonical [value :document] :string
  (document-print value))

(defn decode-canonical [text :string] :document
  (document-read text))

(defn write-string [value :document] :string
  (document-edn-print value))

(defn read-string [text :string] :document
  (document-edn-read text))

(defn roundtrip? [value :document] :bool
  (document-equal? value (decode-canonical (encode-canonical value))))

(defn textual-roundtrip? [value :document] :bool
  (document-equal? value (read-string (write-string value))))

(defn reject-tag [] :document
  (read-string "#inst \"2026-08-03\""))

(defn reject-general-duplicate [] :document
  (read-string "{[1] :a [1] :b}"))

(defn symbol-roundtrip? [] :bool
  (let [value (document-symbol (symbol "actor/run"))]
    (if (document-equal? value (read-string (write-string value)))
      (if (string=? "actor/run" (write-string value))
        (document-equal? value value)
        (bool-not (document-equal? value value)))
      (bool-not (document-equal? value value)))))

(defn list-roundtrip? [] :bool
  (let [value (document-list
               (document-symbol (symbol "actor/run"))
               (document-i64 7))]
    (document-equal? value (read-string (write-string value)))))

(defn set-roundtrip? [] :bool
  (let [value (document-set
               (document-string "one")
               (document-keyword :ready)
               (document-i64 1))]
    (if (document-equal? value (read-string (write-string value)))
      (if (document-set-contains? value (document-keyword :ready))
        (if (string=? "#{1 :ready \"one\"}" (write-string value))
          (document-equal? value value)
          (bool-not (document-equal? value value)))
        (bool-not (document-equal? value value)))
      (bool-not (document-equal? value value)))))

(defn general-map-roundtrip? [] :bool
  (let [value (read-string "{[1 2] :pair, \"name\" 7, :ready true}")]
    (if (textual-roundtrip? value)
      (if (roundtrip? value)
        (if (string=? "{:ready true \"name\" 7 [1 2] :pair}" (write-string value))
          (document-equal? value value)
          (bool-not (document-equal? value value)))
        (bool-not (document-equal? value value)))
      (bool-not (document-equal? value value)))))

(defn main [] :i64
  (let [value (document-map
               :goal (document-string "migrate")
               :attempt (document-i64 3)
               :ready (document-bool true))]
    (if (roundtrip? value)
      (if (textual-roundtrip? value)
        (if (symbol-roundtrip?)
          (if (list-roundtrip?)
            (if (set-roundtrip?)
              (if (general-map-roundtrip?)
                (if (string=? (write-string value)
                              "{:attempt 3 :goal \"migrate\" :ready true}")
                  42
                  1)
                1)
              1)
            1)
          1)
        1)
      1)))
