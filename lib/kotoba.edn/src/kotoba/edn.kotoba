;; Native facade; host aliases retain their existing .cljk implementation.
(ns kotoba.edn
  (:export [read-document read-all write-string escape-controls])
  (:require [kotoba.lang.edn :as impl]))

(defn read-document [text :string] [:result :document :document]
  (impl/read-document text))

(defn read-all [text :string] [:result :document :document]
  (impl/read-all text))

(defn write-string [value :document] [:result :string :document]
  (impl/write-string value))

(defn escape-controls [text :string] :string
  (impl/escape-controls text))
