(ns kotoba.lang.edn-reader-host-test
  (:require [kotoba.lang.edn :as edn]
            [kotoba.test :refer [deftest is]]))

(deftest parser-and-lexer-agree-on-real-values
  (doseq [[source expected]
          [["{:version 3 :consumer/id :kotoba}" {:version 3 :consumer/id :kotoba}]
           ["; comment\n{:nested [1 -2 3.5] :set #{:a :b}}"
            {:nested [1 -2 3.5] :set #{:a :b}}]
           ["#:policy{:allow true}" {:policy/allow true}]
           ["[\"line\\n\" \"\\u3042\"]" ["line\n" "あ"]]
           ["[+42 -42 nil false]" [42 -42 nil false]]
           ["(actor :run)" '(actor :run)]]]
    (is (= expected (edn/read-string source)))))

(deftest read-all-preserves-form-boundaries
  (is (= [{:a 1} [2] :three] (edn/read-all "; first\n{:a 1} [2] :three"))))

(deftest malformed-reader-input-still-refuses
  (doseq [source ["[1}" "{} {}" "#inst \"2026-10-10\"" "\"\\q\""]]
    (is (= :decode
           (try (edn/read-string source) :unexpected-success
                (catch #?(:clj Exception :cljs :default) e (:phase (ex-data e))))))))
