(ns kotoba.edn.closing-test
  (:export [main])
  (:require [kotoba.edn.closing :as c]))

(defn- expect [got :bool want :bool] :i64
  (if (= got want) 0 1))

(defn main [] :i64
  (+ (expect (c/closing? ")") true)
     (expect (c/closing? "]") true)
     (expect (c/closing? "}") true)
     (expect (c/closing? "(") false)
     (expect (c/closing? "[") false)
     (expect (c/closing? "{") false)
     (expect (c/closing? "a") false)
     (expect (c/closing? "") false)
     (expect (c/closing? "))") false)))
