{:paths ["src"]
 ;; ipns.core (name derivation) stays zero-dep and portable -- these two
 ;; are pulled in ONLY by ipns.head (:clj-only signed head records), same
 ;; git-sha-pin convention kotoba-lang/cacao's deps.edn documents
 ;; (ADR-2607022400). SHAs are each sibling repo's origin/main HEAD as of
 ;; 2026-07-06.
 ;; Renamed upstream, the same way dag-cbor was below: kotoba-lang/ed25519 is
 ;; kotoba-lang/org-ietf-ed25519. The old URL still resolves through GitHub's
 ;; redirect, which is why this went unnoticed too; the coordinate now names
 ;; the repository that exists. Unlike the cbor entry the sha does not move --
 ;; nothing was broken here, only misnamed. It matters because tools.deps
 ;; dedupes by the coordinate SYMBOL: a closure that reaches this repository
 ;; under both names loads ed25519.core twice, from two checkouts at two shas.
 :deps {
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}
        io.github.kotoba-lang/org-ietf-ed25519 {:local/root "../org.ietf.ed25519"}
        io.github.kotoba-lang/org-ietf-cbor {:local/root "../org.ietf.cbor"}
        io.github.kotoba-lang/dev-protobuf {:local/root "../kotoba.devProtobuf"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts    ["-m" "clj-kondo.main" "--lint" "src" "test" "--fail-level" "error"]}}}
