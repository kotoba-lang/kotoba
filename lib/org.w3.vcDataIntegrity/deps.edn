{:paths ["src"]
 :deps {
        io.github.kotoba-lang/error {:local/root "../kotoba.error"}
        io.github.kotoba-lang/io {:local/root "../kotoba.io"}
        io.github.kotoba-lang/bytes {:local/root "../kotoba.bytes"}
        io.github.kotoba-lang/json {:local/root "../kotoba.json"}
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}
        io.github.kotoba-lang/org-ietf-jcs {:local/root "../org.ietf.jcs"}
        io.github.kotoba-lang/org-ietf-ed25519 {:local/root "../org.ietf.ed25519"}
        io.github.kotoba-lang/org-w3-did {:local/root "../org.w3.did"}
        io.github.kotoba-lang/org-w3-json-ld-api {:local/root "../org.w3.jsonLdApi"}
        io.github.kotoba-lang/org-w3-rdf-canon {:local/root "../org.w3.rdfCanon"}
        io.github.kotoba-lang/io-multiformats {:local/root "../kotoba.ioMultiformats"}}
 :aliases
 {:test {:extra-paths ["test" "test/fixtures"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}
                      org.clojure/data.json {:mvn/version "2.5.1"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  ;; clj-kondo as a Clojars lib (no Homebrew/system install needed).
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}
  ;; West/sibling workspace development only. Release and CI never use this.
  :dev {:override-deps
        {io.github.kotoba-lang/org-ietf-jcs {:local/root "../org-ietf-jcs"}
         io.github.kotoba-lang/org-ietf-ed25519 {:local/root "../org-ietf-ed25519"}
         io.github.kotoba-lang/org-w3-did {:local/root "../org-w3-did"}
         io.github.kotoba-lang/org-w3-json-ld-api
        {:git/url "https://github.com/kotoba-lang/org-w3-json-ld-api.git"
         :git/sha "499a2223f62ef497991c341b57c4848b41730b2c"}
        io.github.kotoba-lang/org-w3-rdf-canon
        {:git/url "https://github.com/kotoba-lang/org-w3-rdf-canon.git"
         :git/sha "6a70b1dfcd074a2cba4a1120b0c385badcd8cbb0"}
        io.github.kotoba-lang/io-multiformats {:local/root "../io-multiformats"}}}}}
