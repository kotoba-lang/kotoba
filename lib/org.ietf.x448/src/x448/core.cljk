(ns x448.core
  "X448 — [RFC 7748](https://www.rfc-editor.org/rfc/rfc7748) — in portable
  `.cljc`.

  The same shape as `kotoba-lang/org-ietf-x25519`, deliberately: `x448`,
  `public-key`, `contributory?`, and a 56-byte key instead of 32. A caller
  holding a Diffie-Hellman as a value can hold either.

  ## Clamping is not optional and not cosmetic

  RFC 7748 §5 clears the two low bits and sets the high bit of the scalar.
  Clearing the low bits puts the scalar in the prime-order subgroup, so a
  small-order public key cannot leak the low bits of the private one; setting
  the high bit fixes the ladder's length. `x448` clamps what it is given, so a
  caller cannot skip it by accident.

  ## The all-zero output

  A shared secret of all zeroes means the public key had small order and the
  result carries nothing of the private key. RFC 7748 §6.1 leaves the check to
  the caller and RFC 9180 §7.1.4 requires it, so it is here as
  `contributory?` — separate, like `org-ietf-x25519` has it, rather than
  folded into `x448` where a caller who wanted the raw value could not get
  it."
  (:require [x448.fp :as fp]))

(def key-bytes fp/key-bytes)

(def ^:private a24
  "(156326 - 2) / 4 = 39081. RFC 7748 §5."
  (fp/of-int 39081))

(defn clamp
  "RFC 7748 §5, the X448 form: clear the two low bits, set the top bit.

  Note what is *not* here. X25519 also masks the high bit of the last byte,
  because its field is 255 bits inside 32 bytes and the 256th bit must go.
  X448's field is 448 bits inside 56 bytes exactly, so there is no spare bit
  to mask and masking one would clear a bit that means something."
  [k]
  (let [k (mapv #(bit-and (int %) 0xFF) (seq k))]
    (-> k
        (assoc 0 (bit-and (nth k 0) 0xFC))
        (assoc 55 (bit-or (nth k 55) 0x80)))))

(defn- cswap [swap? [a b]] (if swap? [b a] [a b]))

(defn x448
  "The scalar multiplication. Returns `{:status :ok :bytes …}`.

  `k` is clamped here. `u` is taken as given: RFC 7748 says a u-coordinate is
  reduced modulo p on decode, so a non-canonical encoding is a valid input
  rather than an error — which is why the Wycheproof corpus marks those
  `acceptable` and this returns a value for them."
  [k u]
  (let [k (vec (seq k)) u (vec (seq u))]
    (cond
      (not= key-bytes (count k)) {:status :error :reason :bad-key-length :length (count k)}
      (not= key-bytes (count u)) {:status :error :reason :bad-key-length :length (count u)}
      :else
      (let [kk (fp/of-bytes-le (clamp k))
            x1 (fp/of-bytes-le u)]
        (loop [t (dec fp/bits)
               x2 fp/one z2 fp/zero x3 x1 z3 fp/one
               swap false]
          (if (neg? t)
            (let [[x2 _] (cswap swap [x2 x3])
                  [z2 _] (cswap swap [z2 z3])]
              {:status :ok :bytes (fp/to-bytes-le (fp/f* x2 (fp/finv z2)))})
            (let [kt (fp/test-bit kk t)
                  sw (not= swap kt)
                  [x2 x3] (cswap sw [x2 x3])
                  [z2 z3] (cswap sw [z2 z3])
                  a (fp/f+ x2 z2)   aa (fp/fsq a)
                  b (fp/f- x2 z2)   bb (fp/fsq b)
                  e (fp/f- aa bb)
                  c (fp/f+ x3 z3)
                  d (fp/f- x3 z3)
                  da (fp/f* d a)
                  cb (fp/f* c b)]
              (recur (dec t)
                     (fp/f* aa bb)
                     (fp/f* e (fp/f+ aa (fp/f* a24 e)))
                     (fp/fsq (fp/f+ da cb))
                     (fp/f* x1 (fp/fsq (fp/f- da cb)))
                     kt))))))))

(defn x448!
  [k u]
  (let [r (x448 k u)]
    (if (= :ok (:status r)) (:bytes r)
        (throw (ex-info (str "x448: " (name (:reason r))) r)))))

(def base-point
  "u = 5, little-endian."
  (into [5] (repeat 55 0)))

(defn public-key [k] (x448! k base-point))

(defn contributory?
  "False when the output is all zeroes.

  Required by RFC 9180 §7.1.4 before a shared secret is used, and left to the
  caller by RFC 7748 §6.1 — so it is a separate predicate rather than an error
  inside `x448`."
  [bs]
  (not (every? #(= 0 (bit-and (int %) 0xFF)) (seq bs))))

(defn hex [bs]
  (apply str (map (fn [b] (let [b (bit-and (int b) 0xFF)
                                s #?(:clj (Integer/toString b 16) :cljs (.toString b 16))]
                            (if (= 1 (count s)) (str "0" s) s)))
                  bs)))

(defn unhex [s]
  (mapv #(#?(:clj Integer/parseInt :cljs js/parseInt) (apply str %) 16) (partition 2 s)))
