(ns x448.fp
  "Arithmetic modulo `p = 2^448 - 2^224 - 1`, and the host big integers under
  it.

  This is the **only** file here with a reader conditional.

  ## Why this is not shared with org-nist-ecc

  `ecc.bignum` in `kotoba-lang/org-nist-ecc` is the same idea and about the
  same size. It is not depended on, for two reasons and one rule:

  - the coupling would be wrong-way-round — an RFC 7748 curve does not
    belong downstream of the NIST prime curves
  - this one is narrower: a single fixed modulus, a single fixed width, and
    no need for `bit-length` or a general `test-bit`

  The rule is the one this workspace already applies to its SPA routers:
  **extract on the third consumer, not the second.** Two copies is a fact;
  three is a pattern. If a third arrives, the extraction is a repo named for
  the subject (`bignum`) that both depend on.

  ## What ClojureScript gets wrong here

  `BigInt` is not what `cljs.core`'s numeric predicates expect. Measured under
  nbb: `rem` and `even?` throw, and **`zero?` returns `false` for a `BigInt`
  zero**. The two that throw announce themselves; the third does not. Nothing
  below calls one that has not been checked.

  ## Not constant-time

  `java.math.BigInteger` and `BigInt` both branch and allocate on the
  magnitude of their inputs, so `cswap` below is a conditional swap in name
  only — the ladder's shape is constant, the arithmetic under it is not. See
  the README."
  (:refer-clojure :exclude [zero?])
  #?(:clj (:import [java.math BigInteger])))

(def key-bytes 56)
(def bits 448)

(defn of-int [n] #?(:clj (BigInteger/valueOf (long n)) :cljs (js/BigInt n)))
(defn of-dec [s] #?(:clj (BigInteger. ^String s 10) :cljs (js/BigInt s)))
(defn of-hex [s] #?(:clj (BigInteger. ^String s 16)
                    :cljs (js/BigInt (str "0x" (if (= "" s) "0" s)))))

(def zero (of-int 0))
(def one (of-int 1))
(def two (of-int 2))

(defn- badd [a b] #?(:clj (.add ^BigInteger a ^BigInteger b) :cljs (+ a b)))
(defn- bsub [a b] #?(:clj (.subtract ^BigInteger a ^BigInteger b) :cljs (- a b)))
(defn- bmul [a b] #?(:clj (.multiply ^BigInteger a ^BigInteger b) :cljs (* a b)))
(defn- bmod [a m] #?(:clj (.mod ^BigInteger a ^BigInteger m) :cljs (mod a m)))

(defn- pow2 [n] (reduce (fn [a _] (bmul a two)) one (range n)))

(def p
  "`2^448 - 2^224 - 1`, **computed** rather than written down.

  The first draft of this file wrote it out as a decimal literal, split
  across four string chunks. It was wrong — 166 digits instead of 135 — and
  every RFC 7748 vector and all 510 Wycheproof cases failed at once, which is
  the good outcome; a 135-digit constant is 135 chances to be wrong and most
  of the wrong ones would have failed just as loudly. The one that would not
  is a modulus that is still prime and still about the right size.

  So it is not written down. `ecc.curve` in `org-nist-ecc` cannot do this —
  its `b`, `gx`, `gy` and `n` have no closed form — and pays for it with
  three structural assertions instead. Here there is a closed form, and the
  cheapest way to not mistype a number is to not type it."
  (bsub (bsub (pow2 448) (pow2 224)) one))

(defn eq? [a b] #?(:clj (= 0 (.compareTo ^BigInteger a ^BigInteger b)) :cljs (= a b)))
(defn zero? [a] (eq? a zero))

(defn f+ [a b] (bmod (badd a b) p))
(defn f- [a b] (bmod (bsub a b) p))
(defn f* [a b] (bmod (bmul a b) p))
(defn fsq [a] (f* a a))

(defn mod-pow [a e m]
  #?(:clj (.modPow ^BigInteger a ^BigInteger e ^BigInteger m)
     :cljs (loop [b (bmod a m) e e acc one]
             (if (zero? e)
               acc
               (recur (bmod (bmul b b) m)
                      (bit-shift-right e one)
                      (if (= one (bit-and e one)) (bmod (bmul acc b) m) acc))))))

(defn finv
  "`a^(p-2)`. Fermat, because `p` is prime and this happens once per scalar
  multiplication."
  [a]
  (mod-pow a (bsub p two) p))

(defn test-bit [a i]
  #?(:clj (.testBit ^BigInteger a (int i))
     :cljs (= one (bit-and (bit-shift-right a (js/BigInt i)) one))))

;; ── encoding ─────────────────────────────────────────────────────────────────
;;
;; RFC 7748 encodes both scalars and u-coordinates **little-endian**. Getting
;; the order wrong produces a valid-looking field element and a shared secret
;; that agrees with nothing.

(defn of-bytes-le [bs]
  (reduce (fn [acc b] (badd (bmul acc (of-int 256)) (of-int (bit-and (int b) 0xFF))))
          zero
          (reverse (seq bs))))

(defn to-bytes-le [a]
  (loop [v (bmod a p) out [] k 0]
    (if (= k key-bytes)
      out
      (recur #?(:clj (.divide ^BigInteger v (BigInteger/valueOf 256)) :cljs (/ v (js/BigInt 256)))
             (conj out #?(:clj (.intValue (.mod ^BigInteger v (BigInteger/valueOf 256)))
                          :cljs (js/Number (mod v (js/BigInt 256)))))
             (inc k)))))
