(ns x448.core-test
  "X448 against RFC 7748 and against the complete Wycheproof corpus.

  The RFC's own vectors say the function is X448. The corpus says it is X448
  on inputs chosen to break it: 234 points on the **twist** (X448 is x-only,
  so a u-coordinate need not be on the curve at all and the ladder computes
  in the twist group instead), 14 low-order public keys, 11 that produce an
  all-zero shared secret, and 5 non-canonical encodings that are legal
  because RFC 7748 reduces a u-coordinate modulo p on decode."
  (:require [kotoba.test :refer [deftest is testing]]
            [x448.core :as x]
            [x448.fp :as fp]
            [x448.wycheproof :as wp]))

(defn- h [s] (x/unhex s))

;; ── RFC 7748 §5.2 ────────────────────────────────────────────────────────────

(deftest rfc-7748-scalar-multiplication
  (testing "first vector"
    (is (= (str "ce3e4ff95a60dc6697da1db1d85e6afbdf79b50a2412d7546d5f239f"
                "e14fbaadeb445fc66a01b0779d98223961111e21766282f73dd96b6f")
           (x/hex (x/x448! (h (str "3d262fddf9ec8e88495266fea19a34d28882acef045104d0d1aae121"
                                   "700a779c984c24f8cdd78fbff44943eba368f54b29259a4f1c600ad3"))
                           (h (str "06fce640fa3487bfda5f6cf2d5263f8aad88334cbd07437f020f08f9"
                                   "814dc031ddbdc38c19c6da2583fa5429db94ada18aa7a7fb4ef8a086")))))))
  (testing "second vector"
    (is (= (str "884a02576239ff7a2f2f63b2db6a9ff37047ac13568e1e30fe63c4a7"
                "ad1b3ee3a5700df34321d62077e63633c575c1c954514e99da7c179d")
           (x/hex (x/x448! (h (str "203d494428b8399352665ddca42f9de8fef600908e0d461cb021f8c5"
                                   "38345dd77c3e4806e25f46d3315c44e0a5b4371282dd2c8d5be3095f"))
                           (h (str "0fbcc2f993cd56d3305b0b7d9e55d4c1a8fb5dbb52f8e9a1e9b6201b"
                                   "165d015894e56c4d3570bee52fe205e28a78b91cdfbde71ce8d157db"))))))))

(deftest rfc-7748-iterated
  ;; k and u both start at the base point; each round makes the old k the new
  ;; u. One iteration and a thousand. The million-iteration vector the RFC
  ;; also publishes is not run: it is the same code path a thousand more
  ;; times, and it would dominate the suite's runtime for no new information.
  (let [start (into [5] (repeat 55 0))
        step (fn [[k u]] [(x/x448! k u) k])]
    (testing "after one iteration"
      (is (= (str "3f482c8a9f19b01e6c46ee9711d9dc14fd4bf67af30765c2ae2b846a"
                  "4d23a8cd0db897086239492caf350b51f833868b9bc2b3bca9cf4113")
             (x/hex (first (step [start start]))))))
    (testing "after 1,000 iterations"
      (is (= (str "aa3b4749d55b9daf1e5b00288826c467274ce3ebbdd5c17b975e09d4"
                  "af6c67cf10d087202db88286e2b79fceea3ec353ef54faa26e219f38")
             (x/hex (first (nth (iterate step [start start]) 1000))))))))

(deftest rfc-7748-diffie-hellman
  (let [a (h (str "9a8f4925d1519f5775cf46b04b5800d4ee9ee8bae8bc5565d498c28d"
                  "d9c9baf574a9419744897391006382a6f127ab1d9ac2d8c0a598726b"))
        b (h (str "1c306a7ac2a0e2e0990b294470cba339e6453772b075811d8fad0d1d"
                  "6927c120bb5ee8972b0d3e21374c9c921b09d1b0366f10b65173992d"))
        pa (str "9b08f7cc31b7e3e67d22d5aea121074a273bd2b83de09c63faa73d2c"
                "22c5d9bbc836647241d953d40c5b12da88120d53177f80e532c41fa0")
        pb (str "3eb7a829b0cd20f5bcfc0b599b6feccf6da4627107bdb0d4f345b430"
                "27d8b972fc3e34fb4232a13ca706dcb57aec3dae07bdc1c67bf33609")
        k (str "07fff4181ac6cc95ec1c16a94a0f74d12da232ce40a77552281d282b"
               "b60c0b56fd2464c335543936521c24403085d59a449a5037514a879d")]
    (is (= pa (x/hex (x/public-key a))) "Alice's public key")
    (is (= pb (x/hex (x/public-key b))) "Bob's public key")
    (is (= k (x/hex (x/x448! a (h pb)))) "from Alice's side")
    (is (= k (x/hex (x/x448! b (h pa)))) "from Bob's side")
    (is (x/contributory? (x/x448! a (h pb))))))

;; ── Wycheproof ───────────────────────────────────────────────────────────────

(deftest the-corpus-is-whole
  (is (= wp/declared-count (count wp/cases)))
  (is (= 510 wp/declared-count))
  (testing "and carries the cases that make it worth running"
    (let [flag (fn [f] (count (filter #(contains? (:flags %) f) wp/cases)))]
      (is (= 234 (flag :Twist)))
      (is (= 14 (flag :LowOrderPublic)))
      (is (= 11 (flag :ZeroSharedSecret)))
      (is (= 5 (flag :NonCanonicalPublic)))
      (is (= 12 (flag :PublicKeyTooLong))))))

(deftest every-well-formed-case-computes-the-published-secret
  ;; `valid` and `acceptable` are both computed. `acceptable` here does not
  ;; mean "may be wrong" -- it means an implementation may legitimately
  ;; *refuse* the input (a twist point, a low-order key, an all-zero result).
  ;; This one computes, and exposes the refusal separately as
  ;; `contributory?`, because RFC 7748 §6.1 leaves the choice to the caller
  ;; and RFC 9180 §7.1.4 makes it mandatory only for HPKE.
  (doseq [t wp/cases :when (not= :invalid (:result t))]
    (let [r (x/x448 (h (:private t)) (h (:public t)))]
      (is (= :ok (:status r)) (str "tc " (:id t)))
      (is (= (:shared t) (x/hex (:bytes r)))
          (str "tc " (:id t) " " (pr-str (:flags t)))))))

(deftest invalid-cases-are-rejected-for-the-reason-they-name
  (doseq [t wp/cases :when (= :invalid (:result t))]
    (let [r (x/x448 (h (:private t)) (h (:public t)))]
      (is (= :error (:status r)) (str "tc " (:id t)))
      (is (= :bad-key-length (:reason r))
          (str "tc " (:id t) " " (pr-str (:flags t))
               " — every invalid case in this corpus is an over-long public key"))
      (is (contains? (:flags t) :PublicKeyTooLong)
          (str "tc " (:id t) " — and if that ever stops being true, this test is wrong")))))

(deftest the-all-zero-result-is-detectable
  ;; The corpus marks these `acceptable`: an implementation may return the
  ;; zeroes or refuse. This returns them and makes them detectable, and a
  ;; caller that must refuse (HPKE does) has the predicate to do it with.
  (let [zeros (filter #(contains? (:flags %) :ZeroSharedSecret) wp/cases)]
    (is (= 11 (count zeros)))
    (doseq [t zeros]
      (let [r (x/x448 (h (:private t)) (h (:public t)))]
        (is (= :ok (:status r)))
        (is (every? zero? (:bytes r)) (str "tc " (:id t)))
        (is (not (x/contributory? (:bytes r))) (str "tc " (:id t)))))))

;; ── the shape of the thing ───────────────────────────────────────────────────

(deftest clamping-happens-and-is-the-x448-form
  (testing "the two low bits are cleared and the top bit is set"
    (let [k (vec (repeat 56 0xFF))
          c (x/clamp k)]
      (is (= 0xFC (nth c 0)))
      (is (= 0xFF (nth c 55)) "already set, and stays set"))
    (let [k (vec (repeat 56 0x00))
          c (x/clamp k)]
      (is (= 0x00 (nth c 0)))
      (is (= 0x80 (nth c 55)))))

  (testing "the top bit is set unconditionally, for every input"
    ;; A first attempt at breaking this masked bit 7 off and then set it --
    ;; `(bit-or (bit-and x 0x7F) 0x80)` -- which is the identity, so the
    ;; break was green and looked like a missing test. It was a missing
    ;; break. Clearing the bit instead turns 498 assertions red.
    ;;
    ;; X25519 also masks bit 255, because its field is 255 bits inside 32
    ;; bytes. X448's fills its 56 exactly, so there is no spare bit and the
    ;; question does not arise -- which is a statement about the shape of the
    ;; two curves rather than something a test can distinguish here.
    (doseq [top [0x00 0x01 0x7F 0x80 0xFF]]
      (is (= 0x80 (bit-and 0x80 (nth (x/clamp (assoc (vec (repeat 56 0)) 55 top)) 55)))
          (str "top byte " top))))

  (testing "and x448 clamps what it is given, so a caller cannot skip it"
    (let [raw (assoc (vec (repeat 56 0)) 0 0x03)
          clamped (x/clamp raw)]
      (is (not= raw clamped))
      (is (= (x/hex (x/x448! raw x/base-point))
             (x/hex (x/x448! clamped x/base-point)))))))

(deftest lengths-are-refused-rather-than-adapted
  (doseq [n [0 32 55 57 64]]
    (is (= :bad-key-length (:reason (x/x448 (vec (repeat n 1)) x/base-point)))
        (str "scalar of " n " bytes"))
    (is (= :bad-key-length (:reason (x/x448 (vec (repeat 56 1)) (vec (repeat n 1)))))
        (str "u of " n " bytes"))))

(deftest the-field-modulus-is-what-it-should-be
  ;; p is computed from 2^448 - 2^224 - 1 rather than written out, after the
  ;; written-out version turned out to be a different number entirely. These
  ;; check the computation independently of the expression that produced it.
  (testing "448 bits"
    (is (= 135 (count (str fp/p)))))
  (testing "the defining relation, from the other side"
    ;; 2^448 = 2^224 + 1 (mod p), which is what "p = 2^448 - 2^224 - 1" says
    ;; rearranged -- and it is checked with mod-pow, which does not go
    ;; anywhere near the subtraction that defines p.
    (is (fp/eq? (fp/f+ (fp/mod-pow fp/two (fp/of-int 224) fp/p) fp/one)
                (fp/mod-pow fp/two (fp/of-int 448) fp/p))))
  (testing "and it is prime, by Fermat on a few bases"
    (doseq [a [2 3 5 7 65537]]
      (is (fp/eq? fp/one
                  (fp/mod-pow (fp/of-int a)
                              (fp/f- fp/p fp/one)
                              fp/p))
          (str "base " a))))
  (testing "inversion works in it"
    (is (fp/eq? fp/one (fp/f* fp/two (fp/finv fp/two))))))
