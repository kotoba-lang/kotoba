#!/usr/bin/env kbb
;; Run the suite on the ClojureScript side.
;;
;; The ladder is 448 rounds of field arithmetic over host big integers, and
;; ClojureScript's are BigInt -- which cljs.core's numeric predicates do not
;; understand. `x448.fp` shadows the ones that matter; this is what checks
;; that the shadowing is enough.
;;
;;   kbb --backend sci --classpath "$(kbb -A:cljs -Spath)" scripts/verify-cljs.cljk
(ns verify-cljs
  (:require [kotoba.test :as t]
            [x448.core-test]))

(defmethod t/report [:cljs.test/default :end-run-tests] [m]
  (println)
  (if (t/successful? m)
    (println "all checks passed on the ClojureScript path")
    (do (println "FAILED on the ClojureScript path")
        (js/process.exit 1))))

(t/run-tests 'x448.core-test)
