(ns extract-wycheproof-x448
  "Turn Project Wycheproof's `x448_test.json` into `test/x448/wycheproof.cljk`.

  All 510 cases, no sampling, pinned by sha256.

      curl -sSo x448_test.json \\
        https://raw.githubusercontent.com/C2SP/wycheproof/master/testvectors_v1/x448_test.json
      kbb --backend sci scripts/extract_wycheproof_x448.cljk x448_test.json"
  (:require ["fs" :as fs] ["crypto" :as crypto] [kotoba.lang.text :as str]))

(def source-url
  "https://raw.githubusercontent.com/C2SP/wycheproof/master/testvectors_v1/x448_test.json")
(def source-sha256
  "0f8f7199dbd47d1805cb9b13dfb29c207406bc786827bfd9ba7b73374b830fe5")

(defn- sha256-hex [s] (-> (crypto/createHash "sha256") (.update s "utf8") (.digest "hex")))

(defn -main [& args]
  (let [path (first args)
        _ (when-not path
            (println "usage: kbb --backend sci scripts/extract_wycheproof_x448.cljk <x448_test.json>")
            (js/process.exit 2))
        text (str (fs/readFileSync path "utf8"))]
    (when (not= source-sha256 (sha256-hex text))
      (println "REFUSING: corpus sha256 mismatch")
      (js/process.exit 2))
    (let [j (js->clj (js/JSON.parse text) :keywordize-keys true)
          cases (vec (for [g (:testGroups j) t (:tests g)]
                       {:id (:tcId t) :private (:private t) :public (:public t)
                        :shared (:shared t) :result (keyword (:result t))
                        :flags (set (map keyword (:flags t)))}))]
      (when (not= (:numberOfTests j) (count cases))
        (println "REFUSING: declares" (:numberOfTests j) "extracted" (count cases))
        (js/process.exit 2))
      (println "cases" (count cases)
               (pr-str (frequencies (map :result cases))))
      (let [out (str ";; GENERATED by scripts/extract_wycheproof_x448.cljk — do not edit.\n;;\n"
                     ";; Project Wycheproof X448, complete: " (count cases) " cases, no sampling.\n;;\n"
                     ";; Source:  " source-url "\n;; sha256:  " source-sha256 "\n"
                     "(ns x448.wycheproof)\n\n"
                     "(def declared-count " (:numberOfTests j) ")\n\n"
                     "(def cases\n  [" (str/join "\n   " (map pr-str cases)) "])\n")]
        (fs/mkdirSync "test/x448" #js {:recursive true})
        (fs/writeFileSync "test/x448/wycheproof.cljk" out)
        (println "wrote test/x448/wycheproof.cljk" (count out) "bytes")))))

(apply -main *command-line-args*)
