(ns kotodama.inference.ptq1-test
  (:require [kotodama.inference.ptq1 :as ptq1]
            #?(:clj [kotoba.io :as io])
            #?(:clj [kotoba.test :refer [deftest is testing]]
               :cljs [cljs.test :refer-macros [deftest is testing]])))

(defn resource-present? [path]
  #?(:clj (some? (io/resource path))
     :cljs (.existsSync (js/require "fs") (str "resources/" path))))

(deftest shipped-ptq1-kernel-catalog-is-complete
  (is (= {:ggml/type 143
          :ggml/name :ptq1-0
          :ggml/block-elements 128
          :ggml/block-bytes 28
          :ggml/layout [:qs-24 :qh-2 :f16-scale]}
         ptq1/format-spec))
  (is (= #{:matvec :matvec-positions :dual-swiglu :embedding :signed-hadamard}
         (set (keys ptq1/kernel-artifacts))))
  (doseq [[id {:keys [resource]}] ptq1/kernel-artifacts]
    (is (resource-present? resource) (str id " resource is shipped"))))

(deftest host-runtime-admission-does-not-turn-a-candidate-into-production
  (is (= :production-k16
         (:runtime/qualification (ptq1/host-runtime :prism-vulkan-int-dot true))))
  (let [error (try (ptq1/host-runtime :prism-metal-row5 true) nil
                   (catch #?(:clj Exception :cljs :default) e e))]
    (is (= "PTQ1 host runtime is not production-qualified" (ex-message error)))
    (is (= :kernel-parity-m1-max
           (:runtime/qualification (ex-data error)))))
  (is (= "bdc23b56b4458b9f1655aec5287f3ab56ee8daaa"
         (:runtime/revision (ptq1/host-runtime :prism-metal-graph-fusions))))
  (let [error (try (ptq1/host-runtime :prism-metal-graph-fusions true) nil
                   (catch #?(:clj Exception :cljs :default) e e))]
    (is (= "PTQ1 host runtime is not production-qualified" (ex-message error)))
    (is (= :kernel-parity-m1-m4-speed-rejected
           (:runtime/qualification (ex-data error)))))
  (is (thrown-with-msg? #?(:clj Exception :cljs js/Error)
                        #"unknown PTQ1 kernel artifact"
                        (ptq1/kernel-artifact :missing))))
