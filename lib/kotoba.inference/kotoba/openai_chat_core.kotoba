(ns openai-chat-core
  (:export [stream? max-tokens choices-produced n-admissible?
            object-completion object-chunk object-model object-list
            finish-reason sse-data-prefix sse-frame-suffix sse-terminator
            id-prefix owned-by]))

;; The OpenAI `/v1` envelope, next to the Ollama one.
;;
;; Both surfaces render the same conversation through the same rules
;; (ollama_chat_core owns roles and the admissible final turn) and run the
;; same generation. What differs is the envelope — and the differences are
;; not cosmetic. They are the reason this is a separate core rather than a
;; flag on the other one.
;;
;; ── the difference that would silently break clients ──
;;
;; **Ollama streams by default. OpenAI does not.** `POST /api/generate` with
;; no `stream` key streams NDJSON; `POST /v1/chat/completions` with no
;; `stream` key returns one JSON object. A host that shared one default would
;; be wrong for exactly one of the two surfaces, and wrong in a way that
;; looks like a client bug: an OpenAI client receiving SSE frames it did not
;; ask for reports a parse error, not a server error.
;;
;; Word-typed at the boundary and in the bodies.
;; Parity: cljc/test/kotodama/inference/ollama_kotoba_parity_test.cljk

;; ── stream: default OFF, the opposite of Ollama ──────────────────────

(defn stream? [present? :bool requested :bool] :bool
  (if present? requested false))

;; ── max_tokens ───────────────────────────────────────────────────────
;; OpenAI spells the budget `max_tokens` and treats absence as "until the
;; model stops". This runtime generates on CPU at seconds per token, so
;; absence takes the same 32 the Ollama surface uses rather than running
;; unbounded — the cap is a property of this engine, not of either wire, so
;; both surfaces inherit it.

(defn max-tokens [present? :bool requested :i64] :i64
  (if present?
    (if (> requested 0) requested 32)
    32))

;; ── n ────────────────────────────────────────────────────────────────
;; One completion per request. `n: 3` is not silently answered with one
;; choice — a client that asked for three and received one would treat the
;; single answer as the sample it requested. It is a 400.

(defn choices-produced [] :i64 1)

(defn n-admissible? [n :i64] :bool
  (= n 1))

;; ── object tags ──────────────────────────────────────────────────────
;; Clients switch on these strings; naming them here keeps the streaming and
;; non-streaming paths from drifting apart.

(defn object-completion [] :string "chat.completion")
(defn object-chunk [] :string "chat.completion.chunk")
(defn object-model [] :string "model")
(defn object-list [] :string "list")

;; ── finish_reason ────────────────────────────────────────────────────
;; Takes the same stop codes as ollama-protocol-core's `done-reason`, and
;; today the two vocabularies coincide: "stop" and "length" are the words on
;; both wires. They are written separately because they are separate
;; contracts that happen to agree — a test pins the agreement, so if either
;; wire changes, the coincidence breaks visibly rather than silently.

(defn finish-reason [stop-code :i64] :string
  (if (= stop-code 1) "length" "stop"))

;; ── SSE framing ──────────────────────────────────────────────────────
;; `data: ` prefix, blank-line terminated frames, and a literal `[DONE]`
;; sentinel frame before the stream closes. A client that never sees [DONE]
;; cannot distinguish a finished stream from a dropped connection.

(defn sse-data-prefix [] :string "data: ")
(defn sse-frame-suffix [] :string "\n\n")
(defn sse-terminator [] :string "data: [DONE]\n\n")

;; ── identifiers ──────────────────────────────────────────────────────

(defn id-prefix [] :string "chatcmpl-")
(defn owned-by [] :string "kotodama")
