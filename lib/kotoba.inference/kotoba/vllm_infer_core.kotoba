(ns vllm-infer-core
  (:export [max-output-tokens temperature-milli stream?]))

;; Bounded request policy shared by the JVM reference client and the native
;; vLLM client. Transport and credentials remain host-owned.

(defn max-output-tokens [requested :i64] :i64
  (if (> requested 0)
    (if (> requested 4096) 4096 requested)
    64))

(defn temperature-milli [requested :i64] :i64
  (if (< requested 0)
    0
    (if (> requested 2000) 2000 requested)))

(defn stream? [] :bool false)
