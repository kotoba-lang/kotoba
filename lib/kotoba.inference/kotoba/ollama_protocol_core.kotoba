(ns ollama-protocol-core
  (:export [route-not-found route-version route-tags route-ps route-show
            route-generate route-chat route-openai-chat route-openai-models
            route-code route-reads-body?
            stop-eos stop-max-tokens stop-unknown done-reason
            error-not-found error-bad-request error-internal error-status
            api-version]))

;; Decision core for the Ollama-compatible HTTP surface
;; (kotodama.inference.host.ollama-server). Kotoba is the authority; the host
;; owns transport only — sockets, JSON, threads, GGUF bytes.
;;
;; Scope rule (ADR-2608138800): what moves here is the DECISION — which route a
;; (method, path) pair is, whether that route reads a body, what a stop reason
;; is called on the wire, what HTTP status an error kind maps to. What stays in
;; the host is every effect and every collection walk.
;;
;; Word-typed on purpose, in the two separate senses native needs:
;;
;;   - every parameter and result is :i64 / :bool / :string, which is what a
;;     kexe export boundary accepts (ADR-2608110200: a [:ref …] or [:record …]
;;     cannot cross, and is refused deliberately rather than missing);
;;   - the bodies use only features `kotoba.kir/only-native-word-typed-features?`
;;     admits.
;;
;; Both are checked, separately, by the parity test — passing one says nothing
;; about the other.
;;
;; Parity: cljc/test/kotodama/inference/ollama_kotoba_parity_test.cljk

;; ── route codes ──────────────────────────────────────────────────────
;; Codes, not strings, so the host `case` is a dense i64 dispatch and an
;; unhandled code is a compile-visible omission rather than a silent 404.

(defn route-not-found [] :i64 0)
(defn route-version [] :i64 1)
(defn route-tags [] :i64 2)
(defn route-ps [] :i64 3)
(defn route-show [] :i64 4)
(defn route-generate [] :i64 5)
(defn route-chat [] :i64 6)
;; The OpenAI-compatible surface. Same engine, different envelope
;; (openai_chat_core), and notably the opposite streaming default.
(defn route-openai-chat [] :i64 7)
(defn route-openai-models [] :i64 8)

(defn route-code [method :string path :string] :i64
  (if (string=? method "GET")
    (if (string=? path "/api/version")
      1
      (if (string=? path "/api/tags")
        2
        (if (string=? path "/api/ps")
          3
          (if (string=? path "/v1/models") 8 0))))
    (if (string=? method "POST")
      (if (string=? path "/api/show")
        4
        (if (string=? path "/api/generate")
          5
          (if (string=? path "/api/chat")
            6
            (if (string=? path "/v1/chat/completions") 7 0))))
      0)))

(defn route-reads-body? [code :i64] :bool
  ;; Only the POST routes consume a request body. The host must not read the
  ;; body of a route that does not have one: java.net.httpserver blocks.
  ;;
  ;; No longer a simple `>= 4`: /v1/models is a GET and carries code 8, so a
  ;; threshold would make the host block reading a body that never arrives.
  (and (>= code 4) (< code 8)))

;; ── stop reason → Ollama `done_reason` ───────────────────────────────
;; The kotodama generate result carries :kotodama/stop-reason; the host maps it
;; to a code and asks here for the wire name. Unknown reasons say "stop", which
;; is what Ollama clients expect for an orderly end.

(defn stop-eos [] :i64 0)
(defn stop-max-tokens [] :i64 1)
(defn stop-unknown [] :i64 2)

(defn done-reason [stop-code :i64] :string
  (if (= stop-code 1) "length" "stop"))

;; ── error kind → HTTP status ─────────────────────────────────────────

(defn error-not-found [] :i64 0)
(defn error-bad-request [] :i64 1)
(defn error-internal [] :i64 2)

(defn error-status [kind :i64] :i64
  (if (= kind 0)
    404
    (if (= kind 1) 400 500)))

;; ── identity ─────────────────────────────────────────────────────────
;; Ollama clients version-gate on this string. It names the implementation
;; rather than claiming an upstream Ollama version we do not implement.

(defn api-version [] :string "0.1.0-kotodama")
