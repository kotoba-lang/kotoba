(ns ollama-chat-core
  (:export [role-unknown role-system role-user role-assistant role-tool
            role-code role-valid? role-wire-name
            admissible-final-role? assistant-wire-role]))

;; Conversation rules for POST /api/chat.
;;
;; What is here is what a conversation IS: which roles exist, which strings
;; name them, and which role a conversation may end on before the model is
;; asked to continue it.
;;
;; What is NOT here is the rendering. Ollama carries a Go template per model
;; and this runtime does not implement Go templates; the host renders from
;; explicit delimiter fragments carried on the model spec
;; (`:kotodama/chat`), and refuses with 400 when a model has none. Inventing
;; a template for a model whose real one we have not read would be inventing
;; a model fact — the delimiters are data about a specific GGUF, not a
;; decision this core gets to make.
;;
;; Word-typed at the boundary and in the bodies, like the other decision
;; cores (see ollama_protocol_core.kotoba).
;;
;; Parity: cljc/test/kotodama/inference/ollama_kotoba_parity_test.cljk

;; ── roles ────────────────────────────────────────────────────────────
;; `tool` is admitted as a role because Ollama clients send it, and silently
;; dropping a turn would change the conversation the user thinks they sent.
;; Whether a given model can do anything useful with it is the model's
;; business, not the wire's.

(defn role-unknown [] :i64 0)
(defn role-system [] :i64 1)
(defn role-user [] :i64 2)
(defn role-assistant [] :i64 3)
(defn role-tool [] :i64 4)

(defn role-code [name :string] :i64
  (if (string=? name "system")
    1
    (if (string=? name "user")
      2
      (if (string=? name "assistant")
        3
        (if (string=? name "tool") 4 0)))))

(defn role-valid? [code :i64] :bool
  (and (> code 0) (< code 5)))

(defn role-wire-name [code :i64] :string
  (if (= code 1)
    "system"
    (if (= code 2)
      "user"
      (if (= code 3)
        "assistant"
        (if (= code 4) "tool" "")))))

;; ── what a conversation may end on ───────────────────────────────────
;; The request asks the model to produce the NEXT turn, so the last message
;; must be one the model would answer: a user turn, or a tool result it was
;; waiting for. A conversation ending in `assistant` is asking the model to
;; continue its own turn, and one ending in `system` has no question in it —
;; both are client bugs worth a 400 rather than a plausible-looking
;; completion of nothing.
;;
;; An empty conversation is rejected by the host before this is consulted:
;; there is no final role to ask about, and `role-unknown` would conflate
;; "no messages" with "a message whose role I could not read".

(defn admissible-final-role? [code :i64] :bool
  (or (= code 2) (= code 4)))

;; ── the role the answer carries ──────────────────────────────────────
;; Ollama's /api/chat response nests {"role": "assistant", "content": ...}.
;; Named here so the host cannot drift from the request-side role table.

(defn assistant-wire-role [] :string "assistant")
