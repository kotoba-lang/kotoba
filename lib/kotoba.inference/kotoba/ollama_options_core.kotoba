(ns ollama-options-core
  (:export [default-max-tokens max-tokens
            stream?
            forever default-keep-alive-ms keep-alive-ms
            top-k]))

;; Request-option policy for the Ollama-compatible surface. Every export takes
;; an explicit `present?` flag beside the value: JSON absence and JSON null and
;; a supplied zero are three different requests, and a host that collapses them
;; into `(or v default)` cannot tell "the client asked for 0" from "the client
;; said nothing" — the exact shape the 5-question rule (ADR-2608136000 Q1)
;; calls out. Presence is the caller's to determine; the policy is here.
;;
;; Word-typed (i64/:bool) at both the export boundary and in the bodies — see
;; ollama_protocol_core.kotoba for what those two mean and where each is checked.
;;
;; NOT here: temperature and top_p, and the reason first recorded here was
;; wrong. It said f64 arithmetic had no admitted lowering, citing `(< v 0.0)`
;; rejecting with "expected i64, got f64" and `f64+` with "operation has no
;; admitted lowering".
;;
;; Both measurements are real; neither name exists. `<` is the i64 comparison
;; and there is no `f64+`. The float operations are `f64-lt`, `f64-add`,
;; `f64-min`, `f64-max` — amu's frontend carries a full `f64-operations` table,
;; and measured 2026-08-13 on amu e8864273 they compile and execute correctly.
;;
;; The real reason these two stay out: `kotoba.kir/
;; only-native-word-typed-features?` rejects f64, so putting the clamps here
;; would drop this whole core out of the native-boundary gate for the sake of
;; two `f64-min`/`f64-max` calls. Clamping lives in kernel_math_core.kotoba
;; instead, which is float-typed by nature and does not claim native
;; qualification. See ADR-2608138800's amendment.
;;
;; Parity: cljc/test/kotodama/inference/ollama_kotoba_parity_test.cljk

;; ── num_predict ──────────────────────────────────────────────────────
;; 32 rather than Ollama's own -1 (unbounded) because this runtime generates on
;; CPU at seconds per token; an unbounded default is a hung request. Documented
;; in README "Status".
;;
;; Behaviour change vs the pre-Kotoba host (ADR-2608138800): a non-positive
;; num_predict used to fall straight through as the token budget, so
;; `num_predict: 0` and `num_predict: -1` both meant "generate nothing" — the
;; second silently, since -1 means "no limit" to every Ollama client. Both now
;; take the default. There is no way to spell "unbounded" here on purpose.

(defn default-max-tokens [] :i64 32)

(defn max-tokens [present? :bool requested :i64] :i64
  (if present?
    (if (> requested 0) requested (default-max-tokens))
    (default-max-tokens)))

;; ── stream ───────────────────────────────────────────────────────────
;; Ollama streams unless the client explicitly says `"stream": false`.

(defn stream? [present? :bool requested :bool] :bool
  (if present? requested true))

;; ── keep_alive ───────────────────────────────────────────────────────
;; Seconds in, milliseconds out. Negative means "hold the model forever" and is
;; normalised to a single sentinel so downstream comparisons have one shape to
;; test; zero means "unload as soon as this request is answered".
;;
;; Duration strings ("5m", "1h") are NOT parsed here — the host normalises them
;; to seconds first. Character-level parsing in a decision core would be the
;; regex-scanning-for-structure antipattern AGENTS.md names.

(defn forever [] :i64 -1)

(defn default-keep-alive-ms [] :i64 300000)

(defn keep-alive-ms [present? :bool seconds :i64] :i64
  (if present?
    (if (< seconds 0)
      (forever)
      (* seconds 1000))
    (default-keep-alive-ms)))

;; ── top_k ────────────────────────────────────────────────────────────
;; A negative top_k is meaningless; 0 is the sampler's "disabled". Absent stays
;; absent — the host omits the key entirely rather than sending a 0 that would
;; read as an explicit request to disable.

(defn top-k [present? :bool requested :i64] :i64
  (if present?
    (if (< requested 0) 0 requested)
    0))
