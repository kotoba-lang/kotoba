(ns amu.bench.dq-loop-q4k (:export [dot-n]))

;; Timing probe: the fused Q8_0 dequant-dot over a granted weight region and a
;; granted activation region, repeated `times` times by counted self-recursion
;; so the host can difference wall-clock between N=1 and N=large.
;;
;; The native boundary is FIVE words wide on every function, and four of them
;; are the two regions, so the fifth carries everything else packed:
;;   bits  0..15  blocks
;;   bits 16..31  times remaining
;;   bits 32..63  accumulator (xor of every answer's f32 bit pattern), which
;;                is also what makes each iteration observable.

(defn- go [wbase :i64 wlen :i64 xbase :i64 xlen :i64 spec :i64]
  (let [blocks (bit-and spec 65535)
        times (bit-and (u64-shift-right spec 16) 65535)
        acc (u64-shift-right spec 32)]
    (if (< times 1)
      acc
      (go wbase wlen xbase xlen
          (bit-or blocks
                  (bit-or (i64-shift-left (- times 1) 16)
                          (i64-shift-left
                           (bit-xor acc (bit-and 4294967295
                                                 (kernel-dequant-dot-q4-k wbase wlen xbase xlen blocks)))
                           32)))))))

(defn dot-n [wbase :i64 wlen :i64 xbase :i64 xlen :i64 spec :i64]
  (go wbase wlen xbase xlen (bit-and spec 4294967295)))
