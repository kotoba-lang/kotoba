#version 450
// The two expert kdots that share an input, in one dispatch: gate = Wa x, up = Wb x for
// the same eight (expert, row) pairs, and the epilogue writes act = silu(gate) * up
// directly -- gate_exps, up_exps and silu_mul become one dispatch (iteration 28). Same
// r8 layout as kdot_f32_r8.comp (eight rows per 64-thread workgroup, x read once per
// block for both weight streams, sixteen loads in flight per thread), same Meta.
// Bindings: 0 meta, 1 Wa, 2 Wb, 3 x, 4 act, 5 expert_ids. Dispatch: (ceil(rows / 8), positions, 1).
const uint ROWS_PER_WG = 8u;
layout(local_size_x = 64) in;
layout(std430, binding = 0) readonly buffer Meta {
  uint rows; uint cols; uint tensor_type; uint positions; uint input_per_expert; uint pad0; uint pad1; uint pad2;
} params;
layout(std430, binding = 1) readonly buffer WA { uint wa[]; };
layout(std430, binding = 2) readonly buffer WB { uint wb_[]; };
layout(std430, binding = 3) readonly buffer X { float x[]; };
layout(std430, binding = 4) buffer O { float outp[]; };
layout(std430, binding = 5) readonly buffer E { uint expert_ids[]; };
uint weight_byte_a(uint offset) { return (wa[offset >> 2u] >> ((offset & 3u) * 8u)) & 255u; }
float weight_half_a(uint offset) {
  vec2 pair = unpackHalf2x16(wa[offset >> 2u]);
  return ((offset & 2u) != 0u) ? pair.y : pair.x;
}
int q4_scale_a(uint base, uint j) {
  if (j < 4u) return int(weight_byte_a(base + 4u + j) & 63u);
  return int((weight_byte_a(base + 8u + j) & 15u) | ((weight_byte_a(base + j) >> 6u) << 4u));
}
int q4_min_a(uint base, uint j) {
  if (j < 4u) return int(weight_byte_a(base + 8u + j) & 63u);
  return int((weight_byte_a(base + 8u + j) >> 4u) | ((weight_byte_a(base + 4u + j) >> 6u) << 4u));
}
ivec4 q4_word_values_a(uint base, uint index) {
  uint group = index / 64u; uint within = index & 63u;
  uint w = wa[(base + 16u + group * 32u + (within & 31u)) >> 2u];
  uint shift = (within >= 32u) ? 4u : 0u;
  return ivec4(int((w >> shift) & 15u), int((w >> (8u + shift)) & 15u), int((w >> (16u + shift)) & 15u), int((w >> (24u + shift)) & 15u));
}
uint weight_u32_at_a(uint offset) {
  uint w0 = wa[offset >> 2u]; uint shift = (offset & 3u) * 8u;
  if (shift == 0u) return w0;
  uint w1 = wa[(offset >> 2u) + 1u];
  return (w0 >> shift) | (w1 << (32u - shift));
}
ivec4 q6_word_values_a(uint base, uint index) {
  uint group = index / 128u; uint within = index & 127u; uint lane = within & 31u;
  uint ql_base = base + group * 64u;
  uint qh = weight_u32_at_a(base + 128u + group * 32u + lane);
  uint quarter = within / 32u;
  uint ql = weight_u32_at_a(ql_base + (((quarter & 1u) == 1u) ? 32u : 0u) + lane);
  uint ql_shift = (quarter >= 2u) ? 4u : 0u;
  uint qh_shift = quarter * 2u;
  // written out: a dynamically indexed ivec4 in a loop goes to local memory on
  // NVIDIA (measured 2026-09-19 on the Xavier: 1 GB/s against 54 for f32)
  return ivec4(int(((ql >> ql_shift) & 15u) | (((qh >> qh_shift) & 3u) << 4u)) - 32,
               int(((ql >> (8u + ql_shift)) & 15u) | (((qh >> (8u + qh_shift)) & 3u) << 4u)) - 32,
               int(((ql >> (16u + ql_shift)) & 15u) | (((qh >> (16u + qh_shift)) & 3u) << 4u)) - 32,
               int(((ql >> (24u + ql_shift)) & 15u) | (((qh >> (24u + qh_shift)) & 3u) << 4u)) - 32);
}
// IQ4_XS codebook (ggml kvalues_iq4nl) as four packed words of int8, selected
// by comparison rather than indexed: a dynamically indexed constant array is
// local memory on NVIDIA.
//   -127,-104,-83,-65 | -49,-35,-22,-10 | 1,13,25,38 | 53,69,89,113
int kvalue_a(uint i) {
  uint w = (i < 4u) ? 0xBFAD9881u : (i < 8u) ? 0xF6EADDCFu : (i < 12u) ? 0x26190D01u : 0x71594535u;
  return bitfieldExtract(int(w), int((i & 3u) * 8u), 8);
}
ivec4 q5_word_values_a(uint base, uint index) {
  uint group = index / 64u; uint within = index & 63u; uint lane = within & 31u;
  bool hi_half = within >= 32u;
  uint qs = wa[(base + 48u + group * 32u + lane) >> 2u];
  uint qh = wa[(base + 16u + lane) >> 2u];
  uint shift = hi_half ? 4u : 0u;
  uint bit = 2u * group + (hi_half ? 1u : 0u);
  return ivec4(int(((qs >> shift) & 15u) | (((qh >> bit) & 1u) << 4u)),
               int(((qs >> (8u + shift)) & 15u) | (((qh >> (8u + bit)) & 1u) << 4u)),
               int(((qs >> (16u + shift)) & 15u) | (((qh >> (16u + bit)) & 1u) << 4u)),
               int(((qs >> (24u + shift)) & 15u) | (((qh >> (24u + bit)) & 1u) << 4u)));
}
ivec4 iq4xs_word_values_a(uint base, uint index) {
  uint ib = index / 32u; uint within = index & 31u; bool hi = within >= 16u;
  uint w = wa[(base + 8u + ib * 16u + (hi ? within - 16u : within)) >> 2u];
  uint shift = hi ? 4u : 0u;
  return ivec4(kvalue_a((w >> shift) & 15u), kvalue_a((w >> (8u + shift)) & 15u),
               kvalue_a((w >> (16u + shift)) & 15u), kvalue_a((w >> (24u + shift)) & 15u));
}
int iq4xs_scale_a(uint base, uint ib) {
  uint scales_h = wa[base >> 2u] >> 16u;
  uint scales_l = weight_byte_a(base + 4u + ib / 2u);
  return int(((scales_l >> (4u * (ib & 1u))) & 15u) | (((scales_h >> (2u * ib)) & 3u) << 4u));
}
uint block_bytes_of_a(uint t) {
  if (t == 12u) return 144u; if (t == 13u) return 176u; if (t == 14u) return 210u; if (t == 23u) return 136u; return 0u;
}


uint weight_byte_b(uint offset) { return (wb_[offset >> 2u] >> ((offset & 3u) * 8u)) & 255u; }
float weight_half_b(uint offset) {
  vec2 pair = unpackHalf2x16(wb_[offset >> 2u]);
  return ((offset & 2u) != 0u) ? pair.y : pair.x;
}
int q4_scale_b(uint base, uint j) {
  if (j < 4u) return int(weight_byte_b(base + 4u + j) & 63u);
  return int((weight_byte_b(base + 8u + j) & 15u) | ((weight_byte_b(base + j) >> 6u) << 4u));
}
int q4_min_b(uint base, uint j) {
  if (j < 4u) return int(weight_byte_b(base + 8u + j) & 63u);
  return int((weight_byte_b(base + 8u + j) >> 4u) | ((weight_byte_b(base + 4u + j) >> 6u) << 4u));
}
ivec4 q4_word_values_b(uint base, uint index) {
  uint group = index / 64u; uint within = index & 63u;
  uint w = wb_[(base + 16u + group * 32u + (within & 31u)) >> 2u];
  uint shift = (within >= 32u) ? 4u : 0u;
  return ivec4(int((w >> shift) & 15u), int((w >> (8u + shift)) & 15u), int((w >> (16u + shift)) & 15u), int((w >> (24u + shift)) & 15u));
}
uint weight_u32_at_b(uint offset) {
  uint w0 = wb_[offset >> 2u]; uint shift = (offset & 3u) * 8u;
  if (shift == 0u) return w0;
  uint w1 = wb_[(offset >> 2u) + 1u];
  return (w0 >> shift) | (w1 << (32u - shift));
}
ivec4 q6_word_values_b(uint base, uint index) {
  uint group = index / 128u; uint within = index & 127u; uint lane = within & 31u;
  uint ql_base = base + group * 64u;
  uint qh = weight_u32_at_b(base + 128u + group * 32u + lane);
  uint quarter = within / 32u;
  uint ql = weight_u32_at_b(ql_base + (((quarter & 1u) == 1u) ? 32u : 0u) + lane);
  uint ql_shift = (quarter >= 2u) ? 4u : 0u;
  uint qh_shift = quarter * 2u;
  // written out: a dynamically indexed ivec4 in a loop goes to local memory on
  // NVIDIA (measured 2026-09-19 on the Xavier: 1 GB/s against 54 for f32)
  return ivec4(int(((ql >> ql_shift) & 15u) | (((qh >> qh_shift) & 3u) << 4u)) - 32,
               int(((ql >> (8u + ql_shift)) & 15u) | (((qh >> (8u + qh_shift)) & 3u) << 4u)) - 32,
               int(((ql >> (16u + ql_shift)) & 15u) | (((qh >> (16u + qh_shift)) & 3u) << 4u)) - 32,
               int(((ql >> (24u + ql_shift)) & 15u) | (((qh >> (24u + qh_shift)) & 3u) << 4u)) - 32);
}
// IQ4_XS codebook (ggml kvalues_iq4nl) as four packed words of int8, selected
// by comparison rather than indexed: a dynamically indexed constant array is
// local memory on NVIDIA.
//   -127,-104,-83,-65 | -49,-35,-22,-10 | 1,13,25,38 | 53,69,89,113
int kvalue_b(uint i) {
  uint w = (i < 4u) ? 0xBFAD9881u : (i < 8u) ? 0xF6EADDCFu : (i < 12u) ? 0x26190D01u : 0x71594535u;
  return bitfieldExtract(int(w), int((i & 3u) * 8u), 8);
}
ivec4 q5_word_values_b(uint base, uint index) {
  uint group = index / 64u; uint within = index & 63u; uint lane = within & 31u;
  bool hi_half = within >= 32u;
  uint qs = wb_[(base + 48u + group * 32u + lane) >> 2u];
  uint qh = wb_[(base + 16u + lane) >> 2u];
  uint shift = hi_half ? 4u : 0u;
  uint bit = 2u * group + (hi_half ? 1u : 0u);
  return ivec4(int(((qs >> shift) & 15u) | (((qh >> bit) & 1u) << 4u)),
               int(((qs >> (8u + shift)) & 15u) | (((qh >> (8u + bit)) & 1u) << 4u)),
               int(((qs >> (16u + shift)) & 15u) | (((qh >> (16u + bit)) & 1u) << 4u)),
               int(((qs >> (24u + shift)) & 15u) | (((qh >> (24u + bit)) & 1u) << 4u)));
}
ivec4 iq4xs_word_values_b(uint base, uint index) {
  uint ib = index / 32u; uint within = index & 31u; bool hi = within >= 16u;
  uint w = wb_[(base + 8u + ib * 16u + (hi ? within - 16u : within)) >> 2u];
  uint shift = hi ? 4u : 0u;
  return ivec4(kvalue_b((w >> shift) & 15u), kvalue_b((w >> (8u + shift)) & 15u),
               kvalue_b((w >> (16u + shift)) & 15u), kvalue_b((w >> (24u + shift)) & 15u));
}
int iq4xs_scale_b(uint base, uint ib) {
  uint scales_h = wb_[base >> 2u] >> 16u;
  uint scales_l = weight_byte_b(base + 4u + ib / 2u);
  return int(((scales_l >> (4u * (ib & 1u))) & 15u) | (((scales_h >> (2u * ib)) & 3u) << 4u));
}
uint block_bytes_of_b(uint t) {
  if (t == 12u) return 144u; if (t == 13u) return 176u; if (t == 14u) return 210u; if (t == 23u) return 136u; return 0u;
}


shared float partial[1024];   // 2 x ROWS_PER_WG x 64
float silu(float v) { return v / (1.0 + exp(-v)); }
void main() {
  uint row0 = gl_WorkGroupID.x * ROWS_PER_WG;
  uint position = gl_WorkGroupID.y;
  uint t = gl_LocalInvocationID.x;
  uint expert = expert_ids[position];
  uint in_row = (params.input_per_expert == 1u) ? position : 0u;
  uint blocks = params.cols / 256u;
  uint tt = params.tensor_type;
  uint block_bytes = block_bytes_of_a(tt);
  uint row_bytes = blocks * block_bytes;
  uint index = t * 4u;
  float acc_a[8]; float mins_a[8]; float acc_b[8]; float mins_b[8];
  for (uint r = 0u; r < ROWS_PER_WG; r++) { acc_a[r] = 0.0; mins_a[r] = 0.0; acc_b[r] = 0.0; mins_b[r] = 0.0; }
  uint nrows = min(ROWS_PER_WG, params.rows - min(row0, params.rows));
  if (position < params.positions) {
    for (uint block = 0u; block < blocks; block++) {
      uint xb = in_row * params.cols + block * 256u + index;
      vec4 y = vec4(x[xb], x[xb + 1u], x[xb + 2u], x[xb + 3u]);
      float ysum = y.x + y.y + y.z + y.w;
      uint base0 = (expert * params.rows + row0) * row_bytes + block * block_bytes;
      for (uint r = 0u; r < nrows; r++) {
        uint wb = base0 + r * row_bytes;
        if (tt == 12u || tt == 13u) {
          uint j = index / 32u;
          float scale = float(q4_scale_a(wb, j));
          ivec4 q = (tt == 12u) ? q4_word_values_a(wb, index) : q5_word_values_a(wb, index);
          acc_a[r] += weight_half_a(wb) * scale * dot(vec4(q), y);
          mins_a[r] += weight_half_a(wb + 2u) * float(q4_min_a(wb, j)) * ysum;
        } else if (tt == 23u) {
          uint ib = index / 32u;
          float ls = float(iq4xs_scale_a(wb, ib) - 32);
          ivec4 q = iq4xs_word_values_a(wb, index);
          acc_a[r] += weight_half_a(wb) * ls * dot(vec4(q), y);
        } else {
          uint j = index / 16u;
          uint sb = weight_byte_a(wb + 192u + j);
          float scale = float((sb >= 128u) ? int(sb) - 256 : int(sb));
          ivec4 q = q6_word_values_a(wb, index);
          acc_a[r] += weight_half_a(wb + 208u) * scale * dot(vec4(q), y);
        }
        if (tt == 12u || tt == 13u) {
          uint j = index / 32u;
          float scale = float(q4_scale_b(wb, j));
          ivec4 q = (tt == 12u) ? q4_word_values_b(wb, index) : q5_word_values_b(wb, index);
          acc_b[r] += weight_half_b(wb) * scale * dot(vec4(q), y);
          mins_b[r] += weight_half_b(wb + 2u) * float(q4_min_b(wb, j)) * ysum;
        } else if (tt == 23u) {
          uint ib = index / 32u;
          float ls = float(iq4xs_scale_b(wb, ib) - 32);
          ivec4 q = iq4xs_word_values_b(wb, index);
          acc_b[r] += weight_half_b(wb) * ls * dot(vec4(q), y);
        } else {
          uint j = index / 16u;
          uint sb = weight_byte_b(wb + 192u + j);
          float scale = float((sb >= 128u) ? int(sb) - 256 : int(sb));
          ivec4 q = q6_word_values_b(wb, index);
          acc_b[r] += weight_half_b(wb + 208u) * scale * dot(vec4(q), y);
        }
      }
    }
  }
  for (uint r = 0u; r < ROWS_PER_WG; r++) { partial[r * 64u + t] = acc_a[r] - mins_a[r]; partial[512u + r * 64u + t] = acc_b[r] - mins_b[r]; }
  barrier();
  for (uint stride = 32u; stride > 0u; stride >>= 1u) {
    if (t < stride) for (uint r = 0u; r < ROWS_PER_WG; r++) { partial[r * 64u + t] += partial[r * 64u + t + stride]; partial[512u + r * 64u + t] += partial[512u + r * 64u + t + stride]; }
    barrier();
  }
  if (t < nrows && position < params.positions) outp[position * params.rows + row0 + t] = silu(partial[t * 64u]) * partial[512u + t * 64u];
}
