(ns gpu.bench (:export [main]))
;; Serving-shaped probe (root ADR-2609182100 D1: one token = one command
;; buffer): 40 row-dot dispatches over a 64 MiB f32 matrix recorded between
;; BEGIN and SUBMIT, answer = submit->fence nanoseconds for the whole buffer.
;; 40 x 64 MiB = 2.68 GB of weight reads, the order of one Nex token.
(defn gpu [r :string] :string
  (typed-cap-call :gpu/compute :string :string r))

(defn dispatches [n :i64 req :string] :i64
  (if (< n 1) 0 (do (gpu req) (dispatches (- n 1) req))))

(defn main [] :string
  (let [w (gpu "MAP /root/kgpu/w4k.f32 0 67108864")
        x (gpu "MAP /root/kgpu/x4k.f32 0 16384")
        o (gpu "ALLOC 16384")
        m (gpu "ALLOC 16")
        p (gpu "PIPELINE /root/kgpu/dot_rows.spv 4")]
    (do
      (gpu (string-concat "WRITE " (string-concat m " 0 0010000000100000")))
      (let [req (string-concat "DISPATCH " (string-concat p (string-concat " 4096 1 1 " (string-concat m (string-concat " " (string-concat w (string-concat " " (string-concat x (string-concat " " o)))))))))]
        (do
          (gpu "BEGIN")
          (dispatches 40 req)
          (gpu "SUBMIT"))))))
