;; Memory-bandwidth floor of the device (iteration 29): a 1 GiB buffer streamed with vec4
;; loads by 4096 workgroups x 256 threads x 64 vec4 each, 10 dispatches in one command
;; buffer. Answer: "<ns one>|<ns ten>" -> GB/s = 10 GiB / ns_ten.
(ns gpu.mem-probe-u32 (:export [main]))
(defn gpu [r :string] :string
  (typed-cap-call :gpu/compute :string :string r))
(defn dispatches [n :i64 req :string] :i64
  (if (< n 1) 0 (do (gpu req) (dispatches (- n 1) req))))
(defn main [] :string
  (do
    (gpu "ALLOC 16")                    ;; 1 meta
    (gpu "ALLOC 1073741824")            ;; 2 the 1 GiB buffer
    (gpu "ALLOC 16384")                 ;; 3 out (4096 floats)
    (gpu "PIPELINE /root/kgpu/mem_probe_u32.spv 3")
    (gpu "ZERO 2")
    ;; n_u32 = 268435456 (0x10000000), per_thread = 256
    (gpu "WRITE 1 0 00000010000100000000000000000000")
    (let [one (gpu "DISPATCH 1 4096 1 1 1 2 3")]
      (do (gpu "BEGIN") (dispatches 10 "DISPATCH 1 4096 1 1 1 2 3")
          (string-concat one (string-concat "|" (gpu "SUBMIT")))))))
