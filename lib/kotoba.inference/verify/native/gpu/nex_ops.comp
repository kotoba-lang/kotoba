// dense decoders (iteration 59): o[i] = a[i] + bias[i mod rows-stride]: n = total elements (rows x stride), aux = stride
void op_add_bias() {
  uint i = gl_GlobalInvocationID.x; if (i >= P.n) return;
  o[i] = a[i] + b[i - (i / P.aux) * P.aux];
}
void op_f32_matvec() {   // workgroup y = input row (prefill), x = output row
