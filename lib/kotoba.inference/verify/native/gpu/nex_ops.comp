#else
void op_ctl() { if (gl_GlobalInvocationID.x == 0u) { uint n = P.n; if (floatBitsToUint(c[n]) != 0u) ids[0] = 0u; for (uint i = 0u; i < n; i++) b[ids[0] + i] = c[i]; } }
#endif
// params (resident sampling, iteration 50): the sampled-decode message "t,f,T,top_p,seed" -- ctrl words 2..4 become the
// sampler meta's eps / scale / p0 (words 4..6): c = ctrl, o = the sampler's Meta buffer (bit copies, as ctl copies tokens)
