    uint packed = 0u;
    for (uint k = 0u; k < 4u; k++) { int q = int(round(a[b * 32u + w * 4u + k] * inv)); packed |= (uint(q) & 255u) << (8u * k); }
    ids[b * 8u + w] = packed;
  }
}
#ifdef BATCH
void op_pos_incr() { uint r = gl_GlobalInvocationID.x; if (r < P.n) ids[r] += 1u; }   // C-4: every row's position
#else
void op_pos_incr() { if (gl_GlobalInvocationID.x == 0u) ids[0] += 1u; }
#endif   // the position counter, once per token
// ctl (resident serving, iteration 43): one message = "<token id>,<reset flag>" WRITEDEC'd into c (uint bits);
// a set flag rewinds the position to 0 (the kernels read no history at position 0, so nothing else is
// reset), then the token goes to the token buffer at the position: b[pos] = token, as argmax_final writes it.
// iteration 49: P.n tokens (1 in decode) then the flag at c[n]: tokbuf[pos + i] = token i -- the prefill message
#ifdef BATCH
// C-4: the message is B tokens then B flags; row r: flag -> pos[r] = 0, then tokbuf[r * aux (row stride) + pos[r]] = token r
void op_ctl() { uint r = gl_GlobalInvocationID.x; if (r < P.n) { if (floatBitsToUint(c[P.n + r]) != 0u) ids[r] = 0u; b[r * P.aux + ids[r]] = c[r]; } }
#elif defined(BPREFILL)
// iteration 57: the message is P tokens, seq, flag(, pad): flag -> rowpos[seq] = 0; the tokens go to the sequence's token row at its
// base; rowsel (o) = [base, seq] for the prefill kernels
void op_ctl() { if (gl_GlobalInvocationID.x == 0u) { uint n = P.n, r = floatBitsToUint(c[n]); if (floatBitsToUint(c[n + 1u]) != 0u) ids[r] = 0u; uint base = ids[r];
