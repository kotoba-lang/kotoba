void op_params() { uint i = gl_GlobalInvocationID.x, B = P.n; if (i < 3u * B) { uint r = i / 3u, k = i - r * 3u; o[r * 4u + k] = c[2u * B + i]; } }
#else
void op_params() { uint i = gl_GlobalInvocationID.x; if (i < 3u) o[4u + i] = c[2u + i]; }
#endif
#ifdef BPREFILL
void op_pos_add() { if (gl_GlobalInvocationID.x == 0u) ids[floatBitsToUint(a[1])] += P.n; }   // iteration 57: rowpos[seq] += P (a = rowsel [base, seq])
void op_pos_seed() { if (gl_GlobalInvocationID.x == 0u) { ids[0] = floatBitsToUint(a[0]); ids[1] = 0u; ids[2] = floatBitsToUint(a[1]); } }   // stepbuf = [base, row 0, seq]
#else
void op_pos_add() { if (gl_GlobalInvocationID.x == 0u) ids[0] += P.n; }   // prefill in fn mode (iteration 47): the position advances by the batch
void op_pos_seed() { if (gl_GlobalInvocationID.x == 0u) { ids[0] = floatBitsToUint(a[0]); ids[1] = 0u; } }   // a layer's stepbuf = [the step's base position, row 0] before its P delta-net steps
#endif
void op_pos_incr2() { if (gl_GlobalInvocationID.x == 0u) { ids[0] += 1u; ids[1] += 1u; } }   // prefill: absolute position and batch row together
void op_add() {
  uint i = gl_GlobalInvocationID.x; if (i >= P.n) return;
  o[i] = a[i] + b[i];
