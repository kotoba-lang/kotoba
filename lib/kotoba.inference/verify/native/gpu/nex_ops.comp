// int8 activation for the dp4a kdot (iteration 31): per 32-value block, scale =
// max|x| / 127, q = round(x / scale) as int8, four to a word; thread = block.
// a: x (n values, rows of any width -- blocks never straddle a row since widths
// are multiples of 32); o: scales[n/32]; ids: packed int8 words[n/4].
void op_quant_q8() {
  uint b = gl_GlobalInvocationID.x, nb = P.n / 32u; if (b >= nb) return;
  float m = 0.0;
  for (uint i = 0u; i < 32u; i++) m = max(m, abs(a[b * 32u + i]));
  float sc = m / 127.0, inv = (sc > 0.0) ? 1.0 / sc : 0.0;
  o[b] = sc;
