    uint pick = 0u; for (uint i = n; i > 0u; i--) { if (s[LB + i - 1u] >= tau) { pick = i - 1u; break; } }
    ids[IB + P.aux] = pick;
#ifndef BATCH
    if (P.p1 != 0.0 && pos + 1u >= P.aux2) b[pos + 1u] = uintBitsToFloat(pick);
#endif
