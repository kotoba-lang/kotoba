#version 450
// out[row] = sum_k w[row*cols + k] * x[k]  -- one workgroup per row, 256
// threads stride over the row, tree reduction in shared memory. The first
// :gpu/compute kernel (root ADR-2609182400 C): the shape of every matvec,
// f32 weights so the answer has an exact CPU twin.
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer Meta { uint rows; uint cols; } meta;
layout(std430, binding = 1) readonly buffer W { float w[]; };
layout(std430, binding = 2) readonly buffer X { float x[]; };
layout(std430, binding = 3) writeonly buffer O { float o[]; };
shared float partial[256];
void main() {
  uint row = gl_WorkGroupID.x;
  uint t = gl_LocalInvocationID.x;
  if (row >= meta.rows) return;
  float acc = 0.0;
  for (uint k = t; k < meta.cols; k += 256u) acc += w[row * meta.cols + k] * x[k];
  partial[t] = acc;
  barrier();
  for (uint s = 128u; s > 0u; s >>= 1u) {
    if (t < s) partial[t] += partial[t + s];
    barrier();
  }
  if (t == 0u) o[row] = partial[0];
}
