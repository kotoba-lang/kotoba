;; Byte-level BPE tokenizer from a GGUF's own metadata (iteration 40): the CLI over tokenizer_core.cljk.
;;   kbb --backend sci gguf_tokenizer.cljk <file.gguf or head dump> encode "<text>"     -> ids, one line, comma separated
;;   kbb --backend sci gguf_tokenizer.cljk <file.gguf or head dump> decode 760,6511,...  -> the text
;;   kbb --backend sci gguf_tokenizer.cljk <file.gguf or head dump> meta                   -> pre / bos / eos / add_bos / chat_template (iteration 58)
(require '["path" :as path] '[clojure.string :as str])
(def args (vec *command-line-args*))
(when (< (count args) 2) (println "usage: <gguf> encode <text> | decode <ids> | meta") (js/process.exit 2))
(when (and (not= "meta" (args 1)) (< (count args) 3)) (println "usage: <gguf> encode <text> | decode <ids> | meta") (js/process.exit 2))
(require '[nbb.core :refer [load-file]])
(load-file (path/join (path/dirname *file*) "tokenizer_core.cljk"))
(case (args 1)
  "encode" (println (str/join "," (encode (args 2))))
  "decode" (println (decode (mapv js/parseInt (str/split (args 2) #","))))
  "meta" (do (println "model\t" tokenizer-model "\npre\t" (kv "tokenizer.ggml.pre") "->" pre-name "\nignore_merges\t" ignore-merges?
                      "\nbos_id\t" bos-id (when bos-id (pr-str (tokens bos-id))) "\neos_id\t" eos-id (when eos-id (pr-str (tokens eos-id)))
                      "\nadd_bos\t" add-bos? "\ncontrol_tokens\t" (count control-tokens) "\nchat_template\t" (if chat-template (str (count chat-template) " chars") "(none)"))
             (when chat-template (println "----- tokenizer.chat_template -----") (println chat-template)))
  (do (println "usage: encode <text> | decode <ids> | meta") (js/process.exit 2)))
