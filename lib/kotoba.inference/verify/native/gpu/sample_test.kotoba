;; Device-side sampling test (iterations 18-19): 256 draws from ONE fixed logits
;; vector (the f64 oracle's last-step logits, dumped as f32), the position counter
;; advanced by pos_incr between draws so u = hash(seed, pos) changes and the
;; picks land in tok[1..256]. Temperature 0.8, top-p 0.95, seed 0x1234567 (p0
;; bits). Each draw is the multi-workgroup sampler: sample_part (61 wg) ->
;; sample_probs (61) -> 30 x (bisect_part (61), bisect_step (1)) -> sample_final
;; (1) -> pos_incr, 65 dispatches in its own command buffer (the 2048-dispatch
;; buffer cap). Answer: "<ns of the last draw>|<hex of tok[1..256]>". Checked
;; by sample_check.py.
(ns gpu.sample-test (:export [main]))
(defn gpu [r :string] :string
  (typed-cap-call :gpu/compute :string :string r))
;; handles: 1 zeros, 2 logits, 3 meta-incr, 4 meta-sample, 5 posbuf, 6 tok, 7 ids, 8 scratch o, 9 probs s
;; pipelines: 1 part, 2 probs, 3 bisect_part, 4 bisect_step, 5 final, 6 pos_incr
(defn bisect [i :i64] :i64
  (if (< i 1) 0
    (do (gpu "DISPATCH 3 61 1 1 4 2 6 5 8 9 7")
        (gpu "DISPATCH 4 1 1 1 4 2 6 5 8 9 7")
        (bisect (- i 1)))))
(defn draws [i :i64 last :string] :string
  (if (< i 1) last
    (do (gpu "BEGIN")
        (gpu "DISPATCH 1 61 1 1 4 2 6 5 8 9 7")
        (gpu "DISPATCH 2 61 1 1 4 2 6 5 8 9 7")
        (bisect 30)
        (gpu "DISPATCH 5 1 1 1 4 2 6 5 8 9 7")
        (gpu "DISPATCH 6 1 1 1 3 1 1 1 1 1 5")
        (draws (- i 1) (gpu "SUBMIT")))))
(defn main [] :string
  (do
    (gpu "ALLOC 16")                                   ;; 1 zeros
    (gpu "MAP /root/kgpu/logits_last.f32 0 993280")    ;; 2 logits
    (gpu "ALLOC 32")                                   ;; 3 meta (incr)
    (gpu "ALLOC 32")                                   ;; 4 meta (sample)
    (gpu "ALLOC 16")                                   ;; 5 posbuf
    (gpu "ALLOC 1040")                                 ;; 6 tok (260 slots)
    (gpu "ALLOC 256")                                  ;; 7 ids
    (gpu "ALLOC 1024")                                 ;; 8 scratch o (partials + lo/hi)
    (gpu "ALLOC 993280")                               ;; 9 probs s
    (gpu "PIPELINE /root/kgpu/nex_sample_part.spv 7")
    (gpu "PIPELINE /root/kgpu/nex_sample_probs.spv 7")
    (gpu "PIPELINE /root/kgpu/nex_sample_bisect_part.spv 7")
    (gpu "PIPELINE /root/kgpu/nex_sample_bisect_step.spv 7")
    (gpu "PIPELINE /root/kgpu/nex_sample_final.spv 7")
    (gpu "PIPELINE /root/kgpu/nex_pos_incr.spv 7")
    (gpu "ZERO 1") (gpu "ZERO 5") (gpu "ZERO 6")
    ;; n=248320 rows=0 aux=61 aux2=0 eps=0.8 scale=0.95 p0=seed(0x01234567) p1=1.0
    (gpu "WRITE 4 0 00ca0300000000003d00000000000000cdcc4c3f3333733f674523010000803f")
    (let [ns (draws 256 "0")]
      (string-concat ns (string-concat "|" (gpu "READ 6 4 1024"))))))
