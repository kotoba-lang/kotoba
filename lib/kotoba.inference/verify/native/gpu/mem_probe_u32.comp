#version 450
// Memory-bandwidth floor probe with 4-BYTE loads (iteration 32; the vec4 twin is mem_probe.comp): every thread streams `per_thread` vec4
// (16 B) with a stride of the whole grid, sums them, and one float per workgroup is
// written -- pure loads, no dequant, no reduction tree. Meta: n_vec4, per_thread.
// Dispatch: (n_vec4 / (256 * per_thread), 1, 1).
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer Meta { uint n_vec4; uint per_thread; uint pad0; uint pad1; } P;
layout(std430, binding = 1) readonly buffer A { uint a[]; };   // WIDTH variant: 4-byte loads
layout(std430, binding = 2) buffer O { float o[]; };
shared float red[256];
void main() {
  uint g = gl_GlobalInvocationID.x, stride = gl_NumWorkGroups.x * 256u, t = gl_LocalInvocationID.x;
  uint acc = 0u;
  for (uint k = 0u; k < P.per_thread; k++) { uint i = g + k * stride; if (i < P.n_vec4) acc += a[i]; }
  red[t] = float(acc); barrier();
  for (uint s = 128u; s > 0u; s >>= 1u) { if (t < s) red[t] += red[t + s]; barrier(); }
  if (t == 0u) o[gl_WorkGroupID.x] = red[0];
}
