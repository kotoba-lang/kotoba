;; tokenizer_core.cljk vs llama.cpp's own tokenizer test oracle (iteration 58): llama.cpp ships vocab-only GGUFs with a
;; `<gguf>.inp` (texts separated by "\n__ggml_vocab_test__\n") and `<gguf>.out` (one line of space-separated ids per
;; text, add_special = false, parse_special = false; tests/test-tokenizer-0.cpp). Our encode must equal every line.
;; Exit 0 all equal, 1 otherwise, 2 when the oracle could not be read; prints the count either way.
;;   kbb --backend sci tokenizer_oracle.cljk <llama.cpp>/models/ggml-vocab-llama-bpe.gguf [<oracle base: its .inp / .out, default = the gguf path>]
(require '["fs" :as fs] '["path" :as path] '[clojure.string :as str] '[nbb.core :refer [load-file]])
(def args (vec *command-line-args*))
(when (< (count args) 1) (println "usage: <ggml-vocab-*.gguf> [<oracle base>] (<base>.inp / <base>.out; default beside the gguf)") (js/process.exit 2))
(def gguf (args 0))
(def base (or (get args 1) gguf))
(when-not (and (fs/existsSync (str base ".inp")) (fs/existsSync (str base ".out"))) (println "REFUSE no" (str base ".inp") "/ .out") (js/process.exit 2))
(def sinp (str/split (fs/readFileSync (str base ".inp") "utf8") "\n__ggml_vocab_test__\n"))
(def sout (str/split-lines (fs/readFileSync (str base ".out") "utf8")))
(when (not= (count sinp) (count sout)) (println "REFUSE .inp has" (count sinp) "texts but .out has" (count sout) "lines") (js/process.exit 2))
(when (zero? (count sinp)) (println "REFUSE empty oracle") (js/process.exit 2))
(load-file (path/join (path/dirname *file*) "tokenizer_core.cljk"))   ;; reads gguf from (first *command-line-args*)
(def results (for [[text want] (map vector sinp sout)]
               (let [ours (str/join " " (encode* text false)) theirs (str/trim want)]   ;; parse_special false, as the oracle
                 {:text text :ours ours :theirs theirs :ok (= ours theirs)})))
(doseq [r results :when (not (:ok r))] (println "MISMATCH" (pr-str (:text r)) "\n  ours  " (:ours r) "\n  llama " (:theirs r)))
(let [okn (count (filter :ok results))]
  (println (str "ORACLE\t" pre-name "\t" okn "/" (count results) " texts equal to llama.cpp's .out"))
  (js/process.exit (if (= okn (count results)) 0 1)))
