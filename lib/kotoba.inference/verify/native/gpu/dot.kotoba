(ns gpu.dot (:export [main]))
;; :gpu/compute end to end (root ADR-2609182400 C): the weights and the
;; activations reach the device by PATH (MAP), the row-dot pipeline is a
;; SPIR-V blob by path, one DISPATCH of `rows` workgroups, and the answer is
;; "<nanoseconds>|<hex of the output buffer>" for the host to check against
;; its CPU twin. Every decision here -- which kernel, what shape -- is this
;; program's; the provider only moves bytes and submits.
(defn gpu [r :string] :string
  (typed-cap-call :gpu/compute :string :string r))

(defn main [] :string
  (let [w (gpu "MAP /root/kgpu/w.f32 0 16777216")
        x (gpu "MAP /root/kgpu/x.f32 0 4096")
        o (gpu "ALLOC 16384")
        m (gpu "ALLOC 16")
        p (gpu "PIPELINE /root/kgpu/dot_rows.spv 4")]
    (do
      ;; rows = 4096 (0x1000), cols = 1024 (0x400), little-endian u32 x 2
      (gpu (string-concat "WRITE " (string-concat m " 0 0010000000040000")))
      (let [ns (gpu (string-concat "DISPATCH " (string-concat p (string-concat " 4096 1 1 " (string-concat m (string-concat " " (string-concat w (string-concat " " (string-concat x (string-concat " " o))))))))))]
        (string-concat ns (string-concat "|" (gpu (string-concat "READ " (string-concat o " 0 16384")))))))))
