;; chat_templates.cljk vs llama-server's POST /apply-template (iteration 58), byte for byte, on two message shapes
;; (single user; system + user + assistant + user) plus a whitespace-stress shape. Prints each shape's verdict and
;; "TEMPLATE\t<family>\tn/N shapes equal to llama-server"; exit 0 all equal, 1 otherwise, 2 when the server did not answer.
;;   kbb --backend sci chat_template_check.cljk <gguf> <llama-server base url>
(require '["child_process" :as cp] '["path" :as path] '[clojure.string :as str] '[nbb.core :refer [load-file]])
(def args (vec *command-line-args*))
(when (< (count args) 2) (println "usage: <gguf> <url>") (js/process.exit 2))
(load-file (path/join (path/dirname *file*) "tokenizer_core.cljk"))
(load-file (path/join (path/dirname *file*) "chat_templates.cljk"))
(def shapes
  {"single-user" [{:role "user" :content "The capital of France is?"}]
   "system-user-assistant-user" [{:role "system" :content "You are a terse assistant."} {:role "user" :content "Hi there"}
                                 {:role "assistant" :content "Hello! How can I help?"} {:role "user" :content "Name three primes."}]
   "whitespace-stress" [{:role "user" :content "  padded   content with\n\nnewlines and a trailing space "}]})
(defn theirs [messages]
  (let [r (cp/spawnSync "curl" (clj->js ["-s" "-m" "30" (str (args 1) "/apply-template") "-H" "Content-Type: application/json"
                                          "-d" (js/JSON.stringify (clj->js {:messages messages}))]) (clj->js {:encoding "utf8"}))
        body (try (js/JSON.parse (.-stdout r)) (catch :default _ nil))]
    (when-not (and body (.-prompt body)) (println "REFUSE /apply-template did not answer a prompt:" (pr-str (.-stdout r)) (pr-str (.-stderr r))) (js/process.exit 2))
    (.-prompt body)))
(def results (for [[name messages] shapes] (let [a (render messages true) b (theirs messages)] {:name name :ours a :theirs b :ok (= a b)})))
(doseq [r results] (println (if (:ok r) "EQUAL   " "MISMATCH") (:name r))
  (when-not (:ok r) (println "  ours  " (pr-str (:ours r))) (println "  llama " (pr-str (:theirs r)))))
(let [okn (count (filter :ok results))]
  (println (str "TEMPLATE\t" (name template-family) "\t" okn "/" (count results) " shapes equal to llama-server /apply-template"))
  (js/process.exit (if (= okn (count results)) 0 1)))
