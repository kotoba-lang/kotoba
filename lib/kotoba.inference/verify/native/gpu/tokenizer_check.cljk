;; tokenizer_core.cljk vs llama-server (iteration 40; iteration 58 loads the core in-process instead of spawning the
;; CLI per line, so it runs where there is no `kbb` wrapper): for each line of a corpus, our encode (parse_special true)
;; must equal /tokenize (add_special false) and decode(ids) must round-trip the text. Exit 0 all equal,
;; 1 otherwise; prints the count either way (a corpus that could not be read is an exit 2).
;;   kbb --backend sci tokenizer_check.cljk <gguf> <llama-server base url> <corpus.txt>
(require '["fs" :as fs] '["child_process" :as cp] '["path" :as path] '[clojure.string :as str] '[nbb.core :refer [load-file]])
(def args (vec *command-line-args*))
(when (< (count args) 3) (println "usage: <gguf> <url> <corpus>") (js/process.exit 2))
(def lines (vec (remove str/blank? (str/split-lines (fs/readFileSync (args 2) "utf8")))))
(when (empty? lines) (println "REFUSE empty corpus") (js/process.exit 2))
(load-file (path/join (path/dirname *file*) "tokenizer_core.cljk"))   ;; reads the gguf from (first *command-line-args*)
(defn ours [text] (str/join "," (encode text)))
(defn theirs [text] (let [r (cp/spawnSync "curl" (clj->js ["-s" "-m" "30" (str (args 1) "/tokenize") "-H" "Content-Type: application/json" "-d" (js/JSON.stringify (clj->js {:content text :add_special false}))]) (clj->js {:encoding "utf8"}))]
                      (str/join "," (map str (js->clj (.-tokens (js/JSON.parse (.-stdout r))))))))
(def results (for [l lines] (let [a (ours l) b (theirs l) rt (decode (encode l))] {:text l :ours a :theirs b :ok (and (= a b) (= rt l))})))
(doseq [r results :when (not (:ok r))] (println "MISMATCH" (pr-str (:text r)) "\n  ours  " (:ours r) "\n  llama " (:theirs r)))
(let [okn (count (filter :ok results))] (println (str "TOKENIZER\t" okn "/" (count results) " lines equal to llama-server")) (js/process.exit (if (= okn (count results)) 0 1)))
