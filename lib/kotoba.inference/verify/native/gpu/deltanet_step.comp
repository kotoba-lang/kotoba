#version 450
// Gated delta-net recurrence, ONE decode token, all heads -- the GLSL twin of
// shaders/deltanet_step.wgsl (llama.cpp gated_delta_net semantics; value head h
// uses key head h % k_heads). One workgroup per head, thread j owns column j of
// the [K x V] state. Dispatch (heads, 1, 1). Eight storage bindings.
layout(local_size_x = 128) in;
layout(std430, binding = 0) readonly buffer Meta { uint heads; uint k_dim; uint v_dim; uint k_heads; uint v_off; uint pad0; uint pad1; uint pad2; } P;  // v_off: element offset of the values inside the v buffer (the conv output holds q|k|v)
layout(std430, binding = 1) readonly buffer Q { float q[]; };
layout(std430, binding = 2) readonly buffer K { float k[]; };
layout(std430, binding = 3) readonly buffer Vb { float v[]; };
layout(std430, binding = 4) readonly buffer G { float g[]; };
layout(std430, binding = 5) readonly buffer Bt { float beta[]; };
layout(std430, binding = 6) buffer St { float state[]; };
layout(std430, binding = 7) buffer Ob { float outp[]; };
void main() {
  uint h = gl_WorkGroupID.x, j = gl_LocalInvocationID.x;
  if (h >= P.heads || j >= P.v_dim) return;
  uint K_ = P.k_dim, V_ = P.v_dim, kh = h % P.k_heads, sbase = h * K_ * V_;
  float decay = exp(g[h]), b = beta[h];
  float kv_mem = 0.0;
  for (uint i = 0u; i < K_; i++) { float s_ = state[sbase + i * V_ + j] * decay; state[sbase + i * V_ + j] = s_; kv_mem += s_ * k[kh * K_ + i]; }
  float delta = (v[P.v_off + h * V_ + j] - kv_mem) * b;
  float o = 0.0;
  for (uint i = 0u; i < K_; i++) { float s_ = state[sbase + i * V_ + j] + k[kh * K_ + i] * delta; state[sbase + i * V_ + j] = s_; o += s_ * q[kh * K_ + i]; }
  outp[h * V_ + j] = o;
}
