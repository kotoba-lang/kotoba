;; Wall-clock differencing bench for an amu-native kexe (no JVM, no Deno):
;; runs the loader with the loop count at 1 and at N, takes the minimum of R
;; repetitions of each, and reports (tN - t1)/(N-1) as the per-call time of
;; the fused dequant-dot, plus the effective weight-stream GB/s.
;;
;;   kbb --backend sci native_dq_bench.cljk <loader> <code.bin> <isa> <fmt> <blocks> <times> <reps>
;; fmt: q8_0 (34-byte blocks of 32) | q6_k (210/256) | q4_k (144/256)
(require '["child_process" :as cp] '[clojure.string :as str])
(def args (vec *command-line-args*))
(def loader (args 0)) (def code (args 1)) (def isa (args 2)) (def fmt (args 3)) (def blocks-s (args 4)) (def times-s (args 5)) (def reps-s (args 6)) (def offset (or (get args 7) "0"))
(def blocks (js/parseInt blocks-s)) (def times (js/parseInt times-s)) (def reps (js/parseInt reps-s))
(def geom {"q8_0" [34 32] "q6_k" [210 256] "q4_k" [144 256] "iq4_xs" [136 256]})
(def bb (first (get geom fmt))) (def be (second (get geom fmt)))
(defn hex-of [n f] (apply str (for [i (range n)] (let [v (f i)] (str (.padStart (.toString v 16) 2 "0"))))))
;; weights: pseudo-random bytes but a sane fp16 scale in the first two bytes of each block
(def weights (hex-of (* blocks bb) (fn [i] (let [o (mod i bb)] (cond (= o 0) 0 (= o 1) 0x3c :else (bit-and (* (+ i 7) 2654435761) 255))))))
(def acts (hex-of (* blocks be 4) (fn [i] (case (mod i 4) 0 0 1 0 2 0x80 3 0x3f))))
(defn run! [t]
  (let [spec (bit-or blocks (bit-shift-left t 16))
        t0 (js/process.hrtime.bigint)
        r (cp/spawnSync loader #js [code offset "5" isa "-" (str "g:" weights) "gl:0" (str "g:" acts) "gl:1" (str spec)]
                        #js {:env #js {:KEXE_STRUCTURED_REPORT "1" :KEXE_FUEL "4000000000"} :encoding "utf8"})
        t1 (js/process.hrtime.bigint)]
    (when-not (zero? (.-status r)) (println "REFUSE loader exit" (.-status r) (.-stdout r) (.-stderr r)) (js/process.exit 2))
    (when-not (str/includes? (.-stdout r) ":status :ok") (println "REFUSE" (.-stdout r)) (js/process.exit 2))
    (/ (js/Number (- t1 t0)) 1e6)))
(run! 1)
(def t1 (apply min (repeatedly reps #(run! 1))))
(def tN (apply min (repeatedly reps #(run! times))))
(def per-call-ms (/ (- tN t1) (dec times)))
(def wbytes (* blocks bb)) (def xbytes (* blocks be 4))
(println (pr-str {:isa isa :fmt fmt :blocks blocks :weight-bytes wbytes :act-bytes xbytes :times times :reps reps
                  :process-ms-1 (.toFixed t1 3) :process-ms-N (.toFixed tN 3)
                  :us-per-call (.toFixed (* 1000 per-call-ms) 2)
                  :weight-GBps (.toFixed (/ wbytes (* per-call-ms 1e6)) 2)
                  :weight+act-GBps (.toFixed (/ (+ wbytes xbytes) (* per-call-ms 1e6)) 2)
                  :elements-per-us (.toFixed (/ (* blocks be) (* per-call-ms 1000)) 1)}))
