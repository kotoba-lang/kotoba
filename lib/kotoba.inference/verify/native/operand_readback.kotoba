(ns amu.bench.dq-clobber (:export [after]))
;; Does the fused kernel preserve its count operand? Answers blocks*2^32 + (k & 0xffffffff)
;; where blocks is READ AFTER the kernel ran.
(defn after [wbase :i64 wlen :i64 xbase :i64 xlen :i64 spec :i64]
  (let [blocks (bit-and spec 65535)
        k (kernel-dequant-dot-q8-0 wbase wlen xbase xlen blocks)]
    (+ (* 4294967296 blocks) (bit-and k 4294967295))))
