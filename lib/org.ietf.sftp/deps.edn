{:paths ["src"]
 ;; kotobase (kotoba-lang/kotobase) provides the IStore/ITransactionalStore
 ;; seam (kotobase.store) and the LocalStore oracle (kotobase.local) this
 ;; library projects kotobase.sftp.fs over. Pinned to the same SHA as
 ;; kotoba-lang/kotobase-protocols's own deps.edn (verified current against
 ;; kotobase's default-branch HEAD on 2026-07-17 — same commit, no drift).
 :deps {
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}
        io.github.kotoba-lang/kotobase
        {:git/sha "bbf57df9dde5c1869182012860129a598382e088"}}
 ;; First-class runtime is nbb/cljs (repo-wide runtime priority):
 ;;   kbb --backend sci --classpath "src:test:<kotobase>/src" bin/run_tests.cljk
 ;; The :test alias below is the :clj COMPAT suite for the pure `.cljc`
 ;; core (kotobase.sftp.fs) only — it never loads anything under
 ;; src/kotobase/sftp/transport/ (that's .cljs-only, node:net/node:crypto,
 ;; and cannot be loaded by the JVM at all; see transport/ssh.cljs's
 ;; docstring).
 :aliases
 {:test {:extra-paths ["test"]}}}
