{:paths ["src"]
 ;; genspark 風 super-agent。既存の clj スタックの上の薄いオーケストレーション層 +
 ;; 自前 browser 層。すべて .cljc / 第三者ランタイム依存ゼロ（ADR-2606250956）。
 :deps {
        io.github.kotoba-lang/edn {:local/root "../kotoba.edn"}
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}
        io.github.kotoba-lang/browser-use {:local/root "../kotoba.browserUse"}
        io.github.kotoba-lang/langgraph {:local/root "../kotoba.langgraph"}
        io.github.kotoba-lang/langchain {:local/root "../kotoba.langchain"}}
 :aliases
 {:test {:extra-paths ["test"]}
  ;; local checkouts for workspace development (orgs/kotoba-lang/*)
  :dev {:override-deps {io.github.kotoba-lang/browser-use
                        {:git/url "https://github.com/kotoba-lang/browser-use.git"
                                     :git/sha "67f6ef3c159287c77a3e5e7c3fc8921cb7b4d958"}
                        io.github.kotoba-lang/langgraph
                        {:git/url "https://github.com/kotoba-lang/langgraph.git"
                                     :git/sha "577a59a9d5eb3ef90b81342f4673973f481ff7f4"}
                        io.github.kotoba-lang/langchain
                        {:git/url "https://github.com/kotoba-lang/langchain.git"
                                     :git/sha "51e7b61ec3d55e917d5dc77dac145197cb3340df"}}}}}