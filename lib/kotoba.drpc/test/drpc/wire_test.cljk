(ns drpc.wire-test
  "Every hex literal here was produced by `testdata/gen_vectors.go`, which
  links `storj.io/drpc` and asks `drpcwire.AppendFrame` and `SplitN` what they
  emit.

  That matters more than it looks for a format this small. The control byte
  packs a kind, a done bit and a control bit into eight bits, and a kind
  shifted by the wrong amount still round-trips perfectly through one's own
  codec — it just never interoperates. So there is a vector per kind, and one
  per flag, rather than a round-trip property standing in for both."
  (:require [kotoba.test :refer [deftest is testing]]
            [drpc.wire :as w]))

(defn- unhex [s]
  (mapv #?(:clj  #(Integer/parseInt % 16)
           :cljs #(js/parseInt % 16))
        (re-seq #"[0-9a-fA-F]{2}" s)))

;; ── vectors — generated by testdata/gen_vectors.go, do not hand-edit ────────

(def kind-vectors
  {:invoke          "030101012a"
   :message         "050101012a"
   :error           "070101012a"
   :cancel          "090101012a"
   :close           "0b0101012a"
   :close-send      "0d0101012a"
   :invoke-metadata "0f0101012a"})

(def flags-none    "040101012a")
(def flags-done    "050101012a")
(def flags-control "840101012a")
(def flags-both    "850101012a")

(def big-ids    "05ac02f0a204020102")
(def empty-data "0b050900")

(def invoke-piecestore
  "0301011d2f706965636573746f72652e506965636573746f72652f55706c6f6164")

(def two-frames "030101042f612f4205010203089601")

(def split-3-frames "04070404f0f1f2f304070404f4f5f6f705070402f8f9")
(def split-payload  "f0f1f2f3f4f5f6f7f8f9")

;; ── the control byte ────────────────────────────────────────────────────────

(deftest every-kind-has-its-own-control-byte
  (doseq [[kind hex] kind-vectors]
    (testing (name kind)
      (let [{:keys [frame end]} (w/parse-frame (unhex hex))]
        (is (= kind (:kind frame)))
        (is (= (count (unhex hex)) end))
        (is (= [0x2a] (:data frame))))
      (is (= (unhex hex)
             (w/encode-frame {:kind kind :stream 1 :message 1
                              :done? true :data [0x2a]}))))))

(deftest the-three-flags-are-independent
  (doseq [[hex done? control?] [[flags-none    false false]
                                [flags-done    true  false]
                                [flags-control false true]
                                [flags-both    true  true]]]
    (testing (str "done=" done? " control=" control?)
      (let [{:keys [frame]} (w/parse-frame (unhex hex))]
        (is (= done? (:done? frame)))
        (is (= control? (:control? frame)))
        (is (= :message (:kind frame)) "and the kind is unaffected by either"))
      (is (= (unhex hex)
             (w/encode-frame {:kind :message :stream 1 :message 1
                              :done? done? :control? control? :data [0x2a]}))))))

(deftest reserved-kind-zero-never-appears
  (is (nil? (get w/kinds 0)))
  (is (= [:unknown 0] (:kind (:frame (w/parse-frame [0x00 0x01 0x01 0x00]))))
      "and an unknown kind is reported as such rather than as nil"))

;; ── varints in every position ───────────────────────────────────────────────

(deftest multi-byte-ids
  (let [{:keys [frame]} (w/parse-frame (unhex big-ids))]
    (is (= 300 (:stream frame)))
    (is (= 70000 (:message frame)))
    (is (= [0x01 0x02] (:data frame))))
  (is (= (unhex big-ids)
         (w/encode-frame {:kind :message :stream 300 :message 70000
                          :done? true :data [0x01 0x02]}))))

(def long-data
  ;; 200 bytes, so the length itself needs two varint bytes (c8 01)
  (str "050203c801"
       "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f"
       "202122232425262728292a2b2c2d2e2f303132333435363738393a3b3c3d3e3f"
       "404142434445464748494a4b4c4d4e4f505152535455565758595a5b5c5d5e5f"
       "606162636465666768696a6b6c6d6e6f707172737475767778797a7b7c7d7e7f"
       "808182838485868788898a8b8c8d8e8f909192939495969798999a9b9c9d9e9f"
       "a0a1a2a3a4a5a6a7a8a9aaabacadaeafb0b1b2b3b4b5b6b7b8b9babbbcbdbebf"
       "c0c1c2c3c4c5c6c7"))

(deftest a-length-needing-two-varint-bytes
  (let [{:keys [frame end]} (w/parse-frame (unhex long-data))]
    (is (= 200 (count (:data frame))))
    (is (= (vec (range 200)) (:data frame)))
    (is (= (count (unhex long-data)) end)))
  (is (= (unhex long-data)
         (w/encode-frame {:kind :message :stream 2 :message 3
                          :done? true :data (vec (range 200))}))))

(deftest empty-payload
  (let [{:keys [frame]} (w/parse-frame (unhex empty-data))]
    (is (= :close (:kind frame)))
    (is (= [] (:data frame)))
    (is (:done? frame)))
  (is (= (unhex empty-data)
         (w/encode-frame {:kind :close :stream 5 :message 9 :done? true :data []}))))

(deftest an-invoke-carries-the-rpc-name
  (let [{:keys [frame]} (w/parse-frame (unhex invoke-piecestore))]
    (is (= :invoke (:kind frame)))
    (is (= "/piecestore.Piecestore/Upload"
           (apply str (map char (:data frame)))))))

;; ── incomplete input is not an error ────────────────────────────────────────

(deftest partial-frames-wait-rather-than-fail
  (let [full (unhex invoke-piecestore)]
    (testing "every prefix short of the whole frame parses as `not yet`"
      (doseq [n (range 0 (count full))]
        (is (nil? (w/parse-frame (subvec full 0 n)))
            (str "prefix of length " n))))
    (testing "and the whole thing parses"
      (is (some? (w/parse-frame full)))))

  (testing "a length larger than the bytes held is also `not yet`"
    ;; the reference reader cannot distinguish this from a short read, and
    ;; treating it as malformed would kill a connection whenever a frame
    ;; straddled a TCP segment boundary
    (is (nil? (w/parse-frame [0x05 0x01 0x01 0xff 0x01 0x00])))))

(deftest a-varint-that-cannot-end-is-malformed
  ;; ten continuation bytes with no terminator: not a short read, a liar
  (is (thrown? #?(:clj Exception :cljs js/Error)
               (w/parse-frame (into [0x05] (repeat 12 0x80))))))

;; ── the reader ──────────────────────────────────────────────────────────────

(deftest reads-two-frames-from-one-buffer
  (let [{:keys [packets state]} (w/feed (w/reader) (unhex two-frames))]
    (is (= 2 (count packets)))
    (is (= [:invoke :message] (map :kind packets)))
    (is (= "/a/B" (apply str (map char (:data (first packets))))))
    (is (= [0x08 0x96 0x01] (:data (second packets))))
    (is (empty? (:buffer state)) "and nothing is left over")))

(deftest bytes-may-arrive-in-any-chunking
  ;; a socket does not deliver frame-aligned reads
  (doseq [chunk [1 2 3 5 7 100]]
    (testing (str "in chunks of " chunk)
      (let [bs (unhex two-frames)
            {:keys [packets]}
            (reduce (fn [{:keys [state packets]} part]
                      (let [r (w/feed state part)]
                        {:state (:state r) :packets (into packets (:packets r))}))
                    {:state (w/reader) :packets []}
                    (partition-all chunk bs))]
        (is (= 2 (count packets)))
        (is (= [:invoke :message] (map :kind packets)))))))

(deftest a-packet-split-across-frames-is-reassembled
  (let [{:keys [packets]} (w/feed (w/reader) (unhex split-3-frames))]
    (is (= 1 (count packets)) "three frames, one packet")
    (is (= (unhex split-payload) (:data (first packets))))
    (is (= 7 (:stream (first packets))))
    (is (= 4 (:message (first packets))))
    (is (= :message (:kind (first packets))))))

(deftest split-matches-the-reference-splitter
  (is (= (unhex split-3-frames)
         (w/encode-packet {:kind :message :stream 7 :message 4
                           :data (unhex split-payload)}
                          4)))
  (testing "a negative size does not split"
    (is (= 1 (count (w/split {:kind :message :stream 1 :message 1
                              :data (unhex split-payload)}
                             -1)))))
  (testing "zero means the default"
    (is (= 1 (count (w/split {:kind :message :stream 1 :message 1
                              :data (unhex split-payload)}
                             0)))))
  (testing "only the last frame is done"
    (let [frames (w/split {:kind :message :stream 7 :message 4
                           :data (unhex split-payload)} 4)]
      (is (= [false false true] (map :done? frames))))))

(deftest round-trip-through-split-and-feed
  (doseq [size [1 3 4 10 64]]
    (testing (str "frame size " size)
      (let [payload (vec (range 100))
            bs (w/encode-packet {:kind :message :stream 2 :message 5 :data payload} size)
            {:keys [packets]} (w/feed (w/reader) bs)]
        (is (= 1 (count packets)))
        (is (= payload (:data (first packets))))))))

;; ── what the reader refuses ─────────────────────────────────────────────────

(deftest ids-must-not-go-backwards
  (let [{:keys [state]} (w/feed (w/reader) (unhex two-frames))]
    (is (thrown? #?(:clj Exception :cljs js/Error)
                 (w/feed state (w/encode-frame {:kind :message :stream 1 :message 1
                                                :done? true :data [1]})))
        "message 1 has already been consumed")
    (is (thrown? #?(:clj Exception :cljs js/Error)
                 (w/feed state (w/encode-frame {:kind :message :stream 0 :message 99
                                                :done? true :data [1]})))
        "and a lower stream loses regardless of the message")))

(deftest a-kind-may-not-change-mid-packet
  (let [a (w/encode-frame {:kind :message :stream 1 :message 1 :done? false :data [1]})
        b (w/encode-frame {:kind :invoke  :stream 1 :message 1 :done? true  :data [2]})]
    (is (thrown? #?(:clj Exception :cljs js/Error)
                 (w/feed (w/reader) (into a b))))))

(deftest a-new-id-abandons-an-unfinished-packet
  ;; deliberate in DRPC: this is how an asynchronous interrupt is expressed
  (let [a (w/encode-frame {:kind :message :stream 1 :message 1 :done? false :data [1 2 3]})
        b (w/encode-frame {:kind :message :stream 1 :message 2 :done? true  :data [9]})
        {:keys [packets]} (w/feed (w/reader) (into a b))]
    (is (= 1 (count packets)))
    (is (= [9] (:data (first packets))) "the abandoned bytes are not prepended")))

(deftest control-is-sticky-within-a-packet
  (let [a (w/encode-frame {:kind :message :stream 1 :message 1
                           :done? false :control? true :data [1]})
        b (w/encode-frame {:kind :message :stream 1 :message 1
                           :done? true :control? false :data [2]})
        {:keys [packets]} (w/feed (w/reader) (into a b))]
    (is (:control? (first packets))
        "one control frame makes the whole packet control — a later frame
         cannot clear it")))

(deftest payload-is-bounded
  (let [small (w/reader {:max-buffer-size 8})
        bs (w/encode-packet {:kind :message :stream 1 :message 1
                             :data (vec (range 32))} 4)]
    (is (thrown? #?(:clj Exception :cljs js/Error) (w/feed small bs))
        "a peer that never sets done must not be able to ask for memory")))

(deftest defaults-match-the-reference
  (is (= 65536 w/default-frame-size))
  (is (= (* 4 1024 1024) w/default-max-buffer-size)))
