;; The varint DRPC uses is the same LEB128 protobuf uses, so it comes from
;; kotoba-lang/proto rather than being written a third time. That is the only
;; dependency: framing is bytes in, bytes out.
{:paths ["src"]
 :deps {
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}
        io.github.kotoba-lang/proto {:local/root "../kotoba.proto"}}
 :aliases
 {:test {:extra-paths ["test"]}
  :cljs {:extra-paths ["test"]}

}}
