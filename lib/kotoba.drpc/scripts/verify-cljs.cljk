#!/usr/bin/env kbb
;; Run the suite on the ClojureScript side.
;;
;; Framing is pure arithmetic, which makes it tempting to treat a green JVM run
;; as covering both. It does not: the varint underneath reaches sizes where the
;; two runtimes disagree — a JVM long overflows where a double does not — and
;; that difference has already produced one real bug here (kotoba-lang/proto
;; cd8b83a), found because a DRPC peer can send ten 0x80 bytes.
;;
;;   kbb --backend sci --classpath "$(kbb -A:cljs -Spath)" scripts/verify-cljs.cljk
(ns verify-cljs
  (:require [kotoba.test :as t]
            [drpc.client-test]
            [drpc.server-test]
            [drpc.session-test]
            [drpc.stream-test]
            [drpc.wire-test]))

(defmethod t/report [:cljs.test/default :end-run-tests] [m]
  (println)
  (if (t/successful? m)
    (println "all checks passed on the ClojureScript path")
    (do (println "FAILED on the ClojureScript path")
        (js/process.exit 1))))

(t/run-tests 'drpc.client-test
             'drpc.server-test
             'drpc.session-test
             'drpc.stream-test
             'drpc.wire-test)
