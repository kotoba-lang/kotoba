(ns serve
  "A DRPC server built out of this library, answering one call and exiting.

      kbb -M:serve 19600
      kbb --backend sci --classpath \"$(kbb -A:cljs -Spath)\" scripts/serve.cljk 19600

  It prints `listening <port>` once bound, then answers with
  `<rpc>:<request>` — so a client that gets that back has had its rpc *name*
  routed, not merely its bytes echoed.

  A harness, not part of the library. `drpc.server` never touches a socket,
  and the socket handling here is the only reason this file exists."
  (:require [kotoba.lang.text :as str]
            [drpc.client :as c]
            [drpc.server :as srv]
            #?(:cljs ["node:net" :as net]))
  #?(:clj (:import (java.net InetAddress ServerSocket))))

(defn- answer
  "What this server replies with.

  `Collect` is the Upload shape: many messages in, one answer out, reported as
  `count/bytes` so a client that sent three chunks learns whether all three
  arrived. `error` in the name asks for a refusal, so that path is reachable
  from a test. Anything else is echoed with its rpc name in front."
  [{:keys [stream rpc request requests]}]
  (println (str "rpc " rpc " (" (count (or requests [request])) " messages)"))
  (cond
    (str/includes? rpc "error")
    (srv/respond-error stream 17 (str "no such rpc: " rpc))

    (str/includes? rpc "Collect")
    (srv/respond stream (c/ascii-bytes
                         (str (count requests) "/"
                              (reduce + 0 (map count requests)))))

    :else
    (srv/respond stream (into (c/ascii-bytes (str rpc ":")) request))))

(defn run [[port-s]]
  (let [port #?(:clj (parse-long (or port-s "0")) :cljs (js/parseInt (or port-s "0") 10))]
    #?(:clj
       (let [server (ServerSocket. port 1 (InetAddress/getByName "127.0.0.1"))]
         (println (str "listening " (.getLocalPort server)))
         (flush)
         (with-open [sock (.accept server)]
           (let [in (.getInputStream sock)
                 out (.getOutputStream sock)]
             (loop [state (srv/incoming)]
               (let [buf (byte-array 8192)
                     n (.read in buf)]
                 (if (neg? n)
                   (println "FAIL client hung up before asking anything")
                   (let [{:keys [state calls]} (srv/feed state (take n (seq buf)))]
                     (if (seq calls)
                       (do (doseq [call calls]
                             (.write out (byte-array (map unchecked-byte (answer call))))
                             (.flush out))
                           ;; give the client time to read before the socket dies
                           (Thread/sleep 200))
                       (recur state))))))))
         (.close server)
         (System/exit 0))

       :cljs
       (let [state (atom (srv/incoming))
             server (.createServer
                     net (fn [sock]
                           (.on sock "data"
                                (fn [chunk]
                                  (let [fed (srv/feed @state chunk)]
                                    (reset! state (:state fed))
                                    (doseq [call (:calls fed)]
                                      (.write sock (js/Uint8Array.from
                                                    (into-array (answer call))))
                                      (.end sock)
                                      (js/setTimeout #(js/process.exit 0) 200)))))))]
         (.listen server port "127.0.0.1"
                  #(println (str "listening " (.-port (.address server)))))))))

#?(:clj (defn -main [& args] (run args)))
#?(:cljs (run (vec *command-line-args*)))
