(ns woff.woff2-fixtures
  "The repo's WOFF 1.0 test font, and the same font compressed by the reference
   `woff2_compress`, recorded as base64 so the portable suite can decode a real
   WOFF2 file on a runtime with no filesystem and no shell.

   Regenerate with the reference encoder if the fixture font changes; do not
   hand-edit. Broader fixtures — system fonts, CFF flavours, composite glyphs —
   are generated on the fly by `woff.woff2-oracle-test`.")

;; noto-lycian.ttf, 4556 bytes: the original font.
(def original-ttf
  "")

;; The same font through `woff2_compress`, 2200 bytes.
(def woff2
  "")
