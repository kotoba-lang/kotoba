(ns woff.woff2-data-test (:export [main]) (:require [woff.woff2-data :as p]))

(defn- str-at [t :document i :i64] :string
  (option-or (document-string-value (option-or (document-vector-at t i) (document-null))) "?"))

(defn- row-at [t :document r :i64] :document
  (option-or (document-vector-at t r) (document-null)))

(defn- cell [row :document i :i64] :i64
  (option-or (document-i64-value (option-or (document-vector-at row i) (document-null))) -99))

;; The generator's invariant, restated: the bit widths are the spec's values,
;; the total bits are a whole number of bytes (byteCount = 1 + total / 8 with
;; total in 8..32), and the signs are -1, 0 or +1 (0 for one-sided rows).
(defn- row-ok? [row :document] :bool
  (let [xb (cell row 0)
        yb (cell row 1)
        xs (cell row 4)
        ys (cell row 5)
        total (+ xb yb)]
    (if (or (= xb 0) (= xb 4) (= xb 8) (= xb 12) (= xb 16))
      (if (or (= yb 0) (= yb 4) (= yb 8) (= yb 12) (= yb 16))
        (if (or (= total 8) (= total 16) (= total 24) (= total 32))
          (if (or (= xs -1) (= xs 0) (= xs 1))
            (or (= ys -1) (= ys 0) (= ys 1))
            false)
          false)
        false)
      false)))

(defn- bad-rows [t :document] :i64
  (let [n (document-count t)]
    (loop [r 0 bad 0]
      (if (>= r n)
        bad
        (recur (+ r 1) (+ bad (if (row-ok? (row-at t r)) 0 1)))))))

(defn- tags-case [] :i64
  (let [t (p/known-tags)]
    (+ (if (= (document-count t) 63) 0 1)
       (if (string=? (str-at t 0) "cmap") 0 1)
       (if (string=? (str-at t 10) "glyf") 0 1)
       (if (string=? (str-at t 62) "Sill") 0 1))))

(defn- triplets-case [] :i64
  (let [t (p/triplets)]
    (+ (if (= (document-count t) 128) 0 1)
       (bad-rows t)
       (if (string=? (document-edn-print (row-at t 0)) "[0 8 0 0 0 -1]") 0 1)
       (if (string=? (document-edn-print (row-at t 127)) "[16 16 0 0 1 1]") 0 1))))

(defn main [] :i64
  (+ (tags-case) (triplets-case)))
