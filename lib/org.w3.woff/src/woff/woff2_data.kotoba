;; Port of woff.woff2-data (woff2_data.cljk), Kotoba-native, static tables.
;;
;; The source file is GENERATED by tools/extract_woff2_tables.cljk from the WOFF2
;; specification. That generator is cljk and is not ported; this file is a
;; hand port of its output, so the generator's own checks (63 tags; 128 rows;
;; byteCount = 1 + (xBits + yBits) / 8) are restated in the test instead.
;; Regenerate the source, then re-port, rather than editing this file alone.
;;
;; Named divergences from woff2_data.cljk:
;;   - the two tables are zero-arg functions (cross-module constants are not
;;     exportable in amu). known-tags is a :document vector of 63 strings;
;;     triplets is a :document vector of 128 rows of 6 i64, in source order.
;;   - each table is read with document-edn-read from the same EDN text as the
;;     source literal. A document-vector literal with more than about 32
;;     arguments traps in amu's runtime, so the literal form is not used.

(ns woff.woff2-data
  (:export [known-tags triplets]))

(defn known-tags [] :document
  (document-edn-read "[\"cmap\" \"head\" \"hhea\" \"hmtx\" \"maxp\" \"name\" \"OS/2\" \"post\" \"cvt \" \"fpgm\" \"glyf\" \"loca\" \"prep\" \"CFF \" \"VORG\" \"EBDT\" \"EBLC\" \"gasp\" \"hdmx\" \"kern\" \"LTSH\" \"PCLT\" \"VDMX\" \"vhea\" \"vmtx\" \"BASE\" \"GDEF\" \"GPOS\" \"GSUB\" \"EBSC\" \"JSTF\" \"MATH\" \"CBDT\" \"CBLC\" \"COLR\" \"CPAL\" \"SVG \" \"sbix\" \"acnt\" \"avar\" \"bdat\" \"bloc\" \"bsln\" \"cvar\" \"fdsc\" \"feat\" \"fmtx\" \"fvar\" \"gvar\" \"hsty\" \"just\" \"lcar\" \"mort\" \"morx\" \"opbd\" \"prop\" \"trak\" \"Zapf\" \"Silf\" \"Glat\" \"Gloc\" \"Feat\" \"Sill\"]"))

