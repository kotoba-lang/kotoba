;; vmm.oracle-gen — regenerate the precompiled KIR artifacts.
;;
;;   kbb -M:gen
;;
;; Discovers every kotoba/*_core.kotoba and writes
;; resources/vmm/oracle/<name>.kir.edn through the same compile path the
;; freshness gate uses, so "regenerated" and "checked" cannot diverge.

(ns vmm.oracle-gen
  (:require [kotoba.io :as io]
            [kotoba.pprint :as pp]
            [kotoba.lang.text :as str]
            [kotoba.compiler.core :as compiler])
  (:gen-class))

(def target :wasm32-kotoba-v1)

(defn artifacts []
  (->> (io/file-seq (io/file "kotoba"))
       (filter #(and (io/file? %) (str/ends-with? (io/file-name %) "_core.kotoba")))
       (sort-by #(io/file-name %))
       (mapv (fn [f]
               {:source (io/path f)
                :out (str "lib/kotoba.vmm/resources/vmm/oracle/"
                          (str/replace (io/file-name f) #"\.kotoba$" "")
                          ".kir.edn")}))))

(defn- de-bigint
  "Widen every JS BigInt in a KIR document to a host number.

  The compiler's :i64 literals are BigInts on the nbb engine (measured
  2026-10-19), and `kotoba.pprint` renders a BigInt as `#object[BigInt n]` --
  an EDN dispatch form the shipped artifact's own reader refuses. The
  artifact is EDN, so the value it carries must be a plain literal, and the
  freshness gate compares the compiled document against the read-back one:
  both sides have to be normalised the same way or BigInt != Number makes
  every gate red while the bytes are fine."
  [x]
  #?(:clj x
     :cljs (cond
             ;; `(instance? js/BigInt x)` is FALSE for a real BigInt on this
             ;; engine (measured 2026-10-19); constructor identity is what
             ;; actually detects one.
             (and (some? x) (identical? (.-constructor x) js/BigInt))
             (js/Number x)
             (vector? x) (mapv de-bigint x)
             (map? x) (into {} (map (fn [[k v]] [k (de-bigint v)]) x))
             (set? x) (into #{} (map de-bigint x))
             (seq? x) (doall (map de-bigint x))
             :else x)))

(defn compile-kir [source-path]
  (let [r (compiler/compile-source (slurp source-path) target {})]
    (de-bigint
     (or (:kir r)
         (throw (ex-info "compile-source returned no :kir"
                         {:source source-path :keys (keys r)}))))))

(defn render [kir]
  (with-out-str (pp/pprint kir)))

(defn write-artifact! [{:keys [source out]}]
  (let [f (io/file out)]
    (io/make-parents f)
    (spit f (render (compile-kir source)))
    out))

(defn -main [& _]
  (doseq [a (artifacts)]
    (println "wrote" (write-artifact! a)))
  (System/exit 0))
