  {:name admit-image,
   :params [magic image-size flags],
   :result [:result :i64 :string],
   :effects #{},
   :body
   (if
    (if (= magic (image-magic)) false true)
    (result-err-of [:result :i64 :string] "arm64-boot/bad-magic")
    (if
     (= (bit-and flags 1) 1)
     (result-err-of [:result :i64 :string] "arm64-boot/big-endian")
     (if
      (= image-size 0)
      (result-err-of
       [:result :i64 :string]
       "arm64-boot/unknown-image-size")
      (result-ok-of [:result :i64 :string] image-size)))),
   :param-types [:i64 :i64 :i64]}
  {:name admit-kernel,
   :params [ram-base ram-size text-offset image-size],
   :result [:result :i64 :string],
   :effects #{},
   :body
   (if
    (< ram-size 1)
    (result-err-of [:result :i64 :string] "arm64-boot/empty-ram")
    (if
     (>
      (kernel-end ram-base text-offset image-size)
      (ram-end ram-base ram-size))
     (result-err-of
      [:result :i64 :string]
      "arm64-boot/kernel-overflows-ram")
     (result-ok-of
      [:result :i64 :string]
      (pc-value ram-base text-offset)))),
   :param-types [:i64 :i64 :i64 :i64]}
  {:name admit-dtb,
   :params [ram-base ram-size text-offset image-size dtb-size],
   :result [:result :i64 :string],
   :effects #{},
   :body
   (if
    (> dtb-size (max-dtb-bytes))
    (result-err-of [:result :i64 :string] "arm64-boot/dtb-too-large")
    (if
     (>
      (dtb-end ram-base text-offset image-size dtb-size)
      (ram-end ram-base ram-size))
     (result-err-of
      [:result :i64 :string]
      "arm64-boot/dtb-overflows-ram")
     (if
      (>=
       (-
        (dtb-gpa ram-base text-offset image-size)
        (kernel-base ram-base))
       (mib-512))
      (result-err-of
       [:result :i64 :string]
       "arm64-boot/dtb-out-of-kernel-window")
      (result-ok-of
       [:result :i64 :string]
       (dtb-gpa ram-base text-offset image-size))))),
   :param-types [:i64 :i64 :i64 :i64 :i64]}
  {:name admit-initrd,
   :params [gpa size ram-limit],
   :result [:result :i64 :string],
   :effects #{},
   :body
   (if
    (> (+ gpa size) ram-limit)
    (result-err-of
     [:result :i64 :string]
     "arm64-boot/initrd-overflows-ram")
    (result-ok-of [:result :i64 :string] (+ gpa size))),
   :param-types [:i64 :i64 :i64]}],
