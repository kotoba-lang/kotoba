    (result-ok-of [:result :i64 :string] bootargs-bytes)),
   :param-types [:i64]}
  {:name admit-virtio-names,
   :params [first-addr last-addr virtio-count],
   :result [:result :i64 :string],
   :effects #{},
   :body
   (if
    (< virtio-count 0)
    (result-err-of [:result :i64 :string] "fdt/virtio-count-negative")
    (if
     (= virtio-count 0)
     (result-ok-of [:result :i64 :string] 0)
     (if
      (if
       (= (hex-digits first-addr) (hex-digits last-addr))
       false
       true)
      (result-err-of
       [:result :i64 :string]
       "fdt/virtio-name-width-varies")
      (if
       (= (hex-digits first-addr) 0)
       (result-err-of
        [:result :i64 :string]
        "fdt/virtio-address-too-wide")
       (result-ok-of
        [:result :i64 :string]
        (hex-digits first-addr)))))),
   :param-types [:i64 :i64 :i64]}
  {:name admit-ram-name,
