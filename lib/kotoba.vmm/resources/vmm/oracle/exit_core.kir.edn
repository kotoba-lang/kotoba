  {:name access-size-ok?,
   :params [len],
   :result :bool,
   :effects #{},
   :body
   (if
    (= len 1)
    true
    (if (= len 2) true (if (= len 4) true (if (= len 8) true false)))),
   :param-types [:i64]}
  {:name in-uart?,
   :params [gpa],
   :result :bool,
   :effects #{},
   :body
   (if (< gpa (uart-base)) false (< gpa (+ (uart-base) (uart-size)))),
   :param-types [:i64]}
  {:name in-virtio?,
   :params [gpa],
   :result :bool,
   :effects #{},
   :body
   (if
    (< gpa (virtio-base))
    false
    (< gpa (+ (virtio-base) (virtio-window)))),
   :param-types [:i64]}
  {:name virtio-offset,
   :params [gpa],
   :result :i64,
   :effects #{},
   :body
   (let
    [d (- gpa (virtio-base))]
    (- d (* (quot d (virtio-stride)) (virtio-stride)))),
   :param-types [:i64]}
  {:name classify,
   :params [gpa len],
   :result [:result :i64 :string],
   :effects #{},
   :body
   (if
    (if (access-size-ok? len) false true)
    (result-err-of [:result :i64 :string] "mmio/bad-access-size")
    (if
     (in-uart? gpa)
     (if
      (> (+ (- gpa (uart-base)) len) (uart-size))
      (result-err-of [:result :i64 :string] "mmio/straddles-window")
      (result-ok-of [:result :i64 :string] (device-uart)))
     (if
      (in-virtio? gpa)
      (if
       (> (+ (virtio-offset gpa) len) (virtio-stride))
       (result-err-of [:result :i64 :string] "mmio/straddles-window")
       (result-ok-of [:result :i64 :string] (device-virtio)))
      (result-err-of [:result :i64 :string] "mmio/unmapped")))),
   :param-types [:i64 :i64]}
  {:name device-offset,
   :params [gpa len],
   :result [:result :i64 :string],
   :effects #{},
   :body
   (if
    (if (access-size-ok? len) false true)
    (result-err-of [:result :i64 :string] "mmio/bad-access-size")
    (if
     (in-uart? gpa)
     (result-ok-of [:result :i64 :string] (- gpa (uart-base)))
     (if
      (in-virtio? gpa)
      (result-ok-of [:result :i64 :string] (virtio-offset gpa))
      (result-err-of [:result :i64 :string] "mmio/unmapped")))),
   :param-types [:i64 :i64]}
  {:name virtio-index,
   :params [gpa],
   :result [:result :i64 :string],
   :effects #{},
   :body
   (if
    (in-virtio? gpa)
    (result-ok-of
     [:result :i64 :string]
     (quot (- gpa (virtio-base)) (virtio-stride)))
    (result-err-of [:result :i64 :string] "mmio/not-virtio")),
   :param-types [:i64]}
  {:name psci-action,
   :params [fid],
   :result [:result :i64 :string],
   :effects #{},
   :body
   (if
    (= fid (psci-system-off-fid))
    (result-ok-of [:result :i64 :string] (action-system-off))
    (if
     (= fid (psci-system-reset-fid))
     (result-ok-of [:result :i64 :string] (action-system-reset))
     (if
      (= fid (psci-version-fid))
      (result-ok-of [:result :i64 :string] (action-version))
      (if
       (= fid (psci-cpu-on-32-fid))
       (result-ok-of [:result :i64 :string] (action-cpu-on))
       (if
        (= fid (psci-cpu-on-64-fid))
        (result-ok-of [:result :i64 :string] (action-cpu-on))
        (result-err-of
         [:result :i64 :string]
         "psci/not-supported")))))),
   :param-types [:i64]}],
