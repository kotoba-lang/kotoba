  {:name psc-err-name,
   :params [err],
   :result [:result :i64 :string],
   :effects #{},
   :body
   (if
    (= err 0)
    (result-ok-of [:result :i64 :string] 0)
    (if
     (= err 1)
     (result-err-of [:result :i64 :string] "snp/psc-not-host")
     (if
      (= err 2)
      (result-err-of [:result :i64 :string] "snp/psc-not-page-aligned")
      (if
       (= err 3)
       (result-err-of [:result :i64 :string] "snp/psc-not-in-closure")
       (if
        (= err 4)
        (result-err-of [:result :i64 :string] "snp/psc-not-private")
        (if
         (= err 5)
         (result-err-of [:result :i64 :string] "snp/psc-not-shared")
         (if
          (= err 6)
          (result-err-of
           [:result :i64 :string]
           "snp/psc-page-owned-by-others")
          (if
           (= err 7)
           (result-err-of
            [:result :i64 :string]
            "snp/psc-page-not-owned")
           (if
            (= err 8)
            (result-err-of
             [:result :i64 :string]
             "snp/psc-page-not-guest")
            (if
             (= err 16)
             (result-err-of
              [:result :i64 :string]
              "snp/psc-not-guest-encrypted")
             (result-err-of
              [:result :i64 :string]
              "snp/psc-unknown-code"))))))))))),
   :param-types [:i64]}
