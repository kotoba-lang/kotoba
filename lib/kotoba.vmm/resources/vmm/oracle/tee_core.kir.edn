   :param-types [:i64]}
  {:name portio-verdict,
   :params [port len],
   :result [:result :i64 :string],
   :effects #{},
   :body
   (if
    (if
     (let
      [__kotoba_or_3 (= len 1)]
      (if
       __kotoba_or_3
       __kotoba_or_3
       (let
        [__kotoba_or_2 (= len 2)]
        (if __kotoba_or_2 __kotoba_or_2 (= len 4)))))
     false
     true)
    (result-err-of [:result :i64 :string] "portio/bad-width")
    (if
     (let
      [__kotoba_and_2 (>= port 1013)]
      (if __kotoba_and_2 (<= port 1015) __kotoba_and_2))
     (result-err-of [:result :i64 :string] "portio/unmodeled-device")
     (if
      (let
       [__kotoba_and_2 (>= port 1016)]
       (if __kotoba_and_2 (<= port 1023) __kotoba_and_2))
      (result-ok-of [:result :i64 :string] 1)
      (if
       (let
        [__kotoba_and_2 (>= port 20480)]
        (if __kotoba_and_2 (< port (+ 20480 4096)) __kotoba_and_2))
       (result-ok-of [:result :i64 :string] 2)
       (result-err-of
        [:result :i64 :string]
        "portio/unmodeled-device"))))),
   :param-types [:i64 :i64]}
  {:name admit-tdx-guest,
   :params [kvm-tdx-ok tdvf-present cpu-leaf-21 adapter-bit],
   :result [:result :i64 :string],
   :effects #{},
   :body
   (if
    (if (= kvm-tdx-ok 1) false true)
    (result-err-of
     [:result :i64 :string]
     "tdx/kvm-capabilities-absent")
    (if
     (if (= tdvf-present 1) false true)
     (result-err-of [:result :i64 :string] "tdx/tdvf-image-absent")
     (if
      (if (= cpu-leaf-21 1) false true)
      (result-err-of
       [:result :i64 :string]
       "tdx/cpuid-leaf-21-not-virtualised")
      (if
       (if (= adapter-bit 1) false true)
       (result-err-of
        [:result :i64 :string]
        "tdx/cpuid-indirect-adapter-absent")
       (result-ok-of
        [:result :i64 :string]
        (+ (tdx-admit) (tdx-tdvf-bit))))))),
   :param-types [:i64 :i64 :i64 :i64]}
  {:name snp-policy-bounds,
   :params [policy],
   :result :i64,
   :effects #{},
   :body
   (let
    [known
     (snp-policy-known-mask)
     required-one
     (snp-policy-reserved-one-bit)]
    (if
     (= policy (bit-and policy known))
     (if (= (bit-and policy required-one) required-one) 1 0)
     0)),
   :param-types [:i64]}
  {:name admit-snp-guest,
   :params [kvm-snp-ok ovmf-present cpu-sev-bit snp-bit policy],
   :result [:result :i64 :string],
   :effects #{},
   :body
   (if
    (if (= kvm-snp-ok 1) false true)
    (result-err-of
     [:result :i64 :string]
     "snp/kvm-capabilities-absent")
    (if
     (if (= ovmf-present 1) false true)
     (result-err-of [:result :i64 :string] "snp/ovmf-amdsev-absent")
     (if
      (if (= cpu-sev-bit 1) false true)
      (result-err-of
       [:result :i64 :string]
       "snp/cpuid-sev-bit-not-virtualised")
      (if
       (if (= snp-bit 1) false true)
       (result-err-of
        [:result :i64 :string]
        "snp/cpuid-snp-bit-not-virtualised")
       (if
        (if (= (snp-policy-bounds policy) 1) false true)
        (result-err-of
         [:result :i64 :string]
         "snp/policy-bits-outside-mask")
        (result-ok-of
         [:result :i64 :string]
         (+ (snp-admit) (snp-fw-bit)))))))),
   :param-types [:i64 :i64 :i64 :i64 :i64]}
  {:name launch-variant,
   :params [profile],
   :result [:result :i64 :string],
   :effects #{},
   :body
   (if
    (= profile 1)
    (result-ok-of [:result :i64 :string] 1)
    (if
     (= profile 2)
     (result-ok-of [:result :i64 :string] 2)
     (result-err-of [:result :i64 :string] "launch/unknown-variant"))),
   :param-types [:i64]}
  {:name snp-get-report-req,
   :params [declared-size],
   :result [:result :i64 :string],
   :effects #{},
   :body
   (if
    (< declared-size (snp-report-min-bytes))
    (result-err-of
     [:result :i64 :string]
     "snp/report-size-below-minimum")
    (result-ok-of [:result :i64 :string] declared-size)),
   :param-types [:i64]}],
