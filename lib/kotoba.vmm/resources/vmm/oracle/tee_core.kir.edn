   :effects #{},
   :body
   (if
    (= (page-aligned? gpa) 0)
    (result-err-of [:result :i64 :string] "tdvmcall/map-gpa-unaligned")
    (result-ok-of [:result :i64 :string] (tdx-tdvmcall-vgpi gpa))),
   :param-types [:i64]}
  {:name tdx-tdvmcall-map-gpa,
   :params [gpa size],
   :result [:result :i64 :string],
   :effects #{},
   :body
   (if
    (= (page-aligned? gpa) 0)
    (result-err-of [:result :i64 :string] "tdvmcall/map-gpa-unaligned")
    (if
     (= (page-aligned? size) 0)
     (result-err-of
      [:result :i64 :string]
      "tdvmcall/map-gpa-size-unaligned")
     (if
      (<= size 0)
      (result-err-of [:result :i64 :string] "tdvmcall/map-gpa-empty")
      (if
       (> (bit-and gpa 281474976710656) 0)
       (result-ok-of [:result :i64 :string] 2)
       (result-ok-of [:result :i64 :string] 1))))),
   :param-types [:i64 :i64]}
  {:name snp-psc-op,
