;; vmm — decision cores for a virtual machine monitor.
;;
;; The runtime dependency is the KIR interpreter, not the compiler: what ships
;; is the precompiled `resources/vmm/oracle/*.kir.edn`, and `kotoba.kir`
;; executes it. Amu is :test-only -- it is needed to REGENERATE the artifacts
;; and to prove the shipped ones still match their source, never to run them.
{:paths ["src" "resources"]
 :deps {
        io.github.kotoba-lang/io {:local/root "../kotoba.io"}
        io.github.kotoba-lang/pprint {:local/root "../kotoba.pprint"}
        io.github.kotoba-lang/edn {:local/root "../kotoba.edn"}
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}
        io.github.kotoba-lang/osaho
        {:git/url "https://github.com/kotoba-lang/osaho.git"
         :git/sha "502b5bac814ee4b9aec003d2520d23e0347680b8"}}
 :aliases
 {:test
  {:extra-paths ["test"]
   :extra-deps {
                ;; Hosted in the amu repository; the coordinate keeps its
                ;; historical symbol so tools.deps dedupes it with every other
                ;; consumer in this workspace.
                io.github.kotoba-lang/compiler
                {:git/url "https://github.com/kotoba-lang/amu.git"
                 :git/sha "bea7b9b24a44ebd3d5108e8e356a39c6bed5912d"}}}

  ;; Regenerate resources/vmm/oracle/*.kir.edn from kotoba/*_core.kotoba:
  ;;   kbb -M:gen
  ;; (:gen carries its own :extra-paths/:extra-deps because kbb's test-runner
  ;; substitution intercepts any alias set that names :test -- `kbb -M:test:gen`
  ;; runs the tests, not this generator, measured 2026-10-19.)
  :gen {:extra-paths ["test"]
        :extra-deps {io.github.kotoba-lang/compiler
                     {:git/url "https://github.com/kotoba-lang/amu.git"
                      :git/sha "bea7b9b24a44ebd3d5108e8e356a39c6bed5912d"}}
        :main-opts ["-m" "vmm.oracle-gen"]}}}
