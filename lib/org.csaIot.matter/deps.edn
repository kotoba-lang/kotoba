;; No dependencies. Matter's message frame and TLV codec are packed
;; bitfields and a self-contained tag-length-value encoding — Matter's
;; own specified scope (message header, protocol header, TLV) never
;; touches an IEEE 802.15.4 MAC frame directly (it rides over BLE,
;; Wi-Fi/IP, or Thread transports), so there is no shared-802.15.4-layer
;; dependency to wire here — see README 'The shared 802.15.4 layer'.
{:deps {
        io.github.kotoba-lang/bytes {:local/root "../kotoba.bytes"}
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}}
 :paths ["src"]
 :aliases
 {:test {:extra-paths ["test"]}
  :cljs {:extra-paths ["test"]}}}
