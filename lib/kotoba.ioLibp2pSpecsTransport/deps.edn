{:paths ["src"]
 ;; Zero deps. These are frame codecs and state machines; the socket, the
 ;; crypto (kotoba-lang/noise) and the addresses (multiformats.multiaddr) all
 ;; live outside, which is what makes a three-layer negotiation testable in
 ;; memory.
 :deps {
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}}
 :aliases
 {:test {:extra-paths ["test"]}}}
