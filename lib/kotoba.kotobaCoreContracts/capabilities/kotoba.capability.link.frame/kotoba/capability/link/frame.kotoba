(ns capability.link.frame
  ;; Provider-side helpers for a standard untagged Ethernet frame. Lengths are
  ;; pre-FCS: the NIC appends the four-byte FCS after descriptor publication.
  (:export [tx-wire-length]))

(defn tx-wire-length [frame-length]
  (if (or (< frame-length 14) (> frame-length 1514))
    0
    (if (< frame-length 60) 60 frame-length)))
