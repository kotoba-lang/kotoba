;; Kotoba port of lib/kotoba.kotobaCoreContracts/capabilities/kotoba.capability.link.frame/src/kotoba/capability/link/frame.cljk.
;;
;; Named divergences:
;; - `manifest` is left out. It is repository metadata (definition CIDs,
;; authority, effects), not frame semantics; the same choice is made in the
;; kotoba.capability.mmio.map precedent. It is map-valued and has no kotoba form.
;; - The constants are zero-arg fns (a cross-module def fails E6004).
;; - tx-wire-length returns nil in the .cljk when the length is not a standard
;; untagged Ethernet frame. Here it returns a record with a :valid flag and
;; the :length value, since the kotoba checker has no nilable scalar.
(ns kotoba.capability.link.frame
  (:export [ethernet-header-bytes ethernet-min-frame-bytes ethernet-max-frame-bytes
            tx-wire-length tx-wire-length-valid tx-wire-length-value
            ipv4-datagram-fits?]))

(defn ethernet-header-bytes [] :i64 14)
(defn ethernet-min-frame-bytes [] :i64 60)
(defn ethernet-max-frame-bytes [] :i64 1514)

(defn tx-wire-length [frame-length :i64]
  [:record :kotoba.capability.link.frame/tx-wire-length [[:valid :bool] [:length :i64]]]
  (if (and (<= 14 frame-length) (<= frame-length 1514))
    (record [:record :kotoba.capability.link.frame/tx-wire-length [[:valid :bool] [:length :i64]]]
            true (max 60 frame-length))
    (record [:record :kotoba.capability.link.frame/tx-wire-length [[:valid :bool] [:length :i64]]]
            false 0)))

(defn tx-wire-length-valid [r [:record :kotoba.capability.link.frame/tx-wire-length [[:valid :bool] [:length :i64]]]] :bool
  (record-get [:record :kotoba.capability.link.frame/tx-wire-length [[:valid :bool] [:length :i64]]] r :valid))

(defn tx-wire-length-value [r [:record :kotoba.capability.link.frame/tx-wire-length [[:valid :bool] [:length :i64]]]] :i64
  (record-get [:record :kotoba.capability.link.frame/tx-wire-length [[:valid :bool] [:length :i64]]] r :length))

(defn ipv4-datagram-fits? [frame-length :i64 ipv4-total-length :i64] :bool
  (and (<= 20 ipv4-total-length)
       (<= (+ 14 ipv4-total-length) frame-length)))
