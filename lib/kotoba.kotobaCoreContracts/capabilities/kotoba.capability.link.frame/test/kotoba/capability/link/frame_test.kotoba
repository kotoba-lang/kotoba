(ns kotoba.capability.link.frame-test
  (:export [main])
  (:require [kotoba.capability.link.frame :as f]))

(defn- check [ok :bool] :i64 (if ok 0 1))

(defn main [] :i64
  (+ (check (= (f/ethernet-header-bytes) 14))
     (check (= (f/ethernet-min-frame-bytes) 60))
     (check (= (f/ethernet-max-frame-bytes) 1514))
     (check (f/tx-wire-length-valid (f/tx-wire-length 20)))
     (check (= (f/tx-wire-length-value (f/tx-wire-length 20)) 60))
     (check (= (f/tx-wire-length-value (f/tx-wire-length 100)) 100))
     (check (not (f/tx-wire-length-valid (f/tx-wire-length 13))))
     (check (not (f/tx-wire-length-valid (f/tx-wire-length 1515))))
     (check (f/ipv4-datagram-fits? 34 20))
     (check (not (f/ipv4-datagram-fits? 33 20)))
     (check (not (f/ipv4-datagram-fits? 100 19)))))
