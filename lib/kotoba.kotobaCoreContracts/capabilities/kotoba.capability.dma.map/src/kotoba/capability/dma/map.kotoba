;; Port of kotoba.capability.dma.map (map.cljk), Kotoba-native, :document maps.
;;
;; Named divergences from map.cljk:
;;   - the descriptor-* constants are zero-arg fns (def cannot be exported).
;;   - tx-command / rx-command take the i64 length/capacity; bit-or over more
;;     than two operands is nested bit-or.
;;   - manifest is a :document map; its set-valued fields are built with
;;     document-edn-read from canonical EDN text.
;;   - tx/rx-publication-order are :document vectors of keywords.

(ns kotoba.capability.dma.map
  (:export [manifest descriptor-owned descriptor-end-of-ring descriptor-first-fragment
            descriptor-last-fragment tx-publication-order rx-publication-order
            tx-command rx-command device-owned?]))

(defn manifest [] :document
  (document-map
    :schema (document-string "kotoba.capability.repository.v1")
    :capability/version (document-i64 1)
    :capability/hash-contract-cid (document-string "bafkreiflhj3fslsbh7okdas2fzlhmogai64x6p3lkla6gtr7berbp7ftvi")
    :capability/definition-cid (document-string "bafyreies4n3abl6d5ei6mfmcel3xsn7lcjqzyn43hboqgk54wsccudtf6u")
    :capability/dependencies (document-edn-read "#{}")
    :capability/imports (document-edn-read "#{:dma-map}")
    :authority (document-string "kotoba-lang/kotoba-core-contracts")
    :capability/default-policy (document-keyword :autonomous)
    :capability/artifact (document-map :format (document-keyword :wasm-component)
                                       :digest-required? (document-bool true)
                                       :signature-required? (document-bool true))
    :capability/radicle-rid (document-string "rad:zR1KKTVy51jQ9vHzLw6RoCfYi43K")
    :capability/repository (document-string "kotoba-lang/capability-dma-map")
    :capability/id (document-string "dma/map")
    :capability/effects (document-edn-read "#{:memory-access :device-control}")
    :capability/provider-status (document-keyword :contract-only)))

(defn descriptor-owned [] :i64 2147483648)
(defn descriptor-end-of-ring [] :i64 1073741824)
(defn descriptor-first-fragment [] :i64 536870912)
(defn descriptor-last-fragment [] :i64 268435456)

(defn tx-publication-order [] :document
  (document-vector (document-keyword :write-extension) (document-keyword :write-address)
                   (document-keyword :release-fence) (document-keyword :set-owner)
                   (document-keyword :release-fence) (document-keyword :doorbell)))

(defn rx-publication-order [] :document
  (document-vector (document-keyword :write-extension) (document-keyword :write-address)
                   (document-keyword :release-fence) (document-keyword :set-owner)
                   (document-keyword :release-fence)))

(defn tx-command [length :i64] :i64
  (bit-or (bit-or (bit-or (bit-or (descriptor-owned) (descriptor-end-of-ring))
                       (descriptor-first-fragment))
                (descriptor-last-fragment))
         length))

(defn rx-command [capacity :i64] :i64
  (bit-or (bit-or (descriptor-owned) (descriptor-end-of-ring)) capacity))

(defn device-owned? [command :i64] :bool
  (not (= (bit-and command (descriptor-owned)) 0)))
