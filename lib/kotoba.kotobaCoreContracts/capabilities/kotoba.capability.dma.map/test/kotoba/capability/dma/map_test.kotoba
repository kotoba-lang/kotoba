(ns kotoba.capability.dma.map-test (:export [main]) (:require [kotoba.capability.dma.map :as m]))

(defn- fld [d :document k :keyword] :document
  (option-or (document-get d k) (document-null)))

(defn- same [a :document b :document] :bool
  (string=? (document-edn-print a) (document-edn-print b)))

(defn- at [v :document i :i64] :document
  (option-or (document-vector-at v i) (document-null)))

(defn main [] :i64
  (let [mf (m/manifest)
        tx (m/tx-publication-order)
        rx (m/rx-publication-order)]
    (+ (if (= (m/descriptor-owned) 2147483648) 0 1)
       (if (= (m/descriptor-end-of-ring) 1073741824) 0 1)
       (if (= (m/descriptor-first-fragment) 536870912) 0 1)
       (if (= (m/descriptor-last-fragment) 268435456) 0 1)
       (if (= (m/tx-command 100) 4026531940) 0 1)
       (if (= (m/rx-command 4096) 3221229568) 0 1)
       (if (m/device-owned? (m/tx-command 100)) 0 1)
       (if (m/device-owned? 1073741824) 1 0)
       (if (= (document-count tx) 6) 0 1)
       (if (= (document-count rx) 5) 0 1)
       (if (same (at tx 2) (document-keyword :release-fence)) 0 1)
       (if (same (at rx 4) (document-keyword :release-fence)) 0 1)
       (if (= (document-count mf) 14) 0 1)
       (if (same (fld mf :capability/version) (document-i64 1)) 0 1)
       (if (same (fld mf :capability/default-policy) (document-keyword :autonomous)) 0 1)
       (if (same (fld (fld mf :capability/artifact) :format) (document-keyword :wasm-component)) 0 1)
       (if (document-set-contains? (fld mf :capability/imports) (document-keyword :dma-map)) 0 1)
       (if (document-set-contains? (fld mf :capability/effects) (document-keyword :memory-access)) 0 1)
       (if (same (fld mf :capability/id) (document-string "dma/map")) 0 1))))
