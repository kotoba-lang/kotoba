(ns capability.dma.map
  ;; A descriptor is prepared while host-owned, fenced, and only then handed
  ;; to the device by setting OWN. CPUID is the x86-64 serialising primitive
  ;; exposed by the AIUEOS kernel profile.
  (:export [release-fence tx-command rx-command]))

(defn release-fence []
  (+ 1 (* 0 (kernel-cpuid-eax 0 0))))

(defn tx-command [length]
  (bit-or 4026531840 length))

(defn rx-command [capacity]
  (bit-or 3221225472 capacity))
