(ns kotoba.capability.net.transport-test
  (:export [main])
  (:require [kotoba.capability.net.transport :as t]))

(defn- check [ok :bool] :i64 (if ok 0 1))

(defn main [] :i64
  (+ (check (= (t/tcp-header-length 0x50) 20))
     (check (= (t/tcp-header-length 0x60) 24))
     (check (= (t/tcp-header-length 0xf0) 60))
     (check (= (t/tcp-header-length 0x40) 0))
     (check (= (t/tcp-header-length 0x00) 0))
     (check (t/syn-ack-shape? 40 20 0x12))
     (check (t/syn-ack-shape? 44 24 0x12))
     (check (not (t/syn-ack-shape? 40 20 0x10)))
     (check (not (t/syn-ack-shape? 40 16 0x12)))
     (check (not (t/syn-ack-shape? 60 20 0x12)))
     (check (not (t/syn-ack-shape? 36 16 0x12)))))
