;; Kotoba port of the pure helpers in
;; capabilities/kotoba.capability.net.transport/src/kotoba/capability/net/transport.cljk.
;;
;; Named divergences:
;; - `manifest` is repository metadata (keyword map, sets), not semantics; it
;;   stays in the .cljk, as in the mmio precedent.
;; - tcp-header-length returns nil for an out-of-range offset in the .cljk. Kotoba
;;   has no nil, so it returns 0 instead. 0 is never a valid TCP header length
;;   (the valid range is 20..60), so the sentinel is unambiguous.
;; - (bit-shift-right x 4) is spelled (quot x 16); bit-shift-right is an
;;   unsupported form (E2101). For x = (bit-and byte 0xf0) the two are equal.
(ns kotoba.capability.net.transport
  (:export [tcp-header-length syn-ack-shape?]))

(defn tcp-header-length [data-offset-byte :i64] :i64
  (let [length (* 4 (quot (bit-and data-offset-byte 0xf0) 16))]
    (if (and (<= 20 length) (<= length 60)) length 0)))

(defn syn-ack-shape? [ipv4-total :i64 tcp-header :i64 flags :i64] :bool
  (and (<= 40 ipv4-total)
       (<= 20 tcp-header)
       (<= tcp-header 60)
       (= tcp-header (- ipv4-total 20))
       (= flags 0x12)))
