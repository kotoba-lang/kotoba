(ns capability.net.transport
  (:export [tcp-header-length syn-ack-shape]))

(defn tcp-header-length [data-offset-byte]
  (let [length (* (quot (bit-and data-offset-byte 240) 16) 4)]
    (if (and (>= length 20) (<= length 60)) length 0)))

(defn syn-ack-shape [ipv4-total tcp-header flags]
  (if (and (= tcp-header (- ipv4-total 20))
           (= flags 18))
    1
    0))
