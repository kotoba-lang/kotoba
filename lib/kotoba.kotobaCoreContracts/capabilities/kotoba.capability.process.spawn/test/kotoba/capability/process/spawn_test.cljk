(ns kotoba.capability.process.spawn-test
  (:require [clojure.test :refer [deftest is]]
            [kotoba.capability.process.spawn :as spawn]
            [kotoba.core.capability-repository :as authority]
            [kotoba.core.contracts :as contracts]))

(deftest manifest-identity
  (is (= "process/spawn" (:capability/id spawn/manifest)))
  (is (= :contract-only (:capability/provider-status spawn/manifest)))
  (is (contains? (:capability/imports spawn/manifest) :process-spawn)))

(deftest definition-identity-is-canonical-without-granting-runtime-admission
  (is (= (:capability/definition-cid spawn/manifest)
         (authority/definition-cid spawn/manifest)))
  (is (= #{:unknown-capability :radicle-rid-required}
         (set (map :problem (authority/validate-manifest
                              (contracts/capability-contract) spawn/manifest))))))
