(ns kotoba.capability.audio.io-test
  (:export [main])
  (:require [kotoba.capability.audio.io :as io]))

(defn- get-at [d :document k :keyword] :document
  (option-or (document-get d k) (document-null)))

(defn- str-at [d :document k :keyword] :string
  (option-or (document-string-value (get-at d k)) "<none>"))

(defn main [] :i64
  (let [m (io/manifest)]
    (+ (if (string=? (str-at m :capability/id) "audio/io") 0 1)
       (if (= (option-or (document-i64-value (get-at m :capability/version)) 0) 1) 0 1)
       (if (= (document-count (get-at m :capability/dependencies)) 0) 0 1)
       (if (= (document-count (get-at m :capability/imports)) 2) 0 1)
       (if (= (document-count (get-at m :capability/effects)) 3) 0 1)
       (if (document-set-contains? (get-at m :capability/effects) (document-keyword :sensor-read)) 0 1)
       (if (option-or (document-bool-value (get-at (get-at m :capability/artifact) :digest-required?)) false) 0 1)
       (if (string=? (str-at m :schema) "kotoba.capability.repository.v1") 0 1))))
