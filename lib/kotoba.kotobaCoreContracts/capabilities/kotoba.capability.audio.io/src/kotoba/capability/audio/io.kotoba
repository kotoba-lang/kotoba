;; Port of kotoba.capability.audio.io (io.cljk), Kotoba-native, :document maps.
;;
;; Named divergences from io.cljk:
;;   - the manifest def is the zero-arg fn manifest (a def cannot be exported).
;;   - #{...} sets are :document sets; the hash/CID and repository strings are
;;     kept exactly as written.

(ns kotoba.capability.audio.io
  (:export [manifest]))

(defn manifest [] :document
  (document-map :schema (document-string "kotoba.capability.repository.v1")
                :capability/version (document-i64 1)
                :capability/hash-contract-cid (document-string "bafkreiflhj3fslsbh7okdas2fzlhmogai64x6p3lkla6gtr7berbp7ftvi")
                :capability/definition-cid (document-string "bafyreifi36bkriel3h276si25f7gqmmboglsptf4fuyickq4r3ksgpueuy")
                :capability/dependencies (document-set)
                :capability/imports (document-set (document-keyword :audio-play) (document-keyword :audio-record))
                :authority (document-string "kotoba-lang/kotoba-core-contracts")
                :capability/default-policy (document-keyword :approval-required)
                :capability/artifact (document-map :format (document-keyword :wasm-component)
                                                   :digest-required? (document-bool true)
                                                   :signature-required? (document-bool true))
                :capability/radicle-rid (document-string "rad:zX2TtjXmQDxFG7RcjGFJ2fjZXAuB")
                :capability/repository (document-string "kotoba-lang/capability-audio-io")
                :capability/id (document-string "audio/io")
                :capability/effects (document-set (document-keyword :personal-data) (document-keyword :sensor-read)
                                                  (document-keyword :device-write))
                :capability/provider-status (document-keyword :contract-only)))
