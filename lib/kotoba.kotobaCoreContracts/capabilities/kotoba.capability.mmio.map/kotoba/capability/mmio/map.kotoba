(ns capability.mmio.map
  ;; The capability contract validates width/alignment/range. The admitted
  ;; hardware provider performs the actual intrinsic so this library never
  ;; turns importing a helper into ambient MMIO authority.
  (:export [access-valid]))

(defn access-valid [length offset width]
  ;; The provider selects WIDTH from its distinct u8/u16/u32 intrinsic; this
  ;; helper checks the dynamic alignment and region end for that fixed width.
  (if (and (>= offset 0)
           (<= offset (- length width))
           (= (bit-and offset (- width 1)) 0))
    1
    0))
