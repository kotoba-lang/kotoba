;; Kotoba port of src/kotoba/capability/mmio/map.cljk (product semantics only).
;; `manifest` stays in the .cljc original: it is repository metadata, not
;; semantics. The parity test compares `access-valid?` on both sides.
;;
;; The original uses (def supported-widths #{1 2 4}) + contains?; the kotoba
;; js-browser subset rejects integer-set constants, so the width admission is
;; spelled as a disjunction over the same three widths.
(ns kotoba.capability.mmio.map
  (:export [access-valid?]))
(defn access-valid? [length offset width]
  (and (or (= width 1) (= width 2) (= width 4))
       (<= 0 offset)
       (<= width length)
       (<= offset (- length width))
       (zero? (bit-and offset (dec width)))))
