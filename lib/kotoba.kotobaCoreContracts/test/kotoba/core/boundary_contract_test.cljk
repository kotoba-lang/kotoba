(ns kotoba.core.boundary-contract-test
  "The boundary descriptor is judgment-free and shape-only. These assertions
  are what keeps an implementation note or a policy decision from drifting
  into resources/kotoba/runtime/boundary_contract.edn unnoticed."
  (:require [kotoba.test :refer [deftest is testing]]
            [kotoba.core.contracts :as contracts]))

(deftest boundary-contract-schema
  (let [c (contracts/boundary-contract)]
    (is (= :kotoba.lisp-machine/boundary-v1 (:schema c)))
    (is (= :edn (:canonical-format c)))
    (is (= "kotoba-lang/kotoba-core-contracts" (:authority c)))
    (is (= :accepted (:status c)))))

(deftest boundary-contract-is-judgment-free
  (let [c (contracts/boundary-contract)
        excluded (set (:not (:definition c)))]
    (is (every? excluded [:validation :authorization :execution :policy])
        "validation / authorization / execution / policy stay outside the boundary")
    (is (= [:rule-form :grant :authority] (:judgment-owners (:definition c))))
    (testing "no domain places an implementation or carries a judgment of its own"
      (is (not-any? :implementation (vals (:domains c))))
      (is (every? #(contains? % :judges) (vals (:domains c)))))))

(deftest boundary-contract-rules
  (let [c (contracts/boundary-contract)
        ids (set (map :id (:rules c)))]
    (is (= 6 (count (:rules c))))
    (is (= #{:judgment-free
             :unknown-shape-fail-closed
             :canonical-bytes-before-cid
             :versioned-wire-keys-preserved
             :no-secrets
             :host-object-transparent}
           ids))
    (testing "the silent-corruption guards are present by name"
      (is (contains? ids :unknown-shape-fail-closed))
      (is (contains? ids :canonical-bytes-before-cid)))))

(deftest boundary-contract-domains
  (let [c (contracts/boundary-contract)
        domains (:domains c)]
    (is (= 5 (count domains)))
    (is (= #{:kernel-object :host-guest :value-wire :cell-cell :domain-domain}
           (set (keys domains))))
    (is (every? #(and (:carry %) (:shape %)) (vals domains))
        "every domain says what crosses and in which shape")))
