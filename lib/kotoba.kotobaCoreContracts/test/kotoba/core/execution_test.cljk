(ns kotoba.core.execution-test
  (:require #?(:clj [kotoba.test :refer [deftest is testing]]
               :cljs [cljs.test :refer [deftest is testing]])
            [kotoba.core.execution :as execution]))

(def cid "bafkreid4qjrk54dtbrpa4zx3b2umgsvevohcm7z436igajsdd34khleu2q")
(def identity-v2
  (assoc (zipmap execution/execution-identity-keys (repeat cid))
         :format :kotoba.execution-identity/v2 :plan-cid nil
         :grant-cids [cid] :approval-cids [] :host-receipt-cids [cid]))
(def lease-v2
  (assoc (zipmap execution/capability-lease-keys (repeat cid))
         :format :kotoba.capability-lease/v2 :purpose :audit/append
         :expires-at "2026-10-10T01:00:00Z" :uses 1
         :transfer :same-artifact :delegation-depth 0))

(deftest intent-is-distinct-from-completed-identity
  (let [intent (-> identity-v2
                   (dissoc :outcome-cid :host-receipt-cids)
                   (assoc :format :kotoba.execution-intent/v2 :invocation-cid cid))]
    (is (execution/valid-execution-intent? intent))
    (is (not (execution/valid-execution-identity? intent)))
    (is (not (execution/valid-execution-intent? identity-v2)))
    (doseq [k (keys intent)]
      (is (not (execution/valid-execution-intent? (dissoc intent k)))))
    (doseq [k [:outcome-cid :host-receipt-cids :host-handle :component-cid]]
      (is (not (execution/valid-execution-intent? (assoc intent k cid)))))))

(deftest cid-is-structural-and-complete
  (is (execution/cid? cid))
  (doseq [bad [nil "banana" "b" (subs cid 0 20) 42]]
    (is (not (execution/cid? bad)))))

(deftest bounded-semantic-ability
  (let [ability {:target "resource://audit" :operation :audit/append
                 :max-bytes 1 :max-items 1 :deadline-ms 1 :audit-id "audit"}]
    (is (execution/valid-ability? ability))
    (is (= execution/ability-keys (set (keys ability))))
    (is (not (execution/valid-ability? (assoc ability :host-handle "secret"))))
    (doseq [k [:max-bytes :max-items :deadline-ms]]
      (is (not (execution/valid-ability? (assoc ability k 0)))))
    (is (execution/valid-stream-limits? (select-keys ability (:required-limits execution/stream-contract))))
    (is (not (execution/valid-stream-limits? {:deadline-ms 1 :max-items 1 :max-bytes 0})))))

(deftest neutral-plan-policy-approval-remain-v1
  (let [plan (assoc (zipmap execution/plan-keys (repeat cid))
                    :format :kotoba.plan/v1 :requested-effects #{:audit/append}
                    :requested-resources #{:audit} :budget {:fuel 1})
        decision (assoc (zipmap execution/policy-decision-keys (repeat cid))
                        :format :kotoba.policy-decision/v1 :result :permit
                        :reasons [] :issued-at "issued" :expires-at "expires")
        approval (assoc (zipmap execution/approval-keys (repeat cid))
                        :format :kotoba.approval/v1 :resources #{:audit}
                        :issued-at "issued" :expires-at "expires")]
    (doseq [[valid? value] [[execution/valid-plan? plan]
                          [execution/valid-policy-decision? decision]
                          [execution/valid-approval? approval]]]
      (is (valid? value))
      (doseq [k (keys value)] (is (not (valid? (dissoc value k)))))
      (is (not (valid? (assoc value :component-cid cid)))))
    (is (not (execution/valid-policy-decision? (assoc decision :result :maybe))))
    (is (not (execution/valid-approval? (assoc approval :resources #{}))))))

(deftest neutral-identity-and-lease-reject-physical-fields
  (doseq [[valid? value] [[execution/valid-execution-identity? identity-v2]
                        [execution/valid-capability-lease? lease-v2]]]
    (is (valid? value))
    (doseq [k (keys value)] (is (not (valid? (dissoc value k)))))
    (doseq [field [:component-cid :wit-world-cid :host-handle]]
      (is (not (valid? (assoc value field cid)))))
    (is (not (valid? (assoc value :profile-binding-cid nil)))))
  (is (not (execution/valid-execution-identity? (assoc identity-v2 :format :kotoba.execution-identity/v1))))
  (is (not (execution/valid-execution-identity? (assoc identity-v2 :grant-cids [cid cid]))))
  (is (not (execution/valid-capability-lease? (assoc lease-v2 :transfer :same-component))))
  (is (not (execution/valid-capability-lease? (assoc lease-v2 :uses 0)))))
