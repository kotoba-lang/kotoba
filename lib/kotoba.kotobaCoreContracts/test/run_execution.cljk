;; kbb --backend sci --classpath src:test test/run_execution.cljk
(ns run-execution
  (:require [cljs.test :as t] [kotoba.core.execution-test]))
(defmethod t/report [:cljs.test/default :end-run-tests] [m]
  (println (select-keys m [:test :pass :fail :error]))
  (when (or (zero? (:test m)) (pos? (+ (:fail m) (:error m))))
    (set! (.-exitCode js/process) 1)))
(t/run-tests 'kotoba.core.execution-test)
