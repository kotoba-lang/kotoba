{:schema :kotoba.lisp-machine/boundary-v1
 :owner "kotoba/lisp-machine"
 :canonical-format :edn
 :authority "kotoba-lang/kotoba-core-contracts"
 :status :accepted
 :source {:adr "kotoba-lang/kotoba-lang docs/adr/ADR-kotoba-lisp-machine-contract-decisions.md D1"
          :design "kotoba-lang/kotoba-lang docs/kotoba-lisp-machine-design.ja.md section 4"
          :draft "kotoba-lang/kotoba-lang docs/kotoba-lisp-machine-boundary.draft.edn"}
 :versioning {:content-addressed true
              :wire-keys-preserved-until :versioned-migration}

 ;; The boundary is judgment-free: pack / unpack / length / order only.
 ;; It never validates, authorizes or executes. Judgments stay with rule Form,
 ;; grant and authority. Generalizes the aiueos convention "C marshals, Kotoba
 ;; judges" (ADR-0219 flat record) to every seam.
 :definition
 {:statement "boundary encoding is judgment-free"
  :not [:validation :authorization :execution :state-machine :policy]
  :judgment-owners [:rule-form :grant :authority]}

 :rules
 [{:id :judgment-free
   :rule "the boundary carries no predicate, policy or capability decision; anything that decides moves to rule Form or grant"}
  {:id :unknown-shape-fail-closed
   :rule "an unknown tag, shape or profile is refused and recorded; never skipped; refused and passed stay distinguishable in the output"
   :like [:kototama.vm/unknown-effect-deny :kototama.vm/missing-origin-deny]}
  {:id :canonical-bytes-before-cid
   :rule "writes build canonical bytes before taking a CID; reads verify the CID before decoding"
   :like [:kototama.vm/write-canonical-bytes-before-cid :kototama.vm/read-verify-cid-before-decode]}
  {:id :versioned-wire-keys-preserved
   :rule "the boundary spec is content-addressed; existing wire keys and CID rules do not change until a versioned migration"}
  {:id :no-secrets
   :rule "no raw bearer, private key or ambient host handle crosses a boundary; no secret in discovery or receipts"
   :like [:kototama.vm/receipt-forbidden]}
  {:id :host-object-transparent
   :rule "no host object crosses; every host call made by the boundary counts as work (fuel)"
   :like [:kototama.vm/host-object-false]}]

 ;; Five boundary domains. Shapes only: this descriptor places no
 ;; implementation (placement is ADR D1) and carries no judgment.
 :domains
 {:kernel-object {:carry :flat-record
                  :shape {:base :bytes :length :integer :read :offset}
                  :judges :kotoba-object-or-grant}
  :host-guest {:carry :typed-import-export
               :shape :canonical-abi-lift-lower
               :judges :host-admission-or-authority}
  :value-wire {:carry [:value :message :receipt]
               :shape :tagged-dag-cbor-vector
               :judges :none}
  :cell-cell {:carry [:action :op :remote-call]
              :shape :signed-action-plus-op
              :judges :rule-form-or-grant}
  :domain-domain {:carry [:ordered-write :settlement]
                  :shape :message-plus-receipt
                  :judges :declared-domain-rules}}}
