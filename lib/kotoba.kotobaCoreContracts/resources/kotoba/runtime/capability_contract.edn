{:schema "kotoba.runtime.capability-contract.v0"
 :owner "kotoba/runtime"
 :canonical-format :edn
 :authority "kotoba-lang/kotoba-core-contracts"
 :capability-ids {"ledger/append" 201
                  "fs/app-data" 202
                  "notify/show" 203
                  "clipboard/text" 204
                  "http/fetch" 205
                  "keychain/text" 206
                  "contacts/read" 207
                  "calendar/read" 208
                  "graph/kotoba" 209
                  "log/write" 210
                  "clock/monotonic" 211
                  "random/bytes" 212
                  "topic/publish" 213
                  "topic/subscribe" 214
                  "pci/config" 215
                  "dma/map" 216
                  "irq/subscribe" 217
                  "mmio/map" 218
                  ;; kotoba-lang/kototama's actor:host ABI (kototama.contract
                  ;; / kototama.tender, ADR-2607062330/2607062400) -- module
                  ;; "kotoba", same host as everything above, so a guest can
                  ;; freely mix these with the kernel-capability imports
                  ;; already registered.
                  "identity/keypair" 219
                  "identity/sign" 220
                  "identity/verify" 221
                  "hash/sha256" 222
                  "http/post" 223
                  "log/read" 224
                  ;; `llm-infer` -- kototama.tender's Anthropic Messages API
                  ;; call (ADR-2607062330's llm-infer addendum). Same module
                  ;; "kotoba" as everything above.
                  "llm/infer" 225
                  ;; `gpu-clear` -- ADR-2607078000 Track B Phase 0 spike: the
                  ;; first `kami:engine`-independent GPU host-import, proving
                  ;; a guest-driven WebGPU call is possible over a synchronous
                  ;; Wasm host-import (the browser host does one-time async
                  ;; device/adapter setup BEFORE the guest runs; every
                  ;; per-frame call after that, including this one, is
                  ;; genuinely synchronous per the WebGPU spec). Same module
                  ;; "kotoba" as everything above.
                  "gpu/clear" 226
                  ;; Track B Phase 1 (ADR-2607078000): real f32 host-imports
                  ;; (kotoba-lang/kotoba now supports :f32 params/results,
                  ;; ADR-2607078000 Track B Phase 1's f32-compiler-support
                  ;; commit) for orbital math (cos/sin) and the render-guest
                  ;; loop (gpu-set-position/gpu-draw-frame). Same module
                  ;; "kotoba" as everything above.
                  "math/cos" 227
                  "math/sin" 228
                  "gpu/set-position" 229
                  "gpu/draw-frame" 230
                  ;; ADR-2607078000 Track B Phase 1 follow-up: animation +
                  ;; galactic-frame toggle. `now-days` lets the guest read a
                  ;; host-owned, wrapped simulated day count instead of a
                  ;; fixed t (the host advances/wraps it every
                  ;; requestAnimationFrame tick and just calls the guest's
                  ;; 0-arg `main` again -- no guest-side loop or wasm export
                  ;; beyond `main` needed). `galactic-frame?` lets the guest
                  ;; read a host-owned boolean (a page checkbox) to decide
                  ;; whether to apply the tilt+forward-drift transform.
                  "time/now-days" 231
                  "render/galactic-frame" 232
                  ;; `kami-*` -- a minimal game-engine ECS surface (entity
                  ;; spawn/despawn, position/velocity, tag queries, input
                  ;; axis, seeded rand), the kami:engine vocabulary exposed
                  ;; through THIS contract's single (module "kotoba") ABI so
                  ;; a `.kotoba` guest can drive real game logic. Same
                  ;; "guest computes, host executes" split as gpu-set-
                  ;; position above: the host owns all entity state and
                  ;; fixed-step integration, advances the tick counter, and
                  ;; calls the guest's 0-arg `main` once per tick (no
                  ;; guest-side loop); batch ops (move-tagged-toward!/
                  ;; despawn-within!) stand in for per-entity iteration the
                  ;; language deliberately doesn't have. One shared
                  ;; capability for the whole family, like "graph/kotoba"
                  ;; covering the kgraph-* quartet.
                  "kami/engine" 233
                  ;; ADR-2607140600 Phase 3a device-capability bridge (iPhone
                  ;; sensing for the indoor floorplan-lab): 4 read-only, no
                  ;; network-egress, individually-metered/gateable
                  ;; capabilities, registered through the SAME pipeline
                  ;; ADR-2607100030 established (kotoba-core-contracts
                  ;; capability id -> kotoba-lang effect-for-kind -> kotoba
                  ;; runtime op->kind/guarded-host-functions). Real hardware
                  ;; access (CoreMotion/CoreBluetooth/AVAudioEngine) is
                  ;; explicitly OUT of this ADR's scope -- these ids only
                  ;; make the capabilities nameable/gateable from `.kotoba`
                  ;; source and back a deterministic stub host, same as
                  ;; aiueos's device-access quartet (ADR-2607030900).
                  "motion/read" 234
                  "audio/io" 235
                  "ble/scan" 236
                  "wifi/info" 237
                  ;; Bounded component transport ABI. Handles are opaque i64
                  ;; values; no file descriptor or syscall number crosses the
                  ;; component boundary.
                  "net/connect" 238
                  "crypto/tls" 239
                  "net/transport" 240
                  "component/http" 241
                  "component/database" 242
                  "secret/use-scram-sha256" 243
                  "secret/use-postgresql-cancel" 244
                  ;; kotoba-lang/kototama's actor:host ABI, second wave
                  ;; (com-junkawasaki/root ADR-2607230943): CBOR/JSON wire-
                  ;; format encoding for a future news-collecting fleet actor
                  ;; (kawaraban/cloud-itonami) that needs to build CACAO
                  ;; token bytes and XRPC request/response bodies from
                  ;; within a `.kotoba` guest. Same module "kotoba" as
                  ;; every other kototama entry above.
                  ;;
                  ;; NOTE: this wave's THIRD capability, GET-only HTTP
                  ;; fetch, is deliberately NOT a new id here -- id 205
                  ;; "http/fetch" already exists (registered for
                  ;; `kotoba wasm emit`'s own kernel-capability vocabulary,
                  ;; `kotoba.wasm-exec/real-host-functions`'s `http-fetch`)
                  ;; with the exact (url-ptr url-len out-ptr out-cap) -> i32
                  ;; shape kototama needs. kototama simply becomes a SECOND
                  ;; host implementing that already-contracted capability --
                  ;; the same "reuse, don't duplicate" choice this file's
                  ;; own `log/write`/`clock/monotonic` entries already made
                  ;; for kototama (see kototama.tender's namespace
                  ;; docstring). Registering a second, colliding "http/fetch"
                  ;; key here would in fact be a hard EDN reader error
                  ;; (duplicate map key), not just redundant.
                  "data/cbor" 245
                  "data/json" 246
                  ;; kbb ops-script surface (ADR-2607181900 readiness gate):
                  ;; data/edn parses EDN text into an interpreter-native
                  ;; Clojure value (the kbb host slice has no linear memory,
                  ;; so the guest passes the EDN text as a plain string and
                  ;; receives the parsed value directly). Resource scope =
                  ;; nothing external; the bytes come entirely from the
                  ;; guest's own argument, so the kind-level grant is the
                  ;; whole boundary (no per-name narrowing, mirroring
                  ;; json-encode's scope shape). Replace the clojure.edn
                  ;; reader in kbb ops scripts (facade/tasks.edn checks).
                  "data/edn" 260
                  ;; kotoba-lang/kototama's actor:host ABI, THIRD wave
                  ;; (com-junkawasaki/root ADR-2607231022's Phase A left this
                  ;; as an explicit follow-up, closed here): `http_post`
                  ;; itself cannot grow a headers parameter without breaking
                  ;; every ALREADY-COMPILED `.kotoba` guest that imports it
                  ;; (a Wasm import's arity is part of the compiled binary's
                  ;; own import section -- changing it is not
                  ;; backward-compatible the way adding a NEW host-import
                  ;; name is). "http_post_headers" is a SEPARATE host-import
                  ;; name for the SAME operation (POST) with one added
                  ;; guest-supplied input (custom request headers, e.g.
                  ;; `Authorization: Bearer <token>`), so it reuses this
                  ;; table's pre-existing "http/post" capability id 223
                  ;; rather than registering a new one -- same "same
                  ;; operation, don't duplicate the capability id" choice
                  ;; this file's own `http/fetch` reuse (see that entry's
                  ;; comment above) and kototama's `log-write`/
                  ;; `clock-monotonic` naming already made.
                  
                  ;; --- web-wide crawl capabilities (com-junkawasaki/root
                  ;; ADR-2607252400). 道具ではなく *意図* を capability にする:
                  ;; `shell-exec("datalad" ...)` のような汎用コマンド実行を足すと、
                  ;; それを持つ guest が任意 repo に push でき任意ファイルを読めて
                  ;; deny-by-default が無意味になる (ADR-2607201300 が禁じる形)。
                  ;; host は判断を含まない機構だけを所有し、判断は .kotoba 側:
                  ;; どのパターンを何ページ目から引くか / どのレコードを採るか /
                  ;; いつ publish するか、は guest が決める。
                  ;;
                  ;; 大きいデータ (WARC 本文は 250KB 級) は境界を越えさせない。
                  ;; `cc/warc-extract` は CID + 有界サマリだけを返し、実体は host が
                  ;; 保持する。Component Model の 65,536 バイト上限 (compiler
                  ;; ADR 0041) を上げないのは、固定 3x64KiB ページ + bump
                  ;; allocator + post-return reset が保証する「メモリ使用量が
                  ;; 入力に依らず静的に有界」を捨てないため。
                  "cc/cdx-query" 247
                  "cc/warc-extract" 248
                  "corpus/append" 249
                  "corpus/publish" 250
                  ;; --- the kotoba-lang/app-* standard application suite
                  ;; (ADR-2608035000). Split deliberately: reading how much
                  ;; CPU or disk is in use must not require the right to read
                  ;; which processes or files there are, and playing audio
                  ;; must not require the right to enumerate a library.
                  "process/list" 251
                  "system/metrics" 252
                  "fs/browse" 253
                  "image/metadata" 254
                  "media/library" 255
                  "audio/playback" 256

                  ;; kotoba-lang/haishin — publishing to an external social
                  ;; platform under an identity. Deliberately NOT folded into
                  ;; http/post: the authority being granted is not "write to a
                  ;; network socket" but "make this content publicly visible as
                  ;; us, on a service whose deletion semantics we do not
                  ;; control". A grant of http/post to reach an internal API
                  ;; must not silently also authorise a public post.
                  "social/publish" 257
                  ;; kbb ops-script surface (ADR-2607181900 readiness gate):
                  ;; env-read grants a guest a named process-environment
                  ;; variable lookup. Resource scope = the exact env var
                  ;; NAMES the policy grants (fail-closed default #{}), so a
                  ;; policy that grants :env/read without naming variables
                  ;; reads nothing -- same resource-scope shape as
                  ;; :fs/app-data paths.
                  "env/read" 258
                  ;; kbb ops-script surface (ADR-2607181900 readiness gate
                  ;; slice 2): proc/exec runs ONE allowlisted command with a
                  ;; FIXED argument vector. Resource scope = exact command
                  ;; names (bare executable names, no paths, no shells). The
                  ;; argument vector and cwd are policy-side literals, not
                  ;; guest-supplied: the guest cannot compose arbitrary
                  ;; invocations, only choose among the fixed grants. No
                  ;; shell is ever spawned -- argv goes straight to exec.
                  "proc/exec" 259
                  ;; kotoba-lang/find — org-wide directory tree walking for the
                  ;; find/grep lib (com-junkawasaki/root, find-lib slice). The
                  ;; existing "fs/browse" (253) answers entry NAMES only, with
                  ;; no way for a guest to ask "is this entry a directory" —
                  ;; which is exactly what a recursive tree walk needs and
                  ;; what fs/browse deliberately does not provide (the guest
                  ;; recurses through fs-browse + fs-read, but cannot decide
                  ;; whether to descend). fs-browse-dir answers ONE directory
                  ;; as a list of (name, is-dir) pairs so the guest can walk
                  ;; the tree itself, every descent still inside the
                  ;; capability guard. Same module "kotoba" as fs/browse.
                  "fs/browse-dir" 261
                  }
