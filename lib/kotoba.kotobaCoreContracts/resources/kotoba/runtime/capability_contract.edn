  ;; --- web-wide crawl (ADR-2607252400). 既存 import の序数を動かさないよう
  ;; 必ず末尾に足す — 途中挿入は既存 .wasm の import index を全部ずらす。
  cc-cdx-query cc-warc-extract corpus-append corpus-publish
  ;; --- app-* suite (ADR-2608035000). Appended, never inserted.
  process-list system-metrics fs-browse image-metadata media-library
  audio-playback
  ;; --- social/publish (kotoba-lang/haishin). Appended, never inserted.
  social-publish social-publish-receipt
  ;; --- kbb ops-script surface (ADR-2607181900). Appended, never inserted.
  env-read
  proc-exec
  edn-read
  ;; --- kotoba-lang/find tree-walk (find-lib slice). Appended, never inserted.
  fs-browse-dir
