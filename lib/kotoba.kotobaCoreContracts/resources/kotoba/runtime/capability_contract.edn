                           :field "fs_browse"
                           :capability "fs/browse"
                           ;; (dir-ptr dir-len out-ptr out-len)
                           :params [:i32 :i32 :i32 :i32]
                           :result :i32}
                fs-browse-dir {:module "kotoba"
                               :field "fs_browse_dir"
                               :capability "fs/browse-dir"
                               ;; (dir-ptr dir-len out-ptr out-len) -> the list
                               ;; of (name, is-dir) entries of ONE directory,
                               ;; flowed through the string-result convention
                               ;; as a "\n"-joined listing where each line is
                               ;; "<name>\t<0|1>" (0 = file, 1 = directory).
                               ;; The guest splits lines and fragments to walk
                               ;; the tree itself; every descent still inside
                               ;; the capability guard. A granted-but-missing
                               ;; directory returns nil (absent, like fs-browse).
                               :params [:i32 :i32 :i32 :i32]
                               :result :i32}
                env-read {:module "kotoba"
                          :field "env_read"
                          :capability "env/read"
                          ;; (name-ptr name-len) -> the value flows through the
                          ;; interpreter slice's string-result convention (the
                          ;; CLJS/wasm backends carry it via the shared
                          ;; string ABI); kbb's interpreter handler takes the
                          ;; plain literal name and returns the plain string.
                          :params [:i32 :i32]
                          :result :i32}
                proc-exec {:module "kotoba"
                           :field "proc_exec"
                           :capability "proc/exec"
                           ;; (index-ptr index-len) -> the guest names a GRANT
                           ;; INDEX (an i64 decimal string) into the policy's
                           ;; fixed invocation table, not a command line. The
                           ;; host looks the invocation up in the policy, so
                           ;; the guest supplies zero command bytes. Result
                           ;; i32 = 0 on success (exit code flows via the
                           ;; shared result convention), non-zero on denial.
                           :params [:i32 :i32]
                           :result :i32}
                image-metadata {:module "kotoba"
                                :field "image_metadata"
                                :capability "image/metadata"
                                ;; (path-ptr path-len out-ptr out-len)
                                :params [:i32 :i32 :i32 :i32]
                                :result :i32}
                media-library {:module "kotoba"
                               :field "media_library"
                               :capability "media/library"
                               ;; (scope-ptr scope-len out-ptr out-len)
                               :params [:i32 :i32 :i32 :i32]
                               :result :i32}
                audio-playback {:module "kotoba"
                                :field "audio_playback"
                                :capability "audio/playback"
                                ;; (op track-ptr track-len) -> status
                                :params [:i32 :i32 :i32]
                                :result :i32}

                ;; social/publish is two imports, not one, because publishing
                ;; and learning what happened are separately consequential.
                ;; A guest that may publish must also be able to record the
                ;; receipt, or the audit trail ends at "we tried"; but a host
                ;; that hands back the receipt in the same call would have to
                ;; block the guest for the whole upload.
                social-publish {:module "kotoba"
                                :field "social_publish"
                                :capability "social/publish"
                                ;; (target-ptr target-len payload-ptr payload-len)
                                ;; -> >=0 receipt handle, <0 error code
                                :params [:i32 :i32 :i32 :i32]
                                :result :i32}
                social-publish-receipt {:module "kotoba"
                                        :field "social_publish_receipt"
                                        :capability "social/publish"
                                        ;; (handle out-ptr out-cap)
                                        ;; -> bytes written, <0 error code
                                        :params [:i32 :i32 :i32]
                                        :result :i32}
                }}
