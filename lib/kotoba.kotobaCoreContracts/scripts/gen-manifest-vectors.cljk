#!/usr/bin/env kbb
;; Regenerate lang/package-conformance/positive/self-consistent-manifest.edn:
;; a package manifest whose :manifest-cid actually equals its own content's
;; CID, and whose signature is over that CID.
;;
;; WHY THIS FIXTURE EXISTS. Measured 2026-09-06, the corpus's
;; positive/package-manifest.edn passes `package-manifest-error` -- shape,
;; plus a real Ed25519 signature over its DECLARED :manifest-cid -- and fails
;; `manifest-integrity-error`, because that declared CID is not what its
;; content hashes to (declared bafyreia4kejp…, actual bafyreifyfayk…). That is
;; not a bug in the fixture so much as a demonstration of the gap
;; `package-manifest-error` names in its own docstring: signature-over-CID and
;; CID-over-content are two checks, and until now this repository only had the
;; first. Nothing was wrong while the second lived in a `.clj` layer one repo
;; away; it matters now that a compiler runs both.
;;
;; Building one is a fixed point taken in the right order: hash the content
;; WITHOUT the self-CID and WITHOUT signatures, write that in as
;; :manifest-cid, then sign that CID. Excluding signatures from the hashed
;; content is what makes the order terminate at all -- see
;; `manifest-without-self-cid`.
;;
;;   kbb --backend sci --classpath src:<deps> scripts/gen-manifest-vectors.cljk \
;;     > lang/package-conformance/positive/self-consistent-manifest.edn

(ns gen-manifest-vectors
  (:require [ed25519.core :as ed]
            [kotoba.lang.package-contract :as contract]))

(defn- seed [b] (js/Uint8Array.from (clj->js (vec (repeat 32 b)))))
(defn- b64 [u8] (.toString (js/Buffer.from u8) "base64"))

(def ^:private signer (seed 11))
(def ^:private did (ed/did-key-from-pub (ed/pubkey-from-seed signer)))

;; Everything except the two fields that are computed from it.
(def ^:private base
  {:kotoba.package/name "kotoba-lang/demo-util"
   :kotoba.package/version "0.1.0"
   :kotoba.package/kind :library
   :kotoba.package/repo-rid
   "bafyreiamqmkpfhh5noifwsn2jgnavzwpgmefv7orc6frbobfmhh2cear6y"
   :kotoba.package/source
   {:git-commit "0000000000000000000000000000000000000000"
    :tree-cid "bafyreigyygk6epd5ge2akwuafpdjmztjc27v5pr7wpqnq37re7xhjwxsl4"}
   :kotoba.package/capabilities []
   :kotoba.package/dependencies []})

(let [cid (contract/compute-manifest-cid base)
      signed (ed/sign signer (.encode (js/TextEncoder.) cid))
      manifest (-> base
                   (assoc-in [:kotoba.package/source :manifest-cid] cid)
                   (assoc :kotoba.package/signatures
                          [{:did did :alg :ed25519 :sig (b64 signed)}]))]
  ;; Both checks, here, before it is written: a generator that emitted a
  ;; fixture without verifying it would be the same trust-me the fixture
  ;; exists to remove.
  (when-let [e (contract/package-manifest-error manifest)]
    (.error js/console (str "generated manifest fails the shape/signature check: "
                            (:message e)))
    (.exit js/process 1))
  (when-let [e (contract/manifest-integrity-error manifest)]
    (.error js/console (str "generated manifest fails its own integrity check: "
                            (:message e)))
    (.exit js/process 1))
  (println ";; Generated by scripts/gen-manifest-vectors.cljk -- do not hand-edit.")
  (println ";; :manifest-cid is this map's own content CID; the signature is over it.")
  (println (pr-str manifest)))
