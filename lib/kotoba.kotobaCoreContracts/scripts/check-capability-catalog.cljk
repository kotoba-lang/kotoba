(ns check-capability-catalog
  (:require [cljs.reader :as edn] [edamame.core :as parser]
            [kotoba.core.capability-repository :as authority]
            [kotoba.core.contracts :as contracts]
            ["node:fs" :as fs] ["node:path" :as path]))
(def root (or (first *command-line-args*) "."))
(def catalog (js->clj (js/JSON.parse (fs/readFileSync (path/join root "capabilities/catalog.json") "utf8")) :keywordize-keys true))
(def runtime (contracts/capability-contract))
(def results
 (mapv (fn [row]
  (let [manifest (edn/read-string (fs/readFileSync (path/join root (:path row) "capability.edn") "utf8"))
        source (path/join root (:path row) "src" (str (.replaceAll (.replaceAll (str (authority/namespace-symbol (:capability-id row))) "." "/") "-" "_") ".cljk"))
        forms (parser/parse-string-all (fs/readFileSync source "utf8") {:all true :read-cond :allow :features #{:cljs}})
        literal (last (first (filter #(and (seq? %) (= 'def (first %)) (= 'manifest (second %))) forms)))
        problems (authority/validate-manifest runtime manifest)]
    (assert (= manifest literal) (str (:id row) " manifest and source disagree"))
    (assert (= (:definition-cid row) (:capability/definition-cid manifest) (authority/definition-cid manifest))
            (str (:id row) " declared=" (:definition-cid row) " recomputed=" (authority/definition-cid manifest)))
    (assert (= (:capability-id row) (:capability/id manifest)))
    ;; Existing unregistered packages remain unregistered; source lookup
    ;; neither registers them nor converts their unknown-capability verdict.
    (assert (= (mapv #(update % :problem name) problems)
               (:expected-unadmitted-problems row)) (str (:id row) " admission rejection drift: " problems))
    {:id (:id row) :definition-cid (:definition-cid row) :definition-verified true
     :source-literal-equal true :admission :not-granted :existing-validation-problems problems})) (:packages catalog)))
(println (js/JSON.stringify (clj->js {:packages (count results) :definitions (count (set (map :definition-cid results)))
  :all-definition-CIDs-recomputed true :unregistered-retained (filterv #(seq (:existing-validation-problems %)) results) :admission :not-granted})))
