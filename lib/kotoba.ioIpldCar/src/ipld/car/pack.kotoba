;; Bounded Native constructor for the preserved Otehon indexless CARv2 profile.
;; Canonical transport bytes stay with this owner. No parser/I/O qualification.
(ns ipld.car.pack
  (:require [ipld.dag-cbor-write :as w] [multiformats.cid :as cid] [multiformats.byte-cid :as hash])
  (:export [encode root-cid refusal encode-large root-cid-large refusal-large])
  (:schemas {:ipld.car/pack [:record :ipld.car/pack [[:bytes :vector-i64] [:root :string] [:error :keyword]]]}))
(def max-native-pack-bytes 65536)
(def max-large-pack-bytes 1049600)
(def max-leaves 1024)
(defn- refusal-bound [version :i64 flat :vector-i64 limit :i64] :keyword
  (cond (not= version 1) :profile-version
        (> (vector-count flat) limit) :limit
        :else (loop [cursor 0 count 0]
          (cond (= cursor (vector-count flat)) :none
                (>= count max-leaves) :limit
                :else (let [length (vector-at flat cursor) next (+ cursor 1 length)]
                  (cond (< length 0) :extent (> length limit) :limit
                        (> next (vector-count flat)) :truncated
                        :else (let [e (loop [i (+ cursor 1)]
                                        (cond (= i next) :none
                                              (or (< (vector-at flat i) 0) (> (vector-at flat i) 255)) :byte
                                              :else (recur (+ i 1))))]
                                (if (not= e :none) e (recur next (+ count 1))))))))))
(defn refusal [version :i64 flat :vector-i64] :keyword
 (refusal-bound version flat max-native-pack-bytes))
(defn refusal-large [version :i64 flat :vector-i64] :keyword
 (refusal-bound version flat max-large-pack-bytes))
(defn- slice [b :vector-i64 start :i64 length :i64] :vector-i64
  (loop [i 0 out (vector-alloc length)] (if (= i length) out
    (recur (+ i 1) (vector-assoc! out i (vector-at b (+ start i)))))))
(defn- little64 [value :i64] :vector-i64
  (loop [i 0 out (vector-alloc 8)] (if (= i 8) out
    (recur (+ i 1) (vector-assoc! out i (bit-and (u64-shift-right value (* i 8)) 255))))))
(defn- block [link :vector-i64 bytes :vector-i64] :vector-i64
  (w/append (cid/varint (+ (vector-count link) (vector-count bytes))) (w/append link bytes)))
(defn- copy-at [out :vector-i64 at :i64 b :vector-i64] :vector-i64
  (loop [i 0 acc out] (if (= i (vector-count b)) acc
    (recur (+ i 1) (vector-assoc! acc (+ at i) (vector-at b i))))))
(defn- build [version :i64 flat :vector-i64 limit :i64] [:ref :ipld.car/pack]
  (let [e (refusal-bound version flat limit)]
    (if (not= e :none) (record-new [:ref :ipld.car/pack] (vector-i64) "" e)
      (let [sizes (loop [cursor 0 n 0 size 0]
                    (if (= cursor (vector-count flat)) (vector-i64 n size)
                      (let [length (vector-at flat cursor) section (+ 36 length)]
                        (recur (+ cursor 1 length) (+ n 1) (+ size section (vector-count (cid/varint section)))))))
            count (vector-at sizes 0) array (w/array-head count)
            link-width (vector-count (w/link-bytes-item (vector-alloc 36)))
            root-size (+ 8 (vector-count array) (* count link-width))
            root-block-size (+ root-size 36)
            data-size (+ 59 (vector-at sizes 1) root-block-size (vector-count (cid/varint root-block-size)))]
        (if (> (+ 51 data-size) limit)
          (record-new [:ref :ipld.car/pack] (vector-i64) "" :limit)
          (let [links (loop [cursor 0 at (vector-count array) out (copy-at (vector-alloc (+ (vector-count array) (* count link-width))) 0 array)]
                        (if (= cursor (vector-count flat)) out
                          (let [length (vector-at flat cursor) bytes (slice flat (+ cursor 1) length)
                                link (w/link-bytes-item (cid/cid->bytes (hash/cidv1-raw-bytes bytes)))]
                            (recur (+ cursor 1 length) (+ at (vector-count link)) (copy-at out at link)))))
                root (w/append (w/append (w/head 5 1) (w/text-item "leaves")) links)
                root-id (hash/cidv1-dag-cbor-bytes root) root-link (cid/cid->bytes root-id)
                header (w/append (w/append (w/append (w/append (w/head 5 2) (w/text-item "roots")) (w/array-head 1))
                                          (w/link-bytes-item root-link)) (w/append (w/text-item "version") (w/int-item 1)))
                head (w/append (cid/varint (vector-count header)) header)
                data (loop [cursor 0 at (vector-count head) out (copy-at (vector-alloc data-size) 0 head)]
                       (if (= cursor (vector-count flat)) (copy-at out at (block root-link root))
                         (let [length (vector-at flat cursor) bytes (slice flat (+ cursor 1) length)
                               section (block (cid/cid->bytes (hash/cidv1-raw-bytes bytes)) bytes)]
                           (recur (+ cursor 1 length) (+ at (vector-count section)) (copy-at out at section)))))
                pragma (vector-i64 10 161 103 118 101 114 115 105 111 110 2)
                prefix (w/append (w/append (w/append (w/append pragma (vector-alloc 16)) (little64 51))
                                          (little64 (vector-count data))) (little64 0))]
            (record-new [:ref :ipld.car/pack] (w/append prefix data) root-id :none)))))))
(defn encode [version :i64 flat :vector-i64] [:result :vector-i64 :keyword]
  (let [p (build version flat max-native-pack-bytes) e (record-get [:ref :ipld.car/pack] p :error)]
    (if (= e :none) (result-ok-of [:result :vector-i64 :keyword] (record-get [:ref :ipld.car/pack] p :bytes))
      (result-err-of [:result :vector-i64 :keyword] e))))
(defn root-cid [version :i64 flat :vector-i64] [:result :string :keyword]
  (let [p (build version flat max-native-pack-bytes) e (record-get [:ref :ipld.car/pack] p :error)]
    (if (= e :none) (result-ok-of [:result :string :keyword] (record-get [:ref :ipld.car/pack] p :root))
      (result-err-of [:result :string :keyword] e))))

(defn encode-large [version :i64 flat :vector-i64] [:result :vector-i64 :keyword]
 (let [p (build version flat max-large-pack-bytes) e (record-get [:ref :ipld.car/pack] p :error)]
  (if (= e :none) (result-ok-of [:result :vector-i64 :keyword] (record-get [:ref :ipld.car/pack] p :bytes))
   (result-err-of [:result :vector-i64 :keyword] e))))
(defn root-cid-large [version :i64 flat :vector-i64] [:result :string :keyword]
 (let [p (build version flat max-large-pack-bytes) e (record-get [:ref :ipld.car/pack] p :error)]
  (if (= e :none) (result-ok-of [:result :string :keyword] (record-get [:ref :ipld.car/pack] p :root))
   (result-err-of [:result :string :keyword] e))))
