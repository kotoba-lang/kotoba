{:paths ["src"]
 ;; CAR is a byte container for blocks io-ipld already knows how to make:
 ;; multiformats supplies CIDv1 assembly + base32, io-ipld the DAG-CBOR header
 ;; and the tag-42 root links. This repo owns framing, offsets and the index.
 :deps {
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}
        io.github.kotoba-lang/io-ipld {:local/root "../kotoba.ioIpld"}
        io.github.kotoba-lang/io-multiformats {:local/root "../kotoba.ioMultiformats"}}
 :aliases
 {:test {:extra-paths ["test"]}}}
