{:paths ["src"]
 ;; The opt-in tier. byoubu and byoubu-ui deliberately never reach the render
 ;; stack — a page that wants a plate and legible text must not inherit it.
 ;; This repo is where an app opts INTO the GPU, so the dependency lives here
 ;; and nowhere upstream of it.
 ;;
 ;; kami.wgsl is the WGSL-as-data SSoT (zero browser deps, .cljc — which is
 ;; what lets shader generation be unit-tested without a GPU). kami.webgpu is
 ;; the canonical browser executor; it is a :local/root sibling because that is
 ;; how the whole kami stack wires itself.
 :deps {
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}
        io.github.kotoba-lang/byoubu {:local/root "../kotoba.byoubu"}
        io.github.kotoba-lang/wgsl {:local/root "../kotoba.wgsl"}
        io.github.kotoba-lang/expr {:local/root "../kotoba.expr"}}
 :aliases
 {;; The browser half only. Split out so `kbb -M:test` — which runs the

  :test {:extra-paths ["test"]}
}}
