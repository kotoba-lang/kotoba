;; Browser build for the tier-2 demo. Sibling checkouts come from deps.edn's
;; :browser alias (kami.webgpu and its 22 :local/root siblings).
{:deps  {:aliases [:browser]}
 :builds
 {:demo
  {:target     :browser
   :output-dir "public/js"
   :asset-path "/js"
   :modules    {:demo {:init-fn byoubu-gpu.demo/init!}}
   :release    {:compiler-options {:optimizations :advanced}}
   :devtools   {:http-root "public" :http-port 8793}}}}
