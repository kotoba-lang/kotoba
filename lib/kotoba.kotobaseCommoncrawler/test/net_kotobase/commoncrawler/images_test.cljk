(ns net-kotobase.commoncrawler.images-test
  "Tests for net-kotobase.commoncrawler.images"
  (:require [clojure.test :refer :all]
            [net-kotobase.commoncrawler.images :as images]))

(deftest test-extract-image-src
  (let [img-tag "<img src='http://example.com/image.jpg' alt='Test'>"]
    (is (= "http://example.com/image.jpg" (images/extract-image-src img-tag))))
  (let [img-tag "<img alt='Test'>"]
    (is (nil? (images/extract-image-src img-tag)))))

(deftest test-extract-image-alt
  (let [img-tag "<img src='http://example.com/image.jpg' alt='Test image'>"]
    (is (= "Test image" (images/extract-image-alt img-tag))))
  (let [img-tag "<img src='http://example.com/image.jpg'>"]
    (is (nil? (images/extract-image-alt img-tag)))))

(deftest test-extract-images
  (let [html-content "<html><body><img src='http://example.com/img1.jpg' alt='Image 1'><img src='http://example.com/img2.jpg' alt='Image 2'></body></html>"]
    (let [images (images/extract-images html-content)]
      (is (= 2 (count images)))
      (is (= "http://example.com/img1.jpg" (:src (nth images 0))))
      (is (= "Image 1" (:alt (nth images 0))))
      (is (= "http://example.com/img2.jpg" (:src (nth images 1))))
      (is (= "Image 2" (:alt (nth images 1)))))))
