(ns net-kotobase.commoncrawler.html-test
  "Tests for net-kotobase.commoncrawler.html"
  (:require [clojure.test :refer :all]
            [net-kotobase.commoncrawler.html :as html]))

(deftest test-extract-title
  (let [html-content "<html><head><title>Example Title</title></head><body>...</body></html>"]
    (is (= "Example Title" (html/extract-title html-content))))
  (let [html-content "<html><head></head><body>...</body></html>"]
    (is (nil? (html/extract-title html-content)))))

(deftest test-extract-links
  (let [html-content "<html><body><a href='http://link1.com'>Link 1</a><a href='http://link2.com'>Link 2</a></body></html>"]
    (is (= ["http://link1.com" "http://link2.com"] (html/extract-links html-content))))
  (let [html-content "<html><body>No links here</body></html>"]
    (is (empty? (html/extract-links html-content)))))

(deftest test-extract-content
  (let [html-content "<html><head><title>Test Page</title><meta name='description' content='Test desc'></head><body><a href='http://link.com'>Link</a></body></html>"]
    (let [result (html/extract-content html-content)]
      (is (= "Test Page" (:title result)))
      (is (= ["http://link.com"] (:links result)))
      (is (map? (:meta-tags result)))
      (is (map? (:opengraph result))))))
