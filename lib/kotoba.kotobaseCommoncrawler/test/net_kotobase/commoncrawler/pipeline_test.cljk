(ns net-kotobase.commoncrawler.pipeline-test
  "Tests for net-kotobase.commoncrawler.pipeline"
  (:require [clojure.test :refer :all]
            [net-kotobase.commoncrawler.pipeline :as pipeline]))

(deftest test-pipeline-functions-exist
  (testing "process-warc-content function exists"
    (is (fn? pipeline/process-warc-content)))
  (testing "process-html-content function exists"
    (is (fn? pipeline/process-html-content)))
  (testing "pipeline-to-datom-log function exists"
    (is (fn? pipeline/pipeline-to-datom-log))))
