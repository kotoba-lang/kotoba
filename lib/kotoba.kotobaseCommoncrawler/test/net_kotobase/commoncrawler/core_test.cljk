(ns net-kotobase.commoncrawler.core-test
  "Tests for net-kotobase.commoncrawler.core"
  (:require [clojure.test :refer :all]
            [net-kotobase.commoncrawler.core :as core]
            [datom.core :as datom]))

(deftest test-warc-entity
  (let [entity (core/warc-entity "warc-1" "cc-main-2024-51.warc.gz" 12345 678 "http://example.com" "20240101120000")]
    (is (= "cc-main-2024-51.warc.gz" (:commoncrawl.warc/warc-filename entity)))
    (is (= 12345 (:commoncrawl.warc/offset entity)))
    (is (= 678 (:commoncrawl.warc/length entity)))
    (is (= "http://example.com" (:commoncrawl.warc/url entity)))
    (is (= "20240101120000" (:commoncrawl.warc/timestamp entity)))))

(deftest test-html-entity
  (let [entity (core/html-entity "html-1" "http://example.com" "Example Title" "Extracted content" ["http://link1.com" "http://link2.com"] {:meta "data"})]
    (is (= "http://example.com" (:commoncrawl.html/url entity)))
    (is (= "Example Title" (:commoncrawl.html/title entity)))
    (is (= "Extracted content" (:commoncrawl.html/content entity)))
    (is (= ["http://link1.com" "http://link2.com"] (:commoncrawl.html/links entity)))
    (is (= {:meta "data"} (:commoncrawl.html/metadata entity)))))

(deftest test-image-entity
  (let [entity (core/image-entity "image-1" "http://example.com/image.jpg" "Example image" "<img src='...'>" "http://example.com")]
    (is (= "http://example.com/image.jpg" (:commoncrawl.image/url entity)))
    (is (= "Example image" (:commoncrawl.image/alt-text entity)))
    (is (= "<img src='...'>" (:commoncrawl.image/html-element entity)))
    (is (= "http://example.com" (:commoncrawl.image/page-url entity)))))

(deftest test-capture-entity
  (let [entity (core/capture-entity "capture-1" "http://example.com" "20240101120000" "cc-main-2024-51.warc.gz" 12345 678 "200")]
    (is (= "http://example.com" (:commoncrawl.capture/url entity)))
    (is (= "20240101120000" (:commoncrawl.capture/timestamp entity)))
    (is (= "cc-main-2024-51.warc.gz" (:commoncrawl.capture/warc-filename entity)))
    (is (= 12345 (:commoncrawl.capture/offset entity)))
    (is (= 678 (:commoncrawl.capture/length entity)))
    (is (= "200" (:commoncrawl.capture/status entity)))))

(deftest test-log
  (let [entities [(core/warc-entity "warc-1" "cc-main-2024-51.warc.gz" 12345 678 "http://example.com" "20240101120000")
                  (core/html-entity "html-2" "http://example.com" "Example Title" "Extracted content" [] {})]
        log-result (core/log entities)]
    (is (= 2 (count (:tx log-result))))
    (is (>= (count (:datoms log-result)) 0))
    (is (> (:count log-result) 0))))
