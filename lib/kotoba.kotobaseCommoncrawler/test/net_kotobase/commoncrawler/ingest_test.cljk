(ns net-kotobase.commoncrawler.ingest-test
  "Tests for net-kotobase.commoncrawler.ingest"
  (:require [clojure.test :refer :all]
            [net-kotobase.commoncrawler.ingest :as ingest]))

(deftest test-default-crawl
  (is (= "CC-MAIN-2024-51" ingest/default-crawl)))

(deftest test-index-query-exists
  (is (fn? ingest/index-query)))

(deftest test-observe-exists
  (is (fn? ingest/observe)))
