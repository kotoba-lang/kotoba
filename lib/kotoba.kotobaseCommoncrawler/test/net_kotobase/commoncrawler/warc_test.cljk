(ns net-kotobase.commoncrawler.warc-test
  "Tests for net-kotobase.commoncrawler.warc"
  (:require [clojure.test :refer :all]
            #?(:clj [net-kotobase.commoncrawler.warc :as warc])))

(deftest test-range-fetch-text-exists
  #?(:clj
     (testing "range-fetch-text function exists"
       (is (fn? warc/range-fetch-text)))
     :cljs
     (testing "cljs range-fetch-text not implemented")))

(deftest test-gunzip-bytes-exists
  #?(:clj
     (testing "gunzip-bytes function exists"
       (is (fn? warc/gunzip-bytes)))
     :cljs
     (testing "cljs gunzip-bytes not implemented")))
