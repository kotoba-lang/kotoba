(ns net-kotobase.commoncrawler.embeddings-test
  "Tests for net-kotobase.commoncrawler.embeddings"
  (:require [clojure.test :refer :all]
            [net-kotobase.commoncrawler.embeddings :as embeddings]))

(deftest test-cosine-similarity
  (testing "cosine similarity of identical vectors is 1.0"
    (let [vec1 [1.0 2.0 3.0]
          vec2 [1.0 2.0 3.0]]
      (is (= 1.0 (embeddings/cosine-similarity vec1 vec2)))))
  (testing "cosine similarity of orthogonal vectors is 0.0"
    (let [vec1 [1.0 0.0]
          vec2 [0.0 1.0]]
      (is (= 0.0 (embeddings/cosine-similarity vec1 vec2)))))
  (testing "cosine similarity of opposite vectors is -1.0"
    (let [vec1 [1.0 2.0 3.0]
          vec2 [-1.0 -2.0 -3.0]]
      (is (= -1.0 (embeddings/cosine-similarity vec1 vec2))))))

(deftest test-generate-embeddings-exists
  #?(:clj
     (testing "generate-embeddings function exists"
       (is (fn? embeddings/generate-embeddings)))
     :cljs
     (testing "cljs generate-embeddings not implemented")))

(deftest test-vector-search-exists
  #?(:clj
     (testing "vector-search function exists"
       (is (fn? embeddings/vector-search)))
     :cljs
     (testing "cljs vector-search not implemented")))
