(ns net-kotobase.commoncrawler.core
  "CommonCrawl Datom-log representation — EAVT, Datomic-isomorphic, the same shape
  the kotoba Datom-log actors speak. Shared by every actor that datafies
  CommonCrawl results so webpages, documents, images … all land as queryable
  facts on one log.

  Two views from one entity map:
    • `entity` — a Datomic transaction map  {:domain.Kind/id .. :domain.Kind/a ..}
    • `eavt`   — flat [e a v] tuples, the Datom-log view ('datom 化')

  Purpose: DATA REPRESENTATION only. No parsing logic, no extraction logic —
  those live in warc.cljc, html.cljc, images.cljc respectively."
  (:require [kotoba.lang.text :as str]
            [datom.core :as datom]))

(defn warc-entity
  "Create a WARC entity (tx-map). `id` is the unique identity, `warc-filename` is the WARC file name,
  `offset` is the record offset, `length` is the record length, `url` is the
  captured URL, `timestamp` is the capture timestamp."
  [id warc-filename offset length url timestamp]
  (datom/entity
    :commoncrawl
    :warc
    id
    {:warc-filename warc-filename
     :offset offset
     :length length
     :url url
     :timestamp timestamp}))

(defn html-entity
  "Create an HTML entity (tx-map). `id` is the unique identity, `url` is the page URL, `title` is the page title,
  `content` is the extracted text content, `links` are the extracted links,
  `metadata` are the meta tags and OpenGraph data."
  [id url title content links metadata]
  (datom/entity
    :commoncrawl
    :html
    id
    {:url url
     :title title
     :content content
     :links links
     :metadata metadata}))

(defn image-entity
  "Create an image entity (tx-map). `id` is the unique identity, `url` is the image URL, `alt-text` is the alt text,
  `html-element` is the HTML element that referenced the image, `page-url` is the
  page URL that contained this image."
  [id url alt-text html-element page-url]
  (datom/entity
    :commoncrawl
    :image
    id
    {:url url
     :alt-text alt-text
     :html-element html-element
     :page-url page-url}))

(defn capture-entity
  "Create a capture entity (tx-map). `id` is the unique identity, `url` is the captured URL, `timestamp` is the
  capture timestamp, `warc-filename` is the WARC file name, `offset` is the record
  offset, `length` is the record length, `status` is the HTTP status code."
  [id url timestamp warc-filename offset length status]
  (datom/entity
    :commoncrawl
    :capture
    id
    {:url url
     :timestamp timestamp
     :warc-filename warc-filename
     :offset offset
     :length length
     :status status}))

(defn log
  "Collect entity tx-maps into {:tx [..] :datoms [..] :count n}."
  [entities]
  (datom/log entities))
