(ns net-kotobase.commoncrawler.actor.state
  "State definition for the CommonCrawl ingestion actor (langgraph-clj StateGraph)."
  (:require [kotoba.lang.text :as str]))

(defn initial-state
  "Return the initial state map for the ingestion graph."
  []
  {:checkpoint       {:crawl-id "CC-MAIN-2024-51"
                     :pattern    "example.com/*"
                     :last-warc  nil
                     :last-offset 0}
   :pending-captures []
   :processing-node  :fetch-captures
   :extracted-data   nil
   :embedding-entity nil
   :datom-log        nil
   :status           :pending})
