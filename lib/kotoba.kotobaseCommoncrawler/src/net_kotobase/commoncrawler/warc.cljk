(ns net-kotobase.commoncrawler.warc
  "WARC (Web ARChive) file parsing and range-fetch utilities for CommonCrawl data.
  Handle gzip-compressed WARC records and support range-fetching from
  CommonCrawl data storage."
  (:require [kotoba.bytes :as kbytes] [kotoba.lang.text :as str])
  #?(:clj (:import (java.net URI)
                   (java.net.http HttpClient HttpRequest
                                  HttpRequest$BodyPublishers HttpResponse$BodyHandlers)
                   (java.io ByteArrayInputStream)
                   (java.util.zip GZIPInputStream)
                   (java.time Duration))))

(defn- parse-warc-header
  "Parse WARC header line to extract WARC type and WARC record ID."
  [header-line]
  (let [parts (str/split header-line #"\s+")]
    (when (= (first parts) "WARC/1.0")
      (let [type (nth parts 1 nil)
            id-idx (str/index-of header-line "WARC-Type:")
            type-line (when id-idx
                        (let [start (+ id-idx 10)
                              end (str/index-of header-line "\r\n" start)]
                          (str/trim (subs header-line start end))))
            id-idx-2 (str/index-of header-line "WARC-Record-ID:")
            id-line (when id-idx-2
                      (let [start (+ id-idx-2 15)
                            end (str/index-of header-line "\r\n" start)]
                        (str/trim (subs header-line start end))))]
        {:type type
         :id id-line
         :raw header-line}))))

(defn- extract-warc-fields
  "Extract WARC fields from WARC header lines."
  [header-lines]
  (loop [fields {} lines header-lines]
    (if (empty? lines)
      fields
      (let [line (first lines)
            fields (if (str/starts-with? line "WARC-Type:")
                     (assoc fields :type (str/trim (subs line 10)))
                     fields)]
        (let [fields (if (str/starts-with? line "WARC-Record-ID:")
                       (assoc fields :id (str/trim (subs line 15)))
                       fields)]
          (let [fields (if (str/starts-with? line "WARC-Payload-Digest:")
                         (assoc fields :payload-digest (str/trim (subs line 19)))
                         fields)]
            (let [fields (if (str/starts-with? line "WARC-Target-URI:")
                           (assoc fields :url (str/trim (subs line 16)))
                           fields)]
              (let [fields (if (str/starts-with? line "WARC-Date:")
                             (assoc fields :timestamp (str/trim (subs line 10)))
                             fields)]
                (recur fields (rest lines))))))))))

(defn parse-warc-record
  "Parse a WARC record (text or bytes) to extract header fields and content.
  Returns a map with :header-fields, :content-type, :content."
  [warc-content]
  (let [content-str (if (bytes? warc-content)
                      (kbytes/utf8-string warc-content)
                      warc-content)
        ;; Split by CRLF CRLF to separate header from content
        parts (str/split content-str #"\r\n\r\n")]
    (if (>= (count parts) 2)
      (let [header-part (first parts)
            content-part (nth parts 1)]
        (let [header-lines (str/split-lines header-part)
              fields (extract-warc-fields header-lines)]
          {:fields fields
           :content content-part}))
      {:fields {}
       :content content-str})))

#?(:clj
   (defn- create-http-client
     "Create an HTTP client for range requests."
     []
     (-> (HttpClient/newBuilder)
         (.connectTimeout (Duration/ofSeconds 10))
         (.build))))

#?(:clj
   (defn range-fetch
     "GET a byte range and return as bytes — for fetching a single
     gzip'd WARC record from data.commoncrawl.org (each record is its own gzip
     member, so the range IS a complete gzip stream). Returns the byte content
     or nil on a non-2xx."
     [url off len]
     (let [client (create-http-client)
           b (-> (HttpRequest/newBuilder (URI/create url))
                 (.header "range" (str "bytes=" off "-" (+ off len -1)))
                 (.timeout (Duration/ofSeconds 40))
                 (.GET)
                 (.build))
           rs (.send client b (HttpResponse$BodyHandlers/ofByteArray))]
       (when (#{200 206} (.statusCode rs))
         (.body rs)))))

#?(:clj
   (defn gunzip-bytes
     "Gunzip byte content to UTF-8 string."
     [byte-content]
     (when byte-content
       (with-open [g (GZIPInputStream. (ByteArrayInputStream. byte-content))]
         (slurp g)))))

#?(:clj
   (defn range-fetch-text
     "GET a byte range and gunzip it to a UTF-8 string — for fetching a single
     gzip'd WARC record from data.commoncrawl.org (each record is its own gzip
     member, so the range IS a complete gzip stream). Returns the decoded record
     text (WARC + HTTP headers + payload), or nil on a non-2xx."
     [url off len]
     (when-let [bytes (range-fetch url off len)]
       (gunzip-bytes bytes))))
