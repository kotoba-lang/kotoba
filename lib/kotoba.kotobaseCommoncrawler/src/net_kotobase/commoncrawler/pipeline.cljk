(ns net-kotobase.commoncrawler.pipeline
  "Unified ingestion pipeline for CommonCrawl data.
  This component orchestrates the flow from WARC/HTML content to datom-log entities
  with embeddings, connecting LLM extraction (murakumo), embedding generation (embeddings),
  and datom-log entity creation (core)."
  (:require [kotoba.lang.text :as str]
            [net-kotobase.commoncrawler.core :as core]
            [net-kotobase.commoncrawler.murakumo :as murakumo]
            [net-kotobase.commoncrawler.embeddings :as embeddings]
            [datom.core :as datom]))

(defn process-warc-content
  "Process WARC content through the unified pipeline:
  1. Extract structured data using murakumo LLM
  2. Generate embeddings for extracted content
  3. Create datom-log entities with embedding data"
  [murakumo-cfg warc-content url]
  (let [extracted-data (murakumo/extract-content-with-llm murakumo-cfg warc-content "WARC")
        text-for-embedding (or (get extracted-data :content) warc-content)
        embedding-entity (embeddings/content-to-embedding-entity (str "embed-" url) extracted-data text-for-embedding)
        html-entity (core/html-entity (str "html-" url) (or (get extracted-data :url) url) (or (get extracted-data :title) "Untitled") (or (get extracted-data :content) "") (or (get extracted-data :links) []) (or (get extracted-data :metadata) {}))
        image-entities (mapv (fn [img-data idx]
                               (core/image-entity (str "image-" idx) (or (get img-data :url) "unknown-url") (or (get img-data :alt) "") "" (or (get extracted-data :url) url)))
                             (or (get extracted-data :images) [])
                             (range (count (or (get extracted-data :images) []))))]
    {:extracted-data extracted-data
     :embedding-entity embedding-entity
     :html-entity html-entity
     :image-entities image-entities}))

(defn process-html-content
  "Process HTML content through the unified pipeline:
  1. Extract structured data using murakumo LLM
  2. Generate embeddings for extracted content
  3. Create datom-log entities with embedding data"
  [murakumo-cfg html-content url]
  (let [extracted-data (murakumo/extract-content-with-llm murakumo-cfg html-content "HTML")
        text-for-embedding (or (get extracted-data :content) html-content)
        embedding-entity (embeddings/content-to-embedding-entity (str "embed-" url) extracted-data text-for-embedding)
        html-entity (core/html-entity (str "html-" url) (or (get extracted-data :url) url) (or (get extracted-data :title) "Untitled") (or (get extracted-data :content) "") (or (get extracted-data :links) []) (or (get extracted-data :metadata) {}))
        image-entities (mapv (fn [img-data idx]
                               (core/image-entity (str "image-" idx) (or (get img-data :url) "unknown-url") (or (get img-data :alt) "") "" (or (get extracted-data :url) url)))
                             (or (get extracted-data :images) [])
                             (range (count (or (get extracted-data :images) []))))]
    {:extracted-data extracted-data
     :embedding-entity embedding-entity
     :html-entity html-entity
     :image-entities image-entities}))

(defn pipeline-to-datom-log
  "Convert pipeline results to datom-log format."
  [{:keys [html-entity image-entities embedding-entity]}]
  (let [entities [html-entity]
        image-ent-entities (if (seq image-entities) image-entities [])
        all-entities (concat entities image-ent-entities)]
    (core/log all-entities)))
