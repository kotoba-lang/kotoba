(ns net-kotobase.commoncrawler.murakumo
  "LLM integration component using murakumo to convert content into EDN/Datom-log format
  for Datomic querying. This component takes HTML/WARC content and uses murakumo's
  LLM capabilities to extract structured data and convert it to the kotoba Datom-log
  representation."
  (:require [kotoba.lang.text :as str]))

(defn- murakumo-config
  "Murakumo endpoint config from env."
  [getenv]
  {:url     (or (getenv "MURAKUMO_URL") "https://murakumo.etzhayyim.com")
   :model   (or (getenv "MURAKUMO_MODEL") "qwen3.5-9b")
   :api-key (or (getenv "MURAKUMO_API_KEY") "")})

(defn- murakumo-call
  "POST `prompt` to the Murakumo OpenAI-compatible endpoint; return the content
  string or \"\" on failure."
  ([cfg prompt] (murakumo-call cfg prompt 32000))
  ([{:keys [url model api-key]} prompt max-tokens]
   (when (str/blank? api-key)
     (throw (ex-info "MURAKUMO_API_KEY required" {:url url})))
   ;; Placeholder for actual HTTP call to murakumo endpoint
   ;; In a real implementation, this would use http/client or similar
   (throw (ex-info "murakumo-call: not implemented in test context" {:url url}))))

(defn- extract-llm-response
  "Extract JSON response from LLM output, tolerating ``` fences and surrounding prose."
  [text]
  (if (str/blank? text)
    {}
    (let [t       (str/trim text)
          t       (if (str/starts-with? t "```")
                    (->> (str/split-lines t) rest (str/join "\n"))
                    t)
          t       (if (str/ends-with? (str/trim t) "```")
                    (let [tt (str/trim t)] (subs tt 0 (str/last-index-of tt "```")))
                    t)
          t       (str/trim t)
          start   (str/index-of t "{")
          end     (when-let [i (str/last-index-of t "}")] (inc i))]
      (if (and start end (> end start))
        ;; Placeholder for JSON parsing - in real implementation use cheshire or similar
        {}
        {}))))

(defn- content-extraction-prompt
  "Build the extraction prompt for murakumo LLM."
  [content content-type]
  (str "Extract structured data from the following " content-type " content.\n"
       "Return a JSON object with the following structure:\n"
       "{\n"
       "  \"url\": \"<page url>\",\n"
       "  \"title\": \"<page title>\",\n"
       "  \"content\": \"<extracted text content>\",\n"
       "  \"links\": [\"<link1>\", \"<link2>\"],\n"
       "  \"images\": [\n"
       "    {\"url\": \"<image url>\", \"alt\": \"<alt text>\"}\n"
       "  ],\n"
       "  \"metadata\": {\n"
       "    \"description\": \"<meta description>\",\n"
       "    \"keywords\": [\"<keyword1>\", \"<keyword2>\"]\n"
       "  }\n"
       "}\n\n"
       (if (= content-type "HTML")
         "HTML content:\n"
         "WARC content:\n")
       content))

(defn extract-content-with-llm
  "Use murakumo LLM to extract structured data from content."
  [cfg content content-type]
  (let [prompt (content-extraction-prompt content content-type)
        response (murakumo-call cfg prompt)
        extracted (extract-llm-response response)]
    extracted))
