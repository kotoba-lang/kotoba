(ns net-kotobase.commoncrawler.images
  "Image URL extraction and metadata capture for CommonCrawl data.
  Extract image URLs from HTML, capture image metadata (alt text, dimensions if available),
  store image references as entities."
  (:require [kotoba.lang.text :as str]))

(defn extract-image-tags
  "Extract image tags from HTML content."
  [html-content]
  (let [img-tags (re-seq #"<img[^>]+>" html-content)]
    img-tags))

(defn extract-image-src
  "Extract src attribute from image tag."
  [img-tag]
  (when-let [src-m (re-find #"src=['\"]([^'\"]+)['\"]" img-tag)]
    (nth src-m 1)))

(defn extract-image-alt
  "Extract alt attribute from image tag."
  [img-tag]
  (when-let [alt-m (re-find #"alt=['\"]([^'\"]*)['\"]" img-tag)]
    (nth alt-m 1)))

(defn extract-image-width
  "Extract width attribute from image tag."
  [img-tag]
  (when-let [width-m (re-find #"width=['\"]([^'\"]+)['\"]" img-tag)]
    (nth width-m 1)))

(defn extract-image-height
  "Extract height attribute from image tag."
  [img-tag]
  (when-let [height-m (re-find #"height=['\"]([^'\"]+)['\"]" img-tag)]
    (nth height-m 1)))

(defn extract-image-data
  "Extract all image data from an image tag."
  [img-tag]
  {:src (extract-image-src img-tag)
   :alt (extract-image-alt img-tag)
   :width (extract-image-width img-tag)
   :height (extract-image-height img-tag)
   :raw-tag img-tag})

(defn extract-images
  "Extract all images from HTML content."
  [html-content]
  (let [img-tags (extract-image-tags html-content)]
    (mapv extract-image-data img-tags)))

(defn extract-image-urls
  "Extract just the image URLs from HTML content."
  [html-content]
  (let [images (extract-images html-content)]
    (mapv :src images)))

(defn image-metadata
  "Create a metadata map for an image based on HTML context."
  [img-data page-url]
  {:url (:src img-data)
   :alt-text (:alt img-data)
   :width (:width img-data)
   :height (:height img-data)
   :page-url page-url
   :source "commoncrawl"})
