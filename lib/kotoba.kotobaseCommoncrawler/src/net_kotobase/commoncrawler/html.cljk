(ns net-kotobase.commoncrawler.html
  "HTML document extraction and text normalization for CommonCrawl data.
  Extract text content from HTML, preserve metadata (title, meta tags, OpenGraph data),
  extract links and structure, handle different character encodings."
  (:require [kotoba.lang.text :as str]))

(defn extract-title
  "Extract title from HTML content."
  [html-content]
  (when-let [m (re-find #"<title[^>]*>([^<]+)</title>" html-content)]
    (str/trim (nth m 1))))

(defn extract-meta-tags
  "Extract meta tags from HTML content."
  [html-content]
  (let [tags (re-seq #"<meta[^>]+>" html-content)]
    (loop [acc {} tags tags]
      (if (empty? tags)
        acc
        (let [tag (first tags)
              acc (if-let [name-m (re-find #"name=\"([^\"]+)\"" tag)]
                   (let [name (nth name-m 1)
                         value-m (re-find #"content=\"([^\"]+)\"" tag)]
                     (if value-m
                       (assoc acc name (nth value-m 1))
                       acc))
                   acc)]
          (let [acc (if-let [property-m (re-find #"property=\"([^\"]+)\"" tag)]
                      (let [property (nth property-m 1)
                            value-m (re-find #"content=\"([^\"]+)\"" tag)]
                        (if value-m
                          (assoc acc (str "og:" property) (nth value-m 1))
                          acc))
                      acc)]
            (let [acc (if-let [http-equiv-m (re-find #"http-equiv=\"([^\"]+)\"" tag)]
                        (let [http-equiv (nth http-equiv-m 1)
                              content-m (re-find #"content=\"([^\"]+)\"" tag)]
                          (if content-m
                            (assoc acc (str "http-equiv:" http-equiv) (nth content-m 1))
                            acc))
                        acc)]
              (recur acc (rest tags)))))))))

(defn extract-links
  "Extract links from HTML content."
  [html-content]
  (let [link-tags (re-seq #"<a[^>]+href=['\"]([^'\"]+)['\"][^>]*>" html-content)]
    (mapv #(nth % 1) link-tags)))

(defn extract-opengraph-data
  "Extract OpenGraph data from HTML content."
  [html-content]
  (let [meta-tags (re-seq #"<meta[^>]+>" html-content)
        og-data (reduce
                 (fn [acc tag]
                   (when-let [property-m (re-find #"property=\"og:([^\"]+)\"" tag)]
                     (let [property (nth property-m 1)
                           value-m (re-find #"content=\"([^\"]+)\"" tag)]
                       (if value-m
                         (assoc acc property (nth value-m 1))
                         acc)))
                   acc)
                 {} meta-tags)]
    og-data))

(defn extract-content
  "Extract text content, metadata, links, and OpenGraph data from HTML content."
  [html-content]
  {:title (extract-title html-content)
   :meta-tags (extract-meta-tags html-content)
   :links (extract-links html-content)
   :opengraph (extract-opengraph-data html-content)
   :raw-content html-content})

(defn normalize-content
  "Normalize extracted HTML content: remove scripts, styles, and other non-content elements."
  [html-content]
  ;; Placeholder for actual HTML normalization
  ;; In a real implementation, this would use an HTML parser like htmler or similar
  (str/replace html-content #"<script[^>]*>.*?</script>" "")
  (str/replace html-content #"<style[^>]*>.*?</style>" "")
  (str/replace html-content #"<[^>]+>" " "))
