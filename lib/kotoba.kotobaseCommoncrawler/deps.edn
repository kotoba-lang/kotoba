{:paths ["src"]
 ;; Local roots replace the git pins on repositories bundled in this monorepo.
 ;; kotobase.store (IStore) is not bundled here yet, so kotoba-lang/kotobase stays pinned.
 :deps {
        io.github.kotoba-lang/bytes {:local/root "../kotoba.bytes"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}
        io.github.kotoba-lang/datom {:local/root "../kotoba.datom"}
        io.github.kotoba-lang/kotobase {:git/url "https://github.com/kotoba-lang/kotobase.git"
                                        :git/sha "cbb89551800ab358ed0412a91cf5c3aa258b8c27"}}
 :aliases
 {:test {:extra-paths ["test"]}
  :worker {:main-opts ["-m" "net-kotobase.commoncrawler.worker"]}}}
