(ns wise.quotes
  "Kotoba port of the product semantics of wise.quotes/create-quote!:
  creating a quote under a profile is a POST to /v3/profiles/<id>/quotes.
  The request is expressed as an inert request value (ADR-2607279200
  decision 5, row 2: portable effectful application logic) -- the actual
  HTTP call, auth headers and JSON encoding stay host-side in
  wise.client/request!. The original .cljc remains the oracle until a
  human retires it; this file is not required from it."
  (:schemas {:wise/request [:record :wise/request
                            [[:path :string] [:method :string]]]})
  (:export [quote-request-path quote-request-method quote-request]))

;; Parity: test/wise/quotes_kotoba_parity_test.cljk

(defn quote-request-path [profile-id :string] :string
  ;; cljc: (str "/v3/profiles/" profile-id "/quotes")
  (string-concat "/v3/profiles/" (string-concat profile-id "/quotes")))

(defn quote-request-method [] :string
  ;; cljc: (assoc http-opts :method :post ...)
  "POST")

(defn quote-request [profile-id :string] [:ref :wise/request]
  ;; The whole quote-creation request as data. The :body (the Wise quote
  ;; request map) is JSON-encoded host-side by wise.client/request!.
  (record-new [:ref :wise/request]
              (quote-request-path profile-id)
              (quote-request-method)))
