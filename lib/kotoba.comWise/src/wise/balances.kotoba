(ns wise.balances
  "Kotoba port of the product semantics of wise.balances/list-balances:
  listing a profile's balances is a GET to /v4/profiles/<id>/balances with
  the query filter types=STANDARD (the balances endpoint's STANDARD types).
  The request is expressed as an inert request value (ADR-2607279200
  decision 5, row 2: portable effectful application logic) -- the actual
  HTTP call, auth headers and JSON encoding stay host-side in
  wise.client/request!. The original .cljc remains the oracle until a human
  retires it; this file is not required from it."
  (:schemas {:wise/balances-request [:record :wise/balances-request
                                     [[:path :string] [:method :string] [:query :string]]]})
  (:export [list-balances-path list-balances-method list-balances-query
            list-balances-request]))

;; Parity: test/wise/balances_kotoba_parity_test.cljk

(defn list-balances-path [profile-id :string] :string
  ;; cljc: (str "/v4/profiles/" profile-id "/balances")
  (string-concat "/v4/profiles/" (string-concat profile-id "/balances")))

(defn list-balances-method [] :string
  ;; cljc: (client/request! path http-opts) -- default method :get
  "GET")

(defn list-balances-query [] :string
  ;; cljc: (assoc http-opts :query {:types "STANDARD"}) -> url "?types=STANDARD"
  "types=STANDARD")

(defn list-balances-request [profile-id :string] [:ref :wise/balances-request]
  (record-new [:ref :wise/balances-request]
              (list-balances-path profile-id)
              (list-balances-method)
              (list-balances-query)))