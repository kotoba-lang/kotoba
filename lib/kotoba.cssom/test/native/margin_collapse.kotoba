(ns css-margin-collapse-test
  (:require [cssom.margin-collapse :as margins])
  (:export [main]))
(defn eq [state [:ref :cssom.margin/state] expected :f64] :bool
  (let [result (margins/finish state)]
    (and (option-some?-of [:option :f64] result)
         (f64-eq (option-or result 0.0) expected))))
(defn main [] :i64
  (let [zero (margins/empty-state)
        mixed (margins/add (margins/add (margins/add zero 10.25) -8.5) 5.75)
        reversed (margins/add (margins/add (margins/add zero 5.75) -8.5) 10.25)
        positives (margins/add (margins/add zero 4.5) 12.25)
        negatives (margins/add (margins/add zero -4.5) -12.25)
        infinity (margins/add zero (f64-from-bits 9218868437227405312))
        nan (margins/add zero (f64-from-bits 9221120237041090560))]
    (if (and (eq zero 0.0) (eq mixed 1.75) (eq reversed 1.75)
             (eq positives 12.25) (eq negatives -12.25)
             (not (option-some?-of [:option :f64] (margins/finish infinity)))
             (not (option-some?-of [:option :f64] (margins/finish nan)))
             (not (option-some?-of [:option :f64] (margins/finish (margins/add infinity 1.0))))) 42 0)))
