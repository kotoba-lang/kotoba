(ns q6-parse-px-vs-f64
  (:require [cssom.length-q6 :as len] [cssom.parse-px-q6 :as p])
  (:export [main]))

;; Gate for the Q6 number scanner (HOST NATIVE only, JUN-920 / C2b). The scanner has no f64 module to mirror, so there
;; are two independent oracles:
;;  1. GOLDEN: 81 strings with the expected unit and value computed OUTSIDE Kotoba with exact rational arithmetic
;;     (Python fractions: digits beyond the 6th fraction digit truncated, then round half up, range guard), 30 of
;;     them malformed or out of range (unit -1, value invalid).
;;  2. GRID versus f64: 3 signs x 7 integer parts x 20 fractions x 4 units = 1,680 strings built here with `str`,
;;     whose exact value is known from the integer parts; the f64 oracle is floor(v * scale + 1/2) on the double
;;     v = int + frac / 10^k (what a double-based parser gives). Exact ties are counted and reported separately.
;; Grammar and the truncation rule (6 significant fraction digits, the rest truncated, NOT rounded) are in
;; src/cssom/parse_px_q6.kotoba.
;; mode 0 returns 42 when everything holds, 7 otherwise. Modes: 1 golden strings ok (of 81), 2 grid strings,
;; 3 grid strings with a valid value, 4 exact ties among them, 5 tie disagreements with the f64 oracle,
;; 6 non-tie disagreements with the f64 oracle, 7 exactness violations of the Q6 parser, 8 px ties, 9 percent ties.
(def mode 0)

(defn gs [i :i64] :string
  (cond (= i 0) "12.5px" (= i 1) "-3.14159px" (= i 2) "0.1px" (= i 3) "13.3333px" (= i 4) "100" (= i 5) "+7.999px" (= i 6) "16777215.99px" (= i 7) "16777216px" (= i 8) "16777216.01px" (= i 9) "16777217px" (= i 10) "0.0078125px" (= i 11) "0.0078126px" (= i 12) "0.0078120px" (= i 13) "0.0234375px" (= i 14) "11.6667px" (= i 15) "1.5" (= i 16) "33.33px" (= i 17) "0.5px" (= i 18) "0.515625px" (= i 19) "-0.5px" (= i 20) "-0.0078125px" (= i 21) "-0.0234375px" (= i 22) "-1.5px" (= i 23) "-0.5" (= i 24) "0.75px" (= i 25) "1." (= i 26) "1.px" (= i 27) ".5px" (= i 28) ".5" (= i 29) "-.5px" (= i 30) "+.25%" (= i 31) "29%" (= i 32) "12.345%" (= i 33) "-12.345%" (= i 34) "0.005%" (= i 35) "0.004999%" (= i 36) "655.35%" (= i 37) "655.355%" (= i 38) "655.36%" (= i 39) "-655.35%" (= i 40) "100%" (= i 41) "0%" (= i 42) "007px" (= i 43) "1.000000001px" (= i 44) "1.9999999px" (= i 45) "PX" (= i 46) "5PX" (= i 47) "5Px" (= i 48) "5pX" (= i 49) "1e3px" (= i 50) "- 1px" (= i 51) "" (= i 52) "px" (= i 53) "%" (= i 54) "+" (= i 55) "-" (= i 56) "." (= i 57) "+." (= i 58) "-.px" (= i 59) ".px" (= i 60) "abc" (= i 61) "1.2.3px" (= i 62) "1 px" (= i 63) " 1px" (= i 64) "1px " (= i 65) "1em" (= i 66) "1pxx" (= i 67) "--1" (= i 68) "+-1" (= i 69) "1e3" (= i 70) "0x10" (= i 71) "1%%" (= i 72) "1p" (= i 73) "1x" (= i 74) "12px3" (= i 75) "1%px" (= i 76) "999999999px" (= i 77) "16777217" (= i 78) "-16777217px" (= i 79) "1.5pxx" (= i 80) "1,5px" :else ""))
(defn gu [i :i64] :i64
  (cond (= i 0) 1 (= i 1) 1 (= i 2) 1 (= i 3) 1 (= i 4) 0 (= i 5) 1 (= i 6) 1 (= i 7) 1 (= i 8) -1 (= i 9) -1 (= i 10) 1 (= i 11) 1 (= i 12) 1 (= i 13) 1 (= i 14) 1 (= i 15) 0 (= i 16) 1 (= i 17) 1 (= i 18) 1 (= i 19) 1 (= i 20) 1 (= i 21) 1 (= i 22) 1 (= i 23) 0 (= i 24) 1 (= i 25) 0 (= i 26) 1 (= i 27) 1 (= i 28) 0 (= i 29) 1 (= i 30) 2 (= i 31) 2 (= i 32) 2 (= i 33) 2 (= i 34) 2 (= i 35) 2 (= i 36) 2 (= i 37) -1 (= i 38) -1 (= i 39) 2 (= i 40) 2 (= i 41) 2 (= i 42) 1 (= i 43) 1 (= i 44) 1 (= i 45) -1 (= i 46) 1 (= i 47) 1 (= i 48) 1 (= i 49) -1 (= i 50) -1 (= i 51) -1 (= i 52) -1 (= i 53) -1 (= i 54) -1 (= i 55) -1 (= i 56) -1 (= i 57) -1 (= i 58) -1 (= i 59) -1 (= i 60) -1 (= i 61) -1 (= i 62) -1 (= i 63) -1 (= i 64) -1 (= i 65) -1 (= i 66) -1 (= i 67) -1 (= i 68) -1 (= i 69) -1 (= i 70) -1 (= i 71) -1 (= i 72) -1 (= i 73) -1 (= i 74) -1 (= i 75) -1 (= i 76) -1 (= i 77) -1 (= i 78) -1 (= i 79) -1 (= i 80) -1 :else -1))
(defn gv [i :i64] :i64
  (cond (= i 0) 800 (= i 1) -201 (= i 2) 6 (= i 3) 853 (= i 4) 6400 (= i 5) 512 (= i 6) 1073741823 (= i 7) 1073741824 (= i 8) (len/invalid) (= i 9) (len/invalid) (= i 10) 0 (= i 11) 0 (= i 12) 0 (= i 13) 1 (= i 14) 747 (= i 15) 96 (= i 16) 2133 (= i 17) 32 (= i 18) 33 (= i 19) -32 (= i 20) 0 (= i 21) -1 (= i 22) -96 (= i 23) -32 (= i 24) 48 (= i 25) 64 (= i 26) 64 (= i 27) 32 (= i 28) 32 (= i 29) -32 (= i 30) 25 (= i 31) 2900 (= i 32) 1235 (= i 33) -1234 (= i 34) 1 (= i 35) 0 (= i 36) 65535 (= i 37) (len/invalid) (= i 38) (len/invalid) (= i 39) -65535 (= i 40) 10000 (= i 41) 0 (= i 42) 448 (= i 43) 64 (= i 44) 128 (= i 45) (len/invalid) (= i 46) 320 (= i 47) 320 (= i 48) 320 (= i 49) (len/invalid) (= i 50) (len/invalid) (= i 51) (len/invalid) (= i 52) (len/invalid) (= i 53) (len/invalid) (= i 54) (len/invalid) (= i 55) (len/invalid) (= i 56) (len/invalid) (= i 57) (len/invalid) (= i 58) (len/invalid) (= i 59) (len/invalid) (= i 60) (len/invalid) (= i 61) (len/invalid) (= i 62) (len/invalid) (= i 63) (len/invalid) (= i 64) (len/invalid) (= i 65) (len/invalid) (= i 66) (len/invalid) (= i 67) (len/invalid) (= i 68) (len/invalid) (= i 69) (len/invalid) (= i 70) (len/invalid) (= i 71) (len/invalid) (= i 72) (len/invalid) (= i 73) (len/invalid) (= i 74) (len/invalid) (= i 75) (len/invalid) (= i 76) (len/invalid) (= i 77) (len/invalid) (= i 78) (len/invalid) (= i 79) (len/invalid) (= i 80) (len/invalid) :else (len/invalid)))

(defn golden-ok [i :i64] :bool
  (and (= (p/parse-unit (gs i)) (gu i)) (= (p/parse-value (gs i)) (gv i))))
(defn golden [i :i64 acc :i64] :i64 (if (= i 81) acc (golden (+ i 1) (if (golden-ok i) (+ acc 1) acc))))

(defn sign-str [i :i64] :string (cond (= i 0) "" (= i 1) "+" :else "-"))
(defn unit-str [i :i64] :string (cond (= i 0) "" (= i 1) "px" (= i 2) "%" :else "PX"))
(defn int-at [i :i64] :i64 (cond (= i 0) 0 (= i 1) 1 (= i 2) 12 (= i 3) 100 (= i 4) 12345 (= i 5) 16777215 :else 16777216))
;; fraction specs: k digits, numeric value f (k = -1: no dot at all, k = 0: a dot and no digit)
(defn fk [i :i64] :i64
  (cond (= i 0) -1 (= i 1) 0 (= i 2) 1 (= i 3) 1 (= i 4) 1 (= i 5) 2 (= i 6) 2 (= i 7) 2 (= i 8) 3 (= i 9) 3 (= i 10) 3 (= i 11) 3
        (= i 12) 4 (= i 13) 5 (= i 14) 5 (= i 15) 6 (= i 16) 6 (= i 17) 6 (= i 18) 6 :else 6))
(defn ff [i :i64] :i64
  (cond (= i 2) 0 (= i 3) 5 (= i 4) 9 (= i 5) 5 (= i 6) 50 (= i 7) 99 (= i 8) 1 (= i 9) 345 (= i 10) 500 (= i 11) 999
        (= i 12) 625 (= i 13) 1 (= i 14) 78125 (= i 15) 1 (= i 16) 15625 (= i 17) 999999 (= i 18) 500000 :else 4999))
(defn nd [f :i64] :i64 (if (< f 10) 1 (+ 1 (nd (quot f 10)))))
(defn zeros [n :i64] :string (if (<= n 0) "" (str "0" (zeros (- n 1)))))
(defn pow10 [k :i64] :i64 (if (<= k 0) 1 (* 10 (pow10 (- k 1)))))
(defn frac-str [k :i64 f :i64] :string
  (cond (< k 0) "" (= k 0) "." :else (str "." (zeros (- k (nd f))) f)))
(defn floor-i [x :f64] :i64
  (let [t (f64-to-i64-truncating x)] (if (f64-lt x (i64-to-f64-rounded t)) (- t 1) t)))
;; exact half-up of m*scale/d with the sign applied (toward +infinity): independent of the module's own division
(defn exact [neg :bool m :i64 scale :i64 d :i64] :i64
  (let [n (* m scale)]
    (if neg (- 0 (quot (- (+ (* 2 n) d) 1) (* 2 d))) (quot (+ (* 2 n) d) (* 2 d)))))

;; outcome bits: 1 valid, 2 exact tie, 4 tie disagreement with the oracle, 8 non-tie disagreement, 16 exactness violation,
;; 32 px tie, 64 percent tie
(defn outcome [si :i64 ii :i64 fi :i64 ui :i64] :i64
  (let [i (int-at ii) k (fk fi) f (ff fi) kk (if (< k 0) 0 k) d (pow10 kk) fv (if (< k 1) 0 f)
        neg (= si 2) pct (= ui 2) scale (if pct 100 64) lim (if pct 65535 1073741824)
        s (str (sign-str si) i (frac-str k f) (unit-str ui))
        m (+ (* i d) fv)
        e (exact neg m scale d)
        ok (and (<= e lim) (>= e (- 0 lim)))
        want-v (if ok e (len/invalid)) want-u (if ok (cond (= ui 0) 0 (= ui 2) 2 :else 1) -1)
        got-v (p/parse-value s) got-u (p/parse-unit s)
        bad (or (not= got-v want-v) (not= got-u want-u))
        v (f64-add (i64-to-f64-rounded i) (f64-div (i64-to-f64-rounded fv) (i64-to-f64-rounded d)))
        sv (if neg (f64-sub 0.0 v) v)
        o (floor-i (f64-add (f64-mul sv (i64-to-f64-rounded scale)) 0.5))
        tie (= (rem (* 2 (* m scale)) (* 2 d)) d)
        diff (and ok (not= o e))]
    (+ (+ (+ (if ok 1 0) (if (and ok tie) 2 0)) (+ (if (and ok tie diff) 4 0) (if (and ok (not tie) diff) 8 0)))
       (+ (+ (if bad 16 0) (if (and ok tie (not pct)) 32 0)) (if (and ok tie pct) 64 0)))))
(defn grid [which :i64] :i64
  (loop [si 0 ii 0 fi 0 ui 0 acc 0]
    (cond (> si 2) acc
          (> ii 6) (recur (+ si 1) 0 0 0 acc)
          (> fi 19) (recur si (+ ii 1) 0 0 acc)
          (> ui 3) (recur si ii (+ fi 1) 0 acc)
          :else (let [o (outcome si ii fi ui)]
                  (recur si ii fi (+ ui 1)
                         (+ acc (cond (= which 2) 1 (= which 3) (bit-and o 1) (= which 4) (bit-and (i64-shift-right o 1) 1)
                                      (= which 5) (bit-and (i64-shift-right o 2) 1) (= which 6) (bit-and (i64-shift-right o 3) 1)
                                      (= which 7) (bit-and (i64-shift-right o 4) 1) (= which 8) (bit-and (i64-shift-right o 5) 1)
                                      :else (bit-and (i64-shift-right o 6) 1))))))))
(defn spec-ok? [] :bool
  (and (= (p/parse-value "0.0078125px") 0)       ; 7th fraction digit truncated: the exact decimal is a tie (0.5 -> 1), the scanner gives 0
       (= (p/parse-value "0.0234375px") 1)       ; exact 1.5 -> 2, truncated .023437 gives 1
       (= (p/parse-value "12.345%") 1235) (= (p/parse-value "-12.345%") -1234)   ; half up, toward +infinity
       (= (p/parse-unit "5PX") 1) (= (p/parse-unit "5") 0) (= (p/parse-unit "5%") 2)
       (= (p/parse-unit "16777217px") -1) (= (p/parse-value "16777216px") 1073741824)))
(defn main [] :i64
  (cond (= mode 0) (if (and (spec-ok?) (= (golden 0 0) 81) (= (grid 7) 0)) 42 7)
        (= mode 1) (golden 0 0)
        :else (grid mode)))
