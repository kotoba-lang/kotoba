(ns q6-color-vs-f64
  (:require [cssom.color :as f64c] [cssom.color-q6 :as q6])
  (:export [main]))

;; Differential gate (host native macOS, JUN-920 slice 3, census group G04): the Q16 / D4 colour arithmetic (cssom.color-q6)
;; against the f64 reference cssom.color (transcription of domGpu host/color.cljk unit, channel / alpha / percent tokens,
;; hsl->rgb and the alpha product). A unit fraction is a Q16 raw (0..65536), the oracle value is scaled by 65536 and compared.
;;
;; mode 0 : hand-derived spec points (the six CSS primary hsl colours, hue wrap, clamps, packing): 42 / 7.
;;          mode 20 : every grid has zero violations: 42 / 7.
;; mode 1  : unit-byte, all 256 bytes: cases | max deviation raw * 1000 << 21 | violations (> 1/2 raw) << 42
;; mode 2  : round trip to-byte(unit-byte(b)) = b for b = 0..255: violations;   mode 3: nibble-byte, 16 values: violations
;; modes 4..7 : channel-number, channel-percent, alpha-number, alpha-percent over D4 grids (same packing as mode 1)
;; modes 8..11 : hsl-channel over h = -400..800 deg x {0, 0.5} (D4), s and l in 11 x 11 percentages, 3 channels:
;;               8 = cases | max deviation raw * 1000 << 21 | violations (> 2 raw) << 42;  9 = byte differences vs the oracle
;;               (to-byte(q) != round(o * 255)), 10 = byte differences of more than 1, 11 = exact-zero or exact-65536 mismatches
;; mode 12 : final-alpha grid packing as mode 1
(def mode 0)

(defn f [x :i64] :f64 (i64-to-f64-rounded x))
(defn px [x :i64] :i64 (* x 64))
(defn floor-i [x :f64] :i64 (let [t (f64-to-i64-truncating x)] (if (f64-lt x (f t)) (- t 1) t)))
(defn rhu [o :f64] :i64 (floor-i (f64-add o 0.5)))
(defn abs-i [x :i64] :i64 (if (< x 0) (- 0 x) x))
(defn d4 [x :i64] :f64 (f64-div (f x) 10000.0))

;; packing of a (cases, max deviation x 1000, violations) triple
(defn dev1000 [q :i64 o :f64] :i64 (f64-to-i64-truncating (f64-mul (f64-abs (f64-sub (f q) (f64-mul o 65536.0))) 1000.0)))
(defn mx [a :i64 b :i64] :i64 (if (> a b) a b))
(defn pack3 [c :i64 d :i64 v :i64] :i64 (+ (+ c (i64-shift-left d 21)) (i64-shift-left v 42)))

;; ---- unit-byte ----
(defn ub-stat [] :i64
  (loop [b 0 d 0 v 0]
    (if (> b 255) (pack3 256 d v)
      (let [q (q6/unit-byte b) o (f64c/unit (f b)) dv (dev1000 q o)]
        (recur (+ b 1) (mx d dv) (+ v (if (> dv 500) 1 0)))))))
(defn rt-stat [] :i64
  (loop [b 0 v 0] (if (> b 255) v (recur (+ b 1) (+ v (if (= (q6/to-byte (q6/unit-byte b)) b) 0 1))))))
(defn nb-stat [] :i64
  (loop [n 0 v 0] (if (> n 15) v (recur (+ n 1) (+ v (if (= (q6/nibble-byte n) (q6/unit-byte (* n 17))) 0 1))))))
;; ---- token grids: n in -200000..2700000 step 331 plus catalogue ----
(defn n-at [i :i64] :i64
  (cond (= i 0) 0 (= i 1) 1 (= i 2) 5000 (= i 3) 10000 (= i 4) 10001 (= i 5) 2550000 (= i 6) 2550001 (= i 7) 1000000 (= i 8) 1000001
        (= i 9) -1 (= i 10) -10000 (= i 11) 1275000 (= i 12) 500000 (= i 13) 505000 (= i 14) 3333 :else 99999))
;; kind: 0 channel-number, 1 channel-percent, 2 alpha-number, 3 alpha-percent
(defn tok-q [kind :i64 n :i64] :i64
  (cond (= kind 0) (q6/channel-number n) (= kind 1) (q6/channel-percent n) (= kind 2) (q6/alpha-number n) :else (q6/alpha-percent n)))
(defn tok-o [kind :i64 n :i64] :f64
  (cond (= kind 0) (f64c/channel-number (d4 n)) (= kind 1) (f64c/channel-percent (d4 n)) (= kind 2) (f64c/alpha-number (d4 n))
        :else (f64c/alpha-percent (d4 n))))
(defn tok-stat [kind :i64] :i64
  (loop [i 0 n -200000 c 0 d 0 v 0]
    (cond (< i 15)
          (let [x (n-at i) q (tok-q kind x) o (tok-o kind x) dv (dev1000 q o)]
            (recur (+ i 1) n (+ c 1) (mx d dv) (+ v (if (> dv 500) 1 0))))
          (> n 2700000) (pack3 c d v)
          :else
          (let [q (tok-q kind n) o (tok-o kind n) dv (dev1000 q o)]
            (recur i (+ n 331) (+ c 1) (mx d dv) (+ v (if (> dv 500) 1 0)))))))
;; ---- hsl ----
(defn sl-at [i :i64] :i64
  (cond (= i 0) 0 (= i 1) 100000 (= i 2) 200000 (= i 3) 333333 (= i 4) 500000 (= i 5) 505000 (= i 6) 666667 (= i 7) 750000
        (= i 8) 900000 (= i 9) 1000000 :else 1500000))
;; which: 0 cases, 1 max deviation1000, 2 violations (> 2 raw), 3 byte differences, 4 byte differences > 1, 5 end-point mismatches
(defn hsl-stat [which :i64] :i64
  (loop [hi -400 half 0 si 0 li 0 ch 0 acc 0]
    (cond (> hi 800) acc (= half 2) (recur (+ hi 1) 0 0 0 0 acc) (= si 11) (recur hi (+ half 1) 0 0 0 acc)
          (= li 11) (recur hi half (+ si 1) 0 0 acc) (= ch 3) (recur hi half si (+ li 1) 0 acc)
          :else
          (let [h (+ (* hi 10000) (* half 5000))
                sn (sl-at si) ln (sl-at li)
                s16 (q6/hsl-percent sn) l16 (q6/hsl-percent ln)
                q (q6/hsl-channel (q6/hue-wrap h) s16 l16 ch)
                so (f64c/alpha-percent (d4 sn)) lo (f64c/alpha-percent (d4 ln))
                o (f64c/hsl-channel (d4 h) so lo ch)
                dv (dev1000 q o)
                qb (q6/to-byte q) ob (rhu (f64-mul o 255.0))
                endpt (if (or (= q 0) (= q 65536)) (if (= q (rhu (f64-mul o 65536.0))) 0 1) 0)]
            (recur hi half si li (+ ch 1)
                   (cond (= which 0) (+ acc 1) (= which 1) (mx acc dv) (= which 2) (+ acc (if (> dv 2000) 1 0))
                         (= which 3) (+ acc (if (= qb ob) 0 1)) (= which 4) (+ acc (if (> (abs-i (- qb ob)) 1) 1 0))
                         :else (if (= which 5) (+ acc endpt) (+ acc (if (and (not= qb ob) (f64-gt (f64-abs (f64-sub (f64-sub (f64-mul o 255.0) (f (floor-i (f64-mul o 255.0)))) 0.5)) 0.002)) 1 0)))))))))
;; ---- final-alpha ----
(defn fa-stat [] :i64
  (loop [op 0 own 0 c 0 d 0 v 0]
    (cond (> op 10000) (pack3 c d v)
          (> own 65536) (recur (+ op 97) 0 c d v)
          :else
          (let [q (q6/final-alpha op own) o (f64c/final-alpha (d4 op) (f64-div (f own) 65536.0)) dv (dev1000 q o)]
            (recur op (+ own 251) (+ c 1) (mx d dv) (+ v (if (> dv 500) 1 0)))))))

(defn hsl3 [h :i64 s :i64 l :i64] :i64
  (let [w (q6/hue-wrap h) sq (q6/hsl-percent s) lq (q6/hsl-percent l)]
    (q6/pack-rgba (q6/to-byte (q6/hsl-channel w sq lq 0)) (q6/to-byte (q6/hsl-channel w sq lq 1)) (q6/to-byte (q6/hsl-channel w sq lq 2)) 255)))
(defn spec? [] :bool
  (and
   (and (and (= (q6/unit-byte 0) 0) (= (q6/unit-byte 255) 65536))
        (and (= (q6/unit-byte 128) 32897) (and (= (q6/unit-byte 256) (q6/invalid)) (= (q6/nibble-byte 16) (q6/invalid)))))
   (and (and (= (q6/channel-number 1275000) 32768) (= (q6/channel-number 2550001) 65536))
        (and (and (= (q6/channel-number -5) 0) (= (q6/channel-percent 500000) 32768)) (= (q6/alpha-number 5000) 32768)))
   (and (and (= (q6/alpha-percent 500000) 32768) (= (q6/alpha-number 20000) 65536))
        (and (= (q6/hue-wrap -1200000) 2400000) (and (= (q6/hue-wrap 3600000) 0) (= (q6/hue-wrap 4800000) 1200000))))
   (and (and (= (hsl3 0 1000000 500000) (q6/pack-rgba 255 0 0 255)) (= (hsl3 1200000 1000000 500000) (q6/pack-rgba 0 255 0 255)))
        (and (and (= (hsl3 2400000 1000000 500000) (q6/pack-rgba 0 0 255 255)) (= (hsl3 -1200000 1000000 500000) (q6/pack-rgba 0 0 255 255)))
             (and (= (hsl3 600000 1000000 500000) (q6/pack-rgba 255 255 0 255)) (= (hsl3 1800000 1000000 500000) (q6/pack-rgba 0 255 255 255)))))
   (and (and (= (hsl3 0 0 500000) (q6/pack-rgba 128 128 128 255)) (= (hsl3 0 1000000 0) (q6/pack-rgba 0 0 0 255)))
        (and (and (= (hsl3 0 1000000 1000000) (q6/pack-rgba 255 255 255 255)) (= (q6/final-alpha 5000 65536) 32768))
             (and (= (q6/pack-rgba 1 2 3 4) 16909060) (and (= (q6/pack-rgba 256 0 0 0) (q6/invalid)) (= (q6/to-byte 65537) (q6/invalid))))))))
(defn viol [p :i64 limit :i64] :bool (<= (i64-shift-right p 42) 0))
(defn grids-ok? [] :bool
  (and (and (and (= (i64-shift-right (ub-stat) 42) 0) (= (rt-stat) 0)) (and (= (nb-stat) 0) (= (i64-shift-right (fa-stat) 42) 0)))
       (and (and (= (i64-shift-right (tok-stat 0) 42) 0) (= (i64-shift-right (tok-stat 1) 42) 0))
            (and (and (= (i64-shift-right (tok-stat 2) 42) 0) (= (i64-shift-right (tok-stat 3) 42) 0)) (= (hsl-stat 2) 0)))))
(defn main [] :i64
  (cond (= mode 0) (if (spec?) 42 7)
        (= mode 20) (if (grids-ok?) 42 7)
        (= mode 1) (ub-stat) (= mode 2) (rt-stat) (= mode 3) (nb-stat)
        (= mode 4) (tok-stat 0) (= mode 5) (tok-stat 1) (= mode 6) (tok-stat 2) (= mode 7) (tok-stat 3)
        (= mode 8) (pack3 (hsl-stat 0) (hsl-stat 1) (hsl-stat 2)) (= mode 9) (hsl-stat 3) (= mode 10) (hsl-stat 4) (= mode 11) (hsl-stat 5) (= mode 13) (hsl-stat 6)
        (= mode 12) (fa-stat)
        :else 0))
