(ns q6-trig-vs-golden
  (:require [cssom.trig-q6 :as tg] [cssom.trig-golden :as gd])
  (:export [main]))

;; Golden-table gate (host native macOS, JUN-929 / C2b-4, census group G05): the Q17 sin / cos / tan of cssom.trig-q6 against a table
;; that Python produced ONCE (evidence cssom-q6-transform-20261106, scripts/gen_trig_golden.py; the table is data of this gate, its
;; sha256 is pinned by scripts/check-transform-q6-native-macos.py and it is never regenerated by a gate). The native f64 dialect has
;; no sin / cos / tan, so there is no runtime oracle: the golden values are `math.sin` / `math.cos` / `math.tan` rounded half up to
;; Q17 (and Q30 on every 4th row), cross-checked at generation time by an independent exact series (zero disagreements recorded).
;;
;; Row i: unit and v from (gd/g-in i); golden sin17, cos17 and the tan17 field from (gd/g-q17 i). A zero q17 word = outside the
;; domain (|angle| > 32 turns): the module must answer (invalid) for sin17, cos17 and tan17. A zero tan field = tan refused (cos = 0 or
;; |tan| >= 64): the module must answer (invalid), or, at the |tan| = 64 edge only, a value within the tan tolerance below 8388607
;; (and the other way round: a golden value within the tolerance of the edge may be refused).
;; Tolerances: sin, cos: 1 ulp of Q17; tan: 1 + 2 * (2^34 + t^2) / 2^44 ulps, t the golden raw (about 1.6e-3 (1 + tan^2), 9 at |tan| = 64);
;; Q30 values: 2 ulps of Q30.
;; mode 0 : everything within tolerance AND at most 5 rows are 1 ulp off in sin17 / cos17 (a rounding bug is seen): 42 / 7
;; modes: 1 rows, 2 domain-refusal rows agreed, 3 refusal disagreements,
;;        4 5 6 sin17 error 0 / 1 / >= 2 (valid rows),  7 8 9 cos17 error 0 / 1 / >= 2,
;;        10 tan rows compared (golden valid and native valid), 11 tan max error (ulps) over all, 12 13 14 same for |tan| < 1, < 8, < 32,
;;        15 tan violations (error above tolerance), 16 tan refusals agreed, 17 golden refused / native valid (edge rows), 18 golden valid / native refused (edge rows),
;;        19 edge-row violations (not within tolerance of the 64 edge), 20 Q30 rows, 21 sin30 max error, 22 cos30 max error, 23 Q30 violations (> 2 ulps),
;;        24 max over all rows of |sin30^2 + cos30^2 - 2^60| / 2^30 (Pythagorean deviation, in Q30 ulps) for the native module alone,
;;        25 rows where deg / grad / turn spellings of the same angle (see spell) differ by more than 1 Q17 ulp, 26 spelling rows compared
(def mode 0)

(defn abs-i [x :i64] :i64 (if (< x 0) (- 0 x) x))
(defn max-i [a :i64 b :i64] :i64 (if (> a b) a b))
(defn gu [i :i64] :i64 (rem (gd/g-in i) 8))
(defn gv [i :i64] :i64 (- (quot (gd/g-in i) 8) 34359738368))
(defn gq [i :i64] :i64 (gd/g-q17 i))
(defn valid? [i :i64] :bool (not= (gq i) 0))
(defn gs [i :i64] :i64 (- (rem (gq i) 524288) 262144))
(defn gc [i :i64] :i64 (- (rem (quot (gq i) 524288) 524288) 262144))
(defn gt-field [i :i64] :i64 (quot (gq i) 274877906944))
(defn gt [i :i64] :i64 (- (gt-field i) 8388608))
(defn tol-tan [t :i64] :i64 (+ 1 (quot (* 2 (+ 17179869184 (* t t))) 17592186044416)))
(defn ns-of [i :i64] :i64 (tg/sin17 (gu i) (gv i)))
(defn nc-of [i :i64] :i64 (tg/cos17 (gu i) (gv i)))
(defn nt-of [i :i64] :i64 (tg/tan17 (gu i) (gv i)))
(defn inv [] :i64 (tg/invalid))

;; the per-row statistic for a mode; the loops add (or maximise) over all rows
(defn sin-err [i :i64] :i64 (abs-i (- (ns-of i) (gs i))))
(defn cos-err [i :i64] :i64 (abs-i (- (nc-of i) (gc i))))
(defn tan-both? [i :i64] :bool (and (valid? i) (and (not= (gt-field i) 0) (not= (nt-of i) (inv)))))
(defn tan-err [i :i64] :i64 (abs-i (- (nt-of i) (gt i))))
(defn tan-band [i :i64 band :i64] :bool
  (let [a (abs-i (gt i))]
    (cond (= band 0) true (= band 1) (< a 131072) (= band 2) (< a 1048576) :else (< a 4194304))))
(defn edge-ok-a [i :i64] :bool (and (>= (abs-i (nt-of i)) (- 8388607 (tol-tan 8388607))) (<= (abs-i (nt-of i)) 8388607)))   ; golden refused, native valid: just below the edge
(defn edge-ok-b [i :i64] :bool (>= (abs-i (gt i)) (- 8388607 (tol-tan 8388607))))      ; golden valid, native refused

(defn row-stat [w :i64 i :i64] :i64
  (cond
    (= w 1) 1
    (= w 2) (if (and (not (valid? i)) (and (= (ns-of i) (inv)) (and (= (nc-of i) (inv)) (= (nt-of i) (inv))))) 1 0)
    (= w 3) (if (and (not (valid? i)) (not (and (= (ns-of i) (inv)) (and (= (nc-of i) (inv)) (= (nt-of i) (inv)))))) 1
                (if (and (valid? i) (or (= (ns-of i) (inv)) (= (nc-of i) (inv)))) 1 0))
    (= w 4) (if (and (valid? i) (= (sin-err i) 0)) 1 0)
    (= w 5) (if (and (valid? i) (= (sin-err i) 1)) 1 0)
    (= w 6) (if (and (valid? i) (>= (sin-err i) 2)) 1 0)
    (= w 7) (if (and (valid? i) (= (cos-err i) 0)) 1 0)
    (= w 8) (if (and (valid? i) (= (cos-err i) 1)) 1 0)
    (= w 9) (if (and (valid? i) (>= (cos-err i) 2)) 1 0)
    (= w 10) (if (tan-both? i) 1 0)
    (= w 11) (if (tan-both? i) (tan-err i) 0)
    (= w 12) (if (and (tan-both? i) (tan-band i 1)) (tan-err i) 0)
    (= w 13) (if (and (tan-both? i) (tan-band i 2)) (tan-err i) 0)
    (= w 14) (if (and (tan-both? i) (tan-band i 3)) (tan-err i) 0)
    (= w 15) (if (and (tan-both? i) (> (tan-err i) (tol-tan (gt i)))) 1 0)
    (= w 16) (if (and (valid? i) (and (= (gt-field i) 0) (= (nt-of i) (inv)))) 1 0)
    (= w 17) (if (and (valid? i) (and (= (gt-field i) 0) (not= (nt-of i) (inv)))) 1 0)
    (= w 18) (if (and (valid? i) (and (not= (gt-field i) 0) (= (nt-of i) (inv)))) 1 0)
    (= w 19) (if (and (valid? i) (or (and (= (gt-field i) 0) (and (not= (nt-of i) (inv)) (not (edge-ok-a i))))
                                      (and (not= (gt-field i) 0) (and (= (nt-of i) (inv)) (not (edge-ok-b i)))))) 1 0)
    :else 0))

;; Q30 rows: row 4 j; golden words are Q30 + 2^30 + 1, 0 = invalid
(defn q30-s [j :i64] :i64 (- (gd/g-s30 j) 1073741825))
(defn q30-c [j :i64] :i64 (- (gd/g-c30 j) 1073741825))
(defn q30-stat [w :i64 j :i64] :i64
  (let [i (* 4 j)]
    (if (not (valid? i)) 0
      (cond (= w 20) 1
            (= w 21) (abs-i (- (tg/sin30 (gu i) (gv i)) (q30-s j)))
            (= w 22) (abs-i (- (tg/cos30 (gu i) (gv i)) (q30-c j)))
            (= w 23) (if (or (> (abs-i (- (tg/sin30 (gu i) (gv i)) (q30-s j))) 2) (> (abs-i (- (tg/cos30 (gu i) (gv i)) (q30-c j))) 2)) 1 0)
            :else 0))))
(defn pyth-stat [i :i64] :i64
  (if (not (valid? i)) 0
    (let [s (tg/sin30 (gu i) (gv i)) c (tg/cos30 (gu i) (gv i))]
      (quot (abs-i (- (+ (* s s) (* c c)) 1152921504606846976)) 1073741824))))

;; the same angle spelled in deg, grad and turn: k/64 turn = k * 5.625 deg = k * 6.25 grad, k = -2048 .. 2048 (|angle| <= 32 turns)
(defn spell-stat [w :i64 k :i64] :i64
  (let [t (tg/sin17 4 (* k 15625)) d (tg/sin17 1 (* k 5625000)) g (tg/sin17 2 (* k 6250000))
        t2 (tg/cos17 4 (* k 15625)) d2 (tg/cos17 1 (* k 5625000)) g2 (tg/cos17 2 (* k 6250000))
        bad (or (> (abs-i (- t d)) 1) (or (> (abs-i (- t g)) 1) (or (> (abs-i (- t2 d2)) 1) (> (abs-i (- t2 g2)) 1))))]
    (if (= w 25) (if bad 1 0) 1)))

(defn sum-rows [w :i64] :i64
  (loop [i 0 acc 0]
    (if (>= i (gd/rows)) acc
      (recur (+ i 1) (if (or (= w 11) (or (= w 12) (or (= w 13) (= w 14)))) (max-i acc (row-stat w i)) (+ acc (row-stat w i)))))))
(defn sum-q30 [w :i64] :i64
  (loop [j 0 acc 0]
    (if (>= (* 4 j) (gd/rows)) acc
      (recur (+ j 1) (if (or (= w 21) (= w 22)) (max-i acc (q30-stat w j)) (+ acc (q30-stat w j)))))))
(defn max-pyth [] :i64
  (loop [i 0 acc 0] (if (>= i (gd/rows)) acc (recur (+ i 1) (max-i acc (pyth-stat i))))))
(defn sum-spell [w :i64] :i64
  (loop [k -2048 acc 0] (if (> k 2048) acc (recur (+ k 1) (+ acc (spell-stat w k))))))

(defn stat [w :i64] :i64
  (cond (<= w 19) (sum-rows w) (<= w 23) (sum-q30 w) (= w 24) (max-pyth) :else (sum-spell w)))

(defn verdict [] :i64
  (if (and (> (gd/rows) 0)
        (and (= (stat 3) 0)
        (and (= (stat 6) 0) (and (= (stat 9) 0)
        (and (<= (+ (stat 5) (stat 8)) 5)
        (and (= (stat 15) 0) (and (= (stat 19) 0)
        (and (= (stat 23) 0) (and (<= (stat 24) 4) (= (stat 25) 0))))))))))
    42 7))

(defn main [] :i64 (if (= mode 0) (verdict) (if (= mode 26) (stat 26) (stat mode))))
