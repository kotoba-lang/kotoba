(ns q6-aspect-ratio-vs-f64
  (:require [cssom.aspect-ratio :as f64ar] [cssom.aspect-ratio-q6 :as q6] [cssom.pack-q6 :as pk])
  (:export [main]))

;; Differential gate (host native macOS, JUN-920 slice 2, census group G08): the Q6 aspect-ratio and replaced-element sizing
;; (cssom.aspect-ratio-q6, ratio = integer pair) against the f64 reference cssom.aspect-ratio (transcription of layout.cljk
;; aspect-ratio-block-height / -width, replaced-content-size, replaced-intrinsic-size).
;;
;; `(long (/ w r))` and `(long (* h r))` truncate a double: when the EXACT quotient is a whole number of px and the double
;; misses it by an ulp (16/9 as a double), the oracle is one px low. Those cases are "boundary" cases (ties of the truncation
;; rule); a difference away from a boundary, or by more than one px, is a violation. The replaced sizes are unrounded in the
;; source; Q6 rounds half up once, so |2q - 128 o| <= 1.
;;
;; mode 0   : hand-derived spec points (comments of layout.cljk, measured in Brave there): 42 / 7.   mode 20 : all grids: 42 / 7.
;; modes 1..4  block grid (height and width): 1 cases, 2 compared equal, 3 boundary differences, 4 justified refusals;
;;             5 violations
;; modes 6..9  replaced width grid: cases, compared, justified refusals, violations;  10..13 replaced height grid, same
;; modes 14..17 dense sweep of block-height, ratios (rn, rd) 1..24, border-box width 0..2048 px: 14 pairs, 15 boundary,
;;             16 oracle differs at a boundary, 17 oracle differs away from a boundary;  23..26 the same for block-width
;; mode 22  intrinsic-px violations over raw 1..8192 and a step-997 sweep to 2^22
(def mode 0)

(defn rn-at [i :i64]
  :i64 (cond (= i 0) 1 (= i 1) 3 (= i 2) 1 (= i 3) 16 (= i 4) 9 (= i 5) 4 (= i 6) 3 (= i 7) 2 (= i 8) 1 (= i 9) 7
             (= i 10) 65535 (= i 11) 1 (= i 12) 65535 (= i 13) 5 (= i 14) 100 (= i 15) 1000 (= i 16) 0 (= i 17) 1
             (= i 18) 65536 (= i 19) 1 :else -3))
(defn rd-at [i :i64]
  :i64 (cond (= i 0) 1 (= i 1) 1 (= i 2) 3 (= i 3) 9 (= i 4) 16 (= i 5) 3 (= i 6) 2 (= i 7) 1 (= i 8) 2 (= i 9) 3
             (= i 10) 1 (= i 11) 65535 (= i 12) 65535 (= i 13) 7 (= i 14) 1 (= i 15) 1777 (= i 16) 1 (= i 17) 0
             (= i 18) 1 (= i 19) 65536 :else 2))
(defn len-at [i :i64] :i64
  (cond (= i 0) 0 (= i 1) 1 (= i 2) 63 (= i 3) 64 (= i 4) 65 (= i 5) 3200 (= i 6) 6400 (= i 7) 7680 (= i 8) 8960
        (= i 9) 12800 (= i 10) 25600 (= i 11) 1073741824 (= i 12) 1073741825 (= i 13) -64 (= i 14) -1 (= i 15) 960
        (= i 16) 2560 (= i 17) 1000 (= i 18) 5120 :else 12345))
(defn ix-at [i :i64] :i64
  (cond (= i 0) 0 (= i 1) 1280 (= i 2) 640 (= i 3) 640 (= i 4) 0 (= i 5) 64 (= i 6) 1073741824 (= i 7) 0 (= i 8) -64 :else 1073741825))
(defn iy-at [i :i64] :i64
  (cond (= i 0) 0 (= i 1) 1280 (= i 2) 640 (= i 3) 0 (= i 4) 640 (= i 5) 128 (= i 6) 0 (= i 7) 1073741824 (= i 8) 0 :else 0))
(defn abs-i [x :i64] :i64 (if (< x 0) (- 0 x) x))
(defn f64-of [raw :i64] :f64 (f64-mul (i64-to-f64-rounded raw) 0.015625))
(defn ratio-f [rn :i64 rd :i64] :f64 (f64-div (i64-to-f64-rounded rn) (i64-to-f64-rounded rd)))
(defn max0 [x :i64] :i64 (if (< x 0) 0 x))
(defn to-raw [px :f64] :i64 (f64-to-i64-truncating (f64-mul px 64.0)))

;; ---- block height / width grid: index = ((((flags * 20 + li) * 21) + ri) * 10) + ii, flags 0..1, li 0..19, ri 0..20, ii 0..9 ----
;; class: 0 equal, 1 boundary difference, 2 justified refusal, 3 violation
(defn block-class [c :i64 width :bool] :i64
  (let [ii (rem c 10) ri (rem (quot c 10) 21) li (rem (quot c 210) 20) fl (quot c 4200)
        l (len-at li) rn (rn-at ri) rd (rd-at ri) ix (ix-at ii) iy (iy-at ii)
        q (if width (q6/block-width fl l (pk/pack rn rd) (pk/pack ix iy)) (q6/block-height fl l (pk/pack rn rd) (pk/pack ix iy)))
        oracle-ratio (and (> rn 0) (> rd 0))
        dom (and (and (>= rn 1) (<= rn 65535)) (and (and (>= rd 1) (<= rd 65535))
                  (and (<= (abs-i l) 1073741824) (and (and (>= ix 0) (<= ix 1073741824)) (and (>= iy 0) (<= iy 1073741824))))))
        r (if oracle-ratio (ratio-f rn rd) 1.0)   ; a non-positive term is dropped by the source: no oracle value
        o (if width (f64ar/block-width (= fl 1) (f64-of l) r (f64-of ix) (f64-of iy))
                    (f64ar/block-height (= fl 1) (f64-of l) r (f64-of ix) (f64-of iy)))
        oq (to-raw o)
        eff (if (= fl 1) l (max0 (- l (if width iy ix))))
        b (if (and (> rn 0) (> rd 0))
            (if width (= (rem (abs-i (* eff rn)) (* 64 rd)) 0) (= (rem (abs-i (* eff rd)) (* 64 rn)) 0))
            false)]
    (cond (not oracle-ratio) (if (= q (q6/invalid)) 2 3)
          (not dom) (if (= q (q6/invalid)) 2 3)
          (> (abs-i oq) 1073741824) (if (= q (q6/invalid)) 2 3)
          (= q (q6/invalid)) 3
          (= q oq) 0
          (and b (= (abs-i (- q oq)) 64)) 1
          :else 3)))
(defn block-count [lo :i64 hi :i64] :i64
  (loop [c 0 acc 0]
    (if (>= c 8400) acc
      (recur (+ c 1) (+ acc (let [k (+ (block-class c false) 0) k2 (block-class c true)]
                              (+ (if (and (>= k lo) (<= k hi)) 1 0) (if (and (>= k2 lo) (<= k2 hi)) 1 0))))))))

;; ---- replaced width / height grids ----
(defn dw-at [i :i64] :i64 (cond (= i 0) 0 (= i 1) 64 (= i 2) 12800 (= i 3) 5000 (= i 4) 1073741824 :else 1073741825))
(defn iw-at [i :i64] :i64
  (cond (= i 0) 0 (= i 1) 1 (= i 2) 40 (= i 3) 400 (= i 4) 300 (= i 5) 20 (= i 6) 65535 (= i 7) 1 (= i 8) 65536 :else 7))
(defn ih-at [i :i64] :i64
  (cond (= i 0) 0 (= i 1) 1 (= i 2) 20 (= i 3) 200 (= i 4) 150 (= i 5) 10 (= i 6) 1 (= i 7) 65535 (= i 8) 1 :else 3))
(defn dflt-at [i :i64] :i64 (if (= i 0) 19200 0))
(defn rw-at [i :i64] :i64
  (cond (= i 0) 0 (= i 1) 64 (= i 2) 12800 (= i 3) 5000 (= i 4) 19200 (= i 5) 1 (= i 6) 1073741824 :else 1073741825))
;; classes as above; deviation judged in half raw units
(defn rep-judge [q :i64 o :f64 dom :bool] :i64
  (let [oq-big (f64-gt (f64-abs (f64-mul o 64.0)) 1073741826.0)
        oq-edge (f64-gt (f64-abs (f64-mul o 64.0)) 1073741822.0)]
    (cond (or (not dom) oq-big) (if (= q (q6/invalid)) 2 3)
          oq-edge 0
          (= q (q6/invalid)) 3
          (f64-gt (f64-abs (f64-sub (f64-mul (i64-to-f64-rounded q) 2.0) (f64-mul o 128.0))) 1.00001) 3
          :else 0)))
;; width index: (((((fl * 6 + wi) * 6 + hi) * 10) + ni) * 2) + di
(defn width-class [c :i64] :i64
  (let [di (rem c 2) ni (rem (quot c 2) 10) hi (rem (quot c 20) 6) wi (rem (quot c 120) 6) fl (quot c 720)
        dw (dw-at wi) dh (dw-at hi) iw (iw-at ni) ih (ih-at ni) dflt (dflt-at di)
        q (q6/replaced-width fl (pk/pack dw dh) (pk/pack iw ih) dflt)
        has-dw (= (bit-and fl 1) 1) has-dh (= (bit-and (i64-shift-right fl 1) 1) 1) intr (= (bit-and (i64-shift-right fl 2) 1) 1)
        dom (and (or (not has-dw) (<= dw 1073741824)) (and (or (not has-dh) (<= dh 1073741824))
                  (or (not intr) (and (<= iw 65535) (<= ih 65535)))))
        o (f64ar/replaced-width has-dw (f64-of dw) has-dh (f64-of dh) intr (i64-to-f64-rounded iw) (i64-to-f64-rounded ih) (f64-of dflt))]
    (rep-judge q o dom)))
;; height index: (((((fl * 8 + wi) * 6 + hi) * 10) + ni) * 2) + di
(defn height-class [c :i64] :i64
  (let [di (rem c 2) ni (rem (quot c 2) 10) hi (rem (quot c 20) 6) wi (rem (quot c 120) 8) fl (quot c 960)
        w (rw-at wi) dh (dw-at hi) iw (iw-at ni) ih (ih-at ni) dflt (dflt-at di)
        q (q6/replaced-height fl w dh (pk/pack iw ih) dflt)
        has-dh (= (bit-and (i64-shift-right fl 1) 1) 1) intr (= (bit-and (i64-shift-right fl 2) 1) 1)
        dom (and (<= w 1073741824) (and (or (not has-dh) (<= dh 1073741824)) (or (not intr) (and (<= iw 65535) (<= ih 65535)))))
        o (f64ar/replaced-height has-dh (f64-of dh) (f64-of w) intr (i64-to-f64-rounded iw) (i64-to-f64-rounded ih) (f64-of dflt))]
    (rep-judge q o dom)))
(defn count-width [lo :i64 hi :i64] :i64
  (loop [c 0 acc 0]
    (if (>= c 5760) acc (recur (+ c 1) (+ acc (let [k (width-class c)] (if (and (>= k lo) (<= k hi)) 1 0)))))))
(defn count-height [lo :i64 hi :i64] :i64
  (loop [c 0 acc 0]
    (if (>= c 7680) acc (recur (+ c 1) (+ acc (let [k (height-class c)] (if (and (>= k lo) (<= k hi)) 1 0)))))))

;; ---- dense sweeps ----
;; which: 0 pairs, 1 boundary, 2 oracle != Q6 at a boundary, 3 oracle != Q6 away from a boundary. width? selects block-width.
(defn dense-one [rn :i64 rd :i64 px :i64 width :bool which :i64] :i64
  (let [l (* px 64) r (ratio-f rn rd)
        o (to-raw (if width (f64ar/block-width true (f64-of l) r 0.0 0.0) (f64ar/block-height true (f64-of l) r 0.0 0.0)))
        q (if width (q6/block-width 1 l (pk/pack rn rd) (pk/pack 0 0)) (q6/block-height 1 l (pk/pack rn rd) (pk/pack 0 0)))
        b (if width (= (rem (* px rn) rd) 0) (= (rem (* px rd) rn) 0))]
    (cond (= which 0) 1
          (= which 1) (if b 1 0)
          (= which 2) (if (and b (not= o q)) 1 0)
          :else (if (and (not b) (not= o q)) 1 0))))
(defn dense [width :bool which :i64] :i64
  (loop [rn 1 rd 1 px 0 acc 0]
    (cond (> rn 24) acc
          (> rd 24) (recur (+ rn 1) 1 0 acc)
          (> px 2048) (recur rn (+ rd 1) 0 acc)
          :else (recur rn rd (+ px 1) (+ acc (dense-one rn rd px width which))))))
(defn intrinsic-viol [] :i64
  (+ (loop [k 1 acc 0]
       (if (> k 8192) acc
         (recur (+ k 1) (+ acc (if (= (q6/intrinsic-px k) (f64ar/intrinsic-round (f64-of k))) 0 1)))))
     (loop [k 1 acc 0]
       (if (> k 4194304) acc
         (recur (+ k 997) (+ acc (if (= (q6/intrinsic-px k) (f64ar/intrinsic-round (f64-of k))) 0 1)))))))
(defn grids-ok? [] :bool
  (and (= (block-count 3 3) 0) (and (= (count-width 3 3) 0) (and (= (count-height 3 3) 0)
       (and (= (dense false 3) 0) (and (= (dense true 3) 0) (= (intrinsic-viol) 0)))))))

;; ---- spec points ----
(defn px [v :i64] :i64 (* v 64))
(defn spec-ok? [] :bool
  (and
   ;; width: 120px; aspect-ratio: 3/1; padding: 10px -> 140x60 content-box (content 120x40), ratio height 40 for border-box 120
   (= (q6/block-height 0 (px 140) (pk/pack 3 1) (pk/pack (px 20) (px 20))) (px 60))
   (= (q6/block-height 1 (px 120) (pk/pack 3 1) (pk/pack (px 20) (px 20))) (px 40))
   ;; height: 60px; aspect-ratio: 3/1 -> width 180, as a content-box and a border-box with no insets
   (= (q6/block-width 0 (px 60) (pk/pack 3 1) (pk/pack 0 0)) (px 180)) (= (q6/block-width 1 (px 60) (pk/pack 3 1) (pk/pack 0 0)) (px 180))
   ;; 16/9: 144 px wide is exactly 81 px tall ; 21 px at 3/17 is exactly 119 (the f64 oracle gives 118.99999999999999 -> 118: a boundary difference)
   (= (q6/block-height 1 (px 144) (pk/pack 16 9) (pk/pack 0 0)) (px 81)) (= (q6/block-height 1 (px 21) (pk/pack 3 17) (pk/pack 0 0)) (px 119))
   (= (f64-to-i64-truncating (f64ar/block-height true 21.0 (ratio-f 3 17) 0.0 0.0)) 118)
   ;; truncation toward zero: width 100px at 3/2 is 66.66 -> 66 px
   (= (q6/block-height 1 (px 100) (pk/pack 3 2) (pk/pack 0 0)) (px 66)) (= (q6/block-height 1 (px -100) (pk/pack 3 2) (pk/pack 0 0)) (px -66))
   ;; replaced, the 40x20 image of the comments: width: 200px -> 200x100 ; max-width: 20px -> 20x10 ;
   ;; border-box 200 with border 5 and padding 3 -> content 184x92 ; content-box -> 200x100 + 16 = 216x116
   (= (q6/replaced-height 4 (px 200) 0 (pk/pack 40 20) (px 150)) (px 100))
   (= (q6/replaced-height 4 (px 20) 0 (pk/pack 40 20) (px 150)) (px 10))
   (= (q6/replaced-height 4 (px 184) 0 (pk/pack 40 20) (px 150)) (px 92))
   ;; no declared size: the intrinsic size ; no intrinsic: the default object size
   (= (q6/replaced-width 4 (pk/pack 0 0) (pk/pack 40 20) (px 300)) (px 40)) (= (q6/replaced-height 4 (px 40) 0 (pk/pack 40 20) (px 150)) (px 20))
   (= (q6/replaced-width 0 (pk/pack 0 0) (pk/pack 0 0) (px 300)) (px 300)) (= (q6/replaced-height 0 (px 300) 0 (pk/pack 0 0) (px 150)) (px 150))
   ;; declared height and a ratio: width = 100 * 40 / 20 = 200 ; a declared width wins
   (= (q6/replaced-width 6 (pk/pack 0 (px 100)) (pk/pack 40 20) (px 300)) (px 200)) (= (q6/replaced-width 7 (pk/pack (px 7) (px 100)) (pk/pack 40 20) (px 300)) (px 7))
   ;; a zero intrinsic dimension (a canvas width=0) has no ratio: the intrinsic width stands (0)
   (= (q6/replaced-width 6 (pk/pack 0 (px 100)) (pk/pack 0 20) (px 300)) 0)
   ;; exact half-up ties: 1 raw * 1 / 2 = 0.5 -> 1 ; 3 raw * 1 / 2 = 1.5 -> 2
   (= (q6/replaced-width 6 (pk/pack 0 1) (pk/pack 1 2) 0) 1) (= (q6/replaced-width 6 (pk/pack 0 3) (pk/pack 1 2) 0) 2)
   ;; intrinsic rounding: Math/round(0.5) = 1, 0.49 -> 0
   (= (q6/intrinsic-px 32) 1) (= (q6/intrinsic-px 31) 0) (= (q6/intrinsic-px 0) (q6/invalid))
   ;; refusals: a zero or negative ratio term, a term above 16 bits, a length beyond 2^30, a negative inset
   (= (q6/block-height 1 (px 100) (pk/pack 0 1) (pk/pack 0 0)) (q6/invalid)) (= (q6/block-height 1 (px 100) (pk/pack 1 0) (pk/pack 0 0)) (q6/invalid))
   (= (q6/block-height 1 (px 100) (pk/pack 65536 1) (pk/pack 0 0)) (q6/invalid)) (= (q6/block-height 1 1073741825 (pk/pack 3 1) (pk/pack 0 0)) (q6/invalid))
   (= (q6/block-height 0 (px 100) (pk/pack 3 1) (pk/pack -64 0)) (q6/invalid))
   (= (q6/replaced-width 4 (pk/pack 0 0) (pk/pack 65536 1) 0) (q6/invalid))
   ;; the reference on the same points, in px
   (= (f64-to-i64-truncating (f64ar/block-height false 140.0 3.0 20.0 20.0)) 60) (= (f64-to-i64-truncating (f64ar/block-width true 60.0 3.0 0.0 0.0)) 180)
   (= (f64-to-i64-truncating (f64ar/replaced-height false 0.0 200.0 true 40.0 20.0 150.0)) 100)
   (= (f64-to-i64-truncating (f64ar/replaced-width false 0.0 true 100.0 true 40.0 20.0 300.0)) 200)
   (= (f64ar/intrinsic-round 0.5) 1) (= (f64ar/intrinsic-round 0.49) 0) (= (f64ar/intrinsic-round -0.5) 0)))

(defn main [] :i64
  (cond
    (= mode 1) 16800 (= mode 2) (block-count 0 0) (= mode 3) (block-count 1 1) (= mode 4) (block-count 2 2) (= mode 5) (block-count 3 3)
    (= mode 6) 5760 (= mode 7) (count-width 0 0) (= mode 8) (count-width 2 2) (= mode 9) (count-width 3 3)
    (= mode 10) 7680 (= mode 11) (count-height 0 0) (= mode 12) (count-height 2 2) (= mode 13) (count-height 3 3)
    (= mode 14) (dense false 0) (= mode 15) (dense false 1) (= mode 16) (dense false 2) (= mode 17) (dense false 3)
    (= mode 23) (dense true 0) (= mode 24) (dense true 1) (= mode 25) (dense true 2) (= mode 26) (dense true 3)
    (= mode 22) (intrinsic-viol)
    (= mode 20) (if (grids-ok?) 42 7)
    :else (if (spec-ok?) 42 7)))
