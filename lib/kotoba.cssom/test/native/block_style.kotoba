(ns css-block-style-test
  (:require [cssom.length :as length] [cssom.block-style :as style])
  (:export [main]))
(defn v [unit :keyword n :f64] [:ref :css.length/input] (record [:ref :css.length/input] unit n))
(defn make [w [:ref :css.length/input] min [:ref :css.length/input] max [:ref :css.length/input]
            ml [:ref :css.length/input] mr [:ref :css.length/input]
            pl [:ref :css.length/input] pr [:ref :css.length/input] box :bool rtl :bool] [:ref :css.block/style]
  (record [:ref :css.block/style] 200.0 w min max ml mr pl pr 2.0 3.0 box rtl))
(defn check [s [:ref :css.block/style] content :f64 border :f64 l :f64 r :f64] :bool
  (let [z (style/solve s)]
    (and (record-get [:ref :css.block/result] z :valid)
         (f64-eq (record-get [:ref :css.block/result] z :content) content)
         (f64-eq (record-get [:ref :css.block/result] z :border) border)
         (f64-eq (record-get [:ref :css.block/result] z :margin-left) l)
         (f64-eq (record-get [:ref :css.block/result] z :margin-right) r))))
(defn main [] :i64
  (let [auto (v :length/auto 0.0) none (v :length/none 0.0) zero (v :length/px 0.0)
        half (v :length/percent 50.0) p10 (v :length/percent 10.0) p5 (v :length/percent 5.0)
        neg (v :length/percent -10.0)
        unresolved (length/resolve half 200.0 false false)
        invalid (length/resolve neg 200.0 true false)
        bad-unit (length/resolve (v :length/rem 1.0) 200.0 true false)]
    (if (and (check (make half zero none auto auto p10 p5 false false) 100.0 135.0 32.5 32.5)
             (check (make auto zero half auto auto p10 p5 false false) 100.0 135.0 32.5 32.5)
             (check (make auto zero half auto auto p10 p5 true false) 65.0 100.0 50.0 50.0)
             (check (make half zero none neg auto zero zero false false) 100.0 105.0 -20.0 115.0)
             (= (record-get [:ref :css.length/result] unresolved :kind) :length/unresolved)
             (= (record-get [:ref :css.length/result] invalid :kind) :length/invalid)
             (= (record-get [:ref :css.length/result] bad-unit :kind) :length/invalid)
             (not (record-get [:ref :css.block/result] (style/solve (make half zero none auto auto neg zero false false)) :valid))) 42 0)))
