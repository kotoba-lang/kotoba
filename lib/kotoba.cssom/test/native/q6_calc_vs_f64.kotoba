(ns q6-calc-vs-f64
  (:require [cssom.calc :as c] [cssom.calc-q6 :as q6] [cssom.pack-q6 :as pk])
  (:export [main]))

;; Differential gate (host native macOS, JUN-920 slice 2, census group G03): the Q6 calc() evaluator
;; (cssom.calc-q6, postfix program of at most 15 operations / 4 operands) against the f64 reference cssom.calc, a
;; transcription of `eval-calc-node` (core.cljk 977-1048). Each SHAPE below is written twice: as the postfix word the
;; host packer would produce (ops-of) and as the AST the host parser would build (tree), so the grid also checks that the
;; postfix form means the same as the tree. 34 shapes (valid and type-invalid), every operand drawn from a 16-value
;; catalogue (cat-at) that is read as Q6 px or as D4 numbers according to the shape: zero, +-1 raw, exact ties, 1.0, a
;; range edge (+-2^30) and one past it.
;;
;; mode 0  : spec points (hand-derived, evaluated by the Q6 module AND the f64 reference) + the refusal programs: 42 / 7.
;; mode 4  : slice = shape, the whole 16^k grid of that shape: 42 when it has no violation, 7 otherwise.
;; modes 1, 2, 3 (slice = shape): pinned counts. 1: bothInvalid, compared, justified refusals (21 bits each);
;;            2: edge band, violations; 3: maximum deviation in thousandths of 1/128 px (|2q - 2*scale*o| * 1000).
;; modes 5..9: dense single-operation sweeps (px * number, px / number, ...) for the exact-tie report, no records.
(def mode 0)
(def slice 0)

(defn cat-at [i :i64] :i64
  (cond (= i 0) 0 (= i 1) 1 (= i 2) 5000 (= i 3) 10000 (= i 4) 15000 (= i 5) 64 (= i 6) 3200 (= i 7) -64
        (= i 8) -10000 (= i 9) -5000 (= i 10) 1234 (= i 11) 65535 (= i 12) 65536 (= i 13) 1073741824
        (= i 14) -1073741824 :else 1073741825))
(defn digit [c :i64 k :i64] :i64
  (rem (quot c (cond (= k 0) 1 (= k 1) 16 (= k 2) 256 :else 4096)) 16))
(defn w [a :i64 b :i64 c :i64 d :i64 e :i64] :i64 (+ a (+ (* 16 b) (+ (* 256 c) (+ (* 4096 d) (* 65536 e))))))
;; operator words (1 N, 2 P, 3 +, 4 -, 5 *, 6 /, 7 neg, 8 min, 9 max, 10 clamp)
(defn ops-of [s :i64] :i64
  (cond (= s 0) (w 2 0 0 0 0) (= s 1) (w 1 0 0 0 0) (= s 2) (w 2 2 3 0 0) (= s 3) (w 2 2 4 0 0)
        (= s 4) (w 2 1 5 0 0) (= s 5) (w 1 2 5 0 0) (= s 6) (w 2 2 5 0 0) (= s 7) (w 2 1 6 0 0)
        (= s 8) (w 2 2 6 0 0) (= s 9) (w 1 1 6 0 0) (= s 10) (w 1 1 5 0 0) (= s 11) (w 2 7 0 0 0)
        (= s 12) (w 1 7 0 0 0) (= s 13) (w 2 2 8 0 0) (= s 14) (w 2 2 9 0 0) (= s 15) (w 2 1 8 0 0)
        (= s 16) (w 2 2 2 10 0) (= s 17) (w 1 1 1 10 0) (= s 18) (w 2 2 1 10 0) (= s 19) (w 2 1 3 0 0)
        (= s 20) (w 2 2 3 1 5) (= s 21) (w 2 1 5 2 3) (= s 22) (w 2 2 3 1 6)
        (= s 23) (+ (w 2 2 8 2 2) (* 1048576 (w 8 9 0 0 0)))
        (= s 24) (w 1 2 5 2 8)
        (= s 25) (+ (w 2 2 4 2 3) (* 1048576 (w 1 5 0 0 0)))
        (= s 26) (w 2 1 5 1 5) (= s 27) (w 2 1 5 1 6) (= s 28) (w 2 1 6 1 5)
        (= s 29) (+ (w 2 2 2 2 3) (* 1048576 (w 3 3 0 0 0)))
        (= s 30) (w 2 1 5 7 0) (= s 31) (w 2 2 3 7 0) (= s 32) (w 2 2 2 8 8)
        (= s 33) (+ (+ (w 2 7 7 7 7) (* 1048576 (w 7 7 7 7 7))) (* 1099511627776 (w 7 7 7 7 7)))
        :else 0))
(defn nops [s :i64] :i64
  (cond (or (or (= s 0) (= s 1)) (or (or (= s 11) (= s 12)) (= s 33))) 1
        (or (or (or (= s 16) (= s 17)) (or (= s 18) (= s 20))) (or (or (= s 21) (= s 22)) (or (or (= s 24) (= s 26)) (or (or (= s 27) (= s 28)) (= s 32))))) 3
        (or (or (= s 23) (= s 25)) (= s 29)) 4
        :else 2))
(defn negn [n :i64 a [:ref :css.calc/node]] [:ref :css.calc/node]
  (if (= n 0) a (negn (- n 1) (c/op-neg a))))
(defn tree [s :i64 x0 :i64 x1 :i64 x2 :i64 x3 :i64] [:ref :css.calc/node]
  (cond (= s 0) (c/leaf-px x0)
        (= s 1) (c/leaf-number x0)
        (= s 2) (c/op-add (c/leaf-px x0) (c/leaf-px x1))
        (= s 3) (c/op-sub (c/leaf-px x0) (c/leaf-px x1))
        (= s 4) (c/op-mul (c/leaf-px x0) (c/leaf-number x1))
        (= s 5) (c/op-mul (c/leaf-number x0) (c/leaf-px x1))
        (= s 6) (c/op-mul (c/leaf-px x0) (c/leaf-px x1))
        (= s 7) (c/op-div (c/leaf-px x0) (c/leaf-number x1))
        (= s 8) (c/op-div (c/leaf-px x0) (c/leaf-px x1))
        (= s 9) (c/op-div (c/leaf-number x0) (c/leaf-number x1))
        (= s 10) (c/op-mul (c/leaf-number x0) (c/leaf-number x1))
        (= s 11) (c/op-neg (c/leaf-px x0))
        (= s 12) (c/op-neg (c/leaf-number x0))
        (= s 13) (c/op-min (c/leaf-px x0) (c/leaf-px x1))
        (= s 14) (c/op-max (c/leaf-px x0) (c/leaf-px x1))
        (= s 15) (c/op-min (c/leaf-px x0) (c/leaf-number x1))
        (= s 16) (c/op-clamp (c/leaf-px x0) (c/leaf-px x1) (c/leaf-px x2))
        (= s 17) (c/op-clamp (c/leaf-number x0) (c/leaf-number x1) (c/leaf-number x2))
        (= s 18) (c/op-clamp (c/leaf-px x0) (c/leaf-px x1) (c/leaf-number x2))
        (= s 19) (c/op-add (c/leaf-px x0) (c/leaf-number x1))
        (= s 20) (c/op-mul (c/op-add (c/leaf-px x0) (c/leaf-px x1)) (c/leaf-number x2))
        (= s 21) (c/op-add (c/op-mul (c/leaf-px x0) (c/leaf-number x1)) (c/leaf-px x2))
        (= s 22) (c/op-div (c/op-add (c/leaf-px x0) (c/leaf-px x1)) (c/leaf-number x2))
        (= s 23) (c/op-max (c/op-min (c/leaf-px x0) (c/leaf-px x1)) (c/op-min (c/leaf-px x2) (c/leaf-px x3)))
        (= s 24) (c/op-min (c/op-mul (c/leaf-number x0) (c/leaf-px x1)) (c/leaf-px x2))
        (= s 25) (c/op-mul (c/op-add (c/op-sub (c/leaf-px x0) (c/leaf-px x1)) (c/leaf-px x2)) (c/leaf-number x3))
        (= s 26) (c/op-mul (c/op-mul (c/leaf-px x0) (c/leaf-number x1)) (c/leaf-number x2))
        (= s 27) (c/op-div (c/op-mul (c/leaf-px x0) (c/leaf-number x1)) (c/leaf-number x2))
        (= s 28) (c/op-mul (c/op-div (c/leaf-px x0) (c/leaf-number x1)) (c/leaf-number x2))
        (= s 29) (c/op-add (c/leaf-px x0) (c/op-add (c/leaf-px x1) (c/op-add (c/leaf-px x2) (c/leaf-px x3))))
        (= s 30) (c/op-neg (c/op-mul (c/leaf-px x0) (c/leaf-number x1)))
        (= s 31) (c/op-neg (c/op-add (c/leaf-px x0) (c/leaf-px x1)))
        (= s 32) (c/op-min (c/leaf-px x0) (c/op-min (c/leaf-px x1) (c/leaf-px x2)))
        :else (negn 14 (c/leaf-px x0))))

(defn abs-i [x :i64] :i64 (if (< x 0) (- 0 x) x))
;; used operands in the Q6 domain? (the others are ignored by the program)
(defn dom? [s :i64 x0 :i64 x1 :i64 x2 :i64 x3 :i64] :bool
  (let [n (nops s)]
    (and (<= (abs-i x0) 1073741824)
         (and (or (< n 2) (<= (abs-i x1) 1073741824))
              (and (or (< n 3) (<= (abs-i x2) 1073741824)) (or (< n 4) (<= (abs-i x3) 1073741824)))))))
(defn exactly-one-rounding? [s :i64] :bool
  (or (or (or (= s 4) (= s 5)) (or (= s 7) (= s 9))) (or (or (= s 10) (= s 20)) (or (or (= s 21) (= s 22)) (or (or (= s 24) (= s 25)) (= s 30))))))
;; tolerance in half raw units (|2q - 2*scale*o|): 0 for exact programs, 1 per rounding, 1 + |factor| / 1 + 1/|divisor| for
;; two roundings in a row (the first error is multiplied by the second factor)
(defn tol [s :i64 x2 :i64] :f64
  (cond (exactly-one-rounding? s) 1.000001
        (or (= s 26) (= s 28)) (f64-add 1.000001 (f64-div (f64-abs (i64-to-f64-rounded x2)) 10000.0))
        (= s 27) (f64-add 1.000001 (f64-div 10000.0 (f64-abs (i64-to-f64-rounded (if (= x2 0) 1 x2)))))
        :else 0.000001))
(defn result-scale [is-px :bool] :f64 (if is-px 128.0 20000.0))

;; class: 0 both invalid, 1 compared within tolerance, 2 justified refusal, 3 edge band (not judged),
;; 4 Q6 accepted what the oracle rejects, 5 Q6 refused an in-domain valid program, 6 unit mismatch,
;; 7 deviation above tolerance, 8 Q6 accepted what its domain must refuse
(defn class-of [s :i64 c :i64] :i64
  (let [x0 (cat-at (digit c 0)) x1 (cat-at (digit c 1)) x2 (cat-at (digit c 2)) x3 (cat-at (digit c 3))
        ops (ops-of s)
        q (q6/eval-q6 ops (pk/pack x0 x1) (pk/pack x2 x3))
        qu (q6/result-unit ops)
        t (tree s x0 x1 x2 x3)
        ov (c/valid? t)
        qv (not= q (q6/invalid))
        peak (c/peak-of t)
        exact (not (f64-gt (tol s x2) 0.00001))
        band (if exact 0.001 (f64-add (f64-div (tol s x2) 2.0) 0.5))   ; rounding of the intermediates moves the peak by at most this
        refuse-must (or (or (not (dom? s x0 x1 x2 x3)) (f64-gt peak (f64-add 1073741824.0 band))) (c/wide? t))
        accept-must (and (and (dom? s x0 x1 x2 x3) (not (f64-gt peak (if exact (f64-add 1073741824.0 band) (f64-sub 1073741824.0 band))))) (not (c/wide? t)))
        o (c/value-of t)
        dev (f64-abs (f64-sub (f64-mul (i64-to-f64-rounded q) 2.0) (f64-mul o (result-scale (c/px? t)))))]
    (cond (not ov) (if qv 4 0)
          (not qv) (cond refuse-must 2 accept-must 5 :else 3)
          refuse-must 8
          (not accept-must) 3
          (not= qu (if (c/px? t) 1 0)) 6
          (f64-gt dev (tol s x2)) 7
          :else 1)))
(defn dev1000 [s :i64 c :i64] :i64
  (let [x0 (cat-at (digit c 0)) x1 (cat-at (digit c 1)) x2 (cat-at (digit c 2)) x3 (cat-at (digit c 3))
        q (q6/eval-q6 (ops-of s) (pk/pack x0 x1) (pk/pack x2 x3))
        t (tree s x0 x1 x2 x3)
        dev (f64-abs (f64-sub (f64-mul (i64-to-f64-rounded q) 2.0) (f64-mul (c/value-of t) (result-scale (c/px? t)))))]
    (if (= (class-of s c) 1) (f64-to-i64-truncating (f64-mul dev 1000.0)) 0)))
(defn span [s :i64] :i64 (cond (= (nops s) 1) 16 (= (nops s) 2) 256 (= (nops s) 3) 4096 :else 65536))
(defn count-class [s :i64 lo :i64 hi :i64] :i64
  (loop [i 0 acc 0]
    (if (>= i (span s)) acc
      (recur (+ i 1) (+ acc (let [k (class-of s i)] (if (and (>= k lo) (<= k hi)) 1 0)))))))
(defn maxdev [s :i64] :i64
  (loop [i 0 acc 0]
    (if (>= i (span s)) acc
      (recur (+ i 1) (let [d (dev1000 s i)] (if (> d acc) d acc))))))
(defn grid-stats [s :i64 which :i64] :i64
  (cond (= which 1) (+ (+ (count-class s 0 0) (* 2097152 (count-class s 1 1))) (* 4398046511104 (count-class s 2 2)))
        (= which 2) (+ (count-class s 3 3) (* 2097152 (count-class s 4 8)))
        :else (maxdev s)))

;; ---- spec points ----
(defn px [v :i64] :i64 (* v 64))
(defn run3 [ops :i64 a :i64 b :i64 d :i64 e :i64] :i64 (q6/eval-q6 ops (pk/pack a b) (pk/pack d e)))
(defn spec-ok? [] :bool
  (and
   ;; calc(100px + 20px) = 120px; calc(1px + 2px) = 3px; calc(100px) = 100px
   (= (run3 (ops-of 2) (px 100) (px 20) 0 0) (px 120)) (= (run3 (ops-of 2) (px 1) (px 2) 0 0) (px 3))
   (= (run3 (ops-of 0) (px 100) 0 0 0) (px 100))
   ;; calc(100px / 4) = 25px; calc(100px / 3): 33.333.. px = 2133.33 raw -> 2133; calc(10px * 2.5) = 25px; calc(2 * 15px) = 30px
   (= (run3 (ops-of 7) (px 100) 40000 0 0) (px 25)) (= (run3 (ops-of 7) (px 100) 30000 0 0) 2133)
   (= (run3 (ops-of 4) (px 10) 25000 0 0) (px 25)) (= (run3 (ops-of 5) 20000 (px 15) 0 0) (px 30))
   ;; invalid arithmetic (comments of eval-calc-node): 100px / 0, 100px * 20px, 100px + 5, 100px / 4px, min(10px, 2)
   (= (run3 (ops-of 7) (px 100) 0 0 0) (q6/invalid)) (= (run3 (ops-of 6) (px 100) (px 20) 0 0) (q6/invalid))
   (= (run3 (ops-of 19) (px 100) 50000 0 0) (q6/invalid)) (= (run3 (ops-of 8) (px 100) (px 4) 0 0) (q6/invalid))
   (= (run3 (ops-of 15) (px 10) 20000 0 0) (q6/invalid))
   ;; min(100px, 50px, 70px) = 50px; clamp(90px, 5px, 300px) = 90px (the comment of eval-calc-node); max(min(8px,12px), min(12px,40px)) = 12px
   (= (run3 (ops-of 32) (px 100) (px 50) (px 70) 0) (px 50)) (= (run3 (ops-of 16) (px 90) (px 5) (px 300) 0) (px 90))
   (= (run3 (ops-of 23) (px 8) (px 12) (px 12) (px 40)) (px 12))
   ;; negation and units: -(5px) ; the result unit is px (1) for px programs and number (0) for number programs
   (= (run3 (ops-of 11) (px 5) 0 0 0) (px -5)) (= (q6/result-unit (ops-of 11)) 1) (= (q6/result-unit (ops-of 9)) 0)
   (= (q6/result-unit (ops-of 6)) -1) (= (q6/result-unit (ops-of 7)) 1)
   ;; exact half-up ties: 1 raw * 0.5 = 0.5 -> 1 ; -1 raw * 0.5 -> 0 ; 3 * 0.5 = 1.5 -> 2 ; -3 * 0.5 -> -1 ; 1 raw / 2 = 0.5 -> 1
   (= (run3 (ops-of 4) 1 5000 0 0) 1) (= (run3 (ops-of 4) -1 5000 0 0) 0) (= (run3 (ops-of 4) 3 5000 0 0) 2)
   (= (run3 (ops-of 4) -3 5000 0 0) -1) (= (run3 (ops-of 7) 1 20000 0 0) 1) (= (run3 (ops-of 7) -1 20000 0 0) 0)
   ;; 10px * 0.1 is exactly 1px in D4 (a Q10 factor would give 63.75 raw)
   (= (run3 (ops-of 4) (px 10) 1000 0 0) (px 1))
   ;; the 15-operation program (one push and fourteen negations) is accepted and equals its operand
   (= (run3 (ops-of 33) 3200 0 0 0) 3200)))
;; ---- the assertions of the original suite (core_test.cljk 3176-3290, `calc-probe`), flattened to postfix by hand ----
;; The expected values are those the .cljk test asserts (in px); the programs are the postfix form of each expression.
(defn suite-ok? [] :bool
  (and
   (= (run3 (w 2 2 3 0 0) 6400 1280 0 0) 7680)                                   ; calc(100px + 20px) = 120
   (= (run3 (w 1 2 5 0 0) 20000 512 0 0) 1024)                                   ; calc(2 * 8px) = 16
   (= (run3 (w 2 1 6 0 0) 6400 40000 0 0) 1600)                                  ; calc(100px / 4) = 25
   (= (run3 (w 2 1 2 5 3) 6400 20000 512 0) 7424)                                ; calc(100px + 2 * 8px) = 116
   (= (run3 (w 2 2 4 2 4) 640 320 128 0) 192)                                    ; calc(10px - 5px - 2px) = 3
   (= (run3 (w 2 2 3 1 5) 640 384 20000 0) 2048)                                 ; calc((10px + 6px) * 2) = 32
   (= (run3 (w 2 7 2 3 0) 320 1280 0 0) 960)                                     ; calc(-5px + 20px) = 15
   (= (run3 (w 2 2 7 3 0) 640 320 0 0) 320)                                      ; calc(10px + -5px) = 5
   (= (run3 (w 2 2 8 0 0) 3200 6400 0 0) 3200)                                   ; min(100px, 50px) -> 50 (operands 50px, 100px)
   (= (run3 (w 2 2 9 0 0) 6400 3200 0 0) 6400)                                   ; max(100px, 50px) = 100
   (= (run3 (w 2 2 8 2 8) 6400 3200 4480 0) 3200)                                ; min(100px, 50px, 70px) = 50
   (= (run3 (w 2 2 2 10 0) 640 32000 5120 0) 5120)                               ; clamp(10px, 500px, 80px) = 80
   (= (run3 (w 2 2 2 10 0) 5760 320 19200 0) 5760)                               ; clamp(90px, 5px, 300px) = 90
   (= (run3 (w 2 2 8 0 0) 256 576 0 0) 256)                                      ; min(4px, 9px) = 4
   (= (run3 (w 2 2 8 2 3) 6400 3200 640 0) 3840)                                 ; calc(min(100px, 50px) + 10px) = 60
   (= (run3 (w 2 2 3 2 8) 640 320 1280 0) 960)                                   ; min(calc(10px + 5px), 20px) = 15
   (= (run3 (ops-of 23) 512 768 768 2560) 768)                                   ; max(min(8px, 12px), min(12px, 40px)) = 12
   (= (run3 (w 1 2 5 2 8) 20000 960 2560 0) 1920)                                ; min(2 * 15px, 40px) = 30
   (= (run3 (w 2 1 6 0 0) 6400 30000 0 0) 2133)                                  ; calc(100px / 3) = 33.33.. : 2133 raw = 33.328 px, within 1/128 px
   (= (run3 (w 2 1 6 0 0) 6400 0 0 0) (q6/invalid))                              ; calc(100px / 0) is not a number
   (= (run3 (w 2 2 5 0 0) 6400 1280 0 0) (q6/invalid))                           ; calc(100px * 20px)
   (= (run3 (w 2 2 6 0 0) 6400 256 0 0) (q6/invalid))                            ; calc(100px / 4px)
   (= (run3 (w 2 1 3 0 0) 6400 50000 0 0) (q6/invalid))                          ; calc(100px + 5)
   (= (run3 (w 2 1 8 0 0) 640 20000 0 0) (q6/invalid))))                         ; min(10px, 2)

;; programs beyond the bounds or malformed: every one must be refused
(defn refuse-ok? [] :bool
  (and (= (run3 (w 2 2 2 2 2) 64 64 64 64) (q6/invalid))                      ; five pushes
       (= (run3 (w 2 2 2 2 3) 64 64 64 64) (q6/invalid))                      ; four pushes, only one add: three values left
       (= (run3 (+ (+ (w 2 2 3 2 2) (* 1048576 (w 3 3 2 2 3))) (* 1099511627776 3)) 64 64 64 64) (q6/invalid))   ; six pushes, depth never above 3, one value left: the operand cap
       (= (run3 (w 2 0 2 3 0) 64 64 0 0) (q6/invalid))                        ; a zero nibble inside the stream
       (= (run3 (w 3 0 0 0 0) 64 64 0 0) (q6/invalid))                        ; add on an empty stack
       (= (run3 (w 2 2 0 0 0) 64 64 0 0) (q6/invalid))                        ; two values left
       (= (run3 0 64 64 0 0) (q6/invalid))                                    ; the empty program
       (= (run3 (w 2 11 0 0 0) 64 64 0 0) (q6/invalid))                       ; opcode 11
       (= (run3 (w 2 15 0 0 0) 64 64 0 0) (q6/invalid))                       ; opcode 15
       (= (run3 (+ (ops-of 33) (* 1152921504606846976 7)) 64 0 0 0) (q6/invalid))   ; a sixteenth operation (bit 60)
       (= (run3 (- 0 1) 64 0 0 0) (q6/invalid))                               ; negative word
       (= (run3 (ops-of 4) (px 100) 1073741825 0 0) (q6/invalid))             ; operand beyond 2^30
       (= (run3 (ops-of 2) 1073741824 1 0 0) (q6/invalid))                    ; sum beyond 2^30
       (= (run3 (ops-of 4) 1048576 100000 0 0) (q6/invalid))                  ; product bound: no factor below 2^16
       (= (run3 (ops-of 4) 1073741824 65535 0 0) (q6/invalid))                ; 7.0e9 raw leaves the range
       (= (run3 (ops-of 7) 1073741824 1 0 0) (q6/invalid))                    ; 1073741824 / 0.0001 leaves the range
       (= (q6/check (w 2 2 3 0 0)) 521)                                       ; type state: depth 1, px, two pushes
       (= (q6/check (+ (w 2 2 2 2 3) (* 1048576 (w 3 3 0 0 0)))) 1033)))      ; four pushes

;; the f64 reference itself against the same hand-derived values (px result in px, number result as a number)
(defn near [a :f64 b :f64] :bool (not (f64-gt (f64-abs (f64-sub a b)) 0.000000001)))
(defn ref-ok? [] :bool
  (and (near (c/value-of (c/op-add (c/leaf-px 6400) (c/leaf-px 1280))) 120.0)
       (near (c/value-of (c/op-div (c/leaf-px 6400) (c/leaf-number 40000))) 25.0)
       (near (c/value-of (c/op-mul (c/leaf-number 20000) (c/leaf-px 960))) 30.0)
       (near (c/value-of (c/op-clamp (c/leaf-px 5760) (c/leaf-px 320) (c/leaf-px 19200))) 90.0)
       (near (c/value-of (c/op-min (c/leaf-px 6400) (c/op-min (c/leaf-px 3200) (c/leaf-px 4480)))) 50.0)
       (not (c/valid? (c/op-div (c/leaf-px 6400) (c/leaf-number 0))))
       (not (c/valid? (c/op-mul (c/leaf-px 6400) (c/leaf-px 1280))))
       (not (c/valid? (c/op-add (c/leaf-px 6400) (c/leaf-number 50000))))
       (not (c/valid? (c/op-div (c/leaf-px 6400) (c/leaf-px 256))))
       (not (c/valid? (c/op-min (c/leaf-px 640) (c/leaf-number 20000))))
       (c/px? (c/op-mul (c/leaf-number 20000) (c/leaf-px 960)))
       (not (c/px? (c/op-div (c/leaf-number 20000) (c/leaf-number 10000))))))

;; ---- dense sweeps for the exact-tie report (no records: the f64 formula of cssom.calc op-mul / op-div inline) ----
(defn floor-i [x :f64] :i64
  (let [t (f64-to-i64-truncating x)] (if (f64-lt x (i64-to-f64-rounded t)) (- t 1) t)))
(defn oracle-raw [px-value :f64] :i64 (floor-i (f64-add (f64-mul px-value 64.0) 0.5)))
(defn mul-tie? [a :i64 b :i64] :bool (= (rem (abs-i (* a b)) 10000) 5000))
(defn div-tie? [a :i64 b :i64] :bool (= (rem (abs-i (* 20000 a)) (* 2 b)) b))
;; which: 0 pairs, 1 ties, 2 tie disagreements, 3 non-tie disagreements. kind 0 mul (P N *), 1 div (P N /)
(defn dense-one [kind :i64 a :i64 b :i64 which :i64] :i64
  (let [x (f64-div (i64-to-f64-rounded a) 64.0) y (f64-div (i64-to-f64-rounded b) 10000.0)
        o (oracle-raw (if (= kind 0) (f64-mul x y) (f64-div x y)))
        q (run3 (if (= kind 0) (ops-of 4) (ops-of 7)) a b 0 0)
        t (if (= kind 0) (mul-tie? a b) (div-tie? a b))]
    (cond (= which 0) 1
          (= which 1) (if t 1 0)
          (= which 2) (if (and t (not= o q)) 1 0)
          :else (if (and (not t) (not= o q)) 1 0))))
(defn dense [kind :i64 which :i64] :i64
  (loop [a -1024 b (if (= kind 0) 0 1) acc 0]
    (cond (> a 1023) acc
          (> b 20000) (recur (+ a 1) (if (= kind 0) 0 1) acc)
          :else (recur a (+ b 1) (+ acc (dense-one kind a b which))))))

(defn first-viol [s :i64 skip :i64] :i64
  (loop [i 0 k skip]
    (cond (>= i (span s)) -1
          (>= (class-of s i) 4) (if (= k 0) i (recur (+ i 1) (- k 1)))
          :else (recur (+ i 1) k))))

(defn main [] :i64
  (cond
    (= mode 1) (grid-stats slice 1) (= mode 2) (grid-stats slice 2) (= mode 3) (grid-stats slice 3)
    (= mode 4) (if (= (count-class slice 4 8) 0) 42 7)
    (= mode 5) (dense 0 0) (= mode 6) (dense 0 1) (= mode 7) (dense 0 2) (= mode 8) (dense 0 3)
    (= mode 9) (dense 1 0) (= mode 10) (dense 1 1) (= mode 11) (dense 1 2) (= mode 12) (dense 1 3)
    :else (if (and (spec-ok?) (and (suite-ok?) (and (refuse-ok?) (ref-ok?)))) 42 7)))
