(ns q6-length-vs-f64
  (:require [cssom.length :as f64len] [cssom.length-q6 :as q6])
  (:export [main]))

;; Differential gate (host native macOS, JUN-920 / C2b): Q6 length resolution (cssom.length-q6) against the f64
;; module cssom.length over a DETERMINISTIC grid (boundaries, zeros, negatives, maxima, exact .5 ties), plus dense
;; sweeps for the exact-tie report. Inputs are on the Q6 grid so the f64 side is exact on inputs; the only inexact
;; step of the oracle is percent: value * (basis * 0.01).
;;
;; mode 0 returns 42 when every check holds, 7 otherwise. Modes 1.. return a single pinned count (see the
;; gate script check-block-q6-native-macos.py for the pinned values).
(def mode 0)

(defn px-at [i :i64] :i64
  (cond (= i 0) 0 (= i 1) 1 (= i 2) 2 (= i 3) 31 (= i 4) 32 (= i 5) 33 (= i 6) 63 (= i 7) 64 (= i 8) 65
        (= i 9) 3200 (= i 10) 6400 (= i 11) 12800 (= i 12) 1073741824 (= i 13) 1073741825 (= i 14) -1
        (= i 15) -64 (= i 16) -1073741824 (= i 17) -1073741825 (= i 18) 134217728 :else 0))
(defn pct-at [i :i64] :i64
  (cond (= i 0) 0 (= i 1) 1 (= i 2) 50 (= i 3) 99 (= i 4) 100 (= i 5) 101 (= i 6) 2900 (= i 7) 5000
        (= i 8) 9999 (= i 9) 10000 (= i 10) 12345 (= i 11) 15000 (= i 12) 20000 (= i 13) 65535
        (= i 14) 65536 (= i 15) -1 (= i 16) -100 (= i 17) -5000 (= i 18) -65535 (= i 19) -65536 :else 0))
(defn basis-at [i :i64] :i64
  (cond (= i 0) 0 (= i 1) 1 (= i 2) 3 (= i 3) 63 (= i 4) 64 (= i 5) 65 (= i 6) 3200 (= i 7) 3201
        (= i 8) 6400 (= i 9) 12801 (= i 10) 1073741824 (= i 11) 1073741825 (= i 12) -1 (= i 13) -64 :else 0))
(defn unit-key [u :i64] :keyword
  (cond (= u 1) :length/px (= u 2) :length/percent (= u 3) :length/auto (= u 4) :length/none :else :length/em))
(defn kind-code [k :keyword] :i64
  (cond (= k :length/resolved) 1 (= k :length/auto) 2 (= k :length/none) 3 (= k :length/unresolved) 4 :else 0))
(defn to-px [raw :i64] :f64 (f64-mul (i64-to-f64-rounded raw) 0.015625))
;; the f64 value of a length: px-like units carry raw/64 px, percent carries H/100 (a percentage number)
(defn f64-value [unit :i64 v :i64] :f64
  (if (= unit 2) (f64-div (i64-to-f64-rounded v) 100.0) (to-px v)))
;; floor(x + 1/2) of an f64 (Math/round), exact for |x| < 2^52
(defn floor-i [x :f64] :i64
  (let [t (f64-to-i64-truncating x)] (if (f64-lt x (i64-to-f64-rounded t)) (- t 1) t)))
(defn round-raw [px :f64] :i64 (floor-i (f64-add (f64-mul px 64.0) 0.5)))
(defn abs-i [x :i64] :i64 (if (< x 0) (- 0 x) x))
(defn tie? [h :i64 b :i64] :bool (= (rem (abs-i (* h b)) 10000) 5000))
(defn domain-in? [unit :i64 v :i64 basis :i64] :bool
  (and (>= basis 0) (<= basis 1073741824)
       (if (= unit 2) (and (>= v -65535) (<= v 65535)) (and (>= v -1073741824) (<= v 1073741824)))))
(defn raw-ok? [x :i64] :bool (and (>= x -1073741824) (<= x 1073741824)))

;; counters: 0 cases, 1 kind mismatches, 2 value violations, 3 resolved percent cases, 4 ties,
;; 5 tie disagreements (oracle rounded value != Q6), 6 non-tie disagreements
;; returns the counter selected by `which` for one case; accumulated by the caller
(defn case-stat [unit :i64 v :i64 basis :i64 flags :i64 which :i64] :i64
  (let [definite (bit-and flags 1) negative (bit-and (i64-shift-right flags 1) 1)
        x (record [:ref :css.length/input] (unit-key unit) (f64-value unit v))
        z (f64len/resolve x (to-px basis) (= definite 1) (= negative 1))
        okind (kind-code (record-get [:ref :css.length/result] z :kind))
        oval (record-get [:ref :css.length/result] z :value)
        qkind (q6/resolve-kind unit v basis flags)
        qval (q6/resolve-value unit v basis flags)
        dom (domain-in? unit v basis)
        orr (if (= okind 1) (round-raw oval) 0)
        res-ok (or (not= okind 1) (raw-ok? orr))
        want (cond (not dom) 0 (not res-ok) 0 :else okind)
        kind-bad (not= qkind want)
        resolved-pct (and dom (= okind 1) (= unit 2))
        is-tie (and resolved-pct (tie? v basis))
        diff (and (= qkind 1) (= okind 1) (not= qval orr))
        val-bad (and (= qkind 1) (= okind 1)
                     (f64-gt (f64-abs (f64-sub (f64-mul (i64-to-f64-rounded qval) 2.0) (f64-mul oval 128.0))) 1.00001))]
    (cond (= which 0) 1
          (= which 1) (if kind-bad 1 0)
          (= which 2) (if val-bad 1 0)
          (= which 3) (if (and resolved-pct (= qkind 1)) 1 0)
          (= which 4) (if (and is-tie (= qkind 1)) 1 0)
          (= which 5) (if (and is-tie diff) 1 0)
          :else (if (and (not is-tie) diff) 1 0))))

(defn grid [which :i64] :i64
  (loop [u 1 vi 0 bi 0 fl 0 acc 0]
    (cond (> u 5) acc
          (> vi (if (= u 2) 19 18)) (recur (+ u 1) 0 0 0 acc)
          (> bi 13) (recur u (+ vi 1) 0 0 acc)
          (> fl 3) (recur u vi (+ bi 1) 0 acc)
          :else (recur u vi bi (+ fl 1)
                       (+ acc (case-stat u (if (= u 2) (pct-at vi) (px-at vi)) (basis-at bi) fl which))))))

;; dense Q6 sweep: H 0..30000 (0.01 % steps, 0..300 %) x basis raw 0..2047, the f64 formula of cssom.length
;; counted per `which`: 0 pairs, 1 ties, 2 tie disagreements, 3 non-tie disagreements
(defn dense-one [h :i64 b :i64 which :i64] :i64
  (let [o (f64-mul (f64-div (i64-to-f64-rounded h) 100.0) (f64-mul (to-px b) 0.01))
        orr (round-raw o) q (q6/percent-of h b) t (tie? h b)]
    (cond (= which 0) 1
          (= which 1) (if t 1 0)
          (= which 2) (if (and t (not= orr q)) 1 0)
          :else (if (and (not t) (not= orr q)) 1 0))))
(defn dense [which :i64] :i64
  (loop [h 0 b 0 acc 0]
    (cond (> h 30000) acc
          (> b 2047) (recur (+ h 1) 0 acc)
          :else (recur h (+ b 1) (+ acc (dense-one h b which))))))

;; integer-px sweep (layout.cljk percentage-of: (long (Math/round (* basis (/ pct 100.0)))) ): exact half-up is
;; q6/percent-of-int. step 100 = integer percent 0..300, step 1 = 0.01 % steps. which: 0 pairs, 1 differing,
;; 2 ties, 3 tie disagreements, 4 non-tie disagreements
(defn int-one [h :i64 b :i64 which :i64] :i64
  (let [p (f64-div (i64-to-f64-rounded h) 100.0)
        x (f64-mul (i64-to-f64-rounded b) (f64-div p 100.0))
        o (floor-i (f64-add x 0.5))
        q (q6/percent-of-int h b) t (tie? h b)]
    (cond (= which 0) 1
          (= which 1) (if (not= o q) 1 0)
          (= which 2) (if t 1 0)
          (= which 3) (if (and t (not= o q)) 1 0)
          :else (if (and (not t) (not= o q)) 1 0))))
(defn int-sweep [step :i64 which :i64] :i64
  (loop [h 0 b 0 acc 0]
    (cond (> h 30000) acc
          (> b 4096) (recur (+ h step) 0 acc)
          :else (recur h (+ b 1) (+ acc (int-one h b which))))))

;; exact spec points (hand-computed): half-up rounding, negatives, rdiv/fdiv identities
(defn spec-ok? [] :bool
  (and (= (q6/percent-of 2900 3200) 928)          ; 29 % of 50 px = 14.5 px = 928 raw, exact in Q6
       (= (q6/percent-of-int 2900 50) 15)         ; 29 % of 50 = 14.5 -> 15 (the f64 oracle gives 14)
       (= (q6/percent-of 5000 1) 1)               ; 0.5 -> 1 (half up)
       (= (q6/percent-of 5000 3) 2)               ; 1.5 -> 2
       (= (q6/percent-of -5000 1) 0)              ; -0.5 -> 0 (toward +inf)
       (= (q6/percent-of -5000 3) -1)             ; -1.5 -> -1
       (= (q6/percent-of -5000 5) -2)             ; -2.5 -> -2
       (= (q6/percent-of 1 4999) 0) (= (q6/percent-of 1 5000) 1)
       (= (q6/round-px 32) 1) (= (q6/round-px 31) 0) (= (q6/round-px -32) 0) (= (q6/round-px -33) -1)
       (= (q6/fdiv -7 2) -4) (= (q6/fdiv 7 2) 3) (= (q6/fdiv -8 2) -4)
       (= (q6/resolve-value 2 10000 1073741824 1) 1073741824)
       (= (q6/resolve-kind 2 10001 1073741824 1) 0)   ; 100.01 % of 2^30 leaves the range
       (= (q6/resolve-kind 2 5000 64 0) 4)            ; indefinite basis
       (= (q6/resolve-kind 3 0 64 1) 2) (= (q6/resolve-kind 4 0 64 1) 3) (= (q6/resolve-kind 9 0 64 1) 0)
       (= (q6/resolve-kind 1 -64 64 1) 0) (= (q6/resolve-kind 1 -64 64 3) 1)))

(defn main [] :i64
  (cond
    (= mode 1) (grid 0) (= mode 2) (grid 1) (= mode 3) (grid 2) (= mode 4) (grid 3) (= mode 5) (grid 4)
    (= mode 6) (grid 5) (= mode 7) (grid 6)
    (= mode 8) (dense 0) (= mode 9) (dense 1) (= mode 10) (dense 2) (= mode 11) (dense 3)
    (= mode 12) (int-sweep 100 0) (= mode 13) (int-sweep 100 1) (= mode 14) (int-sweep 100 2)
    (= mode 15) (int-sweep 100 3) (= mode 16) (int-sweep 100 4)
    (= mode 17) (int-sweep 1 0) (= mode 18) (int-sweep 1 1) (= mode 19) (int-sweep 1 2)
    (= mode 20) (int-sweep 1 3) (= mode 21) (int-sweep 1 4)
    :else (if (and (spec-ok?) (= (grid 1) 0) (= (grid 2) 0) (= (grid 6) 0)
                   (= (dense 3) 0) (= (int-sweep 100 4) 0) (= (int-sweep 1 4) 0)) 42 7)))
