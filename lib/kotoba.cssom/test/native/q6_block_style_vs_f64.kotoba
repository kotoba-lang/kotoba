(ns q6-block-style-vs-f64
  (:require [cssom.length :as f64len] [cssom.block-width :as f64w] [cssom.block-style :as f64s]
            [cssom.length-q6 :as len] [cssom.block-width-q6 :as qw] [cssom.block-style-q6 :as q6])
  (:export [main]))

;; Differential gate (host native macOS, JUN-920 / C2b): the Q6 style bridge (cssom.block-style-q6: five packed words,
;; lengths resolved by cssom.length-q6, then the Q6 constrained solver) against the f64 module cssom.block-style over
;; a DETERMINISTIC grid of 13 style inputs: units px / percent / auto / none / an unsupported unit, zero, negative,
;; exact .5 tie percentages of odd containing widths (50 % of 12801 raw), min / max in both orders, both box
;; sizings, ltr / rtl, negative borders. 1,008,000 cases in 28 slices (containing width x width kind; the host runtime keeps every record).
;;
;; Tolerance: every percentage term (width, min, max, margins, paddings) is rounded once (<= 1/128 px) and the auto
;; margin halves once more, so |q6 - f64| <= (percent terms + 1) / 128 px. A Q6 refusal is accepted only when an input
;; is outside the Q6 style domain (a slot value outside [-2^27, 2^27), 2^21 px) or the oracle is invalid.
;; mode 0 returns 42 when every case holds, 7 otherwise. Modes: 1 cases + compared<<21 + refused<<42, 2 both-invalid +
;; max-deviation(1/128 px)<<21, 3 violations, 4 verdict (42 / 7) for one slice.
(def mode 0)
(def slice 0)

(defn to-px [raw :i64] :f64 (f64-mul (i64-to-f64-rounded raw) 0.015625))
(defn unit-key [u :i64] :keyword
  (cond (= u 1) :length/px (= u 2) :length/percent (= u 3) :length/auto (= u 4) :length/none :else :length/em))
(defn lval [unit :i64 v :i64] :f64 (if (= unit 2) (f64-div (i64-to-f64-rounded v) 100.0) (to-px v)))
(defn lin [unit :i64 v :i64] [:ref :css.length/input] (record [:ref :css.length/input] (unit-key unit) (lval unit v)))
;; the lengths: unit and value by index
(defn w-unit [i :i64] :i64 (cond (= i 0) 3 (= i 1) 1 (= i 2) 1 (= i 3) 2 (= i 4) 1 (= i 5) 1 :else 9))
(defn w-val [i :i64] :i64 (cond (= i 2) 6400 (= i 3) 5000 (= i 4) -64 (= i 5) 134217728 (= i 6) 64 :else 0))
(defn mn-unit [i :i64] :i64 (cond (= i 0) 1 (= i 1) 1 (= i 2) 2 :else 3))
(defn mn-val [i :i64] :i64 (cond (= i 1) 3200 (= i 2) 2500 :else 0))
(defn mx-unit [i :i64] :i64 (cond (= i 0) 4 (= i 1) 1 (= i 2) 1 (= i 3) 2 :else 2))
(defn mx-val [i :i64] :i64 (cond (= i 2) 6400 (= i 3) 5000 (= i 4) 20000 :else 0))
(defn m-unit [i :i64] :i64 (cond (= i 0) 3 (= i 1) 1 (= i 2) 1 (= i 3) 2 :else 1))
(defn m-val [i :i64] :i64 (cond (= i 2) 640 (= i 3) 1000 (= i 4) -640 :else 0))
(defn pl-unit [i :i64] :i64 (cond (= i 0) 1 (= i 1) 2 :else 2))
(defn pl-val [i :i64] :i64 (cond (= i 1) 500 (= i 2) -100 :else 0))
(defn pr-unit [i :i64] :i64 1)
(defn pr-val [i :i64] :i64 (cond (= i 1) 640 :else 0))
(defn bl-at [i :i64] :i64 (cond (= i 1) 128 (= i 2) -1 :else 0))
(defn br-at [i :i64] :i64 (cond (= i 1) 192 :else 0))
(defn cb-at [i :i64] :i64 (cond (= i 0) 0 (= i 1) 12800 (= i 2) 12801 :else 1))
(defn pct? [u :i64] :bool (= u 2))
(defn slot-bad? [unit :i64 v :i64] :bool (and (or (= unit 1) (= unit 2)) (or (< v -134217728) (> v 134217727))))
(defn out [z [:ref :css.block/result] sel :i64] :f64
  (cond (= sel 1) (record-get [:ref :css.block/result] z :content) (= sel 2) (record-get [:ref :css.block/result] z :border)
        (= sel 3) (record-get [:ref :css.block/result] z :margin-left) :else (record-get [:ref :css.block/result] z :margin-right)))
(defn dev [q :i64 o :f64] :f64 (f64-abs (f64-sub (f64-mul (i64-to-f64-rounded q) 2.0) (f64-mul o 128.0))))
(defn dev-units [q :i64 o :f64] :i64
  (let [d (dev q o)] (if (f64-gt d 1000000.0) 1000000 (f64-to-i64-truncating (f64-add d 0.99999)))))
(defn mx3 [a :i64 b :i64 c :i64 d :i64] :i64 (max (max a b) (max c d)))

;; outcome: low 3 bits: 1 compared, 2 refusal (justified), 4 both invalid, 8 violation; deviation in 1/128 px << 8
(defn outcome [wi :i64 mi :i64 xi :i64 li :i64 ri :i64 pli :i64 pri :i64 bi :i64 cbi :i64 bb :i64 rtl :i64] :i64
  (let [cb (cb-at cbi)
        wu (w-unit wi) wv (w-val wi) mnu (mn-unit mi) mnv (mn-val mi) mxu (mx-unit xi) mxv (mx-val xi)
        lu (m-unit li) lv (m-val li) ru (m-unit ri) rv (m-val ri) plu (pl-unit pli) plv (pl-val pli) pru (pr-unit pri) prv (pr-val pri)
        bl (bl-at bi) br (br-at bi)
        s (record [:ref :css.block/style] (to-px cb) (lin wu wv) (lin mnu mnv) (lin mxu mxv) (lin lu lv) (lin ru rv)
                  (lin plu plv) (lin pru prv) (to-px bl) (to-px br) (= bb 1) (= rtl 1))
        z (f64s/solve s)
        ov (record-get [:ref :css.block/result] z :valid)
        dom (not (or (slot-bad? wu wv) (slot-bad? mnu mnv) (slot-bad? mxu mxv) (slot-bad? lu lv) (slot-bad? ru rv)
                     (slot-bad? plu plv) (slot-bad? pru prv)))
        k (+ (+ (+ (if (pct? wu) 1 0) (if (pct? mnu) 1 0)) (+ (if (pct? mxu) 1 0) (if (pct? lu) 1 0)))
             (+ (+ (if (pct? ru) 1 0) (if (pct? plu) 1 0)) (if (pct? pru) 1 0)))
        p0 (q6/p0-of cb 1 bb rtl)
        p1 (q6/pair (q6/slot wu wv) (q6/slot mnu mnv)) p2 (q6/pair (q6/slot mxu mxv) (q6/slot lu lv))
        p3 (q6/pair (q6/slot ru rv) (q6/slot plu plv)) p4 (q6/pair (q6/slot pru prv) (q6/border-field bl br))
        q1 (q6/solve-pick (+ p0 0) p1 p2 p3 p4)
        q2 (q6/solve-pick (+ p0 4) p1 p2 p3 p4)
        q3 (q6/solve-pick (+ p0 8) p1 p2 p3 p4)
        q4 (q6/solve-pick (+ p0 12) p1 p2 p3 p4)
        qv (and (not= q1 (q6/invalid)) (not= q2 (q6/invalid)) (not= q3 (q6/invalid)) (not= q4 (q6/invalid)))
        qi (and (= q1 (q6/invalid)) (= q2 (q6/invalid)) (= q3 (q6/invalid)) (= q4 (q6/invalid)))
        dv (mx3 (dev-units q1 (out z 1)) (dev-units q2 (out z 2)) (dev-units q3 (out z 3)) (dev-units q4 (out z 4)))]
    (cond (and (not qv) (not qi)) 8
          qv (if (and dom ov (<= dv (+ k 1))) (+ 1 (i64-shift-left dv 8)) 8)
          (not ov) 4
          (not dom) 2
          :else 8)))
(defn pick [o :i64 which :i64] :i64
  (cond (= which 1) (+ (+ 1 (i64-shift-left (bit-and o 1) 21)) (i64-shift-left (bit-and (i64-shift-right o 1) 1) 42))
        (= which 2) (+ (bit-and (i64-shift-right o 2) 1) (i64-shift-left (i64-shift-right o 8) 21))
        :else (bit-and (i64-shift-right o 3) 1)))
(defn sweep [which :i64] :i64
  (loop [mi 0 xi 0 li 0 ri 0 pli 0 pri 0 bi 0 bb 0 rtl 0 acc 0 mxdev 0]
    (cond (> mi 3) (if (= which 2) (+ (bit-and acc 2097151) (i64-shift-left mxdev 21)) acc)
          (> xi 4) (recur (+ mi 1) 0 0 0 0 0 0 0 0 acc mxdev)
          (> li 4) (recur mi (+ xi 1) 0 0 0 0 0 0 0 acc mxdev)
          (> ri 4) (recur mi xi (+ li 1) 0 0 0 0 0 0 acc mxdev)
          (> pli 2) (recur mi xi li (+ ri 1) 0 0 0 0 0 acc mxdev)
          (> pri 1) (recur mi xi li ri (+ pli 1) 0 0 0 0 acc mxdev)
          (> bi 2) (recur mi xi li ri pli (+ pri 1) 0 0 0 acc mxdev)
          (> bb 1) (recur mi xi li ri pli pri (+ bi 1) 0 0 acc mxdev)
          (> rtl 1) (recur mi xi li ri pli pri bi (+ bb 1) 0 acc mxdev)
          :else (let [o (outcome (rem slice 7) mi xi li ri pli pri bi (quot slice 7) bb rtl)]
                  (recur mi xi li ri pli pri bi bb (+ rtl 1) (+ acc (pick o which)) (max mxdev (i64-shift-right o 8)))))))

(defn spec-ok? [] :bool
  (let [p0 (q6/p0-of 12800 1 0 0)
        ;; 50 % wide, margins auto, in 200 px: content 100 px, margins 50 px each
        a (q6/pair (q6/slot 2 5000) (q6/slot 1 0)) b (q6/pair (q6/slot 4 0) (q6/slot 3 0))
        c (q6/pair (q6/slot 3 0) (q6/slot 1 0)) d (q6/pair (q6/slot 1 0) (q6/border-field 0 0))]
    (and (= (q6/solve-pick p0 a b c d) 6400)
         (= (q6/solve-pick (+ p0 8) a b c d) 3200)
         (= (q6/solve-pick (+ p0 12) a b c d) 3200)
         (= (q6/solve-pick p0 a b c (q6/pair (q6/slot 1 0) 0)) (q6/invalid))      ; border-field 0 = refused border
         (= (q6/border-field -1 0) 0) (= (q6/border-field 5 7) 13) (= (q6/border-field 1073741824 1) 0)
         (= (q6/slot 1 134217728) 0) (not= (q6/slot 1 134217727) 0))))
(defn main [] :i64
  (cond (= mode 0) (if (spec-ok?) 42 7)
        (= mode 4) (if (and (spec-ok?) (= (sweep 3) 0)) 42 7)
        :else (sweep mode)))
