(ns css-block-width-test
  (:require [cssom.block-width :as width])
  (:export [main]))
(defn make [cb :f64 w :f64 auto :bool border :bool l :f64 la :bool r :f64 ra :bool
            pl :f64 pr :f64 bl :f64 br :f64 rtl :bool] [:ref :css.block/input]
  (record [:ref :css.block/input] cb w auto border l la r ra pl pr bl br rtl))
(defn check [x [:ref :css.block/input] content :f64 border :f64 l :f64 r :f64] :bool
  (let [z (width/solve x)]
    (and (record-get [:ref :css.block/result] z :valid)
         (f64-eq (record-get [:ref :css.block/result] z :content) content)
         (f64-eq (record-get [:ref :css.block/result] z :border) border)
         (f64-eq (record-get [:ref :css.block/result] z :margin-left) l)
         (f64-eq (record-get [:ref :css.block/result] z :margin-right) r))))
(defn invalid? [x [:ref :css.block/input]] :bool
  (not (record-get [:ref :css.block/result] (width/solve x) :valid)))
(defn constrained [x [:ref :css.block/input] min :f64 max :f64 has-max :bool
                  content :f64 border :f64 l :f64 r :f64] :bool
  (let [z (width/solve-constrained x min max has-max)]
    (and (record-get [:ref :css.block/result] z :valid)
         (f64-eq (record-get [:ref :css.block/result] z :content) content)
         (f64-eq (record-get [:ref :css.block/result] z :border) border)
         (f64-eq (record-get [:ref :css.block/result] z :margin-left) l)
         (f64-eq (record-get [:ref :css.block/result] z :margin-right) r))))
(defn main [] :i64
  (if (and (check (make 200.0 80.0 false false 0.0 true 0.0 true 0.0 0.0 0.0 0.0 false) 80.0 80.0 60.0 60.0)
           (check (make 200.0 100.0 false false 10.0 false 0.0 true 10.0 5.0 2.0 3.0 false) 100.0 120.0 10.0 70.0)
           (check (make 200.0 220.0 false false 10.0 false 10.0 false 0.0 0.0 0.0 0.0 true) 220.0 220.0 -30.0 10.0)
           (check (make 200.0 220.0 false false 0.0 true 0.0 true 0.0 0.0 0.0 0.0 false) 220.0 220.0 0.0 -20.0)
           (check (make 200.0 0.0 true false 10.0 false 20.0 false 10.0 10.0 10.0 10.0 false) 130.0 170.0 10.0 20.0)
           (check (make 200.0 0.0 true false 0.0 true 0.0 true 110.0 110.0 0.0 0.0 false) 0.0 220.0 0.0 -20.0)
           (check (make 200.0 100.0 false true 0.0 true 0.0 true 10.0 5.0 2.0 3.0 false) 80.0 100.0 50.0 50.0)
           (check (make 200.0 5.0 false true 0.0 true 0.0 true 10.0 5.0 2.0 3.0 false) 0.0 20.0 90.0 90.0)
           (constrained (make 200.0 0.0 true false 0.0 true 0.0 true 0.0 0.0 0.0 0.0 false) 0.0 100.0 true 100.0 100.0 50.0 50.0)
           (constrained (make 200.0 0.0 true false 0.0 true 0.0 true 0.0 0.0 0.0 0.0 false) 250.0 0.0 false 250.0 250.0 0.0 -50.0)
           (constrained (make 200.0 0.0 true false 0.0 true 0.0 true 0.0 0.0 0.0 0.0 true) 250.0 0.0 false 250.0 250.0 -50.0 0.0)
           (constrained (make 200.0 180.0 false false 0.0 true 0.0 true 0.0 0.0 0.0 0.0 false) 150.0 100.0 true 150.0 150.0 25.0 25.0)
           (constrained (make 200.0 0.0 true true 0.0 true 0.0 true 10.0 5.0 2.0 3.0 false) 0.0 100.0 true 80.0 100.0 50.0 50.0)
           (constrained (make 200.0 0.0 true true 0.0 true 0.0 true 10.0 5.0 2.0 3.0 false) 5.0 5.0 true 0.0 20.0 90.0 90.0)
           (not (record-get [:ref :css.block/result] (width/solve-constrained (make 200.0 80.0 false false 0.0 true 0.0 true 0.0 0.0 0.0 0.0 false) -1.0 100.0 true) :valid))
           (invalid? (make 200.0 80.0 false false 0.0 true 0.0 true -1.0 0.0 0.0 0.0 false))
           (invalid? (make (f64-from-bits 9218868437227405312) 0.0 true false 0.0 true 0.0 true 0.0 0.0 0.0 0.0 false))) 42 0))
