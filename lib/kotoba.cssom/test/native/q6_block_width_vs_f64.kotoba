(ns q6-block-width-vs-f64
  (:require [cssom.block-width :as f64w] [cssom.block-width-q6 :as q6])
  (:export [main]))

;; Differential gate (host native macOS, JUN-920 / C2b): Q6 block-width solver (cssom.block-width-q6, scalar i64,
;; five words) against the f64 module cssom.block-width, `solve` and `solve-constrained`, over a DETERMINISTIC grid
;; (zeros, ones, odd Q6 raws that make the auto-margin half inexact, negatives, the 2^30 range edge and one past it,
;; all 32 flag combinations) plus the 1,000,000-sample LCG sweep of the census. Inputs are on the Q6 grid, so the f64
;; side is exact on inputs. Tolerance: |q6 - f64| <= 1/128 px (the auto-margin half of an odd Q6 raw).
;;
;; A Q6 refusal (-2^62) is accepted only when justified: an input is outside the Q6 domain, the f64 oracle itself is
;; invalid, or an output of one of the oracle's solves is within one raw unit of the 2^30 range edge or beyond it.
;; mode 0 returns 42 when every case holds, 7 otherwise; modes 1.. return one pinned count each.
(def mode 0)   ; 0: spec points only; 10 * G + which, G 1 unconstrained grid, 2 constrained grid, 3 LCG sweep
(def slice 0)  ; one slice of the grid per run (the host runtime keeps every record, so a run is bounded)

(defn to-px [raw :i64] :f64 (f64-mul (i64-to-f64-rounded raw) 0.015625))
(defn bit [f :i64 b :i64] :bool (not= (bit-and (i64-shift-right f b) 1) 0)) 
(defn mk [cb :i64 w :i64 auto :bool bb :bool l :i64 la :bool r :i64 ra :bool pl :i64 pr :i64 bl :i64 br :i64 rtl :bool] [:ref :css.block/input]
  (record [:ref :css.block/input] (to-px cb) (to-px w) auto bb (to-px l) la (to-px r) ra (to-px pl) (to-px pr) (to-px bl) (to-px br) rtl))
;; |2 q - 128 o| for q a Q6 raw and o an f64 px value: units of 1/128 px
(defn dev [q :i64 o :f64] :f64 (f64-abs (f64-sub (f64-mul (i64-to-f64-rounded q) 2.0) (f64-mul o 128.0))))
(defn rng? [x :i64] :bool (and (>= x -1073741824) (<= x 1073741824)))
(defn nn? [x :i64] :bool (and (>= x 0) (<= x 1073741824)))
(defn near-edge? [o :f64] :bool (f64-gt (f64-abs o) 16777215.9))   ; 1073741823 / 64
(defn oob? [z [:ref :css.block/result]] :bool
  (or (near-edge? (record-get [:ref :css.block/result] z :content)) (near-edge? (record-get [:ref :css.block/result] z :border))
      (near-edge? (record-get [:ref :css.block/result] z :margin-left)) (near-edge? (record-get [:ref :css.block/result] z :margin-right))))
(defn out [z [:ref :css.block/result] sel :i64] :f64
  (cond (= sel 1) (record-get [:ref :css.block/result] z :content) (= sel 2) (record-get [:ref :css.block/result] z :border)
        (= sel 3) (record-get [:ref :css.block/result] z :margin-left) :else (record-get [:ref :css.block/result] z :margin-right)))
(defn max0 [x :i64] :i64 (if (< x 0) 0 x))

;; Per-case outcome as bits: 1 compared (both valid), 2 justified refusal with a valid oracle, 4 both invalid,
;; 8 violation, 16 compared and at least one output differs by exactly 1/128 px (odd half of an auto margin).
;; The sums are packed 21 bits per field so that one run reports several pinned counts:
;;   which 1: cases + compared << 21 + refusals << 42     which 2: both-invalid + half-cases << 21     which 3: violations
(defn risk-of [cb :i64 w :i64 l :i64 r :i64 pl :i64 pr :i64 bl :i64 br :i64 fl :i64 cstr :i64 mn :i64 mx :i64 extra :i64 z [:ref :css.block/result]] :bool
  (let [auto (bit fl 0) bb (bit fl 1) la (bit fl 2) ra (bit fl 3) rtl (bit fl 4) hm (bit fl 5)
        x (mk cb w auto bb l la r ra pl pr bl br rtl)
        mxc (if bb (max0 (- mx extra)) mx) mnc (if bb (max0 (- mn extra)) mn)]
    (or (oob? z) (oob? (f64w/solve x))
        (and (not= cstr 0) hm (oob? (f64w/solve (mk cb mxc false false l la r ra pl pr bl br rtl))))
        (and (not= cstr 0) (oob? (f64w/solve (mk cb mnc false false l la r ra pl pr bl br rtl)))))))
(defn outcome [cb :i64 w :i64 l :i64 r :i64 pl :i64 pr :i64 bl :i64 br :i64 fl :i64 cstr :i64 mn :i64 mx :i64] :i64
  (let [auto (bit fl 0) bb (bit fl 1) la (bit fl 2) ra (bit fl 3) rtl (bit fl 4) hm (bit fl 5)
        parts-ok (and (>= pl 0) (>= pr 0) (>= bl 0) (>= br 0))
        extra (if parts-ok (+ (+ pl pr) (+ bl br)) -1)
        x (mk cb w auto bb l la r ra pl pr bl br rtl)
        z (if (= cstr 0) (f64w/solve x) (f64w/solve-constrained x (to-px mn) (to-px mx) hm))
        ov (record-get [:ref :css.block/result] z :valid)
        dom (and (nn? cb) (nn? w) (rng? l) (rng? r) parts-ok (nn? extra)
                 (or (= cstr 0) (and (nn? mn) (nn? mx))))
        f6 (bit-and fl (if (= cstr 0) 31 63))
        pw (q6/pack cb w) plr (q6/pack l r) pmm (q6/pack mn mx)
        q1 (if (= cstr 0) (q6/solve-pick (+ f6 64) pw plr extra) (q6/solve-constrained-pick (+ f6 64) pw plr extra pmm))
        q2 (if (= cstr 0) (q6/solve-pick (+ f6 128) pw plr extra) (q6/solve-constrained-pick (+ f6 128) pw plr extra pmm))
        q3 (if (= cstr 0) (q6/solve-pick (+ f6 192) pw plr extra) (q6/solve-constrained-pick (+ f6 192) pw plr extra pmm))
        q4 (if (= cstr 0) (q6/solve-pick (+ f6 256) pw plr extra) (q6/solve-constrained-pick (+ f6 256) pw plr extra pmm))
        qv (and (not= q1 (q6/invalid)) (not= q2 (q6/invalid)) (not= q3 (q6/invalid)) (not= q4 (q6/invalid)))
        qi (and (= q1 (q6/invalid)) (= q2 (q6/invalid)) (= q3 (q6/invalid)) (= q4 (q6/invalid)))
        d1 (dev q1 (out z 1)) d2 (dev q2 (out z 2)) d3 (dev q3 (out z 3)) d4 (dev q4 (out z 4))
        match (and (f64-le d1 1.00001) (f64-le d2 1.00001) (f64-le d3 1.00001) (f64-le d4 1.00001))
        half (or (f64-ge d1 0.99999) (f64-ge d2 0.99999) (f64-ge d3 0.99999) (f64-ge d4 0.99999))]
    ;; sound: a valid Q6 answer needs an in-domain input, a valid oracle and a match;
    ;; complete: an in-domain valid oracle answer may only be refused at the range edge
    (cond (and (not qv) (not qi)) 8
          qv (if (and dom ov match) (if (and ov half) 17 1) 8)
          (not ov) 4
          (and dom (risk-of cb w l r pl pr bl br fl cstr mn mx extra z)) 2
          dom 8
          :else 2)))
(defn case [cb :i64 w :i64 l :i64 r :i64 pl :i64 pr :i64 bl :i64 br :i64 fl :i64 cstr :i64 mn :i64 mx :i64 which :i64] :i64
  (let [o (outcome cb w l r pl pr bl br fl cstr mn mx) c (bit-and o 1) rf (bit-and (i64-shift-right o 1) 1)
        bi (bit-and (i64-shift-right o 2) 1) bad (bit-and (i64-shift-right o 3) 1) hf (bit-and (i64-shift-right o 4) 1)]
    (cond (= which 1) (+ (+ 1 (i64-shift-left c 21)) (i64-shift-left rf 42))
          (= which 2) (+ bi (i64-shift-left hf 21))
          :else bad)))

(defn cb-at [i :i64] :i64
  (cond (= i 0) 0 (= i 1) 1 (= i 2) 64 (= i 3) 3200 (= i 4) 12800 (= i 5) 12801 (= i 6) 1073741824 (= i 7) 1073741825 :else -1))
(defn w-at [i :i64] :i64
  (cond (= i 0) 0 (= i 1) 1 (= i 2) 63 (= i 3) 64 (= i 4) 5120 (= i 5) 12800 (= i 6) 12801 (= i 7) 19200
        (= i 8) 1073741824 (= i 9) 1073741825 :else -1))
(defn lr-at [i :i64] :i64
  (cond (= i 0) 0 (= i 1) 1 (= i 2) -64 (= i 3) 640 (= i 4) 3201 (= i 5) 12800 (= i 6) -1073741824
        (= i 7) 1073741824 (= i 8) 1073741825 :else -1073741825))
;; padding/border tuples: pl pr bl br
(defn pl-at [i :i64] :i64
  (cond (= i 0) 0 (= i 1) 640 (= i 2) 1 (= i 3) 1 (= i 4) 3 (= i 5) 64 (= i 6) -1 (= i 7) 0 (= i 8) 0 (= i 9) 1073741824
        (= i 10) 1073741824 :else 5000))
(defn pr-at [i :i64] :i64
  (cond (= i 1) 320 (= i 3) 1 (= i 4) 5 (= i 5) 64 (= i 10) 1 (= i 11) 6000 :else 0))
(defn bl-at [i :i64] :i64
  (cond (= i 1) 128 (= i 3) 1 (= i 4) 7 (= i 5) 64 (= i 7) -1 (= i 11) 700 :else 0))
(defn br-at [i :i64] :i64
  (cond (= i 1) 192 (= i 3) 1 (= i 4) 9 (= i 5) 64 (= i 8) -64 (= i 11) 800 :else 0))

;; unconstrained grid: 9 cb x 10 w x 9 left x 9 right x 12 padding/border tuples x 32 flags; a slice is one cb value (9 slices)
(defn grid [which :i64] :i64
  (loop [b 0 c 0 d 0 e 0 f 0 acc 0]
    (cond (> b 9) acc
          (> c 8) (recur (+ b 1) 0 0 0 0 acc)
          (> d 8) (recur b (+ c 1) 0 0 0 acc)
          (> e 11) (recur b c (+ d 1) 0 0 acc)
          (> f 31) (recur b c d (+ e 1) 0 acc)
          :else (recur b c d e (+ f 1)
                       (+ acc (case (cb-at slice) (w-at b) (lr-at c) (lr-at d) (pl-at e) (pr-at e) (bl-at e) (br-at e) f 0 0 0 which))))))

(defn mn-at [i :i64] :i64
  (cond (= i 0) 0 (= i 1) 64 (= i 2) 3200 (= i 3) 12801 (= i 4) -1 :else 1073741825))
(defn mx-at [i :i64] :i64
  (cond (= i 0) 0 (= i 1) 63 (= i 2) 3200 (= i 3) 12800 (= i 4) 19200 (= i 5) -1 :else 1073741825))
(defn lr2-at [i :i64] :i64 (cond (= i 0) 0 (= i 1) -64 (= i 2) 640 :else 12800))
(defn ex2-at [i :i64] :i64 (cond (= i 0) 0 (= i 1) 1 (= i 2) 2 (= i 3) 4 (= i 4) 6 :else 10))
(defn cb2-at [i :i64] :i64 (cond (= i 0) 0 (= i 1) 3200 (= i 2) 12800 :else 12801))
(defn w2-at [i :i64] :i64 (cond (= i 0) 0 (= i 1) 64 (= i 2) 5120 (= i 3) 12800 :else 12801))

;; constrained grid: 4 cb x 5 w x 4 left x 4 right x 6 extras x 64 flags (incl. has-max) x 6 min x 7 max;
;; a slice is one (cb, w) pair (20 slices)
(defn grid-c [which :i64] :i64
  (loop [c 0 d 0 e 0 f 0 g 0 h 0 acc 0]
    (cond (> c 3) acc
          (> d 3) (recur (+ c 1) 0 0 0 0 0 acc)
          (> e 5) (recur c (+ d 1) 0 0 0 0 acc)
          (> f 63) (recur c d (+ e 1) 0 0 0 acc)
          (> g 5) (recur c d e (+ f 1) 0 0 acc)
          (> h 6) (recur c d e f (+ g 1) 0 acc)
          :else (recur c d e f g (+ h 1)
                       (+ acc (case (cb2-at (quot slice 5)) (w2-at (- slice (* 5 (quot slice 5)))) (lr2-at c) (lr2-at d)
                                    (pl-at (ex2-at e)) (pr-at (ex2-at e)) (bl-at (ex2-at e)) (br-at (ex2-at e))
                                    f 1 (mn-at g) (mx-at h) which))))))

;; census sweep: deterministic LCG, valid-range draws; every sample is solved both unconstrained and constrained
;; (min / max drawn); a slice is 250,000 consecutive samples (4 slices = the census's 1,000,000)
(defn rnd [x :i64] :i64 (bit-and (+ (* x 1103515245) 12345) 2147483647))
(defn draw [x :i64] :i64 (let [k (+ 3 (bit-and (i64-shift-right x 20) 15))] (bit-and (i64-shift-right x 3) (- (i64-shift-left 1 k) 1))))
(defn lcg-one [seed :i64 which :i64] :i64
  (let [s1 (rnd seed) s2 (rnd s1) s3 (rnd s2) s4 (rnd s3) s5 (rnd s4) s6 (rnd s5) s7 (rnd s6) s8 (rnd s7) s9 (rnd s8) s10 (rnd s9) s11 (rnd s10)
        fl (bit-and (i64-shift-right s9 5) 63)]
    (case (draw s1) (draw s2) (- (draw s3) (draw s9)) (draw s4) (draw s5) (draw s6) (bit-and (draw s7) 63) (bit-and (draw s8) 63)
          fl (bit-and (i64-shift-right s10 7) 1) (draw s10) (draw s11) which)))
(defn lcg-skip [seed :i64 n :i64] :i64 (if (= n 0) seed (lcg-skip (rnd (rnd (rnd seed))) (- n 1))))
(defn lcg [which :i64] :i64
  (loop [seed (lcg-skip 12345 (* slice 250000)) n 250000 acc 0]
    (if (= n 0) acc (recur (rnd (rnd (rnd seed))) (- n 1) (+ acc (lcg-one seed which))))))

(defn spec-ok? [] :bool
  (and (= (q6/solve-pick 64 (q6/pack 12800 5120) (q6/pack 0 0) 0) 5120)
       (= (q6/solve-pick 128 (q6/pack 12800 5120) (q6/pack 0 0) 0) 5120)
       ;; width 80 px, both margins auto in 200 px: 60 px each; odd remaining splits floor / ceil
       (= (q6/solve-pick (+ 192 12) (q6/pack 12800 5120) (q6/pack 0 0) 0) 3840)
       (= (q6/solve-pick (+ 256 12) (q6/pack 12801 5120) (q6/pack 0 0) 0) 3841)
       (= (q6/solve-pick (+ 192 12) (q6/pack 12801 5120) (q6/pack 0 0) 0) 3840)
       (= (q6/solve-pick 64 (q6/pack 12800 5120) (q6/pack 0 0) -1) (q6/invalid))
       (= (q6/solve-pick 64 (q6/pack 1073741825 0) (q6/pack 0 0) 0) (q6/invalid))
       (= (q6/solve-pick 64 (q6/pack 12800 5120) (q6/pack 1073741825 0) 0) (q6/invalid))
       (= (q6/hi (q6/pack -5 7)) -5) (= (q6/lo (q6/pack -5 7)) 7)
       (= (q6/hi (q6/pack 1073741825 -1073741825)) 1073741825) (= (q6/lo (q6/pack 1073741825 -1073741825)) -1073741825)))

(defn run [g :i64 which :i64] :i64 (cond (= g 1) (grid which) (= g 2) (grid-c which) :else (lcg which)))
(defn main [] :i64
  (cond
    (= mode 0) (if (spec-ok?) 42 7)
    (= (rem mode 10) 4) (if (and (spec-ok?) (= (run (quot mode 10) 3) 0)) 42 7)
    :else (run (quot mode 10) (rem mode 10))))
