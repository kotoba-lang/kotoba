(ns q6-inline-vs-f64
  (:require [cssom.inline :as f64in] [cssom.inline-q6 :as q6])
  (:export [main]))

;; Differential gate (host native macOS, JUN-920 slice 3, census group G09): the Q6 vertical-align shifts
;; (cssom.inline-q6) against the f64 reference cssom.inline (transcription of layout.cljk vertical-align-shift, the middle
;; box law and the inherited middle shift). The f64 side is exact for halves and inexact for the divisions by 3 and 5, so a
;; difference is allowed only where the exact value is a half raw unit (an exact tie).
;;
;; mode 0 : hand-derived spec points: 42 / 7.   mode 20 : zero violations in every grid: 42 / 7.
;; modes 1..4 : shift-keyword over fs raw 0..40000 (every value), kinds 1 and 2:  1 cases, 2 ties, 3 oracle differs at a tie,
;;              4 violations
;; modes 5..8 : middle-box, h and x in -2000..2000 step 7 (all pairs): 5 cases, 6 ties, 7 differs at a tie, 8 violations
;; modes 9..12: middle-inherited: x 0..400 step 3, lh 0..2000 step 11, ascent 0..30 step 5, descent 0..12 step 4:
;;              9 cases, 10 ties, 11 differs at a tie, 12 violations;  13: leading-ascent grid violations, 14 cases
(def mode 0)
(defn f [x :i64] :f64 (i64-to-f64-rounded x))
(defn px [x :i64] :i64 (* x 64))
(defn floor-i [x :f64] :i64 (let [t (f64-to-i64-truncating x)] (if (f64-lt x (f t)) (- t 1) t)))
(defn abs-i [x :i64] :i64 (if (< x 0) (- 0 x) x))
(defn rhu [o :f64] :i64 (floor-i (f64-add o 0.5)))
(defn dev-ok? [q :i64 o :f64] :bool (f64-lt (f64-abs (f64-sub (f q) o)) 0.500001))

;; shift-keyword: ties: super (fs + 192) mod 3 never gives .5 (divisor 3 odd -> rdiv(x,3) has no tie); sub divisor 5 odd -> no tie.
;; So for shift-keyword the oracle must equal round-half-up except by an ulp at an integer + 1/2, which cannot occur: ties = 0.
(defn sk-stat [which :i64] :i64
  (loop [kind 1 fs 0 acc 0]
    (cond (> kind 2) acc
          (> fs 40000) (recur (+ kind 1) 0 acc)
          :else
          (let [q (q6/shift-keyword kind fs) o (f64in/shift-keyword kind (f fs))
                eq (= q (rhu o)) dv (dev-ok? q o)]
            (recur kind (+ fs 1)
                   (+ acc (cond (= which 0) 1 (= which 1) 0 (= which 2) 0 :else (if (and eq dv) 0 1))))))))
(defn mb-stat [which :i64] :i64
  (loop [h -2000 x -2000 acc 0]
    (cond (> h 2000) acc
          (> x 2000) (recur (+ h 7) -2000 acc)
          :else
          (let [q (q6/middle-box h x) o (f64in/middle-box (f h) (f x))
                tie (= (rem (abs-i (+ h x)) 2) 1) diff (not= q (rhu o))]
            (recur h (+ x 7)
                   (+ acc (cond (= which 0) 1 (= which 1) (if tie 1 0) (= which 2) (if (and tie diff) 1 0) :else (if (and diff (not tie)) 1 0))))))))
(defn la-stat [which :i64] :i64
  (loop [a 0 d 0 lh -300 acc 0]
    (cond (> a 60) acc (> d 12) (recur (+ a 5) 0 -300 acc) (> lh 2000) (recur a (+ d 4) -300 acc)
          :else
          (let [q (q6/leading-ascent a d lh) o (f64in/leading-ascent (f a) (f d) (f lh))
                bad (if (or (f64-lt (f q) o) (f64-gt (f q) o)) 1 0)]
            (recur a d (+ lh 1) (+ acc (if (= which 0) 1 bad)))))))
(defn mi-stat [which :i64] :i64
  (loop [x 0 lh 0 a 0 d 0 acc 0]
    (cond (> x 400) acc (> lh 2000) (recur (+ x 3) 0 0 0 acc) (> a 30) (recur x (+ lh 11) 0 0 acc) (> d 12) (recur x lh (+ a 5) 0 acc)
          :else
          (let [q (q6/middle-inherited x lh a d) o (f64in/middle-inherited (f x) (f lh) (f a) (f d))
                tie (= (rem (abs-i (+ x lh)) 2) 1) diff (not= q (rhu o))]
            (recur x lh a (+ d 4)
                   (+ acc (cond (= which 0) 1 (= which 1) (if tie 1 0) (= which 2) (if (and tie diff) 1 0) :else (if (and diff (not tie)) 1 0))))))))
(defn spec? [] :bool
  (and
   (and (and (= (q6/shift-keyword 1 (px 15)) (px 6)) (= (q6/shift-keyword 2 (px 15)) (px -4)))
        (and (= (q6/shift-keyword 1 (px 16)) 405) (and (= (q6/shift-keyword 2 (px 16)) -269) (= (q6/shift-keyword 3 (px 16)) (q6/invalid)))))
   (and (and (= (q6/middle-box (px 20) 203) 742) (= (q6/middle-box (px 20) 202) 741))
        (and (= (q6/middle-box 1 0) 1) (= (q6/middle-box -1 0) 0)))
   (and (and (and (= (q6/leading-ascent 12 3 (px 20)) 14) (= (q6/leading-ascent 12 3 (px 15)) 12))
             (and (= (q6/leading-ascent 12 3 (px 16)) 12) (= (q6/leading-ascent 12 3 (px 14)) 11)))
        (and (and (= (q6/middle-inherited 200 (px 20) 12 3) (+ 100 (- 640 (px 14)))) (= (q6/middle-inherited 201 (px 20) 12 3) (+ 101 (- 640 (px 14)))))
             (= (q6/leading-ascent 65536 0 0) (q6/invalid))))))
(defn grids-ok? [] :bool
  (and (and (= (sk-stat 3) 0) (= (mb-stat 3) 0)) (and (= (mi-stat 3) 0) (= (la-stat 1) 0))))
(defn main [] :i64
  (cond (= mode 0) (if (spec?) 42 7)
        (= mode 20) (if (grids-ok?) 42 7)
        (= mode 1) (sk-stat 0) (= mode 2) (sk-stat 1) (= mode 3) (sk-stat 2) (= mode 4) (sk-stat 3)
        (= mode 5) (mb-stat 0) (= mode 6) (mb-stat 1) (= mode 7) (mb-stat 2) (= mode 8) (mb-stat 3)
        (= mode 9) (mi-stat 0) (= mode 10) (mi-stat 1) (= mode 11) (mi-stat 2) (= mode 12) (mi-stat 3)
        (= mode 13) (la-stat 1) (= mode 14) (la-stat 0)
        :else 0))
