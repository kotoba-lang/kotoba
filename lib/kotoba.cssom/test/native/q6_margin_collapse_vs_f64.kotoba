(ns q6-margin-collapse-vs-f64
  (:require [cssom.margin-collapse :as f64m] [cssom.margin-collapse-q6 :as q6])
  (:export [main]))

;; Differential gate (host native macOS, JUN-920 / C2b): Q6 margin collapsing (cssom.margin-collapse-q6, one i64 of
;; state) against the f64 module cssom.margin-collapse over EVERY sequence of 0..4 margins drawn from 14 values:
;; zero, +-1 raw, mixed signs (656, -544, 368, +-64), the range edges +-2^30, one past the edges (finite in f64, so the
;; oracle accepts them and Q6 must refuse), and +inf / NaN (both refuse). 41,371 sequences. The result must be EXACT
;; (no tolerance): collapsing only compares and adds integers.
;; mode 0 returns 42 when every sequence holds, 7 otherwise. Modes: 1 sequences, 2 both valid, 3 Q6 refuses a finite
;; oracle result (range guard), 4 both invalid, 5 violations.
(def mode 0)

(defn raw-at [i :i64] :i64
  (cond (= i 0) 0 (= i 1) 1 (= i 2) -1 (= i 3) 656 (= i 4) -544 (= i 5) 368 (= i 6) 64 (= i 7) -64
        (= i 8) 1073741824 (= i 9) -1073741824 (= i 10) 1073741825 (= i 11) -1073741825 :else 0))
(defn f64-at [i :i64] :f64
  (cond (= i 12) (f64-from-bits 9218868437227405312) (= i 13) (f64-from-bits 9221120237041090560)
        :else (f64-mul (i64-to-f64-rounded (raw-at i)) 0.015625)))
(defn in-dom? [i :i64] :bool (< i 10))
(defn q6-add [state :i64 i :i64] :i64 (q6/add state (if (>= i 12) (if (= i 12) 1073741825 -1073741825) (raw-at i))))
;; digit k of the base-14 sequence number n (a sequence of length len)
(defn digit [n :i64 k :i64] :i64 (if (= k 0) (rem n 14) (digit (quot n 14) (- k 1))))
(defn pow14 [k :i64] :i64 (if (= k 0) 1 (* 14 (pow14 (- k 1)))))
(defn f64-fold [len :i64 n :i64 k :i64 st [:ref :cssom.margin/state]] [:ref :cssom.margin/state]
  (if (= k len) st (f64-fold len n (+ k 1) (f64m/add st (f64-at (digit n k))))))
(defn q6-fold [len :i64 n :i64 k :i64 st :i64] :i64 (if (= k len) st (q6-fold len n (+ k 1) (q6-add st (digit n k)))))
(defn all-dom? [len :i64 n :i64 k :i64] :bool (if (= k len) true (and (in-dom? (digit n k)) (all-dom? len n (+ k 1)))))
(defn eq-exact? [q :i64 o :f64] :bool (f64-eq (f64-mul (i64-to-f64-rounded q) 0.015625) o))
;; outcome bits: 1 both valid and exact, 2 refusal of a finite oracle result, 4 both invalid, 8 violation
(defn outcome [len :i64 n :i64] :i64
  (let [ofin (f64m/finish (f64-fold len n 0 (f64m/empty-state)))
        ov (option-some?-of [:option :f64] ofin)
        qf (q6/finish (q6-fold len n 0 (q6/empty-state)))
        qv (not= qf (q6/invalid))
        dom (all-dom? len n 0)]
    (cond (and qv ov dom (eq-exact? qf (option-or ofin 0.0))) 1
          qv 8
          (and ov (not dom)) 2
          (and (not ov) (not dom)) 4
          :else 8)))
(defn sweep [len :i64 n :i64 which :i64 acc :i64] :i64
  (cond (= n (pow14 len)) acc
        :else (let [o (outcome len n)]
                (sweep len (+ n 1) which
                       (+ acc (cond (= which 1) 1 (= which 2) (bit-and o 1) (= which 3) (bit-and (i64-shift-right o 1) 1)
                                    (= which 4) (bit-and (i64-shift-right o 2) 1) :else (bit-and (i64-shift-right o 3) 1)))))))
(defn all-len [which :i64] :i64
  (+ (+ (+ (sweep 0 0 which 0) (sweep 1 0 which 0)) (+ (sweep 2 0 which 0) (sweep 3 0 which 0))) (sweep 4 0 which 0)))
(defn spec-ok? [] :bool
  (and (= (q6/finish (q6/empty-state)) 0)
       (= (q6/finish (q6/add (q6/add (q6/add (q6/empty-state) 656) -544) 368)) 112)   ; 10.25 - 8.5 collapsed with 5.75 = 1.75 px
       (= (q6/finish (q6/add (q6/add (q6/add (q6/empty-state) 368) -544) 656)) 112)
       (= (q6/finish (q6/add (q6/add (q6/empty-state) 288) 784)) 784)
       (= (q6/finish (q6/add (q6/add (q6/empty-state) -288) -784)) -784)
       (= (q6/finish (q6/add (q6/empty-state) 1073741825)) (q6/invalid))
       (= (q6/finish (q6/add (q6/add (q6/empty-state) 1073741825) 5)) (q6/invalid))
       (= (q6/finish (q6/add (q6/empty-state) -1073741825)) (q6/invalid))
       (= (q6/finish (q6/add (q6/empty-state) 1073741824)) 1073741824)
       (= (q6/finish (q6/add (q6/add (q6/empty-state) 1073741824) -1073741824)) 0)
       (q6/valid? (q6/empty-state)) (not (q6/valid? (q6/add (q6/empty-state) 2000000000)))))
(defn main [] :i64
  (cond (= mode 0) (if (and (spec-ok?) (= (all-len 5) 0)) 42 7)
        :else (all-len mode)))
