(ns q6-multicol-vs-f64
  (:require [cssom.multicol :as f64mc] [cssom.multicol-q6 :as q6])
  (:export [main]))

;; Differential gate (host native macOS, JUN-920 slice 3, census group G07 multicol part): the Q6 multi-column geometry
;; (cssom.multicol-q6) against the f64 reference cssom.multicol (transcription of layout.cljk multicol-spec, lay-w, dx and the
;; rule x). Whole-pixel results are compared as Q6 raws (multiples of 64); the f64 side multiplies a fractional width by k,
;; so it can miss an exact .5 (or exact-integer) by an ulp: those pairs are counted as ties, anything else is a violation.
;;
;; mode 0 : hand-derived spec points (the 3-column 300px box with a 10px gap of the layout.cljk comment: 93.33px columns, the
;;          third starting at 206.67 -> 207, and the count rules) and refusals: 42 / 7.   mode 20 : zero violations: 42 / 7.
;; modes 1..4 : ncols grid: 1 cases, 2 violations;  col-raw grid: 3 cases, 4 violations (|q - o| <= 1/2 raw + eps)
;; modes 5..9 : lay-w: 5 cases, 6 violations, 7 ties;  dense dx: 8 cases, 9 violations
;; modes 10..13 : dx ties: 10 exact ties, 11 oracle differs at an exact tie, 12 rule-x cases, 13 rule-x violations;  14 rule-x ties differing
(def mode 0)

(defn px [x :i64] :i64 (* x 64))
(defn f [x :i64] :f64 (i64-to-f64-rounded x))
(defn fne [a :f64 b :f64] :bool (or (f64-lt a b) (f64-gt a b)))
(defn abs-i [x :i64] :i64 (if (< x 0) (- 0 x) x))
(defn cw-at [i :i64] :i64
  (cond (= i 0) 0 (= i 1) 1 (= i 2) 64 (= i 3) 6400 (= i 4) 19200 (= i 5) 19201 (= i 6) 19199 (= i 7) 64000 (= i 8) 100000
        (= i 9) 16777216 (= i 10) 16777217 (= i 11) 12345 (= i 12) 3 :else 5000))
(defn gap-at [i :i64] :i64
  (cond (= i 0) 0 (= i 1) 1 (= i 2) 64 (= i 3) 640 (= i 4) 6400 (= i 5) 16777216 (= i 6) 16777217 (= i 7) 100 :else 33))
(defn wd-at [i :i64] :i64
  (cond (= i 0) -1 (= i 1) 0 (= i 2) 64 (= i 3) 640 (= i 4) 3200 (= i 5) 6400 (= i 6) 19200 (= i 7) 20000 (= i 8) 100 (= i 9) 16777216
        (= i 10) 16777217 (= i 11) -2 :else 7000))
;; ---- ncols ----
(defn nc-stat [which :i64] :i64
  (loop [a 0 b 0 d 0 w 0 acc 0]
    (cond (= a 14) acc (= b 9) (recur (+ a 1) 0 0 0 acc) (= d 7) (recur a (+ b 1) 0 0 acc) (= w 13) (recur a b (+ d 1) 0 acc)
          :else
          (let [cw (cw-at a) gap (gap-at b) wd (wd-at w) dom (and (and (<= cw 16777216) (<= gap 16777216)) (and (>= wd -1) (<= wd 16777216)))
                q (q6/ncols cw gap d wd)
                o (f64mc/ncols (f cw) (f gap) d (f wd))
                bad (if dom (if (> o 255) (if (= q (q6/invalid)) 0 1) (if (= q o) 0 1)) (if (= q (q6/invalid)) 0 1))]
            (recur a b d (+ w 1) (+ acc (if (= which 1) 1 bad)))))))
;; ---- col-raw (rounded fractional width) ----
(defn cr-stat [which :i64] :i64
  (loop [a 0 b 0 n 1 acc 0]
    (cond (= a 14) acc (= b 9) (recur (+ a 1) 0 1 acc) (= n 12) (recur a (+ b 1) 1 acc)
          :else
          (let [cw (cw-at a) gap (gap-at b) dom (and (<= cw 16777216) (<= gap 16777216))
                q (q6/col-raw cw gap n) o (f64mc/col-w (f cw) (f gap) n)
                bad (if dom (if (f64-gt (f64-abs (f64-sub (f q) o)) 0.500001) 1 0) (if (= q (q6/invalid)) 0 1))]
            (recur a b (+ n 1) (+ acc (if (= which 3) 1 bad)))))))
;; ---- lay-w, dx, rule over a dense grid: cw raw 0..4095 (and the catalogue), gap in {0, 640, 33}, n in {2,3,5,6,7,12}, k < n ----
(defn nn-at [i :i64] :i64 (cond (= i 0) 2 (= i 1) 3 (= i 2) 5 (= i 3) 6 (= i 4) 7 :else 12))
(defn g2-at [i :i64] :i64 (cond (= i 0) 0 (= i 1) 640 :else 33))
(defn num-of [cw :i64 gap :i64 n :i64] :i64 (let [v (- cw (* (- n 1) gap))] (if (< v 0) 0 v)))
;; exact tie of dx: (k * M) mod (64 n) = 32 n, M = num + n * gap
(defn dx-tie? [cw :i64 gap :i64 n :i64 k :i64] :bool
  (= (rem (* k (+ (num-of cw gap n) (* n gap))) (* 64 n)) (* 32 n)))
(defn lay-boundary? [cw :i64 gap :i64 n :i64] :bool (= (rem (num-of cw gap n) (* 64 n)) 0))
;; which: 0 lay cases, 1 lay violations, 2 lay boundary differences, 3 dx cases, 4 dx violations, 5 dx ties, 6 dx tie differences
(defn dense-stat [which :i64] :i64
  (loop [cw 0 gi 0 ni 0 k 0 acc 0]
    (cond (= cw 4096) acc (= gi 3) (recur (+ cw 1) 0 0 0 acc) (= ni 6) (recur cw (+ gi 1) 0 0 acc)
          (= k (nn-at ni)) (recur cw gi (+ ni 1) 0 acc)
          :else
          (let [gap (g2-at gi) n (nn-at ni)
                ql (q6/lay-w cw gap n) ol (f64mc/lay-w (f cw) (f gap) n)
                qd (q6/dx cw gap n k) od (f64mc/dx (f cw) (f gap) n k)
                tie (dx-tie? cw gap n k)
                lay-diff (fne (f ql) ol)
                dx-diff (fne (f qd) od)]
            (recur cw gi ni (+ k 1)
                   (+ acc (cond (= which 0) (if (= k 0) 1 0)
                                (= which 1) (if (and lay-diff (not (lay-boundary? cw gap n))) 1 0)
                                (= which 2) (if (and lay-diff (lay-boundary? cw gap n)) 1 0)
                                (= which 3) 1
                                (= which 4) (if (and dx-diff (not tie)) 1 (if (and dx-diff (f64-gt (f64-abs (f64-sub (f qd) od)) 64.1)) 1 0))
                                (= which 5) (if tie 1 0)
                                :else (if (and tie dx-diff) 1 0))))))))
;; rule-x: cx in {-6400, 0, 33, 640, 12800}, rw in {0, 64, 100, 640}; n in {2,3,5,6}, k in 1..n-1, cw raw 0..2047, gap in {0, 640, 33}
(defn cx-at [i :i64] :i64 (cond (= i 0) -6400 (= i 1) 0 (= i 2) 33 (= i 3) 640 :else 12800))
(defn rw-at [i :i64] :i64 (cond (= i 0) 0 (= i 1) 64 (= i 2) 100 :else 640))
(defn rule-n [i :i64] :i64 (cond (= i 0) 2 (= i 1) 3 (= i 2) 5 :else 6))
(defn rule-numer [cw :i64 gap :i64 n :i64 k :i64 cx :i64 rw :i64] :i64
  (+ (+ (* (* 2 n) (- cx gap)) (* (* 2 k) (+ (num-of cw gap n) (* n gap)))) (* n (- gap rw))))
;; which: 0 cases, 1 violations (differs away from an exact tie), 2 exact ties, 3 oracle differs at a tie
(defn rule-stat [which :i64] :i64
  (loop [cw 0 gi 0 ni 0 k 1 ci 0 ri 0 acc 0]
    (cond (= cw 2048) acc (= gi 3) (recur (+ cw 1) 0 0 1 0 0 acc) (= ni 4) (recur cw (+ gi 1) 0 1 0 0 acc)
          (>= k (rule-n ni)) (recur cw gi (+ ni 1) 1 0 0 acc)
          (= ci 5) (recur cw gi ni (+ k 1) 0 0 acc) (= ri 4) (recur cw gi ni k (+ ci 1) 0 acc)
          :else
          (let [gap (g2-at gi) n (rule-n ni) cx (cx-at ci) rw (rw-at ri)
                q (q6/rule-x cw gap (+ n (* 256 k)) cx rw)
                o (f64mc/rule-x (f cw) (f gap) n k (f cx) (f rw))
                tie (= (rem (abs-i (rule-numer cw gap n k cx rw)) (* 128 n)) (* 64 n))
                diff (fne (f q) o)]
            (recur cw gi ni k ci (+ ri 1)
                   (+ acc (cond (= which 0) 1 (= which 1) (if (and diff (not tie)) 1 0) (= which 2) (if tie 1 0) :else (if (and tie diff) 1 0))))))))

(defn spec? [] :bool
  (and
   (and (and (= (q6/ncols (px 300) (px 10) 3 -1) 3) (= (q6/ncols (px 300) (px 10) 0 (px 100)) 2))
        (and (= (q6/ncols (px 300) 0 0 (px 100)) 3) (and (= (q6/ncols (px 300) 0 2 (px 100)) 2) (= (q6/ncols (px 300) 0 5 (px 100)) 3))))
   (and (and (and (= (q6/ncols (px 300) 0 0 -1) 1) (= (q6/ncols (px 50) 0 0 (px 100)) 1))
             (and (= (q6/ncols (px 300) 0 0 0) 1) (= (q6/ncols (px 300) 0 4 -1) 4)))
        (and (and (= (q6/col-raw (px 300) (px 10) 3) 5973) (= (q6/lay-w (px 300) (px 10) 3) (px 93)))
             (and (and (= (q6/dx (px 300) (px 10) 3 2) (px 207)) (= (q6/dx (px 300) (px 10) 3 1) (px 103)))
                  (and (= (q6/rule-x (px 300) (px 10) (+ 3 256) 0 (px 2)) (px 97))
                       (and (= (q6/lay-w (px 5) (px 10) 3) 0) (= (q6/ncols (px 300) (px 10) 3 (px 1000000)) (q6/invalid)))))))
   (and (and (= (q6/col-raw 16777217 0 2) (q6/invalid)) (= (q6/dx 6400 0 3 3) (q6/invalid)))
        (and (= (q6/ncols 0 0 256 -1) (q6/invalid)) (= (q6/rule-x 6400 0 (+ 3 0) 0 0) (q6/invalid))))))
(defn grids-ok? [] :bool
  (and (and (= (nc-stat 2) 0) (= (cr-stat 4) 0))
       (and (and (= (dense-stat 1) 0) (= (dense-stat 4) 0)) (= (rule-stat 1) 0))))
(defn main [] :i64
  (cond (= mode 0) (if (spec?) 42 7)
        (= mode 20) (if (grids-ok?) 42 7)
        (= mode 1) (nc-stat 1) (= mode 2) (nc-stat 2) (= mode 3) (cr-stat 3) (= mode 4) (cr-stat 4)
        (= mode 5) (dense-stat 0) (= mode 6) (dense-stat 1) (= mode 7) (dense-stat 2) (= mode 8) (dense-stat 3) (= mode 9) (dense-stat 4)
        (= mode 10) (dense-stat 5) (= mode 11) (dense-stat 6)
        (= mode 12) (rule-stat 0) (= mode 13) (rule-stat 1) (= mode 14) (rule-stat 3) (= mode 15) (rule-stat 2)
        :else 0))
