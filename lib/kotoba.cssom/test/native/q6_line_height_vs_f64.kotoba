(ns q6-line-height-vs-f64
  (:require [cssom.line-height :as f64lh] [cssom.line-height-q6 :as q6])
  (:export [main]))

;; Differential gate (host native macOS, JUN-920 slice 2, census group G06): the Q6 / D4 line-height and font-metric
;; arithmetic (cssom.line-height-q6) against the f64 reference cssom.line-height (transcription of layout.cljk
;; resolve-line-height, leading-ascent, symbol-marker-advance, select-option-height, tab-runs, and the `(long (* 0.6 fs))` family).
;;
;; Where layout.cljk applies `(long (* m fs))` the oracle is a double product and the Q6 side is exact: they can differ only
;; when the EXACT product is a whole number of pixels and the double misses it by an ulp (for example 0.29 * 100 = 28.999999999999996).
;; Those cases are counted as "boundary" (a tie of the truncation rule); a difference away from a boundary, or by more than one
;; pixel, is a violation.
;;
;; mode 0   : hand-derived spec points: 42 / 7.     mode 20 : every grid has zero violations: 42 / 7.
;; modes 1..4  dense sweep A, 2-decimal multipliers 0.00..5.00 x font size 1..256 px (128,256 pairs, the census sweep):
;;             1 pairs, 2 boundary pairs, 3 oracle differs at a boundary, 4 oracle differs away from a boundary
;; modes 5..8  dense sweep B, D4 multipliers 0..65535 step 7 x font size raw 0..4096 (same four counters)
;; modes 9..13 resolve-line-height grid: 9 cases, 10 equal, 11 boundary differences, 12 justified refusals, 13 violations
;; modes 14..17 violations of leading-ascent, marker-advance, option-height, tab-stop;  18 iterations of those four grids.
(def mode 0)

(defn mult-at [i :i64] :i64
  (cond (= i 0) 0 (= i 1) 1 (= i 2) 2000 (= i 3) 2900 (= i 4) 1000 (= i 5) 6000 (= i 6) 10000 (= i 7) 12000
        (= i 8) 15000 (= i 9) 20000 (= i 10) 25000 (= i 11) 50000 (= i 12) 65535 (= i 13) -10000 (= i 14) -15000
        (= i 15) 65536 (= i 16) 3333 (= i 17) 9999 (= i 18) 11000 :else 14286))
(defn px-at [i :i64] :i64
  (cond (= i 0) 0 (= i 1) 1280 (= i 2) 1344 (= i 3) -64 (= i 4) 63 (= i 5) 65 (= i 6) 1073741824 (= i 7) 1073741825
        (= i 8) 5000 (= i 9) -5000 (= i 10) 6400 (= i 11) 12 (= i 12) 1536 (= i 13) -1 (= i 14) 3200 (= i 15) 960
        (= i 16) 64 (= i 17) 128 (= i 18) 32 :else 31))
(defn fs-at [i :i64] :i64
  (cond (= i 0) 0 (= i 1) 1 (= i 2) 32 (= i 3) 64 (= i 4) 853 (= i 5) 896 (= i 6) 1000 (= i 7) 1792 (= i 8) 6400
        (= i 9) 16384 (= i 10) 262144 (= i 11) 1073741824 (= i 12) 1073741825 (= i 13) -64 (= i 14) 320 :else 160))
(defn theme-at [i :i64] :i64
  (cond (= i 0) 0 (= i 1) 20 (= i 2) 33 (= i 3) 100 (= i 4) -5 (= i 5) 1073741824 :else 1073741825))
(defn abs-i [x :i64] :i64 (if (< x 0) (- 0 x) x))
(defn f64-of [raw :i64] :f64 (f64-mul (i64-to-f64-rounded raw) 0.015625))
(defn mult-f [m :i64] :f64 (f64-div (i64-to-f64-rounded m) 10000.0))
(defn boundary? [m :i64 fs :i64] :bool (= (rem (abs-i (* m fs)) 640000) 0))

;; ---- dense sweeps A and B ----
;; which: 0 pairs, 1 boundary, 2 oracle != Q6 at a boundary, 3 oracle != Q6 away from a boundary
(defn dense-one [m :i64 fs :i64 which :i64] :i64
  (let [o (f64lh/scaled-px (mult-f m) (f64-of fs)) q (q6/mul-trunc m fs) b (boundary? m fs)]
    (cond (= which 0) 1
          (= which 1) (if b 1 0)
          (= which 2) (if (and b (not= o q)) 1 0)
          :else (if (and (not b) (not= o q)) 1 0))))
(defn dense-a [which :i64] :i64
  (loop [m 0 f 1 acc 0]
    (cond (> m 50000) acc
          (> f 256) (recur (+ m 100) 1 acc)
          :else (recur m (+ f 1) (+ acc (dense-one m (* f 64) which))))))
(defn dense-b [which :i64] :i64
  (loop [m 0 f 0 acc 0]
    (cond (> m 65535) acc
          (> f 4096) (recur (+ m 7) 0 acc)
          :else (recur m (+ f 1) (+ acc (dense-one m f which))))))

;; ---- resolve-line-height grid ----
(defn dom? [kind :i64 value :i64 fs :i64 theme :i64] :bool
  (and (<= (abs-i fs) 1073741824)
       (and (<= (abs-i theme) 1073741824)
            (cond (= kind 1) (<= (abs-i value) 1073741824) (= kind 2) (<= (abs-i value) 65535) :else true))))
;; class: 0 equal, 1 boundary difference (|diff| = 1), 2 justified refusal, 3 violation
(defn res-class [c :i64] :i64
  (let [kind (rem c 3) flags (rem (quot c 3) 4) vi (rem (quot c 12) 20) fi (rem (quot c 240) 15) ti (quot c 3600)
        value (if (= kind 2) (mult-at vi) (px-at vi)) fs (fs-at fi) theme (theme-at ti)
        p0 (+ kind (* 4 flags))
        q (q6/resolve p0 value fs theme)
        d (dom? kind value fs theme)
        o (f64lh/resolve kind (if (= kind 2) (mult-f value) (f64-of value)) (f64-of fs) theme flags)
        nat-b (boundary? 12000 fs)
        b (if (= kind 2) (boundary? value fs) (and (= kind 0) nat-b))]
    (cond (not d) (if (= q (q6/invalid)) 2 3)
          (= q (q6/invalid)) 3
          (= q o) 0
          (and b (<= (abs-i (- q o)) 1)) 1
          :else 3)))
(defn res-count [lo :i64 hi :i64] :i64
  (loop [c 0 acc 0]
    (if (>= c 25200) acc
      (recur (+ c 1) (+ acc (let [k (res-class c)] (if (and (>= k lo) (<= k hi)) 1 0)))))))

;; ---- small exhaustive grids ----
(defn la-viol [] :i64
  (loop [a 0 d 0 l -10 acc 0]
    (cond (> a 40) acc
          (> d 20) (recur (+ a 1) 0 -10 acc)
          (> l 70) (recur a (+ d 1) -10 acc)
          :else (recur a d (+ l 1)
                       (+ acc (if (= (q6/leading-ascent a d l)
                                     (f64lh/leading-ascent (i64-to-f64-rounded a) (i64-to-f64-rounded d) (i64-to-f64-rounded l))) 0 1))))))
(defn ma-viol [] :i64
  (loop [k 0 acc 0]
    (if (> k 8192) acc
      (recur (+ k 1) (+ acc (if (= (q6/marker-advance k)
                                   (f64-to-i64-truncating (f64-mul (f64lh/marker-advance (f64-of k)) 64.0))) 0 1))))))
(defn oh-viol [] :i64
  (loop [k 0 acc 0]
    (if (> k 8192) acc
      (recur (+ k 1)
             (+ acc (let [q (q6/option-height k) o (f64lh/option-height (f64-of k))]
                      (if (f64-gt (f64-abs (f64-sub (f64-mul (i64-to-f64-rounded q) 2.0) (f64-mul o 128.0))) 1.00001) 1 0)))))))
(defn ts-viol [] :i64
  (loop [p -4096 w 1 acc 0]
    (cond (> p 8192) acc
          (> w 600) (recur (+ p 7) 1 acc)
          :else (recur p (+ w 1)
                       (+ acc (if (= (q6/tab-stop p w)
                                     (f64-to-i64-truncating (f64-mul (f64lh/tab-stop (f64-of p) (f64-of w)) 64.0))) 0 1))))))
(defn count-loop [lo :i64 hi :i64 step :i64] :i64
  (loop [k lo n 0] (if (> k hi) n (recur (+ k step) (+ n 1)))))
;; iterations of the four small grids: leading-ascent + marker-advance + option-height + tab-stop
(defn small-cases [] :i64
  (+ (+ (* (count-loop 0 40 1) (* (count-loop 0 20 1) (count-loop -10 70 1))) (* 2 (count-loop 0 8192 1)))
     (* (count-loop -4096 8192 7) (count-loop 1 600 1))))
(defn grids-ok? [] :bool
  (and (= (res-count 3 3) 0) (and (= (la-viol) 0) (and (= (ma-viol) 0) (and (= (oh-viol) 0) (and (= (ts-viol) 0)
       (and (= (dense-a 3) 0) (= (dense-b 3) 0))))))))

;; ---- spec points (hand-derived from the comments of layout.cljk) ----
(defn spec-ok? [] :bool
  (and
   ;; (long (* 1.2 28)) = 33 (an <h1> at 28px), (long (* 1.2 14)) = 16, 0.6 * 14 = 8, 0.2 * 14 = 2, 0.6 * 13.3333 = 7
   (= (q6/mul-trunc 12000 1792) 33) (= (q6/mul-trunc 12000 896) 16) (= (q6/mul-trunc 6000 896) 8) (= (q6/mul-trunc 2000 896) 2)
   (= (q6/mul-trunc 6000 853) 7)
   ;; resolve-line-height: `normal` takes max(theme, 1.2 fs) = 33 for the 28px heading; an INHERITED explicit 20 wins: 20
   (= (q6/resolve 4 0 1792 20) 33) (= (q6/resolve 12 0 1792 20) 20)
   ;; no theme default: normal = (long (* 1.2 fs)) either way
   (= (q6/resolve 0 0 896 0) 16) (= (q6/resolve 8 0 896 0) 16)
   ;; a number: `line-height: 24px` -> 24 ; fractional 24.5px -> 24 (long truncates)
   (= (q6/resolve 1 1536 896 20) 24) (= (q6/resolve 1 1568 896 20) 24) (= (q6/resolve 1 -96 896 20) -1)
   ;; multipliers: unitless 1.5 at 14px = 21, at 24px = 36 ; `150%` is the same D4 integer 15000
   (= (q6/resolve 2 15000 896 20) 21) (= (q6/resolve 2 15000 1536 20) 36)
   ;; a multiplier that is a whole number of pixels is exact: 0.29 * 100 = 29, 0.1 * 10 = 1 (a Q10 factor gives 0)
   (= (q6/mul-trunc 2900 6400) 29) (= (q6/mul-trunc 1000 640) 1)
   ;; ...where the f64 oracle gives 28 (28.999999999999996): the recorded oracle disagreement at a truncation boundary
   (= (f64lh/scaled-px (mult-f 2900) 100.0) 28)
   ;; refusals: multiplier or font size beyond the guards, bad packing
   (= (q6/mul-trunc 65536 64) (q6/invalid)) (= (q6/mul-trunc 1 1073741825) (q6/invalid)) (= (q6/resolve 16 0 64 0) (q6/invalid))
   (= (q6/resolve 2 65536 64 0) (q6/invalid))
   ;; leading-ascent reference points measured in Brave at line-height: 20px: 12+3 -> 14, 14+4 -> 15, 21+5 -> 18, 9+2 -> 13
   (= (q6/leading-ascent 12 3 20) 14) (= (q6/leading-ascent 14 4 20) 15) (= (q6/leading-ascent 21 5 20) 18) (= (q6/leading-ascent 9 2 20) 13)
   ;; negative leading is floored: ascent 20, descent 5, line-height 10: 20 + floor(-7.5) = 12
   (= (q6/leading-ascent 20 5 10) 12)
   ;; marker advance at 14px: 14 + ceil(32 / 7) = 19 px
   (= (q6/marker-advance 896) 1216) (= (q6/marker-advance (- 0 64)) (q6/invalid))
   ;; select option height at 14px: 1.2 * 14 + 1 = 17.8 px = 1139.2 raw -> 1139
   (= (q6/option-height 896) 1139)
   ;; tab stops of 56 px (measured): pen 7 -> 56, pen exactly on a stop moves a whole stop: 56 -> 112, 112 -> 168 ; 0 -> 56
   (= (q6/tab-stop 448 3584) 3584) (= (q6/tab-stop 3584 3584) 7168) (= (q6/tab-stop 7168 3584) 10752) (= (q6/tab-stop 0 3584) 3584)
   (= (q6/tab-stop 64 0) (q6/invalid))
   ;; the reference itself on the same points (reads as doubles)
   (= (f64lh/resolve 0 0.0 28.0 20 1) 33) (= (f64lh/resolve 0 0.0 28.0 20 3) 20) (= (f64lh/resolve 2 1.5 14.0 20 0) 21)
   (= (f64lh/leading-ascent 12.0 3.0 20.0) 14) (= (f64lh/leading-ascent 21.0 5.0 20.0) 18) (= (f64lh/leading-ascent 20.0 5.0 10.0) 12)
   (= (f64-to-i64-truncating (f64lh/marker-advance 14.0)) 19)))

(defn main [] :i64
  (cond
    (= mode 1) (dense-a 0) (= mode 2) (dense-a 1) (= mode 3) (dense-a 2) (= mode 4) (dense-a 3)
    (= mode 5) (dense-b 0) (= mode 6) (dense-b 1) (= mode 7) (dense-b 2) (= mode 8) (dense-b 3)
    (= mode 9) 25200 (= mode 10) (res-count 0 0) (= mode 11) (res-count 1 1) (= mode 12) (res-count 2 2) (= mode 13) (res-count 3 3)
    (= mode 14) (la-viol) (= mode 15) (ma-viol) (= mode 16) (oh-viol) (= mode 17) (ts-viol)
    (= mode 18) (small-cases)
    (= mode 20) (if (grids-ok?) 42 7)
    :else (if (spec-ok?) 42 7)))
