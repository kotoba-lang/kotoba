(ns q6-style-num-vs-f64
  (:require [cssom.style-num :as f64sn] [cssom.style-num-q6 :as q6] [cssom.parse-d4-q6 :as pq])
  (:export [main]))

;; Differential gate (host native macOS, JUN-920 slice 3, census group G11): the D4 style numbers (cssom.style-num-q6) against
;; the f64 reference cssom.style-num (opacity clamp, cumulative opacity product, `(< opacity 1.0)`, flex factors).
;;
;; mode 0 : hand-derived spec points: 42 / 7.   mode 20 : zero violations in every grid: 42 / 7.
;; modes 1..4 + 10 * s (s = 1..4, a in 2501-wide slices of 0..10000, b in 0..10000): the cumulative product a * b / 10000 over
;;            ALL pairs:  1 pairs, 2 exact ties (a b mod 10000 = 5000), 3 oracle differs at a tie, 4 oracle differs away from a tie
;; modes 5 6 : stacking? over -10..10100: 5 cases, 6 disagreements;  7 8: clamp over -20000..30000: 7 cases, 8 disagreements
;; modes 9..11: parse-opacity / parse-d4 string table: 9 cases, 10 violations, 11 below-one adjustments (9999 for a value < 1)
(def mode 0)

(defn f [x :i64] :f64 (i64-to-f64-rounded x))
(defn d4 [x :i64] :f64 (f64-div (f x) 10000.0))
(defn floor-i [x :f64] :i64 (let [t (f64-to-i64-truncating x)] (if (f64-lt x (f t)) (- t 1) t)))
(defn round-d4 [x :f64] :i64 (floor-i (f64-add (f64-mul x 10000.0) 0.5)))
(defn abs-i [x :i64] :i64 (if (< x 0) (- 0 x) x))

;; ---- cumulative product ----
;; which: 0 pairs, 1 ties, 2 differs at a tie, 3 differs away from a tie.  Slice s: a in [2501 (s-1), 2501 s - 1] clipped to 10000.
(defn mul-stat [slice :i64 which :i64] :i64
  (let [lo (* 2501 (- slice 1)) hi (if (= slice 4) 10000 (- (* 2501 slice) 1))]
    (loop [a lo b 0 acc 0]
      (cond (> a hi) acc
            (> b 10000) (recur (+ a 1) 0 acc)
            :else
            (let [q (q6/opacity-mul a b) o (round-d4 (f64sn/mul (d4 a) (d4 b)))
                  tie (= (rem (* a b) 10000) 5000) diff (not= q o)]
              (recur a (+ b 1)
                     (+ acc (cond (= which 0) 1 (= which 1) (if tie 1 0) (= which 2) (if (and tie diff) 1 0) :else (if (and diff (not tie)) 1 0)))))))))
(defn stack-stat [which :i64] :i64
  (loop [x -10 acc 0]
    (if (> x 10100) acc
      (recur (+ x 1) (+ acc (if (= which 0) 1 (if (= (q6/stacking? x) (f64sn/stacking? (d4 x))) 0 1)))))))
(defn clamp-stat [which :i64] :i64
  (loop [x -20000 acc 0]
    (if (> x 30000) acc
      (recur (+ x 1) (+ acc (if (= which 0) 1 (if (= (q6/opacity-clamp x) (round-d4 (f64sn/clamp01 (d4 x)))) 0 1)))))))

;; ---- strings: text, mantissa, fraction digits ----
(defn str-at [i :i64] :string
  (cond (= i 0) "0" (= i 1) "1" (= i 2) "0.5" (= i 3) ".5" (= i 4) "+0.25" (= i 5) "0.9999" (= i 6) "0.99995" (= i 7) "0.999999"
        (= i 8) "1.000001" (= i 9) "1.5" (= i 10) "2" (= i 11) "0.00004" (= i 12) "0.00005" (= i 13) "0.12345678" (= i 14) "0.3"
        (= i 15) "0.07" (= i 16) "0.1" (= i 17) "0.0001" (= i 18) "00.50" (= i 19) "1." (= i 20) "0.1234" (= i 21) "0.29" :else "0.6"))
(defn mant-at [i :i64] :i64
  (cond (= i 0) 0 (= i 1) 1 (= i 2) 5 (= i 3) 5 (= i 4) 25 (= i 5) 9999 (= i 6) 99995 (= i 7) 999999 (= i 8) 1000001 (= i 9) 15 (= i 10) 2
        (= i 11) 4 (= i 12) 5 (= i 13) 12345678 (= i 14) 3 (= i 15) 7 (= i 16) 1 (= i 17) 1 (= i 18) 50 (= i 19) 1 (= i 20) 1234 (= i 21) 29 :else 6))
(defn dig-at [i :i64] :i64
  (cond (= i 0) 0 (= i 1) 0 (= i 2) 1 (= i 3) 1 (= i 4) 2 (= i 5) 4 (= i 6) 5 (= i 7) 6 (= i 8) 6 (= i 9) 1 (= i 10) 0 (= i 11) 5 (= i 12) 5
        (= i 13) 8 (= i 14) 1 (= i 15) 2 (= i 16) 1 (= i 17) 4 (= i 18) 2 (= i 19) 0 (= i 20) 4 (= i 21) 2 :else 1))
;; the text is truncated to 6 fraction digits by the Q6 scanner (0.12345678 -> 0.123456), so the f64 side is given the same
;; decimal: mantissa 12345678 / 8 digits is replaced by 123456 / 6 for index 13
(defn mant6 [i :i64] :i64 (if (= i 13) 123456 (mant-at i)))
(defn dig6 [i :i64] :i64 (if (= i 13) 6 (dig-at i)))
;; which: 0 cases, 1 violations, 2 below-one adjustments, 3 parse-d4 violations
(defn str-stat [which :i64] :i64
  (loop [i 0 acc 0]
    (if (= i 23) acc
      (let [s (str-at i) o (f64sn/parse-d4 (mant6 i) (dig6 i))
            want (round-d4 (f64sn/clamp01 o))
            q (pq/parse-opacity s) adj (and (= want 10000) (< (round-d4 o) 10001) (f64-lt o 1.0))
            qd (pq/parse-d4 s) wd (round-d4 o)
            bad (if (= q (q6/invalid)) 1 (if adj (if (= q 9999) 0 1) (if (= q want) 0 1)))
            badd (if (= qd (q6/invalid)) 1 (if (= qd wd) 0 1))]
        (recur (+ i 1) (+ acc (cond (= which 0) 1 (= which 1) bad (= which 2) (if adj 1 0) :else badd)))))))

(defn spec? [] :bool
  (and
   (and (and (= (q6/opacity-clamp -5) 0) (= (q6/opacity-clamp 10001) 10000))
        (and (= (q6/opacity-clamp 5000) 5000) (= (q6/opacity-clamp 1073741825) (q6/invalid))))
   (and (and (and (= (q6/opacity-mul 10000 10000) 10000) (= (q6/opacity-mul 5000 5000) 2500))
             (and (= (q6/opacity-mul 1 5000) 1) (and (= (q6/opacity-mul 1 4999) 0) (= (q6/opacity-mul 10001 1) (q6/invalid)))))
        (and (and (q6/stacking? 9999) (not (q6/stacking? 10000)))
             (and (and (= (q6/factor -3) 0) (= (q6/factor 0) 0)) (and (= (q6/factor 65535) 65535) (= (q6/factor 65536) (q6/invalid))))))
   (and (and (and (= (pq/parse-opacity "0.5") 5000) (= (pq/parse-opacity "1") 10000))
             (and (= (pq/parse-opacity "1.5") 10000) (= (pq/parse-opacity "-1") 0)))
        (and (and (and (= (pq/parse-opacity "0.999999") 9999) (q6/stacking? (pq/parse-opacity "0.999999")))
                  (and (= (pq/parse-opacity "1.000001") 10000) (not (q6/stacking? (pq/parse-opacity "1.000001")))))
             (and (and (= (pq/parse-opacity "0.00004") 0) (= (pq/parse-opacity "0.00005") 1))
                  (and (and (= (pq/parse-opacity "abc") (q6/invalid)) (= (pq/parse-opacity "1e2") (q6/invalid)))
                       (and (and (= (pq/parse-opacity "") (q6/invalid)) (= (pq/parse-opacity ".") (q6/invalid)))
                            (and (= (pq/parse-d4 "2.5") 25000) (and (= (pq/parse-d4 "-0.1") -1000) (= (pq/parse-d4 "15") 150000))))))))))
(defn grids-ok? [] :bool
  (and (and (= (stack-stat 1) 0) (= (clamp-stat 1) 0))
       (and (and (= (str-stat 1) 0) (= (str-stat 3) 0))
            (and (and (= (mul-stat 1 3) 0) (= (mul-stat 2 3) 0)) (and (= (mul-stat 3 3) 0) (= (mul-stat 4 3) 0))))))
(defn main [] :i64
  (let [s (quot mode 10) w (rem mode 10)]
    (cond (= mode 0) (if (spec?) 42 7)
          (= mode 20) (if (grids-ok?) 42 7)
          (and (>= s 1) (and (<= s 4) (and (>= w 1) (<= w 4)))) (mul-stat s (- w 1))
          (= mode 5) (stack-stat 0) (= mode 6) (stack-stat 1) (= mode 7) (clamp-stat 0) (= mode 8) (clamp-stat 1)
          (= mode 9) (str-stat 0) (= mode 100) (str-stat 1) (= mode 101) (str-stat 2) (= mode 102) (str-stat 3)
          :else 0)))
