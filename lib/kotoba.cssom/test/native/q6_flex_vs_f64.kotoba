(ns q6-flex-vs-f64
  (:require [cssom.flex :as f64flex] [cssom.flex-q6 :as q6])
  (:export [main]))

;; Differential gate (host native macOS, JUN-920 slice 3, census group G07 flex part): the Q6 / D4 flex solver and
;; main-axis placement (cssom.flex-q6) against the f64 reference cssom.flex (literal transcription of layout.cljk
;; resolve-flexible-lengths, place-main-axis, place-main-axis-auto-margins).
;;
;; mode 0   : hand-derived spec points (the measured tables of the resolve-flexible-lengths docstring, derived by hand) and
;;            refusals: 42 / 7.            mode 20 : every grid has zero violations: 42 / 7.
;; modes 1..3 + 10 * s (s = slice 1..8, 125,000 pseudo-random lines each): 1 = eq | tie << 21 | cascade << 42,
;;            2 = violations | maxDeviation1000 << 21 | comparisons whose result sits on a min or max bound << 42, 3 = comparisons
;; mode 4 + 10 * s: the slice verdict, 42 / 7
;; modes 100..103 share() against the exact integer formula: 100 cases, 101 violations, 102 ties (2 r w = W mod 2W), 103 one-off
;; modes 110..113 offset() against place-main-axis: 110 comparisons | tie << 32, 111 violations, 112 max deviation1000, 113 refusals
;; modes 120..122 auto-offset() against place-main-axis-auto-margins: 120 comparisons, 121 violations, 122 ties
;; Classification of one Q6 result q against the f64 value o (both in Q6 raw units): eq = q is round-half-up(o);
;; tie = o is within 1e-6 of a half and q is the other neighbour; anything else is a violation. (An earlier draft also allowed a
;; "cascade" class, |q - o| <= 1 in a line with a clamp, for a rounded proposal that lands on a bound; the freeze test on the
;; EXACT proposal removed the need, the field stays in the packed counter and is pinned at zero.)
(def mode 0)

(defn px [x :i64] :i64 (* x 64))
(defn fdiv [a :i64 b :i64] :i64 (let [q (quot a b)] (if (and (< a 0) (not= (* q b) a)) (- q 1) q)))
(defn abs-i [x :i64] :i64 (if (< x 0) (- 0 x) x))
(defn floor-f [x :f64] :i64 (let [t (f64-to-i64-truncating x)] (if (f64-lt x (i64-to-f64-rounded t)) (- t 1) t)))
(defn f [x :i64] :f64 (i64-to-f64-rounded x))
(defn d4 [x :i64] :f64 (f64-div (i64-to-f64-rounded x) 10000.0))
(defn rnd [c :i64 j :i64] :i64
  (let [x1 (bit-and (+ (* (+ c 12345) 1103515245) 12345) 2147483647)
        x2 (bit-and (+ (* (+ x1 (* j 977)) 1103515245) 12345) 2147483647)
        x3 (bit-and (+ (* (+ x2 (* c 31)) 1103515245) 12345) 2147483647)]
    (i64-shift-right x3 6)))

;; ---------------- class of one comparison ----------------
;; 0 eq, 1 tie, 2 cascade, 3 violation
(defn classify [q :i64 o :f64 clamps :bool] :i64
  (let [r (floor-f (f64-add o 0.5))
        fl (i64-to-f64-rounded (floor-f o))
        t (f64-sub o fl)
        d (f64-abs (f64-sub (i64-to-f64-rounded q) o))]
    (cond (= q r) 0
          (and (f64-lt (f64-abs (f64-sub t 0.5)) 0.000001) (f64-lt d 0.500001)) 1
          :else 3)))
(defn dev1000 [q :i64 o :f64] :i64 (f64-to-i64-truncating (f64-mul (f64-abs (f64-sub (i64-to-f64-rounded q) o)) 1000.0)))

;; ---------------- random lines ----------------
(defn base-of [c :i64 j :i64] :i64
  (let [r (rnd c (+ 10 j)) i (rem r 16)]
    (cond (= i 0) 0 (= i 1) 1 (= i 2) 63 (= i 3) 64 (= i 4) 65 (= i 5) 640 (= i 6) 3200 (= i 7) 6400 (= i 8) 9600
          (= i 9) 19200 (= i 10) 64000 (= i 11) 262143 (= i 12) 12800 (= i 13) 6400 :else (rem (quot r 16) 262144))))
(defn fac-of [c :i64 j :i64] :i64
  (let [r (rnd c (+ 20 j)) i (rem r 14)]
    (cond (= i 0) 0 (= i 1) 1 (= i 2) 2500 (= i 3) 5000 (= i 4) 10000 (= i 5) 10000 (= i 6) 10000 (= i 7) 15000
          (= i 8) 20000 (= i 9) 30000 (= i 10) 33333 (= i 11) 65535 (= i 12) 10000 :else (rem (quot r 14) 65536))))
(defn min-of [c :i64 j :i64] :i64
  (let [r (rnd c (+ 30 j)) i (rem r 14)]
    (cond (< i 5) 0 (= i 5) 1280 (= i 6) 3200 (= i 7) 6400 (= i 8) 9600 (= i 9) 12800 (= i 10) 19200 (= i 11) 262143
          (= i 12) 1 :else (rem (quot r 14) 262144))))
(defn max-of [c :i64 j :i64] :i64
  (let [r (rnd c (+ 40 j)) i (rem r 14)]
    (cond (< i 6) -1 (= i 6) 0 (= i 7) 640 (= i 8) 1920 (= i 9) 3200 (= i 10) 6400 (= i 11) 9600 (= i 12) 12800
          :else (rem (quot r 14) 262143))))
(defn net-of [c :i64] :i64
  (let [r (rnd c 50) i (rem r 14)]
    (cond (= i 0) 0 (= i 1) 1 (= i 2) 12800 (= i 3) 19200 (= i 4) 38400 (= i 5) 76800 (= i 6) 262144 (= i 7) -1000
          (= i 8) 524287 (= i 9) -524288 (= i 10) 6400 (= i 11) 25600 (= i 12) 9600 :else (- (rem (quot r 14) 1048576) 524288))))
(defn count-of [c :i64] :i64 (+ 1 (rem (rnd c 0) 4)))
(defn gaps-of [c :i64] :i64 (* 64 (rem (rnd c 60) 4)))
;; present items only; an absent item is zeros and no clamp
(defn b-at [c :i64 j :i64] :i64 (if (< j (count-of c)) (base-of c j) 0))
(defn f-at [c :i64 j :i64] :i64 (if (< j (count-of c)) (fac-of c j) 0))
(defn mn-at [c :i64 j :i64] :i64 (if (< j (count-of c)) (min-of c j) 0))
(defn mx-at [c :i64 j :i64] :i64 (if (< j (count-of c)) (max-of c j) -1))
(defn has-clamp? [c :i64] :bool
  (or (or (or (> (mn-at c 0) 0) (>= (mx-at c 0) 0)) (or (> (mn-at c 1) 0) (>= (mx-at c 1) 0)))
      (or (or (> (mn-at c 2) 0) (>= (mx-at c 2) 0)) (or (> (mn-at c 3) 0) (>= (mx-at c 3) 0)))))

(defn word [b :i64 mn :i64 mx :i64 fa :i64] :i64 (q6/item-word b mn mx fa))
;; decoders of an item word, for the f64 side (the factor low byte is in the word, the high byte in `hi`)
(defn wb [w :i64] :i64 (bit-and w 262143))
(defn wm [w :i64] :i64 (bit-and (i64-shift-right w 18) 262143))
(defn wx [w :i64] :i64 (let [x (bit-and (i64-shift-right w 36) 262143)] (if (= x 262143) -1 x)))
(defn wf [w :i64 hi :i64 j :i64] :i64 (+ (bit-and (i64-shift-right w 54) 255) (* 256 (bit-and (i64-shift-right hi (* 8 j)) 255))))
(defn q6-size [net :i64 n :i64 k :i64 w0 :i64 w1 :i64 w2 :i64 w3 :i64 hi :i64] :i64
  (q6/solve w0 w1 w2 w3 (q6/with-select (q6/line-word net n hi) k)))
(defn f64-item [w :i64 hi :i64 j :i64] [:ref :cssom.flex/item]
  (f64flex/item (f (wb w)) (d4 (wf w hi j)) (d4 (wf w hi j)) (f (wm w)) (f (wx w))))
(defn f64-size [net :i64 gaps :i64 n :i64 k :i64 w0 :i64 w1 :i64 w2 :i64 w3 :i64 hi :i64] :f64
  (f64flex/solve k n (f (+ net gaps)) (f gaps) (f64-item w0 hi 0) (f64-item w1 hi 1) (f64-item w2 hi 2) (f64-item w3 hi 3)))
(defn w-of [c :i64 j :i64] :i64 (if (< j (count-of c)) (word (b-at c j) (mn-at c j) (mx-at c j) (f-at c j)) 0))
(defn hi-of [c :i64] :i64 (q6/hi-bytes (f-at c 0) (f-at c 1) (f-at c 2) (f-at c 3)))
(defn qk [c :i64 k :i64] :i64
  (q6-size (net-of c) (count-of c) k (w-of c 0) (w-of c 1) (w-of c 2) (w-of c 3) (hi-of c)))
(defn ok-k [c :i64 k :i64] :f64
  (f64-size (net-of c) (gaps-of c) (count-of c) k (w-of c 0) (w-of c 1) (w-of c 2) (w-of c 3) (hi-of c)))

;; which: 0 eq, 1 tie, 2 cascade, 3 violation, 4 comparisons, 5 clamped lines, 6 max deviation1000
(defn line-stat [c :i64 which :i64] :i64
  (loop [k 0 acc 0]
    (if (= k (count-of c)) acc
      (let [q (qk c k) o (ok-k c k) cl (classify q o (has-clamp? c))]
        (recur (+ k 1)
               (cond (< which 4) (+ acc (if (= cl which) 1 0))
                     (= which 4) (+ acc 1)
                     (= which 5) (+ acc (if (or (and (> (mn-at c k) 0) (= q (mn-at c k))) (and (>= (mx-at c k) 0) (= q (mx-at c k)))) 1 0))
                     :else (let [dv (dev1000 q o)] (if (> dv acc) dv acc))))))))
(defn sweep [slice :i64 which :i64] :i64
  (loop [i 0 acc 0]
    (if (= i 125000) acc
      (let [c (+ (* slice 1000003) i)]
        (recur (+ i 1) (if (= which 6) (let [v (line-stat c 6)] (if (> v acc) v acc)) (+ acc (line-stat c which))))))))
(defn sweep-pack1 [slice :i64] :i64
  (+ (+ (sweep slice 0) (i64-shift-left (sweep slice 1) 21)) (i64-shift-left (sweep slice 2) 42)))
(defn sweep-pack2 [slice :i64] :i64
  (+ (+ (sweep slice 3) (i64-shift-left (sweep slice 6) 21)) (i64-shift-left (sweep slice 5) 42)))

;; ---------------- share() against the exact integer formula ----------------
(defn r-at [i :i64] :i64
  (cond (= i 0) 0 (= i 1) 1 (= i 2) -1 (= i 3) 2 (= i 4) -2 (= i 5) 63 (= i 6) 64 (= i 7) 127 (= i 8) 128 (= i 9) 129
        (= i 10) 16383 (= i 11) 16384 (= i 12) 16385 (= i 13) 2097151 (= i 14) -2097151 (= i 15) 1000000
        (= i 16) -1000000 (= i 17) 19200 (= i 18) -19200 (= i 19) 3 (= i 20) -3 (= i 21) 5 :else 7))
(defn w-at [i :i64] :i64
  (cond (= i 0) 0 (= i 1) 1 (= i 2) 2 (= i 3) 3 (= i 4) 5000 (= i 5) 10000 (= i 6) 15000 (= i 7) 65535 (= i 8) 262143
        (= i 9) 262144 (= i 10) 1000000 (= i 11) 17179869183 (= i 12) 17179869184 (= i 13) 40000 (= i 14) 1 :else 4))
(defn wt-at [i :i64] :i64
  (cond (= i 0) 0 (= i 1) 0 (= i 2) 1 (= i 3) 2 (= i 4) 3 (= i 5) 5000 (= i 6) 10000 (= i 7) 30000 (= i 8) 65535
        (= i 9) 262144 (= i 10) 262145 (= i 11) 1000000 (= i 12) 4294967296 (= i 13) 68719476735 (= i 14) 17179869184 :else 15000))
;; exact: round-half-up(r * w / tw) = floor((2 r w + tw) / (2 tw))
(defn exact-share [r :i64 w :i64 tw :i64] :i64 (fdiv (+ (* 2 (* r w)) tw) (* 2 tw)))
(defn share-dom? [r :i64 w :i64 tw :i64] :bool (and (> tw 0) (and (>= w 0) (and (<= w tw) (< (abs-i r) 2097152)))))
;; which: 0 cases, 1 violations, 2 exact ties (2 r w = tw mod 2 tw, tw > 0), 3 results below the neighbour of the floor formula
(defn share-stat [which :i64] :i64
  (loop [a 0 b 0 t 0 acc 0]
    (cond (= a 23) acc
          (= b 15) (recur (+ a 1) 0 0 acc)
          (= t 16) (recur a (+ b 1) 0 acc)
          :else
          (let [r (r-at a) w (w-at b) tw (+ (wt-at t) 0)
                q (q6/share r w tw) dom (share-dom? r w tw)
                tie (and dom (= (rem (abs-i (+ (* 2 (* r w)) tw)) (* 2 tw)) 0))
                bad (if dom (if (= q (exact-share r w tw)) 0 1) (if (= q (q6/invalid)) 0 1))]
            (recur a b (+ t 1)
                   (+ acc (cond (= which 0) 1 (= which 1) bad (= which 2) (if tie 1 0) :else 0)))))))

;; ---------------- offset() against place-main-axis ----------------
(defn sz-at [c :i64 j :i64] :i64
  (let [r (rem (rnd c (+ 70 j)) 12)]
    (cond (= r 0) 0 (= r 1) 64 (= r 2) 320 (= r 3) 1 (= r 4) 3200 (= r 5) 6400 (= r 6) 2000 (= r 7) 4095 (= r 8) 777
          (= r 9) 12800 (= r 10) 33 :else 9999)))
(defn cont-of [c :i64] :i64
  (let [r (rem (rnd c 80) 10)]
    (cond (= r 0) 0 (= r 1) 6400 (= r 2) 19200 (= r 3) 25600 (= r 4) 1000 (= r 5) 38400 (= r 6) 12345 (= r 7) 3
          (= r 8) 51200 :else 77777)))
(defn gap-of [c :i64] :i64 (let [r (rem (rnd c 90) 5)] (cond (= r 0) 0 (= r 1) 64 (= r 2) 640 (= r 3) 1 :else 160)))
(defn n-of [c :i64] :i64 (+ 1 (rem (rnd c 95) 6)))
(defn prefix-of [c :i64 i :i64] :i64
  (loop [j 0 acc 0] (if (= j i) acc (recur (+ j 1) (+ acc (sz-at c j))))))
(defn total-of [c :i64] :i64 (prefix-of c (n-of c)))
(defn off-q [c :i64 mode :i64 safe :i64 i :i64] :i64
  (q6/offset (+ (+ mode (* 8 safe)) (+ (* 16 (n-of c)) (* 4096 i))) (cont-of c) (total-of c) (gap-of c) (prefix-of c i)))
(defn off-o [c :i64 mode :i64 safe :i64 i :i64] :f64
  (f64flex/place mode safe (f (cont-of c)) (f (gap-of c)) (n-of c) i
                 (f (sz-at c 0)) (f (sz-at c 1)) (f (sz-at c 2)) (f (sz-at c 3)) (f (sz-at c 4)) (f (sz-at c 5))))
;; which: 0 comparisons, 1 violations, 2 ties, 3 max deviation1000
(defn off-stat [which :i64] :i64
  (loop [c 0 mode 0 safe 0 i 0 acc 0]
    (cond (= c 4000) acc
          (= mode 6) (recur (+ c 1) 0 0 0 acc)
          (= safe 2) (recur c (+ mode 1) 0 0 acc)
          (= i (n-of c)) (recur c mode (+ safe 1) 0 acc)
          :else
          (let [q (off-q c mode safe i) o (off-o c mode safe i) cl (classify q o false)]
            (recur c mode safe (+ i 1)
                   (cond (= which 0) (+ acc 1)
                         (= which 1) (+ acc (if (= cl 3) 1 0))
                         (= which 2) (+ acc (if (= cl 1) 1 0))
                         :else (let [dv (dev1000 q o)] (if (> dv acc) dv acc))))))))

;; ---------------- auto-offset() ----------------
(defn auto-q [c :i64 leads :i64 trails :i64 i :i64] :i64
  (let [n (n-of c)
        before (+ (loop [j 0 a 0] (if (= j i) a (recur (+ j 1) (+ a (+ (bit-and (i64-shift-right leads j) 1) (bit-and (i64-shift-right trails j) 1))))))
                  (bit-and (i64-shift-right leads i) 1))
        nauto (loop [j 0 a 0] (if (= j n) a (recur (+ j 1) (+ a (+ (bit-and (i64-shift-right leads j) 1) (bit-and (i64-shift-right trails j) 1))))))
        totalg (+ (total-of c) (* (gap-of c) (- n 1)))
        prefix (+ (prefix-of c i) (* i (gap-of c)))]
    (if (= nauto 0) prefix (q6/auto-offset (cont-of c) totalg nauto before prefix))))
(defn auto-o [c :i64 leads :i64 trails :i64 i :i64] :f64
  (f64flex/auto-place (f (cont-of c)) (f (gap-of c)) (n-of c) i leads trails
                      (f (sz-at c 0)) (f (sz-at c 1)) (f (sz-at c 2)) (f (sz-at c 3)) (f (sz-at c 4)) (f (sz-at c 5))))
(defn auto-stat [which :i64] :i64
  (loop [c 0 m 0 i 0 acc 0]
    (cond (= c 3000) acc
          (= m 64) (recur (+ c 1) 0 0 acc)
          (= i (n-of c)) (recur c (+ m 1) 0 acc)
          :else
          (let [leads (bit-and m 7) trails (bit-and (i64-shift-right m 3) 7)
                q (auto-q c leads trails i) o (auto-o c leads trails i) cl (classify q o false)]
            (recur c m (+ i 1)
                   (cond (= which 0) (+ acc 1) (= which 1) (+ acc (if (= cl 3) 1 0)) :else (+ acc (if (= cl 1) 1 0))))))))

;; ---------------- hand-derived spec points ----------------
(defn f64-eq-ok [o :f64 e :i64] :bool (f64-lt (f64-abs (f64-sub o (f e))) 0.0000001))
;; sp: one line; n items, the Q6 item words, the four factors in D4 (for the high bytes), net in raw, expected sizes in raw.
(defn sp [n :i64 net :i64 w0 :i64 w1 :i64 w2 :i64 w3 :i64 hi :i64 e0 :i64 e1 :i64 e2 :i64 e3 :i64] :bool
  (let [q0 (q6-size net n 0 w0 w1 w2 w3 hi)
        q1 (if (> n 1) (q6-size net n 1 w0 w1 w2 w3 hi) e1)
        q2 (if (> n 2) (q6-size net n 2 w0 w1 w2 w3 hi) e2)
        q3 (if (> n 3) (q6-size net n 3 w0 w1 w2 w3 hi) e3)
        o0 (f64-size net 0 n 0 w0 w1 w2 w3 hi)
        o1 (if (> n 1) (f64-size net 0 n 1 w0 w1 w2 w3 hi) (f e1))
        o2 (if (> n 2) (f64-size net 0 n 2 w0 w1 w2 w3 hi) (f e2))
        o3 (if (> n 3) (f64-size net 0 n 3 w0 w1 w2 w3 hi) (f e3))]
    (and (and (and (= q0 e0) (= q1 e1)) (and (= q2 e2) (= q3 e3)))
         (and (and (f64-eq-ok o0 e0) (f64-eq-ok o1 e1)) (and (f64-eq-ok o2 e2) (f64-eq-ok o3 e3))))))
;; sp4: the same with the items given as (base min max factor) quadruples
(defn sp4 [n :i64 net :i64 b0 :i64 m0 :i64 x0 :i64 g0 :i64 b1 :i64 m1 :i64 x1 :i64 g1 :i64 e0 :i64 e1 :i64] :bool
  (sp n net (word b0 m0 x0 g0) (word b1 m1 x1 g1) 0 0 (q6/hi-bytes g0 g1 0 0) e0 e1 0 0))
(defn sp3 [net :i64 b0 :i64 m0 :i64 x0 :i64 b1 :i64 m1 :i64 x1 :i64 b2 :i64 m2 :i64 x2 :i64
           g0 :i64 g1 :i64 g2 :i64 e0 :i64 e1 :i64 e2 :i64] :bool
  (sp 3 net (word b0 m0 x0 g0) (word b1 m1 x1 g1) (word b2 m2 x2 g2) 0 (q6/hi-bytes g0 g1 g2 0) e0 e1 e2 0))
(defn spec-flex? [] :bool
  (and
   (and (and (sp4 2 (px 200) 0 (px 150) -1 10000  0 0 -1 10000  (px 150) (px 50))
             (sp4 2 (px 300) 0 0 (px 60) 10000  0 0 -1 10000  (px 60) (px 240)))
        (and (sp3 (px 300) 0 (px 200) -1  0 0 -1  0 0 -1  10000 10000 10000  (px 200) (px 50) (px 50))
             (sp3 (px 300) 0 0 (px 30)  0 0 -1  0 0 -1  10000 10000 10000  (px 30) (px 135) (px 135))))
   (and (and (sp3 (px 300) 0 0 (px 30)  0 0 (px 40)  0 0 -1  10000 10000 10000  (px 30) (px 40) (px 230))
             (sp3 (px 300) 0 0 (px 30)  0 0 (px 110)  0 0 -1  10000 10000 10000  (px 30) (px 110) (px 160)))
        (and (sp4 2 (px 100) 0 (px 80) -1 10000  0 (px 80) -1 10000  (px 80) (px 80))
             (sp4 2 (px 200) (px 150) (px 140) -1 10000  (px 150) 0 -1 10000  (px 140) (px 60))))
   (and (and (sp4 2 (px 200) (px 150) 0 (px 60) 10000  (px 150) 0 -1 10000  (px 60) (px 140))
             (sp4 2 (px 300) 0 0 (px 50) 10000  0 0 -1 20000  (px 50) (px 250)))
        (and (sp3 (px 200) (px 20) 0 (px 20)  (px 100) (px 95) -1  (px 100) 0 -1  10000 10000 10000  1120 (px 95) 5600)
             (sp4 2 (px 120) 0 (px 147) -1 10000  0 (px 7) -1 10000  (px 147) (px 7))))
   ;; the freeze test is made on the EXACT proposal: in a shrinking line A (base 100 raw, min 100, factor 0.0001) proposes
   ;; 100 - 60000 * 100 / 1000000100 = 99.994, a hair below its minimum, so A freezes at 100 and B (base 100000, max 10000)
   ;; at 10000; testing the ROUNDED proposal (100) would leave A free to absorb the +30000 B gave back (30100)
   (sp4 2 40100 100 100 -1 1  100000 0 10000 10000  100 10000)))
;; zero-factor items keep their size
(defn spec-more? [] :bool
  (and (sp4 2 (px 300) (px 100) 0 -1 0  0 0 -1 10000  (px 100) (px 200))
       (and (sp4 2 (px 200) (px 150) 0 -1 0  (px 150) 0 -1 10000  (px 150) (px 50))
            (and (sp 1 (px 50) (word (px 10) 0 -1 10000) 0 0 0 (q6/hi-bytes 10000 0 0 0) (px 50) 0 0 0)
                 (and (sp3 (px 300) 0 0 (px 30)  0 (px 200) -1  0 0 -1  10000 10000 10000  (px 30) (px 200) (px 70))
                      (spec-tie?))))))
;; an exact tie rounds half up in Q6 (the f64 reference holds 1.5 there, which is the documented disagreement)
(defn spec-tie? [] :bool
  (let [w (word 0 0 -1 10000) hi (q6/hi-bytes 10000 10000 0 0)]
    (and (and (= (q6-size 3 2 0 w w 0 0 hi) 2) (= (q6-size 3 2 1 w w 0 0 hi) 2))
         (f64-lt (f64-abs (f64-sub (f64-size 3 0 2 0 w w 0 0 hi) 1.5)) 0.0000001))))
(defn spec-refuse? [] :bool
  (and (and (= (q6/item-word 262144 0 -1 0) (q6/invalid)) (= (q6/item-word 0 0 262143 0) (q6/invalid)))
       (and (and (= (q6/item-word 0 0 -1 65536) (q6/invalid)) (= (q6/line-word 524288 1 0) (q6/invalid)))
            (and (and (= (q6/line-word 0 5 0) (q6/invalid)) (= (q6/line-word 0 0 0) (q6/invalid)))
                 (and (= (q6/share 1 1 0) (q6/invalid))
                      (and (= (q6/share 2097152 1 1) (q6/invalid))
                           (and (= (q6/solve 0 0 0 0 (q6/with-select (q6/line-word 0 1 0) 1)) (q6/invalid))
                                (= (q6/solve 0 0 0 5 (q6/line-word 0 1 0)) (q6/invalid)))))))))
(defn spec? [] :bool (and (spec-flex?) (and (spec-more?) (spec-refuse?))))

(defn grids-ok? [] :bool
  (and (= (share-stat 1) 0)
       (and (= (off-stat 1) 0) (= (auto-stat 1) 0))))

(defn sweep-modes [m :i64] :i64
  (let [slice (quot m 10) which (rem m 10)]
    (cond (= which 1) (sweep-pack1 slice)
          (= which 2) (sweep-pack2 slice)
          (= which 3) (sweep slice 4)
          :else (if (= (sweep slice 3) 0) 42 7))))
(defn main [] :i64
  (cond (= mode 0) (if (spec?) 42 7)
        (= mode 20) (if (grids-ok?) 42 7)
        (and (>= mode 11) (<= mode 84)) (sweep-modes mode)
        (= mode 100) (share-stat 0)
        (= mode 101) (share-stat 1)
        (= mode 102) (share-stat 2)
        (= mode 110) (off-stat 0)
        (= mode 111) (off-stat 1)
        (= mode 112) (off-stat 3)
        (= mode 113) (off-stat 2)
        (= mode 120) (auto-stat 0)
        (= mode 121) (auto-stat 1)
        (= mode 122) (auto-stat 2)
        :else 0))
