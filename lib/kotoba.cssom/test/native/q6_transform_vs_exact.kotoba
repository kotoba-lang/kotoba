(ns q6-transform-vs-exact
  (:require [cssom.pack-q6 :as pk] [cssom.transform-q6 :as tf] [cssom.transform-golden-a :as ga] [cssom.transform-golden-b :as gb] [cssom.transform-golden-c :as gd])
  (:export [main]))

;; Exact-rational gate (host native macOS, JUN-929 / C2b-4, census group G05): the Q17 / Q6 matrix algebra of cssom.transform-q6 against
;; a table that Python produced ONCE with fractions.Fraction (evidence cssom-q6-transform-20261106, scripts/gen_transform_golden.py;
;; the table is data of this gate, pinned by sha256 in scripts/check-transform-q6-native-macos.py). There is no f64 oracle for sin /
;; cos / tan in the native dialect and the f64 side would be the very inexactness the Q6 rule replaces, so the reference is the
;; definition in layout.cljk (matrix*, transform-ops, the `about` conjugation) evaluated on the inputs read as exact rationals and
;; rounded half up ONCE. Inputs are regenerated here from the documented Park-Miller hash (rr, val, uval) and so are not in the table.
;;
;; P1 (N1 cases, 15 functions each): the native result must EQUAL the table word (-2^62 = refused). About 30% of the words are refusals
;; on purpose (a random input leaves the range in a third of the cases): a refusal must be agreed by both sides, never a wrapped number.
;; FLOW: all 81 x 81 coded signed-permutation pairs of flow-rotation, and flow-ab / flow-cd for the 81 codes.
;; E2E: ideal REAL-valued point images (Q6 x 16) of rotate*scale and skew*rotate about an origin point, with sin / cos / tan of the
;; independent series, no intermediate rounding. The native pipelines are (about) one `about-ef` and (chain) T(c) x M x T(-c) with
;; two mul steps as layout.cljk composes them. The error is |16 x native - ideal| in 1/16 of a Q6 ulp.
;; SPEC: hand-derived points, mostly the numbers quoted in the comments of layout.cljk.
;;
;; mode 0 : everything holds: 42 / 7.
;; modes 1..15 : mismatches of function 0..14 (coef, mul-ab, mul-cd, mul-ef, about, map-x, map-y, xs-min, xs-max, ys-min, ys-max,
;;               uniform-scale, font-scale, isqrt, origin) over the N1 cases;  16 words that are values, 17 words that are agreed refusals
;; mode 18 flow mismatches (of 6561), 19 flow-ab / flow-cd mismatches (of 162), 20 flow refusals agreed, 21 flow identities (-1) agreed
;; mode 22 spec-point failures, 23 isqrt invariant violations (r^2 <= n < (r+1)^2 over a grid and the boundaries), 24 isqrt grid points
;; modes 30 + 20 pl + 10 route + w (pl 0 rotate*scale, 1 skew*rotate; route 0 about, 1 chain):
;;       w 0 compared cases, 1 max error (1/16 ulp), 2 bound violations, 3 native refused while the ideal is in range (must be 0 for
;;       |coordinates| below the range edge), 4..8 max error for coordinate classes 2^8, 2^12, 2^16, 2^19, 2^22 raw
(def mode 0)

(defn step [x :i64] :i64 (rem (* x 48271) 2147483647))
(defn rr [i :i64 k :i64] :i64 (step (step (step (+ (+ (* 7919 i) (* 104729 k)) 1)))))
(defn pw [e :i64] :i64 (i64-shift-left 1 e))
(defn val [i :i64 k :i64 e :i64] :i64 (- (rem (rr i k) (+ (pw (+ e 1)) 1)) (pw e)))
(defn uval [i :i64 k :i64 e :i64] :i64 (rem (rr i k) (+ (pw e) 1)))
(defn abs-i [x :i64] :i64 (if (< x 0) (- 0 x) x))
(defn max-i [a :i64 b :i64] :i64 (if (> a b) a b))
(defn el-of [j :i64] :i64 (cond (= j 0) 14 (= j 1) 16 (= j 2) 17 (= j 3) 18 (= j 4) 19 (= j 5) 20 (= j 6) 22 :else 23))
(defn et-of [j :i64] :i64 (cond (= j 0) 4 (= j 1) 8 (= j 2) 12 (= j 3) 16 (= j 4) 20 (= j 5) 22 :else 23))
(defn ev-of [j :i64] :i64 (cond (= j 0) 20 (= j 1) 24 (= j 2) 26 (= j 3) 27 :else 30))
(defn en-of [j :i64] :i64 (cond (= j 0) 8 (= j 1) 16 (= j 2) 24 (= j 3) 32 (= j 4) 40 (= j 5) 44 (= j 6) 46 :else 47))
(defn el [i :i64] :i64 (el-of (rem (rr i 50) 8)))
(defn et [i :i64] :i64 (et-of (rem (rr i 51) 7)))
(defn a1 [i :i64] :i64 (val i 1 (el i)))
(defn b1 [i :i64] :i64 (val i 2 (el i)))
(defn c1 [i :i64] :i64 (val i 3 (el i)))
(defn d1 [i :i64] :i64 (val i 4 (el i)))
(defn e1 [i :i64] :i64 (val i 5 (et i)))
(defn f1 [i :i64] :i64 (val i 6 (et i)))
(defn a2 [i :i64] :i64 (val i 7 (el i)))
(defn b2 [i :i64] :i64 (val i 8 (el i)))
(defn c2 [i :i64] :i64 (val i 9 (el i)))
(defn d2 [i :i64] :i64 (val i 10 (el i)))
(defn e2 [i :i64] :i64 (val i 11 (et i)))
(defn f2 [i :i64] :i64 (val i 12 (et i)))
(defn xx [i :i64] :i64 (val i 13 (et i)))
(defn yy [i :i64] :i64 (val i 14 (et i)))
(defn ww [i :i64] :i64 (uval i 15 (et i)))
(defn hh [i :i64] :i64 (uval i 16 (et i)))
(defn cx [i :i64] :i64 (val i 17 (et i)))
(defn cy [i :i64] :i64 (val i 18 (et i)))
(defn v6 [i :i64] :i64 (val i 19 (ev-of (rem (rr i 52) 5))))
(defn nn [i :i64] :i64 (rem (* (rr i 20) (rr i 27)) (+ (pw (en-of (rem (rr i 53) 8))) 1)))
(defn fs [i :i64] :i64 (val i 21 (et i)))
(defn sc [i :i64] :i64 (val i 22 (el i)))
(defn kd [i :i64] :i64 (rem (rr i 23) 6))
(defn ov [i :i64] :i64 (val i 24 17))
(defn bs [i :i64] :i64 (val i 25 (et i)))
(defn ab1 [i :i64] :i64 (pk/pack (a1 i) (b1 i)))
(defn cd1 [i :i64] :i64 (pk/pack (c1 i) (d1 i)))
(defn ef1 [i :i64] :i64 (pk/pack (e1 i) (f1 i)))
(defn ab2 [i :i64] :i64 (pk/pack (a2 i) (b2 i)))
(defn cd2 [i :i64] :i64 (pk/pack (c2 i) (d2 i)))
(defn ef2 [i :i64] :i64 (pk/pack (e2 i) (f2 i)))
(defn xy [i :i64] :i64 (pk/pack (xx i) (yy i)))
(defn wh [i :i64] :i64 (pk/pack (ww i) (hh i)))
(defn cxy [i :i64] :i64 (pk/pack (cx i) (cy i)))

(defn native [i :i64 f :i64] :i64
  (cond (= f 0) (tf/coef-of-number (v6 i))
        (= f 1) (tf/mul-ab (ab1 i) (cd1 i) (ab2 i))
        (= f 2) (tf/mul-cd (ab1 i) (cd1 i) (cd2 i))
        (= f 3) (tf/mul-ef (ab1 i) (cd1 i) (ef1 i) (ef2 i))
        (= f 4) (tf/about-ef (ab1 i) (cd1 i) (ef1 i) (cxy i))
        (= f 5) (tf/map-x (ab1 i) (cd1 i) (ef1 i) (xy i))
        (= f 6) (tf/map-y (ab1 i) (cd1 i) (ef1 i) (xy i))
        (= f 7) (tf/xs-min (ab1 i) (cd1 i) (ef1 i) (xy i) (wh i))
        (= f 8) (tf/xs-max (ab1 i) (cd1 i) (ef1 i) (xy i) (wh i))
        (= f 9) (tf/ys-min (ab1 i) (cd1 i) (ef1 i) (xy i) (wh i))
        (= f 10) (tf/ys-max (ab1 i) (cd1 i) (ef1 i) (xy i) (wh i))
        (= f 11) (tf/uniform-scale (ab1 i) (cd1 i))
        (= f 12) (tf/font-scale (fs i) (sc i))
        (= f 13) (tf/isqrt (nn i))
        :else (tf/origin-coord (kd i) (ov i) (bs i))))
(defn g1 [i :i64 f :i64] :i64 (if (< f 8) (ga/g1a i f) (gb/g1b i f)))
(defn bad [i :i64 f :i64] :i64 (if (= (native i f) (g1 i f)) 0 1))
(defn refused [i :i64 f :i64] :i64 (if (= (g1 i f) (tf/invalid)) 1 0))
(defn sum-f [m :i64] :i64
  (loop [i 0 acc 0]
    (if (>= i (gd/n1)) acc
      (recur (+ i 1) (+ acc (if (<= m 15) (bad i (- m 1)) 0))))))
(defn sum-all [w :i64] :i64
  (loop [i 0 acc 0]
    (if (>= i (gd/n1)) acc
      (recur (+ i 1) (+ acc (loop [f 0 s 0] (if (> f 14) s (recur (+ f 1) (+ s (if (= w 16) (- 1 (refused i f)) (refused i f)))))))))))

;; ---- flow ----
(defn flow-bad [] :i64
  (loop [k 0 acc 0] (if (>= k 6561) acc (recur (+ k 1) (+ acc (if (= (tf/flow-rotation (quot k 81) (rem k 81)) (gd/g-flow k)) 0 1))))))
(defn flow-ab-bad [] :i64
  (loop [k 0 acc 0] (if (>= k 81) acc (recur (+ k 1) (+ acc (+ (if (= (tf/flow-ab k) (gd/g-flow-ab k)) 0 1) (if (= (tf/flow-cd k) (gd/g-flow-cd k)) 0 1)))))))
(defn flow-count [w :i64] :i64
  (loop [k 0 acc 0]
    (if (>= k 6561) acc
      (recur (+ k 1) (+ acc (if (= w 20) (if (= (gd/g-flow k) (tf/invalid)) 1 0) (if (= (gd/g-flow k) -1) 1 0)))))))

;; ---- isqrt invariants: r^2 <= n < (r+1)^2, a grid of n and the boundaries r^2 - 1, r^2, r^2 + 1 ----
(defn isq-ok [n :i64] :i64
  (let [r (tf/isqrt n)] (if (and (<= (* r r) n) (< n (* (+ r 1) (+ r 1)))) 0 1)))
(defn isq-grid-bad [] :i64
  (loop [k 0 acc 0]
    (if (>= k 4000) acc
      (recur (+ k 1) (+ acc (let [n (rem (* (rr k 90) (rr k 91)) 70368744177664) r (* k 1757)]
                              (+ (isq-ok n) (+ (isq-ok (* r r)) (+ (if (= k 0) 0 (isq-ok (- (* r r) 1))) (isq-ok (+ (* r r) 1)))))))))))

;; ---- spec points (derived by hand from the comments of layout.cljk, or by Python once) ----
(defn id-ab [] :i64 (tf/ident-ab))
(defn id-cd [] :i64 (tf/ident-cd))
(defn near [a :i64 b :i64 t :i64] :bool (<= (abs-i (- a b)) t))
;; each spec point is one clause of spec-pass (index k), true when it holds; spec-all counts the failures
(defn spec-pass [k :i64] :bool
  (cond
    ;; translate(10px, 10px) scale(2) = matrix(2, 0, 0, 2, 10, 10): the translation is untouched by the scale
    (= k 0) (= (tf/mul-ab (id-ab) (id-cd) (tf/scale-ab 262144)) (pk/pack 262144 0))
    (= k 1) (= (tf/mul-cd (id-ab) (id-cd) (tf/scale-cd 262144)) (pk/pack 0 262144))
    (= k 2) (= (tf/mul-ef (id-ab) (id-cd) (pk/pack 640 640) (tf/zero-ef)) (pk/pack 640 640))
    ;; scale(2) translate(10px, 10px) = matrix(2, 0, 0, 2, 20, 20)
    (= k 3) (= (tf/mul-ef (tf/scale-ab 262144) (tf/scale-cd 262144) (tf/zero-ef) (pk/pack 640 640)) (pk/pack 1280 1280))
    ;; rotate(90deg) = [0 1 -1 0], rotate(180deg), rotate(-0.25turn): the quadrant edges are exact
    (= k 4) (= (tf/rotate-ab 1 90000000) (pk/pack 0 131072))
    (= k 5) (= (tf/rotate-cd 1 90000000) (pk/pack -131072 0))
    (= k 6) (= (tf/rotate-ab 1 180000000) (pk/pack -131072 0))
    (= k 7) (= (tf/rotate-ab 4 -250000) (pk/pack 0 -131072))
    ;; one micro-radian past the domain edge (32 turns) is refused, the edge itself is not
    (= k 8) (= (tf/rotate-ab 3 201061930) (tf/invalid))
    (= k 9) (not= (tf/rotate-ab 3 201061929) (tf/invalid))
    ;; skew(45deg) has tan = 1 exactly; skewX(90deg) is refused (tan is infinite); skewX(89.5deg) = 114.589 is refused (>= 64)
    (= k 10) (= (tf/skew-cd 1 45000000) (pk/pack 131072 131072))
    (= k 11) (= (tf/skew-cd 1 90000000) (tf/invalid))
    (= k 12) (= (tf/skew-cd 1 89500000) (tf/invalid))
    ;; the doc of transform-ops: a 45deg rotation of a 100x20 box reports a 84.8528 px wide bounding box (5430.58 raw in Q6)
    (= k 13) (near (tf/bbox-w (tf/rotate-ab 1 45000000) (tf/rotate-cd 1 45000000) (tf/zero-ef) (pk/pack 0 0) (pk/pack 6400 1280)) 5431 1)
    ;; scale(2, 3): the font factor is sqrt(6) = 2.449 (321059.52 in Q17); a rotation has factor 1
    (= k 14) (= (tf/uniform-scale (tf/scale-ab 262144) (tf/scale-cd 393216)) 321060)
    (= k 15) (near (tf/uniform-scale (tf/rotate-ab 1 45000000) (tf/rotate-cd 1 45000000)) 131072 1)
    (= k 16) (= (tf/uniform-scale (tf/rotate-ab 1 90000000) (tf/rotate-cd 1 90000000)) 131072)
    ;; |det| at the budget: 8388607 * 8388607 < 2^46 passes; a = d = b = 8388607, c = -8388607 gives 2 * 8388607^2 >= 2^46: refused
    (= k 17) (not= (tf/uniform-scale (pk/pack 8388607 0) (pk/pack 0 8388607)) (tf/invalid))
    (= k 18) (= (tf/uniform-scale (pk/pack 8388607 8388607) (pk/pack -8388607 8388607)) (tf/invalid))
    ;; flow-rotation: vertical-rl (46) in a horizontal parent (68) is the child itself, horizontal in vertical-rl is [0 -1 1 0] = 34, same mode is nil
    (= k 19) (= (tf/flow-rotation 46 68) 46)
    (= k 20) (= (tf/flow-rotation 68 46) 34)
    (= k 21) (= (tf/flow-rotation 52 52) -1)
    ;; transform-origin: center of 100 px (6400 raw) is 3200, of an odd raw 127 is 64 (half up), 100% is the basis, 25% of 6400 = 1600
    (= k 22) (= (tf/origin-coord 0 0 6400) 3200)
    (= k 23) (= (tf/origin-coord 0 0 127) 64)
    (= k 24) (= (tf/origin-coord 2 0 6400) 6400)
    (= k 25) (= (tf/origin-coord 4 2500 6400) 1600)
    ;; numbers: 2 -> 262144, 0.5 -> 65536, -1.25 -> -163840, 64 -> refused, 63.999995 -> 8388607 (63.999999 rounds to 8388608 and is refused)
    (= k 26) (= (tf/coef-of-number 2000000) 262144)
    (= k 27) (= (tf/coef-of-number 500000) 65536)
    (= k 28) (= (tf/coef-of-number -1250000) -163840)
    (= k 29) (= (tf/coef-of-number 64000000) (tf/invalid))
    (= k 30) (= (tf/coef-of-number 63999995) 8388607)
    :else false))
(defn spec-all [] :i64
  (loop [k 0 acc 0] (if (> k 30) acc (recur (+ k 1) (+ acc (if (spec-pass k) 0 1))))))

;; ---- end to end ----
(defn eu [i :i64] :i64 (+ 1 (rem (rr i 60) 4)))
(defn limit-of [u :i64] :i64 (cond (= u 1) 11520000000 (= u 2) 12800000000 (= u 3) 201061929 :else 32000000))
(defn ev [i :i64] :i64 (- (rem (rr i 61) (+ (* 2 (limit-of (eu i))) 1)) (limit-of (eu i))))
(defn esx [i :i64] :i64 (- (rem (rr i 62) 4000001) 2000000))
(defn esy [i :i64] :i64 (- (rem (rr i 63) 4000001) 2000000))
(defn eax [i :i64] :i64 (- (rem (rr i 64) 170000001) 85000000))
(defn eay [i :i64] :i64 (- (rem (rr i 65) 170000001) 85000000))
(defn eex [i :i64] :i64 (let [j (rem (rr i 66) 5)] (cond (= j 0) 8 (= j 1) 12 (= j 2) 16 (= j 3) 19 :else 22)))
(defn ex [i :i64] :i64 (val i 67 (eex i)))
(defn ey [i :i64] :i64 (val i 68 (eex i)))
(defn ecx [i :i64] :i64 (val i 69 (eex i)))
(defn ecy [i :i64] :i64 (val i 70 (eex i)))
(defn m-ab [i :i64 pl :i64] :i64
  (if (= pl 0)
    (tf/mul-ab (tf/rotate-ab (eu i) (ev i)) (tf/rotate-cd (eu i) (ev i)) (tf/scale-ab (tf/coef-of-number (esx i))))
    (tf/mul-ab (tf/skew-ab 1 (eay i)) (tf/skew-cd 1 (eax i)) (tf/rotate-ab (eu i) (ev i)))))
(defn m-cd [i :i64 pl :i64] :i64
  (if (= pl 0)
    (tf/mul-cd (tf/rotate-ab (eu i) (ev i)) (tf/rotate-cd (eu i) (ev i)) (tf/scale-cd (tf/coef-of-number (esy i))))
    (tf/mul-cd (tf/skew-ab 1 (eay i)) (tf/skew-cd 1 (eax i)) (tf/rotate-cd (eu i) (ev i)))))
;; the translation. route 0: one about-ef. route 1: T(c) x M x T(-c) as layout.cljk composes it (two matrix* steps); the first product
;; T(c) x M has the linear part M (identity times M is exact) and the translation c, the second multiplies by T(-c)
(defn m-ef-chain [i :i64 pl :i64] :i64
  (tf/mul-ef (m-ab i pl) (m-cd i pl) (tf/mul-ef (id-ab) (id-cd) (pk/pack (ecx i) (ecy i)) (tf/zero-ef)) (pk/pack (- 0 (ecx i)) (- 0 (ecy i)))))
(defn ef-of [i :i64 pl :i64 route :i64] :i64
  (if (= route 0) (tf/about-ef (m-ab i pl) (m-cd i pl) (tf/zero-ef) (pk/pack (ecx i) (ecy i))) (m-ef-chain i pl)))
(defn img-x [i :i64 pl :i64 route :i64] :i64 (tf/map-x (m-ab i pl) (m-cd i pl) (ef-of i pl route) (pk/pack (ex i) (ey i))))
(defn img-y [i :i64 pl :i64 route :i64] :i64 (tf/map-y (m-ab i pl) (m-cd i pl) (ef-of i pl route) (pk/pack (ex i) (ey i))))
(defn skipped? [pl :i64 i :i64] :bool (= (gd/g-e2e-x pl i) 0))
(defn err16 [pl :i64 route :i64 i :i64] :i64
  (let [nx (img-x i pl route) ny (img-y i pl route)]
    (if (or (= nx (tf/invalid)) (= ny (tf/invalid))) -1
      (max-i (abs-i (- (* 16 nx) (- (gd/g-e2e-x pl i) 134217728))) (abs-i (- (* 16 ny) (- (gd/g-e2e-y pl i) 134217728)))))))
(defn s-sum [i :i64] :i64 (+ (+ (abs-i (ex i)) (abs-i (ey i))) (+ (abs-i (ecx i)) (abs-i (ecy i)))))
;; bound in 1/16 ulp: about 16 (2 + 4 S / 2^15) (coefficient error <= 16 Q17 ulps), chain 16 (3 + 8 S / 2^15)
(defn bound16 [i :i64 route :i64] :i64
  (if (= route 0) (* 16 (+ 2 (quot (* 4 (s-sum i)) 32768))) (* 16 (+ 3 (quot (* 8 (s-sum i)) 32768)))))
(defn e2e-stat [pl :i64 route :i64 w :i64] :i64
  (loop [i 0 acc 0]
    (if (>= i (gd/n2)) acc
      (recur (+ i 1)
        (if (skipped? pl i) acc
          (let [e (err16 pl route i) cls (eex i)]
            (cond (= w 0) (+ acc 1)
                  (= w 1) (max-i acc e)
                  (= w 2) (+ acc (if (and (>= e 0) (> e (bound16 i route))) 1 0))
                  (= w 3) (+ acc (if (< e 0) 1 0))
                  (= w 4) (if (= cls 8) (max-i acc e) acc)
                  (= w 5) (if (= cls 12) (max-i acc e) acc)
                  (= w 6) (if (= cls 16) (max-i acc e) acc)
                  (= w 7) (if (= cls 19) (max-i acc e) acc)
                  :else (if (= cls 22) (max-i acc e) acc))))))))

(defn verdict [] :i64
  (if (and (= (spec-all) 0)
        (and (= (sum-f 1) 0) (and (= (sum-f 2) 0) (and (= (sum-f 3) 0) (and (= (sum-f 4) 0) (and (= (sum-f 5) 0) (and (= (sum-f 6) 0)
        (and (= (sum-f 7) 0) (and (= (sum-f 8) 0) (and (= (sum-f 9) 0) (and (= (sum-f 10) 0) (and (= (sum-f 11) 0) (and (= (sum-f 12) 0)
        (and (= (sum-f 13) 0) (and (= (sum-f 14) 0) (and (= (sum-f 15) 0)
        (and (= (flow-bad) 0) (and (= (flow-ab-bad) 0) (and (= (isq-grid-bad) 0)
        (and (= (e2e-stat 0 0 2) 0) (and (= (e2e-stat 0 1 2) 0) (and (= (e2e-stat 1 0 2) 0) (= (e2e-stat 1 1 2) 0)))))))))))))))))))))))
    42 7))

(defn main [] :i64
  (cond (= mode 0) (verdict)
        (<= mode 15) (sum-f mode)
        (= mode 16) (sum-all 16)
        (= mode 17) (sum-all 17)
        (= mode 18) (flow-bad)
        (= mode 19) (flow-ab-bad)
        (= mode 20) (flow-count 20)
        (= mode 21) (flow-count 21)
        (= mode 22) (spec-all)
        (= mode 23) (isq-grid-bad)
        (= mode 24) 16000
        :else (e2e-stat (quot (- mode 30) 20) (rem (quot (- mode 30) 10) 2) (rem (- mode 30) 10))))
