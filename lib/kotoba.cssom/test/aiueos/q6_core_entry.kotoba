(ns q6-core-entry
  (:require [cssom.length-q6 :as len] [cssom.block-width-q6 :as bw] [cssom.margin-collapse-q6 :as mc] [cssom.block-style-q6 :as bs])
  (:export [main]))

;; Compile-size entry for the Q6 ARITHMETIC CORE (JUN-920 / C2b): every exported scalar function of length_q6,
;; block_width_q6, margin_collapse_q6 and block_style_q6 is reached from `main`, with inputs that come from the two
;; arguments so nothing folds to a constant. parse_px_q6 is NOT in this entry: it reads a string, which the
;; aiueos targets refuse (E7101 detail 16). This file only exists to be compiled with
;;   amu-full-root compile --target x86_64-aiueos-kernel-v1 (and user-v1, to record the verdict);
;; it is never run. Two arguments because the user / kernel entry takes (base, length).
(defn main [a :i64 b :i64] :i64
  (+ (+ (+ (len/resolve-kind a b (+ a 1) b) (len/resolve-value a b (+ b 1) a))
        (+ (len/percent-of a b) (+ (len/percent-of-int a b) (len/round-px b))))
     (+ (+ (+ (bw/solve-pick a (bw/pack a b) (bw/pack b a) a) (bw/solve-constrained-pick a (bw/pack a b) (bw/pack b a) a (bw/pack a a)))
           (+ (bw/hi a) (bw/lo b)))
        (+ (+ (mc/finish (mc/add (mc/add (mc/empty-state) a) b)) (mc/negative a))
           (+ (bs/solve-pick (bs/p0-of a b a b) (bs/pair a b) (bs/pair (bs/slot a b) b) (bs/pair a (bs/border-field a b)) b)
              (len/fdiv a (+ b 1)))))))
