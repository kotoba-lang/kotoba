(ns q6-core-entry-zero
  (:require [cssom.length-q6 :as len] [cssom.block-width-q6 :as bw] [cssom.margin-collapse-q6 :as mc] [cssom.block-style-q6 :as bs])
  (:export [main]))

;; Zero-argument twin of q6_core_entry.kotoba (JUN-920 / C2b): x86_64-aiueos-user-v1 admits only a zero-argument
;; scalar entry (a two-argument entry is E7102 there), so this is the file the user-v1 verdict is taken from. The
;; same exported functions are reached with literal inputs. Compile-only; never run.
(defn main [] :i64
  (+ (+ (+ (len/resolve-kind 2 5000 3200 3) (len/resolve-value 2 5000 3200 3))
        (+ (len/percent-of 2900 3200) (+ (len/percent-of-int 2900 50) (len/round-px 3201))))
     (+ (+ (+ (bw/solve-pick 76 (bw/pack 12800 5120) (bw/pack 640 320) 100)
              (bw/solve-constrained-pick 108 (bw/pack 12800 5120) (bw/pack 640 320) 100 (bw/pack 64 6400)))
           (+ (bw/hi (bw/pack 5 6)) (bw/lo (bw/pack 7 8))))
        (+ (+ (mc/finish (mc/add (mc/add (mc/empty-state) 656) -544)) (mc/negative (mc/add (mc/empty-state) -64)))
           (+ (bs/solve-pick (bs/p0-of 12800 1 1 0) (bs/pair (bs/slot 2 5000) (bs/slot 1 0)) (bs/pair (bs/slot 4 0) (bs/slot 3 0))
                             (bs/pair (bs/slot 3 0) (bs/slot 1 640)) (bs/pair (bs/slot 1 640) (bs/border-field 128 192)))
              (+ (len/fdiv -7 2) (bs/invalid)))))))
