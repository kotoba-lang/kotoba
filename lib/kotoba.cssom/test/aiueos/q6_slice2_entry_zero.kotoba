(ns q6-slice2-entry-zero
  (:require [cssom.calc-q6 :as calc] [cssom.line-height-q6 :as lh] [cssom.aspect-ratio-q6 :as ar] [cssom.pack-q6 :as pk])
  (:export [main]))

;; Zero-argument twin of q6_slice2_entry.kotoba (JUN-920 / C2b): x86_64-aiueos-user-v1 admits only a zero-argument scalar
;; entry, so the user-v1 verdict is taken from this file. The same exported functions are reached with literal inputs.
;; Compile-only; never run.
(defn main [] :i64
  (+ (+ (+ (calc/check 3346) (calc/result-unit 3346)) (+ (calc/eval-q6 3346 (pk/pack 6400 1280) (pk/pack 0 0)) (calc/invalid)))
     (+ (+ (+ (lh/mul-trunc 12000 1792) (lh/mul-round 12000 896)) (+ (lh/resolve 4 0 1792 20) (lh/leading-ascent 12 3 20)))
        (+ (+ (+ (lh/marker-advance 896) (lh/option-height 896)) (+ (lh/tab-stop 448 3584) (lh/invalid)))
           (+ (+ (+ (ar/block-height 0 8960 (pk/pack 3 1) (pk/pack 1280 1280)) (ar/block-width 1 3840 (pk/pack 3 1) (pk/pack 0 0)))
                 (+ (ar/replaced-width 6 (pk/pack 0 6400) (pk/pack 40 20) 19200) (ar/replaced-height 4 11776 0 (pk/pack 40 20) 9600)))
              (+ (ar/intrinsic-px 32) (ar/invalid)))))))
