(ns q6-slice2-entry
  (:require [cssom.calc-q6 :as calc] [cssom.line-height-q6 :as lh] [cssom.aspect-ratio-q6 :as ar] [cssom.pack-q6 :as pk])
  (:export [main]))

;; Compile-size entry for the slice-2 Q6 ARITHMETIC CORE (JUN-920 / C2b): every exported scalar function of calc_q6,
;; line_height_q6, aspect_ratio_q6 (and the packing of pack_q6 they share) is reached from `main`, with inputs that come
;; from the two arguments so nothing folds to a constant. Compile-only (amu-full-root compile --target
;; x86_64-aiueos-kernel-v1 and user-v1); never run. Two arguments because the kernel / user entry takes (base, length).
(defn main [a :i64 b :i64] :i64
  (+ (+ (+ (calc/check a) (calc/result-unit b)) (+ (calc/eval-q6 a (pk/pack a b) (pk/pack b a)) (calc/invalid)))
     (+ (+ (+ (lh/mul-trunc a b) (lh/mul-round b a)) (+ (lh/resolve a b a b) (lh/leading-ascent a b a)))
        (+ (+ (+ (lh/marker-advance a) (lh/option-height b)) (+ (lh/tab-stop a b) (lh/invalid)))
           (+ (+ (+ (ar/block-height a b (pk/pack a b) (pk/pack b a)) (ar/block-width a b (pk/pack a b) (pk/pack b a)))
                 (+ (ar/replaced-width a (pk/pack a b) (pk/pack b a) b) (ar/replaced-height a b a (pk/pack b a) b)))
              (+ (ar/intrinsic-px a) (ar/invalid)))))))
