(ns cssom.cascade-k (:require [cssom.intern-k :as ik] [cssom.selector-k :as sk] [cssom.match-k :as mk])
  (:export [ck-run ck-nodes]))
;; Style slice, kernel dialect: cascade order, inheritance and a comparable digest (ADR-0287, JUN-920). Pipeline of ck-run:
;; reset, sheet (selector-k), document (match-k), one match row per selector entry, then per element in document order the
;; winning declaration per property, the inherited value where there is none, and a digest of the computed style.
;; Cascade key of a declaration d of selector entry s, as one number (larger wins; core.cljk sort-by juxt, unlayered):
;;   key = ((important << 49 | origin << 48 | specificity) << 12) + (d + 1)
;; important first, then origin (user agent 0 below author 1), then the packed specificity (ids << 32 | classes << 16 | tags),
;; then source order (the declaration index grows with rule order and with position inside a rule, as :order, :decl-index).
;; Not modelled here, so not claimed: cascade layers, @scope proximity, inline style, shorthand expansion, var()/attr()
;; substitution, and the CSS-wide keywords (a declaration whose value is one is refused with -13).
;; Inheritance: a property of the engine's inherited-properties list (core.cljk, the 37 names of inherited-property?)
;; with no winning declaration takes the parent's computed value; every other property stays absent.
;; Computed values: u16 string id per (element, property index) at 40960 + 32 n + 2 k (0 absent), at most 16 properties.
;; Scratch in the header page: u64 best key per property at 1024 + 8 k, u16 best value at 1152 + 2 k, u8 inherited flag at 320 + k.
;; Digest of an element: sum over its present properties of H(name ":" value) mod 2^32, H(b0..) = h <- (257 h + b + 1) mod 2^32
;; from 5381. The case sum is S = sum over elements in document order of (n + 1) * digest(n) < 2^46.
;; ck-run returns S (>= 0) or the negative status of the failing stage (-1 malformed, -2 input too large, -3 elements,
;; -4 strings, -5 string pool, -6 selector entries, -7 declarations, -8 compounds, -9 classes, -10 properties, -11 depth,
;; -12 selector outside the subset, -13 CSS-wide keyword).
(defn- hd [st i] (kernel-load-u32-4k (kernel-subregion st 61440 49152 4096) 4096 (* 4 i)))
(defn- hd! [st i v] (kernel-store-u32-4k (kernel-subregion st 61440 49152 4096) 4096 (* 4 i) v))
(defn- h16 [st at] (kernel-load-u16-4k (kernel-subregion st 61440 49152 4096) 4096 at))
(defn- h16! [st at v] (kernel-store-u16-4k (kernel-subregion st 61440 49152 4096) 4096 at v))
(defn- h8 [st at] (kernel-load-u8-4k (kernel-subregion st 61440 49152 4096) 4096 at))
(defn- h8! [st at v] (kernel-store-u8-4k (kernel-subregion st 61440 49152 4096) 4096 at v))
(defn- bk [st k] (kernel-load-u64-4k (kernel-subregion st 61440 49152 4096) 4096 (+ 1024 (* 8 k))))
(defn- bk! [st k v] (kernel-store-u64-4k (kernel-subregion st 61440 49152 4096) 4096 (+ 1024 (* 8 k)) v))
(defn- nd [st n at] (kernel-load-u16-4k (kernel-subregion st 61440 24576 4096) 4096 (+ (* 32 n) at)))
(defn- rl [st s at] (kernel-load-u16-4k (kernel-subregion st 61440 28672 4096) 4096 (+ (* 32 s) at)))
(defn- rl64 [st s] (kernel-load-u64-4k (kernel-subregion st 61440 28672 4096) 4096 (+ (* 32 s) 16)))
(defn- dc [st d at] (kernel-load-u16-4k (kernel-subregion st 61440 32768 4096) 4096 (+ (* 8 d) at)))
(defn- cv [st n k] (kernel-load-u16-4k (kernel-subregion st 61440 40960 4096) 4096 (+ (* 32 n) (* 2 k))))
(defn- cv! [st n k v] (kernel-store-u16-4k (kernel-subregion st 61440 40960 4096) 4096 (+ (* 32 n) (* 2 k)) v))
(defn- mm [st i] (kernel-load-u8-4k (kernel-subregion st 61440 45056 4096) 4096 i))
(defn- bit [m j] (bit-and (u64-shift-right m j) 1))

;; ---- the inherited-properties list, as exact byte tests on the name (7 bytes per word, little endian) ----
;; GENERATED from the list in core.cljk by scripts/check-style-k-native-macos.py (the gate regenerates it and compares).
(defn- inh? [n w0 w1 w2]
  (or (and (= n 5) (= w0 491495649123)) (or (and (= n 4) (= w0 1953394534)) (or (and (and (= n 11) (= w0 27415418153889638)) (= w1 2037148013)) (or (and (and (= n 9) (= w0 29681511618735974)) (= w1 25978)) (or (and (and (= n 10) (= w0 32777736362553190)) (= w1 6646905)) (or (and (and (= n 11) (= w0 28560009758404454)) (= w1 1952999273)) (or (and (and (= n 12) (= w0 27433010339934054)) (= w1 500068084082)) (or (and (and (= n 12) (= w0 32777736362553190)) (= w1 448345171314)) (or (and (and (= n 11) (= w0 28543516832328044)) (= w1 1952999273)) (or (and (and (= n 14) (= w0 12792154023028076)) (= w1 29113321519149171)) (or (and (and (= n 12) (= w0 31651836187537271)) (= w1 444234031969)) (or (and (and (= n 10) (= w0 30506145340220788)) (= w1 7235433)) (or (and (and (= n 11) (= w0 31077891386664308)) (= w1 1953391972)) (or (and (and (= n 14) (= w0 32215885921412468)) (= w1 30806595247238753)) (or (and (and (= n 11) (= w0 29400036642678132)) (= w1 2003788897)) (or (and (and (= n 11) (= w0 32419536089737335)) (= w1 1701011824)) (or (and (and (= n 10) (= w0 32196094443286391)) (= w1 7037285)) (or (and (and (= n 13) (= w0 31362909676598895)) (= w1 123563834551671)) (or (and (and (= n 9) (= w0 32219184187469687)) (= w1 28769)) (or (and (and (= n 8) (= w0 34455890562277748)) (= w1 101)) (or (and (= n 7) (= w0 32491004144679272)) (or (and (and (= n 9) (= w0 29682842807200100)) (= w1 28271)) (or (and (and (= n 10) (= w0 30515168881633654)) (= w1 7959657)) (or (and (= n 6) (= w0 125823003817315)) (or (and (= n 6) (= w0 126879582352753)) (or (and (and (= n 10) (= w0 32777736362879340)) (= w1 6646905)) (or (and (and (and (= n 15) (= w0 32777736362879340)) (= w1 31658737276382329)) (= w2 101)) (or (and (and (and (= n 19) (= w0 32777736362879340)) (= w1 32492149910367353)) (= w2 474315584617)) (or (and (and (and (= n 16) (= w0 32777736362879340)) (= w1 27423371241548921)) (= w2 25959)) (or (and (and (and (= n 15) (= w0 12792153754464098)) (= w1 32493186054909795)) (= w2 101)) (or (and (and (= n 14) (= w0 12792153754464098)) (= w1 29113321519149171)) (or (and (and (= n 12) (= w0 31084746153943395)) (= w1 435476329261)) (or (and (and (= n 11) (= w0 27916022362172773)) (= w1 1936485477)) (or (and (= n 7) (= w0 32490986964808303)) (or (and (= n 6) (= w0 126956807154039)) (or (and (and (= n 12) (= w0 29113321804886647)) (= w1 435476720941)) (and (and (and (= n 16) (= w0 32210388363273588)) (= w1 29682834468660585)) (= w2 28271)))))))))))))))))))))))))))))))))))))))

(defn- inherits? [st k]
  (let [ps (h16 st (+ 256 (* 2 k)))
        n (ik/ik-len st 61440 ps)]
    (if (inh? n (ik/ik-word st 61440 ps 0 0) (ik/ik-word st 61440 ps 1 0) (ik/ik-word st 61440 ps 2 0)) 1 0)))
(defn- flags [st k nprop]
  (if (>= k nprop) 1 (flags st (+ k (+ 1 (* 0 (h8! st (+ 320 k) (inherits? st k))))) nprop)))

;; ---- digest ----
(defn- hs [st id i n h]
  (if (>= i n) h (hs st id (+ i 1) n (bit-and (+ (* h 257) (+ 1 (ik/ik-byte st 61440 id i))) 4294967295))))
(defn- pair [st ps vs]
  (let [h1 (hs st ps 0 (ik/ik-len st 61440 ps) 5381)
        h2 (bit-and (+ (* h1 257) 59) 4294967295)]
    (hs st vs 0 (ik/ik-len st 61440 vs) h2)))

;; ---- cascade of one element ----
(defn- best-init [st k nprop]
  (if (>= k nprop) 1 (best-init st (+ k (+ 1 (* 0 (+ (bk! st k 0) (h16! st (+ 1152 (* 2 k)) 0))))) nprop)))
(defn- upd [st pi key d]
  (if (> key (bk st pi)) (+ (bk! st pi key) (h16! st (+ 1152 (* 2 pi)) (dc st d 2))) 0))
(defn- decl-loop [st base d lim]
  (if (>= d lim) 1
    (let [pi (dc st d 0)
          key (+ (i64-shift-left (bit-or (i64-shift-left (dc st d 4) 49) base) 12) (+ d 1))]
      (decl-loop st base (+ d (+ 1 (* 0 (upd st pi key d)))) lim))))
(defn- mbit [st s n] (bit (mm st (+ (* 16 s) (u64-shift-right n 3))) (bit-and n 7)))
(defn- apply-sel [st s]
  (decl-loop st (bit-or (i64-shift-left (rl st s 0) 48) (rl64 st s)) (rl st s 6) (+ (rl st s 6) (rl st s 8))))
(defn- try-sel [st n s] (if (= (mbit st s n) 1) (apply-sel st s) 0))
(defn- sel-loop [st n s ns]
  (if (>= s ns) 1 (sel-loop st n (+ s (+ 1 (* 0 (try-sel st n s)))) ns)))
(defn- pick [st n k]
  (if (> (bk st k) 0) (h16 st (+ 1152 (* 2 k)))
    (if (and (= (h8 st (+ 320 k)) 1) (< (nd st n 4) 65535)) (cv st (nd st n 4) k) 0)))
(defn- addp [st k v acc]
  (if (= v 0) acc (bit-and (+ acc (pair st (h16 st (+ 256 (* 2 k))) v)) 4294967295)))
(defn- res-loop [st n k nprop acc]
  (if (>= k nprop) acc
    (let [v (pick st n k) z (cv! st n k v)]
      (res-loop st n (+ k 1) nprop (+ (addp st k v acc) (* 0 z))))))
(defn- nodes [st n nn ns acc]
  (if (>= n nn) acc
    (let [np (hd st 6) a (best-init st 0 np) b (sel-loop st n 0 ns) d (res-loop st n 0 np 0)]
      (nodes st (+ n (+ 1 (* 0 (+ a b)))) nn ns (+ acc (* (+ n 1) d))))))
(defn- match-all [w length s ns]
  (if (>= s ns) 1 (match-all w length (+ s (+ 1 (* 0 (mk/mk-match w length s)))) ns)))
(defn- run3 [w length st]
  (let [q (mk/mk-doc w length (hd st 10))]
    (if (< q 0) q
      (if (not (= q (hd st 12))) -1
        (let [f (flags st 0 (hd st 6)) m (match-all w length 0 (hd st 3))]
          (nodes st 0 (hd st 2) (hd st 3) (+ 0 (* 0 (+ f m)))))))))
(defn ck-run [w length inlen]
  (if (< length 61440) -1
    (if (or (< inlen 0) (> inlen 16384)) -2
      (let [st (kernel-subregion w length 0 61440)
            z (+ (ik/ik-reset w length) (+ (sk/sk-reset w length) (+ (hd! st 12 inlen) (hd! st 2 0))))
            p (sk/sk-sheet w length (* 0 z))]
        (if (< p 0) p
          (let [y (hd! st 10 p)] (run3 w length st)))))))
(defn ck-nodes [w length] (if (>= length 61440) (hd (kernel-subregion w length 0 61440) 2) -1))
