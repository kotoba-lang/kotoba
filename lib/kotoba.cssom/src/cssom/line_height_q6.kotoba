(ns cssom.line-height-q6
  (:require [cssom.length-q6 :as len])
  (:export [invalid mul-trunc mul-round resolve leading-ascent marker-advance option-height tab-stop]))

;; Line-height and font-metric arithmetic in Q6 / D4 fixed point (JUN-920 slice 2, census group G06; ADR-0287).
;; Mirrors layout.cljk resolve-line-height, inherited-line-height, glyph-advance, font-metrics, leading-ascent,
;; symbol-marker-advance, select-option-height and tab-runs (f64 oracle: cssom.line-height). Scalar i64 only, at most
;; five parameters per function, no heap.
;;
;; Scales. A font size or length is a Q6 raw (1/64 px). A multiplier is a D4 raw (1/10000, exact for a decimal with at most
;; four fraction digits; a percentage H hundredths-of-a-percent is the SAME integer as a D4 multiplier: 150% = 15000 = 1.5).
;; The census proposed a Q10 multiplier; Q10 is not exact for 0.1, so `0.1 * 10px` would come out below one pixel and the
;; `long` truncation would lose the pixel the exact decimal gives. D4 keeps every decimal the source can write with four
;; digits exact. Where layout.cljk applies `long` (truncation toward zero) the result is INTEGER PIXELS, not Q6.
;;   mul-trunc(m, fs) = quot(m * fs, 640000)         integer px, = (long (* m fs))      |m| <= 65535, |fs| <= 2^30
;;   mul-round(m, fs) = round-half-up(m * fs / 10000) Q6 raw of an unrounded product        (product < 2^46 by the guards)
;; Beyond the guards the result is (invalid) = -2^62; nothing is truncated silently.
(defn invalid [] :i64 -4611686018427387904)
(defn abs [x :i64] :i64 (if (< x 0) (- 0 x) x))
(defn mul-ok? [m :i64 fs :i64] :bool (and (<= (abs m) 65535) (<= (abs fs) 1073741824)))
(defn mul-trunc [m :i64 fs :i64] :i64 (if (mul-ok? m fs) (quot (* m fs) 640000) (invalid)))
(defn mul-round [m :i64 fs :i64] :i64
  (if (mul-ok? m fs) (let [r (len/rdiv (* m fs) 10000)] (if (len/in-range? r) r (invalid))) (invalid)))
(defn nonneg? [x :i64] :bool (and (>= x 0) (<= x 1073741824)))
(defn imax [a :i64 b :i64] :i64 (if (> a b) a b))
;; resolve-line-height: p0 = kind + 4 * has-theme + 8 * inherited-explicit
;;   kind 0 normal (absent, `normal`, unparseable), 1 a number (value = Q6 raw, `(long raw)`), 2 a multiplier (value = D4 raw)
;;   theme = the theme default in integer px (read when has-theme). Result: integer px.
(defn resolve [p0 :i64 value :i64 fs :i64 theme :i64] :i64
  (let [kind (bit-and p0 3) has-theme (bit-and (i64-shift-right p0 2) 1) inherited (bit-and (i64-shift-right p0 3) 1)
        natural (mul-trunc 12000 fs)
        base (if (= has-theme 1) theme 0)
        normal (if (= inherited 1) (if (= has-theme 1) theme natural) (imax base natural))]
    (cond (or (< p0 0) (> p0 15)) (invalid)
          (or (= natural (invalid)) (not (len/in-range? theme))) (invalid)
          (= kind 1) (if (len/in-range? value) (quot value 64) (invalid))
          (= kind 2) (mul-trunc value fs)
          :else normal)))
;; leading-ascent: ascent + floor((line-height - (ascent + descent)) / 2), integer px
(defn leading-ascent [ascent :i64 descent :i64 lh :i64] :i64
  (if (and (len/in-range? ascent) (and (len/in-range? descent) (len/in-range? lh)))
    (+ ascent (len/fdiv (- lh (+ ascent descent)) 2))
    (invalid)))
;; symbol-marker-advance: fs + ceil(2 * (fs + 2) / 7), fs in Q6, result Q6 (the ceil is a whole number of px)
(defn marker-advance [fs :i64] :i64
  (if (nonneg? fs)
    (let [c (- 0 (len/fdiv (- 0 (+ (* 2 fs) 256)) 448)) r (+ fs (* 64 c))]
      (if (len/in-range? r) r (invalid)))
    (invalid)))
;; select-option-height: 1.2 * fs + 1, Q6
(defn option-height [fs :i64] :i64
  (if (nonneg? fs) (let [r (+ (mul-round 12000 fs) 64)] (if (len/in-range? r) r (invalid))) (invalid)))
;; tab-runs: the next tab stop STRICTLY past pen, tab-w * (1 + floor(pen / tab-w)); Q6 both, tab-w >= 1 raw
(defn tab-stop [pen :i64 tab-w :i64] :i64
  (if (and (len/in-range? pen) (and (>= tab-w 1) (<= tab-w 1073741824)))
    (let [r (* tab-w (+ 1 (len/fdiv pen tab-w)))] (if (len/in-range? r) r (invalid)))
    (invalid)))
