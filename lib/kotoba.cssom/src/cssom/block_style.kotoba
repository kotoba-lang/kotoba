(ns cssom.block-style
  (:require [cssom.length :as length] [cssom.block-width :as width])
  (:export [solve])
  (:schemas {:css.block/style [:record :css.block/style
                               [[:containing :f64] [:width [:ref :css.length/input]]
                                [:min-width [:ref :css.length/input]] [:max-width [:ref :css.length/input]]
                                [:margin-left [:ref :css.length/input]] [:margin-right [:ref :css.length/input]]
                                [:padding-left [:ref :css.length/input]] [:padding-right [:ref :css.length/input]]
                                [:border-left :f64] [:border-right :f64] [:border-box :bool] [:rtl :bool]]]}))

;; Bridge resolved style lengths to the normal-flow solver. All percentages
;; here (including padding and margins) use the containing inline width.
;; No CSS parser, relative units, intrinsic values or indefinite basis yet.
(defn kind [r [:ref :css.length/result]] :keyword (record-get [:ref :css.length/result] r :kind))
(defn value [r [:ref :css.length/result]] :f64 (record-get [:ref :css.length/result] r :value))
(defn resolved? [r [:ref :css.length/result]] :bool (= (kind r) :length/resolved))
(defn invalid [] [:ref :css.block/result] (record [:ref :css.block/result] false 0.0 0.0 0.0 0.0))
(defn solve [style [:ref :css.block/style]] [:ref :css.block/result]
  (let [cb (record-get [:ref :css.block/style] style :containing)
        w (length/resolve (record-get [:ref :css.block/style] style :width) cb true false)
        min (length/resolve (record-get [:ref :css.block/style] style :min-width) cb true false)
        max (length/resolve (record-get [:ref :css.block/style] style :max-width) cb true false)
        ml (length/resolve (record-get [:ref :css.block/style] style :margin-left) cb true true)
        mr (length/resolve (record-get [:ref :css.block/style] style :margin-right) cb true true)
        pl (length/resolve (record-get [:ref :css.block/style] style :padding-left) cb true false)
        pr (length/resolve (record-get [:ref :css.block/style] style :padding-right) cb true false)]
    (if (not (and (or (resolved? w) (= (kind w) :length/auto)) (resolved? min)
                  (or (resolved? max) (= (kind max) :length/none))
                  (or (resolved? ml) (= (kind ml) :length/auto)) (or (resolved? mr) (= (kind mr) :length/auto))
                  (resolved? pl) (resolved? pr))) (invalid)
      (let [input (record [:ref :css.block/input] cb (value w) (= (kind w) :length/auto)
                          (record-get [:ref :css.block/style] style :border-box)
                          (value ml) (= (kind ml) :length/auto) (value mr) (= (kind mr) :length/auto)
                          (value pl) (value pr) (record-get [:ref :css.block/style] style :border-left)
                          (record-get [:ref :css.block/style] style :border-right) (record-get [:ref :css.block/style] style :rtl))]
        (width/solve-constrained input (value min) (value max) (resolved? max))))))
