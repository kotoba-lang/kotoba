(ns cssom.block-style-q6
  (:require [cssom.length-q6 :as len] [cssom.block-width-q6 :as width])
  (:export [invalid slot border-field p0-of pair solve-pick]))

;; Bridge from style lengths to the Q6 normal-flow solver; mirror of cssom.block-style `solve` (f64, the oracle).
;; All percentages (including padding and margins) resolve against the containing inline width.
;; Scalar i64 only, at most five parameters; the 13 inputs of the f64 record travel in five words:
;;   slot(unit, v) = unit * 2^28 + (v + 2^27)   one length, 31 bits. unit: 1 px, 2 percent (v = hundredths of a
;;        percent), 3 auto, 4 none, 0 and 5..7 are refused as invalid. v must lie in [-2^27, 2^27 - 1]
;;        (|px| < 2^21) and unit in 0..7, otherwise slot is 0 which resolves as invalid (a larger unit would overflow
;;        the 31-bit slot, and the host runtime traps on i64 overflow). This style-level range is narrower than
;;        the 2^30 solver range on purpose.
;;   p0 = clamp(containing, -1, 2^30 + 1) * 256 + sel * 4 + border-box * 2 + rtl     sel 1 content, 2 border, 3 ml, 4 mr
;;   p1 = slot(width) * 2^32 + slot(min-width)      p2 = slot(max-width) * 2^32 + slot(margin-left)
;;   p3 = slot(margin-right) * 2^32 + slot(padding-left)
;;   p4 = slot(padding-right) * 2^32 + border-field      border-field = border-left + border-right + 1 (0 = invalid)
;; Only the SUM of the two borders reaches the equation; border-field refuses a negative or > 2^30 term, which keeps
;; the per-term nonnegative guard of the f64 solver. Result: Q6 raw of the selected output, or (invalid) = -2^62.
(defn invalid [] :i64 -4611686018427387904)
(defn slot [unit :i64 v :i64] :i64
  (if (and (>= v -134217728) (<= v 134217727) (>= unit 0) (<= unit 7)) (+ (i64-shift-left unit 28) (+ v 134217728)) 0))
(defn border-field [bl :i64 br :i64] :i64
  (if (and (>= bl 0) (<= bl 1073741824) (>= br 0) (<= br 1073741824) (<= (+ bl br) 1073741824)) (+ (+ bl br) 1) 0))
(defn p0-of [cb :i64 sel :i64 border-box :i64 rtl :i64] :i64
  (+ (i64-shift-left (cond (> cb 1073741825) 1073741825 (< cb -1) -1 :else cb) 8) (+ (i64-shift-left sel 2) (+ (i64-shift-left border-box 1) rtl))))
(defn pair [hi :i64 lo :i64] :i64 (+ (i64-shift-left hi 32) lo))
(defn s-unit [s :i64] :i64 (i64-shift-right s 28))
(defn s-val [s :i64] :i64 (- (bit-and s 268435455) 134217728))
(defn kd [s :i64 cb :i64 flags :i64] :i64 (len/resolve-kind (s-unit s) (s-val s) cb flags))
(defn vl [s :i64 cb :i64 flags :i64] :i64 (len/resolve-value (s-unit s) (s-val s) cb flags))
(defn hi-slot [p :i64] :i64 (i64-shift-right p 32))
(defn lo-slot [p :i64] :i64 (bit-and p 4294967295))
(defn solve-pick [p0 :i64 p1 :i64 p2 :i64 p3 :i64 p4 :i64] :i64
  (let [cb (i64-shift-right p0 8) low (bit-and p0 255) rtl (bit-and low 1) bb (bit-and (i64-shift-right low 1) 1)
        sel (i64-shift-right low 2)
        w (hi-slot p1) mn (lo-slot p1) mx (hi-slot p2) ml (lo-slot p2)
        mr (hi-slot p3) pl (lo-slot p3) pr (hi-slot p4) b (lo-slot p4)
        kw (kd w cb 1) kmx (kd mx cb 1) kml (kd ml cb 3) kmr (kd mr cb 3)]
    (if (not (and (or (= kw 1) (= kw 2)) (= (kd mn cb 1) 1) (or (= kmx 1) (= kmx 3))
                  (or (= kml 1) (= kml 2)) (or (= kmr 1) (= kmr 2))
                  (= (kd pl cb 1) 1) (= (kd pr cb 1) 1) (> b 0)))
      (invalid)
      (width/solve-constrained-pick
        (+ (+ (i64-shift-left sel 6) (width/flags-of (if (= kw 2) 1 0) bb (if (= kml 2) 1 0) (if (= kmr 2) 1 0) rtl))
           (if (= kmx 1) 32 0))
        (width/pack cb (vl w cb 1))
        (width/pack (vl ml cb 3) (vl mr cb 3))
        (+ (+ (vl pl cb 1) (vl pr cb 1)) (- b 1))
        (width/pack (vl mn cb 1) (vl mx cb 1))))))
