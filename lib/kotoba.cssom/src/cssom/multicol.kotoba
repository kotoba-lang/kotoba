(ns cssom.multicol
  (:export [ncols col-w lay-w dx rule-x]))

;; f64 reference (native macOS) for the multi-column arithmetic of layout.cljk (census group G07, multicol part): a
;; transcription of multicol-spec (16385-16406) and of layout-multicol's `lay-w` (17023), `dx` (17065) and the rule x
;; (17094-17097). Lengths are Q6 RAW units carried as f64 (the source's px arithmetic is unit-free in these formulas except
;; for the whole-pixel steps, which are done here in px = raw / 64). ndecl 0 = auto; wdecl < 0 = auto.
;;   fit   (max 1 (long (Math/floor (/ (+ content-w gap) (double (+ w-decl gap))))))
;;   col-w (max 0 (/ (- content-w (* (dec n) gap)) (double n)))
;;   lay-w (long (Math/floor col-w))          dx (long (Math/round (* k (+ col-w gap))))
;;   rule  (long (Math/round (+ content-x (* k (+ col-w gap)) (- gap) (/ (- gap rule-w) 2.0))))
(defn floor-f [x :f64] :f64
  (let [t (i64-to-f64-rounded (f64-to-i64-truncating x))] (if (f64-lt x t) (f64-sub t 1.0) t)))
(defn fmax [a :f64 b :f64] :f64 (if (f64-gt a b) a b))
(defn rnd [x :f64] :f64 (floor-f (f64-add x 0.5)))
(defn ncols [cw :f64 gap :f64 ndecl :i64 wdecl :f64] :i64
  (let [fit-on (and (not (f64-lt wdecl 0.0)) (f64-gt (f64-add wdecl gap) 0.0))
        fit (if fit-on (f64-to-i64-truncating (fmax 1.0 (floor-f (f64-div (f64-add cw gap) (f64-add wdecl gap))))) 0)
        n (cond (and (> ndecl 0) fit-on) (if (< ndecl fit) ndecl fit) (> ndecl 0) ndecl fit-on fit :else 1)]
    (if (< n 1) 1 n)))
(defn col-w [cw :f64 gap :f64 n :i64] :f64
  (fmax 0.0 (f64-div (f64-sub cw (f64-mul (i64-to-f64-rounded (- n 1)) gap)) (i64-to-f64-rounded n))))
;; whole-pixel results, returned in raw units (px * 64)
(defn lay-w [cw :f64 gap :f64 n :i64] :f64
  (f64-mul 64.0 (floor-f (f64-div (col-w cw gap n) 64.0))))
(defn dx [cw :f64 gap :f64 n :i64 k :i64] :f64
  (f64-mul 64.0 (rnd (f64-div (f64-mul (i64-to-f64-rounded k) (f64-add (col-w cw gap n) gap)) 64.0))))
(defn rule-x [cw :f64 gap :f64 n :i64 k :i64 cx :f64 rw :f64] :f64
  (f64-mul 64.0 (rnd (f64-div (f64-add (f64-add cx (f64-mul (i64-to-f64-rounded k) (f64-add (col-w cw gap n) gap)))
                                       (f64-add (f64-sub 0.0 gap) (f64-div (f64-sub gap rw) 2.0))) 64.0))))
