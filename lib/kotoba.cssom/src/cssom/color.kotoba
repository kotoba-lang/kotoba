(ns cssom.color
  (:export [unit channel-number channel-percent alpha-number alpha-percent hsl-channel final-alpha]))

;; f64 reference (native macOS) for the colour arithmetic of lib/kotoba.domGpu/src/kotoba/wasm/host/color.cljk (census group
;; G04): a transcription of
;;   unit                 249:  (/ byte-0-255 255)
;;   parse-channel-token  295:  (clamp 0 255 (if pct? (* (/ n 100) 255) n)), then `unit`
;;   parse-alpha-token    302:  (clamp 0 1 (if pct? (/ n 100) n))      parse-percent-token 352: (clamp 0 1 (/ n 100))
;;   hsl->rgb             362-368 (CSS Color 4):  h' = (mod h 360); f(n): k = (mod (+ n (/ h' 30)) 12), a = (* s (min l (- 1 l))),
;;                        (- l (* a (max -1 (min (- k 3) (- 9 k) 1))))   with n = 0, 8, 4 for r, g, b
;;   ->rgba               442:  (* alpha own-a)
;; on doubles. The inputs are the f64 values of the decimal tokens: n and h as plain numbers (D4 raw / 10000.0), s and l as the
;; 0..1 fraction already clamped by parse-percent-token (the test builds them as clamp(n / 100)). `mod` is the floored modulo
;; of Clojure (sign of the divisor).
(defn floor-f [x :f64] :f64
  (let [t (i64-to-f64-rounded (f64-to-i64-truncating x))] (if (f64-lt x t) (f64-sub t 1.0) t)))
(defn fmod [x :f64 m :f64] :f64 (f64-sub x (f64-mul m (floor-f (f64-div x m)))))
(defn fmax [a :f64 b :f64] :f64 (if (f64-gt a b) a b))
(defn fmin [a :f64 b :f64] :f64 (if (f64-lt a b) a b))
(defn clamp [lo :f64 hi :f64 n :f64] :f64 (fmax lo (fmin hi n)))
(defn unit [b :f64] :f64 (f64-div b 255.0))
(defn channel-number [n :f64] :f64 (unit (clamp 0.0 255.0 n)))
(defn channel-percent [n :f64] :f64 (unit (clamp 0.0 255.0 (f64-mul (f64-div n 100.0) 255.0))))
(defn alpha-number [n :f64] :f64 (clamp 0.0 1.0 n))
(defn alpha-percent [n :f64] :f64 (clamp 0.0 1.0 (f64-div n 100.0)))
(defn hsl-channel [h :f64 s :f64 l :f64 which :i64] :f64
  (let [hh (fmod h 360.0)
        n (if (= which 0) 0.0 (if (= which 1) 8.0 4.0))
        k (fmod (f64-add n (f64-div hh 30.0)) 12.0)
        a (f64-mul s (fmin l (f64-sub 1.0 l)))]
    (f64-sub l (f64-mul a (fmax -1.0 (fmin (f64-sub k 3.0) (fmin (f64-sub 9.0 k) 1.0)))))))
(defn final-alpha [opacity :f64 own :f64] :f64 (f64-mul opacity own))
