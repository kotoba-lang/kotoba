(ns cssom.margin-collapse
  (:export [empty-state add finish])
  (:schemas {:cssom.margin/state [:record :cssom.margin/state
                                  [[:positive :f64] [:negative :f64] [:valid :bool]]]}))

;; Incremental form of cssom.layout/collapse-margins. Keep positive and
;; negative extrema separately: collapsing intermediate sums loses information
;; when three or more margins meet. Callers decide which margins adjoin.
(defn empty-state [] [:ref :cssom.margin/state]
  (record [:ref :cssom.margin/state] 0.0 0.0 true))
(defn finite? [value :f64] :bool
  (not= (bit-and (u64-shift-right (f64-to-bits value) 52) 2047) 2047))
(defn add [state [:ref :cssom.margin/state] value :f64] [:ref :cssom.margin/state]
  (let [positive (record-get [:ref :cssom.margin/state] state :positive)
        negative (record-get [:ref :cssom.margin/state] state :negative)
        valid (record-get [:ref :cssom.margin/state] state :valid)]
    (if (and valid (finite? value))
      (record [:ref :cssom.margin/state] (if (f64-gt value positive) value positive)
              (if (f64-lt value negative) value negative) true)
      (record [:ref :cssom.margin/state] positive negative false))))
(defn finish [state [:ref :cssom.margin/state]] [:option :f64]
  (if (record-get [:ref :cssom.margin/state] state :valid)
    (option-some-of [:option :f64]
      (f64-add (record-get [:ref :cssom.margin/state] state :positive)
               (record-get [:ref :cssom.margin/state] state :negative)))
    (option-none-of [:option :f64])))
