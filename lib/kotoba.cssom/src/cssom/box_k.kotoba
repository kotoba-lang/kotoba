(ns cssom.box-k (:require [cssom.intern-k :as ik] [cssom.length-q6 :as len] [cssom.block-style-q6 :as bs])
  (:export [bk-run]))
;; Layout slice, kernel dialect, pass 1: the computed styles of the style slice become one box record per element (ADR-0287,
;; JUN-920). Runs after cascade-k in the same owned window of 61440 bytes. Reads the node table (24576), the computed values
;; (40960: u16 string id per node and property index), the property table (header @256 + 2 k) and the string table; it
;; overwrites pages that are dead once the cascade is done (the input stream, 0..16383, becomes the box table).
;; Box table: 128 bytes per element at 128 n, u32 word i at 128 n + 4 i, a Q6 raw (1/64 px) stored as two's complement.
;;   0 kind (0 no box: display none or a non-rendered tag, 1 block box, 2 inside a box-less ancestor)   1 x   2 y   3 border-box width
;;   4 border-box height   5 content width   6 content height   7 margin-left   8 margin-right   9 margin-top   10 margin-bottom
;;   11 margin collapsed out of the top edge   12 margin collapsed out of the bottom edge   13..16 padding top right bottom left
;;   17..20 border top right bottom left   21 y relative to the content top of the parent   22 flags (1 flow-root, 2 height is
;;   definite, 4 top margin may collapse with the first child, 8 bottom margin may collapse with the last child)   23 border-box
;;   height from `height` (when flag 2)   24 definite content height handed to the children (-1 none)   25 content-x
;;   26..28 reserved   29 first child (n + 1, 0 none)  30 next sibling (n + 1)  31 last child (n + 1)
;; Header words (u32): 2 elements, 6 properties (cascade), 32 viewport width (Q6), 33 offending element + 1, 34 element being
;; closed (flow-k), 37 document height; u16 at 400 + 2 s: property index + 1 of supported slot s (0 absent), u8 at 448 + k: 1 when
;; property k is a name the slice refuses; u32 at 4 (40 + s): the length slot of supported slot s while an element is read.
;; Property names are the 18 supported slots, then names refused when present on a box, then tags: the table nt (generated by
;; scripts/check-layout-k-native-macos.py, which regenerates it and compares) holds, for table index i, at 4 i the byte length and at
;; 4 i + 1..3 the three little-endian 7-byte words of the name (0 past the end). Index 0..17 slot, 18..44 refused, 45..79 inline-level
;; tag (core.cljk inline-level-tags), 80..86 non-rendered tag (non-rendered-tags).
;; Status (negative) of bk-run: -14 display value or inline-level tag outside the slice, -15 a property the slice refuses is present,
;; -16 a value outside the grammar, -17 a length out of range or negative where forbidden, -18 a result outside +-2^30 Q6 raw.
;; Not modelled, so not claimed: UA tag margins and paddings (layout.cljk ua-tag-box: a `p` has margin 0 here), min-height and
;; max-height (refused), border-style (refused, the border width longhand is the used width), shorthands (refused), text,
;; floats, positioning, scroll containers, the document root's own formatting context (as layout-block, the root is not special).
(defn- hd [st i] (kernel-load-u32-4k (kernel-subregion st 61440 49152 4096) 4096 (* 4 i)))
(defn- hd! [st i v] (kernel-store-u32-4k (kernel-subregion st 61440 49152 4096) 4096 (* 4 i) v))
(defn- h16 [st at] (kernel-load-u16-4k (kernel-subregion st 61440 49152 4096) 4096 at))
(defn- h16! [st at v] (kernel-store-u16-4k (kernel-subregion st 61440 49152 4096) 4096 at v))
(defn- h8 [st at] (kernel-load-u8-4k (kernel-subregion st 61440 49152 4096) 4096 at))
(defn- h8! [st at v] (kernel-store-u8-4k (kernel-subregion st 61440 49152 4096) 4096 at v))
(defn- nd [st n at] (kernel-load-u16-4k (kernel-subregion st 61440 24576 4096) 4096 (+ (* 32 n) at)))
(defn- cv [st n k] (kernel-load-u16-4k (kernel-subregion st 61440 40960 4096) 4096 (+ (* 32 n) (* 2 k))))
(defn- sx [x] (if (>= x 2147483648) (- x 4294967296) x))
(defn- bx [st n i] (sx (kernel-load-u32-16k (kernel-subregion st 61440 0 16384) 16384 (+ (* 128 n) (* 4 i)))))
;; no u32 store exists on the 16 KiB tier of kernel-v1 (E2101 'kernel-store-u32-16k'): two u16 stores
(defn- bx! [st n i v]
  (let [o (+ (* 128 n) (* 4 i))
        a (kernel-store-u16-16k (kernel-subregion st 61440 0 16384) 16384 o (bit-and v 65535))
        b (kernel-store-u16-16k (kernel-subregion st 61440 0 16384) 16384 (+ o 2) (bit-and (u64-shift-right (bit-and v 4294967295) 16) 65535))]
    (* 0 (+ a b))))
(defn- big? [x] (or (> x 1073741824) (< x -1073741824)))
(defn- mx0 [x] (if (< x 0) 0 x))
(defn- kbit [m j] (bit-and (u64-shift-right m j) 1))

;; ---- generated name table ----
(defn- nt [x :i64] :i64 (case x 0 7 1 34165590552963428 4 5 5 448629336439 8 6 9 127991760381288 12 9 13 28263458255300973 14 26740 16 9 17 28263458255954285 18 26740 20 10 21 34455890563723106 22 6778473 24 10 25 12787772938150253 26 7368564 28 12 29 12787772938150253 30 499967814002 32 13 33 12787772938150253 34 120325462585186 36 11 37 12787772938150253 38 1952867692 40 11 41 29113321536119152 42 1886352429 44 13 45 29113321536119152 46 127991760384557 48 14 49 29113321536119152 50 30803318421807661 52 12 53 29113321536119152 54 499934129197 56 16 57 12792153754464098 58 28263458255433588 59 26740 60 18 61 12792153754464098 62 33545500219631986 63 1752458345 64 19 65 12792153754464098 66 12786699414564706 67 448629336439 68 17 69 12792153754464098 70 29685909664720236 71 6845540 72 6 73 121398986170733 76 7 77 29113321536119152 80 6 81 125779802484578 84 12 85 12792153754464098 86 448629336439 88 12 89 12792153754464098 90 435611595891 92 10 93 12792153754464098 94 7368564 96 12 97 12792153754464098 98 499967814002 100 13 101 12792153754464098 102 120325462585186 104 11 105 12792153754464098 106 1952867692 108 16 109 12792153754464098 110 34186510214393716 111 25964 112 18 113 12792153754464098 114 32419600312789362 115 1701607796 116 19 117 12792153754464098 118 12786699414564706 119 435611595891 120 17 121 12792153754464098 122 32777736362026348 123 6646905 124 5 125 499850898534 128 5 129 491260308579 132 8 133 31359671121178480 134 110 136 8 137 31362909676598895 138 119 140 10 141 31362909676598895 142 7875959 144 10 145 31362909676598895 146 7941495 148 12 149 12794344204432225 150 478510604658 152 7 153 32491038722256739 156 12 157 12787790352510819 158 500069396323 160 12 161 12787790352510819 162 448629336439 164 12 165 29113321804886647 166 435476720941 168 9 169 29682842807200100 170 28271 172 10 173 29666370667833709 174 7628903 176 10 177 29666370668487021 178 7628903 180 1 181 97 184 4 185 1919050337 188 1 189 98 192 3 193 6906978 196 3 197 7300194 200 2 201 29282 204 4 205 1702127971 208 4 209 1701080931 212 4 213 1635017060 216 3 217 7103844 220 3 221 7235172 224 2 225 28005 228 1 229 105 232 3 233 7564905 236 3 237 6578795 240 5 241 465557414252 244 4 245 1802658157 248 5 249 491328398701 252 6 253 128047746676079 256 8 257 32481164357759600 258 115 260 1 261 113 264 4 265 2036495730 268 2 269 29810 272 2 273 28786 276 1 277 115 280 4 281 1886216563 284 5 285 465674792307 288 4 289 1851879539 292 6 293 113724013835379 296 3 297 6452595 300 3 301 7370099 304 4 305 1701669236 308 1 309 117 312 3 313 7496054 316 3 317 7496311 320 4 321 1684104552 324 5 325 435611265396 328 6 329 128026154263411 332 5 333 435611595891 336 4 337 1635018093 340 4 341 1802398060 344 8 345 32758215669015924 346 101 0))
(defn- name-eq [st id fold i]
  (and (= (ik/ik-len st 61440 id) (nt (* 4 i)))
       (and (= (ik/ik-word st 61440 id 0 fold) (nt (+ (* 4 i) 1)))
            (and (= (ik/ik-word st 61440 id 1 fold) (nt (+ (* 4 i) 2)))
                 (= (ik/ik-word st 61440 id 2 fold) (nt (+ (* 4 i) 3)))))))
(defn- find-name [st id fold i]
  (if (>= i 87) -1 (if (name-eq st id fold i) i (find-name st id fold (+ i 1)))))

;; ---- supported slots and refused names, once per run ----
(defn- prep-prop [st k]
  (let [i (find-name st (h16 st (+ 256 (* 2 k))) 0 0)
        ref (if (and (>= i 18) (< i 45)) 1 0)]
    (if (and (>= i 0) (< i 18))
      (h16! st (+ 400 (* 2 i)) (+ k 1))
      (h8! st (+ 448 k) ref))))
(defn- prep-loop [st k np]
  (if (>= k np) 1
    (prep-loop st (+ k (+ 1 (* 0 (+ (h8! st (+ 448 k) 0) (prep-prop st k))))) np)))
(defn- clear-slots [st s]
  (if (>= s 18) 1 (clear-slots st (+ s (+ 1 (* 0 (h16! st (+ 400 (* 2 s)) 0)))))))
(defn- vid [st n s] (let [k (h16 st (+ 400 (* 2 s)))] (if (= k 0) 0 (cv st n (- k 1)))))

;; ---- the number scanner of parse_px_q6.kotoba, over the bytes of an interned string ----
(defn- pb [st id i] (ik/ik-byte st 61440 id i))
(defn- dg? [c] (and (>= c 48) (<= c 57)))
(defn- int-scan [st id i acc]
  (if (not (dg? (pb st id i))) (+ (* i 1099511627776) acc)
    (if (>= acc 16777216) -1 (int-scan st id (+ i 1) (+ (* acc 10) (- (pb st id i) 48))))))
(defn- frac-end [st id i] (if (dg? (pb st id i)) (frac-end st id (+ i 1)) i))
(defn- frac-num [st id i k acc]
  (if (= k 6) acc
    (if (dg? (pb st id i)) (frac-num st id (+ i 1) (+ k 1) (+ (* acc 10) (- (pb st id i) 48)))
      (frac-num st id i (+ k 1) (* acc 10)))))
(defn- lower [c] (if (and (>= c 65) (<= c 90)) (+ c 32) c))
(defn- sign-len [st id] (if (or (= (pb st id 0) 45) (= (pb st id 0) 43)) 1 0))
(defn- num-end [st id]
  (let [ip (int-scan st id (sign-len st id) 0)]
    (if (< ip 0) -1
      (let [i (quot ip 1099511627776)
            has-int (> i (sign-len st id))
            dot (= (pb st id i) 46)
            j (if dot (frac-end st id (+ i 1)) i)
            has-frac (and dot (> j (+ i 1)))]
        (if (or has-int has-frac) j -1)))))
(defn- grammar-unit [st id]
  (let [j (num-end st id) n (ik/ik-len st 61440 id)]
    (cond (< j 0) -1
          (= j n) 0
          (and (= (pb st id j) 37) (= (+ j 1) n)) 2
          (and (= (lower (pb st id j)) 112) (and (= (lower (pb st id (+ j 1))) 120) (= (+ j 2) n))) 1
          :else -1)))
(defn- parse-value [st id]
  (let [u (grammar-unit st id)]
    (if (< u 0) (len/invalid)
      (let [neg (= (pb st id 0) 45)
            ip (int-scan st id (sign-len st id) 0)
            acc (bit-and ip 1099511627775)
            i (quot ip 1099511627776)
            fnum (if (= (pb st id i) 46) (frac-num st id (+ i 1) 0 0) 0)
            mag (+ (* acc 1000000) fnum)
            nn (if neg (- 0 mag) mag)
            r (if (= u 2) (len/rdiv (* nn 100) 1000000) (len/rdiv (* nn 64) 1000000))]
        (if (= u 2)
          (if (and (>= r -65535) (<= r 65535)) r (len/invalid))
          (if (len/in-range? r) r (len/invalid)))))))

;; one length value as a block-style slot (unit px 1, percent 2, auto 3, none 4), or -16 outside the grammar / the allowed units
;; (mask bit u), or -17 out of range. A unitless number is read as px (layout.cljk parse-int does the same).
(defn- plen [st id mask]
  (let [n (ik/ik-len st 61440 id) w0 (ik/ik-word st 61440 id 0 1)]
    (cond (and (= n 4) (= w0 1869903201)) (if (= (kbit mask 3) 1) (bs/slot 3 0) -16)
          (and (= n 4) (= w0 1701736302)) (if (= (kbit mask 4) 1) (bs/slot 4 0) -16)
          :else (let [u (grammar-unit st id)]
                  (if (< u 0) -16
                    (let [unit (if (= u 0) 1 u) v (parse-value st id)]
                      (cond (= (kbit mask unit) 0) -16
                            (= v (len/invalid)) -17
                            :else (let [s (bs/slot unit v)] (if (= s 0) -17 s)))))))))
(defn- smask [s] (case s 1 14 2 14 3 6 4 22 6 14 7 14 8 14 9 14 14 2 15 2 16 2 17 2 6))
(defn- sdef [s] (case s 1 939524096 2 939524096 4 1207959552 402653184))
(defn- slot-of [st n s]
  (let [v (vid st n s)] (if (= v 0) (sdef s) (plen st v (smask s)))))
(defn- slots-loop [st n s]
  (if (> s 17) 1
    (if (= s 5) (slots-loop st n 6)
      (let [x (slot-of st n s)]
        (if (< x 0) x (slots-loop st n (+ s (+ 1 (* 0 (hd! st (+ 40 s) x))))))))))
(defn- su [x] (i64-shift-right x 28))
(defn- sv [x] (- (bit-and x 268435455) 134217728))

;; ---- display and tags ----
(defn- word-is [st id n w0 w1] (and (= (ik/ik-len st 61440 id) n) (and (= (ik/ik-word st 61440 id 0 1) w0) (= (ik/ik-word st 61440 id 1 1) w1))))
;; 0 no box, 1 block, 3 flow-root, -14 outside the slice
(defn- display-kind [st n]
  (let [dv (vid st n 0)]
    (if (= dv 0)
      (let [c (find-name st (nd st n 0) 1 45)]
        (if (and (>= c 80) (< c 87)) 0 (if (and (>= c 45) (< c 80)) -14 1)))
      (if (word-is st dv 4 1701736302 0) 0
        (if (word-is st dv 5 461229747298 0) 1
          (if (word-is st dv 9 31369262017768550 29807) 3 -14))))))
(defn- refused-loop [st n k np]
  (if (>= k np) 0
    (if (and (= (h8 st (+ 448 k)) 1) (> (cv st n k) 0)) -15 (refused-loop st n (+ k 1) np))))
;; 0 content-box, 1 border-box, -16
(defn- sizing [st n]
  (let [v (vid st n 5)]
    (if (= v 0) 0
      (if (word-is st v 10 12792153754464098 7892834) 1
        (if (word-is st v 11 32772479322582883 2020565549) 0 -16)))))

;; ---- one block box ----
;; vertical padding / margin of slot s against the containing width cb
(defn- vkind [st s cb flags] (len/resolve-kind (su (hd st (+ 40 s))) (sv (hd st (+ 40 s))) cb flags))
(defn- vval [st s cb flags] (len/resolve-value (su (hd st (+ 40 s))) (sv (hd st (+ 40 s))) cb flags))
(defn- vertical-ok [st cb]
  (and (= (vkind st 10 cb 1) 1) (and (= (vkind st 12 cb 1) 1)
       (and (or (= (vkind st 6 cb 3) 1) (= (vkind st 6 cb 3) 2)) (or (= (vkind st 8 cb 3) 1) (= (vkind st 8 cb 3) 2))))))
(defn- solve [st sel cb bb]
  (bs/solve-pick (bs/p0-of cb sel bb 0)
                 (bs/pair (hd st 41) (hd st 43))
                 (bs/pair (hd st 44) (hd st 49))
                 (bs/pair (hd st 47) (hd st 53))
                 (bs/pair (hd st 51) (bs/border-field (sv (hd st 55)) (sv (hd st 57))))))
(defn- put-box [st n cb]
  (let [pt (vval st 10 cb 1) pb2 (vval st 12 cb 1) pl (vval st 13 cb 1) pr (vval st 11 cb 1)
        bt (sv (hd st 54)) br (sv (hd st 55)) bb (sv (hd st 56)) bl (sv (hd st 57))
        z1 (bx! st n 13 pt) z2 (bx! st n 14 pr) z3 (bx! st n 15 pb2) z4 (bx! st n 16 pl)
        z5 (bx! st n 17 bt) z6 (bx! st n 18 br) z7 (bx! st n 19 bb) z8 (bx! st n 20 bl)
        z9 (bx! st n 9 (vval st 6 cb 3)) z10 (bx! st n 10 (vval st 8 cb 3))]
    (+ 1 (* 0 (+ z1 (+ z2 (+ z3 (+ z4 (+ z5 (+ z6 (+ z7 (+ z8 (+ z9 z10)))))))))))))
(defn- height-of [st n cb dh bb]
  (let [s (hd st 42) u (su s)
        raw (if (= u 1) (sv s) (if (= u 2) (len/percent-of (sv s) dh) 0))
        ext (+ (+ (bx st n 13) (bx st n 15)) (+ (bx st n 17) (bx st n 19)))
        eb (if (= bb 1) raw (+ raw ext))]
    (if (= u 3) -1 (if (and (= u 2) (< dh 0)) -1 (if (< raw 0) -2 (if (big? eb) -3 eb))))))
(defn- put-height [st n eh]
  (let [pt (bx st n 13) pb2 (bx st n 15) bt (bx st n 17) bbm (bx st n 19)
        flow (bit-and (bx st n 22) 1)
        fcfree (if (and (= flow 0) (= (+ bt bbm) 0)) 1 0)
        has (if (>= eh 0) 1 0)
        ct (if (and (= fcfree 1) (= (+ pt bt) 0)) 4 0)
        cb2 (if (and (= fcfree 1) (and (= (+ pb2 bbm) 0) (= has 0))) 8 0)
        dch (if (= has 1) (mx0 (- eh (+ (+ pt bt) (+ pb2 bbm)))) -1)
        ehv (if (= has 1) eh 0)
        z1 (bx! st n 22 (+ flow (+ (* 2 has) (+ ct cb2))))
        z2 (bx! st n 23 ehv)
        z3 (bx! st n 24 dch)]
    (+ 1 (* 0 (+ z1 (+ z2 z3))))))
(defn- box-fixed [st n cb dh]
  (let [bb (sizing st n)]
    (if (< bb 0) bb
      (let [x (slots-loop st n 1)]
        (if (< x 0) x
          (if (not (and (vertical-ok st cb) (and (>= (sv (hd st 54)) 0) (and (>= (sv (hd st 55)) 0) (and (>= (sv (hd st 56)) 0) (>= (sv (hd st 57)) 0))))))
            -17
            (let [c (solve st 1 cb bb) l (solve st 3 cb bb) r (solve st 4 cb bb)]
              (if (or (= c (bs/invalid)) (or (= l (bs/invalid)) (= r (bs/invalid)))) -17
                (let [z (put-box st n cb)
                      ext (+ (+ (bx st n 14) (bx st n 16)) (+ (bx st n 18) (bx st n 20)))
                      eh (height-of st n cb dh bb)]
                  (if (= eh -2) -17
                    (if (or (= eh -3) (big? (+ c ext))) -18
                      (+ z (* 0 (+ (bx! st n 5 c) (+ (bx! st n 3 (+ c ext))
                                  (+ (bx! st n 7 l) (+ (bx! st n 8 r) (put-height st n eh))))))))))))))))))

;; ---- the run ----
(defn- init-rec [st n i] (if (>= i 32) 1 (init-rec st n (+ i (+ 1 (* 0 (bx! st n i 0)))))))
(defn- link [st n p]
  (if (= p 65535) 1
    (let [lc (bx st p 31)]
      (+ 1 (* 0 (+ (if (= lc 0) (bx! st p 29 (+ n 1)) (bx! st (- lc 1) 30 (+ n 1))) (bx! st p 31 (+ n 1))))))))
(defn- res-node [st n vw]
  (let [p (nd st n 4)
        z (init-rec st n 0)
        l (link st n p)]
    (if (and (< p 65535) (not (= (bx st p 0) 1)))
      (+ 1 (* 0 (+ z (+ l (bx! st n 0 2)))))
      (let [dk (display-kind st n)]
        (if (< dk 0) dk
          (if (= dk 0) (+ 1 (* 0 (+ z l)))
            (let [r (refused-loop st n 0 (hd st 6))]
              (if (< r 0) r
                (let [cb (if (= p 65535) vw (bx st p 5))
                      dh (if (= p 65535) -1 (bx st p 24))
                      zk (bx! st n 0 1)
                      fl (if (= dk 3) 1 0)
                      zf (bx! st n 22 fl)
                      q (box-fixed st n cb dh)]
                  (+ q (* 0 (+ zk zf))))))))))))
(defn- nodes-loop [st n nn vw]
  (if (>= n nn) nn
    (let [r (res-node st n vw)]
      (if (< r 0) (+ r (* 0 (hd! st 33 (+ n 1))))
        (nodes-loop st (+ n 1) nn vw)))))
(defn bk-run [w length vw]
  (if (< length 61440) -1
    (if (or (< vw 0) (> vw 1073741824)) -19
      (let [st (kernel-subregion w length 0 61440)
            a (clear-slots st 0)
            b (prep-loop st 0 (+ (hd st 6) (* 0 a)))]
        (nodes-loop st 0 (hd st 2) (+ vw (* 0 b)))))))
