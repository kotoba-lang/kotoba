(ns cssom.parse-px-q6
  (:require [cssom.length-q6 :as len])
  (:export [parse-unit parse-value]))

;; Q6 CSS number scanner (JUN-920 / C2b). HOST-NATIVE ONLY: it reads a string with string-length and
;; string-code-point-at, which x86_64-aiueos-user/kernel targets refuse (E7101 detail 16). The AIUEOS entry
;; point reads the 64-byte request words instead (census prototype px_parse_q6_user); that is not part of
;; this slice. Everything after the byte reads is scalar i64 and uses only the shared Q6 helpers.
;;
;; Grammar: [+-]? ( digits [ "." digits? ] | "." digits ) ( "px" | "%" )?   (px/PX/Px accepted, ASCII case-insensitive)
;; unit code: 0 unitless, 1 px, 2 percent, -1 when the text is not in the grammar (trailing characters, empty, no digit)
;; or its value is out of range (so a unit >= 0 always comes with a valid value).
;; value: px and unitless -> Q6 raw (1/64 px); percent -> hundredths of a percent H. Failure -> len/invalid.
;; At most 6 fraction digits are significant; further digits are consumed and TRUNCATED (not rounded),
;; so the result is exact for up to 6 fraction digits and truncates the decimal beyond that (documented).
;; Rounding: one exact rational division, round half up (see cssom.length-q6).
;; Guards: integer part < 2^24 while scanning; result |raw| <= 2^30 (px) or |H| <= 65535 (percent).
(defn byte-at [s :string i :i64] :i64 (if (< i (string-length s)) (string-code-point-at s i) 0))
(defn digit? [c :i64] :bool (and (>= c 48) (<= c 57)))
;; integer digits from i: returns end*2^40 + acc, or -1 on overflow of the 2^24 guard
(defn int-scan [s :string i :i64 acc :i64] :i64
  (cond (not (digit? (byte-at s i))) (+ (* i 1099511627776) acc)
        (>= acc 16777216) -1
        :else (int-scan s (+ i 1) (+ (* acc 10) (- (byte-at s i) 48)))))
;; index after the fraction digits starting at i
(defn frac-end [s :string i :i64] :i64 (if (digit? (byte-at s i)) (frac-end s (+ i 1)) i))
;; numerator of the first (up to 6) fraction digits starting at i, padded on the right with zeros to 6 digits
(defn frac-num [s :string i :i64 k :i64 acc :i64] :i64
  (cond (= k 6) acc
        (digit? (byte-at s i)) (frac-num s (+ i 1) (+ k 1) (+ (* acc 10) (- (byte-at s i) 48)))
        :else (frac-num s i (+ k 1) (* acc 10))))
(defn lower [c :i64] :i64 (if (and (>= c 65) (<= c 90)) (+ c 32) c))
(defn sign-len [s :string] :i64 (if (or (= (byte-at s 0) 45) (= (byte-at s 0) 43)) 1 0))
(defn int-start [s :string] :i64 (sign-len s))
;; index just after the number (digits, optional fraction), or -1 when no digit at all / int overflow
(defn num-end [s :string] :i64
  (let [ip (int-scan s (int-start s) 0)]
    (if (< ip 0) -1
      (let [i (quot ip 1099511627776)
            has-int (> i (int-start s))
            dot (= (byte-at s i) 46)
            j (if dot (frac-end s (+ i 1)) i)
            has-frac (and dot (> j (+ i 1)))]
        (if (or has-int has-frac) j -1)))))
(defn grammar-unit [s :string] :i64
  (let [j (num-end s) n (string-length s)]
    (cond (< j 0) -1
          (= j n) 0
          (and (= (byte-at s j) 37) (= (+ j 1) n)) 2
          (and (= (lower (byte-at s j)) 112) (= (lower (byte-at s (+ j 1))) 120) (= (+ j 2) n)) 1
          :else -1)))
(defn parse-value [s :string] :i64
  (let [u (grammar-unit s)]
    (if (< u 0) (len/invalid)
      (let [neg (= (byte-at s 0) 45)
            ip (int-scan s (int-start s) 0)
            acc (bit-and ip 1099511627775)
            i (quot ip 1099511627776)
            dot (= (byte-at s i) 46)
            fnum (if dot (frac-num s (+ i 1) 0 0) 0)
            ;; exact rational (acc*10^6 + fnum) / 10^6, signed
            mag (+ (* acc 1000000) fnum)
            n (if neg (- 0 mag) mag)
            r (if (= u 2) (len/rdiv (* n 100) 1000000) (len/rdiv (* n 64) 1000000))]
        (if (= u 2)
          (if (and (>= r -65535) (<= r 65535)) r (len/invalid))
          (if (len/in-range? r) r (len/invalid)))))))
(defn parse-unit [s :string] :i64
  (if (= (parse-value s) (len/invalid)) -1 (grammar-unit s)))
