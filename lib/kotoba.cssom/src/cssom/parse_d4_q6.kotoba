(ns cssom.parse-d4-q6
  (:require [cssom.length-q6 :as len] [cssom.style-num-q6 :as sn])
  (:export [parse-d4 parse-opacity]))

;; HOST-NATIVE ONLY number scanners for the D4 style numbers (JUN-920 slice 3, census group G11). They read a string with
;; string-length and string-code-point-at, which the aiueos user / kernel targets refuse (E7101 detail 16), like
;; cssom.parse-px-q6. Mirrors `(parse-dbl text fallback)` of layout.cljk (370) for the opacity and flex-factor values.
;;
;; STACKING SEMANTICS. The source tests the f64 opacity `< 1.0`, so 0.999999 creates a stacking context and 1 does not. D4 would
;; round 0.999999 to 10000. parse-opacity therefore never rounds a value below 1 up to 10000: a decimal below 1 whose D4 would
;; be 10000 is 9999 (alpha 0.9999 instead of 0.999999, below 1/2000 of an 8-bit step), so stacking? still says true.
;; Grammar: [+-]? ( digits [ "." digits? ] | "." digits ), the whole string (the caller trims, as the source does). Java's
;; Double/parseDouble also accepts an exponent, an f/d suffix, NaN, Infinity and hex floats; those answer (invalid) here and
;; the caller falls back to the default, a documented DIFFERENCE. At most six fraction digits are significant (further digits
;; are truncated, as in parse-px-q6); the integer part must be below 2^20. Result: D4 raw, round half up.
(defn byte-at [s :string i :i64] :i64 (if (< i (string-length s)) (string-code-point-at s i) 0))
(defn digit? [c :i64] :bool (and (>= c 48) (<= c 57)))
(defn int-end [s :string i :i64] :i64 (if (digit? (byte-at s i)) (int-end s (+ i 1)) i))
(defn int-val [s :string i :i64 e :i64 acc :i64] :i64
  (cond (>= i e) acc (>= acc 1048576) -1 :else (int-val s (+ i 1) e (+ (* acc 10) (- (byte-at s i) 48)))))
(defn frac-num [s :string i :i64 k :i64 acc :i64] :i64
  (cond (= k 6) acc (digit? (byte-at s i)) (frac-num s (+ i 1) (+ k 1) (+ (* acc 10) (- (byte-at s i) 48)))
        :else (frac-num s i (+ k 1) (* acc 10))))
(defn sign-len [s :string] :i64 (if (or (= (byte-at s 0) 45) (= (byte-at s 0) 43)) 1 0))
;; the exact 6-digit fixed point of the number in s (sign not applied), or -1 (not in the grammar / too large)
(defn mag6 [s :string] :i64
  (let [a (sign-len s) ie (int-end s a) dot (= (byte-at s ie) 46)
        fe (if dot (int-end s (+ ie 1)) ie) n (string-length s)
        has-int (> ie a) has-frac (and dot (> fe (+ ie 1)))
        iv (int-val s a ie 0)]
    (cond (not (= fe n)) -1
          (not (or has-int has-frac)) -1
          (< iv 0) -1
          :else (+ (* iv 1000000) (if dot (frac-num s (+ ie 1) 0 0) 0)))))
(defn parse-d4 [s :string] :i64
  (let [m (mag6 s)]
    (if (< m 0) (sn/invalid)
      (let [r (len/rdiv (if (= (byte-at s 0) 45) (- 0 m) m) 100)]
        (if (and (>= r -1073741824) (<= r 1073741824)) r (sn/invalid))))))
;; opacity: parse, clamp 0..1, never round a value below 1 up to 1; (invalid) -> the caller uses the default 10000
(defn parse-opacity [s :string] :i64
  (let [m (mag6 s)]
    (cond (< m 0) (sn/invalid)
          (= (byte-at s 0) 45) 0
          :else (let [r (len/rdiv m 100)]
                  (if (and (>= r 10000) (< m 1000000)) 9999 (sn/opacity-clamp r))))))
