(ns cssom.style-num-q6
  (:require [cssom.length-q6 :as len])
  (:export [invalid opacity-clamp opacity-mul stacking? factor]))

;; Style numbers in D4 fixed point (JUN-920 slice 3, census group G11; ADR-0287): opacity and the flex factors. Mirrors
;; layout.cljk node-style :opacity (3302, `(max 0.0 (min 1.0 (parse-dbl ... 1.0)))`), the cumulative `(* opacity (:opacity st))`
;; (12997, 18396), `stacking-context?` `(< (:opacity st) 1.0)` (3662), and :flex-grow / :flex-shrink (3326, 3327,
;; `(parse-dbl ... 0.0 / 1.0)`) (f64 oracle: cssom.style-num). Scalar i64 core, at most five parameters; the host-only
;; scanners parse-d4 / parse-opacity are in cssom.parse-d4-q6 (strings, like cssom.parse-px-q6).
;;
;; Scale: D4 raw (1/10000), exact for a decimal with at most four fraction digits; opacity 0..10000 (0..1), a factor
;; 0..65535 (0..6.5535, the flex module's range). The cumulative opacity product rounds once per level, round half up
;; (the doubles of the source do not round, so a chain of k levels can differ by k/2 raw of 1/10000).
;;   opacity-clamp(x)  = min(10000, max(0, x))                   x a D4 raw, |x| <= 2^30, else (invalid)
;;   opacity-mul(a, b) = round-half-up(a * b / 10000)            a, b in 0..10000
;;   stacking?(x)      = x < 10000
;;   factor(x)         = 0 for x <= 0 (a non-positive weight freezes an item in resolve-flexible-lengths, like 0), x for
;;                       0 < x <= 65535, (invalid) above (the flex word cannot carry it)
;; STACKING SEMANTICS and the number grammar: see cssom.parse-d4-q6 (the scanner decides what text becomes which D4 raw).
(defn invalid [] :i64 -4611686018427387904)
(defn opacity-clamp [x :i64] :i64
  (if (and (>= x -1073741824) (<= x 1073741824)) (if (< x 0) 0 (if (> x 10000) 10000 x)) (invalid)))
(defn opacity-mul [a :i64 b :i64] :i64
  (if (and (and (>= a 0) (<= a 10000)) (and (>= b 0) (<= b 10000))) (len/rdiv (* a b) 10000) (invalid)))
(defn stacking? [x :i64] :bool (< x 10000))
(defn factor [x :i64] :i64
  (if (and (>= x -1073741824) (<= x 1073741824)) (if (<= x 0) 0 (if (> x 65535) (invalid) x)) (invalid)))
