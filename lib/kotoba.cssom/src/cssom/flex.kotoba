(ns cssom.flex
  (:export [item solve place auto-place])
  (:schemas {:cssom.flex/item [:record :cssom.flex/item
                               [[:base :f64] [:grow :f64] [:shrink :f64] [:min :f64] [:max :f64]]]}))

;; f64 reference (native macOS) for the flex arithmetic of layout.cljk (census group G07, flex part): a literal
;; transcription of resolve-flexible-lengths (layout.cljk 9398-9514, CSS Flexbox 9.7), place-main-axis (5090-5220) and
;; place-main-axis-auto-margins (5307-5326), for a line of at most FOUR items (an absent item is base 0, factor 0, no clamp).
;; Every length is a number of Q6 RAW units carried as f64 (so the Q6 module and this reference see the same numbers; the
;; arithmetic is the source's own, on doubles); a factor is the correctly rounded f64 of the D4 decimal, raw / 10000.0.
;; The original .cljk could not be run on this machine (see the slice-2 evidence), so this transcription is validated by
;; the hand-derived cases of the docstring tables (test/native/q6_flex_vs_f64.kotoba, mode 0), not by running the .cljk.
;;
;; solve: the loop keeps `sizes` and `frozen` exactly as the source does, including the guard (initially the item count n)
;; and `settle` (numerically the identity). mx < 0 stands for a nil maximum, a minimum of 0 for a nil minimum
;; (`(or (nth mins i) 0)`).
(defn feq [a :f64 b :f64] :bool (not (or (f64-lt a b) (f64-gt a b))))
(defn pick [k :i64 a :f64 b :f64 c :f64 d :f64] :f64 (cond (= k 0) a (= k 1) b (= k 2) c :else d))
(defn fmax [a :f64 b :f64] :f64 (if (f64-gt a b) a b))
(defn wt [grow :bool g :f64 sh :f64 b :f64] :f64 (if grow g (f64-mul sh b)))
(defn clampf [v :f64 mn :f64 mx :f64] :f64
  (let [v1 (fmax mn v)] (if (f64-lt mx 0.0) v1 (if (f64-lt mx v1) mx v1))))
;; the proposed size of one item: frozen keeps its size, else max(0, base + remaining * (weight / total))
(defn propf [fr :bool s :f64 b :f64 w :f64 rem :f64 tw :f64] :f64
  (if fr s (fmax 0.0 (f64-add b (f64-mul rem (f64-div w tw))))))
(defn item [b :f64 g :f64 sh :f64 mn :f64 mx :f64] [:ref :cssom.flex/item]
  (record [:ref :cssom.flex/item] b g sh mn mx))
(defn ib [i [:ref :cssom.flex/item]] :f64 (record-get [:ref :cssom.flex/item] i :base))
(defn ig [i [:ref :cssom.flex/item]] :f64 (record-get [:ref :cssom.flex/item] i :grow))
(defn ish [i [:ref :cssom.flex/item]] :f64 (record-get [:ref :cssom.flex/item] i :shrink))
(defn imn [i [:ref :cssom.flex/item]] :f64 (record-get [:ref :cssom.flex/item] i :min))
(defn imx [i [:ref :cssom.flex/item]] :f64 (record-get [:ref :cssom.flex/item] i :max))
(defn solve [k :i64 n :i64 avail :f64 gaps :f64
             i0 [:ref :cssom.flex/item] i1 [:ref :cssom.flex/item] i2 [:ref :cssom.flex/item] i3 [:ref :cssom.flex/item]] :f64
  (let [b0 (ib i0) b1 (ib i1) b2 (ib i2) b3 (ib i3)
        mn0 (imn i0) mn1 (imn i1) mn2 (imn i2) mn3 (imn i3) mx0 (imx i0) mx1 (imx i1) mx2 (imx i2) mx3 (imx i3)
        grow (f64-gt avail (f64-add (f64-add (f64-add b0 b1) (f64-add b2 b3)) gaps))
        w0 (wt grow (ig i0) (ish i0) b0) w1 (wt grow (ig i1) (ish i1) b1)
        w2 (wt grow (ig i2) (ish i2) b2) w3 (wt grow (ig i3) (ish i3) b3)]
    (loop [s0 b0 s1 b1 s2 b2 s3 b3
           f0 (not (f64-gt w0 0.0)) f1 (not (f64-gt w1 0.0)) f2 (not (f64-gt w2 0.0)) f3 (not (f64-gt w3 0.0))
           guard n]
      (if (or (and f0 (and f1 (and f2 f3))) (< guard 0))
        (pick k s0 s1 s2 s3)
        (let [used (f64-add (f64-add (if f0 s0 b0) (if f1 s1 b1)) (f64-add (if f2 s2 b2) (if f3 s3 b3)))
              rem (f64-sub (f64-sub avail gaps) used)
              tw (f64-add (f64-add (if f0 0.0 w0) (if f1 0.0 w1)) (f64-add (if f2 0.0 w2) (if f3 0.0 w3)))
              p0 (propf f0 s0 b0 w0 rem tw) p1 (propf f1 s1 b1 w1 rem tw)
              p2 (propf f2 s2 b2 w2 rem tw) p3 (propf f3 s3 b3 w3 rem tw)
              c0 (clampf p0 mn0 mx0) c1 (clampf p1 mn1 mx1) c2 (clampf p2 mn2 mx2) c3 (clampf p3 mn3 mx3)]
          (if (and (feq c0 p0) (and (feq c1 p1) (and (feq c2 p2) (feq c3 p3))))
            (pick k c0 c1 c2 c3)
            (recur c0 c1 c2 c3
                   (or f0 (not (feq c0 p0))) (or f1 (not (feq c1 p1))) (or f2 (not (feq c2 p2))) (or f3 (not (feq c3 p3)))
                   (- guard 1))))))))

;; ---- place-main-axis, up to six items; the offset of item i ----
;; mode 0 start / unknown, 1 space-between, 2 center, 3 end, 4 space-around, 5 space-evenly; the center / end `free` is
;; clamped at zero only when safe. center uses the EXACT half of free (the source's `quot` truncates to whole pixels).
(defn sz [j :i64 s0 :f64 s1 :f64 s2 :f64 s3 :f64 s4 :f64 s5 :f64] :f64
  (cond (= j 0) s0 (= j 1) s1 (= j 2) s2 (= j 3) s3 (= j 4) s4 :else s5))
(defn sum-sizes [n :i64 s0 :f64 s1 :f64 s2 :f64 s3 :f64 s4 :f64 s5 :f64] :f64
  (loop [j 0 acc 0.0] (if (= j n) acc (recur (+ j 1) (f64-add acc (sz j s0 s1 s2 s3 s4 s5))))))
(defn place [mode :i64 safe :i64 container :f64 gap :f64 n :i64 i :i64
             s0 :f64 s1 :f64 s2 :f64 s3 :f64 s4 :f64 s5 :f64] :f64
  (let [total (f64-add (sum-sizes n s0 s1 s2 s3 s4 s5) (f64-mul gap (i64-to-f64-rounded (if (> n 1) (- n 1) 0))))
        free (f64-sub container total)
        freep (fmax 0.0 free)
        fs (if (= safe 1) freep free)
        nf (i64-to-f64-rounded n)
        step (cond (= mode 1) (f64-add gap (if (> n 1) (f64-div freep (i64-to-f64-rounded (- n 1))) 0.0))
                   (= mode 4) (f64-add gap (f64-div freep nf))
                   (= mode 5) (f64-add gap (f64-div freep (f64-add nf 1.0)))
                   :else gap)
        start (cond (= mode 2) (f64-div fs 2.0) (= mode 3) fs
                    (= mode 4) (f64-div (f64-div freep nf) 2.0)
                    (= mode 5) (f64-div freep (f64-add nf 1.0))
                    :else 0.0)]
    (loop [j 0 pos start]
      (if (= j i) pos (recur (+ j 1) (f64-add pos (f64-add (sz j s0 s1 s2 s3 s4 s5) step)))))))

;; ---- place-main-axis-auto-margins: bit j of leads / trails = item j has an auto margin on that side ----
(defn bit [m :i64 j :i64] :i64 (bit-and (i64-shift-right m j) 1)
)
(defn popcount6 [m :i64] :i64 (+ (+ (+ (bit m 0) (bit m 1)) (+ (bit m 2) (bit m 3))) (+ (bit m 4) (bit m 5))))
(defn auto-place [container :f64 gap :f64 n :i64 i :i64 leads :i64 trails :i64
                  s0 :f64 s1 :f64 s2 :f64 s3 :f64 s4 :f64 s5 :f64] :f64
  (let [total (f64-add (sum-sizes n s0 s1 s2 s3 s4 s5) (f64-mul gap (i64-to-f64-rounded (if (> n 1) (- n 1) 0))))
        msk (- (i64-shift-left 1 n) 1)
        nauto (+ (popcount6 (bit-and leads msk)) (popcount6 (bit-and trails msk)))
        share (if (> nauto 0) (f64-div (fmax 0.0 (f64-sub container total)) (i64-to-f64-rounded nauto)) 0.0)]
    (loop [j 0 pos 0.0]
      (let [p (f64-add pos (f64-mul (i64-to-f64-rounded (bit leads j)) share))]
        (if (= j i) p
          (recur (+ j 1) (f64-add (f64-add p (sz j s0 s1 s2 s3 s4 s5))
                                  (f64-add (f64-mul (i64-to-f64-rounded (bit trails j)) share) gap))))))))
