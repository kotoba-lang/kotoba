(ns cssom.length-q6
  (:export [invalid kind-invalid kind-resolved kind-auto kind-none kind-unresolved
            unit-px unit-percent unit-auto unit-none
            max-raw in-range? fdiv rdiv percent-of percent-of-int round-px
            resolve-kind resolve-value]))

;; Q6 fixed-point CSS lengths (JUN-920 / C2b, first vertical of the user-domain renderer, ADR-0287).
;; Scalar i64 in and out, at most five parameters per function, no strings, records or floats. Mirrors
;; cssom.length (f64) `resolve`; the f64 module stays the oracle (test/native/q6_length_vs_f64.kotoba).
;;
;; Scale: a px length is a Q6 raw integer, 1 unit = 1/64 px (the Blink LayoutUnit scale). A percentage is an
;; integer count of hundredths of a percent H (12.5% = 1250). Range guard (replaces the f64 `finite?` test):
;; |raw| <= 2^30 (= 2^24 px) and |H| <= 65535 (= 655.35%), so H * basis < 2^46 (basis <= 2^30), far below i64.
;;
;; Rounding rule (the Q6 specification; the owner must confirm it): every division is ONE exact rational
;; division rounded half up, i.e. floor(x + 1/2) (toward +infinity, also for negatives: -2.5 -> -2), the rule of
;; Java Math/round that layout.cljk percentage-of uses. It is exact: no float is involved, so an exact tie
;; rounds up. The f64 oracle is inexact at exact ties and is NOT copied.
;;
;; Failure is the sentinel (invalid) = -2^62, never a plausible zero.
(defn invalid [] :i64 -4611686018427387904)
(defn kind-invalid [] :i64 0)
(defn kind-resolved [] :i64 1)
(defn kind-auto [] :i64 2)
(defn kind-none [] :i64 3)
(defn kind-unresolved [] :i64 4)
(defn unit-px [] :i64 1)
(defn unit-percent [] :i64 2)
(defn unit-auto [] :i64 3)
(defn unit-none [] :i64 4)
(defn max-raw [] :i64 1073741824)
(defn in-range? [x :i64] :bool (and (>= x -1073741824) (<= x 1073741824)))
(defn nonneg? [x :i64] :bool (and (>= x 0) (<= x 1073741824)))
;; floor division by a positive divisor using only quot (rem/mod are refused by the user targets)
(defn fdiv [a :i64 b :i64] :i64
  (let [q (quot a b)] (if (and (< a 0) (not= (* q b) a)) (- q 1) q)))
;; round-half-up(n / d) for d > 0: floor((2n + d) / (2d))
(defn rdiv [n :i64 d :i64] :i64 (fdiv (+ (* 2 n) d) (* 2 d)))
;; H hundredths of a percent of a Q6 basis, as a Q6 raw (one rounding)
(defn percent-of [h :i64 basis :i64] :i64 (rdiv (* h basis) 10000))
;; same for an integer-px basis and integer-px result (layout.cljk percentage-of, `(long (Math/round ..))`)
(defn percent-of-int [h :i64 basis-px :i64] :i64 (rdiv (* h basis-px) 10000))
;; Q6 raw -> integer px, half up
(defn round-px [raw :i64] :i64 (rdiv raw 64))
(defn value-ok? [unit :i64 value :i64] :bool
  (if (= unit 2) (and (>= value -65535) (<= value 65535)) (in-range? value)))
;; flags: bit0 = the percentage basis is definite, bit1 = negative results are allowed (margins)
(defn resolve-kind [unit :i64 value :i64 basis :i64 flags :i64] :i64
  (let [definite (bit-and flags 1) negative (bit-and (i64-shift-right flags 1) 1)]
    (cond (not (and (value-ok? unit value) (nonneg? basis))) 0
          (= unit 3) 2
          (= unit 4) 3
          (not (or (= unit 1) (= unit 2))) 0
          (and (= negative 0) (< value 0)) 0
          (and (= unit 2) (= definite 0)) 4
          :else (if (in-range? (if (= unit 2) (percent-of value basis) value)) 1 0))))
(defn resolve-value [unit :i64 value :i64 basis :i64 flags :i64] :i64
  (if (= (resolve-kind unit value basis flags) 1)
    (if (= unit 2) (percent-of value basis) value)
    0))
