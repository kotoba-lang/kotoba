(ns cssom.multicol-q6
  (:require [cssom.length-q6 :as len])
  (:export [invalid ncols col-raw lay-w dx rule-x]))

;; Multi-column geometry in Q6 fixed point (JUN-920 slice 3, census group G07, the multicol part; ADR-0287). Mirrors
;; layout.cljk multicol-spec (column count and kept-fractional column width), layout-multicol's `lay-w`, the column pitch
;; `dx` and the rule position (f64 oracle: cssom.multicol). Scalar i64 only, at most five parameters, no heap.
;;
;; Not ported: multicol-balanced-height (a binary search over fragment lists), the `0.5` fragment-boundary tolerances (they
;; are comparisons, `y - 0.5 <= t` is `y - 32 <= t` in Q6, no arithmetic), column-gap / rule parsing (the host).
;;
;; Scale: lengths Q6 raw (1/64 px), 0 <= raw <= 2^24 (262144 px; a larger value answers (invalid)); gap 0..2^24; n 1..255.
;; Products are below 2^40. The source keeps the column width FRACTIONAL and rounds only where a whole pixel is asked for:
;;   ncols(cw, gap, ndecl, wdecl)  ndecl = 0 (auto) or the declared count; wdecl = -1 (auto) or the declared width
;;        fit = max(1, floor((cw + gap) / (wdecl + gap)))  when wdecl >= 0 and wdecl + gap > 0
;;        n = max(1, ndecl & fit: min; ndecl alone; fit alone; neither: 1)
;;   col-raw(cw, gap, n)    = max(0, cw - (n - 1) * gap) / n  as a Q6 raw, round half up (the kept fractional width)
;;   lay-w(cw, gap, n)      = floor(col-w) in WHOLE px, as a Q6 raw (a multiple of 64): the width handed to layout
;;   dx(cw, gap, n, k)      = round-half-up(k * (col-w + gap)) in whole px (Math/round), the x of column k, a multiple of 64
;;   rule-x(cw, gap, nk, cx, rw)  nk = n + 256 * k (the column asked for, 1..n-1); see below
;; The exact rational is computed first and rounded ONCE (the source multiplies the already-fractional width by k, which
;; the doubles do not round, so the exact rational is the same quantity).
(defn invalid [] :i64 -4611686018427387904)
(defn imax [a :i64 b :i64] :i64 (if (> a b) a b))
(defn imin [a :i64 b :i64] :i64 (if (< a b) a b))
(defn ok? [x :i64] :bool (and (>= x 0) (<= x 16777216)))
(defn ncols [cw :i64 gap :i64 ndecl :i64 wdecl :i64] :i64
  (if (and (and (ok? cw) (ok? gap)) (and (and (>= ndecl 0) (<= ndecl 255)) (and (>= wdecl -1) (<= wdecl 16777216))))
    (let [fit-on (and (>= wdecl 0) (> (+ wdecl gap) 0))
          fit (if fit-on (imax 1 (len/fdiv (+ cw gap) (+ wdecl gap))) 0)
          n (imax 1 (cond (and (> ndecl 0) fit-on) (imin ndecl fit) (> ndecl 0) ndecl fit-on fit :else 1))]
      (if (<= n 255) n (invalid)))
    (invalid)))
(defn num [cw :i64 gap :i64 n :i64] :i64 (imax 0 (- cw (* (- n 1) gap))))
(defn dom? [cw :i64 gap :i64 n :i64] :bool (and (and (ok? cw) (ok? gap)) (and (>= n 1) (<= n 255))))
(defn col-raw [cw :i64 gap :i64 n :i64] :i64
  (if (dom? cw gap n) (len/rdiv (num cw gap n) n) (invalid)))
(defn lay-w [cw :i64 gap :i64 n :i64] :i64
  (if (dom? cw gap n) (* 64 (len/fdiv (num cw gap n) (* 64 n))) (invalid)))
;; col-w + gap = (num + n * gap) / n  (raw);  column k starts at k * that
(defn dx [cw :i64 gap :i64 n :i64 k :i64] :i64
  (if (and (dom? cw gap n) (and (>= k 0) (< k n)))
    (* 64 (len/rdiv (* k (+ (num cw gap n) (* n gap))) (* 64 n)))
    (invalid)))
;; the rule of column k >= 1 is centred in the gap before it, in whole px:
;;   round-half-up(cx + k * (col-w + gap) - gap + (gap - rw) / 2),  cx = content-x (raw, |cx| <= 2^24), rw = rule-w (raw,
;;   0..2^24); exact numerator over 2n, one rounding: rdiv(2n (cx - gap) + 2k (num + n gap) + n (gap - rw), 128 n) whole px.
(defn rule-x [cw :i64 gap :i64 nk :i64 cx :i64 rw :i64] :i64
  (let [n (bit-and nk 255) k (i64-shift-right nk 8)]
    (if (and (and (dom? cw gap n) (and (>= k 1) (< k n))) (and (and (>= cx -16777216) (<= cx 16777216)) (ok? rw)))
      (* 64 (len/rdiv (+ (+ (* (* 2 n) (- cx gap)) (* (* 2 k) (+ (num cw gap n) (* n gap)))) (* n (- gap rw))) (* 128 n)))
      (invalid))))
