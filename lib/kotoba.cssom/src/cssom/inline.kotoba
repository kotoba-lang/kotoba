(ns cssom.inline
  (:export [shift-keyword middle-box leading-ascent middle-inherited]))

;; f64 reference (native macOS) for the inline vertical-align arithmetic of layout.cljk (census group G09): a transcription of
;;   vertical-align-shift  12468: "super" (+ (/ parent-fs 3.0) 1)     12469: "sub" (- (+ (/ parent-fs 5.0) 1))
;;   inline-fragments      12793: (+ (/ h 2) (/ parent-x-height 2))   13082: (+ (/ parent-x-height 2)
;;                                                                     (- (/ lh 2) (leading-ascent ascent descent lh)))
;;   leading-ascent        (long (Math/floor (+ ascent (/ (- lh (+ ascent descent)) 2))))   (layout.cljk 4917)
;; All lengths are Q6 RAW units carried as f64; whole-pixel quantities (ascent, descent, the leading-ascent) are in px.
(defn floor-f [x :f64] :f64
  (let [t (i64-to-f64-rounded (f64-to-i64-truncating x))] (if (f64-lt x t) (f64-sub t 1.0) t)))
(defn shift-keyword [kind :i64 fs :f64] :f64
  (cond (= kind 1) (f64-add (f64-div fs 3.0) 64.0)
        :else (f64-sub 0.0 (f64-add (f64-div fs 5.0) 64.0))))
(defn middle-box [h :f64 x :f64] :f64 (f64-add (f64-div h 2.0) (f64-div x 2.0)))
(defn leading-ascent [ascent :f64 descent :f64 lh :f64] :f64
  (floor-f (f64-add ascent (f64-div (f64-sub (f64-div lh 64.0) (f64-add ascent descent)) 2.0))))
(defn middle-inherited [x :f64 lh :f64 ascent :f64 descent :f64] :f64
  (f64-add (f64-div x 2.0) (f64-sub (f64-div lh 2.0) (f64-mul 64.0 (leading-ascent ascent descent lh)))))
