(ns cssom.grid-ref (:export [run]))
;; Host-native f64 reference (macOS, typed lists and doubles allowed) for the grid track sizing of layout.cljk (JUN-932 part 2, census
;; group G07): a transcription of track-sizes (layout.cljk 6043), distribute-fr (5939), distribute-equally-with-caps (5982),
;; fixed-contribution (5955), fr-weight (5969), grid-track-intrinsics (10133, single-track items) and span-width (6711), written from
;; the source and independently of the region module cssom.grid-k. The original .cljk cannot be run on this machine (see
;; evidence/cssom-q6-slice2-20261106), so the transcription is validated by the hand-derived cases of the gate.
;; Arithmetic is the source's own: lengths are whole-pixel longs (the Q6 raw words floored by 64 on entry, the `long` coercions of the
;; source), an fr weight is a double (the D4 word / 10000.0, the correctly rounded value of the decimal), and distribute-fr is
;; trunc(fl(fl(remaining * w) / total)) with total the left fold of the weights from 0 -- Clojure's `quot` on doubles.
;; Input: the case words as one document vector (the wire words of grid_k.kotoba); only cases the contract accepts are run (the
;; capacity refusals belong to the encoding of the region module, as in style_ref). Output: the hash of the n track sizes followed by
;; the m span widths, each as Q6 raw, H <- (257 H + v + 1) mod 2^32 from 5381.
(defn- wd [d :document i :i64] :i64
  (option-value-of [:option :i64] (document-i64-value (option-value-of [:option :document] (document-vector-at d i) (document-null))) 0))
(defn- px [raw :i64] :i64 (quot raw 64))
(defn- lget [l [:list :i64] i :i64] :i64 (typed-list-nth [:list :i64] l i))
(defn- lset [l [:list :i64] n :i64 i :i64 v :i64] [:list :i64]
  (loop [k 0 out (typed-list-new [:list :i64])]
    (if (>= k n) out (recur (+ k 1) (typed-list-conj [:list :i64] out (if (= k i) v (lget l k)))))))
(defn- lrep [n :i64 v :i64] [:list :i64]
  (loop [k 0 out (typed-list-new [:list :i64])] (if (>= k n) out (recur (+ k 1) (typed-list-conj [:list :i64] out v)))))
(defn- imax [a :i64 b :i64] :i64 (if (> a b) a b))
(defn- tt [d :document i :i64] :i64 (wd d (+ 8 (* 6 i))))
(defn- ta [d :document i :i64] :i64 (px (wd d (+ 9 (* 6 i)))))
(defn- tb [d :document i :i64] :i64 (px (wd d (+ 10 (* 6 i)))))
(defn- wf [raw :i64] :f64 (f64-div (i64-to-f64-rounded raw) 10000.0))

;; fixed-contribution
(defn- fcont [d :document i :i64] :i64
  (let [t (tt d i)] (cond (= t 0) (ta d i) (= t 2) (imax (ta d i) (tb d i)) (= t 3) (ta d i) :else 0)))
;; fr-weight as the D4 raw word, -1 for nil
(defn- frw [d :document i :i64] :i64
  (let [t (tt d i)] (cond (= t 1) (wd d (+ 9 (* 6 i))) (= t 3) (wd d (+ 10 (* 6 i))) :else -1)))

;; grid-track-intrinsics: the widest min / max content of the single-track items per track (or the track words), then
;; intrinsic-max = max(min, max)
(defn- item-b [n :i64 j :i64] :i64 (+ 8 (+ (* 6 n) (* 4 j))))
(defn- intrinsic [d :document n :i64 m :i64 which :i64 i :i64] :i64
  (let [derive (wd d 5)
        mn (if (= derive 1)
             (loop [j 0 acc 0]
               (if (>= j m) acc
                 (let [b (item-b n j) cs (wd d b) ce (wd d (+ b 1))]
                   (recur (+ j 1) (if (and (= (- ce cs) 1) (= cs i)) (imax acc (px (wd d (+ b 2)))) acc)))))
             (px (wd d (+ 11 (* 6 i)))))
        mx (if (= derive 1)
             (loop [j 0 acc 0]
               (if (>= j m) acc
                 (let [b (item-b n j) cs (wd d b) ce (wd d (+ b 1))]
                   (recur (+ j 1) (if (and (= (- ce cs) 1) (= cs i)) (imax acc (px (wd d (+ b 3)))) acc)))))
             (px (wd d (+ 12 (* 6 i)))))]
    (if (= which 0) mn (imax mn mx))))

;; distribute-equally-with-caps: sizes, the live indices (a list and its count), cap-of = the intrinsic max when `capped`, free
(defn- is-frozen? [cur :i64 want :i64 cap :i64 capped :i64] :bool (and (= capped 1) (>= want cap)))
(defn- pass-sizes [d :document n :i64 m :i64 sizes [:list :i64] live [:list :i64] nl :i64 share :i64 capped :i64] [:list :i64]
  (loop [k 0 s sizes]
    (if (>= k nl) s
      (let [i (lget live k) cur (lget s i) want (+ cur share) cap (intrinsic d n m 1 i)]
        (recur (+ k 1) (lset s n i (if (is-frozen? cur want cap capped) (imax cur cap) want)))))))
(defn- pass-unspent [d :document n :i64 m :i64 sizes [:list :i64] live [:list :i64] nl :i64 share :i64 capped :i64] :i64
  (loop [k 0 u 0]
    (if (>= k nl) u
      (let [i (lget live k) cur (lget sizes i) want (+ cur share) cap (intrinsic d n m 1 i)]
        (recur (+ k 1) (if (is-frozen? cur want cap capped) (+ u (- want (imax cur cap))) u))))))
(defn- pass-still [d :document n :i64 m :i64 sizes [:list :i64] live [:list :i64] nl :i64 share :i64 capped :i64] [:list :i64]
  (loop [k 0 out (typed-list-new [:list :i64])]
    (if (>= k nl) out
      (let [i (lget live k) cur (lget sizes i) want (+ cur share) cap (intrinsic d n m 1 i)]
        (recur (+ k 1) (if (is-frozen? cur want cap capped) out (typed-list-conj [:list :i64] out i)))))))
(defn- pass-nstill [d :document n :i64 m :i64 sizes [:list :i64] live [:list :i64] nl :i64 share :i64 capped :i64] :i64
  (loop [k 0 c 0]
    (if (>= k nl) c
      (let [i (lget live k) cur (lget sizes i) want (+ cur share) cap (intrinsic d n m 1 i)]
        (recur (+ k 1) (if (is-frozen? cur want cap capped) c (+ c 1)))))))
(defn- dewc [d :document n :i64 m :i64 sizes [:list :i64] live [:list :i64] nlive :i64 capped :i64 free :i64] [:list :i64]
  (loop [sz sizes lv live nl nlive fr free]
    (if (or (<= fr 0) (= nl 0)) sz
      (let [share (quot fr nl)]
        (if (<= share 0)
          (loop [k 0 s sz left fr]
            (if (>= k nl) s
              (let [i (lget lv k)]
                (if (> left 0)
                  (let [want (+ (lget s i) 1)]
                    (if (or (= capped 0) (<= want (intrinsic d n m 1 i)))
                      (recur (+ k 1) (lset s n i want) (- left 1))
                      (recur (+ k 1) s left)))
                  (recur (+ k 1) s left)))))
          (let [nsz (pass-sizes d n m sz lv nl share capped)
                unspent (pass-unspent d n m sz lv nl share capped)
                still (pass-still d n m sz lv nl share capped)]
            (recur nsz still (pass-nstill d n m sz lv nl share capped) (+ unspent (- fr (* share nl))))))))))

;; ---- track-sizes ----
(defn- lsum [l [:list :i64] n :i64] :i64 (loop [k 0 a 0] (if (>= k n) a (recur (+ k 1) (+ a (lget l k))))))
(defn- iota-auto [d :document n :i64] [:list :i64]
  (loop [i 0 out (typed-list-new [:list :i64])] (if (>= i n) out (recur (+ i 1) (if (= (tt d i) 4) (typed-list-conj [:list :i64] out i) out)))))
(defn- count-auto [d :document n :i64] :i64 (loop [i 0 c 0] (if (>= i n) c (recur (+ i 1) (if (= (tt d i) 4) (+ c 1) c)))))
(defn- any-fr? [d :document n :i64] :bool (loop [i 0 f false] (if (>= i n) f (recur (+ i 1) (or f (>= (frw d i) 0))))))
(defn- base-list [d :document n :i64 m :i64] [:list :i64]
  (loop [i 0 out (typed-list-new [:list :i64])]
    (if (>= i n) out (recur (+ i 1) (typed-list-conj [:list :i64] out (if (= (tt d i) 4) (intrinsic d n m 0 i) (fcont d i)))))))
(defn- ftotal [d :document n :i64 ar [:list :i64]] :i64
  (loop [i 0 a 0] (if (>= i n) a (recur (+ i 1) (+ a (if (= (tt d i) 4) (lget ar i) (fcont d i)))))))
;; the fr weights of the weighted tracks, in order; their count; the left fold total as a double
(defn- weights [d :document n :i64] [:list :i64]
  (loop [i 0 out (typed-list-new [:list :i64])] (if (>= i n) out (recur (+ i 1) (if (>= (frw d i) 0) (typed-list-conj [:list :i64] out (frw d i)) out)))))
(defn- wtotal [ws [:list :i64] k :i64] :f64
  (loop [i 0 a 0.0] (if (>= i k) a (recur (+ i 1) (f64-add a (wf (lget ws i)))))))
;; distribute-fr: trunc(fl(fl(remaining * w) / total)); the leftover goes to the last weighted track
(defn- fr-shares [rem :i64 ws [:list :i64] k :i64] [:list :i64]
  (let [total (wtotal ws k)]
    (if (or (<= rem 0) (not (f64-gt total 0.0))) (lrep k 0)
      (let [sizes (loop [i 0 out (typed-list-new [:list :i64])]
                    (if (>= i k) out
                      (recur (+ i 1) (typed-list-conj [:list :i64] out
                                       (f64-to-i64-truncating (f64-div (f64-mul (i64-to-f64-rounded rem) (wf (lget ws i))) total))))))
            left (- rem (lsum sizes k))]
        (if (and (> left 0) (> k 0)) (lset sizes k (- k 1) (+ (lget sizes (- k 1)) left)) sizes)))))
(defn- sizes-ref [d :document n :i64 m :i64] [:list :i64]
  (let [t (wd d 2) dfn (not (= t 4294967295)) tpx (px t) gapt (* (px (wd d 1)) (imax 0 (- n 1)))
        base (base-list d n m) autos (iota-auto d n) na (count-auto d n) hf (any-fr? d n)
        ar (if (and dfn (> na 0))
             (let [grown (dewc d n m base autos na 1 (- (- tpx (lsum base n)) gapt))]
               (if (or hf (= (wd d 3) 0)) grown (dewc d n m grown autos na 0 (- (- tpx (lsum grown n)) gapt))))
             base)
        rem (if dfn (imax 0 (- (- tpx (ftotal d n ar)) gapt)) 0)
        ws (weights d n) k (loop [i 0 c 0] (if (>= i n) c (recur (+ i 1) (if (>= (frw d i) 0) (+ c 1) c))))
        frs (fr-shares rem ws k)]
    (loop [i 0 kk 0 out (typed-list-new [:list :i64])]
      (if (>= i n) out
        (let [ty (tt d i)]
          (cond (= ty 4) (recur (+ i 1) kk (typed-list-conj [:list :i64] out (lget ar i)))
                (>= (frw d i) 0) (recur (+ i 1) (+ kk 1) (typed-list-conj [:list :i64] out (+ (if (= ty 3) (ta d i) 0) (lget frs kk))))
                :else (recur (+ i 1) kk (typed-list-conj [:list :i64] out (fcont d i)))))))))
(defn- hash-step [h :i64 v :i64] :i64 (bit-and (+ (* h 257) (+ 1 (* v 64))) 4294967295))
(defn run [d :document] :i64
  (let [n (wd d 0) m (wd d 4) gap (px (wd d 1))
        out (sizes-ref d n m)
        h1 (loop [i 0 h 5381] (if (>= i n) h (recur (+ i 1) (hash-step h (lget out i)))))]
    (loop [j 0 h h1]
      (if (>= j m) h
        (let [b (item-b n j) cs (wd d b) ce (wd d (+ b 1))
              span (+ (loop [k cs a 0] (if (>= k ce) a (recur (+ k 1) (+ a (lget out k))))) (* gap (imax 0 (- (- ce cs) 1))))]
          (recur (+ j 1) (hash-step h span)))))))
