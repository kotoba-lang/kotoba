(ns cssom.table-ref (:export [run]))
;; Host-native f64 reference (macOS, typed lists and doubles allowed) for the table column widths of layout.cljk (JUN-932 part 2,
;; census group G07): a transcription of table-column-widths (10554), table-fixed-column-widths (10437), distribute-excess (10386) and
;; the caption widening of layout-table (10838), written from the source and independently of the region module cssom.table-k.
;; The original .cljk cannot be run on this machine (see evidence/cssom-q6-slice2-20261106); the transcription is validated by the
;; hand-derived cases of the gate. Arithmetic is the source's: whole-pixel longs (the Q6 raw words floored by 64 on entry), and the
;; proportional steps in doubles -- the scale-down is (long (* w (/ content-w total))) with both operands converted to doubles (the
;; kotoba target has no ratios), distribute-excess is (long (* target (/ w (double total)))) as written.
;; Input: the case words as one document vector (the wire words of table_k.kotoba); only accepted cases are run. Output: the hash
;; of the column widths as Q6 raw, H <- (257 H + v + 1) mod 2^32 from 5381.
(defn- wd [d :document i :i64] :i64
  (option-value-of [:option :i64] (document-i64-value (option-value-of [:option :document] (document-vector-at d i) (document-null))) 0))
(defn- px [raw :i64] :i64 (quot raw 64))
(defn- lget [l [:list :i64] i :i64] :i64 (typed-list-nth [:list :i64] l i))
(defn- lset [l [:list :i64] n :i64 i :i64 v :i64] [:list :i64]
  (loop [k 0 out (typed-list-new [:list :i64])]
    (if (>= k n) out (recur (+ k 1) (typed-list-conj [:list :i64] out (if (= k i) v (lget l k)))))))
(defn- imax [a :i64 b :i64] :i64 (if (> a b) a b))
(defn- lsum [l [:list :i64] n :i64] :i64 (loop [k 0 a 0] (if (>= k n) a (recur (+ k 1) (+ a (lget l k))))))
(defn- fl [x :i64] :f64 (i64-to-f64-rounded x))
;; column records: -1 for nil
(defn- cwp [d :document k :i64] :i64 (if (< k (wd d 3)) (let [v (wd d (+ 8 (* 2 k)))] (if (= v 4294967295) -1 (px v))) -1))
(defn- dwp [d :document k :i64] :i64 (if (< k (wd d 3)) (let [v (wd d (+ 9 (* 2 k)))] (if (= v 4294967295) -1 (px v))) -1))
(defn- cb [d :document j :i64] :i64 (+ 8 (+ (* 2 (wd d 3)) (* 5 j))))
(defn- ccol [d :document j :i64] :i64 (wd d (cb d j)))
(defn- cspan [d :document j :i64] :i64 (wd d (+ (cb d j) 1)))
(defn- cnat [d :document j :i64] :i64 (px (wd d (+ (cb d j) 2))))
(defn- cdec [d :document j :i64] :i64 (let [v (wd d (+ (cb d j) 3))] (if (= v 4294967295) -1 (px v))))
(defn- crow0 [d :document j :i64] :i64 (wd d (+ (cb d j) 4)))

;; distribute-excess; locked? only in the automatic algorithm (a column a <col> or a cell declared)
(defn- locked? [d :document i :i64 lock :i64] :bool (and (= lock 1) (or (>= (cwp d i) 0) (>= (dwp d i) 0))))
(defn- free-total [d :document ws [:list :i64] n :i64 lock :i64] :i64
  (loop [i 0 a 0] (if (>= i n) a (recur (+ i 1) (if (locked? d i lock) a (+ a (lget ws i)))))))
(defn- free-count [d :document n :i64 lock :i64] :i64
  (loop [i 0 a 0] (if (>= i n) a (recur (+ i 1) (if (locked? d i lock) a (+ a 1))))))
(defn- last-free [d :document n :i64 lock :i64] :i64
  (loop [i 0 a -1] (if (>= i n) a (recur (+ i 1) (if (locked? d i lock) a i)))))
(defn- dist-excess [d :document ws [:list :i64] n :i64 target :i64 lock :i64] [:list :i64]
  (let [total (lsum ws n) ft (free-total d ws n lock) fc (free-count d n lock)]
    (cond
      (or (= n 0) (or (not (> total 0)) (<= target total))) ws
      (or (= fc 0) (not (> ft 0)))
      (let [grown (loop [i 0 out (typed-list-new [:list :i64])]
                    (if (>= i n) out
                      (recur (+ i 1) (typed-list-conj [:list :i64] out
                                       (f64-to-i64-truncating (f64-mul (fl target) (f64-div (fl (lget ws i)) (fl total))))))))
            short (- target (lsum grown n))]
        (lset grown n (- n 1) (+ (lget grown (- n 1)) short)))
      :else
      (let [ftarget (- target (- total ft))
            grown (loop [i 0 out (typed-list-new [:list :i64])]
                    (if (>= i n) out
                      (recur (+ i 1) (typed-list-conj [:list :i64] out
                                       (if (locked? d i lock) (lget ws i)
                                         (f64-to-i64-truncating (f64-mul (fl ftarget) (f64-div (fl (lget ws i)) (fl ft)))))))))
            short (- target (lsum grown n))
            lf (last-free d n lock)]
        (lset grown n lf (+ (lget grown lf) short))))))

;; ---- table-column-widths (automatic) ----
(defn- ncols [d :document row0only :i64 start :i64] :i64
  (loop [j 0 a start]
    (if (>= j (wd d 4)) a
      (recur (+ j 1) (if (or (= row0only 0) (= (crow0 d j) 1)) (imax a (+ (ccol d j) (cspan d j))) a)))))
(defn- widest [d :document col :i64] :i64
  (loop [j 0 a 1] (if (>= j (wd d 4)) a (recur (+ j 1) (if (and (= (cspan d j) 1) (= (ccol d j) col)) (imax a (cnat d j)) a)))))
(defn- base-list [d :document n :i64] [:list :i64]
  (loop [c 0 out (typed-list-new [:list :i64])]
    (if (>= c n) out
      (let [cw (cwp d c) dw (dwp d c)]
        (recur (+ c 1) (typed-list-conj [:list :i64] out
                         (cond (and (>= cw 0) (>= dw 0)) (imax cw dw) (>= cw 0) cw (>= dw 0) dw :else (widest d c))))))))
(defn- add-range [ws [:list :i64] n :i64 from :i64 to :i64 add :i64] [:list :i64]
  (loop [i 0 out (typed-list-new [:list :i64])]
    (if (>= i n) out (recur (+ i 1) (typed-list-conj [:list :i64] out (if (and (>= i from) (< i to)) (+ (lget ws i) add) (lget ws i)))))))
(defn- span-fold [d :document ws [:list :i64] n :i64] [:list :i64]
  (loop [j 0 w ws]
    (if (>= j (wd d 4)) w
      (let [sp (cspan d j) col (ccol d j)]
        (if (= sp 1) (recur (+ j 1) w)
          (let [have (+ (loop [i col a 0] (if (>= i (+ col sp)) a (recur (+ i 1) (+ a (lget w i))))) (* (px (wd d 2)) (- sp 1)))
                short (- (cnat d j) have)]
            (if (> short 0)
              (recur (+ j 1) (add-range w n col (+ col sp) (quot (+ short (- sp 1)) sp)))
              (recur (+ j 1) w))))))))
(defn- auto-widths [d :document n :i64] [:list :i64]
  (let [natural (span-fold d (base-list d n) n)
        total (lsum natural n) cw (px (wd d 1))]
    (if (and (> total 0) (> total cw))
      (loop [i 0 out (typed-list-new [:list :i64])]
        (if (>= i n) out
          (recur (+ i 1) (typed-list-conj [:list :i64] out
                           (f64-to-i64-truncating (f64-mul (fl (lget natural i)) (f64-div (fl cw) (fl total))))))))
      natural)))

;; ---- table-fixed-column-widths ----
(defn- first-decl [d :document col :i64] :i64
  (loop [j 0]
    (if (>= j (wd d 4)) -1
      (if (and (and (= (crow0 d j) 1) (and (= (cspan d j) 1) (= (ccol d j) col))) (>= (cdec d j) 0)) (cdec d j) (recur (+ j 1))))))
(defn- fixed-widths [d :document n :i64] [:list :i64]
  (let [avail (imax 0 (- (px (wd d 1)) (* (px (wd d 2)) (+ n 1))))
        declared (loop [c 0 out (typed-list-new [:list :i64])]
                   (if (>= c n) out (recur (+ c 1) (typed-list-conj [:list :i64] out (if (>= (cwp d c) 0) (cwp d c) (first-decl d c))))))
        fixed (loop [c 0 a 0] (if (>= c n) a (recur (+ c 1) (if (>= (lget declared c) 0) (+ a (lget declared c)) a))))
        autos (loop [c 0 a 0] (if (>= c n) a (recur (+ c 1) (if (< (lget declared c) 0) (+ a 1) a))))
        each (if (> autos 0) (imax 0 (quot (- avail fixed) autos)) 0)
        widths (loop [c 0 out (typed-list-new [:list :i64])]
                 (if (>= c n) out (recur (+ c 1) (typed-list-conj [:list :i64] out (if (>= (lget declared c) 0) (lget declared c) each)))))]
    (if (> autos 0) widths (dist-excess d widths n avail 0))))

(defn- hash-step [h :i64 v :i64] :i64 (bit-and (+ (* h 257) (+ 1 (* v 64))) 4294967295))
(defn run [d :document] :i64
  (let [fixed? (= (wd d 0) 1)
        n (if fixed? (ncols d 1 (wd d 3)) (ncols d 0 0))
        w1 (if fixed? (fixed-widths d n) (auto-widths d n))
        short (- (px (wd d 5)) (+ (lsum w1 n) (* (px (wd d 2)) (+ n 1))))
        w2 (if (and (> short 0) (> n 0))
             (let [add (quot (+ short (- n 1)) n)] (add-range w1 n 0 n add))
             w1)
        tg (wd d 6)
        w3 (if (and (not fixed?) (< tg 4294967295)) (dist-excess d w2 n (px tg) 1) w2)]
    (loop [i 0 h 5381] (if (>= i n) h (recur (+ i 1) (hash-step h (lget w3 i)))))))
