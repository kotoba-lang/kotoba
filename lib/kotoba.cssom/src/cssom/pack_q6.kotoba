(ns cssom.pack-q6
  (:export [clamp pack hi lo]))

;; Two Q6 lengths in one i64 (JUN-920 slice 2). The same packing as cssom.block-width-q6 (slice 1 keeps its own copy;
;; it is not changed here): each field is clamped to +-(2^30 + 1), so an out-of-range input stays out of range (and is
;; refused by the caller's guard) instead of aliasing into the neighbouring field. pack(hi, lo) = hi * 2^32 + lo + 2^30 + 1.
(defn clamp [x :i64] :i64 (cond (> x 1073741825) 1073741825 (< x -1073741825) -1073741825 :else x))
(defn pack [hi :i64 lo :i64] :i64 (+ (i64-shift-left (clamp hi) 32) (+ (clamp lo) 1073741825)))
(defn hi [p :i64] :i64 (i64-shift-right p 32))
(defn lo [p :i64] :i64 (- (bit-and p 4294967295) 1073741825))
