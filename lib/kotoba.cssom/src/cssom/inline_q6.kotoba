(ns cssom.inline-q6
  (:require [cssom.length-q6 :as len])
  (:export [invalid shift-keyword middle-box middle-inherited leading-ascent]))

;; Vertical-align shifts of inline fragments in Q6 fixed point (JUN-920 slice 3, census group G09; ADR-0287). Mirrors
;; layout.cljk vertical-align-shift (12468-12469, `super` / `sub`), the `middle` box law of inline-fragments (12793,
;; `h/2 + x-height/2`) and the inherited `middle` shift (13082-13083, `x-height/2 + (lh/2 - leading-ascent)`)
;; (f64 oracle: cssom.inline). Scalar i64 only, at most five parameters, no heap.
;;
;; Scale: Q6 raw (1/64 px), |raw| <= 2^30 (else (invalid)); font metrics `ascent` / `descent` are whole px (the font table is
;; integer), x-height and the line-height may be fractional px. Every shift is ONE exact rational rounded half up:
;;   shift-keyword(kind, fs)  kind 1 super: fs/3 + 1 px;  kind 2 sub: -(fs/5 + 1) px;  fs Q6 raw >= 0; other kinds (invalid)
;;   middle-box(h, x)         h/2 + x/2 = (h + x)/2
;;   leading-ascent(ascent, descent, lh)  floor(ascent + (lh - (ascent + descent))/2) in WHOLE px (Math/floor): the px count
;;   middle-inherited(x, lh, ascent, descent)  x/2 + (lh/2 - leading-ascent) = (x + lh)/2 - leading-ascent, as a Q6 raw
;; The source adds two halves of doubles, which is exact (halving is exact); the exact sum has at most half a raw unit of
;; odd remainder, so the only deviation is that one rounding (1/128 px).
(defn invalid [] :i64 -4611686018427387904)
(defn shift-keyword [kind :i64 fs :i64] :i64
  (if (and (>= fs 0) (<= fs 1073741824))
    (cond (= kind 1) (len/rdiv (+ fs 192) 3)
          (= kind 2) (len/rdiv (- 0 (+ fs 320)) 5)
          :else (invalid))
    (invalid)))
(defn middle-box [h :i64 x :i64] :i64
  (if (and (len/in-range? h) (len/in-range? x)) (len/rdiv (+ h x) 2) (invalid)))
(defn leading-ascent [ascent :i64 descent :i64 lh :i64] :i64
  (if (and (and (>= ascent 0) (<= ascent 65535)) (and (and (>= descent 0) (<= descent 65535)) (len/in-range? lh)))
    (len/fdiv (+ (* 64 (- ascent descent)) lh) 128)
    (invalid)))
(defn middle-inherited [x :i64 lh :i64 ascent :i64 descent :i64] :i64
  (let [la (leading-ascent ascent descent lh)]
    (if (and (and (len/in-range? x) (len/in-range? lh)) (not= la (invalid)))
      (- (len/rdiv (+ x lh) 2) (* 64 la))
      (invalid))))
