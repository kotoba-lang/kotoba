(ns cssom.style-num
  (:export [clamp01 mul stacking? factor parse-d4]))

;; f64 reference (native macOS) for the style numbers of layout.cljk (census group G11): opacity
;; `(max 0.0 (min 1.0 x))` (3302), the cumulative `(* opacity (:opacity st))` (12997, 18396), `(< opacity 1.0)` (3662) and the
;; flex factors `(parse-dbl ... 0.0 / 1.0)` (3326-3327), on doubles. x is the f64 of the decimal text (D4 raw / 10000.0).
;; parse-d4 is the f64 value of a decimal digit string given as mantissa and fraction digit count (the host parser of the
;; source is Double/parseDouble; this reference starts from the parsed value).
(defn clamp01 [x :f64] :f64 (if (f64-lt x 0.0) 0.0 (if (f64-gt x 1.0) 1.0 x)))
(defn mul [a :f64 b :f64] :f64 (f64-mul a b))
(defn stacking? [x :f64] :bool (f64-lt x 1.0))
(defn factor [x :f64] :f64 x)
(defn parse-d4 [mant :i64 frac-digits :i64] :f64
  (f64-div (i64-to-f64-rounded mant) (loop [k 0 p 1.0] (if (= k frac-digits) p (recur (+ k 1) (f64-mul p 10.0))))))
