(ns cssom.margin-collapse-q6
  (:export [empty-state add finish invalid positive negative valid?]))

;; Incremental margin collapsing (CSS 2.2 8.3.1) in Q6, mirror of cssom.margin-collapse (f64, the oracle).
;; Positive and negative extrema are kept separately so that three or more margins collapse correctly.
;; The whole state is ONE i64: a valid state is positive * 2^32 + (-negative) with 0 <= positive, -negative <= 2^30
;; (so it is >= 0); the invalid state is -1. A margin outside |raw| <= 2^30 (the f64 `finite?` replacement)
;; makes the state invalid, and invalid is absorbing. finish returns the collapsed margin positive + negative as a
;; Q6 raw, or (invalid) = -2^62 for an invalid state. Scalar i64, at most five parameters, no floats.
(defn invalid [] :i64 -4611686018427387904)
(defn empty-state [] :i64 0)
(defn valid? [state :i64] :bool (>= state 0))
(defn positive [state :i64] :i64 (i64-shift-right state 32))
(defn negative [state :i64] :i64 (- 0 (bit-and state 4294967295)))
(defn add [state :i64 value :i64] :i64
  (if (and (>= state 0) (>= value -1073741824) (<= value 1073741824))
    (let [p (if (> value (positive state)) value (positive state))
          n (if (< value (negative state)) value (negative state))]
      (+ (i64-shift-left p 32) (- 0 n)))
    -1))
(defn finish [state :i64] :i64
  (if (>= state 0) (+ (positive state) (negative state)) (invalid)))
