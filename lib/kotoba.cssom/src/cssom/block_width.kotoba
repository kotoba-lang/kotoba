(ns cssom.block-width
  (:export [solve solve-constrained])
  (:schemas {:css.block/input [:record :css.block/input
                               [[:containing :f64] [:width :f64] [:width-auto :bool] [:border-box :bool]
                                [:left :f64] [:left-auto :bool] [:right :f64] [:right-auto :bool]
                                [:padding-left :f64] [:padding-right :f64] [:border-left :f64] [:border-right :f64]
                                [:rtl :bool]]]
             :css.block/result [:record :css.block/result
                                [[:valid :bool] [:content :f64] [:border :f64]
                                 [:margin-left :f64] [:margin-right :f64]]]}))

;; CSS 2.2 10.3.3, after cascade and percentage resolution: horizontal
;; equation for a non-replaced block in normal flow. Percentage resolution, floats,
;; orthogonal writing modes, scrollbar and intrinsic sizing are caller-owned.
;; A failed finite/nonnegative check returns valid=false, never plausible zero.
(defn finite? [x :f64] :bool (not= (bit-and (u64-shift-right (f64-to-bits x) 52) 2047) 2047))
(defn nonnegative? [x :f64] :bool (and (finite? x) (not (f64-lt x 0.0))))
(defn maximum-zero [x :f64] :f64 (if (f64-lt x 0.0) 0.0 x))
(defn invalid [] [:ref :css.block/result] (record [:ref :css.block/result] false 0.0 0.0 0.0 0.0))
(defn solve [x [:ref :css.block/input]] [:ref :css.block/result]
  (let [cb (record-get [:ref :css.block/input] x :containing)
        declared (record-get [:ref :css.block/input] x :width)
        auto (record-get [:ref :css.block/input] x :width-auto)
        border-box (record-get [:ref :css.block/input] x :border-box)
        left (record-get [:ref :css.block/input] x :left)
        left-auto (record-get [:ref :css.block/input] x :left-auto)
        right (record-get [:ref :css.block/input] x :right)
        right-auto (record-get [:ref :css.block/input] x :right-auto)
        pl (record-get [:ref :css.block/input] x :padding-left)
        pr (record-get [:ref :css.block/input] x :padding-right)
        bl (record-get [:ref :css.block/input] x :border-left)
        br (record-get [:ref :css.block/input] x :border-right)
        rtl (record-get [:ref :css.block/input] x :rtl)]
    (if (not (and (nonnegative? cb) (nonnegative? declared) (finite? left) (finite? right)
                  (nonnegative? pl) (nonnegative? pr) (nonnegative? bl) (nonnegative? br))) (invalid)
      (let [extra (f64-add (f64-add pl pr) (f64-add bl br))
            l0 (if left-auto 0.0 left) r0 (if right-auto 0.0 right)
            fixed (if auto 0.0 (if border-box (maximum-zero (f64-sub declared extra)) declared))
            fixed-border (f64-add fixed extra)
            over (and (not auto) (f64-gt (f64-add (f64-add fixed-border l0) r0) cb))
            la (and left-auto (not over) (not auto)) ra (and right-auto (not over) (not auto))
            content (if auto (maximum-zero (f64-sub (f64-sub (f64-sub cb extra) l0) r0)) fixed)
            border (f64-add content extra)
            remaining (f64-sub (f64-sub (f64-sub cb border) l0) r0)
            half (f64-mul remaining 0.5)
            l (cond (and la ra) half la remaining (and (not ra) rtl) (f64-add l0 remaining) :else l0)
            r (cond (and la ra) half ra remaining (and (not la) (not rtl)) (f64-add r0 remaining) :else r0)]
        (if (and (finite? extra) (finite? content) (finite? border) (finite? l) (finite? r))
          (record [:ref :css.block/result] true content border l r) (invalid))))))

;; Re-run the equation with a definite content width, preserving the original
;; auto margin flags. This matters when an auto width is constrained: simply
;; clamping the first result would leave the old margins in place.
(defn with-content-width [x [:ref :css.block/input] width :f64] [:ref :css.block/input]
  (record [:ref :css.block/input]
          (record-get [:ref :css.block/input] x :containing) width false false
          (record-get [:ref :css.block/input] x :left) (record-get [:ref :css.block/input] x :left-auto)
          (record-get [:ref :css.block/input] x :right) (record-get [:ref :css.block/input] x :right-auto)
          (record-get [:ref :css.block/input] x :padding-left) (record-get [:ref :css.block/input] x :padding-right)
          (record-get [:ref :css.block/input] x :border-left) (record-get [:ref :css.block/input] x :border-right)
          (record-get [:ref :css.block/input] x :rtl)))

;; CSS 2.2 10.4: test max first, then min, recalculating the complete width
;; equation each time. Bounds are already-resolved CSS lengths in the chosen
;; box-sizing; has-max=false represents max-width:none.
(defn solve-constrained [x [:ref :css.block/input] min-width :f64 max-width :f64 has-max :bool] [:ref :css.block/result]
  (if (not (and (nonnegative? min-width) (nonnegative? max-width))) (invalid)
    (let [initial (solve x)
          box (record-get [:ref :css.block/input] x :border-box)
          extra (f64-add (f64-add (record-get [:ref :css.block/input] x :padding-left)
                                  (record-get [:ref :css.block/input] x :padding-right))
                         (f64-add (record-get [:ref :css.block/input] x :border-left)
                                  (record-get [:ref :css.block/input] x :border-right)))
          min-content (if box (maximum-zero (f64-sub min-width extra)) min-width)
          max-content (if box (maximum-zero (f64-sub max-width extra)) max-width)]
      (if (not (record-get [:ref :css.block/result] initial :valid)) (invalid)
        (let [after-max (if (and has-max (f64-gt (record-get [:ref :css.block/result] initial :content) max-content))
                          (solve (with-content-width x max-content)) initial)]
          (if (not (record-get [:ref :css.block/result] after-max :valid)) (invalid)
            (if (f64-lt (record-get [:ref :css.block/result] after-max :content) min-content)
              (solve (with-content-width x min-content)) after-max)))))))
