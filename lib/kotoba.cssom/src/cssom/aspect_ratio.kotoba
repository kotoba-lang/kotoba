(ns cssom.aspect-ratio
  (:export [block-height block-width replaced-width replaced-height intrinsic-round]))

;; f64 reference (native macOS) for the aspect-ratio and replaced-element sizing of layout.cljk (census group G08), a
;; transcription of:
;;   block-height   aspect-ratio-block-height 4497-4505:  border-box (long (/ bw r)); else iy + (long (/ (max 0 (- bw ix)) r))
;;   block-width    aspect-ratio-block-width  4522-4530:  border-box (long (* h r));  else ix + (long (* (max 0 (- h iy)) r))
;;   replaced-width / replaced-height   replaced-content-size 4606-4631: the width and height cond tables (the clamp between
;;                  the two is the caller's: replaced-height takes the clamped width)
;;   intrinsic-round replaced-intrinsic-size 2102-2103:   (long (Math/round (double x)))   = floor(x + 1/2)
;; The ratio `r` is a positive double (aspect-ratio 4411-4421 drops a zero or negative term); the test builds it as rn / rd, the
;; same double the host gets from `a / b` or from a decimal with the denominator 10^k. Lengths are px (f64).
(defn trunc-f [x :f64] :f64 (i64-to-f64-rounded (f64-to-i64-truncating x)))
(defn max0 [x :f64] :f64 (if (f64-lt x 0.0) 0.0 x))
(defn block-height [border-box :bool bw :f64 r :f64 ix :f64 iy :f64] :f64
  (if border-box (trunc-f (f64-div bw r)) (f64-add iy (trunc-f (f64-div (max0 (f64-sub bw ix)) r)))))
(defn block-width [border-box :bool h :f64 r :f64 ix :f64 iy :f64] :f64
  (if border-box (trunc-f (f64-mul h r)) (f64-add ix (trunc-f (f64-mul (max0 (f64-sub h iy)) r)))))
(defn has-ratio? [intrinsic :bool iw :f64 ih :f64] :bool (and intrinsic (and (f64-gt iw 0.0) (f64-gt ih 0.0))))
(defn replaced-width [has-dw :bool dw :f64 has-dh :bool dh :f64 intrinsic :bool iw :f64 ih :f64 dflt :f64] :f64
  (let [ratio (has-ratio? intrinsic iw ih)]
    (cond has-dw dw
          (and has-dh ratio) (f64-mul dh (f64-div iw ih))
          intrinsic iw
          :else dflt)))
(defn replaced-height [has-dh :bool dh :f64 w :f64 intrinsic :bool iw :f64 ih :f64 dflt :f64] :f64
  (let [ratio (has-ratio? intrinsic iw ih)]
    (cond has-dh dh
          ratio (f64-div w (f64-div iw ih))
          intrinsic ih
          :else dflt)))
(defn intrinsic-round [x :f64] :i64
  (let [t (f64-to-i64-truncating (f64-add x 0.5))]
    (if (f64-lt (f64-add x 0.5) (i64-to-f64-rounded t)) (- t 1) t)))
