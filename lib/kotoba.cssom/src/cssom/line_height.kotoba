(ns cssom.line-height
  (:export [scaled-px resolve leading-ascent marker-advance option-height tab-stop]))

;; f64 reference (native macOS) for the line-height and font-metric arithmetic of layout.cljk (census group G06): a
;; transcription of the following functions, with the host values (numbers, parsed multipliers) as f64 / i64 arguments.
;;   scaled-px         `(long (* multiplier font-size))`            layout.cljk 4817 (resolve-line-height), 4883
;;                     (inherited-line-height), and with the literals 0.6 / 1.2 / 0.2: 527, 1590, 8251, 8355, 9362, 16075
;;                     (glyph advance), 4812 and 4813 (`normal`), 13932 (descent). `long` truncates toward zero.
;;   resolve           resolve-line-height 4812-4818: a number is `(long raw)`, a multiplier is scaled-px, anything else
;;                     is `normal` = inherited-explicit ? (or theme (long (* 1.2 fs))) : (max (or theme 0) (long (* 1.2 fs))).
;;   leading-ascent    4917: `(long (Math/floor (+ ascent (/ (- lh (+ ascent descent)) 2))))`
;;   marker-advance    6869: `(+ fs (Math/ceil (/ (* 2 (+ fs 2)) 7.0)))`
;;   option-height     2306: `(+ (* 1.2 fs) 1)`
;;   tab-stop          630:  `(* tab-w (inc (long (Math/floor (/ pen tab-w)))))`
;; The decimal literal of the source (`0.6`, `1.5`, `150%` -> `(/ n 100.0)`) arrives here as the correctly rounded f64 of the
;; decimal text, i.e. the same double the host parser produces; the test builds it as raw / 10000.0.
(defn trunc-i [x :f64] :i64 (f64-to-i64-truncating x))
(defn floor-f [x :f64] :f64
  (let [t (i64-to-f64-rounded (f64-to-i64-truncating x))] (if (f64-lt x t) (f64-sub t 1.0) t)))
(defn ceil-f [x :f64] :f64
  (let [t (i64-to-f64-rounded (f64-to-i64-truncating x))] (if (f64-gt x t) (f64-add t 1.0) t)))
(defn scaled-px [m :f64 fs :f64] :i64 (trunc-i (f64-mul m fs)))
(defn imax [a :i64 b :i64] :i64 (if (> a b) a b))
;; kind: 0 normal / unparseable string, 1 a number (value = the number in px), 2 a multiplier (value = the f64 multiplier)
;; flags: bit0 a theme default exists, bit1 inherited-explicit
(defn resolve [kind :i64 value :f64 fs :f64 theme :i64 flags :i64] :i64
  (let [has-theme (= (bit-and flags 1) 1) inherited (= (bit-and (i64-shift-right flags 1) 1) 1)
        natural (scaled-px 1.2 fs)
        normal (if inherited (if has-theme theme natural) (imax (if has-theme theme 0) natural))]
    (cond (= kind 1) (trunc-i value)
          (= kind 2) (scaled-px value fs)
          :else normal)))
(defn leading-ascent [ascent :f64 descent :f64 lh :f64] :i64
  (trunc-i (floor-f (f64-add ascent (f64-div (f64-sub lh (f64-add ascent descent)) 2.0)))))
(defn marker-advance [fs :f64] :f64 (f64-add fs (ceil-f (f64-div (f64-mul 2.0 (f64-add fs 2.0)) 7.0))))
(defn option-height [fs :f64] :f64 (f64-add (f64-mul 1.2 fs) 1.0))
(defn tab-stop [pen :f64 tab-w :f64] :f64
  (f64-mul tab-w (f64-add 1.0 (floor-f (f64-div pen tab-w)))))
