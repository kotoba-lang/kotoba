(ns cssom.trig-q6
  (:require [cssom.length-q6 :as len])
  (:export [invalid unit-deg unit-grad unit-rad unit-turn
            one17 one30 domain-ok? mulq reduce-n reduce-theta sin30 cos30 sin17 cos17 tan17 max-tan17
            poly-sin poly-cos]))

;; Fixed-point sin / cos / tan for the CSS transform functions (JUN-929 / C2b-4, census group G05; ADR-0287 amendment 1).
;; layout.cljk calls Math/cos, Math/sin (rotate) and Math/tan (skew, skewX, skewY) on the output of transform-angle; the native f64
;; dialect has none of them, so there is NO native runtime oracle and the result is checked against a golden table that Python
;; produced once (evidence cssom-q6-transform-20261106). Scalar i64 only, at most five parameters, no loops, no heap, no strings,
;; no floats; the only division is quot (through cssom.length-q6 fdiv / rdiv).
;;
;; INPUT. An angle is the pair (unit, v): v is the number of the CSS token as a D6 integer (millionths of the unit, the exact
;; 6-digit fixed point; digits beyond the sixth are the host scanner's business), unit 1 deg, 2 grad, 3 rad, 4 turn. A bare 0 is
;; (any unit, 0). DOMAIN: |angle| <= 32 full turns, i.e. |v| <= 11,520,000,000 deg, 12,800,000,000 grad, 201,061,929 rad
;; (floor of 32 * 2 pi * 10^6), 32,000,000 turn. Outside it every function answers (invalid) = -2^62: nothing wraps, truncates or
;; reduces silently. (layout.cljk accepts any real; rotate(1e9deg) is therefore REFUSED here, a documented difference.)
;;
;; METHOD. 1. Reduce to a quadrant k = 0..3 and a residual angle in [0, pi/2). deg, grad and turn reduce EXACTLY in integers
;; (quarter = 90e6 / 100e6 / 250000 units; the folding of the residual to [0, pi/4] is exact in the same integers), so 90deg, 0.25turn,
;; 100grad give the exact quadrant edge and cos = 0 exactly. rad reduces with pi/2 * 10^6 * 2^16 rounded to an integer
;; (102943708073; the residual pi/2 error is below 2^-17 micro-radian per quarter, 1e-9 rad at 32 turns). 2. The residual theta in
;; [0, pi/4] becomes radians in Q30 (one multiplication by a constant rounded to 30 bits: relative error below 2^-30). 3. sin and
;; cos of theta by a fixed Horner polynomial in u = theta^2 (sin through theta^11, cos through theta^12; the first omitted terms
;; are below 1e-11 on [0, pi/4]), every product rounded half up to Q30 through `mulq`. 4. The quadrant and the fold swap and negate
;; the two results. 5. The Q17 answer is the Q30 value rounded half up (one more rounding). tan = sin / cos by a bounded long
;; division (Q17 result), refused when |tan| >= 64 (raw >= 2^23, the coefficient range of cssom.transform-q6) or cos = 0.
;;
;; ERROR (stated here, measured against the golden table by test/native/q6_trig_vs_golden.kotoba; the numbers are in the evidence README):
;;   sin30, cos30: the polynomial plus roundings stay within 2 Q30 ulps (= 2 * 9.3e-10) of the true value.
;;   sin17, cos17: |result - round(true * 2^17)| <= 1 Q17 ulp (7.6e-6); they equal the correctly rounded value except when the true value
;;       lies within 3e-4 ulp of a rounding tie.
;;   tan17: the input angle is held at 2^-28 turn (Q30 radians); the derivative 1 + tan^2 magnifies this, so
;;       |error| <= 1 + 1.6e-3 * (1 + tan^2) ulps (at |tan| = 64: 8 ulps = 6.1e-5; at |tan| = 8: 1.1 ulps).
;; Rounding rule everywhere: round half up, floor(x + 1/2), the rule of the other Q6 modules.
(defn invalid [] :i64 -4611686018427387904)
(defn unit-deg [] :i64 1)
(defn unit-grad [] :i64 2)
(defn unit-rad [] :i64 3)
(defn unit-turn [] :i64 4)
(defn one17 [] :i64 131072)
(defn one30 [] :i64 1073741824)
(defn max-tan17 [] :i64 8388607)
;; the largest |v| per unit (32 turns)
(defn limit [unit :i64] :i64
  (cond (= unit 1) 11520000000 (= unit 2) 12800000000 (= unit 3) 201061929 (= unit 4) 32000000 :else -1))
(defn domain-ok? [unit :i64 v :i64] :bool (and (>= (limit unit) 0) (and (>= v (- 0 (limit unit))) (<= v (limit unit)))))

;; round(x * y / 2^s) for 0 <= x, y <= 2^30, exact (no double rounding): y is split at bit 15 so that every multiplication is below 2^46
(defn mulq [x :i64 y :i64 s :i64] :i64
  (i64-shift-right (+ (+ (i64-shift-left (* x (i64-shift-right y 15)) 15) (* x (bit-and y 32767))) (i64-shift-left 1 (- s 1))) s))

;; one Horner level: 1 - u * w / d   (u, w in Q30, d a small integer)
(defn lv [u :i64 w :i64 d :i64] :i64 (- 1073741824 (len/rdiv (mulq u w 30) d)))
;; sin and cos of theta in Q30 radians, 0 <= theta <= pi/4 (843314857)
(defn poly-sin [theta :i64] :i64
  (let [u (mulq theta theta 30)
        w6 (lv u 1073741824 110) w5 (lv u w6 72) w4 (lv u w5 42) w3 (lv u w4 20) w2 (lv u w3 6)]
    (mulq theta w2 30)))
(defn poly-cos [theta :i64] :i64
  (let [u (mulq theta theta 30)
        c6 (lv u 1073741824 132) c5 (lv u c6 90) c4 (lv u c5 56) c3 (lv u c4 30) c2 (lv u c3 12)]
    (lv u c2 2)))

;; ---- reduction: (unit, v) -> pack(n, theta), n = 2 k + s, k the quadrant 0..3, s = 1 when the residual was folded (psi = pi/2 - theta) ----
;; r in [0, quarter): the residual in integer units; the fold r > quarter / 2 -> quarter - r is exact for deg, grad, turn
(defn quarter [unit :i64] :i64 (cond (= unit 1) 90000000 (= unit 2) 100000000 (= unit 4) 250000 :else 0))
(defn int-const [unit :i64] :i64 (cond (= unit 1) 628821134 (= unit 2) 565939020 :else 884279719))
(defn int-shift [unit :i64] :i64 (if (= unit 4) 17 25))
;; deg, grad, turn: (quadrant count q, residual r) packed as q * 2^32 + r; q may be negative (floor division)
(defn int-q [unit :i64 v :i64] :i64 (len/fdiv v (quarter unit)))
(defn int-r [unit :i64 v :i64] :i64 (- v (* (int-q unit v) (quarter unit))))
;; rad: q = floor(v * 2^16 / P16), residual in Q16 micro-radians r16 = v * 2^16 - q * P16, P16 = round(pi/2 * 10^6 * 2^16)
(defn rad-q [v :i64] :i64 (len/fdiv (* v 65536) 102943708073))
(defn rad-r16 [v :i64] :i64 (- (* v 65536) (* (rad-q v) 102943708073)))
;; theta0 (Q30 radians, 0 <= theta0 < pi/2) from the residual
(defn theta-int [unit :i64 r :i64] :i64 (mulq r (int-const unit) (int-shift unit)))
(defn theta-rad [r16 :i64] :i64 (len/rdiv (* r16 256) 15625))
(defn quad-of [unit :i64 v :i64] :i64
  (let [q (if (= unit 3) (rad-q v) (int-q unit v))] (- q (* 4 (len/fdiv q 4)))))
;; the folded flag and the folded residual theta in [0, pi/4]
(defn fold-int? [unit :i64 v :i64] :bool (> (* 2 (int-r unit v)) (quarter unit)))
(defn theta-of [unit :i64 v :i64] :i64
  (if (= unit 3)
    (let [t (theta-rad (rad-r16 v))] (if (> t 843314857) (- 1686629713 t) t))
    (let [r (int-r unit v)] (theta-int unit (if (fold-int? unit v) (- (quarter unit) r) r)))))
(defn fold-of [unit :i64 v :i64] :i64
  (if (= unit 3)
    (if (> (theta-rad (rad-r16 v)) 843314857) 1 0)
    (if (fold-int? unit v) 1 0)))
(defn reduce-n [unit :i64 v :i64] :i64
  (if (domain-ok? unit v) (+ (* 2 (quad-of unit v)) (fold-of unit v)) -1))
(defn reduce-theta [unit :i64 v :i64] :i64 (if (domain-ok? unit v) (theta-of unit v) -1))

;; the folded pair (sin psi, cos psi) of the within-quadrant angle psi, then the quadrant rotation
(defn psi-sin [n :i64 theta :i64] :i64 (if (= (bit-and n 1) 1) (poly-cos theta) (poly-sin theta)))
(defn psi-cos [n :i64 theta :i64] :i64 (if (= (bit-and n 1) 1) (poly-sin theta) (poly-cos theta)))
(defn sin-of [n :i64 theta :i64] :i64
  (let [k (i64-shift-right n 1)]
    (cond (= k 0) (psi-sin n theta) (= k 1) (psi-cos n theta) (= k 2) (- 0 (psi-sin n theta)) :else (- 0 (psi-cos n theta)))))
(defn cos-of [n :i64 theta :i64] :i64
  (let [k (i64-shift-right n 1)]
    (cond (= k 0) (psi-cos n theta) (= k 1) (- 0 (psi-sin n theta)) (= k 2) (- 0 (psi-cos n theta)) :else (psi-sin n theta))))
;; Q30 results (|x| <= 2^30)
(defn sin30 [unit :i64 v :i64] :i64
  (if (domain-ok? unit v) (sin-of (reduce-n unit v) (reduce-theta unit v)) (invalid)))
(defn cos30 [unit :i64 v :i64] :i64
  (if (domain-ok? unit v) (cos-of (reduce-n unit v) (reduce-theta unit v)) (invalid)))
;; Q17 results
(defn to17 [x :i64] :i64 (len/rdiv x 8192))
(defn sin17 [unit :i64 v :i64] :i64 (if (domain-ok? unit v) (to17 (sin30 unit v)) (invalid)))
(defn cos17 [unit :i64 v :i64] :i64 (if (domain-ok? unit v) (to17 (cos30 unit v)) (invalid)))

;; round(a * 2^17 / b) for 0 <= a <= 2^30, 0 < b <= 2^30 by a long division in two steps, ties up (neg = 0) or down in magnitude (neg = 1,
;; which is half up on the signed value)
(defn div17-mag [a :i64 b :i64 neg :i64] :i64
  (let [t (* a 32768) q1 (quot t b) r1 (- t (* q1 b))
        u (* r1 4) q2 (quot u b) r2 (- u (* q2 b))
        q (+ (* q1 4) q2)
        up (if (= neg 1) (> (* 2 r2) b) (>= (* 2 r2) b))]
    (if up (+ q 1) q)))
(defn tan-of [s :i64 c :i64] :i64
  (let [neg (if (= (< s 0) (< c 0)) 0 1)
        m (div17-mag (if (< s 0) (- 0 s) s) (if (< c 0) (- 0 c) c) neg)]
    (cond (> m 8388607) (invalid) (= neg 1) (- 0 m) :else m)))
(defn tan17 [unit :i64 v :i64] :i64
  (if (domain-ok? unit v)
    (if (= (cos30 unit v) 0) (invalid) (tan-of (sin30 unit v) (cos30 unit v)))
    (invalid)))
