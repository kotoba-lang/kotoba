(ns cssom.length
  (:export [resolve])
  (:schemas {:css.length/input [:record :css.length/input [[:unit :keyword] [:value :f64]]]
             :css.length/result [:record :css.length/result [[:kind :keyword] [:value :f64]]]}))

;; Resolved px/percentage/auto/none only; CSS tokenization, calc(), relative
;; units and property-specific defaults remain caller-owned. An indefinite
;; percentage is explicit rather than guessed as zero or a remote fallback.
(defn finite? [x :f64] :bool (not= (bit-and (u64-shift-right (f64-to-bits x) 52) 2047) 2047))
(defn result [kind :keyword value :f64] [:ref :css.length/result]
  (record [:ref :css.length/result] kind value))
(defn resolve [input [:ref :css.length/input] basis :f64 definite :bool negative :bool] [:ref :css.length/result]
  (let [unit (record-get [:ref :css.length/input] input :unit)
        value (record-get [:ref :css.length/input] input :value)]
    (cond (not (and (finite? value) (finite? basis) (not (f64-lt basis 0.0)))) (result :length/invalid 0.0)
          (= unit :length/auto) (result :length/auto 0.0)
          (= unit :length/none) (result :length/none 0.0)
          (not (or (= unit :length/px) (= unit :length/percent))) (result :length/invalid 0.0)
          (and (not negative) (f64-lt value 0.0)) (result :length/invalid 0.0)
          (and (= unit :length/percent) (not definite)) (result :length/unresolved 0.0)
          :else (let [n (if (= unit :length/percent) (f64-mul value (f64-mul basis 0.01)) value)]
                  (if (finite? n) (result :length/resolved n) (result :length/invalid 0.0))))))
