(ns cssom.aspect-ratio-q6
  (:require [cssom.length-q6 :as len] [cssom.pack-q6 :as pk])
  (:export [invalid block-height block-width replaced-width replaced-height intrinsic-px]))

;; aspect-ratio and replaced-element sizing in Q6 fixed point (JUN-920 slice 2, census group G08; ADR-0287). Mirrors
;; layout.cljk aspect-ratio-block-height / -width, replaced-content-size and the rounding of replaced-intrinsic-size
;; (f64 oracle: cssom.aspect-ratio). Scalar i64 only, at most five parameters, no heap.
;;
;; A ratio is the INTEGER PAIR (rn, rd), r = rn / rd, each 1..65535, carried as rr = pack(rn, rd). The host parser turns `16 / 9`
;; into (16, 9) and a decimal `1.5` into (15, 10) (or any reduced form); a ratio that does not fit (a zero or negative term
;; is already dropped by the source) or has more than 16 bits per term is REFUSED, never rounded. A length is a Q6 raw,
;; |raw| <= 2^30; an intrinsic image size is a whole number of px 0..65535. The products w * rd and h * rn stay below 2^46
;; (2^30 * 2^16). Exact: no division is approximate. `long` of the source truncates toward zero, so a size derived from a
;; ratio is a WHOLE number of px (a multiple of 64 raw); the replaced sizes are not truncated in the source and are rounded
;; half up once (round-half-up(a / b), see cssom.length-q6).
;;   block-height(flags, bw, rr, ins)  flags bit0 = border-box;  ins = pack(ix, iy) the declared insets (>= 0)
;;       border-box: 64 * quot(bw * rd, 64 * rn);   content-box: iy + 64 * quot(max0(bw - ix) * rd, 64 * rn)
;;   block-width(flags, h, rr, ins)
;;       border-box: 64 * quot(h * rn, 64 * rd);    content-box: ix + 64 * quot(max0(h - iy) * rn, 64 * rd)
;;   replaced-width(flags, dwdh, ir, dflt)  flags bit0 declared width, bit1 declared height, bit2 intrinsic size present;
;;       dwdh = pack(dw, dh) (Q6, >= 0), ir = pack(iw, ih) (whole px), dflt = the default width (Q6)
;;       cond: dw | dh * iw / ih (ratio = intrinsic with iw > 0 and ih > 0) | iw * 64 | dflt
;;   replaced-height(flags, w, dh, ir, dflt)  w = the width after the caller's clamp
;;       cond: dh | w * ih / iw | ih * 64 | dflt
;;   intrinsic-px(raw) = round-half-up(raw / 64) for a positive size raw (Math/round of the host size), whole px
;; Beyond a guard the result is (invalid) = -2^62.
(defn invalid [] :i64 -4611686018427387904)
(defn flag [f :i64 bit :i64] :bool (not= (bit-and (i64-shift-right f bit) 1) 0))
(defn max0 [x :i64] :i64 (if (< x 0) 0 x))
(defn nonneg? [x :i64] :bool (and (>= x 0) (<= x 1073741824)))
(defn ratio-ok? [rn :i64 rd :i64] :bool (and (and (>= rn 1) (<= rn 65535)) (and (>= rd 1) (<= rd 65535))))
(defn finish [r :i64] :i64 (if (len/in-range? r) r (invalid)))
(defn block-height [flags :i64 bw :i64 rr :i64 ins :i64] :i64
  (let [rn (pk/hi rr) rd (pk/lo rr) ix (pk/hi ins) iy (pk/lo ins)]
    (if (and (ratio-ok? rn rd) (and (len/in-range? bw) (and (nonneg? ix) (nonneg? iy))))
      (if (flag flags 0)
        (finish (* 64 (quot (* bw rd) (* 64 rn))))
        (finish (+ iy (* 64 (quot (* (max0 (- bw ix)) rd) (* 64 rn))))))
      (invalid))))
(defn block-width [flags :i64 h :i64 rr :i64 ins :i64] :i64
  (let [rn (pk/hi rr) rd (pk/lo rr) ix (pk/hi ins) iy (pk/lo ins)]
    (if (and (ratio-ok? rn rd) (and (len/in-range? h) (and (nonneg? ix) (nonneg? iy))))
      (if (flag flags 0)
        (finish (* 64 (quot (* h rn) (* 64 rd))))
        (finish (+ ix (* 64 (quot (* (max0 (- h iy)) rn) (* 64 rd))))))
      (invalid))))
(defn px16? [x :i64] :bool (and (>= x 0) (<= x 65535)))
(defn replaced-width [flags :i64 dwdh :i64 ir :i64 dflt :i64] :i64
  (let [dw (pk/hi dwdh) dh (pk/lo dwdh) iw (pk/hi ir) ih (pk/lo ir)
        ratio (and (flag flags 2) (and (> iw 0) (> ih 0)))]
    (if (and (or (not (flag flags 0)) (nonneg? dw)) (and (or (not (flag flags 1)) (nonneg? dh)) (and (nonneg? dflt) (or (not (flag flags 2)) (and (px16? iw) (px16? ih))))))
      (cond (flag flags 0) dw
            (and (flag flags 1) ratio) (finish (len/rdiv (* dh iw) ih))
            (flag flags 2) (* iw 64)
            :else dflt)
      (invalid))))
(defn replaced-height [flags :i64 w :i64 dh :i64 ir :i64 dflt :i64] :i64
  (let [iw (pk/hi ir) ih (pk/lo ir)
        ratio (and (flag flags 2) (and (> iw 0) (> ih 0)))]
    (if (and (nonneg? w) (and (or (not (flag flags 1)) (nonneg? dh)) (and (nonneg? dflt) (or (not (flag flags 2)) (and (px16? iw) (px16? ih))))))
      (cond (flag flags 1) dh
            ratio (finish (len/rdiv (* w ih) iw))
            (flag flags 2) (* ih 64)
            :else dflt)
      (invalid))))
(defn intrinsic-px [raw :i64] :i64
  (if (and (> raw 0) (<= raw 4194304)) (len/round-px raw) (invalid)))
