(ns cssom.flexplace-k (:require [cssom.flex-k :as fk]) (:export [fp-offset fp-auto]))
;; JUN-932 (JUN-920 follow-up), main-axis placement of a flex line of up to sixteen items, kernel dialect. The semantics are
;; those of `offset` and `auto-offset` of flex_q6.kotoba (layout.cljk place-main-axis, place-main-axis-auto-margins); the
;; difference is that the item sizes are not passed in: they are the sizes fx-run left in the window (cssom.flex-k), and the
;; prefix sums are taken here. Everything is Q6 raw; the invalid marker is -2^62 as in flex_q6.
;; fp-offset  mi = mode + 8 * safe + 16 * i  (mode 0 start, 1 space-between, 2 center, 3 end, 4 space-around, 5 space-evenly,
;;            any other value is start; safe applies to center / end: the free space is then clamped at zero), i the item.
;;            offset of item i = prefix + i * gap + ONE rounding (half up) of an exact fraction of the free space
;;            F = container - (total + gap * (n - 1)):  between F+ i / (n - 1),  center F? / 2,  end F?,
;;            around F+ (2 i + 1) / (2 n),  evenly F+ (i + 1) / (n + 1)   (F+ = max(0, F), F? = F or F+ when safe).
;; fp-auto    ml = leads | trails << 16 | i << 32 (bit j of leads / trails: item j has an auto margin on that side): every bit
;;            of positive free space goes to the auto margins of the line, split equally; the offset of item i is its prefix
;;            plus the `before` auto margins in front of it (its own lead margin included), round-half-up(before * F+ / nauto).
;;            With no auto margin the offset is the prefix.
(defn- inval [] -4611686018427387904)
(defn- imax [a b] (if (> a b) a b))
(defn- fdiv [a b] (let [q (quot a b)] (if (and (< a 0) (not= (* q b) a)) (- q 1) q)))
(defn- rdiv [n d] (fdiv (+ (* 2 n) d) (* 2 d)))
(defn- inr [x] (and (>= x -1073741824) (<= x 1073741824)))
(defn- sum-to [w length i j acc]
  (if (>= j i) acc (sum-to w length i (+ j 1) (+ acc (fk/fx-size w length j)))))
(defn- pc [m j acc] (if (>= j 16) acc (pc m (+ j 1) (+ acc (bit-and (u64-shift-right m j) 1)))))
(defn fp-offset [w length mi container gap]
  (let [n (fk/fx-count w length) i (u64-shift-right mi 4)
        mode (bit-and mi 7) safe (bit-and (u64-shift-right mi 3) 1)]
    (if (and (and (>= n 1) (<= n 16)) (and (>= i 0) (< i n)))
      (let [total (sum-to w length n 0 0) prefix (sum-to w length i 0 0)
            f (- container (+ total (* gap (- n 1)))) fp (imax 0 f) fs (if (= safe 1) fp f)
            base (+ prefix (* i gap))]
        (if (and (and (inr container) (inr total)) (and (and (inr gap) (>= gap 0)) (inr prefix)))
          (let [r (if (= mode 1) (+ base (if (> n 1) (rdiv (* i fp) (- n 1)) 0))
                    (if (= mode 2) (+ base (rdiv fs 2))
                      (if (= mode 3) (+ base fs)
                        (if (= mode 4) (+ base (rdiv (* (+ (* 2 i) 1) fp) (* 2 n)))
                          (if (= mode 5) (+ base (rdiv (* (+ i 1) fp) (+ n 1))) base)))))]
            (if (inr r) r (inval)))
          (inval)))
      (inval))))
(defn fp-auto [w length ml container gap]
  (let [n (fk/fx-count w length) i (u64-shift-right ml 32)
        leads (bit-and ml 65535) trails (bit-and (u64-shift-right ml 16) 65535)]
    (if (and (and (>= n 1) (<= n 16)) (and (>= i 0) (< i n)))
      (let [mask (- (i64-shift-left 1 n) 1)
            nauto (+ (pc (bit-and leads mask) 0 0) (pc (bit-and trails mask) 0 0))
            before (+ (pc (bit-and leads (- (i64-shift-left 1 (+ i 1)) 1)) 0 0) (pc (bit-and trails (- (i64-shift-left 1 i) 1)) 0 0))
            total (sum-to w length n 0 0) prefix (+ (sum-to w length i 0 0) (* i gap))
            totalg (+ total (* gap (- n 1)))]
        (if (and (and (inr container) (inr totalg)) (and (and (inr gap) (>= gap 0)) (inr prefix)))
          (let [r (if (= nauto 0) prefix (+ prefix (rdiv (* before (imax 0 (- container totalg))) nauto)))]
            (if (inr r) r (inval)))
          (inval)))
      (inval))))
