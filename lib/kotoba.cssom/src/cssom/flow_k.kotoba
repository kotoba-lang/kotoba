(ns cssom.flow-k (:require [cssom.cascade-k :as ck] [cssom.box-k :as bk] [cssom.margin-collapse-q6 :as mc])
  (:export [fk-run fk-height fk-word fk-off]))
;; Layout slice, kernel dialect, passes 2 and 3 and the entry (ADR-0287, JUN-920). Normal block flow of layout.cljk
;; layout-children-block / layout-block over the box table of box-k (record layout in box_k.kotoba), in Q6.
;; Pass 2 (bottom-up, elements from the last to the first, so every descendant is done): the in-flow children of a box, in order,
;; with the state (ht running height, pm margin of the previous sibling, om margin collapsed out of the top, first? flag),
;; exactly the loop state of layout-children-block:
;;   mt* = collapse(mt, child's top margin that collapsed out), mb* = the same at the bottom;
;;   gap = first and the parent's top margin may collapse (flag 4): 0; first: mt*; else collapse(pm, mt*);
;;   child rel-y = ht + gap; a child of height 0 with no vertical padding or border and not flow-root is self-collapsing: it does not
;;   advance ht, pm becomes collapse(pm, mt*, mb*) (unchanged when it also escapes through the top of a first child), om becomes
;;   collapse(om, mt*, mb*) and the first? flag stays; any other child advances ht by gap + its height and pm becomes mb*, and a first
;;   child sets om to mt* when the parent's top margin may collapse.
;;   content height = max(0, ht + (pm unless flag 8)); border-box height = the `height` if definite else content + padding + border;
;;   the bottom margin that collapses out is pm (flag 8) when the box did not take its height from `height`.
;; The document root is a child of an initial containing block that does not collapse (viewport width = containing width).
;; Pass 3 (top-down): x = parent x + parent border-left + padding-left + margin-left, y = parent y + border-top + padding-top + rel-y.
;; fk-run returns the number of elements (>= 0) or the negative status of the failing stage: the style slice's -1..-13 (cascade-k) and
;; -14..-19 of box-k / here (-18: a result outside +-2^30 Q6 raw, -19: the viewport width). fk-height is the document height (the root's
;; margin box), fk-word the record word i of element n.
(defn- hd [st i] (kernel-load-u32-4k (kernel-subregion st 61440 49152 4096) 4096 (* 4 i)))
(defn- hd! [st i v] (kernel-store-u32-4k (kernel-subregion st 61440 49152 4096) 4096 (* 4 i) v))
(defn- nd [st n at] (kernel-load-u16-4k (kernel-subregion st 61440 24576 4096) 4096 (+ (* 32 n) at)))
(defn- sx [x] (if (>= x 2147483648) (- x 4294967296) x))
(defn- bx [st n i] (sx (kernel-load-u32-16k (kernel-subregion st 61440 0 16384) 16384 (+ (* 128 n) (* 4 i)))))
;; no u32 store exists on the 16 KiB tier of kernel-v1 (E2101 'kernel-store-u32-16k'): two u16 stores
(defn- bx! [st n i v]
  (let [o (+ (* 128 n) (* 4 i))
        a (kernel-store-u16-16k (kernel-subregion st 61440 0 16384) 16384 o (bit-and v 65535))
        b (kernel-store-u16-16k (kernel-subregion st 61440 0 16384) 16384 (+ o 2) (bit-and (u64-shift-right (bit-and v 4294967295) 16) 65535))]
    (* 0 (+ a b))))
(defn- big? [x] (or (> x 1073741824) (< x -1073741824)))
(defn- mx0 [x] (if (< x 0) 0 x))
(defn- cm2 [a b] (mc/finish (mc/add (mc/add 0 a) b)))
(defn- cm3 [a b c] (mc/finish (mc/add (mc/add (mc/add 0 a) b) c)))
(defn- nxt [st c] (let [f (bx st c 30)] (if (= f 0) 1023 (- f 1))))

(defn- finish-node [st ht pm om]
  (let [p (hd st 34) fl (bx st p 22)
        cbot (bit-and (i64-shift-right fl 3) 1) has (bit-and (i64-shift-right fl 1) 1)
        it (+ (bx st p 13) (bx st p 17)) ib (+ (bx st p 15) (bx st p 19))
        hc (mx0 (+ ht (if (= cbot 1) 0 pm)))
        sum (+ hc (+ it ib))
        nh (if (= has 1) (bx st p 23) sum)
        omb (if (= cbot 1) pm 0)
        omo (if (= nh sum) omb 0)]
    (if (or (big? nh) (big? sum)) -18
      (+ 1 (* 0 (+ (bx! st p 4 nh) (+ (bx! st p 6 (mx0 (- nh (+ it ib)))) (+ (bx! st p 11 om) (bx! st p 12 omo)))))))))
;; cf = child + 1024 * first?; the end of the chain is child 1023
(defn- kids [st cf ht pm om]
  (let [c (bit-and cf 1023) fst (i64-shift-right cf 10)]
    (if (= c 1023) (finish-node st ht pm om)
      (if (not (= (bx st c 0) 1))
        (kids st (+ (nxt st c) (* 1024 fst)) ht pm om)
        (let [p (hd st 34)
              ctop (bit-and (i64-shift-right (bx st p 22) 2) 1)
              mts (cm2 (bx st c 9) (bx st c 11))
              mbs (cm2 (bx st c 10) (bx st c 12))
              gap (if (= fst 1) (if (= ctop 1) 0 mts) (cm2 pm mts))
              chh (bx st c 4)
              selfc (if (and (= chh 0) (and (= (+ (bx st c 17) (bx st c 19)) 0) (and (= (+ (bx st c 13) (bx st c 15)) 0) (= (bit-and (bx st c 22) 1) 0)))) 1 0)
              esc (if (and (= selfc 1) (and (= fst 1) (= ctop 1))) 1 0)
              ht2 (if (= selfc 1) ht (+ ht (+ gap chh)))
              pm2 (if (= selfc 1) (if (= esc 1) pm (cm3 pm mts mbs)) mbs)
              om2 (if (= esc 1) (cm3 om mts mbs) (if (and (= fst 1) (= ctop 1)) mts om))
              fst2 (if (= esc 1) fst 0)]
          (if (or (big? ht2) (big? (+ ht gap))) -18
            (let [z (bx! st c 21 (+ ht gap))]
              (kids st (+ (+ (nxt st c) (* 1024 fst2)) (* 0 z)) ht2 pm2 om2))))))))
(defn- root [st]
  (if (not (= (bx st 0 0) 1)) (+ 1 (* 0 (hd! st 37 0)))
    (let [mts (cm2 (bx st 0 9) (bx st 0 11))
          mbs (cm2 (bx st 0 10) (bx st 0 12))
          dh (+ (+ mts (bx st 0 4)) mbs)]
      (if (big? dh) -18
        (+ 1 (* 0 (+ (bx! st 0 21 mts) (hd! st 37 (bit-and dh 4294967295)))))))))
(defn- up [st p]
  (if (< p 0) (root st)
    (if (= (bx st p 0) 1)
      (let [z (hd! st 34 p)
            f (bx st p 29)
            c0 (if (= f 0) 1023 (- f 1))
            r (kids st (+ c0 (+ 1024 (* 0 z))) 0 0 0)]
        (if (< r 0) r (up st (- p 1))))
      (up st (- p 1)))))
(defn- down [st n nn]
  (if (>= n nn) 1
    (if (not (= (bx st n 0) 1)) (down st (+ n 1) nn)
      (let [p (nd st n 4)
            x (if (= p 65535) (bx st n 7) (+ (bx st p 1) (+ (bx st p 20) (+ (bx st p 16) (bx st n 7)))))
            y (if (= p 65535) (bx st n 21) (+ (bx st p 2) (+ (bx st p 17) (+ (bx st p 13) (bx st n 21)))))]
        (if (or (big? x) (big? y)) -18
          (down st (+ n (+ 1 (* 0 (+ (bx! st n 1 x) (bx! st n 2 y))))) nn))))))
(defn fk-run [w length inlen vw]
  (if (< length 61440) -1
    (let [st0 (kernel-subregion w length 0 61440)
          z0 (hd! st0 33 0)
          r (ck/ck-run w length (+ inlen (* 0 z0)))
          z1 (hd! st0 33 0)]
      (if (< r 0) r
        (let [b (bk/bk-run w length (+ vw (* 0 z1)))]
          (if (< b 0) b
            (let [st (kernel-subregion w length 0 61440)
                  f (up st (- (hd st 2) 1))]
              (if (< f 0) f
                (let [g (down st 0 (hd st 2))] (if (< g 0) g (hd st 2)))))))))))
(defn fk-off [w length] (if (>= length 61440) (hd (kernel-subregion w length 0 61440) 33) 0))
(defn fk-height [w length] (if (>= length 61440) (sx (hd (kernel-subregion w length 0 61440) 37)) -1))
(defn fk-word [w length n i]
  (if (and (>= length 61440) (and (>= n 0) (and (< n 128) (and (>= i 0) (< i 32)))))
    (bx (kernel-subregion w length 0 61440) n i)
    0))
