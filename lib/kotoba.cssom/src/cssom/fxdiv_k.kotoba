(ns cssom.fxdiv-k (:export [xd-pack xd-floor xd-rem]))
;; JUN-932 (JUN-920 follow-up), flex lines beyond four items, kernel dialect: the exact share of the free space,
;; R * w / W = F + f / W with F the floor and 0 <= f < W, by long division on 7-bit chunks of |R| (no 128-bit product,
;; no heap, no float). Same technique and the same contract as `share`/`dv` of flex_q6.kotoba, widened for sixteen items:
;;   W = the sum of the weights, W < 2^38 (sixteen shrink weights are at most 16 * 65535 * 262143 = 2.75e11 < 2^38),
;;   |R| < 2^23 (sixteen bases of at most 262143 plus a net of at most 524288 stay below 4.72e6; flex_q6 stopped at 2^21
;;   because four items cannot reach it), so |R| is cut into FOUR chunks (c3 below 4, then three of 7 bits).
;; Every product is below 2^46: c * w <= 127 W, and (remainder * 128) <= 128 W, so one step is below 255 W < 7.01e13 < 2^46.
;; xd-pack answers (F + 2^23) << 38 | f, or the invalid marker -2^62 outside the domain (W <= 0, w < 0, w > W, W >= 2^38,
;; |R| >= 2^23). The rounding of an item that is not frozen, F + (2 f >= W), is made by the caller (flex_k ev).
(defn- inval [] -4611686018427387904)
(defn- absv [x] (if (< x 0) (- 0 x) x))
;; one long-division step: the remainder before (r), the chunk (c), the weight (w) and the total (tw); returns q * 2^40 + the new remainder
(defn- step [r c w tw]
  (let [t (+ (* r 128) (* c w)) q (quot t tw)]
    (+ (* q 1099511627776) (- t (* q tw)))))
(defn- sq [s] (u64-shift-right s 40))
(defn- sr [s] (bit-and s 1099511627775))
(defn xd-pack [r w tw]
  (if (and (and (> tw 0) (< tw 274877906944)) (and (and (>= w 0) (<= w tw)) (< (absv r) 8388608)))
    (let [a (absv r)
          s3 (step 0 (u64-shift-right a 21) w tw)
          s2 (step (sr s3) (bit-and (u64-shift-right a 14) 127) w tw)
          s1 (step (sr s2) (bit-and (u64-shift-right a 7) 127) w tw)
          s0 (step (sr s1) (bit-and a 127) w tw)
          q (+ (* (+ (* (+ (* (sq s3) 128) (sq s2)) 128) (sq s1)) 128) (sq s0))
          r0 (sr s0)
          neg (< r 0)
          fl (if neg (- 0 (+ q (if (> r0 0) 1 0))) q)
          fr (if neg (if (> r0 0) (- tw r0) 0) r0)]
      (+ (i64-shift-left (+ fl 8388608) 38) fr))
    (inval)))
(defn xd-floor [d] (- (u64-shift-right d 38) 8388608))
(defn xd-rem [d] (bit-and d 274877906943))
