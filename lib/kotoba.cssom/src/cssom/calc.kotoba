(ns cssom.calc
  (:export [leaf-number leaf-px op-neg op-add op-sub op-mul op-div op-min op-max op-clamp
            valid? px? value-of peak-of wide?])
  (:schemas {:css.calc/node [:record :css.calc/node [[:valid :bool] [:px :bool] [:value :f64] [:peak :f64] [:wide :bool]]]}))

;; f64 reference (native macOS) for the calc() evaluator: a transcription of the unit and arithmetic rules of
;; `eval-calc-node` (lib/kotoba.cssom/src/cssom/core.cljk 977-1048 and layout.cljk 5694-5726). One function per AST node
;; kind, so a test builds the SAME tree the host parser would build and nests the calls:
;;   :num  -> leaf-number / leaf-px      :neg -> op-neg    :add -> op-add    :sub -> op-sub
;;   :mul  -> op-mul    :div -> op-div   :fn "min"/"max" (variadic, reduce) -> op-min / op-max applied pairwise
;;   :fn "clamp" -> op-clamp = (max lo (min v hi))     :fn "calc" -> the argument itself
;; Rules kept from the source: + - min max clamp need EQUAL units; * needs at least one plain number (the result takes the
;; other side's unit); / needs a plain-number, non-zero divisor (the dividend's unit); anything else is nil, here valid=false.
;; The oracle does not model overflow: every number is an f64.
;; The record carries two extra fields that are NOT CSS semantics but instrumentation for the Q6 comparison: `peak`
;; (the largest magnitude of any operand or intermediate, in Q6 raw units: px * 64, number * 10000) and `wide` (some
;; multiplication has no factor below 2^16 raw, so the Q6 module must refuse it). They let the test decide whether a Q6
;; refusal is justified by the Q6 domain.
(defn zero-node [] [:ref :css.calc/node] (record [:ref :css.calc/node] false false 0.0 0.0 false))
(defn scale [is-px :bool] :f64 (if is-px 64.0 10000.0))
(defn raw-mag [x :f64 is-px :bool] :f64 (f64-abs (f64-mul x (scale is-px))))
(defn fmax [a :f64 b :f64] :f64 (if (f64-gt a b) a b))
(defn leaf-number [raw :i64] [:ref :css.calc/node]
  (let [v (f64-div (i64-to-f64-rounded raw) 10000.0)]
    (record [:ref :css.calc/node] true false v (raw-mag v false) false)))
(defn leaf-px [raw :i64] [:ref :css.calc/node]
  (let [v (f64-mul (i64-to-f64-rounded raw) 0.015625)]
    (record [:ref :css.calc/node] true true v (raw-mag v true) false)))
(defn valid? [n [:ref :css.calc/node]] :bool (record-get [:ref :css.calc/node] n :valid))
(defn px? [n [:ref :css.calc/node]] :bool (record-get [:ref :css.calc/node] n :px))
(defn value-of [n [:ref :css.calc/node]] :f64 (record-get [:ref :css.calc/node] n :value))
(defn peak-of [n [:ref :css.calc/node]] :f64 (record-get [:ref :css.calc/node] n :peak))
(defn wide? [n [:ref :css.calc/node]] :bool (record-get [:ref :css.calc/node] n :wide))
(defn mk [is-px :bool v :f64 a [:ref :css.calc/node] b [:ref :css.calc/node] extra-wide :bool] [:ref :css.calc/node]
  (record [:ref :css.calc/node] true is-px v
          (fmax (fmax (peak-of a) (peak-of b)) (raw-mag v is-px))
          (or (or (wide? a) (wide? b)) extra-wide)))
(defn op-neg [a [:ref :css.calc/node]] [:ref :css.calc/node]
  (if (valid? a) (record [:ref :css.calc/node] true (px? a) (f64-sub 0.0 (value-of a)) (peak-of a) (wide? a)) (zero-node)))
(defn both-same [a [:ref :css.calc/node] b [:ref :css.calc/node]] :bool
  (and (and (valid? a) (valid? b)) (= (px? a) (px? b))))
(defn op-add [a [:ref :css.calc/node] b [:ref :css.calc/node]] [:ref :css.calc/node]
  (if (both-same a b) (mk (px? a) (f64-add (value-of a) (value-of b)) a b false) (zero-node)))
(defn op-sub [a [:ref :css.calc/node] b [:ref :css.calc/node]] [:ref :css.calc/node]
  (if (both-same a b) (mk (px? a) (f64-sub (value-of a) (value-of b)) a b false) (zero-node)))
(defn op-min [a [:ref :css.calc/node] b [:ref :css.calc/node]] [:ref :css.calc/node]
  (if (both-same a b) (mk (px? a) (if (f64-lt (value-of a) (value-of b)) (value-of a) (value-of b)) a b false) (zero-node)))
(defn op-max [a [:ref :css.calc/node] b [:ref :css.calc/node]] [:ref :css.calc/node]
  (if (both-same a b) (mk (px? a) (if (f64-gt (value-of a) (value-of b)) (value-of a) (value-of b)) a b false) (zero-node)))
(defn op-clamp [lo [:ref :css.calc/node] v [:ref :css.calc/node] hi [:ref :css.calc/node]] [:ref :css.calc/node]
  (op-max lo (op-min v hi)))
;; no factor below 2^16 raw: the Q6 product bound cannot be met
(defn wide-pair [a [:ref :css.calc/node] b [:ref :css.calc/node]] :bool
  (let [ra (raw-mag (value-of a) (px? a)) rb (raw-mag (value-of b) (px? b))]
    (not (or (and (f64-lt rb 65536.0) (not (f64-gt ra 1073741824.0))) (and (f64-lt ra 65536.0) (not (f64-gt rb 1073741824.0)))))))
(defn op-mul [a [:ref :css.calc/node] b [:ref :css.calc/node]] [:ref :css.calc/node]
  (if (and (valid? a) (valid? b))
    (cond (not (px? a)) (mk (px? b) (f64-mul (value-of a) (value-of b)) a b (wide-pair a b))
          (not (px? b)) (mk (px? a) (f64-mul (value-of a) (value-of b)) a b (wide-pair a b))
          :else (zero-node))
    (zero-node)))
(defn op-div [a [:ref :css.calc/node] b [:ref :css.calc/node]] [:ref :css.calc/node]
  (if (and (and (valid? a) (valid? b)) (and (not (px? b)) (or (f64-lt (value-of b) 0.0) (f64-gt (value-of b) 0.0))))
    (mk (px? a) (f64-div (value-of a) (value-of b)) a b false)
    (zero-node)))
