 ;; --- grid track sizing and item alignment ------------------------------
 ;;
 ;; The corpus already had a case per FLOW gap (auto-flow-column,
 ;; auto-rows, the gap longhands); these are the sizing and alignment rules
 ;; those cases depend on but never isolate, so a regression in one of them
 ;; would have shown up only as a mystery in a composite case.

 {:id :grid/auto-track-overflows-a-narrow-grid
  :group :grid
  ;; An `auto` track's floor is its items' MIN-content size, so two of them
  ;; holding 41.6px and 50.1px of unbreakable word overflow a 60px grid
  ;; rather than crushing to 30px each.
  :html "<div style=\"display: grid; grid-template-columns: auto auto; width: 60px\"><div>short</div><div>a much longer cell</div></div>"}

 {:id :grid/auto-track-beside-an-fr
  :group :grid
  ;; With an `fr` track competing for the leftover space, the `auto` track
  ;; stops at its own max-content instead of stretching -- the opposite of
  ;; what it does in :grid/auto-columns-size-to-content.
  :html "<div style=\"display: grid; grid-template-columns: auto 1fr; width: 400px\"><div>short</div><div>x</div></div>"}

 {:id :grid/auto-track-beside-a-fixed-one
  :group :grid
  :html "<div style=\"display: grid; grid-template-columns: auto 100px; width: 400px\"><div>short</div><div>x</div></div>"}

 {:id :grid/justify-items-end
  :group :grid
  :html "<div style=\"display: grid; grid-template-columns: 120px 120px; justify-items: end\"><div>a</div><div>bb</div></div>"}

 {:id :grid/justify-self-overrides-justify-items
  :group :grid
  ;; The item with `justify-self` shrinks and centres; its sibling keeps
  ;; the container's stretch and stays a full track wide.
  :html "<div style=\"display: grid; grid-template-columns: 120px 120px\"><div style=\"justify-self: center\">a</div><div>bb</div></div>"}

 {:id :grid/align-items-end
  :group :grid
  :html "<div style=\"display: grid; grid-template-columns: 80px; grid-template-rows: 60px; align-items: end\"><div>mid</div></div>"}

 {:id :grid/align-self-in-a-tall-row
  :group :grid
  :html "<div style=\"display: grid; grid-template-columns: 80px; grid-template-rows: 60px\"><div style=\"align-self: center\">mid</div></div>"}

 {:id :grid/auto-flow-column-fills-rows-first
  :group :grid
  ;; Two explicit rows and five items: the flow fills a COLUMN top to
  ;; bottom before moving right, so the third item starts a new column.
  :html "<div style=\"display: grid; grid-auto-flow: column; grid-template-rows: 30px 30px; grid-auto-columns: 70px\"><div>a</div><div>b</div><div>c</div><div>d</div><div>e</div></div>"}

 {:id :grid/auto-flow-column-past-the-template
  :group :grid
  ;; Column flow creates IMPLICIT columns beyond grid-template-columns;
  ;; with no grid-auto-columns they are `auto`.
  :html "<div style=\"display: grid; grid-auto-flow: column; grid-template-columns: 50px 50px\"><div>a</div><div>b</div><div>c</div><div>d</div></div>"}

 {:id :grid/gap-shorthand-two-values
  :group :grid
  ;; `gap: <row> <column>`, row first -- the same two numbers
  ;; :grid/separate-row-and-column-gap writes as longhands.
  :html "<div style=\"display: grid; grid-template-columns: 60px 60px; gap: 24px 8px\"><div>a</div><div>b</div><div>c</div><div>d</div></div>"}

 {:id :grid/auto-rows-beyond-the-template
  :group :grid
  :html "<div style=\"display: grid; grid-template-columns: 60px; grid-template-rows: 20px; grid-auto-rows: 40px\"><div>a</div><div>b</div><div>c</div></div>"}

 {:id :grid/implicit-rows-stretch-to-a-definite-height
  :group :grid
  ;; A definite container height with no `fr` row: the explicit 30px track
  ;; keeps its size and the two implicit `auto` rows share the rest.
  :html "<div style=\"display: grid; grid-template-columns: 60px; grid-template-rows: 30px; height: 200px\"><div>a</div><div>b</div><div>c</div></div>"}

 {:id :grid/auto-row-beside-an-fr-row
  :group :grid
  :html "<div style=\"display: grid; grid-template-columns: 60px; grid-template-rows: auto 1fr; height: 200px\"><div>a</div><div>b</div></div>"}

 {:id :grid/inline-grid-with-auto-tracks
  :group :grid
  :html "<p>before <span style=\"display: inline-grid; grid-template-columns: auto auto\"><span>aaa</span><span>bb</span></span> after</p>"}
 ;; ---- stacking: what is ON TOP where boxes overlap ---------------------
 ;;
 ;; The paint-order axis asks both sides which element is at a sample point
 ;; -- the only axis that sees ORDER rather than size. The corpus held four
 ;; stacking cases when that axis landed, so it was measuring mostly
 ;; incidental overlap from cases about something else. These exercise it
 ;; deliberately.

 {:id :stacking/later-sibling-covers-earlier
  :group :stacking
  ;; No z-index anywhere: document order alone decides where they overlap.
  :html "<div style=\"position: relative; height: 60px\"><div style=\"position: absolute; left: 0; top: 0; width: 80px; height: 40px; background: #f00\">a</div><div style=\"position: absolute; left: 40px; top: 0; width: 80px; height: 40px; background: #0f0\">b</div></div>"}

 {:id :stacking/z-index-beats-document-order
  :group :stacking
  ;; The EARLIER box wins because it asks to.
  :html "<div style=\"position: relative; height: 60px\"><div style=\"position: absolute; left: 0; top: 0; width: 80px; height: 40px; z-index: 2; background: #f00\">a</div><div style=\"position: absolute; left: 40px; top: 0; width: 80px; height: 40px; z-index: 1; background: #0f0\">b</div></div>"}

 {:id :stacking/positioned-covers-later-flow-content
  :group :stacking
  ;; LINE-AXIS BLIND. The two words overlap exactly, so the line axis is
  ;; being asked a question with no answer -- see the measurement below.
  ;; The case's real subject, which side is ON TOP, is scored by the
  ;; paint-order axis, and its boxes are scored by geometry; only the
  ;; ordering of two coincident words is excluded.
  ;;
  ;; Marked here rather than left failing because a permanently red case
  ;; that nobody may fix teaches the next reader nothing, while a marked
  ;; one carries why.
  :oracle/blind true
  ;; Position alone is enough to paint above in-flow content that follows.
  ;;
  ;; Its LINE-axis failure (`want ["over under"] got ["under over"]`) is
  ;; not an engine gap and was measured as such on 2026-08-04: every box
  ;; in this case agrees with the oracle, and both words sit at exactly
  ;; (0,0) -- they overlap, so there is no left-to-right order between
  ;; them to get right. cluster-lines sorts a line by `:left`, and with
  ;; the lefts equal each side keeps its own input order: DOM order for
  ;; the browser, draw-op (PAINT) order for the engine, where an
  ;; out-of-flow box correctly paints after the in-flow content it was
  ;; written before. Breaking the tie by the text itself was tried and
  ;; reverted -- it fixes this case and breaks :float/clear-left and
  ;; :float/float-after-text-in-its-container, whose float and the text
  ;; beside it also share a left and DO have a real order.
  :html "<div style=\"position: relative; height: 60px\"><div style=\"position: absolute; left: 0; top: 0; width: 200px; height: 30px; background: #f00\">over</div><p>under</p></div>"}

 {:id :stacking/nested-positioned-child-over-parents-sibling
  :group :stacking
  :html "<div style=\"position: relative; height: 80px\"><div style=\"position: absolute; left: 0; top: 0; width: 100px; height: 30px; background: #eee\"><div style=\"position: absolute; left: 20px; top: 10px; width: 100px; height: 40px; background: #f00\">inner</div></div><div style=\"position: absolute; left: 60px; top: 20px; width: 60px; height: 30px; background: #0f0\">sib</div></div>"}

 {:id :stacking/float-under-later-inline-text
  :group :stacking
  ;; A float is out of flow for LAYOUT but still painted under the line
  ;; boxes that flow beside it.
  :html "<div style=\"width: 200px\"><span style=\"float: left; width: 60px; height: 40px; background: #eee\">f</span>text that flows beside the float and wraps under it</div>"}

 {:id :stacking/inline-background-under-following-text
  :group :stacking
  :html "<p style=\"width: 200px\">before <span style=\"background: #eee\">highlighted run</span> after</p>"}

 {:id :stacking/table-cell-content-over-row-background
  :group :stacking
  :html "<table style=\"width: 200px\"><tr style=\"background: #eee\"><td>cell one</td><td>cell two</td></tr></table>"}

 ;; ---- CSS transforms, and other properties with no case at all ---------
 ;;
 ;; `transform` appeared nowhere in this engine (the only match in the
 ;; source was `text-transform`, an unrelated property) and nowhere in this
 ;; corpus, so the size of the gap was unknown. A transform changes what
 ;; `getBoundingClientRect` reports, so it IS measurable on the geometry
 ;; axis -- these six cases were added to find out how much was missing,
 ;; and all six failed.
 ;;
 ;; All six PASS as of 2026-08-04 (see cssom.layout's `---- CSS transforms
 ;; ----` section): the six of them are the whole of the geometry axis's
 ;; 1224 -> 1230 boxes and 308 -> 314 clean cases that round. The four
 ;; cases below them were added at the same time, from the twenty-three
 ;; further shapes measured in Brave while implementing it -- composition
 ;; order, `transform-origin`, a flex item, and the one shape that must NOT
 ;; move.

 {:id :transform/translate-moves-the-box
  :group :transform
  :html "<div style=\"width: 400px; height: 40px\"><div style=\"width: 100px; height: 20px; transform: translate(30px, 10px)\">moved</div></div>"}

 {:id :transform/translate-does-not-affect-siblings
  :group :transform
  ;; A transform is a paint-time operation: the following sibling stays
  ;; where the untransformed box left it.
  :html "<div style=\"width: 400px\"><div style=\"height: 20px; transform: translateX(50px)\">a</div><div style=\"height: 20px\">b</div></div>"}

 {:id :transform/scale-changes-the-reported-box
  :group :transform
  ;; getBoundingClientRect reports the VISUAL box, so a 2x scale doubles
  ;; the reported width and height around the centre.
  :html "<div style=\"width: 400px; height: 60px\"><div style=\"width: 100px; height: 20px; transform: scale(2)\">big</div></div>"}

 {:id :transform/percentage-translate-is-of-the-box
  :group :transform
  ;; Unlike almost every other percentage in CSS, a translate percentage
  ;; resolves against the ELEMENT's own size, not the containing block.
  :html "<div style=\"width: 400px; height: 40px\"><div style=\"width: 100px; height: 20px; transform: translateX(50%)\">half</div></div>"}

 {:id :transform/rotate-grows-the-reported-box
  :group :transform
  ;; A 45-degree rotation of a 100x20 box reports a larger axis-aligned
  ;; bounding box than the box itself.
  :html "<div style=\"width: 400px; height: 120px\"><div style=\"width: 100px; height: 20px; transform: rotate(45deg)\">turn</div></div>"}

 {:id :transform/on-an-inline-block
  :group :transform
  :html "<p style=\"width: 400px\">before <span style=\"display: inline-block; width: 60px; transform: translateY(-4px)\">up</span> after</p>"}

 {:id :transform/not-on-a-non-replaced-inline
  :group :transform
  ;; The companion to the case above, and the only one here that measures
  ;; a transform NOT happening. CSS applies `transform` to transformable
  ;; elements, which excludes a non-replaced inline box: this span
  ;; COMPUTES matrix(1, 0, 0, 1, 30, 0) and sits at exactly the x an
  ;; untransformed span sits at.
  :html "<p style=\"width: 400px\">before <span style=\"transform: translateX(30px)\">span</span> after</p>"}

 {:id :transform/functions-compose-in-order
  :group :transform
  ;; A transform list is one composed matrix, and the leftmost function is
  ;; the outermost: `translate(...) scale(2)` leaves the translation alone
  ;; where `scale(2) translate(...)` doubles it. Same two functions, two
  ;; different boxes.
  :html "<div style=\"width: 400px; height: 120px\"><div style=\"width: 100px; height: 20px; transform: translate(10px, 10px) scale(2)\">a</div><div style=\"width: 100px; height: 20px; transform: scale(2) translate(10px, 10px)\">b</div></div>"}

 {:id :transform/origin-moves-the-fixed-point
  :group :transform
  ;; `transform-origin` is the point the transform holds still. The
  ;; initial value is the box's own centre, which is why
  ;; `scale-changes-the-reported-box` above grows in both directions;
  ;; `0 0` pins the top-left corner instead and it grows only right/down.
  :html "<div style=\"width: 400px; height: 120px\"><div style=\"width: 100px; height: 20px; transform: scale(2); transform-origin: 0 0\">o</div></div>"}

 {:id :transform/on-a-flex-item
  :group :transform
  ;; A transform is paint-time in a flex container too: the middle item
  ;; paints 20px right of where flex placed it, and the third item stays
  ;; exactly where the middle item's UNtransformed box left it.
  :html "<div style=\"width: 400px; display: flex\"><div style=\"width: 50px; height: 20px\">a</div><div style=\"width: 50px; height: 20px; transform: translateX(20px)\">b</div><div style=\"width: 50px; height: 20px\">c</div></div>"}

 ;; Properties that likewise have no case. Each is common enough in real
 ;; pages that not knowing whether this engine handles it is itself a gap.

 {:id :block/menu-is-an-indented-list
  :group :block
  ;; `<menu>` is the legacy list container, and a browser gives it exactly
  ;; `<ul>`'s box: `margin: 1em 0` and a 40px indent.
  :html "<div style=\"width: 400px\"><menu><li>one</li><li>two</li></menu></div>"}

 {:id :block/figure-has-side-margins
  :group :block
  ;; `figure { margin: 1em 40px }` -- the same rule as `<blockquote>`,
  ;; and the half of it this engine had was the 1em.
  :html "<div style=\"width: 400px\"><figure>a caption-less figure</figure></div>"}

 {:id :block/hr-is-its-own-border
  :group :block
  ;; An `<hr>` has no content at all: its whole box is `margin: 0.5em 0`
  ;; around a 1px border on each side, so it is 2px tall. Deliberately
  ;; ALONE in its container -- between two paragraphs the neighbours'
  ;; larger margins collapse over its own and hide the difference.
  :html "<div style=\"width: 400px\"><hr></div>"}

 {:id :sizing/aspect-ratio-derives-the-height
  :group :sizing
  :html "<div style=\"width: 400px\"><div style=\"width: 120px; aspect-ratio: 3 / 1; background: #eee\">box</div></div>"}

 ;; ...and the rest of `aspect-ratio`, because one case can only show that
 ;; the property is read at all. Each of these isolates ONE thing the
 ;; ratio has to lose to, or one form of it a parser can get wrong.

 {:id :sizing/aspect-ratio-loses-to-a-declared-height
  :group :sizing
  ;; Both axes are already declared, so the ratio has nothing to solve
  ;; for and is simply not applied: 120x70, not 120x40.
  :html "<div style=\"width: 400px\"><div style=\"width: 120px; height: 70px; aspect-ratio: 3 / 1\">box</div></div>"}

 {:id :sizing/aspect-ratio-derives-the-width
  :group :sizing
  ;; The other direction: a definite height and an auto width make the
  ;; ratio supply the width, so this block is 180 wide inside a 400px
  ;; parent rather than filling it.
  :html "<div style=\"width: 400px\"><div style=\"height: 60px; aspect-ratio: 3 / 1\">box</div></div>"}

 {:id :sizing/aspect-ratio-auto-is-no-ratio
  :group :sizing
  ;; `auto` on a non-replaced element leaves the height content-driven.
  :html "<div style=\"width: 400px\"><div style=\"width: 120px; aspect-ratio: auto\">box</div></div>"}

 {:id :sizing/aspect-ratio-auto-and-a-ratio
  :group :sizing
  ;; The two-value `auto <ratio>` form. With no natural ratio to prefer,
  ;; the declared one applies -- the same 40px height as the bare form.
  :html "<div style=\"width: 400px\"><div style=\"width: 120px; aspect-ratio: auto 3 / 1\">box</div></div>"}

 {:id :sizing/aspect-ratio-single-number
  :group :sizing
  ;; `<number>` with the `/ <number>` omitted is that number over 1.
  :html "<div style=\"width: 400px\"><div style=\"width: 120px; aspect-ratio: 1.5\">box</div></div>"}

 {:id :sizing/aspect-ratio-yields-to-content
  :group :sizing
  ;; A ratio-sized box with visible overflow has an automatic MINIMUM
  ;; size in the ratio-dependent axis: the content wins when it is
  ;; taller, so this is six lines tall and not the 13px 40/3 asks for.
  :html "<div style=\"width: 400px\"><div style=\"width: 40px; aspect-ratio: 3 / 1\">a much longer content string here</div></div>"}

 {:id :sizing/aspect-ratio-under-max-height
  :group :sizing
  ;; min-height/max-height clamp the ratio's answer like any other.
  :html "<div style=\"width: 400px\"><div style=\"width: 120px; aspect-ratio: 3 / 1; max-height: 20px\">box</div></div>"}

 {:id :sizing/aspect-ratio-in-a-flex-item
  :group :sizing
  ;; A flex item's cross size normally stretches to the line; a ratio and
  ;; a definite main size make it 40 instead.
  :html "<div style=\"width: 400px; display: flex\"><div style=\"width: 120px; aspect-ratio: 3 / 1\">box</div><div>s</div></div>"}

 {:id :sizing/aspect-ratio-with-padding
  :group :sizing
  ;; The ratio governs the box `box-sizing` names: with the default
  ;; content-box it relates the CONTENT boxes, so this is 140x60.
  :html "<div style=\"width: 400px\"><div style=\"width: 120px; aspect-ratio: 3 / 1; padding: 10px\">box</div></div>"}

 {:id :sizing/aspect-ratio-derives-a-flex-item-main-size
  :group :sizing
  ;; The cross axis is the definite one here, so the ratio runs the other
  ;; way and gives the item its MAIN size: 90 wide for a 30px-tall item.
  :html "<div style=\"width: 400px; display: flex\"><div style=\"height: 30px; aspect-ratio: 3 / 1\">box</div><div>s</div></div>"}

 {:id :sizing/aspect-ratio-on-an-absolute-box
  :group :sizing
  ;; An absolutely positioned box sizes itself, and the ratio applies
  ;; there too -- 120x40 inside a 100px-tall containing block.
  :html "<div style=\"width: 400px; position: relative; height: 100px\"><div style=\"position: absolute; width: 120px; aspect-ratio: 3 / 1\">box</div></div>"}

 {:id :sizing/aspect-ratio-over-a-percentage-width
  :group :sizing
  ;; The ratio consumes the RESOLVED width, not the declared one: 50% of
  ;; 400 is 200, and 200/4 is 50.
  :html "<div style=\"width: 400px\"><div style=\"width: 50%; aspect-ratio: 4 / 1\">box</div></div>"}

 {:id :sizing/aspect-ratio-with-no-width-at-all
  :group :sizing
  ;; Neither axis is declared: the block still fills its containing block
  ;; in the inline axis first, and only then does the ratio derive the
  ;; height from it -- 400 wide and a third of that tall.
  :html "<div style=\"width: 400px\"><div style=\"aspect-ratio: 3 / 1\">box</div></div>"}

 {:id :sizing/min-height-wins-over-content
  :group :sizing
  :html "<div style=\"width: 400px\"><div style=\"min-height: 60px\">short</div></div>"}

 {:id :overflow/text-overflow-ellipsis-keeps-one-line
  :group :overflow
  ;; LINE-AXIS BLIND, and in the opposite direction from generated content:
  ;; the browser keeps the whole string in the DOM and paints the ellipsis
  ;; at paint time, so the oracle's Range reads "a very long label indeed";
  ;; this engine has to truncate to emit a text op at all, so it reports
  ;; "a very lon…". Both are right for what they are, and comparing them
  ;; compares a DOM to a rendering. Geometry and paint order still score.
  :oracle/blind true
  :html "<div style=\"width: 90px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis\">a very long label indeed</div>"}

 {:id :text/white-space-pre-wrap-keeps-runs
  :group :text
  :html "<div style=\"width: 200px; white-space: pre-wrap\">two  spaces\nand a newline that wraps eventually</div>"}

 {:id :text/visibility-hidden-keeps-the-box
  :group :text
  ;; `visibility: hidden` still occupies space, unlike `display: none`.
  :html "<div style=\"width: 400px\"><div style=\"visibility: hidden; height: 20px\">gone</div><div style=\"height: 20px\">after</div></div>"}

 ;; ---------------------------------------------------------------------
 ;; MULTI-COLUMN (added 2026-08-05). Entirely new territory: `column-count`
 ;; appears nowhere in src/, and the only `column-gap` there is the GRID/
 ;; FLEX longhand. These cases say how large that gap is rather than
 ;; asserting it exists.
 ;; ---------------------------------------------------------------------

 {:id :multicol/column-count-two-balances
  :group :multicol
  ;; 300px across a 20px gap is two 140px columns; four 30px blocks
  ;; balance two-and-two, so `c` starts a new column at x=160,y=0.
  :html "<div style=\"width: 300px; column-count: 2; column-gap: 20px\"><div style=\"height: 30px\">a</div><div style=\"height: 30px\">b</div><div style=\"height: 30px\">c</div><div style=\"height: 30px\">d</div></div>"}

 {:id :multicol/column-count-three
  :group :multicol
  :html "<div style=\"width: 320px; column-count: 3; column-gap: 10px\"><div style=\"height: 20px\">a</div><div style=\"height: 20px\">b</div><div style=\"height: 20px\">c</div></div>"}

 {:id :multicol/column-width-derives-the-count
  :group :multicol
  ;; No `column-count`: the used count is how many `column-width` columns
  ;; plus gaps fit the available inline size -- 300/(100+10) rounds to 2.
  :html "<div style=\"width: 300px; column-width: 100px; column-gap: 10px\"><div style=\"height: 30px\">a</div><div style=\"height: 30px\">b</div></div>"}

 {:id :multicol/column-gap-normal-is-1em
  :group :multicol
  ;; `column-gap: normal` on a multicol box is 1em -- 14px here, unlike
  ;; the 0 it means on a grid or flex container.
  :html "<div style=\"width: 300px; font-size: 14px; column-count: 2\"><div style=\"height: 30px\">a</div><div style=\"height: 30px\">b</div></div>"}

 {:id :multicol/column-rule-takes-no-space
  :group :multicol
  ;; A column rule is painted INSIDE the gap and does not widen it, so the
  ;; columns are exactly where they are without one.
  :html "<div style=\"width: 300px; column-count: 2; column-gap: 20px; column-rule: 4px solid #888\"><div style=\"height: 30px\">a</div><div style=\"height: 30px\">b</div></div>"}

 {:id :multicol/a-block-splits-across-the-column-boundary
  :group :multicol
  ;; The FIRST block is the one that splits, not the second -- this
  ;; comment said otherwise until 2026-08-06, when fragmentation landed
  ;; and the case was measured properly. The used column height is 25 (the
  ;; smallest at which the flow fits in two columns, cutting in the empty
  ;; band below the first block's line), so the 30px block is cut there:
  ;; rects [0,0,140,25] and [160,0,140,5], and getBoundingClientRect
  ;; reports their union [0,0,300,25], spanning both columns. The 20px
  ;; block then starts at y=5 in column two.
  :html "<div style=\"width: 300px; height: 40px; column-count: 2; column-gap: 20px\"><div style=\"height: 30px\">a</div><div style=\"height: 20px\">b</div></div>"}

 {:id :multicol/break-inside-avoid-moves-the-whole-block
  :group :multicol
  ;; The same block with `break-inside: avoid` -- which, measured, makes NO
  ;; difference here: a 20px block holding a 20px line is unbreakable
  ;; either way, so this case and the one above read identically in Brave.
  ;; It is kept as the pair it was authored as, and
  ;; :multicol/break-inside-avoid-moves-a-whole-wrapper below is the shape
  ;; that actually discriminates.
  :html "<div style=\"width: 300px; height: 40px; column-count: 2; column-gap: 20px\"><div style=\"height: 30px\">a</div><div style=\"height: 20px; break-inside: avoid\">b</div></div>"}

 {:id :multicol/column-span-all-interrupts-the-columns
  :group :multicol
  :html "<div style=\"width: 300px; column-count: 2; column-gap: 20px\"><div style=\"height: 20px\">a</div><h3 style=\"column-span: all; margin: 0; height: 20px\">H</h3><div style=\"height: 20px\">b</div></div>"}

 {:id :multicol/text-flows-into-the-column-width
  :group :multicol
  ;; The LINE axis's own view of multicol: the lines are broken at the
  ;; COLUMN's inline size (140px), not the container's 300px.
  :html "<div style=\"width: 300px; column-count: 2; column-gap: 20px\">one two three four five six seven eight nine ten</div>"}

 {:id :multicol/fixed-height-adds-columns-sideways
  :group :multicol
  ;; A multicol box with a definite height and more content than fits
  ;; overflows in the INLINE direction, past its own right edge.
  :html "<div style=\"width: 200px; height: 40px; column-count: 2; column-gap: 20px\"><div style=\"height: 40px\">a</div><div style=\"height: 40px\">b</div><div style=\"height: 40px\">c</div></div>"}

 {:id :multicol/column-fill-auto-fills-the-first-column
  :group :multicol
  ;; `column-fill: auto` fills each column to the box's height before
  ;; starting the next, instead of balancing.
  :html "<div style=\"width: 300px; height: 60px; column-count: 2; column-gap: 20px; column-fill: auto\"><div style=\"height: 30px\">a</div><div style=\"height: 30px\">b</div><div style=\"height: 30px\">c</div></div>"}

 {:id :multicol/padding-is-outside-the-columns
  :group :multicol
  ;; The columns divide the CONTENT box. `width: 300px` with the default
  ;; `content-box` sizing IS 300 of content (the padding is outside it, in
  ;; a 320px border box), so the gap leaves two 140px columns -- and they
  ;; start at x=10, inside the padding, which is the half that would be
  ;; wrong if the columns divided the border box. Measured: x=10/w=140 and
  ;; x=170/w=140. (This comment said 130 until 2026-08-05, from subtracting
  ;; the padding from a `width` that never included it; the numbers the
  ;; harness compares against always came from the browser, so nothing was
  ;; ever scored against the wrong ones.)
  :html "<div style=\"width: 300px; padding: 10px; column-count: 2; column-gap: 20px\"><div style=\"height: 30px\">a</div><div style=\"height: 30px\">b</div></div>"}

 ;; ---------------------------------------------------------------------
 ;; position: sticky. The corpus had one case, and it covered the
 ;; unscrolled default -- which layout.cljc is explicitly right about. A
 ;; sticky box can be STUCK with no scrolling at all if it is anchored to
 ;; the far edge of a scrollport it starts below, which is what these
 ;; measure.
 ;; ---------------------------------------------------------------------

 {:id :position/sticky-bottom-is-stuck-at-scroll-zero
  :group :position
  ;; The sticky box's flow position (y=100) is below the 60px scrollport,
  ;; so `bottom: 0` pulls it UP to sit on the scrollport's bottom edge --
  ;; a stuck sticky box that needs no scroll to observe.
  :html "<div style=\"width: 300px; height: 60px; overflow: auto\"><div style=\"height: 100px\">a</div><div style=\"position: sticky; bottom: 0; height: 20px\">s</div><div style=\"height: 40px\">b</div></div>"}

 {:id :position/sticky-is-clamped-by-its-containing-block
  :group :position
  ;; Same pull, but the sticky box may not leave its containing block:
  ;; `bottom: 0` asks for y=40 and the 60px-tall parent starting at y=80
  ;; allows only y=80.
  :html "<div style=\"width: 300px; height: 60px; overflow: auto\"><div style=\"height: 80px\">a</div><div style=\"height: 60px\"><div style=\"height: 20px\">x</div><div style=\"position: sticky; bottom: 0; height: 20px\">s</div></div><div style=\"height: 100px\">b</div></div>"}

 {:id :overflow/nowrap-inline-blocks-do-not-wrap
  :group :overflow
  ;; The control for :position/sticky-right-in-a-horizontal-scroller
  ;; below: the same two inline-blocks WITHOUT the sticky, so that case's
  ;; delta can be attributed to `sticky` and not to `white-space: nowrap`
  ;; inside a scroll container.
  :html "<div style=\"width: 200px; overflow: auto; white-space: nowrap\"><span style=\"display: inline-block; width: 300px\">a</span><span style=\"display: inline-block; width: 40px\">s</span></div>"}

 {:id :position/sticky-right-in-a-horizontal-scroller
  :group :position
  ;; The same mechanism in the inline axis: an inline-block whose flow x
  ;; is past the scrollport's right edge is pulled back to it.
  :html "<div style=\"width: 200px; overflow: auto; white-space: nowrap\"><span style=\"display: inline-block; width: 300px\">a</span><span style=\"display: inline-block; position: sticky; right: 0; width: 40px\">s</span></div>"}

 {:id :position/sticky-with-no-inset-never-moves
  :group :position
  ;; A sticky box with NO inset property has no anchor edge and is
  ;; therefore always at its flow position, scrolled or not.
  :html "<div style=\"width: 300px; height: 60px; overflow: auto\"><div style=\"height: 100px\">a</div><div style=\"position: sticky; height: 20px\">s</div><div style=\"height: 40px\">b</div></div>"}

 ;; ---------------------------------------------------------------------
 ;; Interactive / metadata elements: what a UA renders without any script.
 ;; ---------------------------------------------------------------------

 {:id :interactive/details-closed-shows-only-the-summary
  :group :interactive
  ;; LINE-AXIS BLIND, for the `text-overflow: ellipsis` reason applied to a
  ;; different mechanism: measured in Brave (2026-08-05) a CLOSED <details>
  ;; still LAYS OUT its content -- the <p> reports a real 300x20 box at
  ;; y=34 and a Range reads "Body" out of it -- and merely never PAINTS it
  ;; (Chromium hides `::details-content` with `content-visibility: hidden`,
  ;; not `display: none`; the <details> box itself is 20px tall either
  ;; way). This engine emits draw-ops, so a box it does not paint is a box
  ;; it cannot report. Comparing the two on text compares a DOM to a
  ;; rendering. Geometry and paint order still score, and the box-count
  ;; difference that leaves is the finding.
  :oracle/blind true
  :html "<div style=\"width: 300px\"><details><summary>More</summary><p>Body</p></details><div style=\"height: 20px\">after</div></div>"}

 {:id :interactive/details-open-shows-the-body
  :group :interactive
  :html "<div style=\"width: 300px\"><details open><summary>More</summary><p>Body</p></details><div style=\"height: 20px\">after</div></div>"}

 {:id :interactive/details-with-no-summary
  :group :interactive
  ;; A `<details>` with no `<summary>` gets a UA-generated one; its own
  ;; children are still hidden while closed.
  ;;
  ;; PAINT AGREES since 2026-08-06 (10 sample points, the largest single
  ;; paint residual the corpus had); GEOMETRY does not, and cannot. Brave
  ;; reports the closed `<p>` as a real 300x20 box at y=34 and never
  ;; paints it -- Chromium hides a closed `<details>`'s content with
  ;; `content-visibility: hidden`, not `display: none` -- and an engine
  ;; that emits draw-ops cannot report a box it does not paint. That is
  ;; the same limit `:interactive/details-closed-shows-only-the-summary`
  ;; already records, and it is the ONLY box left disagreeing here: the
  ;; `<details>` itself, the wrapper and the `after` div all land.
  ;;
  ;; The generated summary is SHADOW content: measured with
  ;; `elementsFromPoint`, every interior point of the box reports
  ;; `DETAILS` rather than `SUMMARY`, so the engine reserves a band and
  ;; emits no `summary` element box -- see `details-summary-band`.
  :oracle/blind true
  :html "<div style=\"width: 300px\"><details><p>Body</p></details><div style=\"height: 20px\">after</div></div>"}

 {:id :interactive/summary-is-a-block
  :group :interactive
  ;; `<summary>` computes to `display: list-item` in the UA sheet, so it
  ;; is a full-width block row, not an inline.
  :html "<div style=\"width: 300px\"><details open><summary>More</summary><span>tail</span></details></div>"}

 {:id :interactive/dialog-without-open-is-not-rendered
  :group :interactive
  :html "<div style=\"width: 300px\"><dialog>Hidden</dialog><div style=\"height: 20px\">after</div></div>"}

 {:id :interactive/dialog-open-is-a-bordered-block
  :group :interactive
  ;; An open non-modal `<dialog>` is absolutely positioned, `width:
  ;; fit-content`, `margin: auto`, with the UA's `border: solid` and
  ;; `padding: 1em`.
  :html "<div style=\"width: 300px; position: relative; height: 80px\"><dialog open>Hi</dialog></div>"}

 {:id :interactive/template-generates-nothing
  :group :interactive
  ;; `<template>` content is a separate DocumentFragment: it is not in the
  ;; rendered tree at all, and the `<template>` element itself is
  ;; `display: none`.
  :html "<div style=\"width: 300px\"><template><p>never</p></template><div style=\"height: 20px\">after</div></div>"}

 {:id :interactive/hidden-attribute-is-display-none
  :group :interactive
  :html "<div style=\"width: 300px\"><div hidden>gone</div><div style=\"height: 20px\">after</div></div>"}

 {:id :interactive/display-beats-the-hidden-attribute
  :group :interactive
  ;; `[hidden] { display: none }` is a UA rule, so any author `display`
  ;; wins on specificity and the element renders.
  :html "<div style=\"width: 300px\"><div hidden style=\"display: block; height: 20px\">shown</div><div style=\"height: 20px\">after</div></div>"}

 ;; ---------------------------------------------------------------------
 ;; Tables: the parts the existing 25 cases never entered.
 ;; ---------------------------------------------------------------------

 {:id :table/nested-table-in-a-cell
  :group :table
  :html "<table style=\"width: 300px; border-collapse: collapse\"><tr><td>outer<table style=\"width: 100px; border-collapse: collapse\"><tr><td>in</td><td>ner</td></tr></table></td><td>right</td></tr></table>"}

 {:id :table/caption-side-bottom
  :group :table
  :html "<table style=\"width: 200px; caption-side: bottom\"><caption>Cap</caption><tr><td>a</td><td>b</td></tr></table>"}

 {:id :table/colgroup-span-sizes-two-columns
  :group :table
  :html "<table style=\"width: 300px\"><colgroup span=\"2\" style=\"width: 60px\"></colgroup><colgroup><col style=\"width: 120px\"></colgroup><tr><td>a</td><td>b</td><td>c</td></tr></table>"}

 {:id :table/table-layout-fixed-overflowing-content
  :group :table
  ;; `table-layout: fixed` sizes columns from the first row alone and does
  ;; NOT widen for content, so the long cell overflows its column.
  :html "<table style=\"width: 200px; table-layout: fixed\"><tr><td style=\"width: 40px\">averylongunbreakableword</td><td>b</td></tr></table>"}

 {:id :table/empty-cells-hide
  :group :table
  ;; `empty-cells: hide` suppresses the BORDER and background of an empty
  ;; cell under `border-separate`; the cell still occupies its slot.
  ;;
  ;; NOT IMPLEMENTED, and measured to be unscoreable by this harness rather
  ;; than assumed to be. Brave 151 (2026-08-05), this table with `hide` and
  ;; with `show`: identical boxes to three decimals (128.625 / 59.375 here,
  ;; and 153.813 / 34.188 on the background spelling), and
  ;; `elementFromPoint` answers `td` over the empty cell either way. The
  ;; property changes which pixels are FILLED, and neither the geometry
  ;; axis nor the paint-order axis compares a fill. The case stays in
  ;; because it is the only thing standing between "we do not implement
  ;; empty-cells" and someone implementing it as a layout change.
  ;;
  ;; Its one-point paint-order residual is not this property either: Brave
  ;; hit-tests every element from ONE PIXEL ABOVE and LEFT of its box.
  ;; Swept at 0.05px on this table (`td` at y=4..26), `elementFromPoint`
  ;; answers `table` at y=3.00 and `td` from y=3.05, and stops at y=26.00
  ;; exactly -- and the same 1px slop appears on a plain `<p>` in a padded
  ;; `<div>` (box at y=36, hit from y=35.05) and on a bare `<span>`, in x
  ;; as well as y. It is a property of `elementFromPoint`, not of tables,
  ;; and this engine's own half-open [x, x+w) test is the honest answer to
  ;; the question the axis asks. Whether a sample point lands inside that
  ;; 1px band depends on where the case happens to sit on the corpus page.
  :html "<table style=\"width: 200px; border-spacing: 4px; empty-cells: hide\"><tr><td style=\"border: 2px solid #888\">a</td><td style=\"border: 2px solid #888\"></td></tr></table>"}

 {:id :table/tfoot-renders-after-tbody
  :group :table
  ;; Written before the `<tbody>`, painted after it: row-group order is
  ;; thead, tbody, tfoot regardless of source order.
  :html "<table style=\"width: 200px\"><tfoot><tr><td>foot</td></tr></tfoot><tbody><tr><td>body</td></tr></tbody></table>"}

 {:id :table/col-width-sizes-a-column
  :group :table
  ;; A bare `<col>` with no `<colgroup>` around it. Two separate things are
  ;; measured: whether the declared 200px survives the table's surplus
  ;; hand-out, and whether the parser synthesises the implicit
  ;; `<colgroup>` a real HTML parser inserts. The second half was an
  ;; htmldom finding rather than a cssom one, and was fixed THERE
  ;; (`maybe-insert-implied-table-structure`, 2026-08-05): Brave wraps
  ;; consecutive bare `<col>`s in ONE synthesised `<colgroup>`, and puts
  ;; one that arrives after a row group in a group of its own beside it.
  :html "<table style=\"width: 300px\"><col style=\"width: 200px\"><col><tr><td>a</td><td>b</td></tr></table>"}

 {:id :table/cell-percentage-width
  :group :table
  :html "<table style=\"width: 300px\"><tr><td style=\"width: 25%\">a</td><td>b</td></tr></table>"}

 ;; ---------------------------------------------------------------------
 ;; Intrinsic sizes, and min/max clamps where a flex or grid item is what
 ;; is being clamped.
 ;; ---------------------------------------------------------------------

 {:id :sizing/min-width-on-a-flex-item
  :group :sizing
  ;; The item would shrink below 80; `min-width` floors it and the other
  ;; item absorbs the loss.
  :html "<div style=\"width: 200px; display: flex\"><div style=\"flex: 1; min-width: 150px\">a</div><div style=\"flex: 1\">b</div></div>"}

 {:id :sizing/max-width-on-a-flex-item
  :group :sizing
  :html "<div style=\"width: 300px; display: flex\"><div style=\"flex: 1; max-width: 60px\">a</div><div style=\"flex: 1\">b</div></div>"}

 {:id :sizing/min-width-auto-floors-a-flex-item
  :group :sizing
  ;; A flex item's `min-width` is `auto`, which resolves to its
  ;; MIN-CONTENT size -- the reason a long unbreakable word makes a flex
  ;; row overflow instead of shrinking.
  :html "<div style=\"width: 200px; display: flex\"><div style=\"flex: 1\">averylongunbreakableword</div><div style=\"flex: 1\">b</div></div>"}

 {:id :sizing/overflow-hidden-releases-the-flex-floor
  :group :sizing
  ;; `overflow: hidden` changes the automatic minimum size to zero, so the
  ;; same item now shrinks as asked.
  :html "<div style=\"width: 200px; display: flex\"><div style=\"flex: 1; overflow: hidden\">averylongunbreakableword</div><div style=\"flex: 1\">b</div></div>"}

 {:id :sizing/max-width-on-a-grid-item
  :group :sizing
  :html "<div style=\"width: 300px; display: grid; grid-template-columns: 1fr 1fr\"><div style=\"max-width: 40px\">a</div><div>b</div></div>"}

 {:id :sizing/min-width-min-content
  :group :sizing
  :html "<div style=\"width: 300px\"><div style=\"width: min-content\">alpha beta</div></div>"}

 {:id :sizing/width-max-content
  :group :sizing
  :html "<div style=\"width: 300px\"><div style=\"width: max-content\">alpha beta</div></div>"}

 {:id :sizing/width-fit-content
  :group :sizing
  ;; `fit-content` is min(max-content, max(min-content, available)) -- 300
  ;; is wider than the max-content here, so this is the max-content size.
  :html "<div style=\"width: 300px\"><div style=\"width: fit-content\">alpha beta</div></div>"}

 {:id :sizing/fit-content-clamped-by-the-container
  :group :sizing
  :html "<div style=\"width: 60px\"><div style=\"width: fit-content\">alpha beta gamma</div></div>"}

 {:id :sizing/max-width-percentage
  :group :sizing
  :html "<div style=\"width: 300px\"><div style=\"max-width: 40%; height: 20px\">a</div></div>"}

 {:id :sizing/min-height-on-a-flex-item-cross-axis
  :group :sizing
  :html "<div style=\"width: 300px; display: flex; align-items: flex-start\"><div style=\"min-height: 50px\">a</div><div>b</div></div>"}

 ;; ---------------------------------------------------------------------
 ;; gap, across the three box types that take one.
 ;; ---------------------------------------------------------------------

 {:id :gap/percentage-column-gap-on-a-grid
  :group :gap
  ;; A percentage gap resolves against the container's own content-box
  ;; size in that axis: 10% of 300 is 30.
  :html "<div style=\"width: 300px; display: grid; grid-template-columns: 1fr 1fr; column-gap: 10%\"><div style=\"height: 20px\">a</div><div style=\"height: 20px\">b</div></div>"}

 {:id :gap/percentage-row-gap-on-a-grid
  :group :gap
  ;; The BLOCK axis is the cyclic one: measured in Brave, a 10% row gap on
  ;; a 40px-tall auto-height grid is 4px -- resolved against the grid's own
  ;; content height, arrived at by laying the grid out once with a zero
  ;; gap. This engine reads "10%" through parse-int and gets 10px, which is
  ;; the same defect as the inline-axis case above, not a second one.
  :html "<div style=\"width: 300px; display: grid; grid-template-columns: 1fr; row-gap: 10%\"><div style=\"height: 20px\">a</div><div style=\"height: 20px\">b</div></div>"}

 {:id :gap/row-gap-between-flex-lines
  :group :gap
  :html "<div style=\"width: 200px; display: flex; flex-wrap: wrap; row-gap: 12px; column-gap: 8px\"><div style=\"width: 120px; height: 20px\">a</div><div style=\"width: 120px; height: 20px\">b</div></div>"}

 {:id :gap/gap-on-a-multicol-box
  :group :gap
  ;; `gap`'s column half is the multicol gap too -- one property, three
  ;; box types.
  :html "<div style=\"width: 300px; column-count: 2; gap: 40px\"><div style=\"height: 20px\">a</div><div style=\"height: 20px\">b</div></div>"}

 {:id :gap/gap-shorthand-two-values-on-a-flex-row
  :group :gap
  :html "<div style=\"width: 300px; display: flex; flex-wrap: wrap; gap: 6px 18px\"><div style=\"width: 100px; height: 20px\">a</div><div style=\"width: 100px; height: 20px\">b</div><div style=\"width: 100px; height: 20px\">c</div></div>"}

 {:id :gap/percentage-row-gap-with-a-definite-height
  :group :gap
  ;; The non-cyclic half of the pair above, and the control that says the
  ;; 4px there is a SECOND PASS rather than a small percentage: with the
  ;; grid's height declared there is nothing to compute first, and Brave
  ;; puts the second row at y=40 -- 10% of 200, not of the 40px of content.
  :html "<div style=\"width: 300px; height: 200px; display: grid; grid-template-columns: 1fr; grid-template-rows: 20px 20px; row-gap: 10%\"><div>a</div><div>b</div></div>"}

 {:id :gap/percentage-row-gap-on-an-auto-flex-column
  :group :gap
  ;; The same declaration on a flex container instead of a grid, and it
  ;; does something else: measured in Brave 151 on 2026-08-06, a
  ;; `flex-direction: column` box with an AUTO height resolves a
  ;; percentage row gap to ZERO -- second item at y=20, container 40, no
  ;; overflow -- at 10%, 50% and 200% alike. Blink gives a flex
  ;; container's block axis no second pass; only a definite `height` does
  ;; (and a min/max clamp does not, where on a grid it does).
  :html "<div style=\"width: 300px; display: flex; flex-direction: column; row-gap: 10%\"><div style=\"height: 20px\">a</div><div style=\"height: 20px\">b</div></div>"}

 {:id :gap/percentage-column-gap-on-an-inline-grid
  :group :gap
  ;; The INLINE axis is cyclic too, wherever the width is not definite,
  ;; and it takes the same two passes. Brave: this box is 120 wide -- the
  ;; gap-free sum of its two 60px tracks -- with a 12px gap that overflows
  ;; it, putting the second column at x=72.
  :html "<div style=\"width: 400px\"><div style=\"display: inline-grid; grid-template-columns: 60px 60px; column-gap: 10%\"><div style=\"height: 20px\">a</div><div style=\"height: 20px\">b</div></div></div>"}

 ;; ---------------------------------------------------------------------
 ;; Scroll containers.
 ;; ---------------------------------------------------------------------

 {:id :overflow/auto-reserves-no-gutter-in-this-oracle
  :group :overflow
  ;; Written expecting a divergence and finding none, which is the result.
  ;; A classic scrollbar takes its width out of the scroll container's
  ;; CONTENT box and this engine reserves nothing; measured in Brave 151
  ;; headless on macOS (2026-08-05) the browser reserves nothing either --
  ;; overlay scrollbars -- so the inner block is the full 200px on both
  ;; sides. Platform-dependent by nature: on a classic-scrollbar oracle
  ;; this case and the two below would all diverge by the gutter width,
  ;; which is exactly what they are here to catch.
  :html "<div style=\"width: 200px; height: 40px; overflow: auto\"><div style=\"height: 100px\">a</div></div>"}

 {:id :overflow/hidden-reserves-nothing
  :group :overflow
  :html "<div style=\"width: 200px; height: 40px; overflow: hidden\"><div style=\"height: 100px\">a</div></div>"}

 {:id :overflow/x-auto-reserves-height-only
  :group :overflow
  :html "<div style=\"width: 200px; height: 40px; overflow-x: auto; overflow-y: hidden\"><div style=\"width: 400px; height: 20px\">a</div></div>"}

 {:id :overflow/on-a-flex-item
  :group :overflow
  :html "<div style=\"width: 300px; display: flex\"><div style=\"flex: 1; height: 40px; overflow: auto\"><div style=\"height: 90px\">a</div></div><div style=\"flex: 1\">b</div></div>"}

 {:id :overflow/scroll-always-reserves
  :group :overflow
  ;; `overflow: scroll` reserves the gutter even with nothing to scroll.
  :html "<div style=\"width: 200px; height: 40px; overflow: scroll\"><div style=\"height: 10px\">a</div></div>"}

 ;; ---------------------------------------------------------------------
 ;; Real-page composites. A failure here attributes nothing on its own --
 ;; read the isolating cases above for the cause.
 ;; ---------------------------------------------------------------------

 {:id :page/sidebar-with-a-nav-list
  :group :page
  :composite true
  ;; Distinct from :page/sidebar-and-main above: a real `<ul>` nav, a
  ;; `flex: none` sidebar and `min-width: 0` on the main column.
  ;; The nav is a real `<ul>`, so its list markers put this on the same
  ;; footing as :page/nested-lists-in-nav -- LINE-AXIS BLIND, no Range
  ;; reaches a marker. Geometry and paint order still score, and they are
  ;; what the case is for.
  :oracle/blind true
  :html "<div style=\"width: 400px; display: flex; gap: 12px\"><nav style=\"width: 100px; flex: none\"><ul style=\"margin: 0; padding-left: 16px\"><li>One</li><li>Two</li></ul></nav><main style=\"flex: 1; min-width: 0\"><h2 style=\"margin: 0\">Title</h2><p>Body text here.</p></main></div>"}

 {:id :page/sticky-header-over-scrolling-content
  :group :page
  :composite true
  :html "<div style=\"width: 300px; height: 80px; overflow: auto\"><header style=\"position: sticky; top: 0; height: 20px; background: #eee\">Head</header><p style=\"margin: 0\">One</p><p style=\"margin: 0\">Two</p><p style=\"margin: 0\">Three</p><p style=\"margin: 0\">Four</p></div>"}

 {:id :page/card-list-with-images-and-captions
  :group :page
  :composite true
  :html "<div style=\"width: 400px; display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px\"><figure style=\"margin: 0\"><img src=\"data:image/gif;base64,R0lGODlhAQABAAAAACw=\" width=\"40\" height=\"30\"><figcaption>One</figcaption></figure><figure style=\"margin: 0\"><img src=\"data:image/gif;base64,R0lGODlhAQABAAAAACw=\" width=\"40\" height=\"30\"><figcaption>Two</figcaption></figure><figure style=\"margin: 0\"><img src=\"data:image/gif;base64,R0lGODlhAQABAAAAACw=\" width=\"40\" height=\"30\"><figcaption>Three</figcaption></figure></div>"}

 {:id :page/two-column-article
  :group :page
  :composite true
  :html "<article style=\"width: 320px; column-count: 2; column-gap: 20px\"><h3 style=\"margin: 0; column-span: all\">Head</h3><p style=\"margin: 0\">One two three.</p><p style=\"margin: 0\">Four five six.</p></article>"}

 {:id :page/data-table-with-caption-and-foot
  :group :page
  :composite true
  :html "<table style=\"width: 300px; caption-side: bottom; border-collapse: collapse\"><caption>Totals</caption><tfoot><tr><td>Sum</td><td>3</td></tr></tfoot><thead><tr><th>Item</th><th>N</th></tr></thead><tbody><tr><td>a</td><td>1</td></tr><tr><td>b</td><td>2</td></tr></tbody></table>"}
 ;; ---- text: letter-spacing and word-spacing, at widths where they SHOW ----
 ;;
 ;; Both properties already reach `cssom.layout` (they are in its inherited
 ;; set) and neither is added to a text run's advance, so the only shapes
 ;; that can see them are ones where the extra width changes a wrap point or
 ;; an inline box's own width. The first draft of these cases used widths
 ;; that were roomy enough for BOTH answers to fit on one line, and passed
 ;; while measuring nothing -- every width below was picked by measuring the
 ;; browser at that width first.

 {:id :text/letter-spacing-forces-a-wrap
  :group :text
  ;; `alpha beta` is 70px bare and 110px at 4px/char, so 100px is the
  ;; width at which the two engines must disagree about the line count.
  :html "<div style=\"width: 100px\"><p style=\"letter-spacing: 4px\">alpha beta</p></div>"}

 {:id :text/negative-letter-spacing-fits-one-line
  :group :text
  ;; The mirror: 70px bare does NOT fit in 60px, 50px at -2px/char does.
  :html "<div style=\"width: 60px\"><p style=\"letter-spacing: -2px\">alpha beta</p></div>"}

 {:id :text/letter-spacing-inherits-into-a-child
  :group :text
  :html "<div style=\"width: 100px; letter-spacing: 4px\"><p>alpha beta</p></div>"}

 {:id :text/letter-spacing-on-an-inline-child
  :group :text
  :html "<p>a <b style=\"letter-spacing: 3px\">wide</b> b</p>"}

 {:id :text/letter-spacing-widens-a-shrink-to-fit-box
  :group :text
  :html "<div style=\"width: 200px\"><span style=\"display: inline-block; letter-spacing: 4px\">abcd</span></div>"}

 {:id :text/word-spacing-forces-a-wrap
  :group :text
  ;; `one two three` is 91px bare and 131px with 20px added at each of its
  ;; two spaces.
  :html "<div style=\"width: 120px\"><p style=\"word-spacing: 20px\">one two three</p></div>"}

 {:id :text/negative-word-spacing-fits-one-line
  :group :text
  :html "<div style=\"width: 80px\"><p style=\"word-spacing: -6px\">one two three</p></div>"}

 {:id :text/word-spacing-on-an-inline-child
  :group :text
  :html "<p>a <b style=\"word-spacing: 10px\">one two</b> b</p>"}

 ;; ---- text: indentation ----

 {:id :text/text-indent-only-indents-the-first-line
  :group :text
  ;; 22 characters is 154px and fits 160px unindented; the 40px indent
  ;; pushes the last word onto a second line, and ONLY the first line is
  ;; indented -- an engine that indented every line would break earlier.
  :html "<p style=\"width: 160px; text-indent: 40px\">alpha beta gamma delta</p>"}

 {:id :text/text-indent-percentage-of-the-containing-block
  :group :text
  ;; 50% of the 200px containing block, not of anything the <p> owns.
  :html "<div style=\"width: 200px\"><p style=\"text-indent: 50%\">alpha beta gamma</p></div>"}

 {:id :text/text-indent-inherits-into-a-block-child
  :group :text
  :html "<div style=\"width: 150px; text-indent: 60px\"><p>alpha beta gamma</p></div>"}

 {:id :text/text-indent-hanging-skips-the-first-line
  :group :text
  ;; `hanging` inverts it: the first line is flush and every later line is
  ;; indented, so this wraps to THREE lines where the same text without
  ;; `hanging` wraps to two.
  :html "<p style=\"width: 160px; text-indent: 40px hanging\">alpha beta gamma delta epsilon zeta eta theta</p>"}

 {:id :text/text-indent-each-line-indents-after-a-break
  :group :text
  ;; `each-line` re-applies the indent after a FORCED break, so the <br>
  ;; ends up 30px further right than the first line's own indent alone.
  :html "<p style=\"width: 200px; text-indent: 30px each-line\">alpha<br>beta</p>"}

 ;; ---- text: white-space, wrapping and break opportunities ----

 {:id :text/white-space-break-spaces-keeps-newlines
  :group :text
  ;; `break-spaces` is one of the four preserving values, so this is two
  ;; lines. Shaped around the newline rather than around a run of spaces on
  ;; purpose: the oracle measures one Range per WORD and so cannot see
  ;; where a run of preserved spaces breaks, which is the only thing
  ;; `break-spaces` does that `pre-wrap` does not.
  :html "<div style=\"width: 200px; white-space: break-spaces\">aa\nbb</div>"}

 ;; The four below are the content that DOES discriminate `break-spaces`
 ;; from `pre-wrap`, which the round that added the case above looked for
 ;; and did not find. Its own note is right about why: the oracle measures
 ;; one Range per word, so it cannot see where a run of spaces breaks. What
 ;; it can see is the BOX, and the two values give it different heights as
 ;; soon as the spaces themselves overflow the line -- which the six-space
 ;; shape that round tried never does.
 ;;
 ;; Measured in Brave 151, 2026-08-06, at 14px monospace / 20px lines, so
 ;; 7px a character and eight of them to a 60px box. Each `break-spaces`
 ;; case is followed by its `pre-wrap` twin, because a single height cannot
 ;; distinguish 'the rule is implemented' from 'this shape does not
 ;; discriminate'.

 {:id :text/white-space-break-spaces-wraps-inside-a-run-of-spaces
  :group :text
  ;; 60x40. `aa` plus ten spaces is 84px of preserved content in a 60px
  ;; box, and under `break-spaces` a space is measured and may be broken
  ;; after, so the run wraps onto a second line.
  :html "<div style=\"width: 60px; white-space: break-spaces\">aa          </div>"}

 {:id :text/white-space-pre-wrap-hangs-a-run-of-spaces
  :group :text
  ;; 60x20 -- the twin, and the whole difference. Under `pre-wrap` the same
  ;; ten spaces HANG past the content edge rather than wrapping, so the box
  ;; is one line tall.
  :html "<div style=\"width: 60px; white-space: pre-wrap\">aa          </div>"}

 {:id :text/white-space-break-spaces-wraps-a-run-before-the-next-word
  :group :text
  ;; 60x60: `aa` + six spaces, then eight spaces, then six spaces + `bb`.
  ;; Three lines, and the only way to get three is to measure the spaces.
  :html "<div style=\"width: 60px; white-space: break-spaces\">aa                    bb</div>"}

 {:id :text/white-space-pre-wrap-hangs-a-run-before-the-next-word
  :group :text
  ;; 60x40 for the identical markup -- the spaces hang and only `bb` wraps.
  :html "<div style=\"width: 60px; white-space: pre-wrap\">aa                    bb</div>"}

 ;; The next three were BLOCKED UPSTREAM OF cssom from 2026-08-05 and are
 ;; UNBLOCKED as of 2026-08-06. kotoba-lang/htmldom used to collapse
 ;; whitespace at PARSE time, on the belief that space collapsing was
 ;; HTML-structural, so `cssom.layout` never saw the characters: a
 ;; `<span style="white-space: pre">   indented</span>` arrived as
 ;; `" indented"` and a tab arrived as a space.
 ;;
 ;; Measured in Brave 151, 2026-08-06 (htmldom's conformance/ws_probe.cljs),
 ;; the belief was wrong: the browser's HTML parser collapses NOTHING --
 ;; `<div>   a   b   </div>` keeps every one of its spaces in the DOM, and
 ;; `<div>a\tb</div>` keeps its tab. The only whitespace it drops is the
 ;; single leading newline after a `<pre>`/`<textarea>` start tag. htmldom
 ;; now defers all of it to layout, where `white-space` can decide, and
 ;; these three answer 77/63/35 -- the browser's numbers exactly.

 {:id :text/white-space-pre-keeps-leading-spaces
  :group :text
  ;; Shrink-to-fit so the preserved spaces are IN the measured width:
  ;; 11 characters, not 8.
  :html "<span style=\"display: inline-block; white-space: pre\">   indented</span>"}

 {:id :text/tab-in-pre-advances-to-the-next-eight-column-stop
  :group :text
  ;; A tab is not one space: it advances to the next multiple of `tab-size`
  ;; (initially 8), so `a<tab>b` is 9 characters wide, 63px.
  :html "<span style=\"display: inline-block; white-space: pre\">a\tb</span>"}

 {:id :text/tab-size-four-in-pre
  :group :text
  ;; The same shape at `tab-size: 4` is 5 characters, 35px. The pair is
  ;; what separates 'the tab stop is wrong' from 'tab-size is ignored'.
  :html "<span style=\"display: inline-block; white-space: pre; tab-size: 4\">a\tb</span>"}

 {:id :text/overflow-wrap-anywhere-shrinks-min-content
  :group :text
  ;; The three break keywords differ ONLY when a box is being SIZED:
  ;; `anywhere` and `break-all` let the long word break while its
  ;; min-content width is computed, so the inline-block takes the 60px on
  ;; offer; `break-word` does not, so the same box is 105px and overflows.
  :html "<div style=\"width: 60px\"><span style=\"display: inline-block; overflow-wrap: anywhere\">aaaaaaaaaaaaaaa</span></div>"}

 {:id :text/overflow-wrap-break-word-keeps-min-content
  :group :text
  :html "<div style=\"width: 60px\"><span style=\"display: inline-block; overflow-wrap: break-word\">aaaaaaaaaaaaaaa</span></div>"}

 {:id :text/word-break-break-all-shrinks-min-content
  :group :text
  :html "<div style=\"width: 60px\"><span style=\"display: inline-block; word-break: break-all\">aaaaaaaaaaaaaaa</span></div>"}

 {:id :text/soft-hyphen-is-a-break-opportunity
  :group :text
  :oracle/blind true
  ;; U+00AD is a conditional break point (`hyphens: manual` is the initial
  ;; value), so the browser breaks the word there and this box is two lines
  ;; tall: 90x40, first line 35 + a 14px inserted hyphen, second line 105.
  ;; IMPLEMENTED 2026-08-06 -- see soft-hyphen-lines and inline-line-breaker.
  ;;
  ;; `:oracle/blind`, and the reason is the inserted glyph rather than the
  ;; engine. The harness measures a word that spans two lines one CHARACTER
  ;; at a time (a multi-rect word has no other way to say which line each
  ;; part landed on), and Chromium attributes the hyphen it INSERTED to the
  ;; character after the break: measured 2026-08-06, the range covering the
  ;; `c` of `califragilistic` reports getClientRects() = [[35,2,14,15],
  ;; [0,22,7,15]] -- the hyphen's rect on line ONE and its own on line two --
  ;; and getBoundingClientRect(), which is what the harness reads, is their
  ;; union [0,2,49,35]. That union's midpoint sits inside line one's span,
  ;; so the two lines cluster into one and the oracle reports
  ;; ["super<shy>c alifragilistic"] for a box it has itself rendered as two
  ;; lines. Nothing the engine emits can match that.
  ;;
  ;; The two sides also spell the glyph differently and legitimately: the
  ;; oracle's line one ends with the SOFT HYPHEN it found in the document,
  ;; the engine's with the U+2010 HYPHEN it inserted, and neither is in the
  ;; other's line. Geometry and paint are the honest axes here and both are
  ;; compared -- `:oracle/blind` only excludes the line score.
  :html "<div style=\"width: 90px\">super&shy;califragilistic</div>"}

 {:id :text/soft-hyphen-under-hyphens-none
  :group :text
  ;; CONTROL: `hyphens: none` removes the opportunity, so the same markup
  ;; is one 140px line in a 90px box -- 90x20 on both sides, exactly what
  ;; the word without the character gives.
  :html "<div style=\"width: 90px; hyphens: none\">super&shy;califragilistic</div>"}

 {:id :text/soft-hyphen-costs-nothing-where-it-sits
  :group :text
  ;; CONTROL, and the measurement that says the character is not a glyph:
  ;; with room to spare the box is 300x20 and the text is 63 wide, exactly
  ;; the nine characters around it.
  :html "<div style=\"width: 300px\">super&shy;cali</div>"}

 {:id :text/soft-hyphen-greedy-takes-the-last-that-fits
  :group :text
  :oracle/blind true
  ;; Two opportunities, and the greedy loop takes the SECOND: Brave puts
  ;; `aaabbb` + a hyphen (42 + 14) on line one and the fifteen c's (105) on
  ;; line two, 120x40. Breaking at the first would have given 21 + 14.
  ;; Blind for the same inserted-glyph reason as the case above.
  :html "<div style=\"width: 120px\">aaa&shy;bbb&shy;ccccccccccccccc</div>"}

 {:id :text/a-hyphenated-line-may-overflow-its-box
  :group :text
  :oracle/blind true
  ;; The hyphen does not have to fit for the break to be taken once the
  ;; content before it already reaches the edge: Brave's first line is
  ;; 84 + 14 = 98 in a 90px box, `bb` on the second, 90x40. (What DOES
  ;; depend on the hyphen fitting is whether an EARLIER opportunity is
  ;; preferred -- see soft-hyphen-lines' scope cut, which this engine does
  ;; not implement and which no case here can show, because the two answers
  ;; have the same height.)
  :html "<div style=\"width: 90px\">aaaaaaaaaaaa&shy;bb</div>"}

 {:id :text/hyphens-auto-breaks-inside-a-word
  :group :text
  ;; With `hyphens: auto` and a language, Chromium's own hyphenation
  ;; dictionary breaks `hyphenation` and the box becomes three lines tall
  ;; instead of two.
  :html "<div style=\"width: 70px; hyphens: auto\" lang=\"en\">hyphenation example</div>"}

 {:id :text/nowrap-inline-inside-a-wrapping-paragraph
  :group :text
  ;; `white-space: nowrap` on an INLINE child keeps its own words together
  ;; without making it a break point either side.
  :html "<p style=\"width: 120px\">alpha <span style=\"white-space: nowrap\">beta gamma</span> delta</p>"}

 {:id :text/text-wrap-balance-evens-the-lines
  :group :text
  ;; A greedy line breaker fills the first line; `balance` does not.
  :html "<p style=\"width: 200px; text-wrap: balance\">alpha beta gamma delta epsilon</p>"}

 ;; ---- text: font-size keywords ----

 {:id :text/font-size-absolute-keyword
  :group :text
  ;; The absolute keywords are keyed on the DEFAULT font of the family in
  ;; use (`large` is 16px in this page's monospace, 18 in a proportional
  ;; one), which is why `resolve-font-size` returns nil for them. Measured
  ;; here rather than asserted, and it costs more than the font size: the
  ;; UA `p { margin: 1em 0 }` then resolves against the wrong size too.
  :html "<p style=\"font-size: large\">large</p>"}

 {:id :text/font-size-larger-scales-off-the-parent
  :group :text
  ;; The contrast partner: `larger`/`smaller` are a pure ratio off the
  ;; parent and need no family table, so they DO resolve.
  :html "<div style=\"font-size: 20px\"><p style=\"font-size: larger\">bigger</p></div>"}

 ;; ---- generated content the box tree can still be measured through ----

 {:id :inline/q-adds-quotation-marks
  :group :inline
  ;; The oracle's per-word Ranges cannot see generated content, so the LINE
  ;; axis is blind here -- but the <q>'s own BOX is two characters wider on
  ;; each side, and geometry reads that directly.
  ;;
  ;; The marker was added when the engine LEARNED to generate the quotes
  ;; (`q::before { content: open-quote }` in cssom.core's UA sheet). Before
  ;; that both sides read the same plain text for the same wrong reason --
  ;; neither produced a quote at all -- and the case scored on the line
  ;; axis by accident. It is the same situation
  ;; `:generated/before-content-joins-line` has carried from the start.
  :oracle/blind true
  :html "<p>he said <q>hello</q> loudly</p>"}

 {:id :inline/nested-q-uses-the-second-quote-level
  :group :inline
  ;; blind for the same reason as the case above, and doubly so: the outer
  ;; quotes and the inner ones are different characters.
  :oracle/blind true
  :html "<p>x <q>a <q>b</q> c</q> y</p>"}

 {:id :generated/counter-numbers-the-items
  :group :generated
  :oracle/blind true
  :html "<div class=\"cnt\"><p>one</p><p>two</p><p>three</p></div>"
  :css ".cnt { counter-reset: step } .cnt p::before { counter-increment: step; content: counter(step) \". \" }"}

 {:id :generated/attr-content-after
  :group :generated
  :oracle/blind true
  :html "<p>label<span data-label=\"note\"></span></p>"
  :css "span::after { content: attr(data-label) }"}

 ;; ---- a margin rule the `:empty` case above exposed, isolated ----

 {:id :block/an-empty-block-collapses-through-itself
  :group :block
  ;; A block with no content and no border or padding is SELF-COLLAPSING:
  ;; its own top and bottom margins collapse into one, that one then
  ;; collapses with the next sibling's, and with nothing to stop it at the
  ;; parent's top edge the whole set escapes. The browser puts both
  ;; children at y=0 and the parent is 20px tall.
  :html "<div><div style=\"margin: 14px 0\"></div><div style=\"height: 20px\">after</div></div>"}

 ;; ---- selectors: structural ----
 ;;
 ;; Written with <p> siblings rather than <li>: a list's marker is
 ;; generated content the oracle cannot see, so an otherwise perfectly good
 ;; selector case in a <ul> can only ever be scored `unscorable`.

 {:id :selector/nth-child-negative-coefficient
  :group :selector
  :html "<div><p>1</p><p>2</p><p>3</p><p>4</p></div>"
  :css "p:nth-child(-n+2) { color: #ff0000 }"}

 {:id :selector/nth-child-an-plus-b
  :group :selector
  :html "<div><p>1</p><p>2</p><p>3</p><p>4</p><p>5</p></div>"
  :css "p:nth-child(2n+1) { color: #ff0000 }"}

 {:id :selector/nth-child-odd-and-even-keywords
  :group :selector
  :html "<div><p>1</p><p>2</p><p>3</p><p>4</p></div>"
  :css "p:nth-child(odd) { color: #ff0000 } p:nth-child(even) { color: #0000ff }"}

 {:id :selector/nth-child-of-a-selector
  :group :selector
  ;; `of <selector>` counts only among the matching siblings, so `2n+1 of
  ;; .m` is the FIRST `.m` and would be the third -- which does not exist.
  ;; An engine that ignores the `of` clause bolds both `.m` paragraphs.
  :html "<div><p class=\"m\">1</p><p>2</p><p class=\"m\">3</p><p>4</p></div>"
  :css "p:nth-child(2n+1 of .m) { font-weight: bold }"}

 {:id :selector/nth-of-type-counts-per-tag
  :group :selector
  :html "<div><p>p1</p><span>s1</span><p>p2</p><span>s2</span></div>"
  :css "p:nth-of-type(2) { color: #ff0000 } span:nth-of-type(1) { color: #0000ff }"}

 {:id :selector/nth-last-child-counts-from-the-end
  :group :selector
  :html "<div><p>1</p><p>2</p><p>3</p></div>"
  :css "p:nth-last-child(1) { font-weight: bold }"}

 {:id :selector/first-last-and-only-child
  :group :selector
  ;; The lone child of the second group is first, last AND only, so source
  ;; order decides between three equally specific rules.
  :html "<div><div><p>1</p><p>2</p><p>3</p></div><div><p>only</p></div></div>"
  :css "p:first-child { color: #ff0000 } p:last-child { color: #0000ff } p:only-child { color: #008000 }"}

 {:id :selector/first-of-type-among-mixed-siblings
  :group :selector
  :html "<div><span>s</span><p>p1</p><p>p2</p></div>"
  :css "p:first-of-type { font-style: italic }"}

 {:id :selector/empty-pseudo-class
  :group :selector
  :html "<div><p></p><p>x</p></div>"
  :css "p:empty { padding-left: 20px }"}

 {:id :selector/not-with-a-nested-pseudo-class
  :group :selector
  :html "<div><p>1</p><p>2</p><p>3</p></div>"
  :css "p:not(:first-child) { font-style: italic }"}

 ;; ---- selectors: :has() ----

 {:id :selector/has-a-descendant
  :group :selector
  :html "<div><p><a href=\"/x\">link</a></p><p>plain</p></div>"
  :css "p:has(a) { font-weight: bold }"}

 {:id :selector/has-a-direct-child
  :group :selector
  :html "<div><p><span><a href=\"/x\">deep</a></span></p><p><a href=\"/y\">shallow</a></p></div>"
  :css "p:has(> a) { font-weight: bold }"}

 {:id :selector/has-a-following-sibling
  :group :selector
  ;; The sibling-relative form, named as out of scope in `cssom.core`'s own
  ;; docstring and never measured until now.
  :html "<div><h2>head</h2><p>after</p></div>"
  :css "h2:has(~ p) { font-style: italic }"}

 ;; ---- selectors: combinators ----

 {:id :selector/adjacent-sibling-combinator
  :group :selector
  :html "<div><h2>head</h2><p>right after</p><p>later</p></div>"
  :css "h2 + p { font-style: italic }"}

 {:id :selector/general-sibling-combinator
  :group :selector
  :html "<div><h2>head</h2><p>one</p><span>s</span><p>two</p></div>"
  :css "h2 ~ p { font-style: italic }"}

 ;; ---- selectors: attributes ----

 {:id :selector/attribute-prefix-match
  :group :selector
  :html "<p><a href=\"https://x\">ext</a> <a href=\"/y\">int</a></p>"
  :css "a[href^=\"https\"] { font-weight: bold }"}

 {:id :selector/attribute-suffix-match
  :group :selector
  :html "<p><a href=\"/a.pdf\">pdf</a> <a href=\"/b.html\">page</a></p>"
  :css "a[href$=\".pdf\"] { font-weight: bold }"}

 {:id :selector/attribute-substring-match
  :group :selector
  :html "<p><a href=\"/docs/x\">docs</a> <a href=\"/blog/y\">blog</a></p>"
  :css "a[href*=\"docs\"] { font-weight: bold }"}

 {:id :selector/attribute-whitespace-list-match
  :group :selector
  :html "<div><p data-tags=\"one two\">has</p><p data-tags=\"onetwo\">none</p></div>"
  :css "p[data-tags~=\"two\"] { font-weight: bold }"}

 {:id :selector/attribute-hyphen-match
  :group :selector
  :html "<div><p lang=\"en-GB\">gb</p><p lang=\"english\">no</p></div>"
  :css "p[lang|=\"en\"] { font-style: italic }"}

 {:id :selector/attribute-case-insensitive-flag
  :group :selector
  :html "<div><p data-k=\"VALUE\">upper</p><p data-k=\"value\">lower</p></div>"
  :css "p[data-k=\"value\" i] { font-weight: bold }"}

 ;; ---- selectors: specificity ----

 {:id :selector/is-and-where-differ-in-specificity
  :group :selector
  ;; `:is()` takes its argument's specificity -- an id, so it beats `p`;
  ;; `:where()` is always zero, so the same argument loses to `p`. The two
  ;; halves are in one case because the difference IS the measurement.
  :html "<div><p id=\"sel-is-a\">is</p><p id=\"sel-where-b\">where</p></div>"
  :css ":is(#sel-is-a) { color: #ff0000 } p { color: #0000ff } :where(#sel-where-b) { color: #ff0000 }"}

 {:id :selector/is-with-a-descendant-combinator
  :group :selector
  ;; A combinator chain INSIDE `:is()`. `cssom.core`'s docstring names this
  ;; form as out of scope -- measured, it works, and a control
  ;; (`:is(.nomatch xyz) p`) correctly matches nothing, so the docstring is
  ;; stale rather than the engine incomplete. Pinned so it stays that way.
  :html "<div class=\"wrap\"><section><p>nested</p></section></div>"
  :css ":is(.wrap section) p { font-weight: bold }"}

 {:id :selector/not-takes-a-selector-list
  :group :selector
  :html "<div><p class=\"x\">a</p><p class=\"y\">b</p><p>c</p></div>"
  :css "p:not(.x, .y) { font-weight: bold }"}

 {:id :selector/not-specificity-comes-from-its-argument
  :group :selector
  ;; `p:not(#nope)` is (1,0,1) and beats `.lead`'s (0,1,0) even though the
  ;; id it names matches nothing.
  :html "<div><p class=\"lead\">t</p></div>"
  :css "p:not(#nope) { color: #ff0000 } .lead { color: #0000ff }"}

 {:id :selector/specificity-is-not-additive-across-levels
  :group :selector
  ;; Eleven classes still lose to one id.
  :html "<div><p id=\"sel-many\" class=\"a b c d e f g h i j k\">t</p></div>"
  :css "#sel-many { color: #ff0000 } .a.b.c.d.e.f.g.h.i.j.k { color: #0000ff }"}

 {:id :selector/source-order-breaks-a-specificity-tie
  :group :selector
  :html "<div><p class=\"tie\">t</p></div>"
  :css ".tie { color: #ff0000 } .tie { color: #0000ff }"}

 ;; ---- cascade: importance and inline styles ----

 {:id :cascade/author-important-beats-an-inline-style
  :group :selector
  ;; An inline `style=\"\"` outranks any selector -- until the selector's
  ;; declaration is `!important`, which outranks the inline one.
  :html "<div><p style=\"color: #0000ff\">text</p></div>"
  :css "p { color: #ff0000 !important }"}

 {:id :cascade/inline-important-beats-author-important
  :group :selector
  :html "<div><p style=\"color: #0000ff !important\">text</p></div>"
  :css "p { color: #ff0000 !important }"}

 {:id :cascade/inline-style-beats-an-id-selector
  :group :selector
  :html "<div><p id=\"sel-inline\" style=\"color: #0000ff\">text</p></div>"
  :css "#sel-inline { color: #ff0000 }"}

 ;; ---- cascade: var(), shorthands and the CSS-wide keywords ----

 {:id :cascade/var-fallback-when-undefined
  :group :selector
  :html "<div><p>uses a fallback</p></div>"
  :css "p { padding: var(--nope, 12px) }"}

 {:id :cascade/var-invalid-at-computed-value-time-inherits
  :group :selector
  ;; A `var()` naming nothing makes the WHOLE declaration invalid at
  ;; computed-value time, and an inherited property then INHERITS -- it
  ;; does not fall back to the earlier declaration in the same block.
  :html "<div style=\"color: #008000\"><p>text</p></div>"
  :css "p { color: #0000ff; color: var(--missing) }"}

 {:id :cascade/var-invalid-on-a-non-inherited-property
  :group :selector
  ;; ...and a non-inherited one takes its INITIAL value, not the 20px.
  :html "<div><p>text</p></div>"
  :css "p { padding-left: 20px; padding-left: var(--missing) }"}

 {:id :cascade/shorthand-after-longhand-resets-it
  :group :selector
  :html "<div><p>text</p></div>"
  :css "p { padding-left: 30px; padding: 5px }"}

 {:id :cascade/longhand-after-shorthand-wins
  :group :selector
  :html "<div><p>text</p></div>"
  :css "p { padding: 5px; padding-left: 30px }"}

 {:id :cascade/initial-keyword-resets-to-the-css-initial-value
  :group :selector
  :html "<div style=\"text-align: center\"><p style=\"text-align: initial\">text</p></div>"}

 {:id :cascade/unset-on-an-inherited-property-inherits
  :group :selector
  :html "<div style=\"color: #008000\"><p style=\"color: unset\">text</p></div>"}

 {:id :cascade/unset-on-a-non-inherited-property-is-initial
  :group :selector
  :html "<div style=\"padding-left: 40px\"><p style=\"padding-left: unset\">text</p></div>"}

 {:id :cascade/inherit-on-a-non-inherited-property
  :group :selector
  :html "<div style=\"padding-left: 40px\"><p style=\"padding-left: inherit\">text</p></div>"}

 {:id :cascade/revert-drops-to-the-user-agent-value
  :group :selector
  ;; The author rule has to be there for this to measure anything: with no
  ;; author declaration to roll back, IGNORING `revert` and OBEYING it both
  ;; leave the UA `margin: 1em 0` standing.
  :html "<div><p class=\"rv\" style=\"margin: revert\">b</p></div>"
  :css "p.rv { margin: 0 }"}


 ;; ======================================================================
 ;; Round thirty-three: 75 cases in territory the corpus had never entered.
 ;;
 ;; Every number in the comments below was read out of the same headless
 ;; Brave 151.1.93.129 over CDP that drives this harness, on a page built
 ;; with this file's own wrapper (800px, monospace, 14px, line-height
 ;; 20px), BEFORE the case was written. Where a case AGREES it says so --
 ;; a control that passes is what makes its neighbour a finding, and
 ;; several of the pairs below exist for no other reason.
 ;; ======================================================================

 ;; ---- logical properties: the flow-relative half of the box model ----
 ;; `margin-inline-*`, `padding-inline-*`, `padding-block-*`,
 ;; `inline-size`, `block-size`, `border-inline-*` and `inset-inline-*`
 ;; matched NOTHING in src/ when these twelve were written -- a repo-wide
 ;; grep for each was zero in both cssom.core and cssom.layout -- so all
 ;; twelve diverged and they were one cause. They are here because they are
 ;; not exotic: they are how a stylesheet that supports both writing
 ;; directions is written today, and two of them are the only cases in the
 ;; corpus that can tell a physical property from a logical one -- the ones
 ;; that FLIP under `direction: rtl`, where `margin-inline-start` is a
 ;; right margin.
 ;;
 ;; ELEVEN OF THE TWELVE now agree (2026-08-06). The cause really was one:
 ;; the rename to the physical property happens at computed-value time in
 ;; cssom.core's cascade, keyed on the element's OWN resolved `direction`,
 ;; between the cascade's sort and its per-property winner selection -- so
 ;; a logical and a physical declaration for the same side compete by
 ;; ordinary specificity and source order with no code of their own. See
 ;; `logical->physical-by-flow` there for the browser measurements.
 ;;
 ;; The twelfth, `border-inline-start`, diverged until 2026-08-06 and it
 ;; was never this cause: the cascade resolved it to
 ;; `border-left-width`/`-style`/`-color` correctly and cssom.layout had no
 ;; per-side border to read them with, so `border-left: 5px solid #000` --
 ;; the physical spelling -- laid out identically wrong. Both land now; see
 ;; the border group below.

 {:id :logical/margin-inline-start
  :group :logical
  ;; Brave: inner div x=40 w=260 inside its 300px parent. Engine was
  ;; 0/300; AGREES since 2026-08-06.
  :html "<div style=\"width: 300px\"><div style=\"margin-inline-start: 40px\">m</div></div>"}

 {:id :logical/margin-inline-two-values
  :group :logical
  ;; `margin-inline: <start> <end>`. Brave: x=20 w=220 (300 - 20 - 60).
  ;; AGREES since 2026-08-06.
  :html "<div style=\"width: 300px\"><div style=\"margin-inline: 20px 60px\">m</div></div>"}

 {:id :logical/margin-inline-mirrors-under-rtl
  :group :logical
  ;; The same declaration in an rtl containing block: start is the RIGHT
  ;; side. Brave: x=60 w=220 -- the 20px is now on the right and the 60px
  ;; on the left. This is the case that distinguishes a logical property
  ;; from an alias for the physical one, and AGREES since 2026-08-06.
  :html "<div style=\"width: 300px; direction: rtl\"><div style=\"margin-inline: 20px 60px\">m</div></div>"}

 {:id :logical/padding-inline-two-values
  :group :logical
  ;; Brave: the padded div is 340 wide (auto width + 40 of padding) and
  ;; its <p> is at x=10 with w=300. AGREES since 2026-08-06.
  :html "<div style=\"width: 300px; padding-inline: 10px 30px\"><p style=\"margin: 0\">p</p></div>"}

 {:id :logical/padding-inline-start-mirrors-under-rtl
  :group :logical
  ;; Brave: div w=350, <p> at x=0 w=300 -- the 50px landed on the RIGHT,
  ;; so the <p>'s own box is the same as it would be with no padding at
  ;; all and only the outer box records the difference. AGREES since
  ;; 2026-08-06.
  :html "<div style=\"width: 300px; direction: rtl; padding-inline-start: 50px\"><p style=\"margin: 0\">p</p></div>"}

 {:id :logical/padding-block
  :group :logical
  ;; Brave: div h=56 (12 + 20 + 24), <p> at y=12. AGREES since 2026-08-06.
  :html "<div style=\"width: 300px; padding-block: 12px 24px\"><p style=\"margin: 0\">p</p></div>"}

 {:id :logical/margin-block
  :group :logical
  ;; Brave: the second div is at y=40 (10px sibling + a 30px block-start
  ;; margin) and the wrapper is 60 tall. Engine was y=10, wrapper 30;
  ;; AGREES since 2026-08-06.
  :html "<div style=\"width: 300px\"><div style=\"height: 10px\"></div><div style=\"margin-block: 30px 0\">m</div></div>"}

 {:id :logical/inline-size-is-width
  :group :logical
  ;; Brave: w=120. This engine read `width` only, so the box filled 300.
  ;; AGREES since 2026-08-06.
  :html "<div style=\"width: 300px\"><div style=\"inline-size: 120px\">i</div></div>"}

 {:id :logical/block-size-is-height
  :group :logical
  ;; Brave: h=60. AGREES since 2026-08-06.
  :html "<div style=\"width: 300px\"><div style=\"block-size: 60px\">b</div></div>"}

 {:id :logical/max-inline-size
  :group :logical
  ;; Brave: w=80, and the text does NOT wrap at it (`alpha beta` is 70px),
  ;; so what this measures is the box and not the line. AGREES since
  ;; 2026-08-06.
  :html "<div style=\"width: 300px\"><div style=\"max-inline-size: 80px\">alpha beta</div></div>"}

 {:id :logical/inset-inline-start
  :group :logical
  ;; Brave: the absolutely positioned box is at x=30. AGREES since
  ;; 2026-08-06.
  :html "<div style=\"width: 300px; height: 40px; position: relative\"><div style=\"position: absolute; inset-inline-start: 30px; top: 0\">a</div></div>"}

 {:id :logical/border-inline-start
  :group :logical
  ;; Brave: the bordered div is 305 wide (auto width + the 5px border) and
  ;; its <p> is at x=5 w=300. AGREES since 2026-08-06 -- it was the one of
  ;; the twelve that was not the logical mapping, and the fix was the
  ;; per-side border it resolved to, not the resolution.
  :html "<div style=\"width: 300px; border-inline-start: 5px solid #000\"><p style=\"margin: 0\">p</p></div>"}

 ;; ---- replaced elements and their default size ----
 ;; These five used to say `inline-atomic-tags` had no box for
 ;; `:svg`/`:canvas`/`:video`/`:iframe`, on that set's own reasoning:
 ;; "this engine has no rendering for any of them, so giving them an
 ;; inline box would place an empty rectangle in the middle of a sentence
 ;; rather than fix anything." The number they put on it answered that: a
 ;; browser cannot render them either and RESERVES 300x150 for every one
 ;; of them anyway, so the objection was answered by the box being the
 ;; RIGHT empty rectangle. All five AGREE now (2026-08-06) -- see
 ;; `replaced-content-size` in cssom.layout for the sizing algorithm and
 ;; the Brave measurements behind it, and the `iframe` rule in
 ;; cssom.core's UA stylesheet for the 4px that separates 304x154 from
 ;; 300x150.
 ;;
 ;; The <img> cases beside them measure the other half: an intrinsic
 ;; RATIO, which this engine had never had to read because every image in
 ;; the corpus until 2026-08-06 was a 1x1 GIF with both dimensions
 ;; declared. The image here is a 40x20 SVG as a data URI, so the 2:1
 ;; ratio is a property of the RESOURCE rather than of the attributes --
 ;; and a resource's own size is a property of the bytes at the far end of
 ;; a URL, which no pure layout engine can see.
 ;;
 ;; They agree now, through the OPTIONAL `:image-size` theme hook
 ;; `(fn [src] {:w .. :h ..})` -- the same bargain as `:measure-text`, and
 ;; `replaced-intrinsic-size` is where the answer arrives. This harness
 ;; plays the host by reading each src's decoded size off the ORACLE's own
 ;; decoder (see the measurement script's `__images__` probe for why it is
 ;; not decoded here instead: the 1x1 GIF ten other cases use has a
 ;; well-formed header saying 1x1 and no image data, so a header-sniffing
 ;; decoder in the harness would disagree with Brave -- which reports 0 and
 ;; paints a broken-image icon -- and that disagreement would be scored as
 ;; a layout bug). The engine still emits no image draw-op: what the hook
 ;; buys is the BOX a browser reserves for the picture, exactly as the
 ;; 300x150 default object size does for a <video> nothing here decodes.

 {:id :replaced/img-intrinsic-size
  :group :replaced
  ;; Brave: 40x20, from the resource alone, and this engine agrees once a
  ;; host answers `:image-size`.
  ;;
  ;; HONEST LIMIT OF THIS ONE CASE: a bare <img>'s box IS its intrinsic
  ;; size, and the harness's host answer comes from the oracle's decoder,
  ;; so this case asserts that the size is consulted at all and nothing
  ;; more. The two beside it are where the ALGORITHM is measured -- there
  ;; the box (200x100, 120x60) is not the fact (40x20) and has to be
  ;; derived from it.
  ;;
  ;; Without a hook it is 0x0, which is also what Brave gives an <img>
  ;; with no `src` at all -- see `replaced-default-size`, and note that a
  ;; BROKEN src is a third thing again (a 16x16 broken-image icon), which
  ;; this engine does not model and which no case here exercises.
  :html "<div style=\"width: 400px\"><img src=\"data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSI0MCIgaGVpZ2h0PSIyMCIvPg==\"></div>"}

 {:id :replaced/img-width-only-keeps-the-ratio
  :group :replaced
  ;; Brave: 200x100 -- the declared width and the resource's 2:1 ratio.
  ;; The ratio machinery to solve the other axis was already here
  ;; (replaced-content-size does exactly this for a <canvas>); what was
  ;; missing was only the resource's size to build a ratio from, which is
  ;; why closing this needed a host hook and not a box-model change. It
  ;; was 200x0 until 2026-08-06.
  :html "<div style=\"width: 400px\"><img src=\"data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSI0MCIgaGVpZ2h0PSIyMCIvPg==\" style=\"width: 200px\"></div>"}

 {:id :replaced/img-height-only-keeps-the-ratio
  :group :replaced
  ;; The mirror: Brave 120x60, and 0x60 here until the hook existed.
  :html "<div style=\"width: 400px\"><img src=\"data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSI0MCIgaGVpZ2h0PSIyMCIvPg==\" style=\"height: 60px\"></div>"}

 {:id :replaced/img-attribute-height-survives-a-css-width
  :group :replaced
  ;; AGREES, and it is the control that makes the two above findings: the
  ;; width/height ATTRIBUTES are presentational hints, i.e. ordinary
  ;; author-origin declarations of the lowest priority, so a CSS `width`
  ;; replaces the width hint and the height hint stands on its own. Brave
  ;; and this engine both say 200x20 -- NOT the 200x100 an aspect ratio
  ;; would give. So what the engine is missing is the RESOURCE's ratio,
  ;; not the attributes.
  :html "<div style=\"width: 400px\"><img src=\"data:image/gif;base64,R0lGODlhAQABAAAAACw=\" width=\"40\" height=\"20\" style=\"width: 200px\"></div>"}

 {:id :replaced/img-with-no-src-uses-its-attributes
  :group :replaced
  ;; AGREES: 40x20 on both sides, with nothing to load.
  :html "<div style=\"width: 400px\"><img width=\"40\" height=\"20\"></div>"}

 {:id :replaced/img-max-width-clamps-before-the-ratio
  :group :replaced
  ;; Where the clamp goes, which is the one thing the ratio path can get
  ;; backwards: Brave says 20x10 -- min/max has its say on the WIDTH and
  ;; the ratio then solves the height from the clamped number, rather than
  ;; the resource's 40x20 being clipped to 20 wide and left 20 tall.
  :html "<div style=\"width: 400px\"><img src=\"data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSI0MCIgaGVpZ2h0PSIyMCIvPg==\" style=\"max-width: 20px\"></div>"}

 {:id :replaced/img-border-and-padding-sit-outside-the-resource-size
  :group :replaced
  ;; A resource's size is a CONTENT size in both box-sizing modes, which
  ;; is the same fact an <iframe>'s UA `border: 2px inset` establishes from
  ;; the other side. Brave: 216x116 here (a 200x100 content box plus 8px
  ;; of border+padding on each edge), and 200x108 for the same declaration
  ;; under `box-sizing: border-box` (a 184x92 content box).
  :html "<div style=\"width: 400px\"><img src=\"data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSI0MCIgaGVpZ2h0PSIyMCIvPg==\" style=\"width: 200px; border: 5px solid #000; padding: 3px\"></div>"}

 {:id :replaced/canvas-default-size
  :group :replaced
  ;; Brave: 300x150, HTML's own default canvas size, in a 400x156 line.
  ;; AGREES. It was a 400x0 block in a 400x0 parent until 2026-08-06.
  :html "<div style=\"width: 400px\"><canvas></canvas></div>"}

 {:id :replaced/canvas-attributes-size-it
  :group :replaced
  ;; Brave: 80x40, and AGREES. Its pair above says the 300x150 is a
  ;; DEFAULT rather than a constant; this one says the attributes are read
  ;; at all -- and a <canvas>'s are its BITMAP, not a presentational hint,
  ;; which is measurable: with these same attributes and a CSS
  ;; `width: 200px` Brave says 200x100 for a canvas (the 2:1 ratio solves
  ;; the height) and 200x40 for a <video> or an <img>.
  :html "<div style=\"width: 400px\"><canvas width=\"80\" height=\"40\"></canvas></div>"}

 {:id :replaced/canvas-in-a-sentence
  :group :replaced
  ;; What the block treatment cost on the LINE axis, not just the box:
  ;; Brave keeps `before <canvas> after` on one line with the canvas an
  ;; atomic inline at x=49 y=4 w=20 h=10 sitting on the baseline, where
  ;; this engine put `before` and `after` on two lines with a 400px-wide
  ;; block between them. AGREES since 2026-08-06, and it is the case that
  ;; makes the atomic-inline half a separate finding from the size half:
  ;; an element can reserve the right box and still break the sentence.
  :html "<div style=\"width: 400px\">before <canvas width=\"20\" height=\"10\"></canvas> after</div>"}

 {:id :replaced/iframe-default-size
  :group :replaced
  ;; Brave: 304x154 -- the 300x150 default plus Chrome's UA
  ;; `border: 2px inset` on all four sides. AGREES. Measured alongside:
  ;; `border: 0` on the same iframe gives 300x150 exactly, which is what
  ;; says the default object size is a CONTENT size.
  :html "<div style=\"width: 400px\"><iframe></iframe></div>"}

 {:id :replaced/video-default-size
  :group :replaced
  ;; Brave: 300x150, and AGREES. Its difference from the <canvas> above
  ;; is the whole shape of the sizing rule: a bare <video> has no
  ;; intrinsic size at all, so `width: 200px` leaves it 150 tall where the
  ;; canvas's own 2:1 bitmap makes it 100.
  :html "<div style=\"width: 400px\"><video></video></div>"}

 {:id :replaced/svg-without-attributes-is-300x150
  :group :replaced
  ;; Brave: 300x150, and AGREES. An <svg> WITH width/height attributes is
  ;; 60x30, but the default is the interesting half -- the same 300x150 as
  ;; a canvas, which is CSS's own default sizing of a replaced element
  ;; with no intrinsic size rather than an HTML per-element constant. An
  ;; <svg> with a `viewBox` is a third answer and a documented scope cut:
  ;; measured, `viewBox="0 0 40 20"` in a 400px block is 400x200 there and
  ;; 300x150 here -- an intrinsic RATIO with no intrinsic size.
  :html "<div style=\"width: 400px\"><svg></svg></div>"}

 ;; ---- stacking contexts, and what a browser will actually let you click ----
 ;; Every geometry box in this group AGREES exactly, on both sides, in all
 ;; eighteen cases. That is the paint-order axis's entire reason to exist:
 ;; an engine can put every rectangle in the right place and still hand
 ;; the user the wrong element under the pointer.
 ;;
 ;; Two shapes are repeated deliberately. `<section>` over `<article>`
 ;; whenever the two boxes need to be told apart by their TAG, and
 ;; `<div class="lower">` over `<div class="upper">` in the two cases that
 ;; exist to prove the axis can now tell two boxes of the SAME tag apart
 ;; at all (it could not before this round -- see engine-topmost-at).

 {:id :stacking/z-index-on-a-static-box-is-ignored
  :group :stacking
  ;; AGREES, and it is the control for the four cases after it: `z-index`
  ;; applies only to a positioned box (or a flex/grid item), so this one
  ;; must NOT lift anything. Brave and this engine both answer `article`
  ;; at all 25 points -- the later sibling, exactly as if the declaration
  ;; were absent.
  :html "<div style=\"height: 60px\"><section style=\"height: 60px; background: #f00\">a</section><article style=\"height: 60px; margin-top: -60px; background: #0f0; z-index: 5\">b</article></div>"}

 {:id :stacking/opacity-lifts-a-box-above-later-flow
  :group :stacking
  ;; `opacity < 1` makes the box a stacking context, which real CSS paints
  ;; in Appendix E's step 8 -- above ALL in-flow content, including a
  ;; later sibling that overlaps it. Brave: `section` at every one of the
  ;; 25 points; this engine: `article` at every one of them.
  :html "<div style=\"height: 60px\"><section style=\"height: 60px; background: #f00; opacity: 0.99\">a</section><article style=\"height: 60px; margin-top: -60px; background: #0f0\">b</article></div>"}

 {:id :stacking/transform-lifts-a-box-above-later-flow
  :group :stacking
  ;; Same rule, different trigger. Round twenty-seven implemented
  ;; `transform` for geometry and named what it left: "a transformed
  ;; element also establishes a stacking context in real CSS and this
  ;; engine does not model that". This is that sentence, measured --
  ;; Brave `section`, engine `article`, 25 points.
  :html "<div style=\"height: 60px\"><section style=\"height: 60px; background: #f00; transform: translateY(0px)\">a</section><article style=\"height: 60px; margin-top: -60px; background: #0f0\">b</article></div>"}

 {:id :stacking/filter-lifts-a-box-above-later-flow
  :group :stacking
  ;; And a third trigger, on a property nothing in src/ reads at all.
  ;; Brave: `section`.
  :html "<div style=\"height: 60px\"><section style=\"height: 60px; background: #f00; filter: blur(0px)\">a</section><article style=\"height: 60px; margin-top: -60px; background: #0f0\">b</article></div>"}

 {:id :stacking/relative-lifts-a-box-above-later-flow
  :group :stacking
  ;; The oldest of the four and the one most pages depend on: a POSITIONED
  ;; box with no z-index at all is painted in step 8 too, so
  ;; `position: relative` alone puts it over a later in-flow sibling.
  ;; Brave: `section`. This engine's `layout-absolute-children` sorts the
  ;; OUT-OF-FLOW children into z-index bands, and a relatively positioned
  ;; box is still in flow, so nothing lifts it.
  :html "<div style=\"height: 60px\"><section style=\"height: 60px; background: #f00; position: relative\">a</section><article style=\"height: 60px; margin-top: -60px; background: #0f0\">b</article></div>"}

 {:id :stacking/relative-with-z-auto-does-not-confine-a-descendant
  :group :stacking
  ;; The discriminating pair, first half. `position: relative` with
  ;; `z-index: auto` is NOT a stacking context, so the z-index: 5
  ;; descendant competes in the ROOT context and wins. Brave: `section`;
  ;; this engine: `article`.
  :html "<div style=\"position: relative; height: 60px\"><div style=\"position: relative\"><section style=\"position: absolute; left: 0; top: 0; width: 700px; height: 60px; background: #f00; z-index: 5\">a</section></div><article style=\"position: absolute; left: 0; top: 0; width: 700px; height: 60px; background: #0f0; z-index: 2\">b</article></div>"}

 {:id :stacking/relative-inline-block-with-z-zero-confines-a-descendant
  :group :stacking
  ;; The same pair as the two block cases below, on an ATOMIC inline, so
  ;; that the `position: relative` fix on that path is measured for
  ;; stacking as well as for position. An integer `z-index` on a
  ;; positioned box makes it a stacking context, so the `z-index: 5`
  ;; child is confined to it and the `z-index: 2` sibling of its wrapper
  ;; paints on top -- Brave answers `lime` over the overlap. The
  ;; GEOMETRY of this case and of the one after it is identical, which is
  ;; the point: only the paint axis can tell them apart.
  :html "<div style=\"position: relative; width: 300px; height: 24px\">ab<span style=\"display: inline-block; width: 60px; height: 20px; position: relative; z-index: 0; background: blue\"><span style=\"position: absolute; left: 0; top: 0; width: 60px; height: 20px; background: red; z-index: 5\"></span></span><span style=\"position: absolute; left: 0; top: 0; width: 120px; height: 20px; background: lime; z-index: 2\"></span></div>"}

 {:id :stacking/relative-inline-block-with-z-auto-does-not-confine
  :group :stacking
  ;; ...and with `z-index: auto` the inline-block is NOT a stacking
  ;; context, so its `z-index: 5` child competes in the wrapper's context
  ;; and beats the `z-index: 2` sibling -- Brave answers `red`.
  :html "<div style=\"position: relative; width: 300px; height: 24px\">ab<span style=\"display: inline-block; width: 60px; height: 20px; position: relative; background: blue\"><span style=\"position: absolute; left: 0; top: 0; width: 60px; height: 20px; background: red; z-index: 5\"></span></span><span style=\"position: absolute; left: 0; top: 0; width: 120px; height: 20px; background: lime; z-index: 2\"></span></div>"}

 {:id :stacking/relative-with-z-zero-confines-a-descendant
  :group :stacking
  ;; Second half, and the ONLY difference in the markup is `z-index: 0` on
  ;; the middle div, which makes it a stacking context and confines the 5.
  ;; Brave: `article`. This engine AGREES here -- and the pair is what
  ;; says why: it confines a descendant's z-index in BOTH shapes, so it is
  ;; right by accident here and wrong above. One declaration apart, two
  ;; different answers, is what makes this a measurement of the rule
  ;; rather than of a number.
  :html "<div style=\"position: relative; height: 60px\"><div style=\"position: relative; z-index: 0\"><section style=\"position: absolute; left: 0; top: 0; width: 700px; height: 60px; background: #f00; z-index: 5\">a</section></div><article style=\"position: absolute; left: 0; top: 0; width: 700px; height: 60px; background: #0f0; z-index: 2\">b</article></div>"}

 {:id :stacking/isolation-isolate-confines-a-descendant
  :group :stacking
  ;; `isolation: isolate` exists for no other purpose than to create a
  ;; stacking context. Brave: `article`, and this engine agrees for the
  ;; same accidental reason as the case above -- `isolation` appears
  ;; nowhere in src/.
  :html "<div style=\"position: relative; height: 60px\"><div style=\"isolation: isolate\"><section style=\"position: absolute; left: 0; top: 0; width: 700px; height: 60px; background: #f00; z-index: 5\">a</section></div><article style=\"position: absolute; left: 0; top: 0; width: 700px; height: 60px; background: #0f0; z-index: 2\">b</article></div>"}

 {:id :stacking/negative-z-index-stays-above-its-own-context
  :group :stacking
  ;; A negative z-index child goes behind its stacking context's CONTENT
  ;; but not behind that context's own BACKGROUND: Appendix E paints the
  ;; context's background in step 1 and its negative-z children in step 2.
  ;; Brave: `article` -- the -1 box is on top of the blue section that
  ;; established the context. This engine: `section`.
  :html "<div style=\"height: 60px\"><section style=\"position: relative; z-index: 0; height: 60px; background: #00f\"><article style=\"position: absolute; left: 0; top: 0; width: 700px; height: 60px; background: #f00; z-index: -1\">a</article></section></div>"}

 {:id :stacking/negative-z-index-goes-behind-a-plain-parent
  :group :stacking
  ;; Its pair: drop the `z-index: 0` and the parent is no longer a
  ;; stacking context, so the -1 box sinks past it into the root context
  ;; and the parent's own background covers it. Brave: `section`, and
  ;; this engine agrees -- it sinks the box in both shapes.
  :html "<div style=\"height: 60px\"><section style=\"position: relative; height: 60px; background: #00f\"><article style=\"position: absolute; left: 0; top: 0; width: 700px; height: 60px; background: #f00; z-index: -1\">a</article></section></div>"}

 {:id :stacking/z-index-on-a-flex-item
  :group :stacking
  ;; A flex ITEM takes a z-index without being positioned -- the one place
  ;; the control at the top of this group does not apply. Brave: `section`
  ;; over the first four sample columns (the negative margin pulls the
  ;; article across it) and `article` at x=720, past the section's 700px.
  ;; This engine: `article` everywhere.
  :html "<div style=\"display: flex; height: 60px\"><section style=\"width: 700px; height: 60px; background: #f00; z-index: 2; margin-right: -650px\">a</section><article style=\"width: 700px; height: 60px; background: #0f0\">b</article></div>"}

 {:id :stacking/pointer-events-none-falls-through
  :group :stacking
  ;; Not a paint question at all: the green box IS painted on top, and a
  ;; click still lands on the red one underneath. Brave: `section` in the
  ;; first four columns, the wrapper `div` at x=720. This engine agrees --
  ;; and it did not before this round, because the HARNESS was not reading
  ;; the `:pointer-events` key the engine puts on every `:node` op for
  ;; exactly this purpose. See engine-topmost-at.
  :html "<div style=\"position: relative; height: 60px\"><section style=\"position: absolute; left: 0; top: 0; width: 700px; height: 60px; background: #f00\">a</section><article style=\"position: absolute; left: 0; top: 0; width: 700px; height: 60px; background: #0f0; pointer-events: none\">b</article></div>"}

 {:id :stacking/visibility-hidden-is-not-hit
  :group :stacking
  ;; Brave: `section`. A `visibility: hidden` box keeps its space (the
  ;; corpus already has that half) and answers no clicks. Same story as
  ;; the case above: the engine had this right and the harness was not
  ;; reading `:visibility`.
  :html "<div style=\"position: relative; height: 60px\"><section style=\"position: absolute; left: 0; top: 0; width: 700px; height: 60px; background: #f00\">a</section><article style=\"position: absolute; left: 0; top: 0; width: 700px; height: 60px; background: #0f0; visibility: hidden\">b</article></div>"}

 {:id :stacking/opacity-zero-is-still-hit
  :group :stacking
  ;; Its contrast partner, and the answers are opposite: a box invisible
  ;; by OPACITY is still a hit-test candidate. Brave: `article`, and this
  ;; engine agrees -- which is what stops the two skips above from being
  ;; "skip anything you cannot see".
  :html "<div style=\"position: relative; height: 60px\"><section style=\"position: absolute; left: 0; top: 0; width: 700px; height: 60px; background: #f00\">a</section><article style=\"position: absolute; left: 0; top: 0; width: 700px; height: 60px; background: #0f0; opacity: 0\">b</article></div>"}

 {:id :stacking/border-radius-shrinks-the-hit-region
  :group :stacking
  ;; A rounded box is not hit outside its curve. Brave, on an 800x200 box
  ;; with `border-radius: 50%`: the four CORNER sample points (10% and 90%
  ;; of each axis) answer the wrapper `div` and the other 21 answer
  ;; `section`. This is the third measured case of an element's reported
  ;; box and its hit region being different rectangles -- see
  ;; cssom.layout's `:hit` key, added for the first two -- and the first
  ;; where the region is not a union of rectangles at all.
  :html "<div style=\"width: 800px; height: 200px\"><section style=\"width: 800px; height: 200px; border-radius: 50%; background: #f00\">r</section></div>"}

 {:id :stacking/content-visibility-hidden-is-not-painted
  :group :stacking
  ;; `content-visibility: hidden` skips the subtree's PAINT while keeping
  ;; its layout: Brave reports a real 800x60 box for the <article> and a
  ;; Range reads "inner" out of it, and all 25 sample points answer
  ;; `section`. Geometry and the line axis therefore agree with this
  ;; engine and only paint order can see the difference -- the same shape
  ;; as `:interactive/details-closed-shows-only-the-summary`, which is how
  ;; Chromium implements a closed <details> in the first place.
  :html "<div style=\"height: 60px\"><section style=\"content-visibility: hidden; height: 60px; background: #eee\"><article style=\"height: 60px; background: #f00\">inner</article></section></div>"}

 {:id :stacking/same-tag-opacity-lifts-the-earlier-box
  :group :stacking
  ;; The same shape as `:stacking/opacity-lifts-a-box-above-later-flow`
  ;; with two <div>s instead of a <section> and an <article>, and it is
  ;; here to prove the axis can now see it: until this round the oracle
  ;; reported only a TAG per sample point, so two overlapping <div>s were
  ;; indistinguishable and this case would have passed while measuring
  ;; nothing. Brave: `div.lower` at all 25 points; this engine:
  ;; `div.upper`.
  :html "<div style=\"height: 60px\"><div class=\"lower\" style=\"height: 60px; background: #f00; opacity: 0.99\">a</div><div class=\"upper\" style=\"height: 60px; margin-top: -60px; background: #0f0\">b</div></div>"}

 {:id :stacking/same-tag-later-sibling-covers-earlier
  :group :stacking
  ;; Its control, and it AGREES: with the opacity gone the later div wins
  ;; on both sides. Brave and this engine both answer `div.upper`. Two
  ;; same-tag cases whose answers differ is the evidence that the class is
  ;; being compared rather than ignored.
  :html "<div style=\"height: 60px\"><div class=\"lower\" style=\"height: 60px; background: #f00\">a</div><div class=\"upper\" style=\"height: 60px; margin-top: -60px; background: #0f0\">b</div></div>"}

 ;; ---- a percentage in the BLOCK axis of the box model is of the WIDTH ----
 ;; CSS 2.1 SS8.3/SS8.4: a percentage margin or padding resolves against
 ;; the containing block's INLINE size on all four sides, top and bottom
 ;; included. It is the rule behind the padding-bottom aspect-ratio idiom,
 ;; and nothing in the corpus asked for it. When these four were written
 ;; this engine read the number and dropped the unit -- `padding-bottom:
 ;; 50%` was 50px -- the same defect round thirty-two recorded for
 ;; percentage GAPS ("node-style runs parse-int on the string, and it has
 ;; no available size to resolve a percentage against").
 ;;
 ;; THREE OF THE FOUR now agree (2026-08-06): node-style carries the raw
 ;; value beside the coerced one and `resolve-box-percentages` rewrites it
 ;; wherever the containing block's inline size is in scope. The fourth,
 ;; `margin-top-percentage-is-of-the-width`, is blocked on the SAME missing
 ;; per-side border as `:logical/border-inline-start` -- its 1px
 ;; `border-top` is there to stop the margin collapsing through the parent,
 ;; and this engine cannot see it, so the (now correctly resolved) 30px
 ;; margin collapses out. With the parent's `padding-top: 1px` instead of a
 ;; border, both sides put the child at y=31 (asserted in layout_test).
 ;;
 ;; It did NOT cover the two percentage GAP cases, and that is a rule
 ;; difference rather than an oversight: a percentage margin/padding is of
 ;; the containing block's inline size on all four sides, a percentage
 ;; `top`/`left` is of the containing block's size in its OWN axis (those
 ;; already agreed), and a percentage `row-gap` is of the container's own
 ;; content BLOCK size -- which for an auto-height container is cyclic.
 ;; Measured in Brave: a 10% row gap on a 40px-tall auto grid is 4px AND
 ;; the container stays 40 tall, i.e. the gap is resolved against a height
 ;; computed without it and the content then overflows. Three bases, one
 ;; shared `percentage-of`.

 {:id :box/padding-top-percentage-is-of-the-width
  :group :box
  ;; Brave: 10% of the 300px container is 30px of padding, so the inner
  ;; box is 50 tall and its text sits at y=32. Resolving against the
  ;; parent's 40px HEIGHT would have given 4, and reading the bare number
  ;; gives 10 -- which is what this engine did (h=30). AGREES since
  ;; 2026-08-06.
  :html "<div style=\"width: 300px; height: 40px\"><div style=\"padding-top: 10%\">p</div></div>"}

 {:id :box/padding-bottom-percentage-makes-a-ratio-box
  :group :box
  ;; The idiom itself. Brave: 300x150 from `padding-bottom: 50%` alone,
  ;; with no height anywhere. Engine was 300x50; AGREES since 2026-08-06.
  :html "<div style=\"width: 300px\"><div style=\"padding-bottom: 50%\"></div></div>"}

 {:id :box/margin-top-percentage-is-of-the-width
  :group :box
  ;; Same rule for margins. Brave: child at y=31, parent 51 tall. The 1px
  ;; border on the parent is not the subject -- it is there to stop the
  ;; child's top margin collapsing through it, which would take the
  ;; number out of the case.
  ;;
  ;; AGREES since 2026-08-06. It diverged for the border alone after the
  ;; percentage landed: the 10% resolved to 30px like the three cases
  ;; around it and then collapsed straight out through a parent this
  ;; engine saw no border on, because `border-top` was not parsed as a
  ;; per-side shorthand and there was no per-side border to parse it into.
  ;; Both halves are there now.
  :html "<div style=\"width: 300px; border-top: 1px solid #000\"><div style=\"margin-top: 10%; height: 20px\">m</div></div>"}

 {:id :box/margin-left-percentage
  :group :box
  ;; The inline-axis control for the three above, and it failed the same
  ;; way: Brave x=30 w=270, this engine x=10 w=290. So the percentage was
  ;; not a block-axis problem -- the unit was dropped on every side.
  ;; AGREES since 2026-08-06.
  :html "<div style=\"width: 300px\"><div style=\"margin-left: 10%; height: 20px\">m</div></div>"}

 ;; ---- vertical-align, at every value that moves a box ----
 ;; The corpus had exactly one case for this property (`gap/vertical-
 ;; align-top`, on a table cell) and none at all for an inline-level box.
 ;; Each shape is a 40px inline-block (which sets the line box) beside a
 ;; 10px one carrying the value under test, so the SECOND span's y is the
 ;; whole measurement and the geometry axis reads it directly. Brave puts
 ;; the line box at 46 tall in all seven and the baseline default at y=30.
 ;; This engine answered 30 for six of the seven until 2026-08-06 -- i.e.
 ;; it left an atomic inline on the baseline -- and `middle` was the
 ;; exception that made the other six a finding rather than "the property
 ;; does nothing here". ALL SEVEN AGREE now; each case below records what
 ;; it measured and which rule reproduces it.

 {:id :inline/vertical-align-middle
  :group :inline
  ;; AGREES, to the last fractional pixel: both sides say y=31.828125 --
  ;; the box's middle aligned with the baseline plus half the parent's
  ;; x-height, which is why it is not simply 30. It is the control that
  ;; makes the other six a finding rather than "vertical-align does
  ;; nothing here".
  :html "<div style=\"width: 400px\"><span style=\"display: inline-block; width: 20px; height: 40px\"></span><span style=\"display: inline-block; width: 20px; height: 10px; vertical-align: middle\"></span></div>"}

 {:id :inline/vertical-align-top-on-an-inline-block
  :group :inline
  ;; AGREES since 2026-08-06. Brave: y=0, the top of the LINE BOX --
  ;; which is not known until every other box on the line has been
  ;; placed, so this is the one value the atomic path needs a second pass
  ;; for (inline-line-metrics rewrites the fragment's `:baseline-offset`
  ;; once the union is known).
  :html "<div style=\"width: 400px\"><span style=\"display: inline-block; width: 20px; height: 40px\"></span><span style=\"display: inline-block; width: 20px; height: 10px; vertical-align: top\"></span></div>"}

 {:id :inline/vertical-align-bottom-on-an-inline-block
  :group :inline
  ;; AGREES since 2026-08-06. Brave: y=36, flush with the line box's
  ;; bottom at 46 -- the mirror of `top`, through the same second pass.
  :html "<div style=\"width: 400px\"><span style=\"display: inline-block; width: 20px; height: 40px\"></span><span style=\"display: inline-block; width: 20px; height: 10px; vertical-align: bottom\"></span></div>"}

 {:id :inline/vertical-align-text-top
  :group :inline
  ;; AGREES. `text-top` is the parent's FONT's top, not the line box's,
  ;; so Brave says 28 where `top` says 0, and the pair is what makes
  ;; either number mean anything. This case PASSED while being wrong:
  ;; engine 30 against oracle 28 is exactly the 2px tolerance, so only the
  ;; per-case `--dump-ops` diff showed it moving to 28 on 2026-08-06. The
  ;; rule is `baseline - parent ascent`: unmoved by any line-height, and
  ;; moved by the parent's face (a bold parent reads 26).
  :html "<div style=\"width: 400px\"><span style=\"display: inline-block; width: 20px; height: 40px\"></span><span style=\"display: inline-block; width: 20px; height: 10px; vertical-align: text-top\"></span></div>"}

 {:id :inline/vertical-align-text-bottom
  :group :inline
  ;; AGREES since 2026-08-06. Brave: y=33, against `bottom`'s 36 --
  ;; `baseline + parent descent - h`, one descent below the baseline
  ;; rather than at the line's own bottom edge.
  :html "<div style=\"width: 400px\"><span style=\"display: inline-block; width: 20px; height: 40px\"></span><span style=\"display: inline-block; width: 20px; height: 10px; vertical-align: text-bottom\"></span></div>"}

 {:id :inline/vertical-align-length
  :group :inline
  ;; AGREES. A length RAISES the box off the baseline. Brave: y=18,
  ;; exactly 12 above the baseline default's 30. The control for the
  ;; percentage below: the same kind of offset from a different base.
  :html "<div style=\"width: 400px\"><span style=\"display: inline-block; width: 20px; height: 40px\"></span><span style=\"display: inline-block; width: 20px; height: 10px; vertical-align: 12px\"></span></div>"}

 {:id :inline/vertical-align-percentage
  :group :inline
  ;; AGREES since 2026-08-06. A percentage is of the element's own
  ;; LINE-HEIGHT (20px here), so 50% raises by 10 -- Brave: y=20, against
  ;; 30. Discriminated by measurement rather than read off a spec: the
  ;; BOX's own `line-height: 40px` doubles the raise and the container's
  ;; `font-size: 28px` does not change it.
  :html "<div style=\"width: 400px\"><span style=\"display: inline-block; width: 20px; height: 40px\"></span><span style=\"display: inline-block; width: 20px; height: 10px; vertical-align: 50%\"></span></div>"}

 ;; ---- visibility: collapse ----
 ;; The one visibility value with a behaviour of its own, and the corpus
 ;; had `visible` and `hidden` only.

 {:id :visibility/collapse-removes-a-table-row
  :group :visibility
  ;; Brave: the collapsed <tr> and its <td> are 0px tall, the third row
  ;; moves UP to y=22, and the table is 44 tall rather than 66. This
  ;; engine renders the row as if it were `hidden` (66, rows at 0/22/44),
  ;; which is what the two controls below say is right EVERYWHERE ELSE.
  :html "<table style=\"border-collapse: collapse\"><tr><td>one</td></tr><tr style=\"visibility: collapse\"><td>two</td></tr><tr><td>three</td></tr></table>"}

 {:id :visibility/collapse-on-a-block-is-hidden
  :group :visibility
  ;; AGREES: outside a table `collapse` is exactly `hidden`, so Brave and
  ;; this engine both keep the 20px and put `b` at y=20.
  :html "<div style=\"width: 300px\"><div style=\"height: 20px; visibility: collapse\">a</div><div style=\"height: 20px\">b</div></div>"}

 {:id :visibility/collapse-removes-a-table-column
  :group :visibility
  ;; The column half of the same property, landed 2026-08-06. Brave: the
  ;; collapsed `<col>` is 0x0, the cell in it is 0 wide and keeps its full
  ;; row height, the third column shifts left, and ONE border-spacing goes
  ;; with the column -- table 42x26 with cells at x=2, 20 and 22, against
  ;; the control's 62 with cells at 2, 22 and 42.
  :html "<table><colgroup><col><col style=\"visibility: collapse\"><col></colgroup><tr><td style=\"width: 16px\">a</td><td style=\"width: 16px\">b</td><td style=\"width: 16px\">c</td></tr></table>"}

 {:id :visibility/a-table-column-that-is-not-collapsed
  :group :visibility
  ;; CONTROL for the case above, same markup without the declaration:
  ;; 62x26, three 18px columns and four 2px gaps.
  :html "<table><colgroup><col><col><col></colgroup><tr><td style=\"width: 16px\">a</td><td style=\"width: 16px\">b</td><td style=\"width: 16px\">c</td></tr></table>"}

 {:id :visibility/collapse-on-a-column-group-removes-its-columns
  :group :visibility
  ;; A `<colgroup>` collapses every column it covers, and a group whose
  ;; columns are ALL gone is 0x0 rather than 0 wide and full height --
  ;; measured, exactly as a single collapsed `<col>` is. Here the FIRST
  ;; column goes, so the gap that leaves with it is the one AFTER it (the
  ;; table's leading border-spacing is the table's, not the column's): the
  ;; second cell sits at x=2, the same place the first one would have.
  :html "<table><colgroup style=\"visibility: collapse\"><col></colgroup><colgroup><col><col></colgroup><tr><td style=\"width: 16px\">a</td><td style=\"width: 16px\">b</td><td style=\"width: 16px\">c</td></tr></table>"}

 {:id :visibility/collapse-on-a-cell-collapses-nothing
  :group :visibility
  ;; CONTROL, and the reason the column test is self-or-column-group rather
  ;; than self-or-ancestor: `collapse` on a `<td>` is plain `hidden`. The
  ;; table is still 62 wide with three 18px columns.
  :html "<table><tr><td style=\"width: 16px\">a</td><td style=\"width: 16px; visibility: collapse\">b</td><td style=\"width: 16px\">c</td></tr></table>"}

 {:id :visibility/collapse-on-the-first-table-row
  :group :visibility
  ;; The position the row axis got wrong until the column axis asked the
  ;; same question sideways. A collapsed track takes exactly one adjacent
  ;; gap with it, and for track ZERO that gap is the one AFTER it: Brave
  ;; puts the second row at the same y the first would have had. Under
  ;; `border-collapse: collapse` the spacing is 0 either way, so what this
  ;; case actually pins is the table height -- 44, not 66, and not the 88
  ;; the old rule gave the border-spacing form.
  :html "<table style=\"border-collapse: collapse\"><tr style=\"visibility: collapse\"><td>one</td></tr><tr><td>two</td></tr><tr><td>three</td></tr></table>"}

 {:id :visibility/a-colspan-crossing-a-collapsed-column
  :group :visibility
  ;; No special case needed, and that is the finding: the spanning cell is
  ;; the sum of the columns it covers and the gaps between them, and a
  ;; collapsed column contributes zero of each. Brave reports it 20 wide --
  ;; column 0's 20, a dropped gap, and column 1's 0.
  :html "<table><colgroup><col><col style=\"visibility: collapse\"><col></colgroup><tr><td colspan=\"2\" style=\"width: 40px\">wide</td><td style=\"width: 16px\">c</td></tr><tr><td style=\"width: 16px\">a</td><td style=\"width: 16px\">b</td><td style=\"width: 16px\">c</td></tr></table>"}

 {:id :visibility/collapse-on-a-flex-item-is-hidden
  :group :visibility
  ;; AGREES, including on a flex item, where the spec once said
  ;; otherwise: the three items are at x=0, 60 and 120 on both sides --
  ;; the collapsed one keeps its track.
  :html "<div style=\"display: flex; width: 300px\"><div style=\"width: 60px; height: 20px\">a</div><div style=\"width: 60px; height: 20px; visibility: collapse\">b</div><div style=\"width: 60px; height: 20px\">c</div></div>"}

 ;; ---- borders: per side, and the two that take no space ----
 ;; Round twenty-six named "per-side border widths" as not implemented --
 ;; "this engine has one uniform `:border-width`". Measured, it was sharper
 ;; than that: a per-side SHORTHAND was not read at all, so `border-top:
 ;; 10px solid` contributed nothing rather than ten pixels on four sides.
 ;; Both halves landed on 2026-08-06 -- the cascade expands the four
 ;; per-side shorthands and the three 1-to-4 ones, and `node-style`
 ;; resolves four used widths through each side's own style.

 {:id :box/border-top-width-only
  :group :box
  ;; Brave: the bordered div is 30 tall and its <p> is at y=10 with the
  ;; full w=300 -- a top border costs height and nothing else. AGREES
  ;; since 2026-08-06; this engine was 20 tall with the <p> at y=0.
  :html "<div style=\"width: 300px\"><div style=\"border-top: 10px solid #000\"><p style=\"margin: 0\">p</p></div></div>"}

 {:id :box/border-left-width-only
  :group :box
  ;; The mirror: Brave puts the <p> at x=20 with w=280 and the div stays
  ;; 300 wide. A uniform border would have taken 20 off all four sides;
  ;; this engine took none off any of them. AGREES since 2026-08-06.
  :html "<div style=\"width: 300px\"><div style=\"border-left: 20px solid #000\"><p style=\"margin: 0\">p</p></div></div>"}

 {:id :box/border-width-with-style-none-takes-no-space
  :group :box
  ;; AGREES, and it is the control that kept the two above honest, before
  ;; and after the fix: `border-style: none` makes the computed
  ;; `border-width` ZERO however wide it was declared, which is CSS's own
  ;; rule and not a rendering shortcut. Brave and this engine both put the
  ;; <p> at x=0 w=300 in a 20-tall div, i.e. the 10px is not there at all
  ;; -- so the fix for the two cases above could not simply start adding
  ;; declared widths up, and does not.
  :html "<div style=\"width: 300px\"><div style=\"border-width: 10px; border-style: none\"><p style=\"margin: 0\">p</p></div></div>"}

 {:id :box/outline-takes-no-space
  :group :box
  ;; AGREES: an outline is drawn outside the border box and moves nothing.
  ;; Both sides put `b` at y=20. `expand-outline-shorthand` in cssom.core
  ;; parses the property, so this is a real regression guard rather than a
  ;; test that an unknown declaration is ignored.
  :html "<div style=\"width: 300px\"><div style=\"outline: 5px solid #000; height: 20px\">a</div><div style=\"height: 20px\">b</div></div>"}

 {:id :box/box-shadow-takes-no-space
  :group :box
  ;; AGREES: neither does a shadow, spread included. `b` at y=20 on both
  ;; sides, and `expand-box-shadow-shorthand` does parse the 10px spread.
  :html "<div style=\"width: 300px\"><div style=\"box-shadow: 0 0 0 10px #000; height: 20px\">a</div><div style=\"height: 20px\">b</div></div>"}

 ;; ---- generated content, measured where the oracle CAN see it ----
 ;; A ::before/::after is not DOM text, so no Range reaches it and the
 ;; line axis is structurally blind (hence `:oracle/blind` on all four).
 ;; What is NOT blind is the box whose size the generated content changes,
 ;; and these shapes are chosen so that box is the answer.

 {:id :generated/after-content-widens-an-inline
  :group :generated
  :oracle/blind true
  ;; AGREES on the box: Brave's <b> is 37.03125 wide -- 24.234 of `mid`
  ;; plus 12.797 of `!!!` -- and this engine says 37.0234375. (Brave
  ;; reports it as TWO client rects, one per piece; the geometry axis
  ;; compares the union, which is what getBoundingClientRect returns.)
  :html "<div style=\"width: 300px\">x<b class=\"aft\">mid</b>y</div>"
  :css ".aft::after { content: \"!!!\" }"}

 {:id :generated/counter-reset-with-a-start-value
  :group :generated
  :oracle/blind true
  ;; AGREES: `counter-reset: k 7` sets the counter to 7 rather than 0, so
  ;; the generated text is `7-`. The box is shrink-to-fit, which is what
  ;; makes the width the whole measurement -- Brave and this engine both
  ;; say 21 (three characters), against the 14 a missing counter would
  ;; give and the 21 a counter starting at 0 would give ONLY by having
  ;; the same digit count, which is why the start value is 7 and not 1.
  :html "<div style=\"width: 300px\"><div class=\"kk\" style=\"display: inline-block\">x</div></div>"
  :css ".kk::before { content: counter(k) \"-\" } .kk { counter-reset: k 7 }"}

 {:id :generated/before-display-block-makes-its-own-line
  :group :generated
  :oracle/blind true
  ;; A `display: block` ::before is a block box, not the first thing in
  ;; the element's line. Brave: the <p> is 40 tall and `tail` is at y=22.
  ;; This engine flows the generated text into the paragraph's own line
  ;; and reports 20.
  :html "<div style=\"width: 300px\"><p style=\"margin: 0\" class=\"bb\">tail</p></div>"
  :css ".bb::before { content: \"head\"; display: block }"}

 {:id :list/list-style-position-inside
  :group :list
  :oracle/blind true
  ;; AGREES since 2026-08-06. The value round twenty-nine implemented the
  ;; DEFAULT of, measured alongside, and never gave a case. Brave puts the
  ;; <a> at x=59 with `inside` against x=40 with the default `outside`;
  ;; this engine said 53.70625, which is 5.29 short and is exactly the
  ;; number that round recorded in `list-style-inside?` rather than
  ;; modelling. Round forty-three swept it: the disc advance is
  ;; `font-size + ceil(2 x (font-size + 2) / 7)`, exact at every integer
  ;; size from 6 to 40 and identical in Arial and monospace -- so a
  ;; browser is not laying out the `"• "` string (13.70625 here) at all.
  ;; See symbol-marker-advance.
  :html "<ul class=\"ins\" style=\"width: 300px\"><li><a href=\"#\">First</a></li></ul>"
  :css ".ins li { list-style-position: inside }"}

 ;; ---- form controls with a UA box of their own ----
 ;; `ua-control-box` covers input/button/select/textarea. These five were
 ;; the ones it did not: two tags that were not controls at all here (laid
 ;; out as 400x0 blocks) and three <input> types that all came out of the
 ;; text-field rule at 153x21. Four of the five AGREE since 2026-08-06;
 ;; the fifth (file) agrees on everything but its width, which is the one
 ;; number in this group that is not a rule -- see below.

 {:id :form/progress-default-box
  :group :form
  ;; Brave: 140x14, at y=2.797 on a 20px line. AGREES (engine 2.8, which
  ;; is the same 0.2em without Brave's 1/64 LayoutUnit flooring). It is
  ;; `10em x 1em` and `vertical-align: -0.2em`, not a platform constant:
  ;; measured at 8/14/28px the bar is 80x8, 140x14 and 280x28.
  :html "<div style=\"width: 400px\"><progress></progress></div>"}

 {:id :form/meter-default-box
  :group :form
  ;; Brave: 70x14, and AGREES -- half a progress bar, which is why both
  ;; are here, and it turned out to be `5em` against progress's `10em`
  ;; rather than a separate constant.
  :html "<div style=\"width: 400px\"><meter></meter></div>"}

 {:id :form/input-range-default-box
  :group :form
  ;; Brave: 129x16 at x=2 y=2 -- a range input carries `margin: 2px` and
  ;; no padding, where this engine gave every <input> the text field's
  ;; 153x21 and its 1px/2px padding. AGREES since 2026-08-06, and so does
  ;; the computed-style axis (those four padding values used to be the
  ;; only cascade-attributed residual these cases added). Its baseline is
  ;; its bottom BORDER edge with the 2px bottom margin hanging below --
  ;; measured by giving it `margin-bottom: 20px`, which does not move the
  ;; box.
  :html "<div style=\"width: 400px\"><input type=\"range\"></div>"}

 {:id :form/input-color-default-box
  :group :form
  ;; Brave: 50x27, and AGREES. Its baseline is 6px up from its bottom
  ;; edge, and moves with an explicit height (at `height: 50px` Brave
  ;; puts it at 44) -- which is what separates it from the file input
  ;; below, whose baseline does not move.
  :html "<div style=\"width: 400px\"><input type=\"color\"></div>"}

 {:id :form/input-file-default-box
  :group :form
  ;; Brave: 253x27 -- the width of the button plus its label text, so it
  ;; is a different KIND of number from the two fixed ones above and a
  ;; single per-type constant table would not produce it. That reading
  ;; held up when it was measured (2026-08-06) and it is the one case in
  ;; this group left OPEN on purpose. The HEIGHT is a rule and is
  ;; implemented: 27 is the engine's own 21px <button> with 3px above and
  ;; below, which is also where the control's baseline comes from (18 from
  ;; the TOP, and unlike range's and color's it does NOT move when the
  ;; height does -- measured at `height: 50px`). The WIDTH is not: the
  ;; shadow <button> holding the browser's own localized "Choose File" is
  ;; 87.141 wide and "No file chosen" in the UA control face is 84.484,
  ;; which sum to 171.625 -- 81 short of 253 -- so the control also
  ;; reserves a fixed filename column, and both strings are en-US. A 253
  ;; in the engine would be a measurement of this machine's UI language.
  ;; Engine: 145x27, i.e. the div agrees and the input's width does not.
  ;;
  ;; RE-MEASURED 2026-08-06, and the reading above was wrong in its
  ;; premise. The UA shadow tree, read over CDP with `DOM.getDocument
  ;; pierce`, is not en-US at all -- this machine's browser UI is
  ;; JAPANESE: the shadow button holds `ファイルを選択` and is 108.656
  ;; wide (92.656 of text plus 8 on each side), the filename label is
  ;; `選択されていません` at 119.313, and the gap between them is 4. Those
  ;; sum to 231.97, which does NOT reach 253 -- so the earlier `87.141 +
  ;; 84.484, 81 short` was measuring two strings the control does not
  ;; contain.
  ;;
  ;; Blink's own width is `ceil(max(34 x advance("0"), button + 4 +
  ;; label))`, and here the FIRST term wins: 34 nominal `0` glyphs of the
  ;; UA control face (Arial 13.3333) is 252.063, which ceils to exactly
  ;; 253. That term is a property of the FONT, not of the UI language, and
  ;; it is what is now implemented (atomic-intrinsic-width's `file`
  ;; branch, verified against eight font/size pairs). The localized term
  ;; is a documented scope cut -- it wins at other fonts (at `monospace
  ;; 14px` the CJK label is full-width and Brave reports 244 against this
  ;; branch's 238) and reproducing it would mean carrying every UA string
  ;; in every UI language, which is not a CSS fact.
  :html "<div style=\"width: 400px\"><input type=\"file\"></div>"}

 ;; ---- five singles, each in the group it belongs to ----

 {:id :wrap/wbr-is-a-break-opportunity
  :group :wrap
  ;; AGREES: <wbr> is a zero-width break opportunity inside a word, and
  ;; Brave breaks the 14-character run in two -- `aaaaaaa` at y=2 and
  ;; `bbbbbbb` at y=22, box 80x40 -- as does this engine, which reaches
  ;; the same answer by treating the unknown element as an inline that
  ;; splits the text into two runs. Brave reports NO box for the <wbr>
  ;; itself (getClientRects() is empty, the geometry axis's `boxless`).
  :html "<div style=\"width: 80px\">aaaaaaa<wbr>bbbbbbb</div>"}

 {:id :wrap/no-wbr-does-not-break-the-word
  :group :wrap
  ;; Its control, and it agrees too: the same 14 characters with the
  ;; <wbr> removed stay on ONE line and overflow, 98px of word in an 80px
  ;; box, 20 tall. Without this the case above would be a break that
  ;; could have come from the box being too narrow.
  :html "<div style=\"width: 80px\">aaaaaaabbbbbbb</div>"}

 {:id :text/writing-mode-vertical-rl
  :group :text
  ;; AGREES since round forty-two. Brave lays the text down the page: the
  ;; inner box is 20 wide and 70 tall, with `alpha` at y=0 and `beta` at
  ;; y=42. This case was in the corpus for eleven rounds reporting a
  ;; horizontal 300x20 and one line, recorded on the reasoning that a
  ;; vertical writing mode is `a second axis convention through every
  ;; function in cssom.layout, not a property to read`. Half of that was
  ;; right: it IS a second axis convention. What it is not is a second
  ;; convention through every function -- it is a change of BASIS applied
  ;; once, at the boundary. See the `writing modes` section in
  ;; cssom.layout, and the `:writing-mode/*` group below for the rest of
  ;; what that basis had to get right.
  :html "<div style=\"width: 300px; height: 120px\"><div style=\"writing-mode: vertical-rl\">alpha beta</div></div>"}

 {:id :multicol/columns-shorthand
  :group :multicol
  ;; AGREES: the `columns: <count> <width>` shorthand, which the twelve
  ;; existing multicol cases reach only through its longhands. Brave and
  ;; this engine both give two 143px columns with the second at x=157.
  :html "<div style=\"width: 300px; columns: 2 auto\"><div style=\"height: 30px\">a</div><div style=\"height: 30px\">b</div></div>"}

 {:id :display/inline-table-in-a-sentence
  :group :display
  ;; AGREES since 2026-08-06. Brave: the inline-table is 28x20 at x=49,
  ;; so `after` starts at 84 -- one line, with the table shrink-wrapped to
  ;; its single cell. This engine made it a block: three lines and two
  ;; 400px-wide boxes. The fix needed no sizing rule (a table already
  ;; shrink-wraps); `inline-table` simply was not inline-LEVEL.
  :html "<div style=\"width: 400px\">before <span style=\"display: inline-table\"><span style=\"display: table-cell\">cell</span></span> after</div>"}

 {:id :position/inset-shorthand
  :group :position
  ;; `inset` is the physical shorthand for top/right/bottom/left and is
  ;; not in the corpus at all. Brave: x=20 y=10 w=260 h=40. This engine
  ;; reads none of the four, so the box is shrink-to-fit at its static
  ;; position: 0,0,7x20.
  :html "<div style=\"width: 300px; height: 60px; position: relative\"><div style=\"position: absolute; inset: 10px 20px\">a</div></div>"}


 ;; ---------------------------------------------------------------------
 ;; MULTICOL FRAGMENTATION (added 2026-08-06, with the change that made a
 ;; block splittable at all). The two cases above recorded the gap; these
 ;; sixteen say what the rule IS. Every one was measured in Brave 151
 ;; before it was implemented, as part of a 59-shape probe sweep, and all
 ;; of them agree.
 ;;
 ;; A fragmented element has one rect PER FRAGMENT in getClientRects() and
 ;; the UNION of them in getBoundingClientRect(). This axis compares the
 ;; latter, which is what a `:node` op's box now is; the fragments
 ;; themselves are the op's `:hit` rects and are what the PAINT axis
 ;; compares. Neither side of the harness changed to accommodate any of
 ;; this.
 ;; ---------------------------------------------------------------------

 {:id :multicol/a-block-with-room-below-its-line-is-cut-anywhere-in-it
  :group :multicol
  ;; The free band a break may land in is CONTINUOUS. A 90px block whose
  ;; content is one 20px line is cut at 45 -- not at 20, not at any
  ;; structural boundary, exactly at half -- and reports [0,0,140,45] and
  ;; [160,0,140,45].
  :html "<div style=\"width: 300px; column-count: 2; column-gap: 20px\"><div style=\"height: 90px\">a</div></div>"}

 {:id :multicol/padding-above-the-first-line-is-not-a-break-opportunity
  :group :multicol
  ;; The asymmetry: the same 60px of box with the empty band ABOVE the line
  ;; does not cut at all. 60 tall, one rect, where `height: 60px` over the
  ;; same content balances to 30 and reports two.
  :html "<div style=\"width: 300px; column-count: 2; column-gap: 20px\"><div style=\"padding-top: 40px\">a</div></div>"}

 {:id :multicol/padding-below-the-last-line-is-not-a-break-opportunity
  :group :multicol
  ;; The other end of the same rule: the band a cut can land in is the
  ;; CONTENT box, and padding is outside it. 60 tall, one rect.
  :html "<div style=\"width: 300px; column-count: 2; column-gap: 20px\"><div style=\"padding-bottom: 40px\">a</div></div>"}

 {:id :multicol/break-inside-avoid-moves-a-whole-wrapper
  :group :multicol
  ;; The `break-inside: avoid` case the pair above cannot make: a 40px
  ;; WRAPPER that does not fit the 20px left in column one moves whole,
  ;; [160,0,140,40] with its children at y 0 and 20 beside it.
  :html "<div style=\"width: 300px; height: 40px; column-count: 2; column-gap: 20px\"><div style=\"height: 20px\">a</div><div style=\"break-inside: avoid\"><div style=\"height: 20px\">x</div><div style=\"height: 20px\">y</div></div></div>"}

 {:id :multicol/break-inside-avoid-is-dropped-when-it-cannot-be-honoured
  :group :multicol
  ;; `avoid` is a preference: a 100px block in a 40px column has to go
  ;; somewhere. It skips column one and then fragments 40/40/20.
  :html "<div style=\"width: 300px; height: 40px; column-count: 2; column-gap: 20px\"><div style=\"height: 20px\">a</div><div style=\"height: 100px; break-inside: avoid\">b</div></div>"}

 {:id :multicol/decorations-are-sliced-at-the-break
  :group :multicol
  ;; `box-decoration-break: slice` is the initial value and is what a
  ;; browser does: a 56px border box cut at 40 reports 40 and 16, summing
  ;; to 56 -- the ring cut open, not repeated.
  :html "<div style=\"width: 300px; height: 40px; column-count: 2; column-gap: 20px\"><div style=\"height: 20px\">a</div><div style=\"height: 40px; border: 5px solid #333; padding: 3px\">b</div></div>"}

 {:id :multicol/a-continuing-fragment-fills-its-column
  :group :multicol
  ;; A fragment's height is not the content it holds: a box that continues
  ;; is stretched to its column's bottom edge. Two 20px lines in a forced
  ;; 30px column report fragments of 30 and 20, and the 30 holds one line.
  :html "<div style=\"width: 300px; height: 30px; column-count: 2; column-gap: 20px\"><div>one<br>two</div></div>"}

 {:id :multicol/a-nested-block-is-cut-between-its-own-children
  :group :multicol
  ;; The cut is not a top-level operation: the wrapper is fragmented at the
  ;; boundary between two of its children, [0,20,140,20] and
  ;; [160,0,140,40], and each child lands whole on one side of it.
  :html "<div style=\"width: 300px; height: 40px; column-count: 2; column-gap: 20px\"><div style=\"height: 20px\">a</div><div><div style=\"height: 20px\">x</div><div style=\"height: 20px\">y</div><div style=\"height: 20px\">z</div></div></div>"}

 {:id :multicol/orphans-keeps-the-first-two-lines-together
  :group :multicol
  ;; `orphans` (initial 2) is what decides whether a two-line block splits
  ;; at all: it does not, and the box is 40 tall with one rect.
  :html "<div style=\"width: 300px; column-count: 2; column-gap: 20px\"><div>one<br>two</div></div>"}

 {:id :multicol/orphans-one-lets-two-lines-split
  :group :multicol
  ;; The same block with `orphans: 1` splits: 20 tall, two rects.
  :html "<div style=\"width: 300px; column-count: 2; column-gap: 20px\"><div style=\"orphans: 1\">one<br>two</div></div>"}

 {:id :multicol/widows-is-not-honoured
  :group :multicol
  ;; `orphans: 1; widows: 2` splits anyway, leaving a single widow: this
  ;; browser reads `orphans` and ignores `widows`, and so does this engine
  ;; -- deliberately, because honouring it would diverge.
  :html "<div style=\"width: 300px; column-count: 2; column-gap: 20px\"><div style=\"orphans: 1; widows: 2\">one<br>two</div></div>"}

 {:id :multicol/three-lines-split-two-and-one
  :group :multicol
  ;; Three lines DO split, 2/1 -- which is the widow the case above says is
  ;; allowed, reached from the other direction.
  :html "<div style=\"width: 300px; column-count: 2; column-gap: 20px\"><div>one<br>two<br>three</div></div>"}

 {:id :multicol/balanced-height-is-never-less-than-the-content-over-the-count
  :group :multicol
  ;; The balancer starts at ceil(total / count) and only grows. These two
  ;; blocks fit one per column at height 30 -- the 60px margin is dropped
  ;; at the break -- and the box is still 60 tall, which is ceil(120/2).
  :html "<div style=\"width: 300px; column-count: 2; column-gap: 20px\"><div style=\"height: 30px\">a</div><div style=\"height: 30px; margin-top: 60px\">b</div></div>"}

 {:id :multicol/an-overflow-hidden-block-is-monolithic
  :group :multicol
  ;; A scroll container is not fragmented: the 60px block moves whole into
  ;; the second column and overflows it.
  :html "<div style=\"width: 300px; height: 40px; column-count: 2; column-gap: 20px\"><div style=\"height: 20px\">a</div><div style=\"height: 60px; overflow: hidden\">b</div></div>"}

 {:id :multicol/a-table-fragments-between-its-rows
  :group :multicol
  ;; A table is fragmented -- between rows, never inside one.
  :html "<div style=\"width: 300px; height: 40px; column-count: 2; column-gap: 20px\"><table style=\"border-collapse: collapse\"><tr><td style=\"height: 20px; padding: 0\">a</td></tr><tr><td style=\"height: 20px; padding: 0\">b</td></tr><tr><td style=\"height: 20px; padding: 0\">c</td></tr></table></div>"}

 {:id :multicol/a-flex-container-fragments-between-its-items
  :group :multicol
  ;; And so is a column flex container, between its items.
  :html "<div style=\"width: 300px; height: 40px; column-count: 2; column-gap: 20px\"><div style=\"display: flex; flex-direction: column\"><div style=\"height: 20px\">a</div><div style=\"height: 20px\">b</div><div style=\"height: 20px\">c</div></div></div>"}

 ;; ---- writing modes -----------------------------------------------------
 ;;
 ;; Every number in these comments was measured in Brave 151 over CDP on
 ;; 2026-08-06, before any of it was implemented. The group is here rather
 ;; than under `:text` because only two of these cases are about text at
 ;; all: a vertical writing mode is a box-model rotation, and what it
 ;; mostly changes is which axis a size landed on and which direction
 ;; block-level children stack in.

 {:id :writing-mode/vertical-rl-wraps-at-the-parents-block-size
  :group :writing-mode
  ;; An orthogonal flow's `inline-size: auto` is FIT-CONTENT against the
  ;; containing block's BLOCK size -- not fill-available, and not
  ;; max-content. The same markup in a 120-tall parent is the 20x70 box
  ;; `:text/writing-mode-vertical-rl` measures; in this 60-tall one Brave
  ;; wraps it onto two lines and reports 40x60, with `alpha` in the right
  ;; column (x=23) and `beta` in the left (x=3).
  :html "<div style=\"width: 300px; height: 60px\"><div style=\"writing-mode: vertical-rl\">alpha beta</div></div>"}

 {:id :writing-mode/vertical-rl-does-not-stretch-to-a-taller-parent
  :group :writing-mode
  ;; Its control, and the half that says fit-content rather than
  ;; fill-available: a 400-tall parent leaves the same box at 20x70.
  :html "<div style=\"width: 300px; height: 400px\"><div style=\"writing-mode: vertical-rl\">alpha beta</div></div>"}

 {:id :writing-mode/vertical-rl-stacks-block-children-right-to-left
  :group :writing-mode
  ;; `width` is a BLOCK size in a vertical mode, and the block axis of
  ;; `-rl` runs leftward: Brave reports an 80x21 box with the first child
  ;; (30 wide) at x=50 and the second (50 wide) at x=0.
  :html "<div style=\"width: 300px; height: 120px\"><div style=\"writing-mode: vertical-rl\"><div style=\"width: 30px\">one</div><div style=\"width: 50px\">two</div></div></div>"}

 {:id :writing-mode/vertical-lr-stacks-block-children-left-to-right
  :group :writing-mode
  ;; The same markup under `-lr`: same 80x21 box, first child at x=0 and
  ;; second at x=30. The block direction is the only difference between
  ;; the two modes that any box in this corpus can see.
  :html "<div style=\"width: 300px; height: 120px\"><div style=\"writing-mode: vertical-lr\"><div style=\"width: 30px\">one</div><div style=\"width: 50px\">two</div></div></div>"}

 {:id :writing-mode/sideways-rl-is-vertical-rl
  :group :writing-mode
  ;; And its control: `sideways-rl` differs from `vertical-rl` only in how
  ;; glyphs of upright scripts are oriented, which no box measures. Every
  ;; number here is `:writing-mode/vertical-rl-stacks-block-children-
  ;; right-to-left`'s -- 80x21, x=50 then x=0.
  :html "<div style=\"width: 300px; height: 120px\"><div style=\"writing-mode: sideways-rl\"><div style=\"width: 30px\">one</div><div style=\"width: 50px\">two</div></div></div>"}

 {:id :writing-mode/sideways-lr-runs-its-inline-axis-upward
  :group :writing-mode
  ;; The one mode that is not a rotation of the other three: its inline
  ;; axis runs UP the page. Brave reports the same 40x40 two-line box
  ;; `vertical-rl` would, but each line is packed against the far edge --
  ;; `alpha`'s 35px of ink at y=5..40 and `beta`'s 28 at y=12..40 -- and
  ;; the columns run left to right (x=2 then x=22).
  :html "<div style=\"width: 300px; height: 40px\"><div style=\"writing-mode: sideways-lr\">alpha beta</div></div>"}

 {:id :writing-mode/logical-sizes-name-the-other-axis
  :group :writing-mode
  ;; The cascade half. `inline-size: 70px; block-size: 20px` is a box 20
  ;; WIDE and 70 TALL under a vertical mode -- the exact pair the logical
  ;; property round measured and then gated itself on rather than resolve
  ;; into an axis this engine could not lay out.
  :html "<div style=\"width: 300px; height: 200px\"><div style=\"writing-mode: vertical-rl; inline-size: 70px; block-size: 20px\">v</div></div>"}

 {:id :writing-mode/block-start-is-the-right-edge
  :group :writing-mode
  ;; `padding-block-start` is the RIGHT side under vertical-rl: Brave
  ;; reports a 32x7 box (20 of line box plus 12 of padding) whose content
  ;; is still at y=0. Its control is on the other axis --
  ;; `padding-inline-start` is the TOP -- which the next case measures.
  :html "<div style=\"width: 300px; height: 200px\"><div style=\"writing-mode: vertical-rl; padding-block-start: 12px\">v</div></div>"}

 {:id :writing-mode/inline-start-is-the-top-edge
  :group :writing-mode
  ;; ...and that control: a 20x19 box with its `v` pushed 12px DOWN.
  :html "<div style=\"width: 300px; height: 200px\"><div style=\"writing-mode: vertical-rl; padding-inline-start: 12px\">v</div></div>"}

 {:id :writing-mode/an-orthogonal-flow-contains-its-margins
  :group :writing-mode
  ;; A box establishing an orthogonal flow establishes a block formatting
  ;; context. Brave: the vertical box is 45 WIDE -- 25 of the child's
  ;; block-start margin plus one 20px line box -- and the child sits at
  ;; x=0. The horizontal control is `:box/margin-collapse-through`, where
  ;; the same margin leaves the box entirely.
  :html "<div style=\"width: 300px; height: 200px\"><div style=\"writing-mode: vertical-rl\"><div style=\"margin-right: 25px\">a</div></div></div>"}

 {:id :writing-mode/an-orthogonal-flow-contains-its-float
  :group :writing-mode
  ;; The other half of the same rule: the float does not escape, the
  ;; vertical box is 40x30, and `after` clears it at y=30.
  :html "<div style=\"width: 300px; height: 200px\"><div style=\"writing-mode: vertical-rl\"><div style=\"float: left; width: 40px; height: 30px\"></div></div><div>after</div></div>"}

 {:id :writing-mode/a-vertical-box-is-an-ordinary-block-in-a-horizontal-parent
  :group :writing-mode
  ;; Its MARGINS are read, unrotated, by the parent that places it -- the
  ;; one property family the rotation must leave alone. Brave puts the
  ;; vertical box at (40, 30), i.e. its physical margin-left and 20 for
  ;; `before` plus its physical margin-top, and `after` at y=95.
  :html "<div style=\"width: 300px; height: 200px\"><div>before</div><div style=\"writing-mode: vertical-rl; margin: 10px 20px 30px 40px\">alpha</div><div>after</div></div>"}

 {:id :writing-mode/a-horizontal-box-inside-a-vertical-one-turns-back
  :group :writing-mode
  ;; The inverse boundary. Brave: a 90x120 vertical box holding a 70x20
  ;; horizontal child at x=20 and a 20x120 vertical sibling at x=0 -- the
  ;; horizontal child consumed 70 of a block axis running right to left.
  :html "<div style=\"width: 300px; height: 150px\"><div style=\"writing-mode: vertical-rl; height: 120px\"><div style=\"writing-mode: horizontal-tb\">alpha beta</div><div>x y</div></div></div>"}

 {:id :writing-mode/a-block-direction-change-is-not-an-orthogonal-flow
  :group :writing-mode
  ;; `vertical-lr` inside `vertical-rl` shares its parent's AXIS, so it is
  ;; not an orthogonal flow: Brave has it FILL the parent's 120px inline
  ;; size (where an orthogonal child shrink-wraps) and stack its own two
  ;; children left-to-right, `p` at x=0 and `q` at x=20, inside a parent
  ;; whose own block axis runs the other way.
  :html "<div style=\"width: 300px; height: 150px\"><div style=\"writing-mode: vertical-rl; height: 120px\"><div style=\"writing-mode: vertical-lr\"><div>p</div><div>q</div></div></div></div>"}

 {:id :writing-mode/a-percentage-size-crossing-an-orthogonal-boundary
  :group :writing-mode
  ;; The two percentage bases swap at the boundary and `width`/`height`
  ;; keep naming the physical axes: in a 300x120 parent, `width: 50%;
  ;; height: 50%` on a vertical-rl box is 150 wide and 60 tall.
  :html "<div style=\"width: 300px; height: 120px\"><div style=\"writing-mode: vertical-rl; width: 50%; height: 50%\">v</div></div>"}

 {:id :writing-mode/a-percentage-padding-is-of-the-containing-blocks-inline-size
  :group :writing-mode
  ;; ...and margins and paddings do NOT swap with them: a percentage
  ;; resolves against the containing block's INLINE size on all four
  ;; sides, which for a vertical containing block is its height. Brave:
  ;; `padding-top: 10%` and `padding-left: 10%` inside a 300x120
  ;; vertical-rl parent are 12px each -- 10% of 120, not of 300.
  :html "<div style=\"width: 300px; height: 120px; writing-mode: vertical-rl\"><div style=\"padding-top: 10%; padding-left: 10%\">v</div></div>"}

 {:id :writing-mode/text-align-packs-a-line-along-the-inline-axis
  :group :writing-mode
  ;; `text-align` is line-relative, so `center` centres DOWN the page:
  ;; Brave puts `alpha`'s 35px of ink at y=32.5 in a 100-tall box.
  :html "<div style=\"width: 300px; height: 120px\"><div style=\"writing-mode: vertical-rl; height: 100px; text-align: center\">alpha</div></div>"}

 {:id :writing-mode/a-float-goes-to-the-inline-start
  :group :writing-mode
  ;; And so is `float: left`, which is line-LEFT rather than physical
  ;; left: Brave puts the float at the TOP of a vertical-rl box (0,0,20,30)
  ;; and starts the text 30px below it, at y=30.
  :html "<div style=\"width: 300px; height: 120px\"><div style=\"writing-mode: vertical-rl; height: 100px\"><div style=\"float: left; width: 20px; height: 30px\"></div>alpha beta</div></div>"}

 {:id :writing-mode/text-orientation-upright-advances-by-the-em
  :group :writing-mode
  ;; `upright` sets each character upright, so what it advances along the
  ;; inline axis is the em and not the glyph's horizontal advance.
  ;; Measured: `alpha` is 70px of inline extent under upright against 35
  ;; under `mixed`, and `alpha beta` is 140 -- which does not fit this
  ;; 120-tall parent, so Brave wraps it and reports a 40x120 box.
  :html "<div style=\"width: 300px; height: 120px\"><div style=\"writing-mode: vertical-rl; text-orientation: upright\">alpha beta</div></div>"}

 {:id :writing-mode/text-orientation-sideways-is-the-default-orientation
  :group :writing-mode
  ;; Its control, and the reason `mixed` and `sideways` need no
  ;; implementation for latin text: both set it sideways, so both give the
  ;; 20x70 box `:text/writing-mode-vertical-rl` already measures.
  :html "<div style=\"width: 300px; height: 120px\"><div style=\"writing-mode: vertical-rl; text-orientation: sideways\">alpha beta</div></div>"}

 {:id :writing-mode/a-relative-offset-is-read-in-the-parents-frame
  :group :writing-mode
  ;; `position: relative`'s `left`/`top` are physical, and a vertical box's
  ;; own offsets are read by the horizontal parent that places it: Brave
  ;; moves it to (7, 11), the numbers as written.
  :html "<div style=\"width: 300px; height: 120px\"><div style=\"writing-mode: vertical-rl; position: relative; left: 7px; top: 11px\">alpha</div></div>"}

 {:id :writing-mode/an-absolute-inset-is-read-in-the-containing-blocks-frame
  :group :writing-mode
  ;; ...and one level in, the same two properties are read in the VERTICAL
  ;; containing block's frame. They are still physical -- Brave lands the
  ;; child at (9, 5) -- which in that box's own canonical frame is
  ;; `left: 5` and `bottom: 9`, i.e. exactly the side permutation the
  ;; margins take. Same pair of properties as the case above, opposite
  ;; frame, and the mode that decides is the containing block's both times.
  :html "<div style=\"width: 300px; height: 120px\"><div style=\"writing-mode: vertical-rl; width: 80px; height: 100px; position: relative\"><div style=\"position: absolute; top: 5px; left: 9px; width: 10px; height: 10px\"></div></div></div>"}

 {:id :writing-mode/aspect-ratio-is-not-rotated
  :group :writing-mode
  ;; KNOWN GAP, recorded rather than chased. `aspect-ratio`'s two terms are
  ;; the PHYSICAL width and height even inside a vertical mode, so
  ;; `inline-size: 60px; aspect-ratio: 2` is 120 wide by 60 tall in Brave.
  ;; This engine applies the ratio to the box's canonical axes instead and
  ;; reports 30x60 -- the ratio inverted. Fixing it is one more entry in
  ;; `rotate-box-style`, but `aspect-ratio` is resolved in three places
  ;; (aspect-ratio-block-width, replaced-content-size, the flex base size)
  ;; and none of them is measured against a vertical mode yet.
  :html "<div style=\"width: 300px; height: 200px\"><div style=\"writing-mode: vertical-rl; inline-size: 60px; aspect-ratio: 2\">v</div></div>"}
 ;; ==================================================================
 ;; Round forty-four: cascade machinery -- which declarations reach a
 ;; box, rather than where the box goes.
 ;;
 ;; The corpus had 48 selector/cascade cases and **not one at-rule**:
 ;; `grep '@' cases.edn` found two email addresses. `@layer`,
 ;; `@supports`, `@media`, `@container` and CSS nesting were an entire
 ;; unmeasured subsystem, and three of those five are implemented in
 ;; `cssom.core` -- implemented and never differentially tested.
 ;;
 ;; Every expected value below was read out of a real headless Brave
 ;; 151.1.93.129 over CDP before the case was written.
 ;;
 ;; A THIRD HAZARD OF THE SHARED PAGE, on top of the two at the top of
 ;; this file: **a layer name, a `@property` name and a `@scope` root are
 ;; DOCUMENT-GLOBAL.** `scope-css` prefixes selectors, and there is
 ;; nothing in `@layer a { ... }` to prefix -- so two cases both naming a
 ;; layer `base` would share one layer and one ordering. Every layer name
 ;; here is prefixed with its case's own initials, every `@property` name
 ;; is unique, and every `@scope` root is an id nothing else uses.

 ;; ---- @layer: layer order, specificity, and the !important reversal ----

 {:id :layer/a-later-layer-wins
  :group :layer
  ;; The baseline both the divergences below are read against: of two
  ;; layers, the one declared LATER wins, whatever the specificity.
  ;; Brave: red.
  :html "<div><p id=\"lw1\">text</p></div>"
  :css "@layer lw-a { #lw1 { color: #0000ff } } @layer lw-b { #lw1 { color: #ff0000 } }"}

 {:id :layer/a-layer-beats-a-more-specific-earlier-layer
  :group :layer
  ;; Layer membership is checked BEFORE specificity: `p#lc1` (1,0,1) in
  ;; the earlier layer loses to a bare `#lc1` (1,0,0) in the later one.
  ;; The `@layer a, b;` statement is what fixes the order here -- the
  ;; blocks appear in the opposite order. Brave: red.
  :html "<div><p id=\"lc1\">text</p></div>"
  :css "@layer lc-a, lc-b; @layer lc-b { #lc1 { color: #ff0000 } } @layer lc-a { p#lc1 { color: #0000ff } }"}

 {:id :layer/the-order-is-the-first-appearance-of-the-block
  :group :layer
  ;; With no ordering statement, a layer's position is where its first
  ;; BLOCK appears. `li-b` is written first, so `li-a` is the later layer
  ;; and wins. Brave: red.
  :html "<div><p id=\"li1\">text</p></div>"
  :css "@layer li-b { #li1 { color: #0000ff } } @layer li-a { #li1 { color: #ff0000 } }"}

 {:id :layer/an-unlayered-declaration-beats-a-layered-one
  :group :layer
  ;; Unlayered author declarations are the LAST layer, so they win over
  ;; every layered one of the same importance regardless of specificity.
  ;; Brave: padding-left 10px, not 30.
  :html "<div><p id=\"lj1\">text</p></div>"
  :css "@layer lj-a { #lj1 { padding-left: 30px } } #lj1 { padding-left: 10px }"}

 {:id :layer/important-reverses-the-layer-order
  :group :layer
  ;; ...and for `!important` declarations real CSS reverses that order, so
  ;; the EARLIER layer wins. Brave: red, from the earlier layer.
  :html "<div><p id=\"lm1\">text</p></div>"
  :css "@layer lm-a { #lm1 { color: #ff0000 !important } } @layer lm-b { #lm1 { color: #0000ff !important } }"}

 {:id :layer/a-layered-important-beats-an-unlayered-important
  :group :layer
  ;; The reversal reaches the unlayered declarations too: for `!important`
  ;; they are the WEAKEST, not the strongest -- the mirror image of
  ;; `an-unlayered-declaration-beats-a-layered-one` above. Brave: red,
  ;; from inside the layer. This engine agrees, which is worth having a
  ;; case for: its own docstring says "any unlayered declaration beats
  ;; every layered one of the same importance", and that sentence is only
  ;; true of the normal half.
  :html "<div><p id=\"lg1\">text</p></div>"
  :css "@layer lg-a { #lg1 { color: #ff0000 !important } } #lg1 { color: #0000ff !important }"}

 {:id :layer/a-layer-inside-media-keeps-its-layer
  :group :layer
  ;; `@layer` nested inside `@media` is fully supported here, and the
  ;; control for the case below it. Brave: red -- `le-b` is the later
  ;; layer and beats the one declared inside the `@media` block.
  :html "<div><p id=\"le1\">text</p></div>"
  :css "@layer le-a, le-b; @media (min-width: 1px) { @layer le-a { #le1 { color: #0000ff } } } @layer le-b { #le1 { color: #ff0000 } }"}

 {:id :layer/media-inside-a-layer-keeps-the-layer
  :group :layer
  ;; The other nesting order, and the engine's own documented cut:
  ;; `parse-rules` says an `@media` nested inside `@layer` "loses the
  ;; outer layer tag on that block". Measured, losing it does not merely
  ;; forget the layer -- it promotes the rule to UNLAYERED, which is the
  ;; strongest normal position there is. Brave: blue (`ld-b` is later);
  ;; this engine: red, because the rule inside `@media` escaped `ld-a`
  ;; altogether.
  :html "<div><p id=\"ld1\">text</p></div>"
  :css "@layer ld-a, ld-b; @layer ld-b { #ld1 { color: #0000ff } } @layer ld-a { @media (min-width: 1px) { #ld1 { color: #ff0000 } } }"}

 {:id :layer/two-anonymous-layers-are-two-layers
  :group :layer
  ;; Each `@layer { ... }` with no name is its OWN anonymous layer, so the
  ;; second beats the first even though the first is more specific.
  ;; Brave: blue. This engine tags both with the same empty-string layer
  ;; name, so they land in one layer and specificity decides: red.
  :html "<div><p id=\"la1\">text</p></div>"
  :css "@layer { p#la1 { color: #ff0000 } } @layer { #la1 { color: #0000ff } }"}

 {:id :layer/a-nested-layer-is-the-layer-its-dotted-name-names
  :group :layer
  ;; `@layer o { @layer i { ... } }` and `@layer o.i { ... }` are the SAME
  ;; layer, so the two declarations below are in one layer and specificity
  ;; decides: Brave reports red, from the more specific `p#lb1`. This
  ;; engine flattens the nested block to its OUTER name (`lb-o`) and reads
  ;; `lb-o.lb-i` as an unrelated third name, so it sees two different
  ;; layers, puts the dotted one later, and reports blue.
  :html "<div><p id=\"lb1\">text</p></div>"
  :css "@layer lb-o { @layer lb-i { p#lb1 { color: #ff0000 } } } @layer lb-o.lb-i { #lb1 { color: #0000ff } }"}

 {:id :layer/revert-layer-rolls-back-to-the-previous-layer
  :group :layer
  ;; `revert-layer` drops the declaration back to the value the PREVIOUS
  ;; layer left, so the 120px in `rg-b` is rolled back to `rg-a`'s 200.
  ;; Brave: 200x20. This engine stores the literal string `revert-layer`
  ;; as the width, which `cssom.layout` cannot read, so the box is `auto`
  ;; and fills its container: 800x20.
  :html "<div><div id=\"rg1\">w</div></div>"
  :css "@layer rg-a { #rg1 { width: 200px } } @layer rg-b { #rg1 { width: 120px; width: revert-layer } }"}

 ;; ---- @supports: a condition this engine does not evaluate at all ----
 ;;
 ;; `@supports` is not in `cssom.core` in any form. `parse-rules` does not
 ;; recognise the at-rule, and its inner rules are picked up by the plain
 ;; selector parser as if the wrapper were not there -- so every
 ;; `@supports` block applies UNCONDITIONALLY. The four controls below
 ;; agree for exactly that reason and are here to make the four
 ;; divergences mean something: "applies when it should" is not evidence
 ;; on an engine that applies everything.

 {:id :supports/a-supported-condition-applies
  :group :supports
  ;; Control. Brave supports `display: grid`, so the block applies: red.
  :html "<div><p id=\"sb1\">text</p></div>"
  :css "@supports (display: grid) { #sb1 { color: #ff0000 } }"}

 {:id :supports/an-unsupported-value-does-not-apply
  :group :supports
  ;; Brave does not support `display: flurb`, so the block does NOT
  ;; apply and the paragraph stays black. This engine applies it: red.
  :html "<div><p id=\"sa1\">text</p></div>"
  :css "@supports (display: flurb) { #sa1 { color: #ff0000 } }"}

 {:id :supports/an-unknown-property-name-does-not-apply
  :group :supports
  ;; The same in the other half of the declaration -- the PROPERTY is the
  ;; unknown one. Brave: black. This engine: red.
  :html "<div><p id=\"sg1\">text</p></div>"
  :css "@supports (flurb: 1px) { #sg1 { color: #ff0000 } }"}

 {:id :supports/not-inverts-a-supported-condition
  :group :supports
  ;; `not (display: grid)` is FALSE in a browser that supports grid, so
  ;; the block does not apply: black. This engine applies it: red. The
  ;; discriminating half of `not` -- the version that wraps an
  ;; UNsupported condition would agree by accident, since both sides then
  ;; apply the block.
  :html "<div><p id=\"sc1\">text</p></div>"
  :css "@supports not (display: grid) { #sc1 { color: #ff0000 } }"}

 {:id :supports/and-with-one-false-arm-does-not-apply
  :group :supports
  ;; Brave: black -- one false arm is enough. This engine: red.
  :html "<div><p id=\"sd1\">text</p></div>"
  :css "@supports (display: grid) and (display: flurb) { #sd1 { color: #ff0000 } }"}

 {:id :supports/or-with-one-true-arm-applies
  :group :supports
  ;; Control, and the pair of the case above: one TRUE arm is enough, so
  ;; both sides apply it. Brave: red.
  :html "<div><p id=\"se1\">text</p></div>"
  :css "@supports (display: flurb) or (display: grid) { #se1 { color: #ff0000 } }"}

 {:id :supports/selector-function-on-a-supported-selector
  :group :supports
  ;; Control. `selector(p:has(b))` is true in Brave 151: red.
  :html "<div><p id=\"sf1\">text</p></div>"
  :css "@supports selector(p:has(b)) { #sf1 { color: #ff0000 } }"}

 {:id :supports/selector-function-on-an-unknown-pseudo-class
  :group :supports
  ;; ...and false for a pseudo-class that does not exist, so Brave leaves
  ;; it black. This engine: red.
  :html "<div><p id=\"sz1\">text</p></div>"
  :css "@supports selector(:frobnicate) { #sz1 { color: #ff0000 } }"}

 ;; ---- @media: evaluated against the oracle's own viewport ----
 ;;
 ;; The harness now reads `window.innerWidth` out of the oracle and hands
 ;; it to `apply-cascade` (see `*oracle-viewport-width*`), because the two
 ;; numbers were not the same: cases are 800px wide, the headless window
 ;; reports **756**, and `cssom.core/default-viewport-width` is 800. Every
 ;; threshold in that band would otherwise have diverged over WHICH
 ;; VIEWPORT rather than over the cascade.

 {:id :media/min-width-below-the-viewport-applies
  :group :media
  ;; Brave: red. 600 < 756.
  :html "<div><p id=\"ma1\">text</p></div>"
  :css "@media (min-width: 600px) { #ma1 { color: #ff0000 } }"}

 {:id :media/min-width-above-the-viewport-does-not-apply
  :group :media
  ;; Brave: black. 5000 > 756.
  :html "<div><p id=\"mb1\">text</p></div>"
  :css "@media (min-width: 5000px) { #mb1 { color: #ff0000 } }"}

 {:id :media/max-width-above-the-viewport-applies
  :group :media
  ;; Brave: red.
  :html "<div><p id=\"mc1\">text</p></div>"
  :css "@media (max-width: 5000px) { #mc1 { color: #ff0000 } }"}

 {:id :media/a-threshold-between-the-case-width-and-the-viewport
  :group :media
  ;; The case that measures the plumbing rather than the cascade: 780 is
  ;; wider than the 756px viewport and narrower than the 800px case, so
  ;; the answer depends entirely on which number `@media` is evaluated
  ;; against. Brave: black. The engine agrees only because the harness
  ;; hands it the oracle's own `innerWidth`; on `default-viewport-width`
  ;; it reported red.
  :html "<div><p id=\"md1\">text</p></div>"
  :css "@media (min-width: 780px) { #md1 { color: #ff0000 } }"}

 {:id :media/and-combines-two-features
  :group :media
  ;; Brave: red -- 756 is inside [400, 900].
  :html "<div><p id=\"me1\">text</p></div>"
  :css "@media (min-width: 400px) and (max-width: 900px) { #me1 { color: #ff0000 } }"}

 {:id :media/the-screen-media-type-applies
  :group :media
  ;; Brave: red.
  :html "<div><p id=\"mf1\">text</p></div>"
  :css "@media screen { #mf1 { color: #ff0000 } }"}

 {:id :media/the-print-media-type-does-not-apply
  :group :media
  ;; Brave: black. The pair of the case above -- one of them alone cannot
  ;; tell "the media type is read" from "everything matches".
  :html "<div><p id=\"ml1\">text</p></div>"
  :css "@media print { #ml1 { color: #ff0000 } }"}

 {:id :media/prefers-color-scheme-matches-the-oracle
  :group :media
  ;; The oracle's own scheme, measured (`matchMedia`) and handed to the
  ;; engine the same way the viewport is. Headless Brave 151 on this
  ;; machine reports **dark**, where `cssom.core/default-color-scheme` is
  ;; "light" -- so this case and the one below it were a matched pair of
  ;; false divergences until the harness stopped assuming. Brave: red.
  :html "<div><p id=\"mi1\">text</p></div>"
  :css "@media (prefers-color-scheme: dark) { #mi1 { color: #ff0000 } }"}

 {:id :media/the-other-color-scheme-does-not-apply
  :group :media
  ;; ...and its mirror: Brave: black.
  :html "<div><p id=\"mh1\">text</p></div>"
  :css "@media (prefers-color-scheme: light) { #mh1 { color: #ff0000 } }"}

 {:id :media/range-syntax-above-the-viewport-does-not-apply
  :group :media
  ;; Media Queries 4 range syntax. Brave: black (5000 > 756). This engine
  ;; does not parse `width >= N` and falls through to its documented
  ;; "unrecognized features match, so nothing is silently hidden"
  ;; default: red. The case is written ABOVE the viewport on purpose --
  ;; below it, both sides apply the block and the case measures nothing.
  :html "<div><p id=\"mm1\">text</p></div>"
  :css "@media (width >= 5000px) { #mm1 { color: #ff0000 } }"}

 {:id :media/min-width-in-em-above-the-viewport-does-not-apply
  :group :media
  ;; 60em against the ROOT font size (16px in Brave, not the case's 14) is
  ;; 960px, wider than the 756px viewport, so Brave leaves it black.
  ;; `media-feature-pattern` accepts only `<digits>` or `<digits>px`, so
  ;; this engine does not recognise the feature and applies it: red.
  :html "<div><p id=\"mn1\">text</p></div>"
  :css "@media (min-width: 60em) { #mn1 { color: #ff0000 } }"}

 {:id :media/not-inverts-a-query
  :group :media
  ;; `not all and (min-width: 5000px)` is TRUE at 756px, so Brave applies
  ;; it: red. This engine has no `not` qualifier -- it splits on `and`,
  ;; evaluates `(min-width: 5000px)` as false and drops the rule: black.
  ;; The inversion is what makes this the discriminating direction; a
  ;; `not` around a matching query would leave both sides agreeing.
  :html "<div><p id=\"mj1\">text</p></div>"
  :css "@media not all and (min-width: 5000px) { #mj1 { color: #ff0000 } }"}

 {:id :media/an-unrecognized-feature-still-applies
  :group :media
  ;; Control for the two above, and the rule they are exceptions to:
  ;; `min-resolution` is a feature neither side evaluates, and both apply
  ;; the block rather than hiding it. Brave: red. The engine's default is
  ;; deliberate and stated in `media-condition-matches?`; what the two
  ;; cases above show is that `not` and range syntax are not features,
  ;; they are GRAMMAR, and defaulting them to "matches" inverts an answer
  ;; rather than widening one.
  :html "<div><p id=\"mo1\">text</p></div>"
  :css "@media (min-resolution: 1dppx) { #mo1 { color: #ff0000 } }"}

 ;; ---- @container: implemented, and never differentially measured ----
 ;;
 ;; `cssom.core` has a whole `@container` implementation with an honestly
 ;; drawn boundary -- a container whose OWN width is already a literal
 ;; number is queryable, anything layout-driven is not -- and the corpus
 ;; contained the string `container-type` zero times. Seven of these eight
 ;; agree with Brave exactly, which is the first evidence that the feature
 ;; works rather than merely exists.

 {:id :container/min-width-matches-the-containers-width
  :group :container
  ;; Brave: red. The container is 400px and declares `container-type`.
  :html "<div style=\"container-type: inline-size; width: 400px\"><p id=\"qa1\" style=\"margin: 0\">text</p></div>"
  :css "@container (min-width: 300px) { #qa1 { color: #ff0000 } }"}

 {:id :container/min-width-above-the-containers-width-does-not-match
  :group :container
  ;; Brave: black. Same container, a threshold it does not reach.
  :html "<div style=\"container-type: inline-size; width: 400px\"><p id=\"qb1\" style=\"margin: 0\">text</p></div>"
  :css "@container (min-width: 900px) { #qb1 { color: #ff0000 } }"}

 {:id :container/max-width-matches
  :group :container
  ;; Brave: red.
  :html "<div style=\"container-type: inline-size; width: 400px\"><p id=\"qc1\" style=\"margin: 0\">text</p></div>"
  :css "@container (max-width: 900px) { #qc1 { color: #ff0000 } }"}

 {:id :container/an-exact-width-query-matches
  :group :container
  ;; `(width: 400px)` is an equality query. Brave: red.
  :html "<div style=\"container-type: inline-size; width: 400px\"><p id=\"qf1\" style=\"margin: 0\">text</p></div>"
  :css "@container (width: 400px) { #qf1 { color: #ff0000 } }"}

 {:id :container/a-named-container-matches-its-own-name
  :group :container
  ;; Brave: red.
  :html "<div style=\"container-type: inline-size; container-name: qside; width: 400px\"><p id=\"qd1\" style=\"margin: 0\">text</p></div>"
  :css "@container qside (min-width: 300px) { #qd1 { color: #ff0000 } }"}

 {:id :container/a-named-query-does-not-match-another-name
  :group :container
  ;; ...and the pair that makes the one above evidence: the SAME container
  ;; and the same condition, queried under a name it does not have. Brave:
  ;; black.
  :html "<div style=\"container-type: inline-size; container-name: qside; width: 400px\"><p id=\"qe1\" style=\"margin: 0\">text</p></div>"
  :css "@container qother (min-width: 300px) { #qe1 { color: #ff0000 } }"}

 {:id :container/no-container-ancestor-never-matches
  :group :container
  ;; A 400px wrapper that does NOT declare `container-type` is not a query
  ;; container, so there is nothing to query and the rule cannot apply.
  ;; Brave: black. This is the case that separates "the condition is
  ;; evaluated" from "the condition is ignored and the block applies".
  :html "<div style=\"width: 400px\"><p id=\"qh1\" style=\"margin: 0\">text</p></div>"
  :css "@container (min-width: 300px) { #qh1 { color: #ff0000 } }"}

 {:id :container/a-percentage-width-container-is-not-queryable
  :group :container
  ;; The engine's documented cut, measured rather than asserted. A
  ;; container sized `50%` has a real width once layout runs -- 400px, and
  ;; Brave applies the rule: red. This engine's cascade finishes BEFORE
  ;; layout and `resolvable-container-width` accepts only an already-literal
  ;; number, so the query honestly does not apply: black. Closing this one
  ;; means a re-cascade after layout, which is a pipeline change and not a
  ;; parser change.
  :html "<div style=\"container-type: inline-size; width: 50%\"><p id=\"qp1\" style=\"margin: 0\">text</p></div>"
  :css "@container (min-width: 300px) { #qp1 { color: #ff0000 } }"}

 {:id :container/container-type-establishes-a-containment-context
  :group :container
  ;; Found by the eight cases above failing on GEOMETRY while agreeing on
  ;; every colour they were written for: `container-type: inline-size`
  ;; applies layout containment, which makes the box an independent
  ;; formatting context, so the paragraph's UA `margin: 1em 0` no longer
  ;; escapes through the wrapper's top edge. Measured in Brave: the
  ;; container is **400x48** with the paragraph at y=14, against **400x20**
  ;; with the paragraph at y=0 for the identical wrapper without
  ;; `container-type`. This engine reports 400x20 for both -- it reads
  ;; `container-type` as a query marker only.
  ;;
  ;; The other eight cases now pin `margin: 0` on their paragraph so they
  ;; measure the QUERY and not this; that is what a case isolating one
  ;; behaviour means, and this is the one they were accidentally carrying.
  :html "<div><div style=\"container-type: inline-size; width: 400px\"><p>contained</p></div></div>"}

 {:id :container/a-plain-wrapper-does-not-contain-its-childs-margin
  :group :container
  ;; The control beside it: the same wrapper with no `container-type`, so
  ;; the paragraph's top margin collapses through and the wrapper is
  ;; 400x20 with the paragraph at y=0. Both sides agree. Without it, the
  ;; case above measures "these two boxes differ" rather than "this
  ;; declaration is what makes them differ".
  :html "<div><div style=\"width: 400px\"><p>not contained</p></div></div>"}

 ;; ---- CSS nesting ----
 ;;
 ;; IMPLEMENTED 2026-08-06 (round forty-nine) by a real desugaring pass
 ;; over the raw text -- `cssom.core/desugar-nesting`, which rewrites a
 ;; nested rule into a flat one BEFORE any at-rule splitter runs, and
 ;; returns its input unchanged on a stylesheet that has no nested rule.
 ;;
 ;; Round forty-four measured these six as divergences and named the trap:
 ;; `parse-rules` split on braces without tracking depth, so a block
 ;; holding BOTH declarations and a nested rule lost the declarations --
 ;; the outer rule was destroyed by the presence of the inner one -- and
 ;; making the splitter depth-aware WITHOUT desugaring would have traded
 ;; one wrong answer for another (the outer declaration would survive and
 ;; the nested rule would stop applying, turning the control below red).
 ;; The first case is still that control, and it still has to stay green.
 ;;
 ;; `&`'s SPECIFICITY is the one part that is not textual substitution --
 ;; it is `:is(<parent selector list>)`'s, the maximum over the list. The
 ;; two cases at the end of this group are the pair that pins it in both
 ;; directions.

 {:id :nesting/an-ampersand-descendant-rule-in-its-own-block
  :group :nesting
  ;; Control. `#na1 { & span { ... } }` with nothing else in the block:
  ;; Brave paints the paragraph blue and the span red. It agreed BEFORE
  ;; nesting was implemented too, for the wrong reason -- the brace
  ;; splitter happened to recover `& span { color: red }` as a rule of its
  ;; own and a stray `&` in a compound selector was ignored rather than
  ;; resolved. It is kept precisely because a desugaring that got `&`
  ;; wrong would turn it red, which is the failure mode a depth-aware
  ;; splitter alone would have caused.
  :html "<div><p id=\"na1\">n <span>d</span></p></div>"
  :css "#na1 { color: #0000ff } #na1 { & span { color: #ff0000 } }"}

 {:id :nesting/a-declaration-beside-a-nested-rule
  :group :nesting
  ;; One block, one declaration, one nested rule. Brave: paragraph blue,
  ;; span red, and so does this engine since 2026-08-06. Before that the
  ;; span was red and the paragraph had NO colour at all -- `color:
  ;; #0000ff` was dropped on the floor because a nested rule shared its
  ;; block. A declaration silently vanishing is a worse failure than a
  ;; nested rule not applying, and it is why this group is six cases
  ;; rather than one.
  :html "<div><p id=\"nc1\">n <span>d</span></p></div>"
  :css "#nc1 { color: #0000ff; span { color: #ff0000 } }"}

 {:id :nesting/a-nested-child-combinator
  :group :nesting
  ;; `& > b` -- Brave: paragraph blue, bold red. Agreed since 2026-08-06.
  :html "<div><p id=\"nb1\">n <b>c</b></p></div>"
  :css "#nb1 { color: #0000ff; & > b { color: #ff0000 } }"}

 {:id :nesting/a-nested-compound-on-the-ampersand
  :group :nesting
  ;; `&.on` is the element itself when it also has the class -- the one
  ;; nesting form with no descendant in it. Brave: red. Before 2026-08-06
  ;; this engine reported no colour at all, so not even the `#0000ff`
  ;; beside it survived.
  :html "<div><p id=\"nd1\" class=\"nd-on\">text</p></div>"
  :css "#nd1 { color: #0000ff; &.nd-on { color: #ff0000 } }"}

 {:id :nesting/a-nested-sibling-combinator
  :group :nesting
  ;; `& + p` reaches the NEXT paragraph, not this one. Brave: the first
  ;; paragraph is blue and the second red. Agreed since 2026-08-06; before
  ;; that neither was coloured.
  :html "<div><p id=\"ne1\">first</p><p>second</p></div>"
  :css "#ne1 { color: #0000ff; & + p { color: #ff0000 } }"}

 {:id :nesting/a-media-block-nested-in-a-style-rule
  :group :nesting
  ;; Nesting is not only selectors: a conditional at-rule can be nested in
  ;; a style rule and its declarations apply to that rule's own subject.
  ;; Brave: red, and so does this engine since 2026-08-06 -- the
  ;; desugaring hoists it to a top-level `@media (...) { #nf1 { ... } }`
  ;; before `split-media-segments` runs, which is why the condition
  ;; survives at all. Note the `@media` here MATCHES, so what this case
  ;; measures is the nesting and not the query.
  :html "<div><p id=\"nf1\">text</p></div>"
  :css "#nf1 { color: #0000ff; @media (min-width: 1px) { color: #ff0000 } }"}

 ;; ---- min() / max() / clamp(), and the calc() that already works ----
 ;;
 ;; `parse-style-value` resolves a whole-value `calc()` over a constant
 ;; px/number subset and nothing else, so every one of these lands in the
 ;; cascade as a raw string `cssom.layout` cannot read -- which for a
 ;; `width` means `auto`, i.e. the whole container. The last two cases in
 ;; the group are the controls that place the boundary: constant `calc()`
 ;; arithmetic agrees exactly, so the gap is the math FUNCTIONS and not
 ;; the value pipeline.

 {:id :math/min-takes-the-smaller-length
  :group :math
  ;; Brave: 50x20. This engine: 800x20.
  :html "<div><div id=\"ca1\">w</div></div>"
  :css "#ca1 { width: min(100px, 50px) }"}

 {:id :math/max-takes-the-larger-length
  :group :math
  ;; Brave: 100x20. This engine: 800x20.
  :html "<div><div id=\"cb1\">w</div></div>"
  :css "#cb1 { width: max(100px, 50px) }"}

 {:id :math/min-of-three-lengths
  :group :math
  ;; `min()` takes any number of arguments, not two. Brave: 50x20.
  :html "<div><div id=\"ch1\">w</div></div>"
  :css "#ch1 { width: min(100px, 50px, 70px) }"}

 {:id :math/clamp-takes-the-middle-value
  :group :math
  ;; Brave: 80x20 -- the preferred 500 is cut to the 80px ceiling.
  :html "<div><div id=\"cc1\">w</div></div>"
  :css "#cc1 { width: clamp(10px, 500px, 80px) }"}

 {:id :math/clamp-below-its-floor-takes-the-floor
  :group :math
  ;; The other end, so the pair cannot both be satisfied by reading one
  ;; argument. Brave: 90x20.
  :html "<div><div id=\"cd1\">w</div></div>"
  :css "#cd1 { width: clamp(90px, 5px, 300px) }"}

 {:id :math/min-inside-calc
  :group :math
  ;; A math function nests inside `calc()`. Brave: 60x20 -- 50 + 10.
  :html "<div><div id=\"ce1\">w</div></div>"
  :css "#ce1 { width: calc(min(100px, 50px) + 10px) }"}

 {:id :math/min-of-a-percentage-and-a-length
  :group :math
  ;; The form `min()` is actually written for: a percentage against a cap.
  ;; 50% of the 800px case is 400, so the 300px cap wins. Brave: 300x20.
  ;; A percentage inside a math function needs the containing block, which
  ;; is the same "resolve at layout, not at cascade" boundary
  ;; `parse-calc` already draws for `calc()`.
  :html "<div><div id=\"cf1\">w</div></div>"
  :css "#cf1 { width: min(50%, 300px) }"}

 {:id :math/max-in-a-margin
  :group :math
  ;; Not a width: `max(10px, 2em)` at the case's 14px font is 28px, and
  ;; Brave puts the box at x=28 with a 772px width. This engine leaves the
  ;; margin unset, so the box is at x=0 and 800 wide. In the corpus for
  ;; the property as much as the function -- a margin is where the
  ;; computed-style axis can see a length at all.
  :html "<div><div id=\"cg1\">w</div></div>"
  :css "#cg1 { margin-left: max(10px, 2em) }"}

 {:id :math/min-in-a-padding-shorthand
  :group :math
  ;; The one case in this group the COMPUTED STYLE axis can score: an
  ;; unresolvable `width` is excluded as a non-absolute length, but an
  ;; absent `padding` is compared against the browser's number. Brave:
  ;; padding 4px on all four sides, so the box is 800x28 with a 792px
  ;; content width. This engine: no padding at all, 800x20.
  :html "<div><div id=\"jb1\">w</div></div>"
  :css "#jb1 { padding: min(4px, 9px) }"}

 {:id :math/constant-calc-multiplication-and-division
  :group :math
  ;; Control, and the boundary marker: `calc(100px * 2 / 4)` is inside
  ;; `parse-calc`'s constant subset and both sides report 50x20. The eight
  ;; cases above are not "this engine cannot do arithmetic".
  :html "<div><div id=\"ci1\">w</div></div>"
  :css "#ci1 { width: calc(100px * 2 / 4) }"}

 {:id :math/a-percentage-calc-is-resolved-against-the-container
  :group :math
  ;; The other side of that boundary, in `calc()` itself: a percentage
  ;; makes the expression layout-dependent and `parse-calc` correctly
  ;; declines it -- but nothing downstream resolves it either, so the
  ;; declared 100px is lost too. Brave: 780x20 (800 - 20). This engine:
  ;; 800x20.
  :html "<div><div id=\"ic1\">w</div></div>"
  :css "#ic1 { width: 100px; width: calc(100% - 20px) }"}

 ;; ---- the CSS-wide keywords, registered properties, and the rest ----

 {:id :cascade/all-initial-resets-every-property
  :group :cascade
  ;; `all` is the shorthand for every property, and `initial` on it takes
  ;; a `<div>` back to `display: inline`, `font-size: 16px` (the initial
  ;; value, NOT the inherited 14) and an auto width -- Brave reports a
  ;; 9.2x16 inline box where the two declarations before it asked for
  ;; 120x30. This engine does not know the `all` shorthand at all and
  ;; reports 120x30, block, 14px.
  :html "<div><div id=\"rd1\">a</div></div>"
  :css "#rd1 { width: 120px; height: 30px; all: initial }"}

 {:id :cascade/all-unset-inherits-what-inherits
  :group :cascade
  ;; `unset` is `inherit` for inherited properties and `initial` for the
  ;; rest, so the paragraph keeps the inherited 14px font and loses its
  ;; `display: block` -- Brave reports an inline box and black text where
  ;; the block declared red. This engine: red, block.
  :html "<div><p id=\"re1\">a</p></div>"
  :css "#re1 { color: #ff0000; all: unset }"}

 {:id :cascade/all-revert-drops-the-whole-author-block
  :group :cascade
  ;; `revert` rolls the AUTHOR origin back, so the 40px margin goes and
  ;; the UA `p { margin: 1em 0 }` stands: Brave reports margin-left 0 and
  ;; the box at x=0. This engine keeps 40. The one case in this group the
  ;; computed-style axis scores as a mismatch rather than excluding, since
  ;; both sides' answers are plain numbers.
  :html "<div><p id=\"rf1\">a</p></div>"
  :css "#rf1 { margin-left: 40px; all: revert }"}

 {:id :cascade/a-registered-custom-property-has-an-initial-value
  :group :cascade
  ;; `@property` with an `initial-value` makes `var(--casc-pw)` resolve
  ;; even where nothing declared it: Brave reports 60x20, and so does this
  ;; engine since 2026-08-06. Before that it had no `@property`, the
  ;; reference was invalid at computed-value time, and the box was auto
  ;; (800x20). The registration is threaded as a selector-less pseudo-rule
  ;; out of `parse-rules` -- see `parse-property-registrations`.
  :html "<div><div id=\"pa1\">w</div></div>"
  :css "@property --casc-pw { syntax: \"<length>\"; inherits: false; initial-value: 60px } #pa1 { width: var(--casc-pw) }"}

 {:id :cascade/an-undefined-custom-property-is-invalid
  :group :cascade
  ;; The control the case above is read against: with no `@property`
  ;; registration the same reference IS invalid, and both sides report an
  ;; auto 800x20 box. Without it, "the engine reports 800" says nothing
  ;; about whether it read the registration or simply failed twice.
  :html "<div><div id=\"pd1\">w</div></div>"
  :css "#pd1 { width: var(--casc-undefined) }"}

 {:id :cascade/a-var-fallback-chain-nests
  :group :cascade
  ;; Control. A fallback whose own value is another `var()` with its own
  ;; fallback: both sides report 90x20.
  :html "<div><div id=\"pb1\">w</div></div>"
  :css "#pb1 { width: var(--casc-n1, var(--casc-n2, 90px)) }"}

 {:id :cascade/a-custom-property-redeclared-at-depth-shadows-the-ancestor
  :group :cascade
  ;; Control. The inner element declares the same custom property the
  ;; wrapper did; the reference on the inner element resolves against its
  ;; OWN value, not the inherited one. Both sides: 40x20.
  :html "<div id=\"id1\" style=\"--casc-shadow: 10px\"><div class=\"casc-inner\" style=\"--casc-shadow: 40px\">w</div></div>"
  :css "#id1 .casc-inner { width: var(--casc-shadow) }"}

 {:id :cascade/env-resolves-a-known-variable-rather-than-its-fallback
  :group :cascade
  ;; `env(safe-area-inset-left, 120px)` is DEFINED in Brave and its value
  ;; is 0, so the fallback is not used and the box is 0x20. Agreed since
  ;; 2026-08-06; before that this engine kept the raw string and reported
  ;; 800x20. The fallback is deliberately a value neither 0 nor 800, so
  ;; "used the fallback", "resolved the variable" and "read neither" are
  ;; three different answers -- and all four `safe-area-inset-*` were
  ;; measured, all four are 0 in this headless build.
  :html "<div><div id=\"pe1\">w</div></div>"
  :css "#pe1 { width: env(safe-area-inset-left, 120px) }"}

 {:id :cascade/attr-in-a-length
  :group :cascade
  ;; CSS Values 5 `attr()` outside `content`: Brave 151 resolves
  ;; `attr(data-w px, 30px)` to 55px from the attribute, and so does this
  ;; engine since 2026-08-06. Before that only `content` had `attr()`
  ;; support, the width stayed a raw string and the box was 800x20.
  ;; Three-way again: 55 from the attribute, 30 from the fallback, 800
  ;; from neither. The TYPED form only -- the legacy string form is
  ;; invalid in a `width` in Brave too, which is the case just below.
  :html "<div><div id=\"ie1\" data-w=\"55\">w</div></div>"
  :css "#ie1 { width: attr(data-w px, 30px) }"}

 {:id :cascade/a-scope-rule-does-not-reach-outside-its-root
  :group :cascade
  ;; The case round forty-four opened and round forty-nine measured in
  ;; full. `@scope (#casc-sc) { ... }` limits its rules to that subtree:
  ;; Brave reddens the paragraph inside and leaves the one outside black.
  ;; Both are here on purpose -- the inner one agrees, and an agreement
  ;; beside the disagreement is what says the rule was found rather than
  ;; lost.
  ;;
  ;; THIS CASE WAS MEASURING SOMETHING ELSE UNTIL 2026-08-06. `scope-css`
  ;; prefixed the body with the case container's id, and a scoped selector
  ;; carries an implicit `:scope ` DESCENDANT prefix, so the rule reaching
  ;; the browser was `:scope #case-N .casc-sp` -- and `#case-N` is an
  ;; ANCESTOR of `#casc-sc`, never a descendant of it. Measured: Brave read
  ;; BOTH paragraphs as black, so the case's two mismatches were "the
  ;; engine reddens two paragraphs the browser reddens neither of",
  ;; which is a true divergence for a false reason. `scope-css` now leaves a
  ;; rooted `@scope` body unprefixed and the case measures what it says.
  ;;
  ;; The full `@scope` measurement round forty-nine recorded here has moved
  ;; into the `:scope` group below, where each row is its own case with its
  ;; own control.
  :html "<div><div id=\"casc-sc\"><p class=\"casc-sp\">in</p></div><p class=\"casc-sp\">out</p></div>"
  :css "@scope (#casc-sc) { .casc-sp { color: #ff0000 } }"}

 ;; ---- two selector shapes the earlier rounds named as unscorable ----

 {:id :selector/first-letter-changes-the-line-box
  :group :selector
  ;; Round thirty-two left `::first-letter` out because "neither produces
  ;; an element box, so neither the geometry axis nor the oracle's element
  ;; probe can see one". True of the pseudo-element -- and not of its
  ;; effect: a 40px first letter grows the paragraph's OWN box, which the
  ;; geometry axis reads directly. Brave: 800x29 against a plain 800x20,
  ;; which is 9px and well outside the 2px tolerance. This engine has no
  ;; `::first-letter`: 800x20.
  :html "<div><p id=\"fa1\">Alpha beta gamma delta</p></div>"
  :css "#fa1::first-letter { font-size: 40px }"}

 {:id :selector/the-universal-selector-adds-no-specificity
  :group :selector
  ;; Control. `#ua1 *` is (1,0,0) and `#ua1 p` is (1,0,1), so the type
  ;; selector wins even though the universal rule is written first and
  ;; matches the same element. Brave: blue.
  :html "<div id=\"ua1\"><p>text</p></div>"
  :css "#ua1 * { color: #ff0000 } #ua1 p { color: #0000ff }"}

 ;; ==================================================================
 ;; Round forty-nine: CSS nesting, and three value functions.
 ;;
 ;; Every expected value below was read out of headless Brave
 ;; 151.1.93.129 over CDP before the case was written, ONE PROBE PAGE PER
 ;; PROBE. That last part is a finding of its own: the first version of
 ;; this measurement put sixteen probes on one page, and a single bare
 ;; `p span { color: blue }` written for one probe reached the spans of
 ;; three others and made a layered rule look like it had lost. It is the
 ;; same hazard the top of this file names for the corpus page, and it
 ;; bites a probe harness harder because a probe has no id prefixing.

 ;; ---- nesting: the specificity pair ----
 ;;
 ;; `&` is NOT textual substitution. Its specificity is
 ;; `:is(<parent selector list>)`'s -- the MAXIMUM over the list -- so a
 ;; parent arm that matches nothing still raises the nested rule. These
 ;; two cases are one rule read from both sides, and neither means
 ;; anything without the other.

 {:id :nesting/an-ampersand-carries-the-parent-lists-maximum-specificity
  :group :nesting
  ;; `#nz1` matches nothing on the page. `.nz-c span` alone would be
  ;; (0,1,1) and lose to `div.nz-c span`'s (0,1,2) -- but `&` is
  ;; `:is(#nz1, .nz-c)`, which is (1,0,0). Brave: RED.
  ;;
  ;; HONESTLY: this case and the one below AGREED BEFORE nesting was
  ;; implemented too, and they were measured to. The old brace splitter
  ;; recovered `& span { color: red }` as a rule of its own and ignored
  ;; the stray `&`, which lands on the same two colours by coincidence.
  ;; They are here as REGRESSION GUARDS on the desugaring rather than as
  ;; divergences: plain textual expansion of a multi-arm parent turns THIS
  ;; one blue, and an `:is()` wrapped around a one-arm parent would be
  ;; harmless -- so the pair pins `expand-nested-selector`'s choice from
  ;; both sides. Round forty-nine's residual arithmetic names them: the
  ;; other four new nesting cases account for all 8 of the cascade values
  ;; that changed, and these two for none.
  ;;
  ;; 2026-08-06: THIS CASE IS NOW RED, and the change is in the harness
  ;; rather than in either engine. `cascaded-document` used to hand this
  ;; side the RAW css while the browser page got it scoped by the case's
  ;; own container id, so the two sides were reading two different
  ;; selectors -- and the parent list this side saw (`#nz1, .nz-c`) was two
  ;; COMPOUND selectors where the browser's (`#case-N #nz1, #case-N .nz-c`)
  ;; was two COMPLEX ones. Scoping this side too (see `cascaded-document`)
  ;; makes them the same question and lands the case squarely on
  ;; `expand-nested-selector`'s third branch, which round forty-nine
  ;; measured and named: with a COMPLEX parent it expands one rule per
  ;; parent, so each carries its own specificity instead of the list's
  ;; maximum, and this comes out blue where Brave says red. Closing it is
  ;; the change that round already identified -- letting this engine's
  ;; `:is()` hold a complex selector, in `parse-simple-selector`/
  ;; `matches-simple?` -- and it is not a nesting change.
  :html "<div class=\"nz-c\"><span>s</span></div>"
  :css "#nz1, .nz-c { & span { color: #ff0000 } } div.nz-c span { color: #0000ff }"}

 {:id :nesting/one-parent-does-not-raise-a-nested-rules-specificity
  :group :nesting
  ;; The control that places the same rule from the other side, and the
  ;; one an over-eager desugaring would break: with ONE parent, and a
  ;; class one, `:is(.ny-c) span` is (0,1,1) and `div.ny-c span` is
  ;; (0,1,2). Brave: BLUE.
  :html "<div class=\"ny-c\"><span>s</span></div>"
  :css ".ny-c { & span { color: #ff0000 } } div.ny-c span { color: #0000ff }"}

 {:id :nesting/a-declaration-after-a-nested-rule-still-applies
  :group :nesting
  ;; The other half of "a block holding both loses the declarations":
  ;; declarations on BOTH sides of a nested rule, competing with each
  ;; other. Brave: GREEN -- the parent's own declarations cascade among
  ;; themselves in source order, and the nested rule between them is not
  ;; a boundary.
  :html "<div><p id=\"nx1\">n <span>d</span></p></div>"
  :css "#nx1 { color: #0000ff; span { color: #ff0000 } color: #008000 }"}

 {:id :nesting/a-nested-rule-inside-media-keeps-the-condition
  :group :nesting
  ;; The other nesting order from `:nesting/a-media-block-nested-in-a-style-rule`:
  ;; a nested rule INSIDE a `@media` block. Brave: paragraph blue, span
  ;; red. The query matches, so what this measures is that the
  ;; desugaring's output is still inside the at-rule.
  :html "<div><p id=\"nw1\">n <span>d</span></p></div>"
  :css "@media (min-width: 1px) { #nw1 { color: #0000ff; span { color: #ff0000 } } }"}

 {:id :nesting/a-nested-rule-keeps-the-layer-it-was-written-in
  :group :nesting
  ;; A nested rule is an ordinary member of its enclosing layer, not a
  ;; promotion out of it. The nested rule is in the EARLIER layer, so the
  ;; plain rule in the later one wins. Brave: GREEN.
  ;;
  ;; This is the case that guards against the failure mode the `@media`-
  ;; inside-`@layer` cut already has, measured in round forty-four:
  ;; losing a layer tag does not merely forget the layer, it promotes the
  ;; rule to UNLAYERED, which is the strongest normal position there is.
  :html "<div><p id=\"nv1\">n <span>d</span></p></div>"
  :css "@layer nv-a { #nv1 { span { color: #ff0000 } } } @layer nv-b { #nv1 span { color: #008000 } }"}

 {:id :nesting/a-relative-selector-gets-an-implicit-ampersand
  :group :nesting
  ;; Two shapes in one: `> b` with no `&` at all is the RELATIVE form and
  ;; means `& > b`, and a nested rule two levels deep resolves against the
  ;; selector its own parent resolved to. Brave: paragraph blue, bold red,
  ;; italic green.
  :html "<div><p id=\"nu1\">n <b>c <i>d</i></b></p></div>"
  :css "#nu1 { color: #0000ff; > b { color: #ff0000; i { color: #008000 } } }"}

 ;; ---- @property, env(), attr(): the shapes the round-forty-four cases
 ;; ---- could not distinguish

 {:id :cascade/an-invalid-value-for-a-registered-property-becomes-its-initial
  :group :cascade
  ;; The measurement that says a registered property follows a DIFFERENT
  ;; rule from an unregistered one. The wrapper declares 200px, the
  ;; element declares an unparseable value; Brave reports **70x20** -- the
  ;; registered initial. Not the inherited 200 (which is what an
  ;; unregistered custom property's invalid-at-computed-value-time
  ;; behaviour would give) and not auto.
  :html "<div id=\"pv-w\" style=\"--casc-pv: 200px\"><div id=\"pv1\">w</div></div>"
  :css "@property --casc-pv { syntax: \"<length>\"; inherits: false; initial-value: 70px } #pv1 { --casc-pv: notalength; width: var(--casc-pv) }"}

 {:id :cascade/a-registered-property-with-inherits-false-does-not-inherit
  :group :cascade
  ;; `inherits: false` is the default and it is observable: the wrapper
  ;; declares 200px and the child reads the INITIAL, 80px. Brave: 80x20.
  :html "<div id=\"pi-w\" style=\"--casc-pi: 200px\"><div id=\"pi1\">w</div></div>"
  :css "@property --casc-pi { syntax: \"<length>\"; inherits: false; initial-value: 80px } #pi1 { width: var(--casc-pi) }"}

 {:id :cascade/a-registered-property-with-inherits-true-does-inherit
  :group :cascade
  ;; The control beside it -- one descriptor different, and the child now
  ;; reads the wrapper's own 200px rather than the 80px initial. Brave:
  ;; 200x20. Without this pair, "80" would only say the engine read an
  ;; initial value from somewhere.
  :html "<div id=\"pt-w\" style=\"--casc-pt: 200px\"><div id=\"pt1\">w</div></div>"
  :css "@property --casc-pt { syntax: \"<length>\"; inherits: true; initial-value: 80px } #pt1 { width: var(--casc-pt) }"}

 {:id :cascade/a-registration-with-a-relative-initial-value-is-invalid
  :group :cascade
  ;; An `initial-value` has to be computationally independent, and Brave
  ;; rejects the WHOLE at-rule when it is not: 800x20 (auto), and
  ;; `getComputedStyle` reports the empty string for the property, exactly
  ;; as if it had never been registered. A convenient boundary -- it is
  ;; the same set of values this engine can carry anyway.
  ;;
  ;; CONTROL, and it agrees on an engine with no `@property` at all (which
  ;; also reports 800): it is only evidence read BESIDE
  ;; `:cascade/a-registered-custom-property-has-an-initial-value`, which
  ;; is the same shape with an absolute initial and goes 800 -> 60. The
  ;; pair says "the registration was read AND its initial value was
  ;; checked"; either alone says neither.
  :html "<div><div id=\"pq1\">w</div></div>"
  :css "@property --casc-pq { syntax: \"<length>\"; inherits: false; initial-value: 2em } #pq1 { width: var(--casc-pq) }"}

 {:id :cascade/env-with-an-unknown-name-uses-its-fallback
  :group :cascade
  ;; The half `:cascade/env-resolves-a-known-variable-rather-than-its-fallback`
  ;; cannot show: an env() name nothing defines DOES fall back. Brave:
  ;; 130x20. Read against that one, the two together say the engine has a
  ;; table rather than a single answer.
  :html "<div><div id=\"eu1\">w</div></div>"
  :css "#eu1 { width: env(kotoba-not-a-thing, 130px) }"}

 {:id :cascade/env-with-no-fallback-invalidates-the-whole-declaration
  :group :cascade
  ;; And with no fallback it is invalid at computed-value time. Brave:
  ;; 800x20 -- note what that rules out, since the SAME BLOCK declares
  ;; `width: 140px` first: the declaration does not fall back to the
  ;; earlier one, it becomes `unset`, and `width: unset` is `auto`.
  ;;
  ;; CONTROL: an engine that does not resolve `env()` at all also reports
  ;; 800 here (it keeps the raw string, which reads as auto). It is
  ;; evidence only beside the case above, which goes 800 -> 130.
  :html "<div><div id=\"en1\">w</div></div>"
  :css "#en1 { width: 140px; width: env(kotoba-not-a-thing) }"}

 {:id :cascade/attr-falls-back-when-the-attribute-is-unusable
  :group :cascade
  ;; `attr(data-w px, 30px)` against `data-w="abc"`, which is present and
  ;; not a number. Brave: 30x20, the fallback -- the same answer an absent
  ;; attribute gives, and a different one from the 55 the usable
  ;; attribute gives in `:cascade/attr-in-a-length`.
  :html "<div><div id=\"ia1\" data-w=\"abc\">w</div></div>"
  :css "#ia1 { width: attr(data-w px, 30px) }"}

 {:id :cascade/the-legacy-string-attr-is-not-valid-in-a-length
  :group :cascade
  ;; The control that separates CSS Values 5's TYPED `attr()` from the
  ;; legacy string one. `data-w` holds `75px`, a perfectly good length,
  ;; and Brave still reports 800x20: the legacy form is invalid outside
  ;; `content`, and the earlier `width: 150px` in the same block does not
  ;; survive it either. Only one of the two forms is widely supported per
  ;; property and they are not interchangeable.
  ;;
  ;; Like the two controls above it agrees on an engine with no `attr()`
  ;; outside `content` -- it is what stops the TYPED cases from being read
  ;; as "this engine resolves any attr()", and it is the assertion that
  ;; would fail if `resolve-attr-values` were widened to the legacy
  ;; form.
  :html "<div><div id=\"il1\" data-w=\"75px\">w</div></div>"
  :css "#il1 { width: 150px; width: attr(data-w) }"}

 {:id :cascade/attr-resolves-inside-calc
  :group :cascade
  ;; `calc(attr(data-w px, 30px) + 10px)` with `data-w="55"`. Brave: 65x20
  ;; -- the reference is a term in the arithmetic, not text wrapped around
  ;; it, which is what says the substitution happens before the value is
  ;; parsed rather than after.
  :html "<div><div id=\"ic1\" data-w=\"55\">w</div></div>"
  :css "#ic1 { width: calc(attr(data-w px, 30px) + 10px) }"}
 ;; ---- round forty-seven: the at-rules, actually evaluated ----
 ;;
 ;; Every expected value below was read out of a real headless Brave
 ;; 151.1.93.129 over CDP on 2026-08-06, before the case was written.
 ;; These nine are what the eleven divergences round forty-four MEASURED
 ;; did not pin down: the rules behind them, and the boundaries either
 ;; side of each rule.

 {:id :supports/a-general-enclosed-condition-is-false-and-not-inverts-it
  :group :supports
  ;; `(grid)` is a `<general-enclosed>` -- well-formed, unrecognised --
  ;; which is FALSE, so `not (grid)` is TRUE and the block applies.
  ;; Brave: red. The discriminating half of the pair below.
  :html "<div><p id=\"ge1\">text</p></div>"
  :css "@supports not (grid) { #ge1 { color: #ff0000 } }"}

 {:id :supports/an-unparseable-condition-is-not-a-false-one
  :group :supports
  ;; ...and its pair. A bare `garbage` does not parse as a
  ;; `<supports-condition>` at all, so the whole at-rule is invalid and
  ;; dropped -- which a `not` cannot rescue. Brave: black, and reading
  ;; `document.styleSheets` back confirms the rule is simply absent, where
  ;; the `not (grid)` rule above is present and true. One condition is
  ;; false, the other never existed; only these two side by side show that
  ;; those are different answers.
  :html "<div><p id=\"ue1\">text</p></div>"
  :css "@supports not garbage { #ue1 { color: #ff0000 } }"}

 {:id :supports/an-unsupported-value-on-a-length-property
  :group :supports
  ;; The value half of the oracle, on a property whose values are lengths
  ;; rather than keywords: a unitless non-zero number is not a length.
  ;; Brave: black. `(width: 10px)` is red, which is the control the
  ;; `:supports/a-supported-condition-applies` group already carries in
  ;; keyword form.
  :html "<div><p id=\"uv1\">text</p></div>"
  :css "@supports (width: 10) { #uv1 { color: #ff0000 } }"}

 {:id :layer/a-layers-own-rules-beat-its-sublayer
  :group :layer
  ;; Layers are a TREE and the order is a post-order traversal of it: a
  ;; layer's sublayers come first, then the layer's own un-sublayered
  ;; declarations. Brave: red, from the OUTER layer, even though the
  ;; sublayer block is written later. This is the rule behind
  ;; `a-nested-layer-is-the-layer-its-dotted-name-names` above, measured
  ;; on its own.
  :html "<div><p id=\"po1\">text</p></div>"
  :css "@layer po-o { #po1 { color: #ff0000 } @layer po-i { #po1 { color: #0000ff } } }"}

 {:id :layer/an-anonymous-layer-takes-its-place-in-the-order
  :group :layer
  ;; The control beside `two-anonymous-layers-are-two-layers`: an
  ;; anonymous layer is not only distinct, it sits where it is written.
  ;; Written after a named layer, it wins. Brave: blue.
  :html "<div><p id=\"ao1\">text</p></div>"
  :css "@layer ao-a { #ao1 { color: #ff0000 } } @layer { #ao1 { color: #0000ff } }"}

 {:id :layer/an-unlayered-revert-layer-rolls-back-into-the-layers
  :group :layer
  ;; `revert-layer` rolls back to the value the property would have had if
  ;; no declaration in the CURRENT layer existed -- and the unlayered
  ;; declarations are a layer for that purpose, so an unlayered
  ;; `revert-layer` reaches the layered value below it rather than past the
  ;; whole author origin. Brave: 200x20. The version with no `@layer`
  ;; anywhere is 800x20 on both sides and is deliberately not a case (it
  ;; would pass for the wrong reason -- see round forty-four).
  :html "<div><div id=\"rl1\">w</div></div>"
  :css "@layer rl-a { #rl1 { width: 200px } } #rl1 { width: 120px; width: revert-layer }"}

 {:id :media/an-unknown-media-type-does-not-apply
  :group :media
  ;; The boundary of the fail-open default. An unknown FEATURE matches
  ;; (`:media/an-unrecognized-feature-still-applies`); an unknown media
  ;; TYPE does not, because a media type is a closed vocabulary. Brave:
  ;; black. `@media screen` beside it is the control the group already has.
  :html "<div><p id=\"ut1\">text</p></div>"
  :css "@media flurb { #ut1 { color: #ff0000 } }"}

 {:id :media/a-length-with-no-unit-is-invalid
  :group :media
  ;; 100 is not 100px: a unitless non-zero length makes the query invalid,
  ;; which is `not all`. Brave: black, at a 756px viewport where
  ;; `(min-width: 100px)` is red -- so this measures the unit and not the
  ;; comparison.
  :html "<div><p id=\"nu1\">text</p></div>"
  :css "@media (min-width: 100) { #nu1 { color: #ff0000 } }"}

 {:id :media/two-ended-range-syntax-around-the-viewport
  :group :media
  ;; The matching direction of `range-syntax-above-the-viewport-does-not-
  ;; apply`, and the two-ended form: 756 is inside [400, 900]. Brave: red.
  ;; A range that only ever failed would not tell "evaluated" from
  ;; "dropped".
  :html "<div><p id=\"tr1\">text</p></div>"
  :css "@media (400px <= width <= 900px) { #tr1 { color: #ff0000 } }"}

 ;; ---- form-state pseudo-classes ------------------------------------
 ;;
 ;; `matches-pseudo?` implements THIRTEEN of these -- :checked, :disabled,
 ;; :enabled, :required, :optional, :read-only, :read-write, :valid,
 ;; :invalid, :in-range, :out-of-range, plus :focus/:focus-within -- and
 ;; before this round the corpus contained NOT ONE case for any of them.
 ;; Implemented and never differentially tested is exactly the state
 ;; `@layer` was in before round forty-four.
 ;;
 ;; None of these needs an interaction: every state below is decided by an
 ;; attribute or by the document, so both sides can answer it from the same
 ;; markup. `:focus`/`:focus-within`/`:hover`/`:active` are the ones that
 ;; cannot be, and there is no case for them.
 ;;
 ;; Everything here was measured one probe page per probe in a real
 ;; headless Brave 151.1.93.129 over CDP on 2026-08-06, in this corpus's own
 ;; frame, BEFORE the case was written.

 {:id :form/checked-matches-a-checked-checkbox
  :group :form
  ;; Brave: margin-left 30px on the checked box, 4px on the other -- 4px is
  ;; this browser's UA `input[type=checkbox] { margin: 3px 3px 3px 4px }`,
  ;; so the pair separates "the rule matched" from "the rule matched
  ;; everything".
  :html "<p><input type=\"checkbox\" checked><input type=\"checkbox\"></p>"
  :css "input:checked { margin-left: 30px }"}

 {:id :form/checked-matches-a-checked-radio
  :group :form
  ;; The same rule on the other control, and the UA number is NOT the same:
  ;; Brave gives a radio `margin-left: 5px` where a checkbox gets 4. Brave:
  ;; 5px then 30px.
  :html "<p><input type=\"radio\" name=\"ck2\"><input type=\"radio\" name=\"ck2\" checked></p>"
  :css "input:checked { margin-left: 30px }"}

 {:id :form/checked-matches-a-selected-option
  :group :form
  ;; `:checked` is not one attribute. On an `<option>` the state is
  ;; `selected`, and this engine tests `:checked` for every control alike.
  ;; Brave: the first option black, the second red.
  :html "<p><select><option>a</option><option selected>b</option></select></p>"
  :css "option:checked { color: #ff0000 }"}

 {:id :form/a-checked-attribute-on-an-option-is-not-selectedness
  :group :form
  ;; Its inverse, and the pair is the measurement: an `<option checked>` is
  ;; NOT `:checked` and an `<option selected>` is. Brave: black then red --
  ;; the same answer as the case above, from the opposite markup. An engine
  ;; reading the `checked` attribute for every control gives red then black.
  :html "<p><select><option checked>a</option><option selected>b</option></select></p>"
  :css "option:checked { color: #ff0000 }"}

 {:id :form/disabled-and-enabled-are-complementary
  :group :form
  ;; Brave: red then blue. Both halves in one case on purpose -- an engine
  ;; that matched neither, or both, would show here and not in either half
  ;; alone.
  :html "<p><button disabled>a</button><button>b</button></p>"
  :css "button:disabled { color: #ff0000 } button:enabled { color: #0000ff }"}

 {:id :form/disabled-descends-from-a-fieldset
  :group :form
  ;; `:disabled` is not the attribute either: a disabled `<fieldset>`
  ;; disables its descendants. Brave: input red, button blue -- both
  ;; matched `:disabled` without carrying the attribute themselves.
  :html "<fieldset disabled><input><button>b</button></fieldset>"
  :css "input:disabled { color: #ff0000 } button:disabled { color: #0000ff }"}

 {:id :form/the-first-legend-of-a-disabled-fieldset-escapes
  :group :form
  ;; The boundary of the rule above, and it is a real one: the controls in
  ;; a disabled fieldset's FIRST `<legend>` stay enabled. Brave: the legend's
  ;; input blue (enabled), the other red (disabled).
  :html "<fieldset disabled><legend><input></legend><input></fieldset>"
  :css "input:disabled { color: #ff0000 } input:enabled { color: #0000ff }"}

 {:id :form/enabled-does-not-match-a-non-control
  :group :form
  ;; The control for the whole `:enabled` family: a bare `:enabled` is not
  ;; "everything that is not disabled". Brave: the span black, the input red.
  :html "<p><span id=\"en1\">x</span><input></p>"
  :css ":enabled { color: #ff0000 }"}

 {:id :form/enabled-and-disabled-on-an-option
  :group :form
  ;; An `<option>` takes part in the pair too. Brave: red then blue.
  :html "<p><select><option>a</option><option disabled>b</option></select></p>"
  :css "option:enabled { color: #ff0000 } option:disabled { color: #0000ff }"}

 {:id :form/required-and-optional-are-complementary
  :group :form
  ;; Brave: red then blue.
  :html "<p><input required><input></p>"
  :css "input:required { color: #ff0000 } input:optional { color: #0000ff }"}

 {:id :form/required-still-matches-a-disabled-control
  :group :form
  ;; Measured, and it is the one that separates `:required` from validity:
  ;; disabling a control takes it OUT of constraint validation but does not
  ;; stop it being required. Brave: BOTH red -- the disabled one matches
  ;; `:required`, and `:optional` (written later, same specificity) does not
  ;; rescue it. An engine that excludes disabled controls from `:required`
  ;; leaves the first one with no colour at all -- which is what this one
  ;; does, so the case is RED. `:valid`/`:invalid`/`:in-range`/
  ;; `:out-of-range` DO keep their disabled test and Brave agrees they
  ;; should, which is what makes this a rule about `:required` rather than
  ;; about disabledness; `:form/in-range-does-not-match-a-disabled-control`
  ;; is the control that says so, and it agrees. Closed on 2026-08-06:
  ;; `:required`/`:optional` now decide on the attribute and on whether it
  ;; APPLIES (`required-capable-control?`, measured across twenty-two input
  ;; types), and on nothing else.
  :html "<p><input required disabled><input required></p>"
  :css "input:required { color: #ff0000 } input:optional { color: #0000ff }"}

 {:id :form/read-only-matches-a-non-editable-element
  :group :form
  ;; `:read-only` is not a form-control pseudo-class: it matches every
  ;; element that is not user-alterable, a plain `<p>` included. Brave: red.
  :html "<p id=\"ro1\">text</p>"
  :css "p:read-only { color: #ff0000 }"}

 {:id :form/read-only-matches-a-disabled-input
  :group :form
  ;; ...and a DISABLED text field is one of them, which is not what "read
  ;; only" reads like. Brave: margin-left 30px on the disabled input and
  ;; margin-right 30px on the enabled one -- so the disabled control is
  ;; `:read-only` and not `:read-write`, and an engine that asks only about
  ;; the `readonly` attribute gives it neither. Closed on 2026-08-06 by
  ;; `user-alterable?` -- ONE predicate of which `:read-write` is the whole
  ;; and `:read-only` is the complement. It was measured and written by
  ;; round fifty-one and REVERTED there, because kotoba-lang/browser's
  ;; query-selector suite asserted the old answers; both halves landed
  ;; together, and that repo's assertions carry the measurement that says
  ;; what each encoded.
  :html "<p><input disabled><input></p>"
  :css "input:read-only { margin-left: 30px } input:read-write { margin-right: 30px }"}

 {:id :form/read-write-matches-a-contenteditable
  :group :form
  ;; The other side of the same rule: `:read-write` reaches a
  ;; `contenteditable` element, which is not a form control at all. Brave:
  ;; the editable paragraph red, the plain one black. This engine's
  ;; `:read-write` used to require a form control and so matched neither;
  ;; `user-alterable?`'s second clause is the nearest-`contenteditable`
  ;; walk that closes it (and stops at a `contenteditable="false"`, which
  ;; is measured separately).
  :html "<p contenteditable=\"true\">edit</p><p>plain</p>"
  :css "p:read-write { color: #ff0000 }"}

 {:id :form/valid-and-invalid-on-a-required-field
  :group :form
  ;; Brave: the empty required field red, the filled one blue.
  :html "<p><input required><input required value=\"v\"></p>"
  :css "input:invalid { color: #ff0000 } input:valid { color: #0000ff }"}

 {:id :form/invalid-on-a-pattern-mismatch
  :group :form
  ;; Constraint validation is more than `required`. Brave: red then blue.
  :html "<p><input pattern=\"[0-9]+\" value=\"abc\"><input pattern=\"[0-9]+\" value=\"123\"></p>"
  :css "input:invalid { color: #ff0000 } input:valid { color: #0000ff }"}

 {:id :form/valid-matches-a-form-element
  :group :form
  ;; `:valid`/`:invalid` apply to a `<form>` as well as to its controls --
  ;; a form is valid when every control in it is. Brave: red.
  :html "<form><input required value=\"v\"></form>"
  :css "form:valid { color: #ff0000 }"}

 {:id :form/in-range-and-out-of-range
  :group :form
  ;; Brave: the 15 red, the 5 blue, against `min=1 max=10`.
  :html "<p><input type=\"number\" min=\"1\" max=\"10\" value=\"15\"><input type=\"number\" min=\"1\" max=\"10\" value=\"5\"></p>"
  :css "input:out-of-range { color: #ff0000 } input:in-range { color: #0000ff }"}

 {:id :form/an-unbounded-number-is-in-neither-range
  :group :form
  ;; The control that makes the pair above mean something: a control with
  ;; no range limitations at all matches NEITHER pseudo-class -- not
  ;; `:in-range` by default. Brave: black.
  :html "<p><input type=\"number\" value=\"5\"></p>"
  :css "input:in-range { color: #ff0000 } input:out-of-range { color: #0000ff }"}

 {:id :form/in-range-does-not-match-a-disabled-control
  :group :form
  ;; And the other boundary: disabling a control DOES take it out of the
  ;; range pseudo-classes, where it does not take it out of `:required`
  ;; above. Brave: margin-left 0px then 30px.
  :html "<p><input type=\"number\" min=\"1\" max=\"10\" value=\"5\" disabled><input type=\"number\" min=\"1\" max=\"10\" value=\"5\"></p>"
  :css "input:in-range { margin-left: 30px }"}

 {:id :form/placeholder-shown
  :group :form
  ;; Brave: the empty field red, the one holding a value black.
  :html "<p><input placeholder=\"hint\"><input placeholder=\"hint\" value=\"typed\"></p>"
  :css "input:placeholder-shown { color: #ff0000 }"}

 {:id :form/default-on-a-checked-checkbox
  :group :form
  ;; `:default` is the state the control was BORN in, which for a checkbox
  ;; is the `checked` attribute rather than its current checkedness. Brave:
  ;; margin-left 30px then 4px.
  :html "<p><input type=\"checkbox\" checked><input type=\"checkbox\"></p>"
  :css "input:default { margin-left: 30px }"}

 {:id :form/default-on-the-first-submit-button
  :group :form
  ;; The other half of `:default`, and it has nothing to do with checkedness:
  ;; the first submit button of a form is the one Enter would press. Brave:
  ;; the first button red, the second black.
  :html "<form><button>one</button><button>two</button></form>"
  :css "button:default { color: #ff0000 }"}

 {:id :form/indeterminate-on-a-progress-with-no-value
  :group :form
  ;; A `<progress>` with no `value` ATTRIBUTE is indeterminate. Presence is
  ;; the whole test -- measured, `value=""` and `value="abc"` are both
  ;; determinate. Brave: margin-left 30px then 0px. NOT the only shape
  ;; reachable without scripting, which the radio case below is: what is
  ;; unreachable is the CHECKBOX, whose indeterminacy is an IDL property
  ;; with no content attribute behind it (measured -- neither
  ;; `<input type=checkbox indeterminate>` nor `indeterminate="true"`
  ;; matches in Brave).
  :html "<p><progress></progress><progress value=\"0.5\"></progress></p>"
  :css "progress:indeterminate { margin-left: 30px }"}

 {:id :form/indeterminate-on-a-radio-group-with-none-checked
  :group :form
  ;; And the second shape: every radio of a group with nothing checked is
  ;; indeterminate. Brave: margin-left 30px on BOTH.
  :html "<p><input type=\"radio\" name=\"ig1\"><input type=\"radio\" name=\"ig1\"></p>"
  :css "input:indeterminate { margin-left: 30px }"}

 {:id :form/a-radio-group-with-one-checked-is-not-indeterminate
  :group :form
  ;; Its control, and the pair is what makes either a measurement: check one
  ;; of the two and NEITHER is indeterminate any more. Brave: margin-left
  ;; 5px on both, i.e. the UA value.
  :html "<p><input type=\"radio\" name=\"ig2\" checked><input type=\"radio\" name=\"ig2\"></p>"
  :css "input:indeterminate { margin-left: 30px }"}

 ;; ---- structural and logical selectors -----------------------------

 {:id :selector/only-of-type
  :group :selector
  ;; `:only-of-type` was in neither the engine's `matches-pseudo?` nor the
  ;; corpus. Brave: the lone `<p>` red, the two `<span>`s black.
  :html "<div><p>p</p><span>s1</span><span>s2</span></div>"
  :css "div > :only-of-type { color: #ff0000 }"}

 {:id :selector/only-of-type-is-not-only-child
  :group :selector
  ;; Its control, and it is the whole distinction: the `<span>` is the only
  ;; one OF ITS TYPE while having two siblings. Brave: the span red, both
  ;; paragraphs black.
  :html "<div><p>1</p><p>2</p><span>s</span></div>"
  :css "div > :only-of-type { color: #ff0000 }"}

 {:id :selector/last-of-type-among-mixed-siblings
  :group :selector
  ;; The mirror of `first-of-type-among-mixed-siblings`, counted per tag
  ;; from the end. Brave: the second span red, the second p blue, the first
  ;; of each black.
  :html "<div><span>s1</span><p>p1</p><span>s2</span><p>p2</p></div>"
  :css "div span:last-of-type { color: #ff0000 } div p:last-of-type { color: #0000ff }"}

 {:id :selector/nth-last-of-type
  :group :selector
  ;; An+B counted per tag AND from the end -- the one combination of the
  ;; four `:nth-*` pseudo-classes the corpus had no case for. The `<span>`
  ;; is in the middle to prove the count skips it. Brave: the second
  ;; paragraph red.
  :html "<div><p>1</p><span>s</span><p>2</p><p>3</p></div>"
  :css "div p:nth-last-of-type(2) { color: #ff0000 }"}

 {:id :selector/empty-ignores-a-comment
  :group :selector
  ;; `:empty` is "no child NODES", with one exception that has to be
  ;; measured: a comment is not a child for this purpose and a whitespace
  ;; text node is. Brave: the commented paragraph red, the one holding a
  ;; single space black, the genuinely empty one red.
  :html "<p><!--c--></p><p> </p><p></p>"
  :css "p:empty { color: #ff0000 }"}

 {:id :selector/first-child-ignores-a-comment
  :group :selector
  ;; Its control on the other structural family: a leading comment does not
  ;; take the `:first-child` position away from the element after it.
  ;; Brave: the first paragraph red, the second black.
  :html "<div><!--c--><p>a</p><p>b</p></div>"
  :css "p:first-child { color: #ff0000 }"}

 {:id :selector/lang-matches-the-attribute
  :group :selector
  ;; Brave: the `en` paragraph red, the `fr` one black.
  :html "<div lang=\"en\"><p>en</p></div><div lang=\"fr\"><p>fr</p></div>"
  :css "p:lang(en) { color: #ff0000 }"}

 {:id :selector/lang-matches-a-region-subtag
  :group :selector
  ;; `:lang()` is a language RANGE, not a string compare: `en` matches
  ;; `en-GB`. Brave: red then black.
  :html "<div lang=\"en-GB\"><p>gb</p></div><div lang=\"fr-CA\"><p>ca</p></div>"
  :css "p:lang(en) { color: #ff0000 }"}

 {:id :selector/lang-does-not-match-a-broader-tag
  :group :selector
  ;; The range runs one way only, which is the control for the case above:
  ;; `:lang(en-GB)` does not match a bare `en`. Brave: black.
  :html "<div lang=\"en\"><p>en</p></div>"
  :css "p:lang(en-GB) { color: #ff0000 }"}

 {:id :selector/lang-is-inherited-through-an-untagged-ancestor
  :group :selector
  ;; The language is the nearest ANCESTOR's `lang`, not the element's own.
  ;; Brave: red.
  :html "<div lang=\"fr\"><section><p>x</p></section></div>"
  :css "p:lang(fr) { color: #ff0000 }"}

 {:id :selector/a-lang-selector-list-is-not-valid-in-this-browser
  :group :selector
  ;; Selectors 4 gives `:lang()` a comma-separated list of ranges. Blink 151
  ;; has not shipped it: measured, the rule is DROPPED from
  ;; `document.styleSheets` entirely (two rules survive on the page instead
  ;; of three) and the paragraph is black -- where `:lang(de)` alone, the
  ;; case above's shape, is red. An engine that implements the list is
  ;; ahead of this oracle rather than wrong, and the corpus records which.
  :html "<div lang=\"de\"><p>de</p></div>"
  :css "p:lang(fr, de) { color: #ff0000 }"}

 {:id :selector/dir-matches-the-direction
  :group :selector
  ;; Brave: the rtl paragraph red, the ltr one blue.
  :html "<div dir=\"rtl\"><p>a</p></div><div dir=\"ltr\"><p>b</p></div>"
  :css "p:dir(rtl) { color: #ff0000 } p:dir(ltr) { color: #0000ff }"}

 {:id :selector/dir-reads-the-attribute-and-not-the-css-property
  :group :selector
  ;; The rule that a spec reading gets wrong: `:dir()` is HTML
  ;; directionality, and `direction: rtl` in CSS does not change it. Brave:
  ;; BLUE -- `:dir(ltr)` still matches a box the CSS has turned rtl.
  :html "<div style=\"direction: rtl\"><p>a</p></div>"
  :css "p:dir(rtl) { color: #ff0000 } p:dir(ltr) { color: #0000ff }"}

 {:id :selector/any-link-and-link-both-match-an-href
  :group :selector
  ;; Neither is implemented here, and both are ordinary non-interactive
  ;; state: an `<a>` is a link exactly when it has an `href`. Brave:
  ;; padding-left AND padding-right 30px on the first anchor, 0 on the
  ;; second.
  :html "<p><a href=\"/x\">l</a><a>n</a></p>"
  :css "a:any-link { padding-left: 30px } a:link { padding-right: 30px }"}

 {:id :selector/not-takes-a-complex-argument
  :group :selector
  ;; Selectors 4 lets `:not()` hold a full complex selector, and Blink has
  ;; shipped it (the rule survives in `document.styleSheets`). Brave: the
  ;; paragraph inside `.w` black, the one outside red.
  :html "<div class=\"w\"><p>a</p></div><div><p>b</p></div>"
  :css "p:not(.w p) { color: #ff0000 }"}

 {:id :selector/has-a-next-sibling
  :group :selector
  ;; `:has(+ p)` -- the adjacent form, beside the `~` one the corpus
  ;; already has. Brave: the first `<h2>` red, the second black.
  :html "<div><h2>head</h2><p>p</p></div><div><h2>head</h2><b>b</b></div>"
  :css "h2:has(+ p) { color: #ff0000 }"}

 {:id :selector/has-a-direct-child-compound
  :group :selector
  ;; `:has(> b.m)` -- the child form with a compound argument, which is
  ;; what separates it from the descendant form. Brave: the first div red,
  ;; the one whose `b.m` is a level deeper black.
  :html "<div><b class=\"m\">x</b></div><div><span><b class=\"m\">y</b></span></div>"
  :css "div:has(> b.m) { color: #ff0000 }"}

 {:id :selector/has-takes-a-selector-list
  :group :selector
  ;; :has()'s own comma list is an OR. Brave: the first two divs red, the
  ;; third black. This case is ALSO the reason `scope-css` learned to split
  ;; a selector list outside parentheses only -- before that it rewrote the
  ;; second arm to `#case-N i`, and the first div came out black.
  :html "<div><i>i</i></div><div><b>b</b></div><div><u>u</u></div>"
  :css "div:has(b, i) { color: #ff0000 }"}

 {:id :selector/has-specificity-comes-from-its-arguments
  :group :selector
  ;; :has()'s specificity is the MAXIMUM over its argument list, including
  ;; an arm that matches nothing -- the same rule `:is()` has, and the same
  ;; rule a nested `&` relies on. `#zz` makes the compound (1,0,1), which
  ;; beats `div.c p`'s (0,1,2). Brave: RED.
  :html "<div class=\"c\"><p><b>b</b></p></div>"
  :css "p:has(#zz, b) { color: #ff0000 } div.c p { color: #0000ff }"}

 {:id :selector/one-argument-does-not-raise-a-has-specificity
  :group :selector
  ;; Its control, and neither means anything alone: drop the `#zz` arm and
  ;; `p:has(b)` is (0,0,2), which LOSES to the same `div.c p`. Brave: BLUE.
  :html "<div class=\"c\"><p><b>b</b></p></div>"
  :css "p:has(b) { color: #ff0000 } div.c p { color: #0000ff }"}

 {:id :selector/has-inside-is
  :group :selector
  ;; `:has()` composes into `:is()`. Brave: the div holding a `<b>` red,
  ;; the plain one black.
  :html "<div><b>b</b></div><div>plain</div>"
  :css ":is(div:has(b)) { color: #ff0000 }"}

 {:id :selector/has-nested-in-has-is-invalid
  :group :selector
  ;; ...and does NOT compose into itself: `:has()` inside `:has()` is
  ;; invalid, so the whole rule is dropped rather than the inner one being
  ;; ignored. Measured: two rules survive on the page instead of three, and
  ;; the div is black. An engine that parses the inner one and matches
  ;; makes it red.
  :html "<div><section><b>x</b></section></div>"
  :css "div:has(section:has(b)) { color: #ff0000 }"}

 {:id :selector/has-a-descendant-through-a-combinator
  :group :selector
  ;; The control for the case above: the same intent written legally, as a
  ;; descendant combinator inside one `:has()`. Brave: the first div red,
  ;; the second black.
  :html "<div><section><b>x</b></section></div><div><section><i>y</i></section></div>"
  :css "div:has(section b) { color: #ff0000 }"}

 ;; ---- pseudo-elements ----------------------------------------------
 ;;
 ;; `pseudo-element-pattern` recognises `::before`, `::after` and
 ;; `::first-letter` and deliberately nothing else, so a rule naming any
 ;; other pseudo-element falls through to the pseudo-CLASS pattern, becomes
 ;; an unrecognised pseudo-class, and matches nothing. That is fail-CLOSED,
 ;; which is the safe direction -- these cases measure what it costs.
 ;;
 ;; THREE were measured and deliberately NOT added, because no axis can see
 ;; them at any value (all three in this corpus's own frame):
 ;;   ::placeholder  -- a 40px `font-size` on it leaves the `<input>` at
 ;;                     153x21, exactly its box without the rule.
 ;;   ::selection    -- nothing is selected, so a `color`/`background` on it
 ;;                     changes neither the paragraph's box nor any of the
 ;;                     fourteen compared properties.
 ;;   ::backdrop     -- a `<dialog open>` is not MODAL and has no backdrop;
 ;;                     the dialog's own box is 41x54 either way.
 ;; A case that can never be scored does not belong here.

 {:id :generated/marker-font-size-grows-the-item
  :group :generated
  ;; The oracle cannot read a marker's text -- no Range reaches generated
  ;; content -- so only the LINE score is blind here. The geometry the case
  ;; is written for is still compared, and it is the whole point of it.
  :oracle/blind true
  ;; `::marker` HAS no box of its own, and its effect still reaches the
  ;; geometry axis: the marker is an inline box on the item's first line, so
  ;; a bigger font grows the line. Brave: the `<li>` is 800x29 against
  ;; 800x20 without the rule -- 9px, well outside the 2px tolerance.
  :html "<ul><li>one</li></ul>"
  :css "li::marker { font-size: 40px }"}

 {:id :generated/marker-font-size-on-an-ordered-list
  :group :generated
  ;; The oracle cannot read a marker's text -- no Range reaches generated
  ;; content -- so only the LINE score is blind here. The geometry the case
  ;; is written for is still compared, and it is the whole point of it.
  :oracle/blind true
  ;; The same on an `<ol>`, whose marker is a string rather than a glyph.
  ;; Brave: 800x29 against 800x20.
  :html "<ol><li>one</li></ol>"
  :css "li::marker { font-size: 40px }"}

 {:id :generated/marker-content-widens-a-shrink-to-fit-item
  :group :generated
  ;; The other observable half: `content` on a `::marker` changes what the
  ;; marker advances, which a shrink-to-fit box reads directly. Brave: the
  ;; inline-block is 56 wide against 40 without the rule -- and 40 is
  ;; exactly what this engine's own inside-marker advance formula gives, so
  ;; the control is already pinned by `:list/list-style-position-inside`.
  :html "<div style=\"display: inline-block\"><ul style=\"list-style-position: inside; margin: 0; padding: 0\"><li>one</li></ul></div>"
  :css "li::marker { content: \"XXXX \" }"}

 {:id :generated/an-unknown-pseudo-element-does-not-restyle-its-element
  :group :generated
  ;; The control beside the three above, and it is the failure mode they
  ;; are the other side of: an unrecognised pseudo-element must not fall
  ;; back to styling the ELEMENT. Measured: Brave drops the rule (two rules
  ;; survive instead of three) and the paragraph is black; this engine
  ;; reaches the same black by a different route (`:frobnicate` becomes an
  ;; unrecognised pseudo-CLASS, which never matches). Two right answers for
  ;; two reasons, which is what makes it a control and not a finding.
  :html "<p>text</p>"
  :css "p::frobnicate { color: #ff0000 }"}

 {:id :form/file-selector-button-padding-grows-the-control
  :group :form
  ;; `::file-selector-button` styles a real box in the UA shadow tree, and
  ;; the control's own size is computed from it. Brave: 261x65 with
  ;; `padding: 20px` on the button, against 253x27 without -- and 253 is the
  ;; `ceil(34 x advance("0"))` term round forty-five implemented, which is
  ;; correct exactly while it wins. A fix needs the shadow tree, not a
  ;; wider constant. Measured in full on 2026-08-06 -- twelve declarations
  ;; on the pseudo-element, the control's box and the button's own box
  ;; beside each -- and deliberately still not implemented: see the `file`
  ;; branch of `atomic-intrinsic-width` in src/cssom/layout.cljk for the
  ;; table and for the split it turns on. The HEIGHT is derivable from
  ;; numbers this engine already has; the WIDTH's second term is the two
  ;; localized UA strings (92.656 + 119.313 here, in Japanese), so writing
  ;; it would encode this machine's UI language.
  :html "<p><input type=\"file\"></p>"
  :css "input::file-selector-button { padding: 20px }"}


 ;; ---- box alignment ------------------------------------------------
 ;;
 ;; `place-items`, `place-content` and `place-self` are in neither
 ;; `cssom.core`'s shorthand expanders nor `cssom.layout`'s readers, so
 ;; every case below that uses one is measuring whether a shorthand is
 ;; expanded at all. The order of the two values had to be measured rather
 ;; than assumed and is the same for all three: ALIGN first, then JUSTIFY --
 ;; block axis before inline axis, which is the opposite of the order the
 ;; `gap` shorthand's two values are usually remembered in.

 {:id :grid/place-items-centers-both-axes
  :group :grid
  ;; `place-items` is a size decision before it is a position one: the item
  ;; stops filling the track. Brave: the item is 7x20 at (56.5, 20) in a
  ;; 120x60 track.
  :html "<div id=\"pi1\" style=\"display: grid; grid-template-columns: 120px; grid-template-rows: 60px; width: 300px\"><div>x</div></div>"
  :css "#pi1 { place-items: center }"}

 {:id :grid/place-items-is-align-then-justify
  :group :grid
  ;; The order, measured: `place-items: end start` reports
  ;; `align-items: end` and `justify-items: start`, and the item lands at
  ;; (0, 40) in the same 120x60 track. Reading the two values the other way
  ;; round puts it at (113, 0), so this case tells the two apart.
  :html "<div id=\"pi2\" style=\"display: grid; grid-template-columns: 120px; grid-template-rows: 60px; width: 300px\"><div>x</div></div>"
  :css "#pi2 { place-items: end start }"}

 {:id :grid/place-items-control-is-stretch
  :group :grid
  ;; The control for both: with no `place-items` the item fills its track.
  ;; Brave: 120x60 at (0, 0).
  :html "<div id=\"pi3\" style=\"display: grid; grid-template-columns: 120px; grid-template-rows: 60px; width: 300px\"><div>x</div></div>"}

 {:id :grid/place-self-single-value-is-both-axes
  :group :grid
  ;; One value sets both. Brave: the item is 7x20 at (113, 40).
  :html "<div style=\"display: grid; grid-template-columns: 120px; grid-template-rows: 60px; width: 300px\"><div id=\"ps1\">x</div></div>"
  :css "#ps1 { place-self: end }"}

 {:id :grid/place-self-two-values
  :group :grid
  ;; ...and two values are align then justify, same as `place-items`.
  ;; `place-self: end center` puts the first item at (56.5, 40) while its
  ;; sibling, untouched, still fills its own track at (0, 60) 120x20.
  :html "<div style=\"display: grid; grid-template-columns: 120px; grid-template-rows: 60px; width: 300px\"><div id=\"ps2\">x</div><div>y</div></div>"
  :css "#ps2 { place-self: end center }"}

 {:id :grid/justify-content-centers-the-tracks
  :group :grid
  ;; `justify-content` on a grid CONTAINER places the tracks in the leftover
  ;; space, which `cssom.layout` names as unimplemented (tracks are always
  ;; placed from the start edge). Brave: the two 60px tracks at x=90 and
  ;; x=150 in a 300px grid.
  :html "<div style=\"display: grid; grid-template-columns: 60px 60px; width: 300px; justify-content: center\"><div>x</div><div>y</div></div>"}

 {:id :grid/justify-content-space-between-spreads-the-tracks
  :group :grid
  ;; The distribution form of the same property, which a "centre it" fix
  ;; would not cover. Brave: x=0 and x=240.
  :html "<div style=\"display: grid; grid-template-columns: 60px 60px; width: 300px; justify-content: space-between\"><div>x</div><div>y</div></div>"}

 {:id :grid/align-content-end
  :group :grid
  ;; The block-axis half. Brave: the two 20px rows at y=60 and y=80 in a
  ;; 100px-tall grid.
  :html "<div id=\"ac1\" style=\"display: grid; grid-template-rows: 20px 20px; height: 100px; width: 300px\"><div>x</div><div>y</div></div>"
  :css "#ac1 { align-content: end }"}

 {:id :grid/align-content-control
  :group :grid
  ;; Its control: without the declaration the rows start at the top edge.
  ;; Brave: y=0 and y=20.
  :html "<div id=\"ac2\" style=\"display: grid; grid-template-rows: 20px 20px; height: 100px; width: 300px\"><div>x</div><div>y</div></div>"}

 {:id :grid/place-content-is-align-then-justify
  :group :grid
  ;; The shorthand over both of the above, in the same order. Brave:
  ;; `place-content: end center` reports `align-content: end` and
  ;; `justify-content: center`, and the two tracks land at (90, 80) and
  ;; (150, 80).
  :html "<div id=\"pc1\" style=\"display: grid; grid-template-columns: 60px 60px; grid-template-rows: 20px; width: 300px; height: 100px\"><div>x</div><div>y</div></div>"
  :css "#pc1 { place-content: end center }"}

 {:id :grid/auto-flow-dense-backfills-a-hole
  :group :grid
  ;; `dense` is named as unimplemented at `item-grid-placement`. Brave, in a
  ;; three-column grid with an item locked to column 2 and a two-column
  ;; spanner after it: the third item goes BACK to (0, 0), into the hole the
  ;; explicit placement left.
  :html "<div style=\"display: grid; grid-template-columns: 60px 60px 60px; grid-auto-flow: row dense\"><div style=\"grid-column: 2\">1</div><div style=\"grid-column: span 2\">2</div><div>3</div></div>"}

 {:id :grid/auto-flow-sparse-does-not-backfill
  :group :grid
  ;; Its control, identical but for the keyword: the cursor only ever moves
  ;; forward, so the third item lands at (120, 20). The two cases differ in
  ;; exactly one box, which is what makes the pair a measurement of `dense`
  ;; rather than of placement in general.
  :html "<div style=\"display: grid; grid-template-columns: 60px 60px 60px\"><div style=\"grid-column: 2\">1</div><div style=\"grid-column: span 2\">2</div><div>3</div></div>"}

 {:id :grid/order-reorders-grid-items
  :group :grid
  ;; `order` is not a flex property: it reorders a grid's auto-placement
  ;; too. Brave: the first item at x=60 and the second at x=0.
  :html "<div style=\"display: grid; grid-template-columns: 60px 60px\"><div style=\"order: 2\">aa</div><div>bb</div></div>"}

 {:id :flex/place-content-on-a-row
  :group :flex
  ;; The same shorthand on a flex container, where `align-content` has no
  ;; effect on a single line and `justify-content` does all the work.
  ;; Brave: the two items at x=286 and x=293, each 7x100.
  :html "<div id=\"fpc\" style=\"display: flex; width: 300px; height: 100px\"><div>x</div><div>y</div></div>"
  :css "#fpc { place-content: center flex-end }"}

 {:id :flex/place-items-applies-only-on-the-cross-axis
  :group :flex
  ;; `place-items: center` on a flex row sets `align-items: center` (which
  ;; applies) and `justify-items: center` (which a flex container ignores).
  ;; Brave: the item 7x20 at (0, 30) in an 80px-tall container, against
  ;; 7x80 at (0, 0) without the rule. Half of a shorthand applying is the
  ;; shape a per-property fix gets wrong.
  :html "<div id=\"fpi\" style=\"display: flex; width: 300px; height: 80px\"><div>x</div></div>"
  :css "#fpi { place-items: center }"}

 {:id :flex/order-negative-comes-first
  :group :flex
  ;; `order` defaults to 0, so a negative one sorts ahead of untouched
  ;; siblings without any of them being renumbered. Brave: x=14, 0, 28.
  :html "<div style=\"display: flex; width: 300px\"><div>aa</div><div style=\"order: -1\">bb</div><div>cc</div></div>"}

 {:id :box/justify-self-on-a-block-child
  :group :box
  ;; Measured, and it is the one in this group a spec reading would have got
  ;; wrong: box alignment is not grid-only. `justify-self` on an ordinary
  ;; block-level child of an ordinary block container places it in the
  ;; inline axis. Brave: the 60px box at x=120 in a 300px parent, i.e.
  ;; centred, where `margin: 0 auto` would be needed to say the same thing.
  :html "<div style=\"width: 300px\"><div style=\"justify-self: center; width: 60px\">x</div></div>"}

 {:id :box/align-self-on-a-block-child-does-nothing
  :group :box
  ;; Its control, and the asymmetry is real: the BLOCK axis has no such
  ;; rule, so `align-self: end` on the same child moves nothing. Brave:
  ;; (0, 0), where `justify-self: end` on the same markup is x=240.
  :html "<div style=\"width: 300px; height: 100px\"><div style=\"align-self: end; width: 60px\">x</div></div>"}

 {:id :box/order-does-not-reorder-block-children
  :group :box
  ;; The control for the two `order` cases above: `order` applies to flex
  ;; and grid items and to nothing else. Brave: the two blocks in document
  ;; order at y=0 and y=20.
  :html "<div><div style=\"order: 2\">aa</div><div>bb</div></div>"}
 {:id :selector/is-holds-a-complex-selector
  :group :selector
  ;; `:is()` takes a COMPLEX selector, and this is a matching fact before
  ;; it is a specificity one: `.cs-a .cs-b` and `.cs-a.cs-b` select
  ;; different elements. Both are on the page because only the pair
  ;; measures it -- a compound-only parser reads the argument as "both
  ;; classes on ONE element" and gets each of them exactly backwards.
  ;; Brave: the nested span RED, the one-element span BLACK.
  :html "<div class=\"cs-a\"><div class=\"cs-b\"><span id=\"cs1\">s</span></div></div><div class=\"cs-a cs-b\"><span id=\"cs2\">t</span></div>"
  :css ":is(.cs-a .cs-b) span { color: #ff0000 }"}

 {:id :selector/a-complex-is-argument-carries-its-summed-specificity
  :group :selector
  ;; A complex argument's specificity is the SUM over its own compounds,
  ;; so `:is(.cq-a .cq-b) span` is (0,2,1) and beats `div.cq-b span`'s
  ;; (0,1,2). Brave: RED.
  :html "<div class=\"cq-a\"><div class=\"cq-b\"><span id=\"cq1\">s</span></div></div>"
  :css ":is(.cq-a .cq-b) span { color: #ff0000 } div.cq-b span { color: #0000ff }"}

 {:id :selector/a-complex-is-argument-still-loses-to-a-longer-selector
  :group :selector
  ;; The control the row above needs: the SUM is not a promotion.
  ;; `:is(.cr-a .cr-b) span` is (0,2,1) and `div.cr-a .cr-b span` is
  ;; (0,2,2). Brave: BLUE.
  :html "<div class=\"cr-a\"><div class=\"cr-b\"><span id=\"cr1\">s</span></div></div>"
  :css ":is(.cr-a .cr-b) span { color: #ff0000 } div.cr-a .cr-b span { color: #0000ff }"}

 {:id :nesting/an-ampersand-with-a-complex-parent-carries-the-lists-maximum
  :group :nesting
  ;; The third arity of `&`, and the one round forty-nine measured and
  ;; left open. `.nq-q, .nq-a .nq-b` is a parent list with one COMPLEX
  ;; arm; `&` is `:is()` of the list, so its specificity is the maximum
  ;; over the arms -- (0,2,0), from the arm that matches NOTHING on this
  ;; page. `& span` is therefore (0,2,1) and beats `div.nq-q span`'s
  ;; (0,1,2). Brave: RED. Expanding the list one parent at a time, which
  ;; is what this engine did until complex `:is()` arguments landed, gives
  ;; `.nq-q span` = (0,1,1) and loses.
  :html "<div class=\"nq-q\"><span id=\"nq1\">s</span></div>"
  :css ".nq-q, .nq-a .nq-b { & span { color: #ff0000 } } div.nq-q span { color: #0000ff }"}

 {:id :nesting/two-complex-parents-do-not-raise-a-nested-rule
  :group :nesting
  ;; ...and the control, which a change that simply raised every
  ;; multi-parent nested rule would turn red. Both arms complex, no id
  ;; anywhere: the maximum is (0,2,0), `& span` is (0,2,1), and
  ;; `div.np-a .np-b span` is (0,2,2). Brave: BLUE. This case agrees on
  ;; both sides of the change and is here for that reason.
  :html "<div class=\"np-a\"><div class=\"np-b\"><span id=\"np1\">s</span></div></div>"
  :css ".np-a .np-b, .np-c .np-d { & span { color: #ff0000 } } div.np-a .np-b span { color: #0000ff }"}

 {:id :cascade/a-registered-custom-ident-rejects-a-number
  :group :cascade
  ;; `@property`'s `syntax` is a grammar, not three special cases. A `7`
  ;; is not a `<custom-ident>`, so the declaration is invalid for the
  ;; registration and the property falls back to its registered INITIAL --
  ;; `center`, which `text-align` is one of the fourteen properties the
  ;; computed-style axis compares. Brave: `text-align: center`. An engine
  ;; that only checks `<length>`/`<number>`/`<integer>` keeps the 7 and
  ;; lands on `text-align: 7`.
  :html "<div><p id=\"pa1\">text</p></div>"
  :css "@property --paz { syntax: \"<custom-ident>\"; inherits: false; initial-value: center } #pa1 { --paz: 7; text-align: var(--paz) }"}

 {:id :cascade/a-registration-with-an-unknown-syntax-component-is-dropped
  :group :cascade
  ;; An unknown component NAME does not degrade to "syntax unchecked" --
  ;; it makes the whole at-rule invalid, so the property is not registered
  ;; at all and `var(--pfz)` has nothing to resolve to. Brave: 800 wide
  ;; (the declaration is invalid at computed-value time and `width` is
  ;; `auto`). Its control is
  ;; `:cascade/a-registered-custom-property-has-an-initial-value`, the same
  ;; shape with `<length>`, which must stay 60.
  :html "<div><p id=\"pf1\">w</p></div>"
  :css "@property --pfz { syntax: \"<flurb>\"; inherits: false; initial-value: 60px } #pf1 { width: var(--pfz) }"}

 {:id :supports/a-colour-this-engine-cannot-parse-is-not-supported
  :group :supports
  ;; The value half of the `@supports` oracle now speaks for colours,
  ;; because the colour grammar turned out to live one layer BELOW
  ;; `cssom.core` (in dom-gpu) rather than above it in `cssom.layout`.
  ;; Both halves on one page because a condition that correctly reports
  ;; false proves nothing without a true one beside it. Brave: the first
  ;; paragraph BLACK, the second RED.
  :html "<div><p id=\"sz1\">a</p><p id=\"sz2\">b</p></div>"
  :css "@supports (color: #zzz) { #sz1 { color: #ff0000 } } @supports (color: #f00) { #sz2 { color: #ff0000 } }"}

 {:id :supports/text-decoration-is-answered-component-by-component
  :group :supports
  ;; The other row the oracle used to name as a scope cut. `flurb` is not
  ;; a decoration component; `underline dotted red` is three of them, and
  ;; a per-component walk is what tells them apart without answering
  ;; `false` for a real declaration. Brave: BLACK then RED.
  :html "<div><p id=\"sd1\">a</p><p id=\"sd2\">b</p></div>"
  :css "@supports (text-decoration: flurb) { #sd1 { color: #ff0000 } } @supports (text-decoration: underline dotted red) { #sd2 { color: #ff0000 } }"}

 ;; ---- @scope: a range in the tree, and PROXIMITY in the cascade ----
 ;;
 ;; Round forty-four measured `@scope` and left it; round forty-nine
 ;; measured it in full and named exactly why it was still open -- one of
 ;; its rules is a new dimension in the cascade sort tuple, not a parse or
 ;; a value change. This is that round.
 ;;
 ;; Every value below was read out of a real headless Brave 151.1.93.129
 ;; over CDP on 2026-08-06, ONE PROBE PAGE PER PROBE, and each probe page
 ;; carried the case's CSS ALREADY PUT THROUGH `scope-css` and wrapped in a
 ;; `#case-0` container -- so the numbers are the numbers this corpus page
 ;; produces, not the numbers a bare probe would.
 ;;
 ;; A FOURTH HAZARD OF THE SHARED PAGE, on top of the three above: a scoped
 ;; selector carries an implicit `:scope ` DESCENDANT prefix, and the case
 ;; container is an ANCESTOR of the scope root -- so prefixing the body of a
 ;; rooted `@scope` with `#case-N` makes the rule `:scope #case-N .x`, which
 ;; matches nothing. Measured: the case that existed before this round read
 ;; BOTH its paragraphs as black in Brave, for that reason and not for the
 ;; one its comment gave. `scope-css` now leaves a rooted `@scope` body
 ;; unprefixed (the prelude already confines it), which is what lets the
 ;; cases below say what they mean -- and it is why every scope root here is
 ;; an id or class nothing else on the page uses.
 ;;
 ;; The cost of that fix, named where it bites: the two sides of this
 ;; harness now receive different CSS in one respect. Every UNSCOPED
 ;; selector still gains `#case-N` on the browser side and does not on the
 ;; engine side, and a rooted `@scope` body gains nothing on either. That
 ;; is invisible while both competing selectors are unscoped -- they both
 ;; gain one id -- and it INVERTS a specificity comparison the moment a
 ;; scoped rule competes with an unscoped one. So every case below puts its
 ;; competing rules inside `@scope` blocks, or lets a key ABOVE specificity
 ;; (layer order) decide. See the note above
 ;; `a-limit-cuts-the-limit-element-and-everything-under-it` for the one
 ;; measurement this makes inexpressible here.

 {:id :scope/the-scope-root-itself-does-not-match-a-bare-descendant-rule
  :group :scope
  ;; A scoped selector is `:scope <selector>`, so the ROOT is out even when
  ;; it matches the selector. Brave: the outer `div` is black and the one
  ;; inside it is red. Before this round the wrapper was transparent and
  ;; both were red.
  :html "<div><div id=\"sc-r1\"><div>inner</div></div></div>"
  :css "@scope (#sc-r1) { div { color: #ff0000 } }"}

 {:id :scope/the-scope-pseudo-class-reaches-the-root
  :group :scope
  ;; The other half of the row above, and the control for it: `:scope` is
  ;; how a scoped rule reaches its own root. Brave: the root is red.
  :html "<div><div id=\"sc-r2\"><p>child</p></div></div>"
  :css "@scope (#sc-r2) { :scope { color: #ff0000 } }"}

 {:id :scope/a-scope-prelude-contributes-no-specificity
  :group :scope
  ;; Two rules in the SAME scope, so proximity ties and specificity alone
  ;; decides. `p` is (0,0,1) and `div p` is (0,0,2) -- the prelude adds
  ;; nothing to either. Brave: blue.
  :html "<div><div id=\"sc-r3\"><div><p>text</p></div></div></div>"
  :css "@scope (#sc-r3) { p { color: #ff0000 } } @scope (#sc-r3) { div p { color: #0000ff } }"}

 {:id :scope/an-explicit-scope-pseudo-class-does-add-specificity
  :group :scope
  ;; The same shape with `:scope` written out: `:scope p` is (0,1,1) and
  ;; beats the same `div p` the case above loses to. Brave: RED. The pair
  ;; is the measurement -- it says the implicit prefix and the written
  ;; pseudo-class cannot share one representation.
  :html "<div><div id=\"sc-r4\"><div><p>text</p></div></div></div>"
  :css "@scope (#sc-r4) { :scope p { color: #ff0000 } } @scope (#sc-r4) { div p { color: #0000ff } }"}

 {:id :scope/proximity-beats-source-order
  :group :scope
  ;; The row that makes this a cascade change. The blue rule is written
  ;; FIRST and its scope root is NEARER, and blue wins -- so reversing the
  ;; source order does not reverse the answer. Brave: blue. An engine with
  ;; no proximity key reports red (source order).
  :html "<div><div class=\"sc-o3\"><div class=\"sc-o4\"><p>text</p></div></div></div>"
  :css "@scope (.sc-o4) { p { color: #0000ff } } @scope (.sc-o3) { p { color: #ff0000 } }"}

 {:id :scope/proximity-and-source-order-pointing-the-same-way
  :group :scope
  ;; The control beside it: the same two scopes with the nearer one written
  ;; SECOND, where proximity and source order agree. Brave: blue, and an
  ;; engine with no proximity key also reports blue. Only the pair is
  ;; evidence.
  :html "<div><div class=\"sc-o1\"><div class=\"sc-o2\"><p>text</p></div></div></div>"
  :css "@scope (.sc-o1) { p { color: #ff0000 } } @scope (.sc-o2) { p { color: #0000ff } }"}

 {:id :scope/specificity-beats-proximity
  :group :scope
  ;; Where the seventh sort key sits, from above. The FARTHER scope carries
  ;; `div p` (0,0,2) and the NEARER one carries `p` (0,0,1), and the
  ;; farther one wins. Brave: blue. Beside
  ;; `proximity-beats-source-order`, which has the same shape at EQUAL
  ;; specificity and answers the other way, this places proximity BELOW
  ;; specificity and ABOVE order.
  :html "<div><div class=\"sc-far2\"><div class=\"sc-near2\"><p>text</p></div></div></div>"
  :css "@scope (.sc-far2) { div p { color: #0000ff } } @scope (.sc-near2) { p { color: #ff0000 } }"}

 {:id :scope/layer-order-beats-proximity
  :group :scope
  ;; ...and from above on the other side. The farther scope is in the LATER
  ;; layer and wins. Brave: blue. If proximity had been put above the layer
  ;; key this reads red, which is what makes it a measurement rather than a
  ;; decoration.
  :html "<div><div class=\"sc-far3\"><div class=\"sc-near3\"><p>text</p></div></div></div>"
  :css "@layer sc-la, sc-lb; @layer sc-lb { @scope (.sc-far3) { p { color: #0000ff } } } @layer sc-la { @scope (.sc-near3) { p { color: #ff0000 } } }"}

 ;; MEASURED AND DELIBERATELY NOT ADDED: "an unscoped declaration is at
 ;; INFINITE proximity". It is a real rule and a real divergence -- Brave
 ;; reports RED for `@scope (#r) { p { red } } p { blue }`, same
 ;; specificity, same layer, with the unscoped rule written LATER, and it
 ;; is still red inside one explicit `@layer` -- but it cannot be expressed
 ;; on the SHARED PAGE, and the reason is worth having written down.
 ;;
 ;; The two sides of this harness get DIFFERENT CSS. `cascaded-document`
 ;; hands the engine the case's raw `:css`; the browser gets it through
 ;; `scope-css`, which prefixes every UNSCOPED selector with `#case-N` and
 ;; -- since 2026-08-06 -- leaves a rooted `@scope` body alone. That is
 ;; harmless whenever both competing selectors are prefixed, which was true
 ;; of every case in this corpus before the `:scope` group: they both gain
 ;; one id and their relative order is unchanged. It stops being harmless
 ;; the moment a SCOPED selector competes with an UNSCOPED one, because
 ;; then only one of the two gains that id.
 ;;
 ;; The case that was written and removed made it concrete. `@scope (#r5)
 ;; { #w1 #p1 { red } } #p1 { blue }` is (2,0,0) against (2,0,0) in the
 ;; browser and (2,0,0) against (1,0,0) in the engine -- so both sides say
 ;; RED, the case passes, and the engine's red comes from specificity while
 ;; the browser's comes from proximity. It agreed on the base commit too,
 ;; which is how it was caught. There is no rewrite that fixes it: equal
 ;; specificity on one side is unequal on the other, by construction.
 ;;
 ;; The measurement lives in `cssom.core-test`'s
 ;; `an-unscoped-declaration-is-at-infinite-proximity`, which calls
 ;; `apply-cascade` directly and therefore has one CSS text rather than
 ;; two. It fails on the base commit and passes here, with both controls
 ;; (specificity still decides first, and so does layer order) passing on
 ;; both sides.

 {:id :scope/a-limit-cuts-the-limit-element-and-everything-under-it
  :group :scope
  ;; The donut hole, all four positions in one case. Brave: the paragraph
  ;; before the limit is red, the one inside it is black, the one after it
  ;; is red again, and the one outside the root is black. An engine with no
  ;; `@scope` reports red for all four.
  :html "<div><div id=\"sc-r6\"><p>before</p><div class=\"sc-lim\"><p>inside limit</p></div><p>after</p></div><p>outside</p></div>"
  :css "@scope (#sc-r6) to (.sc-lim) { p { color: #ff0000 } }"}

 {:id :scope/the-limit-element-itself-is-out
  :group :scope
  ;; The case above cannot see this, because its limit is a `div` and its
  ;; rule selects `p`. Here the rule selects `div`, so the limit element is
  ;; itself a candidate. Brave: black -- the limit is excluded, not merely
  ;; its descendants.
  :html "<div><div id=\"sc-r6b\"><div>before</div><div class=\"sc-lim2\"><div>inside limit</div></div></div></div>"
  :css "@scope (#sc-r6b) to (.sc-lim2) { div { color: #ff0000 } }"}

 {:id :scope/a-limit-selector-is-relative-to-the-scope-root
  :group :scope
  ;; `to (:scope > .sc-lim3)` cuts only a `.sc-lim3` that is a DIRECT CHILD
  ;; of the root. Brave: the first `.sc-lim3` and what is under it are
  ;; black; the wrapper beside it, the second `.sc-lim3` and what is under
  ;; THAT are red. So the limit is a selector evaluated against the scope,
  ;; not a bare class test.
  :html "<div><div id=\"sc-r11\"><div class=\"sc-lim3\"><div>under direct</div></div><div><div class=\"sc-lim3\"><div>under deep</div></div></div></div></div>"
  :css "@scope (#sc-r11) to (:scope > .sc-lim3) { div { color: #ff0000 } }"}

 {:id :scope/a-cut-root-does-not-suppress-a-nearer-uncut-one
  :group :scope
  ;; One root SELECTOR, two matching ancestors, and a limit between them.
  ;; Every match roots its own scope: the paragraph under the inner root is
  ;; red (the limit is ABOVE that scope, not inside it) and the paragraph
  ;; beside it, still inside the limit, is black. Brave: red, black.
  :html "<div><div class=\"sc-r12\"><div class=\"sc-lim4\"><div class=\"sc-r12\"><p>inner</p></div><p>cut</p></div></div></div>"
  :css "@scope (.sc-r12) to (.sc-lim4) { p { color: #ff0000 } }"}

 {:id :scope/a-scoped-rule-keeps-the-layer-it-was-written-in
  :group :scope
  ;; The guard round forty-four's `@media`-inside-`@layer` cut named:
  ;; losing a layer tag does not merely forget the layer, it promotes the
  ;; rule to UNLAYERED, the strongest normal position in the author origin.
  ;; The scoped rule is in the EARLIER layer and must lose. Brave: blue.
  :html "<div><div id=\"sc-r7\"><p>text</p></div></div>"
  :css "@layer sc-ka, sc-kb; @layer sc-ka { @scope (#sc-r7) { p { color: #ff0000 } } } @layer sc-kb { p { color: #0000ff } }"}

 {:id :scope/a-scoped-rule-keeps-the-media-condition-it-was-written-in
  :group :scope
  ;; `@media` INSIDE `@scope`, both directions of the condition in one
  ;; case. Brave: the paragraph is red (the query holds) and the span is
  ;; black (it does not). A wrapper that swallowed the condition would
  ;; report the span red.
  :html "<div><div id=\"sc-r8\"><p>text</p><span>span</span></div></div>"
  :css "@scope (#sc-r8) { @media (min-width: 1px) { p { color: #ff0000 } } } @scope (#sc-r8) { @media (min-width: 99999px) { span { color: #008000 } } }"}

 {:id :scope/nested-scopes-both-have-to-contain-the-element
  :group :scope
  ;; Four positions, one case. Brave: red only where BOTH roots are
  ;; ancestors; black under each root alone and black under neither.
  :html "<div><div id=\"sc-a\"><div class=\"sc-b\"><p>both</p></div><p>only a</p></div><div class=\"sc-b\"><p>only b</p></div><p>neither</p></div>"
  :css "@scope (#sc-a) { @scope (.sc-b) { p { color: #ff0000 } } }"}

 {:id :scope/proximity-is-measured-to-the-nearest-matching-root
  :group :scope
  ;; One root selector matching two ancestors: `.sc-r9` counts at ONE hop
  ;; (the inner match), not three. Brave: red.
  :html "<div><div class=\"sc-r9\"><div class=\"sc-m9\"><div class=\"sc-r9\"><p>text</p></div></div></div></div>"
  :css "@scope (.sc-r9) { p { color: #ff0000 } } @scope (.sc-m9) { p { color: #0000ff } }"}

 {:id :scope/proximity-with-only-one-matching-root-per-scope
  :group :scope
  ;; The control: drop the inner root and `.sc-m10` is the nearer scope.
  ;; Brave: blue. Without this, the red above is equally consistent with
  ;; "the FIRST matching ancestor wins" and with source order.
  :html "<div><div class=\"sc-r10\"><div class=\"sc-m10\"><p>text</p></div></div></div>"
  :css "@scope (.sc-r10) { p { color: #ff0000 } } @scope (.sc-m10) { p { color: #0000ff } }"}

 {:id :scope/important-does-not-reverse-proximity
  :group :scope
  ;; This engine encodes the `!important` layer-order REVERSAL by negating
  ;; the layer key, and the measurement says proximity must not ride along.
  ;; Both declarations are `!important` and the nearer one is written
  ;; FIRST; if importance reversed proximity the later, farther one would
  ;; win. Brave: red.
  :html "<div><div class=\"sc-far5\"><div class=\"sc-near5\"><p>text</p></div></div></div>"
  :css "@scope (.sc-near5) { p { color: #ff0000 !important } } @scope (.sc-far5) { p { color: #0000ff !important } }"}
 ;; ---- content distribution, round fifty-three ----
 ;; Every number below was read out of a real headless Brave 151.1.93.129
 ;; over CDP on 2026-08-06, one probe page per probe, before the case was
 ;; written. Coordinates here are the browser's minus the 8px body margin.

 {:id :grid/justify-content-space-around-and-evenly-are-not-the-same
  :group :grid
  ;; Two tracks cannot tell `space-around` from `space-evenly` apart from
  ;; the lead, so this is the three-track shape where they separate.
  ;; Brave, three 60px tracks in a 300px grid: around at 20/120/220
  ;; (each track gets a full free/n share, split half-lead half-trail) and
  ;; evenly at 30/120/210 (free split into n+1 equal gaps).
  :html "<div style=\"display: grid; grid-template-columns: 60px 60px 60px; width: 300px; justify-content: space-around\"><div style=\"height: 20px\">x</div><div style=\"height: 20px\">y</div><div style=\"height: 20px\">z</div></div>"}

 {:id :grid/justify-content-space-evenly-splits-the-free-space-n-plus-one-ways
  :group :grid
  ;; Its pair. Brave: 30/120/210.
  :html "<div style=\"display: grid; grid-template-columns: 60px 60px 60px; width: 300px; justify-content: space-evenly\"><div style=\"height: 20px\">x</div><div style=\"height: 20px\">y</div><div style=\"height: 20px\">z</div></div>"}

 {:id :grid/justify-content-adds-to-the-gap-rather-than-replacing-it
  :group :grid
  ;; `column-gap` stays a MINIMUM the distribution is added to, not a
  ;; fallback for when free space runs out. Brave: 0/240 -- the same two
  ;; positions the gapless grid gives, because space-between puts
  ;; everything at the two edges either way, which is exactly why the
  ;; case that distinguishes the two readings is the CENTRE one beside it.
  :html "<div style=\"display: grid; grid-template-columns: 60px 60px; column-gap: 20px; width: 300px; justify-content: space-between\"><div style=\"height: 20px\">x</div><div style=\"height: 20px\">y</div></div>"}

 {:id :grid/justify-content-center-counts-the-gap-as-part-of-the-subject
  :group :grid
  ;; ...and here it does: 140px of tracks-and-gap in 300px leaves 160,
  ;; so the pair sits at 80/160. Reading `gap` as a fallback would give
  ;; 90/150, which is this case's whole point.
  :html "<div style=\"display: grid; grid-template-columns: 60px 60px; column-gap: 20px; width: 300px; justify-content: center\"><div style=\"height: 20px\">x</div><div style=\"height: 20px\">y</div></div>"}

 {:id :grid/an-overflowing-track-list-is-unsafe-by-default
  :group :grid
  ;; NEGATIVE free space, which is where the alignment keywords stop
  ;; agreeing with their own names. A bare positional keyword is UNSAFE:
  ;; Brave puts three 120px tracks in a 300px grid at -30/90/210 under
  ;; `center`, hanging the first off the start edge.
  :html "<div style=\"display: grid; grid-template-columns: 120px 120px 120px; width: 300px; justify-content: center\"><div style=\"height: 20px\">x</div><div style=\"height: 20px\">y</div><div style=\"height: 20px\">z</div></div>"}

 {:id :grid/safe-center-falls-back-to-start-when-it-overflows
  :group :grid
  ;; The `safe` prefix on the identical shape, and it is the only thing
  ;; that differs. Brave: 0/120/240.
  :html "<div style=\"display: grid; grid-template-columns: 120px 120px 120px; width: 300px; justify-content: safe center\"><div style=\"height: 20px\">x</div><div style=\"height: 20px\">y</div><div style=\"height: 20px\">z</div></div>"}

 {:id :grid/space-between-falls-back-to-start-when-it-overflows
  :group :grid
  ;; And the distribution keywords are safe WITHOUT the prefix -- their
  ;; fallback alignment is a safe one. Brave: 0/120/240, i.e. nothing
  ;; spread at all, which is not what the name suggests.
  :html "<div style=\"display: grid; grid-template-columns: 120px 120px 120px; width: 300px; justify-content: space-between\"><div style=\"height: 20px\">x</div><div style=\"height: 20px\">y</div><div style=\"height: 20px\">z</div></div>"}

 {:id :grid/an-authored-justify-content-stops-auto-tracks-stretching
  :group :grid
  ;; CSS Grid 12.8 stretches `auto` tracks only under `normal`/`stretch`,
  ;; and that condition is what gives a non-default `justify-content`
  ;; anything to distribute. Brave: two `auto` tracks holding 60px items
  ;; in a 300px grid are 60 wide each and land at 90/150.
  :html "<div style=\"display: grid; grid-template-columns: auto auto; width: 300px; justify-content: center\"><div style=\"width: 60px; height: 20px\">x</div><div style=\"width: 60px; height: 20px\">y</div></div>"}

 {:id :grid/auto-tracks-stretch-when-nothing-is-authored
  :group :grid
  ;; Its control, identical but for the declaration: the tracks share the
  ;; container and the second item starts at the halfway line. Brave:
  ;; x=0 and x=150, both items still 60 wide.
  :html "<div style=\"display: grid; grid-template-columns: auto auto; width: 300px\"><div style=\"width: 60px; height: 20px\">x</div><div style=\"width: 60px; height: 20px\">y</div></div>"}

 {:id :grid/an-authored-align-content-stops-auto-rows-stretching
  :group :grid
  ;; The same condition on the block axis. Brave: two auto rows in a
  ;; 100px-tall grid under `align-content: start` are 20 tall and sit at
  ;; y=0/20.
  :html "<div style=\"display: grid; width: 300px; height: 100px; align-content: start\"><div style=\"height: 20px\">x</div><div style=\"height: 20px\">y</div></div>"}

 {:id :grid/auto-rows-stretch-when-nothing-is-authored
  :group :grid
  ;; Its control. Brave: the rows are 50 each, so the second item starts
  ;; at y=50 while staying 20 tall.
  :html "<div style=\"display: grid; width: 300px; height: 100px\"><div style=\"height: 20px\">x</div><div style=\"height: 20px\">y</div></div>"}

 {:id :grid/align-content-reads-a-min-height-clamp-as-a-definite-size
  :group :grid
  ;; A clamp makes free space just as a declared `height` does -- the
  ;; container size align-content distributes in is the USED one. Brave:
  ;; a 100-tall box with its two 20px rows at y=60/80.
  :html "<div style=\"display: grid; grid-template-rows: 20px 20px; min-height: 100px; width: 300px; align-content: end\"><div>x</div><div>y</div></div>"}

 {:id :grid/align-content-has-no-free-space-in-an-auto-height-grid
  :group :grid
  ;; Its opposite: with no definite block size the container is sized BY
  ;; its rows, so there is nothing to distribute. Brave: a 40px box with
  ;; its rows still at y=0/20, despite the declaration.
  :html "<div style=\"display: grid; grid-template-rows: 20px 20px; width: 300px; align-content: space-between\"><div>x</div><div>y</div></div>"}

 {:id :flex/justify-content-end-means-flex-end
  :group :flex
  ;; `end` and `flex-end` are the same keyword to a browser, on a flex
  ;; container as much as on a grid. Brave: two 60px items in a 300px row
  ;; at 180/240 under either spelling.
  :html "<div style=\"display: flex; width: 300px; justify-content: end\"><div style=\"width: 60px; height: 20px\">x</div><div style=\"width: 60px; height: 20px\">y</div></div>"}

 {:id :flex/an-overflowing-line-is-unsafe-by-default
  :group :flex
  ;; And the overflow rule is the same one, to the pixel: three
  ;; unshrinkable 120px items in a 300px row sit at -30/90/210, exactly
  ;; where the three grid tracks beside them do.
  :html "<div style=\"display: flex; width: 300px; justify-content: center\"><div style=\"width: 120px; height: 20px; flex-shrink: 0\">x</div><div style=\"width: 120px; height: 20px; flex-shrink: 0\">y</div><div style=\"width: 120px; height: 20px; flex-shrink: 0\">z</div></div>"}

 {:id :grid/auto-flow-dense-backfills-with-a-spanner
  :group :grid
  ;; The second dense shape, where it is the two-column SPANNER that goes
  ;; back rather than a single cell: with the explicit item locked to
  ;; column 3, Brave puts the spanner at (0,0) and the two plain items at
  ;; (0,20) and (60,20).
  :html "<div style=\"display: grid; grid-template-columns: 60px 60px 60px; grid-auto-flow: row dense\"><div style=\"grid-column: 3; height: 20px\">1</div><div style=\"grid-column: span 2; height: 20px\">2</div><div style=\"height: 20px\">3</div><div style=\"height: 20px\">4</div></div>"}

 {:id :grid/dense-changes-nothing-when-no-hole-is-left
  :group :grid
  ;; Its control, and it is a control because `dense` is only ever a
  ;; difference in where the scan STARTS: a `grid-row: span 2` item in
  ;; column 1 followed by three plain ones gives the identical four boxes
  ;; either way. Brave: (0,0) (60,0) (60,20) (0,40).
  :html "<div style=\"display: grid; grid-template-columns: 60px 60px; grid-auto-flow: row dense\"><div style=\"grid-row: span 2; height: 20px\">1</div><div style=\"height: 20px\">2</div><div style=\"height: 20px\">3</div><div style=\"height: 20px\">4</div></div>"}

 {:id :box/justify-items-on-a-block-container
  :group :box
  ;; The container-side half of `justify-self`, and this engine does NOT
  ;; read it -- layout-children-block is handed the container's content
  ;; box and not its style map. Brave: the 60px child at x=120, i.e.
  ;; centred, exactly as `justify-self: center` on the child itself is.
  :html "<div style=\"width: 300px; justify-items: center\"><div style=\"width: 60px; height: 20px\">x</div></div>"}

 {:id :box/justify-self-on-an-auto-width-block-shrinks-to-fit
  :group :box
  ;; The other half this engine leaves open: a non-stretch `justify-self`
  ;; on an AUTO-width block is a size decision as well as a position one.
  ;; Brave: the child shrink-wraps to 8.578px and sits at x=291.4, where
  ;; this engine leaves it 300 wide at x=0 and so finds no free space to
  ;; move it in.
  :html "<div style=\"width: 300px\"><div style=\"justify-self: end\">x</div></div>"}
]
