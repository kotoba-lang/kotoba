;; No dependencies. An OSPF packet is a fixed-layout header, five body
;; shapes, an LSA header, and two RFC-specified checksum algorithms — a leaf
;; that dragged a socket library or a routing daemon behind it would defeat
;; the point, which is that the wire format can be exercised (encoded,
;; decoded, fuzzed) without either.
{:deps {
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}}
 :paths ["src"]
 :aliases
 {:test {:extra-paths ["test"]}
  :cljs {:extra-paths ["test"]}}}
