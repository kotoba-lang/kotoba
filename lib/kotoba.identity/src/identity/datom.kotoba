;; Port of identity.datom (datom.cljk), Kotoba-native, :document maps.
;;
;; Each emitter returns a :document vector of one map, as the source does.
;;
;; Named divergences from datom.cljk:
;;   - A missing key, or a non-map argument, reads as document-null.
;;   - causal-datoms: `or` over the id fields is read as "first value that is
;;     neither null nor false"; with none present :db/id is null. For a
;;     non-map record the source's assoc throws; this returns a map holding
;;     only :db/id.

(ns identity.datom
  (:export [subject-datoms evidence-datoms attestation-datoms causal-datoms]))

(defn- field [m :document k :keyword] :document
  (if (map? m)
    (option-or (document-get m k) (document-null))
    (document-null)))

(defn- falsy-doc? [d :document] :bool
  (or (document-equal? d (document-null))
      (document-equal? d (document-bool false))))

(defn- or-doc [a :document b :document] :document
  (if (falsy-doc? a) b a))

(defn subject-datoms [s :document] :document
  (document-vector
   (document-map :db/id (field s :identity.subject/id)
                 :identity.subject/type (field s :identity.subject/type)
                 :identity.subject/did (field s :identity.subject/did)
                 :identity.subject/labels (field s :identity.subject/labels)
                 :identity.subject/source (field s :identity.subject/source)
                 :identity.subject/aliases (field s :identity.subject/aliases)
                 :identity.subject/conflict? (field s :identity.subject/conflict?))))

(defn evidence-datoms [e :document] :document
  (document-vector
   (document-map :db/id (field e :identity.evidence/id)
                 :identity.evidence/kind (field e :identity.evidence/kind)
                 :identity.evidence/ref (field e :identity.evidence/ref)
                 :identity.evidence/hash (field e :identity.evidence/hash)
                 :identity.evidence/source (field e :identity.evidence/source)
                 :identity.evidence/observed-at (field e :identity.evidence/observed-at)
                 :identity.evidence/claims (field e :identity.evidence/claims)
                 :identity/non-adjudicating (field e :identity/non-adjudicating))))

(defn attestation-datoms [a :document] :document
  (document-vector
   (document-map :db/id (field a :identity.attestation/id)
                 :identity.attestation/subject (field a :identity.attestation/subject)
                 :identity.attestation/predicate (field a :identity.attestation/predicate)
                 :identity.attestation/issuer (field a :identity.attestation/issuer)
                 :identity.attestation/evidence (field a :identity.attestation/evidence)
                 :identity.attestation/issued-at (field a :identity.attestation/issued-at)
                 :identity/non-adjudicating (field a :identity/non-adjudicating))))

(defn- causal-id [r :document] :document
  (or-doc (field r :identity.epoch/id)
          (or-doc (field r :identity.link/id)
                  (or-doc (field r :trust.claim/id)
                          (or-doc (field r :identity.obligation/id)
                                  (field r :identity.transition/id))))))

(defn causal-datoms [record :document] :document
  (document-vector
   (if (map? record)
     (document-assoc record :db/id (causal-id record))
     (document-map :db/id (causal-id record)))))
