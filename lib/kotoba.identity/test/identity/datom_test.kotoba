(ns identity.datom-test (:export [main]) (:require [identity.datom :as p]))

(defn- ok [b :bool] :i64
  (if b 0 1))

(defn- row [v :document] :document
  (option-or (document-vector-at v 0) (document-null)))

(defn- subject-checks [] :i64
  (let [s (document-map :identity.subject/id (document-string "subj-1")
                        :identity.subject/type (document-keyword :person))]
    (ok (document-equal? (row (p/subject-datoms s))
                         (document-map :db/id (document-string "subj-1")
                                       :identity.subject/type (document-keyword :person)
                                       :identity.subject/did (document-null)
                                       :identity.subject/labels (document-null)
                                       :identity.subject/source (document-null)
                                       :identity.subject/aliases (document-null)
                                       :identity.subject/conflict? (document-null))))))

(defn- causal-checks [] :i64
  (+ (ok (document-equal? (row (p/causal-datoms (document-map :identity.epoch/id (document-string "ep-1")
                                                              :identity.link/id (document-string "ln-1")
                                                              :x (document-i64 7))))
                          (document-map :db/id (document-string "ep-1")
                                        :identity.epoch/id (document-string "ep-1")
                                        :identity.link/id (document-string "ln-1")
                                        :x (document-i64 7))))
     (ok (document-equal? (row (p/causal-datoms (document-map :identity.link/id (document-string "ln-1"))))
                          (document-map :db/id (document-string "ln-1")
                                        :identity.link/id (document-string "ln-1"))))
     (ok (document-equal? (row (p/causal-datoms (document-map :x (document-i64 7))))
                          (document-map :db/id (document-null) :x (document-i64 7))))))

(defn- evidence-checks [] :i64
  (ok (document-equal? (row (p/evidence-datoms (document-map :identity.evidence/id (document-string "ev-1")
                                                             :identity.evidence/kind (document-keyword :doc))))
                       (document-map :db/id (document-string "ev-1")
                                     :identity.evidence/kind (document-keyword :doc)
                                     :identity.evidence/ref (document-null)
                                     :identity.evidence/hash (document-null)
                                     :identity.evidence/source (document-null)
                                     :identity.evidence/observed-at (document-null)
                                     :identity.evidence/claims (document-null)
                                     :identity/non-adjudicating (document-null)))))

(defn main [] :i64
  (+ (subject-checks) (causal-checks) (evidence-checks)))
