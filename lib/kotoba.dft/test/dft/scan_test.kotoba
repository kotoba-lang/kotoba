(ns dft.scan-test (:export [main]) (:require [dft.scan :as s]))

;; document-map canonicalizes key order, but document-edn-read keeps the text
;; order, so the EDN literals below list keys in sorted order.

(defn- same [a :document b :document] :bool
  (string=? (document-edn-print a) (document-edn-print b)))

(defn- fld [d :document k :keyword] :document
  (option-or (document-get d k) (document-null)))

(defn main [] :i64
  (let [cfg (s/config (document-map :chain-count (document-i64 2)))
        ffs (document-vector (document-string "a") (document-string "b") (document-string "c")
                             (document-string "d") (document-string "e"))
        chains (s/insert-scan-chains ffs cfg)
        exp (document-edn-read "[{:cells [{:chain-id 0 :ff-name \"a\" :position 0 :scan-in \"SI0\" :scan-out \"a_so\"} {:chain-id 0 :ff-name \"c\" :position 1 :scan-in \"a_so\" :scan-out \"c_so\"} {:chain-id 0 :ff-name \"e\" :position 2 :scan-in \"c_so\" :scan-out \"SO0\"}] :id 0 :length 3 :scan-in-port \"SI0\" :scan-out-port \"SO0\"} {:cells [{:chain-id 1 :ff-name \"b\" :position 0 :scan-in \"SI1\" :scan-out \"b_so\"} {:chain-id 1 :ff-name \"d\" :position 1 :scan-in \"b_so\" :scan-out \"SO1\"}] :id 1 :length 2 :scan-in-port \"SI1\" :scan-out-port \"SO1\"}]")
        dflt (s/config (document-map))
        one (s/insert-scan-chains (document-vector (document-string "x"))
                                  (s/config (document-map :chain-count (document-i64 3) :scan-in-prefix (document-string "T"))))
        exp-one (document-edn-read "[{:cells [{:chain-id 0 :ff-name \"x\" :position 0 :scan-in \"T0\" :scan-out \"SO0\"}] :id 0 :length 1 :scan-in-port \"T0\" :scan-out-port \"SO0\"} {:cells [] :id 1 :length 0 :scan-in-port \"T1\" :scan-out-port \"SO1\"} {:cells [] :id 2 :length 0 :scan-in-port \"T2\" :scan-out-port \"SO2\"}]")
        st (s/scan-chain-stats chains)
        exp-st (document-map :num-chains (document-i64 2) :total-ffs (document-i64 5)
                             :max-length (document-i64 3) :min-length (document-i64 2))]
    (+ (if (same chains exp) 0 1)
       (if (same (s/insert-scan-chains (document-vector) cfg) (document-vector)) 0 1)
       (if (same (s/insert-scan-chains ffs (s/config (document-map :chain-count (document-i64 0)))) (document-vector)) 0 1)
       (if (same one exp-one) 0 1)
       (if (same st exp-st) 0 1)
       (if (same (s/scan-chain-stats (document-vector))
                 (document-map :num-chains (document-i64 0) :total-ffs (document-i64 0)
                               :max-length (document-i64 0) :min-length (document-i64 0))) 0 1)
       (if (same (fld dflt :clock-name) (document-string "clk")) 0 1)
       (if (same (fld dflt :max-length) (document-i64 100)) 0 1)
       (if (same (fld dflt :scan-out-prefix) (document-string "SO")) 0 1)
       (if (same (fld dflt :chain-count) (document-null)) 0 1))))
