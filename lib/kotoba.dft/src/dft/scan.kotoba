;; Port of dft.scan (scan.cljk, kami-dft src/scan.rs), Kotoba-native, :document maps.
;;
;; Named divergences from scan.cljk:
;;   - flip-flops is a :document vector of :string names; the config and every
;;     chain / cell are :document maps.
;;   - config's :or defaults are option-or defaults; a missing :chain-count stays
;;     document-null (as nil does in the source) and reads as 0 in insert-scan-chains.
;;   - insert-scan-chains returns an empty vector for a chain-count <= 0; the
;;     source's (zero? 0) case is [] and a negative count is outside its domain
;;     (it throws there; throw is not available in Kotoba).
;;   - scan-chain-stats takes the chains as a :document vector.

(ns dft.scan
  (:export [config insert-scan-chains scan-chain-stats]))

(defn- opt-or [m :document k :keyword d :document] :document
  (option-or (document-get m k) d))

(defn config [opts :document] :document
  (document-map
    :chain-count (opt-or opts :chain-count (document-null))
    :max-length (opt-or opts :max-length (document-i64 100))
    :clock-name (opt-or opts :clock-name (document-string "clk"))
    :scan-enable (opt-or opts :scan-enable (document-string "SE"))
    :scan-in-prefix (opt-or opts :scan-in-prefix (document-string "SI"))
    :scan-out-prefix (opt-or opts :scan-out-prefix (document-string "SO"))))

(defn- str-of [m :document k :keyword d :string] :string
  (option-or (document-string-value (opt-or m k (document-null))) d))

(defn- i64-of [m :document k :keyword d :i64] :i64
  (option-or (document-i64-value (opt-or m k (document-null))) d))

(defn- elt [v :document i :i64] :document
  (option-or (document-vector-at v i) (document-null)))

(defn- ff-str [ffs :document i :i64] :string
  (option-or (document-string-value (elt ffs i)) ""))

(defn- chain-members [ffs :document cc :i64 c :i64] :document
  (loop [i 0 acc (document-vector)]
    (if (< i (document-count ffs))
      (recur (+ i 1) (if (= (mod i cc) c) (document-vector-conj acc (elt ffs i)) acc))
      acc)))

(defn- cell [members :document c :i64 pos :i64 sip :string sop :string] :document
  (let [n (document-count members)
        nm (ff-str members pos)
        sin (if (= pos 0) sip (string-concat (ff-str members (- pos 1)) "_so"))
        sout (if (= pos (- n 1)) sop (string-concat nm "_so"))]
    (document-map :ff-name (document-string nm)
                  :scan-in (document-string sin)
                  :scan-out (document-string sout)
                  :chain-id (document-i64 c)
                  :position (document-i64 pos))))

(defn- cells-of [members :document c :i64 sip :string sop :string] :document
  (loop [pos 0 acc (document-vector)]
    (if (< pos (document-count members))
      (recur (+ pos 1) (document-vector-conj acc (cell members c pos sip sop)))
      acc)))

(defn- chain-of [members :document c :i64 inp :string outp :string] :document
  (let [sip (string-concat inp (string-from-i64 c))
        sop (string-concat outp (string-from-i64 c))]
    (document-map :id (document-i64 c)
                  :cells (cells-of members c sip sop)
                  :length (document-i64 (document-count members))
                  :scan-in-port (document-string sip)
                  :scan-out-port (document-string sop))))

(defn insert-scan-chains [flip-flops :document cfg :document] :document
  (let [cc (i64-of cfg :chain-count 0)
        inp (str-of cfg :scan-in-prefix "SI")
        outp (str-of cfg :scan-out-prefix "SO")]
    (if (or (<= cc 0) (= (document-count flip-flops) 0))
      (document-vector)
      (loop [c 0 acc (document-vector)]
        (if (< c cc)
          (recur (+ c 1) (document-vector-conj acc (chain-of (chain-members flip-flops cc c) c inp outp)))
          acc)))))

(defn scan-chain-stats [chains :document] :document
  (let [n (document-count chains)]
    (loop [i 0 total 0 mx 0 mn 0]
      (if (< i n)
        (let [len (i64-of (elt chains i) :length 0)]
          (recur (+ i 1)
                 (+ total len)
                 (if (= i 0) len (if (> len mx) len mx))
                 (if (= i 0) len (if (< len mn) len mn))))
        (document-map :num-chains (document-i64 n)
                      :total-ffs (document-i64 total)
                      :max-length (document-i64 mx)
                      :min-length (document-i64 mn))))))
