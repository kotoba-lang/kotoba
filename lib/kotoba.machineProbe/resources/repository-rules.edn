;; This repository's entry in the kotoba.repository-role-rules taxonomy.
;; ADR-2607266000 / ADR-2607299000.
{:schema "kotoba.repository-role-rules.v0"
 :this-repo
 {:name "machine-probe"
  :tier :t5
  :role :assurance
  ;; The effect half of the machine contract. `machine` declares
  ;; :must-not [:probe-hardware] and `perfgate` declares
  ;; :must-not [:run-benchmarks], so somebody has to actually touch the
  ;; device -- it is this repo, in one place, on purpose. :assurance rather
  ;; than :provider because it consumes libraries (layout) to produce
  ;; evidence, which the provider role edge does not permit.
  :must-not [:invent-facts-it-did-not-read :own-the-descriptor-schema :judge-its-own-results]
  :depends-on ["kotoba-lang/machine" "kotoba-lang/layout" "kotoba-lang/perfgate"]}}
