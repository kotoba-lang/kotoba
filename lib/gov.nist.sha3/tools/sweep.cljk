;; Prints "<function> <message-length> <output-length> <hex>" for a fixed sweep.
;; Pipe it into tools/oracle_sweep.py, which recomputes every line with Python's
;; hashlib (an independent implementation) and compares.
;;   kbb --backend sci --classpath src tools/sweep.cljk | python3 -I tools/oracle_sweep.py
(require '[sha3.core :as sha3])

(defn msg [n] (vec (map #(mod (+ (* % 7) 3) 256) (range n))))

(doseq [n (range 0 421)]
  (let [m (msg n)]
    (println "sha3-224" n 28 (sha3/sha3-224-hex m))
    (println "sha3-256" n 32 (sha3/sha3-256-hex m))
    (println "sha3-384" n 48 (sha3/sha3-384-hex m))
    (println "sha3-512" n 64 (sha3/sha3-512-hex m))))

(doseq [n [0 1 55 56 135 136 137 167 168 169 335 336 337 500]
        out [1 16 31 32 135 136 137 167 168 169 336 500 1000]]
  (let [m (msg n)]
    (println "shake128" n out (sha3/shake128-hex m out))
    (println "shake256" n out (sha3/shake256-hex m out))))
