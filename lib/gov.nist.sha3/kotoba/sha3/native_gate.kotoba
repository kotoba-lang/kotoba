;; sha3.native-gate -- FIPS 202 known answers and an oracle sweep, run by a
;; loaderless static image built from kotoba/sha3/core.kotoba (README "Native
;; gate" composes the two bodies; JUN-352 P1b).
;;
;; main returns a bitmask, 63 is a pass:
;;   1 SHA3-224/256/384/512 of "" and "abc" (FIPS 202 examples)
;;   2 SHA3-256 of 200 bytes 0xA3 (NIST example, crosses one rate block)
;;   4 SHAKE128/256 of "" (NIST examples), 32 and 64 bytes
;;   8 SHAKE outputs are prefixes of longer outputs across the rate boundary
;;  16 every sponge output byte is 0..255 and the lengths are exact
;;  32 bad parameters are refused (rate not a multiple of 8, negative length)
;; It also prints one line per oracle case for the README's hashlib comparison:
;;   sha3-<bits> <len> <hex> / shake128 <len> <out> <hex> / shake256 <len> <out> <hex>
(ns sha3.native-gate
  (:export [main]))

(defn- g-ascii [s :string] :vector-i64 (vector-i64-from-bytes (string-to-utf8 s)))
(defn- g-fill [n :i64 x :i64] :vector-i64
  (loop [i 0 out (vector-alloc n)] (if (= i n) out (recur (+ i 1) (vector-assoc! out i x)))))
(defn- g-pattern [n :i64] :vector-i64
  (loop [i 0 out (vector-alloc n)] (if (= i n) out (recur (+ i 1) (vector-assoc! out i (rem (+ (* 7 i) 3) 256))))))
(defn- g-prefix? [a :vector-i64 b :vector-i64] :bool
  (and (<= (vector-count a) (vector-count b))
       (loop [i 0] (if (= i (vector-count a)) true (if (= (vector-at a i) (vector-at b i)) (recur (+ i 1)) false)))))
(defn- g-bytes? [d :vector-i64 n :i64] :bool
  (and (= (vector-count d) n)
       (loop [i 0] (if (= i n) true (if (and (>= (vector-at d i) 0) (<= (vector-at d i) 255)) (recur (+ i 1)) false)))))

(defn- g-sha3-examples [] :bool
  (let [e (vector-alloc 0) abc (g-ascii "abc")]
    (and (= (hex (sha3-224 e)) "6b4e03423667dbb73b6e15454f0eb1abd4597f9a1b078e3f5b5a6bc7")
         (= (hex (sha3-256 e)) "a7ffc6f8bf1ed76651c14756a061d662f580ff4de43b49fa82d80a4b80f8434a")
         (= (hex (sha3-384 e)) "0c63a75b845e4f7d01107d852e4c2485c51a50aaaa94fc61995e71bbee983a2ac3713831264adb47fb6bd1e058d5f004")
         (= (hex (sha3-512 e)) "a69f73cca23a9ac5c8b567dc185a756e97c982164fe25859e0d1dcc1475c80a615b2123af1f5f94c11e3e9402c3ac558f500199d95b6d3e301758586281dcd26")
         (= (hex (sha3-224 abc)) "e642824c3f8cf24ad09234ee7d3c766fc9a3a5168d0c94ad73b46fdf")
         (= (hex (sha3-256 abc)) "3a985da74fe225b2045c172d6bd390bd855f086e3e9d525b46bfe24511431532")
         (= (hex (sha3-384 abc)) "ec01498288516fc926459f58e2c6ad8df9b473cb0fc08c2596da7cf0e49be4b298d88cea927ac7f539f1edf228376d25")
         (= (hex (sha3-512 abc)) "b751850b1a57168a5693cd924b6b096e08f621827444f70d884f5d0240d2712e10e116e9192af3c91a7ec57647e3934057340b4cf408d5a56592f8274eec53f0"))))

(defn- g-sha3-a3 [] :bool
  (= (hex (sha3-256 (g-fill 200 163))) "79f38adec5c20307a98ef76e8324afbfd46cfd81b22e3973c65fa1bd9de31787"))

(defn- g-shake-examples [] :bool
  (let [e (vector-alloc 0)]
    (and (= (hex (shake128 e 32)) "7f9c2ba4e88f827d616045507605853ed73b8093f6efbc88eb1a6eacfa66ef26")
         (= (hex (shake256 e 64)) "46b9dd2b0ba88d13233b3feb743eeb243fcd52ea62b81b82b50c27646ed5762fd75dc4ddd8c0f200cb05019d67b592f6fc821c49479ab48640292eacb3b7c4be"))))

(defn- g-shake-prefixes [] :bool
  (let [m (g-pattern 300)]
    (and (g-prefix? (shake128 m 167) (shake128 m 400)) (g-prefix? (shake128 m 168) (shake128 m 400))
         (g-prefix? (shake128 m 169) (shake128 m 400)) (g-prefix? (shake256 m 135) (shake256 m 300))
         (g-prefix? (shake256 m 136) (shake256 m 300)) (g-prefix? (shake256 m 137) (shake256 m 300)))))

(defn- g-shapes [] :bool
  (and (loop [n 0] (if (= n 140) true (if (g-bytes? (sha3-256 (g-pattern n)) 32) (recur (+ n 1)) false)))
       (g-bytes? (shake128 (g-pattern 10) 0) 0) (g-bytes? (sha3-512 (g-pattern 73)) 64)))

(defn- g-refusals [] :bool
  (and (= (vector-count (sponge (vector-alloc 0) 135 6 32)) 0)
       (= (vector-count (sponge (vector-alloc 0) 136 6 -1)) 0)
       (= (vector-count (sponge (vector-alloc 0) 0 6 32)) 0)))

(defn- g-say [s :string] :i64
  (let [x (typed-cap-call :io/write :string :string (string-concat s "\n"))] 0))
(defn- g-line [name :string n :i64 tail :string] :i64
  (g-say (string-concat name (string-concat " " (string-concat (string-from-i64 n) (string-concat " " tail))))))

;; Lengths around every rate (72, 104, 136, 144, 168) and a few multi-block ones.
(defn- g-len [i :i64] :i64
  (vector-at [0 1 71 72 73 103 104 105 135 136 137 143 144 145 167 168 169 335 336 337 500] i))

(defn- g-print-sweeps [] :i64
  (loop [i 0 n 0]
    (if (= i 21) n
      (let [m (g-pattern (g-len i))
            a (g-line "sha3-224" (g-len i) (hex (sha3-224 m)))
            b (g-line "sha3-256" (g-len i) (hex (sha3-256 m)))
            c (g-line "sha3-384" (g-len i) (hex (sha3-384 m)))
            d (g-line "sha3-512" (g-len i) (hex (sha3-512 m)))
            e (g-line "shake128" (g-len i) (string-concat "200 " (hex (shake128 m 200))))
            f (g-line "shake256" (g-len i) (string-concat "300 " (hex (shake256 m 300))))]
        (recur (+ i 1) (+ n 6))))))

(defn main [] :i64
  (let [lines (g-print-sweeps)
        x (g-say (string-concat "lines " (string-from-i64 lines)))]
    (+ (if (g-sha3-examples) 1 0)
       (+ (if (g-sha3-a3) 2 0)
          (+ (if (g-shake-examples) 4 0)
             (+ (if (g-shake-prefixes) 8 0)
                (+ (if (g-shapes) 16 0) (if (g-refusals) 32 0))))))))
