(ns sha3.sha3-test
  "Runtime-agnostic suite: published examples, table pins, and API behaviour.

   The NIST CAVP files are exercised by `sha3.cavp-test`."
  (:require [sha3.core :as sha3]
            [sha3.test-util :refer [ascii hex->bytes]]
            #?(:clj  [clojure.test :refer [deftest is testing]]
               :cljs [cljs.test :refer [deftest is testing]])))

;; ---------------------------------------------------------------------------
;; Published values (FIPS 202 examples / NIST "SHA-3 Standard" example values)
;; ---------------------------------------------------------------------------

(deftest published-digests
  (testing "SHA3-224"
    (is (= "6b4e03423667dbb73b6e15454f0eb1abd4597f9a1b078e3f5b5a6bc7"
           (sha3/sha3-224-hex []))))
  (testing "SHA3-256"
    (is (= "a7ffc6f8bf1ed76651c14756a061d662f580ff4de43b49fa82d80a4b80f8434a"
           (sha3/sha3-256-hex [])))
    (is (= "3a985da74fe225b2045c172d6bd390bd855f086e3e9d525b46bfe24511431532"
           (sha3/sha3-256-hex (ascii "abc")))))
  (testing "SHA3-384"
    (is (= (str "0c63a75b845e4f7d01107d852e4c2485c51a50aaaa94fc61995e71bbee983a2a"
                "c3713831264adb47fb6bd1e058d5f004")
           (sha3/sha3-384-hex []))))
  (testing "SHA3-512"
    (is (= (str "a69f73cca23a9ac5c8b567dc185a756e97c982164fe25859e0d1dcc1475c80a6"
                "15b2123af1f5f94c11e3e9402c3ac558f500199d95b6d3e301758586281dcd26")
           (sha3/sha3-512-hex []))))
  (testing "SHAKE128 and SHAKE256, empty message"
    (is (= "7f9c2ba4e88f827d616045507605853ed73b8093f6efbc88eb1a6eacfa66ef26"
           (sha3/shake128-hex [] 32)))
    (is (= (str "46b9dd2b0ba88d13233b3feb743eeb243fcd52ea62b81b82b50c27646ed5762f"
                "d75dc4ddd8c0f200cb05019d67b592f6fc821c49479ab48640292eacb3b7c4be")
           (sha3/shake256-hex [] 64)))))

;; ---------------------------------------------------------------------------
;; The tables are computed from FIPS 202; pin them to the published ones.
;; ---------------------------------------------------------------------------

(def ^:private published-round-constants
  ;; The 24 Keccak round constants, as 64-bit hex (hi lo).
  ["0000000000000001" "0000000000008082" "800000000000808a" "8000000080008000"
   "000000000000808b" "0000000080000001" "8000000080008081" "8000000000008009"
   "000000000000008a" "0000000000000088" "0000000080008009" "000000008000000a"
   "000000008000808b" "800000000000008b" "8000000000008089" "8000000000008003"
   "8000000000008002" "8000000000000080" "000000000000800a" "800000008000000a"
   "8000000080008081" "8000000000008080" "0000000080000001" "8000000080008008"])

(defn- hex32 [n]
  (let [s #?(:clj (Long/toString n 16) :cljs (.toString n 16))]
    (str (apply str (repeat (- 8 (count s)) "0")) s)))

(deftest round-constants-match-the-standard
  (let [computed @#'sha3.core/round-constants]
    (is (= 24 (count computed)))
    (is (= published-round-constants
           (mapv (fn [[lo hi]] (str (hex32 hi) (hex32 lo))) computed)))))

(deftest rotation-offsets-match-the-standard
  ;; Table 2 of FIPS 202, read out in lane order x + 5y.
  (is (= [0 1 62 28 27
          36 44 6 55 20
          3 10 43 25 39
          41 45 15 21 8
          18 2 61 56 14]
         @#'sha3.core/rho-offsets)))

;; ---------------------------------------------------------------------------
;; The permutation
;; ---------------------------------------------------------------------------

(deftest keccak-f-of-the-zero-state
  ;; The widely published first lane of Keccak-f[1600] applied to the all-zero
  ;; state is 0xF1258F7940E1DDE7 (lane 0), 0x84D5CCF933C0478A (lane 1).
  (let [s (sha3/keccak-f1600 (vec (repeat 50 0)))]
    (is (= ["f1258f7940e1dde7" "84d5ccf933c0478a"]
           [(str (hex32 (nth s 1)) (hex32 (nth s 0)))
            (str (hex32 (nth s 3)) (hex32 (nth s 2)))]))))

;; ---------------------------------------------------------------------------
;; API behaviour
;; ---------------------------------------------------------------------------

(deftest signed-bytes-are-accepted
  (is (= (sha3/sha3-256 [0xff 0x80 0x01])
         (sha3/sha3-256 [-1 -128 1]))))

(deftest absorbing-in-pieces-equals-one-shot
  (let [msg (vec (map #(mod (* % 7) 256) (range 700)))]
    (doseq [kind [:sha3-256 :shake128 :shake256]
            cut [0 1 135 136 137 167 168 169 699 700]]
      (let [a (-> (sha3/xof kind)
                  (sha3/xof-absorb (subvec msg 0 cut))
                  (sha3/xof-absorb (subvec msg cut)))
            b (sha3/xof-absorb (sha3/xof kind) msg)]
        (is (= (second (sha3/xof-squeeze a 50)) (second (sha3/xof-squeeze b 50)))
            (str kind " cut " cut))))))

(deftest squeezing-in-pieces-equals-one-shot
  ;; across the rate boundary of SHAKE128 (168) and SHAKE256 (136)
  (doseq [[kind rate] [[:shake128 168] [:shake256 136]]]
    (let [x (sha3/xof-absorb (sha3/xof kind) (ascii "squeeze me"))
          whole (second (sha3/xof-squeeze x (* 3 rate)))
          [x1 a] (sha3/xof-squeeze x 10)
          [x2 b] (sha3/xof-squeeze x1 (- rate 5))
          [x3 c] (sha3/xof-squeeze x2 (- (* 3 rate) 10 (- rate 5)))]
      (is (= whole (vec (concat a b c))) (str kind))
      (is (= (* 3 rate) (+ (count a) (count b) (count c)))))))

(deftest shake-prefixes-are-consistent
  (let [long-out (sha3/shake128 (ascii "x") 400)]
    (doseq [n [0 1 16 168 169 400]]
      (is (= (subvec long-out 0 n) (sha3/shake128 (ascii "x") n))))))

(deftest no-absorb-after-squeeze
  (let [[x _] (sha3/xof-squeeze (sha3/xof :shake128) 1)]
    (is (thrown? #?(:clj Exception :cljs :default) (sha3/xof-absorb x [1])))))

(deftest unknown-kind-is-refused
  (is (thrown? #?(:clj Exception :cljs :default) (sha3/xof :sha3-257))))

(deftest hex-round-trip
  (is (= "000fff" (sha3/hex [0 15 255])))
  (is (= [0 15 255] (hex->bytes "000fff"))))
