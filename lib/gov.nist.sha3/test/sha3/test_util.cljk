(ns sha3.test-util
  "Helpers shared by the suites. Test code only.")

(defn hex->bytes
  "\"0a1b\" => [10 27]"
  [s]
  (vec (for [i (range 0 (count s) 2)]
         #?(:clj  (Integer/parseInt (subs s i (+ i 2)) 16)
            :cljs (js/parseInt (subs s i (+ i 2)) 16)))))

(defn ascii
  "ASCII string => byte vector. (`(int \"a\")` is 0 in ClojureScript.)"
  [s]
  #?(:clj  (mapv int s)
     :cljs (mapv #(.charCodeAt % 0) (seq s))))
