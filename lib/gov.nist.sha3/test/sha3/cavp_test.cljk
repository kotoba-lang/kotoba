(ns sha3.cavp-test
  "NIST CAVP known-answer tests for FIPS 202 (byte-oriented).

   Where the vectors come from, and what was kept of them, is in
   test/cavp/PROVENANCE.md. The data namespaces are generated by
   tools/import_cavp.py and are not edited by hand."
  (:require [sha3.core :as sha3]
            [sha3.test-util :refer [hex->bytes]]
            [sha3.cavp.sha3-224-short :as s224] [sha3.cavp.sha3-224-long :as l224] [sha3.cavp.sha3-224-monte :as m224]
            [sha3.cavp.sha3-256-short :as s256] [sha3.cavp.sha3-256-long :as l256] [sha3.cavp.sha3-256-monte :as m256]
            [sha3.cavp.sha3-384-short :as s384] [sha3.cavp.sha3-384-long :as l384] [sha3.cavp.sha3-384-monte :as m384]
            [sha3.cavp.sha3-512-short :as s512] [sha3.cavp.sha3-512-long :as l512] [sha3.cavp.sha3-512-monte :as m512]
            [sha3.cavp.shake128-short :as sk128s] [sha3.cavp.shake128-long :as sk128l] [sha3.cavp.shake128-variable :as sk128v]
            [sha3.cavp.shake256-short :as sk256s] [sha3.cavp.shake256-long :as sk256l] [sha3.cavp.shake256-variable :as sk256v]
            #?(:clj  [clojure.test :refer [deftest is testing]]
               :cljs [cljs.test :refer [deftest is testing]])))

(defn- check-md
  "Each vector is [len-bits msg-hex md-hex]; the message is whole bytes."
  [label f vectors]
  (testing label
    (is (pos? (count vectors)))
    (doseq [[len msg md] vectors]
      (is (= md (sha3/hex (f (hex->bytes msg)))) (str label " len=" len)))))

(deftest sha3-short-and-long-messages
  (check-md "SHA3-224 short" sha3/sha3-224 s224/vectors)
  (check-md "SHA3-224 long"  sha3/sha3-224 l224/vectors)
  (check-md "SHA3-256 short" sha3/sha3-256 s256/vectors)
  (check-md "SHA3-256 long"  sha3/sha3-256 l256/vectors)
  (check-md "SHA3-384 short" sha3/sha3-384 s384/vectors)
  (check-md "SHA3-384 long"  sha3/sha3-384 l384/vectors)
  (check-md "SHA3-512 short" sha3/sha3-512 s512/vectors)
  (check-md "SHA3-512 long"  sha3/sha3-512 l512/vectors))

(defn- check-xof
  "Each vector is [_ msg-hex output-hex]; the output length is the hex length."
  [label f vectors]
  (testing label
    (is (pos? (count vectors)))
    (doseq [[n msg out] vectors]
      (is (= out (sha3/hex (f (hex->bytes msg) (quot (count out) 2)))) (str label " " n)))))

(deftest shake-short-long-and-variable-output
  (check-xof "SHAKE128 short"    sha3/shake128 sk128s/vectors)
  (check-xof "SHAKE128 long"     sha3/shake128 sk128l/vectors)
  (check-xof "SHAKE128 variable" sha3/shake128 sk128v/vectors)
  (check-xof "SHAKE256 short"    sha3/shake256 sk256s/vectors)
  (check-xof "SHAKE256 long"     sha3/shake256 sk256l/vectors)
  (check-xof "SHAKE256 variable" sha3/shake256 sk256v/vectors))

(defn- monte [f seed checkpoints]
  ;; MD(0) = Seed; for each checkpoint, 1000 times Msg = MD, MD = H(Msg).
  (loop [md (hex->bytes seed) cps checkpoints out []]
    (if (empty? cps)
      out
      (let [md (loop [i 0 md md] (if (= i 1000) md (recur (inc i) (f md))))]
        (recur md (rest cps) (conj out (sha3/hex md)))))))

(deftest sha3-monte-carlo
  (is (= m224/checkpoints (monte sha3/sha3-224 m224/seed m224/checkpoints)))
  (is (= m256/checkpoints (monte sha3/sha3-256 m256/seed m256/checkpoints)))
  (is (= m384/checkpoints (monte sha3/sha3-384 m384/seed m384/checkpoints)))
  (is (= m512/checkpoints (monte sha3/sha3-512 m512/seed m512/checkpoints))))
