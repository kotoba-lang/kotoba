;; tsukasa.node-state — a node's ledger state derived from L1 and L2, with no
;; coordinator (com-junkawasaki/root ADR-2610222140 §1; Linear JUN-315, which
;; changes JUN-287's "a coordinator writes the ledger"). Every node computes
;; the same state from the same inputs, one legal ledger_core transition at a
;; time, so the derived history never breaks `legal?`.
;;
;;   L1 (operator, signed)  admitted-digest: the digest of the declaration the
;;                          operator admitted ("" = not admitted; admission is a
;;                          human decision, network-awai-apex ADR 0004);
;;                          cordoned; retired
;;   L2 (the node, signed)  decl-problem: ledger_core's first-problem of the
;;                          node's own declaration; decl-digest; fresh (the
;;                          observation is younger than ttl, murakumo's
;;                          fleet-placement fresh?); self-drain (the node backs
;;                          off by itself: maintenance, pressure)
;;
;;   node-target  where the inputs point:
;;                node/retired, node/refused (a bad declaration),
;;                node/proposed (declared, not admitted),
;;                node/declaration-changed (admitted, but the node now declares
;;                something else: it must be admitted again),
;;                node/cordoned, node/stale, node/self-drain, node/active
;;   next-state   one step from the previous state toward the target, over
;;                ledger_core's codes (-1 absent, 0 proposed, 1 admitted,
;;                2 active, 3 draining, 4 retired): a new node enters as
;;                proposed; active is reached through admitted; an active
;;                node that cannot be scheduled drains, and drains before it
;;                retires; retired is terminal
;;   schedulable? only active takes work
;;
;; Written in the Amu selfhost seed subset, after kotoba/tsukasa/ledger_core.kotoba
;; (legal?, first-problem); README "Node state from L1 and L2" has the gate.
(ns tsukasa.node-state
  (:export [node-target next-state schedulable? held?
            test-target test-steps test-legal test-paths]))

;; ---------------------------------------------------------------------------
;; Target

(defn node-target [decl-problem :string admitted-digest :string decl-digest :string
                   retired :bool fresh :bool cordoned :bool self-drain :bool] :string
  (cond retired "node/retired"
        (not (= decl-problem "tsukasa/ok")) "node/refused"
        (= admitted-digest "") "node/proposed"
        (not (= admitted-digest decl-digest)) "node/declaration-changed"
        cordoned "node/cordoned"
        (not fresh) "node/stale"
        self-drain "node/self-drain"
        :else "node/active"))

;; admitted, but not to be scheduled now
(defn held? [target :string] :bool
  (or (= target "node/declaration-changed") (= target "node/cordoned")
      (= target "node/stale") (= target "node/self-drain")))

;; ---------------------------------------------------------------------------
;; One step

(defn next-state [prev :i64 target :string] :i64
  (cond (= prev 4) 4
        (< prev 0) (if (or (= target "node/refused") (= target "node/retired")) -1 0)
        (= target "node/retired") (if (= prev 2) 3 4)
        (= target "node/active") (if (= prev 0) 1 2)
        ;; not schedulable: proposed, refused or held
        (= prev 0) (if (held? target) 1 0)
        (= prev 1) 1
        :else 3))

(defn schedulable? [state :i64] :bool (= state 2))

;; ---------------------------------------------------------------------------
;; test-* : zero-arity, true when every assertion holds.

(defn test-target [] :bool
  (if (and (= (node-target "tsukasa/ok" "d1" "d1" false true false false) "node/active")
           (= (node-target "tsukasa/ok" "d1" "d1" true true false false) "node/retired")
           ;; retirement wins over a bad declaration
           (= (node-target "tsukasa/missing-runtime-classes" "d1" "d1" true true false false) "node/retired")
           (= (node-target "tsukasa/missing-runtime-classes" "d1" "d1" false true false false) "node/refused")
           (= (node-target "tsukasa/ok" "" "d1" false true false false) "node/proposed")
           (= (node-target "tsukasa/ok" "d1" "d2" false true false false) "node/declaration-changed")
           (= (node-target "tsukasa/ok" "d1" "d1" false false true false) "node/cordoned")
           (= (node-target "tsukasa/ok" "d1" "d1" false false false false) "node/stale")
           (= (node-target "tsukasa/ok" "d1" "d1" false true false true) "node/self-drain")
           (held? "node/stale") (not (held? "node/proposed")) (not (held? "node/active")))
    true false))

(defn test-steps [] :bool
  (if (and (= (next-state -1 "node/active") 0)
           (= (next-state -1 "node/proposed") 0)
           (= (next-state -1 "node/refused") -1)
           (= (next-state -1 "node/retired") -1)
           (= (next-state 0 "node/active") 1)
           (= (next-state 1 "node/active") 2)
           (= (next-state 2 "node/active") 2)
           (= (next-state 3 "node/active") 2)
           (= (next-state 0 "node/stale") 1)
           (= (next-state 0 "node/proposed") 0)
           (= (next-state 0 "node/refused") 0)
           (= (next-state 1 "node/stale") 1)
           (= (next-state 2 "node/stale") 3)
           (= (next-state 2 "node/cordoned") 3)
           (= (next-state 2 "node/refused") 3)
           (= (next-state 3 "node/stale") 3)
           (= (next-state 2 "node/retired") 3)
           (= (next-state 3 "node/retired") 4)
           (= (next-state 1 "node/retired") 4)
           (= (next-state 0 "node/retired") 4)
           (= (next-state 4 "node/active") 4)
           (schedulable? 2) (not (schedulable? 3)) (not (schedulable? 1)))
    true false))

;; every step is a ledger_core transition (or stays, or registers)
(defn step-ok? [prev :i64 next :i64] :bool
  (cond (= prev next) true
        (and (< prev 0) (= next 0)) true
        (< prev 0) false
        :else (legal? prev next)))

(defn target-at [k :i64] :string
  (cond (= k 0) "node/retired" (= k 1) "node/refused" (= k 2) "node/proposed"
        (= k 3) "node/declaration-changed" (= k 4) "node/cordoned"
        (= k 5) "node/stale" (= k 6) "node/self-drain" :else "node/active"))

(defn all-legal-from? [prev :i64 k :i64] :bool
  (if (> k 7) true
    (if (step-ok? prev (next-state prev (target-at k)))
      (all-legal-from? prev (+ k 1))
      false)))

(defn all-legal? [prev :i64] :bool
  (if (> prev 4) true
    (if (all-legal-from? prev 0) (all-legal? (+ prev 1)) false)))

(defn test-legal [] :bool (if (all-legal? -1) true false))

;; follow the steps for n rounds under one target
(defn run [prev :i64 target :string n :i64] :i64
  (if (<= n 0) prev (run (next-state prev target) target (- n 1))))

(defn test-paths [] :bool
  (if (and ;; a new node that is admitted and fresh is active after 3 rounds
           (= (run -1 "node/active" 1) 0)
           (= (run -1 "node/active" 2) 1)
           (= (run -1 "node/active" 3) 2)
           ;; heartbeat lost: draining; back: active
           (= (run 2 "node/stale" 5) 3)
           (= (run 3 "node/active" 1) 2)
           ;; retiring an active node drains it first, then retires it
           (= (run 2 "node/retired" 1) 3)
           (= (run 2 "node/retired" 2) 4)
           (= (run 4 "node/active" 9) 4)
           ;; never admitted: stays proposed however long it waits
           (= (run -1 "node/proposed" 9) 0)
           ;; a bad declaration never enters the ledger
           (= (run -1 "node/refused" 9) -1)
           ;; a changed declaration holds an admitted node and drains an active one
           (= (run 1 "node/declaration-changed" 3) 1)
           (= (run 2 "node/declaration-changed" 3) 3)
           ;; the targets use ledger_core's declaration check
           (= (node-target (first-problem "n1" "did:key:z6Mkx" "home-1" "always-on" 0)
                           "d1" "d1" false true false false) "node/refused")
           (= (node-target (first-problem "n1" "did:key:z6Mkx" "home-1" "always-on" 2)
                           "d1" "d1" false true false false) "node/active"))
    true false))
