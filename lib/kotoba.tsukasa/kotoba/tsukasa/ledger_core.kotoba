(ns tsukasa.ledger-core
  "司 — the itonami node ledger, kotoba guest. JUN-197: this is the whole
  component — registration verdicts, lifecycle state machine, failure-domain
  audit. Pure: `amu check --jvm-free` reports :effects #{}.

  Parity with the .cljk suite (12 tests / 38 assertions): same reason literal
  texts — \"tsukasa/missing-id\" carries the same pin the :tsukasa/missing-id
  keyword carried (the test profile refuses keyword VALUES, measured
  2026-10-21: value-type-outside-profile) — same precedence (id, did,
  failure-domain, availability), same lifecycle legality incl. retired-terminal
  and typo-is-not-a-policy-hit, same audit fixture numbers.

  Measured compiler bounds that shaped this port (amu main 6c474c81):
  - params need type annotations when a symbol is used at more than one type
  - keyword VALUES are refused by the amu test profile; string literals pin
    the reason text instead
  - cond-> / not= / string-starts-with? / bit-shift-* are absent; nested if,
    inverted if, string-index-of == 0, i64 vector ops substitute
  - vector literals are :vector-i64; the ledger is 8 slots of state codes
    with -1 = absent (vector-at OOB traps, so every access is bounds-guarded)
  - state codes: 0 proposed 1 admitted 2 active 3 draining 4 retired

  JUN-287 (ADR-0244 §3): a node also declares which dapp runtime classes it
  can accept, as a MASK: wasm = 1, container (fune) = 2. Owner 2026-10-22
  \"hako = fune\": a Linux OCI image is one class, and whether it runs as a
  container (Linux) or a microVM (aiueos) is the node's choice, not a class.
  Valid masks are 1..3. Like failure-domain and availability there is NO
  default: 0 (nothing declared) is refused, and anything outside 1..3 is an
  unknown class. tsukasa only records the declaration; whether a class may
  actually run on the node is kekkai/grant's decision, and where work is
  placed is murakumo/sahai's."
  (:export [first-problem runtime-classes-problem has-runtime-class?
            register-verdict commit-register empty-ledger
            transition-verdict transition-commit state-name
            audit-nodes audit-domains audit-largest audit-single?
            test-registration test-duplicates test-transitions
            test-retired-terminal test-ledger test-audit
            test-runtime-classes]))

;; ---------------------------------------------------------------------------
;; Reason literals. Pinned contract — callers match on these exact strings;
;; changing one is a breaking change.

(defn blank? [s :string] :bool (= s ""))

(defn prefix? [s :string p :string] :bool (= (string-index-of s p) 0))

(defn runtime-classes-problem [rc :i64] :string
  (if (= rc 0) "tsukasa/missing-runtime-classes"
    (if (< rc 0) "tsukasa/unknown-runtime-class"
      (if (> rc 3) "tsukasa/unknown-runtime-class" "tsukasa/ok"))))

;; Mask membership by enumeration: no arithmetic assumed beyond comparison.
;; wasm = 1, container = 2; an unknown class name (microvm included: it is a
;; backing of container now, not a class) is never held.
(defn has-runtime-class? [rc :i64 cls :string] :bool
  (if (= cls "wasm") (or (= rc 1) (= rc 3))
  (if (= cls "container") (or (= rc 2) (= rc 3))
  false)))

(defn first-problem [id :string did :string fd :string av :string rc :i64] :string
  (let [a (if (blank? id) "tsukasa/missing-id" "tsukasa/ok")
        b (if (blank? did) "tsukasa/missing-did"
            (if (prefix? did "did:key:") "tsukasa/ok" "tsukasa/bad-did"))
        c (if (blank? fd) "tsukasa/missing-failure-domain" "tsukasa/ok")
        d (if (blank? av) "tsukasa/missing-availability"
            (if (or (= av "always-on") (= av "intermittent"))
              "tsukasa/ok" "tsukasa/bad-availability"))
        e (runtime-classes-problem rc)]
    (if (= a "tsukasa/ok")
      (if (= b "tsukasa/ok")
        (if (= c "tsukasa/ok") (if (= d "tsukasa/ok") e d) c)
        b)
      a)))

;; ---------------------------------------------------------------------------
;; Ledger: 8 slots of lifecycle state codes, -1 = absent. Refusal returns a
;; verdict string and NO new ledger — the host gates commit-register on
;; \"tsukasa/ok\", so a refused registration cannot leak in.

(defn empty-ledger [] :vector-i64 [-1 -1 -1 -1 -1 -1 -1 -1])

(defn in-range? [states :vector-i64 code :i64] :bool
  (if (< code 0) false (if (< code (count states)) true false)))

(defn register-verdict [states :vector-i64 code :i64
                        id :string did :string fd :string av :string
                        rc :i64] :string
  (if (in-range? states code)
    (let [p (first-problem id did fd av rc)]
      (if (= p "tsukasa/ok")
        (if (> (vector-at states code) -1) "tsukasa/duplicate-id" "tsukasa/ok")
        p))
    "tsukasa/unknown-node"))

;; The 8 slots rebuilt with slot `code` set to v. A self-recursive defn rather
;; than (reduce (fn ..)): the Amu selfhost seed lets a fn literal capture only
;; :i64 locals, and that fn would capture the ledger vector.
(defn set-slot [states :vector-i64 code :i64 v :i64 j :i64 acc :vector-i64] :vector-i64
  (if (< j 8)
    (recur states code v (+ j 1) (vector-conj acc (if (= j code) v (vector-at states j))))
    acc))

(defn commit-register [states :vector-i64 code :i64] :vector-i64
  (if (in-range? states code) (set-slot states code 0 0 []) states))

;; ---------------------------------------------------------------------------
;; Lifecycle. State codes outside 0..4 are refused as unknown-state (the
;; code-world form of the .cljk typo case); retired (4) is terminal.

(defn state? [to :i64] :bool (if (> to 4) false (if (< to 0) false true)))

(defn legal? [from :i64 to :i64] :bool
  (if (= from 0) (if (or (= to 1) (= to 4)) true false)
  (if (= from 1) (if (or (= to 2) (= to 4)) true false)
  (if (= from 2) (= to 3)
  (if (= from 3) (if (or (= to 2) (= to 4)) true false)
  false)))))

(defn state-name [code :i64] :string
  (if (= code 0) "proposed"
  (if (= code 1) "admitted"
  (if (= code 2) "active"
  (if (= code 3) "draining"
  (if (= code 4) "retired" "unknown"))))))

(defn transition-verdict [states :vector-i64 code :i64 to :i64] :string
  (if (in-range? states code)
    (let [from (vector-at states code)]
      (if (> from -1)
        (if (state? to)
          (if (legal? from to) "tsukasa/ok" "tsukasa/illegal-transition")
          "tsukasa/unknown-state")
        "tsukasa/unknown-node"))
    "tsukasa/unknown-node"))

(defn transition-commit [states :vector-i64 code :i64 to :i64] :vector-i64
  (if (in-range? states code) (set-slot states code to 0 []) states))

;; ---------------------------------------------------------------------------
;; Audit. Domain codes are caller-assigned i64 in 0..7 (the host holds domain
;; name strings). Counts NODES vs INDEPENDENT DOMAINS — three nodes on one
;; provider+site are one independent thing (kura-node's pseudo-node lesson).

(defn occ [ds :vector-i64 e :i64] :i64
  (reduce (fn [acc x] (if (= x e) (+ acc 1) acc)) 0 ds))

(defn audit-nodes [ds :vector-i64] :i64 (count ds))

;; Domain codes 0..7, walked by self-recursion for the same reason as set-slot.
(defn domains-from [ds :vector-i64 c :i64 acc :i64] :i64
  (if (< c 8) (recur ds (+ c 1) (if (> (occ ds c) 0) (+ acc 1) acc)) acc))

(defn audit-domains [ds :vector-i64] :i64 (domains-from ds 0 0))

(defn largest-from [ds :vector-i64 c :i64 acc :i64] :i64
  (if (< c 8) (recur ds (+ c 1) (if (> (occ ds c) acc) (occ ds c) acc)) acc))

(defn audit-largest [ds :vector-i64] :i64 (largest-from ds 0 0))

(defn audit-single? [ds :vector-i64] :bool (= (audit-domains ds) 1))

;; ---------------------------------------------------------------------------
;; test-* : exported zero-arity, return true. amu test runs each on
;; :jvm-kir :js :wasm.

(defn test-registration [] :bool
  (if (and (= (first-problem "" "did:key:x" "d" "always-on" 1) "tsukasa/missing-id")
           (= (first-problem "n" "" "d" "always-on" 1) "tsukasa/missing-did")
           (= (first-problem "n" "did:web:x" "d" "always-on" 1) "tsukasa/bad-did")
           (= (first-problem "n" "did:key:x" "" "always-on" 1) "tsukasa/missing-failure-domain")
           (= (first-problem "n" "did:key:x" "d" "" 1) "tsukasa/missing-availability")
           (= (first-problem "n" "did:key:x" "d" "mostly-on" 1) "tsukasa/bad-availability")
           (= (first-problem "n" "did:key:x" "d" "intermittent" 1) "tsukasa/ok")
           (= (first-problem "n" "did:key:x" "d" "always-on" 1) "tsukasa/ok")) true false))

(defn test-duplicates [] :bool
  (let [s (commit-register (empty-ledger) 0)]
    (if (and (= (register-verdict (empty-ledger) 0 "a" "did:key:x" "d" "always-on" 1) "tsukasa/ok")
             (= (register-verdict s 0 "a" "did:key:x" "d" "always-on" 1) "tsukasa/duplicate-id")
             (= (register-verdict s 7 "a" "did:key:x" "d" "always-on" 1) "tsukasa/ok")
             (= (register-verdict s 8 "a" "did:key:x" "d" "always-on" 1) "tsukasa/unknown-node")
             (= (register-verdict (empty-ledger) 0 "" "did:key:x" "d" "always-on" 1) "tsukasa/missing-id")) true false)))

(defn test-transitions [] :bool
  (let [s (commit-register (empty-ledger) 0)]
    (if (and (= (transition-verdict s 0 1) "tsukasa/ok")
             (= (transition-verdict s 0 2) "tsukasa/illegal-transition")
             (= (transition-verdict s 0 9) "tsukasa/unknown-state")
             (= (transition-verdict s 5 1) "tsukasa/unknown-node")
             (= (transition-verdict (empty-ledger) 0 1) "tsukasa/unknown-node")
             (= (transition-verdict s 0 4) "tsukasa/ok")) true false)))

(defn test-retired-terminal [] :bool
  (let [s (transition-commit (commit-register (empty-ledger) 0) 0 4)]
    (if (and (= (transition-verdict s 0 4) "tsukasa/illegal-transition")
             (= (transition-verdict s 0 0) "tsukasa/illegal-transition")
             (= (transition-verdict s 0 1) "tsukasa/illegal-transition")
             (= (transition-verdict s 0 2) "tsukasa/illegal-transition")
             (= (transition-verdict s 0 3) "tsukasa/illegal-transition")) true false)))

(defn test-ledger [] :bool
  (let [s0 (empty-ledger)
        s1 (commit-register s0 0)
        s2 (transition-commit s1 0 1)
        s3 (transition-commit s2 0 2)
        s4 (transition-commit s3 0 3)
        s5 (transition-commit s4 0 2)
        s6 (transition-commit s5 0 3)
        s7 (transition-commit s6 0 4)]
    (if (and (= (count s0) 8)
             (= (vector-at s0 0) -1)
             (= (vector-at s1 0) 0)
             (= (vector-at s2 0) 1)
             (= (vector-at s7 0) 4)
             (= (state-name (vector-at s7 0)) "retired")
             (= (state-name 9) "unknown")) true false)))

(defn test-audit [] :bool
  (if (and (= (audit-nodes [1 1 2]) 3)
           (= (audit-domains [1 1 2]) 2)
           (= (audit-largest [1 1 2]) 2)
           (not (audit-single? [1 1 2]))
           (= (audit-nodes [4 4 4]) 3)
           (= (audit-domains [4 4 4]) 1)
           (= (audit-largest [4 4 4]) 3)
           (audit-single? [4 4 4])
           (= (audit-nodes []) 0)
           (= (audit-domains []) 0)
           (not (audit-single? []))) true false))

(defn test-runtime-classes [] :bool
  (if (and (= (runtime-classes-problem 0) "tsukasa/missing-runtime-classes")
           (= (runtime-classes-problem -1) "tsukasa/unknown-runtime-class")
           (= (runtime-classes-problem 4) "tsukasa/unknown-runtime-class")
           (= (runtime-classes-problem 7) "tsukasa/unknown-runtime-class")
           (= (runtime-classes-problem 1) "tsukasa/ok")
           (= (runtime-classes-problem 3) "tsukasa/ok")
           ;; undeclared is refused even when everything else is valid
           (= (first-problem "n" "did:key:x" "d" "always-on" 0) "tsukasa/missing-runtime-classes")
           (= (first-problem "n" "did:key:x" "d" "always-on" 9) "tsukasa/unknown-runtime-class")
           ;; earlier problems keep precedence over the class declaration
           (= (first-problem "n" "did:key:x" "d" "" 0) "tsukasa/missing-availability")
           (= (register-verdict (empty-ledger) 0 "a" "did:key:x" "d" "always-on" 0) "tsukasa/missing-runtime-classes")
           ;; membership
           (has-runtime-class? 1 "wasm")
           (not (has-runtime-class? 1 "container"))
           (has-runtime-class? 2 "container")
           (not (has-runtime-class? 2 "wasm"))
           (has-runtime-class? 3 "wasm")
           (has-runtime-class? 3 "container")
           ;; microvm is a backing of container, not a class
           (not (has-runtime-class? 3 "microvm"))
           (not (has-runtime-class? 3 "oci"))
           (not (has-runtime-class? 0 "wasm"))) true false))
