{:paths ["src"]
 ;; XDR only. The envelope is a codec, not a server: transport, threads and
 ;; sockets belong to the deploy shell, the same arrangement org-ietf-webdav
 ;; uses for HTTP.
 :deps {
        io.github.kotoba-lang/io {:local/root "../kotoba.io"}
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}
        io.github.kotoba-lang/org-ietf-xdr {:local/root "../org.ietf.xdr"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {
                      ;; TEST-ONLY. Parity compiles kotoba/oncrpc/record.kotoba
                      ;; and runs it against oncrpc.record. Nothing in :paths
                      ;; depends on either. Pins are the west pair (amu +
                      ;; kotoba-kir) as of this commit; advanced together.
                      io.github.kotoba-lang/amu
                      {:git/url "https://github.com/kotoba-lang/amu.git"
                       :git/sha "35e8a18f2842762bedbf88b32f22e1128ad95cf0"}
                      io.github.kotoba-lang/osaho
                      {:git/url "https://github.com/kotoba-lang/osaho.git"
                       :git/sha "099c627609ad506babf05f2d5e9a73b95c1b026b"}}}}}
