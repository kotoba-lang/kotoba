;; Called by forest-maintenance after ownership/worktree validation.
(require '[clojure.edn :as edn] '["fs" :as fs])
(let [slug (first *command-line-args*)
      f "manifest/repos.edn"
      data (edn/read-string (fs/readFileSync f "utf8"))
      k :manifest.repos/extra-projects
      value (get-in data [0 k])
      old (if (string? value) (edn/read-string value) value)]
  (when-not (re-matches #"[A-Za-z0-9][A-Za-z0-9._-]*/[A-Za-z0-9][A-Za-z0-9._-]*" slug)
    (throw (ex-info "Invalid GitHub slug" {})))
  (fs/writeFileSync f (pr-str (assoc-in data [0 k] (vec (distinct (conj old slug)))))))
