{
  "schemaVersion": "1",
  "type": "mcp",
  "id": "github-forest",
  "name": "GitHub Forest Maintenance",
  "version": "1.0.0",
  "description": "Audit and safely organize local Git repositories, worktrees and WIP through nine guarded MCP tools.",
  "author": "com-junkawasaki",
  "source": "https://github.com/com-junkawasaki/west-manifest/tree/e481916ad720e10af8526774d668a6dae0cae488",
  "transport": "stdio",
  "command": "forest-maintenance",
  "args": [
    "mcp"
  ],
  "permissions": [
    "filesystem",
    "network",
    "process"
  ],
  "compatibility": {
    "hermes": "0.21.5",
    "desktop": "0.7.14"
  },
  "requires": [
    "Node.js",
    "Git",
