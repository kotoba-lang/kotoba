;; scripts/availability-oracle-cases.cljk -- kotobase.availability (pure Kotoba)
;; against kotobase.federation (the .cljk oracle), case by case.
;;
;;   NODE_PATH=<a node_modules holding @noble/hashes> \
;;     kbb --backend sci --classpath "src:$(kbb -Spath)" scripts/availability-oracle-cases.cljk
;;
;; (the pinned multiformats reaches @noble/hashes on the ClojureScript route.)
;; Every row is an assertion in src/kotobase/availability.kotoba's test-*. This
;; asks the oracle the same question and fails on the first disagreement.

(require '[kotobase.federation :as f])

(defn- b [v] (byte-array (map unchecked-byte v)))
(def blk [1 2 3 255])
(def nonce [9 9 9])
(def proof "1401f268dd8495c1d63ed77d7849adde874024a82be660688ab97f73316b8471")

(def cases
  [[:prove blk nonce proof]
   [:prove [] [1] "4bf5122f344554c53bde2ebb8cd2b7e3d1600ad631c385a5d7cce23c7785459a"]
   [:prove-missing nil]
   [:verify {:local true :response {:cid "bafyA" :proof proof}} :ok]
   [:verify {:local true :response {:cid "bafyA" :proof "00"}} :failed]
   [:verify {:local true :response nil} :missed]
   [:verify {:local true :response {:cid "other" :proof proof}} :malformed]
   [:verify {:local false :response {:cid "bafyA" :proof proof}} :verifier-lacks-replica]
   [:verify {:local false :response nil} :verifier-lacks-replica]
   [:tier :volatile false] [:tier :standard false] [:tier :sla true] [:tier :unknown false]])

(defn- oracle [[op x y]]
  (case op
    :prove (:kotobase.availability/proof (f/prove {"c" (b x)} (f/challenge "c" (b y) 1)))
    :prove-missing (f/prove {} (f/challenge "c" (b nonce) 1))
    :verify (let [{:keys [local response]} x
                  chal (f/challenge "bafyA" (b nonce) 7)]
              (f/verify (if local {"bafyA" (b blk)} {}) chal
                        (when response {:kotobase.availability/cid (:cid response)
                                        :kotobase.availability/proof (:proof response)})))
    :tier (boolean (f/audit-required? x))))

(let [bad (remove (fn [c] (= (last c) (oracle (butlast c)))) cases)]
  (doseq [c bad] (println "DISAGREE" (pr-str (butlast c)) "expected" (pr-str (last c)) "oracle" (pr-str (oracle (butlast c)))))
  (println (str "SCANNED\t" (count cases) "\tcases; " (- (count cases) (count bad)) " agree"))
  (when (or (empty? cases) (seq bad)) (js/process.exit 1)))
