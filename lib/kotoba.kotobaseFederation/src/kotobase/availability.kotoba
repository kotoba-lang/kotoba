;; kotobase.availability -- the replica availability challenge, as pure Kotoba.
;;
;; root ADR-2610082200 §5 (bytes are durable the Filecoin way: storage receipts
;; plus "kotobase-federation's availability challenge") and §16 (everything below
;; the kotoba app runs in pure Kotoba). kotobase.federation (federation.cljk)
;; stays as the oracle; this is its canonical form for a guest.
;;
;; The honest scope is the oracle's, unchanged: this is NOT Filecoin's PoRep or
;; PoSt. A verifier cannot check sha256(bytes ++ nonce) from a CID alone, so it
;; recomputes the salted hash from its own replica; the challenge proves ongoing
;; possession between two parties who both once held the block.
;;
;; Two shape changes, both because a guest has no host storage or host hash:
;; - the oracle takes a get-fn and looks the block up itself; here the caller
;;   (the conductor, hata) fetches the block through its object-store capability
;;   and passes the bytes plus whether it had them
;; - the salted hash is hash/sha256 (capability wire id 3) over block ++ nonce,
;;   so a guest using this module declares [:cap/call 3]
;;
;; prove answers "" where the oracle answers nil (no block, no proof). verify
;; answers a code in the oracle's order:
;;   5 verifier-lacks-replica  3 missed  4 malformed (cid mismatch)  1 ok  2 failed

(ns kotobase.availability
  (:export [salted-hash prove verify audit-required?
            main test-salted-hash test-prove test-verify test-tiers]))

(defn salted-hash [block :bytes nonce :bytes] :string
  (hash/sha256 (bytes-concat block nonce)))

(defn prove [has-block :bool block :bytes nonce :bytes] :string
  (if has-block (salted-hash block nonce) ""))

(defn verify [has-local :bool local :bytes nonce :bytes cid :string
              responded :bool response-cid :string response-proof :string] :i64
  (if (not has-local) 5
    (if (not responded) 3
      (if (not (string=? response-cid cid)) 4
        (if (string=? response-proof (salted-hash local nonce)) 1 2)))))

(defn audit-required? [tier :string] :bool
  ;; redundancy-tiers: only :sla (5 replicas) is audited; an unknown tier is not
  (string=? tier "sla"))

;; --- tests: answers produced by kotobase.federation on 2026-10-09 -----------

(defn- pass [b :bool] :i64 (if b 1 0))
(defn- blk [] :bytes (bytes-from-vector-i64 (vector-i64 1 2 3 255)))
(defn- nonce [] :bytes (bytes-from-vector-i64 (vector-i64 9 9 9)))
(def proof "1401f268dd8495c1d63ed77d7849adde874024a82be660688ab97f73316b8471")

(defn test-salted-hash [] :i64
  (pass (and (string=? (salted-hash (blk) (nonce)) proof)
             (string=? (salted-hash (bytes-from-vector-i64 (vector-i64)) (bytes-from-vector-i64 (vector-i64 1)))
                       "4bf5122f344554c53bde2ebb8cd2b7e3d1600ad631c385a5d7cce23c7785459a"))))

(defn test-prove [] :i64
  (pass (and (string=? (prove true (blk) (nonce)) proof)
             (string=? (prove false (blk) (nonce)) ""))))

(defn test-verify [] :i64
  (pass (and (= 1 (verify true (blk) (nonce) "bafyA" true "bafyA" proof))
             (= 2 (verify true (blk) (nonce) "bafyA" true "bafyA" "00"))
             (= 3 (verify true (blk) (nonce) "bafyA" false "" ""))
             (= 4 (verify true (blk) (nonce) "bafyA" true "other" proof))
             (= 5 (verify false (blk) (nonce) "bafyA" true "bafyA" proof))
             ;; no replica AND no response: the replica check comes first
             (= 5 (verify false (blk) (nonce) "bafyA" false "" "")))))

(defn test-tiers [] :i64
  (pass (and (not (audit-required? "volatile")) (not (audit-required? "standard"))
             (audit-required? "sla") (not (audit-required? "unknown")))))

;; main: the number of test-* that pass (4 when all do).
(defn main [] :i64
  (+ (test-salted-hash) (test-prove) (test-verify) (test-tiers)))
