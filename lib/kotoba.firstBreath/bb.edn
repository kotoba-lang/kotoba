{;; Standalone babashka project for the first-breath cell (breath.cljk). Lets the
 ;; deployed cell run `kbb breath.cljk` on a mini with only this dir scp'd — the
 ;; sole dep is eth-crypto-clj (pure-Clojure Keccak-256 / secp256k1 / RFC-6979
 ;; ECDSA / EIP-155 / RLP); cheshire + babashka.http-client are built into bb.
 :paths ["."]
 :deps {com-junkawasaki/eth-crypto-clj
        {:git/url "https://github.com/com-junkawasaki/eth-crypto-clj"
         :git/sha "9208ecc09a32cf51627ed32eb417e4834f208324"}}}
