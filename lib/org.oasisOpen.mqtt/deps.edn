;; No dependencies. An MQTT control packet is a fixed header (packet type,
;; flags, a variable-length integer), a variable header of big-endian
;; integers and length-prefixed strings, and a payload — none of it needs
;; anything beyond core Clojure, and pulling in an MQTT client library to
;; write a codec would defeat the point, which is a codec this workspace's
;; other runtimes (cljs, nbb) can load without a JVM.
{:deps {
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}}
 :paths ["src"]
 :aliases
 {:test {:extra-paths ["test"]}
  :cljs {:extra-paths ["test"]}}}
