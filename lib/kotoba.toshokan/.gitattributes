* annex.backend=MD5E
**/.git* annex.largefiles=nothing

# Default: keep scripts/docs/journals in plain git (small, needed offline).
# text2git would annex only binary mime, but fulltext/*.txt is plain text —
# without an explicit path rule it would land in git history and bloat the
# repo (same trap as product-corpus corpus/*.edn). Path rules win.
* annex.largefiles=nothing

# Public-domain full text bodies (Project Gutenberg etc.). Annex → B2.
fulltext/** annex.largefiles=anything
