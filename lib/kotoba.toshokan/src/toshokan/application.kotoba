(ns toshokan.application
  (:export [main harvest-max-bytes harvest-max-records harvest-deadline-ms
            harvest-origin-admitted worker-fetch-admitted
            worker-scheduled-admitted test-harvest-bounds
            test-worker-lifecycle]))

;; Portable workflow policy. Hosts own physical I/O resources; this sealed
;; component owns lifecycle admission and finite limits.
(defn main [] 0)
(defn harvest-max-bytes [] :i64 2097152)
(defn harvest-max-records [] :i64 20)
(defn harvest-deadline-ms [] :i64 30000)

(defn harvest-origin-admitted [origin :string] :i64
  (string=? origin "https://ndlsearch.ndl.go.jp"))

(defn worker-fetch-admitted [method :string path :string] :i64
  (if (string=? method "GET")
    (if (string=? path "/health") 1
      (if (string=? path "/latest") 1 0))
    (if (string=? method "POST")
      (if (string=? path "/run") 1
        (if (string=? path "/effect") 1 0))
      0)))

(defn worker-scheduled-admitted [cron :string] :i64
  (string=? cron "17 4 * * *"))

(defn test-harvest-bounds [] :i64
  (if (= (harvest-max-bytes) 2097152)
    (if (= (harvest-max-records) 20)
      (= (harvest-deadline-ms) 30000) 0)
    0))

(defn test-worker-lifecycle [] :i64
  (if (= (worker-fetch-admitted "POST" "/run") 1)
    (if (= (worker-fetch-admitted "DELETE" "/run") 0)
      (= (worker-scheduled-admitted "17 4 * * *") 1) 0)
    0))
