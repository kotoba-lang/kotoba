(ns toshokan.ndl-parser
  (:export [main
            decode-record-data
            record-data
            bib-count
            bib-about
            bib-title
            creator-count
            creator-name
            publisher-count
            publisher-name
            issued
            ndc
            extent
            test-decodes-record-data
            test-reads-sru-record-data
            test-extracts-bibliographic-fields
            test-counts-repeated-fields]))

(defn main [] 0)

;; NDL SRU uses recordPacking=string, so RDF/XML is entity-escaped once inside
;; recordData. Ampersand is deliberately decoded last.
(defn decode-record-data [encoded :string] :string
  (string-replace-all
   (string-replace-all
    (string-replace-all
     (string-replace-all
      (string-replace-all encoded "&lt;" "<")
      "&gt;" ">")
     "&quot;" "\"")
    "&apos;" "'")
   "&amp;" "&"))

(defn- decode-field-text [encoded :string] :string
  (decode-record-data encoded))

(defn- decode-field [value [:option :string]] [:option :string]
  (match-option value [:option :string]
    (none (option-none-of [:option :string]))
    (some text
      (option-some-of [:option :string] (decode-field-text text)))))

(defn record-data [sru :string index :i64] [:option :string]
  (match-option (xml-name-text sru "recordData" index) [:option :string]
    (none (option-none-of [:option :string]))
    (some encoded
      (option-some-of [:option :string] (decode-record-data encoded)))))

(defn bib-count [rdf :string] :i64
  (xml-name-count rdf "dcndl:BibResource"))

(defn bib-about [rdf :string index :i64] [:option :string]
  (xml-path-attr rdf "rdf:RDF/dcndl:BibResource" index "rdf:about"))

(defn bib-title [rdf :string index :i64] [:option :string]
  (decode-field
   (xml-path-text rdf
     "rdf:RDF/dcndl:BibResource/dcterms:title" index)))

(defn creator-count [rdf :string] :i64
  (xml-path-count rdf
    "rdf:RDF/dcndl:BibResource/dcterms:creator/foaf:Agent/foaf:name"))

(defn creator-name [rdf :string index :i64] [:option :string]
  (decode-field
   (xml-path-text rdf
     "rdf:RDF/dcndl:BibResource/dcterms:creator/foaf:Agent/foaf:name" index)))

(defn publisher-count [rdf :string] :i64
  (xml-path-count rdf
    "rdf:RDF/dcndl:BibResource/dcterms:publisher/foaf:Agent/foaf:name"))

(defn publisher-name [rdf :string index :i64] [:option :string]
  (decode-field
   (xml-path-text rdf
     "rdf:RDF/dcndl:BibResource/dcterms:publisher/foaf:Agent/foaf:name" index)))

(defn issued [rdf :string index :i64] [:option :string]
  (decode-field
   (xml-path-text rdf
     "rdf:RDF/dcndl:BibResource/dcterms:issued" index)))

(defn ndc [rdf :string index :i64] [:option :string]
  (decode-field
   (xml-path-text rdf
     "rdf:RDF/dcndl:BibResource/dc:subject" index)))

(defn extent [rdf :string index :i64] [:option :string]
  (decode-field
   (xml-path-text rdf
     "rdf:RDF/dcndl:BibResource/dcterms:extent" index)))

(defn test-decodes-record-data [] :i64
  (string=? (decode-record-data
              "&lt;rdf:RDF&gt;&lt;dcterms:title&gt;Kotoba &amp;amp; CLJ&lt;/dcterms:title&gt;&lt;/rdf:RDF&gt;")
            "<rdf:RDF><dcterms:title>Kotoba &amp; CLJ</dcterms:title></rdf:RDF>"))

(defn test-reads-sru-record-data [] :i64
  (string=?
   (option-value-of [:option :string]
     (record-data
      "<searchRetrieveResponse><records><record><recordData>&lt;rdf:RDF&gt;&lt;dcterms:title&gt;Kotoba&lt;/dcterms:title&gt;&lt;/rdf:RDF&gt;</recordData></record></records></searchRetrieveResponse>"
      0)
     "")
   "<rdf:RDF><dcterms:title>Kotoba</dcterms:title></rdf:RDF>"))

(defn test-extracts-bibliographic-fields [] :i64
  (let [rdf "<rdf:RDF><dcndl:BibResource rdf:about=\"https://ndl/books/R1#material\"><dcterms:title>ことば</dcterms:title><dcterms:issued>2026</dcterms:issued></dcndl:BibResource></rdf:RDF>"]
    (if (= (bib-count rdf) 1)
      (if (string=? (option-value-of [:option :string] (bib-about rdf 0) "")
                    "https://ndl/books/R1#material")
        (string=? (option-value-of [:option :string] (bib-title rdf 0) "")
                  "ことば")
        0)
      0)))

(defn test-counts-repeated-fields [] :i64
  (let [rdf "<rdf:RDF><dcndl:BibResource><dcterms:creator><foaf:Agent><foaf:name>A</foaf:name></foaf:Agent></dcterms:creator><dcterms:creator><foaf:Agent><foaf:name>B</foaf:name></foaf:Agent></dcterms:creator><dcterms:publisher><foaf:Agent><foaf:name>P</foaf:name></foaf:Agent></dcterms:publisher></dcndl:BibResource></rdf:RDF>"]
    (if (= (creator-count rdf) 2)
      (if (string=? (option-value-of [:option :string] (creator-name rdf 1) "") "B")
        (= (publisher-count rdf) 1)
        0)
      0)))
