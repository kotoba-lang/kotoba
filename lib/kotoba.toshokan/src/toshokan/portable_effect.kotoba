(ns toshokan.portable-effect
  (:export [main
            ndl-scope-admitted
            ndl-limits-admitted
            test-admits-ndl
            test-denies-broader-limit
            test-denies-other-provider]))

;; This is the portable semantic policy. Hosts still own physical I/O,
;; credentials, timeouts, byte accounting, and the final URL check.
(defn main [] 0)

(defn ndl-scope-admitted [resource :string
                          target :string
                          operation :string] :i64
  (if (string=? resource "library:ndl")
    (if (string=? target "toshokan/http")
      (if (string=? operation "get") 1 0)
      0)
    0))

(defn ndl-limits-admitted [max-bytes :i64
                           max-items :i64
                           deadline-ms :i64] :i64
  (if (> max-bytes 0)
    (if (<= max-bytes 2097152)
      (if (> max-items 0)
        (if (<= max-items 20)
          (if (> deadline-ms 0)
            (if (<= deadline-ms 30000) 1 0)
            0)
          0)
        0)
      0)
    0))

;; Tests are ordinary, content-addressed Kotoba definitions, in the Unison
;; style. `kotoba test` discovers exported zero-arity `test-*` functions and
;; executes this one definition on KIR/JVM, restricted ESM, and Wasm.
(defn test-admits-ndl [] :i64
  (if (= (ndl-scope-admitted "library:ndl" "toshokan/http" "get") 1)
    (= (ndl-limits-admitted 2097152 20 30000) 1)
    0))

(defn test-denies-broader-limit [] :i64
  (= (ndl-limits-admitted 2097152 21 30000) 0))

(defn test-denies-other-provider [] :i64
  (= (ndl-scope-admitted "library:ndl" "attacker/http" "get") 0))
