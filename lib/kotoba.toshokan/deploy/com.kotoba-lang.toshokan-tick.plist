<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.kotoba-lang.toshokan-tick</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/nbb</string>
    <string>/Users/junkawasaki/.gftd/run-toshokan-tick.cljs</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>GIT_SSH_COMMAND</key>
    <string>/usr/bin/ssh</string>
    <key>GIT_TERMINAL_PROMPT</key>
    <string>0</string>
    <key>TOSHOKAN_ROOT</key>
    <string>/Users/junkawasaki/github/com-junkawasaki/orgs/kotoba-lang/toshokan</string>
    <key>KOTOBASE_CLIENT_SRC</key>
    <string>/Users/junkawasaki/github/com-junkawasaki/orgs/kotoba-lang/kotobase-client/src</string>
    <key>NODE_PATH</key>
    <string>/Users/junkawasaki/github/com-junkawasaki/orgs/kotoba-lang/kotobase-client/node_modules:/Users/junkawasaki/github/com-junkawasaki/orgs/kotoba-lang/toshokan/node_modules</string>
  </dict>
  <!-- 6h — library APIs are not realtime; polite cadence matches product-corpus / fleet-ci -->
  <key>StartInterval</key>
  <integer>21600</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/junkawasaki/.gftd/toshokan-tick.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/junkawasaki/.gftd/toshokan-tick.stdout.log</string>
  <key>WorkingDirectory</key>
  <string>/Users/junkawasaki/github/com-junkawasaki/orgs/kotoba-lang/toshokan</string>
</dict>
</plist>
