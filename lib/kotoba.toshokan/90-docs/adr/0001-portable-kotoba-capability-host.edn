{:adr/id "0001"
 :adr/title "Portable Kotoba capability host for Toshokan"
 :adr/status :accepted-partially-implemented
 :adr/date "2026-07-26"
 :adr/scope :ndl-vertical-slice
 :decision
 {:authoritative-sources
  ["src/toshokan/application.kotoba"
   "src/toshokan/portable_effect.kotoba"
   "src/toshokan/ndl_parser.kotoba"
   "toshokan.host.edn"]
  :application
  {:semantics :kotoba
   :tests :exported-test-definitions
   :test-executions [:kir-jvm :restricted-esm :wasm]
   :worker-lifecycle [:fetch :scheduled]
   :generated-entry "workerd/generated/host/worker.mjs"}
  :capability-abi
  {:task {:kind :linear-resource :states [:pending :ready :cancelled]}
   :stream-bytes
   {:kind :bounded-linear-resource
    :max-pull-bytes 65536
    :operations [:read :cancel]}
   :http [:get-stream]
   :object-store [:get-stream :put-block :compare-and-set-ref]}
  :large-values
  {:scalar-limit-bytes 65536
   :response-limit-bytes 2097152
   :block-bytes 32768
   :manifest :kotoba.chunk-manifest/v1
   :addressing :sha-256
   :rule "Parse bounded frames; never materialize a dataset at the guest ABI."}
  :kotobase
  {:storage :capability-abi
   :immutable-write-order :blocks-before-ref
   :mutable-ref :etag-compare-and-set
   :receipt [:committed-cid :pull-read-back]}
  :host-boundary
  {:ambient-env-exposed? false
   :ambient-fetch-exposed? false
   :responsibilities
   [:physical-io :credentials :deadline :byte-accounting
    :url-validation :receipts]}}
 :deployment
 {:service "murakumo-toshokan"
  :url "https://toshokan.murakumo.cloud"
  :cron "17 4 * * *"
  :object-store "murakumo-toshokan"
  :public-routes [["GET" "/health"] ["GET" "/latest"]]
  :protected-routes [["POST" "/run"] ["POST" "/effect"]]}
 :invariants
 ["An endpoint string is not authority."
  "Every operation requires admitted capability, scope, limits, provider, and boundary validation."
  "Generated JavaScript and Wasm are artifacts; Kotoba and EDN are authoritative."
  "The 65536-byte bound applies to one scalar or stream pull, not a whole dataset."]
 :migration
 {:legacy-cljs
  {:status :incremental
   :order [:ndl :loc :dnb :bnf :kb-nl :libris-se :nb-no :iccu-it
           :korea-nl]
   :removal-condition "Kotoba fixture and live smoke parity for each parser"}
  :markdown-authority? false}}
