{:paths ["src"]
 ;; kotobase (kotoba-lang/kotobase) provides the IStore seam
 ;; (kotobase.store) kotobase.bitcoin.transport persists synced headers
 ;; through. Pinned to the same SHA kotobase-protocols/org-ietf-sftp's own
 ;; deps.edn use (verified current against kotobase's default-branch HEAD
 ;; on 2026-07-17 -- same commit, no drift).
 ;;
 ;; sha256d (kotoba-lang/sha256d) provides the actual SHA-256 / Bitcoin
 ;; SHA-256d digest (kotobase.bitcoin.protocol does not reimplement it) --
 ;; a portable .cljc reference implementation already verified against the
 ;; real Bitcoin genesis block on both JVM and V8.
 :deps {
        io.github.kotoba-lang/bytes {:local/root "../kotoba.bytes"}
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}
        io.github.kotoba-lang/kotobase
        {:git/sha "bbf57df9dde5c1869182012860129a598382e088"}
        io.github.kotoba-lang/sha256d {:local/root "../kotoba.sha256d"}}
 ;; First-class runtime is nbb/cljs (repo-wide runtime priority):
 ;;   kbb --backend sci --classpath "src:test:<kotobase>/src:<sha256d>/src" bin/run_tests.cljk
 ;; The :test alias below is the :clj COMPAT suite for the pure `.cljc`
 ;; core (kotobase.bitcoin.protocol) only -- it never loads anything under
 ;; src/kotobase/bitcoin/transport.cljk (.cljs-only, node:net, cannot run
 ;; on the JVM at all).
 :aliases
 {:test {:extra-paths ["test"]}}}
