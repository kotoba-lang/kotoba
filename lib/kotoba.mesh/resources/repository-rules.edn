{:schema "kotoba.repository-role-rules.v0"
 :this-repo
 {:name "mesh"
  :tier :t3
  :role :runtime
  :must-not [:compile-language-semantics :grant-placement-authority]
  :depends-on ["kotoba-lang/kotoba"
               ;; The KIR interpreter is a RUNTIME dependency, not a build one:
               ;; `kotoba.mesh.kotoba-oracle` calls `kotoba.kir/execute` on
               ;; every classification. deps.edn has said so since the shipped
               ;; decision core landed; this declaration had not caught up.
               ;; Depending on a :contract from a :runtime is an allowed edge.
               "kotoba-lang/kotoba-kir"
               "kotoba-lang/kotoba-selfhost-contracts"]}}
