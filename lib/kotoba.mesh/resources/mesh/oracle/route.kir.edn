{:format :kotoba.kir/v4,
 :signature nil,
 :functions
 [{:name mesh-prefix,
   :params [],
   :result :string,
   :effects #{},
   :body "/mesh/http/",
   :param-types []}
  {:name request-kind,
   :params [method path],
   :result :keyword,
   :effects #{},
   :body
   (if
    (string=? method "GET")
    (if (string=? path "/health") :health :unknown)
    (if
     (string=? method "POST")
     (if
      (< (string-byte-length path) (string-byte-length (mesh-prefix)))
      :unknown
      (if
       (string=?
        (string-substring path 0 (string-byte-length (mesh-prefix)))
        (mesh-prefix))
       :mesh-dispatch
       :unknown))
     :unknown)),
   :param-types [:string :string]}
  {:name mesh-route-name,
   :params [path],
   :result :string,
   :effects #{},
   :body
   (string-substring
    path
    (string-byte-length (mesh-prefix))
    (string-byte-length path)),
   :param-types [:string]}
  {:name answer?,
   :params [written],
   :result :bool,
   :effects #{},
   :body (if (> written 0) true false),
   :param-types [:i64]}
  {:name outcome,
   :params [kind bound? answered?],
   :result :keyword,
   :effects #{},
   :body
   (if
    (= kind :health)
    :health-ok
    (if
     (= kind :mesh-dispatch)
     (if bound? (if answered? :answer :no-answer) :route-not-bound)
     :not-found)),
   :param-types [:keyword :bool :bool]}
  {:name status-for,
   :params [outcome],
   :result :i64,
   :effects #{},
   :body
   (if
    (= outcome :no-answer)
    204
    (if
     (= outcome :route-not-bound)
     404
     (if (= outcome :not-found) 404 200))),
   :param-types [:keyword]}],
 :oracle-value nil,
 :schema-identities nil,
 :exports [request-kind mesh-route-name answer? outcome status-for],
 :schemas nil,
 :effects #{},
 :blocks [],
 :entry nil}
