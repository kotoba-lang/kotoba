;; route.kotoba -- the murakumo -> node HTTP contract, as the thing that runs.
;;
;; This repository's stated role is "route compilation/admission at startup,
;; HTTP serving, and runtime dispatch" (README, resources/repository-rules.edn
;; :role :runtime). The URL shapes below ARE that contract: which requests this
;; node recognises, and what status each outcome gets. They used to live in the
;; `cond` inside `kotoba.mesh.node/handler`; they live here now, and
;; `handler` asks.
;;
;; What deliberately did NOT move, and why: the route table (a map that grows
;; with the deployment), the Chicory dispatch (an effect), and reading the
;; guest's answer out of wasm memory. ADR-2608112100 measured the boundary --
;; a core handed one decision's worth of data delegates, a core holding a
;; collection whose size grows with the domain does not (mokuroku's catalog was
;; refused at 13 items). So `outcome` is handed a BOOLEAN saying whether the
;; route was bound, not the table it was looked up in: this core sees the same
;; four scalars whether the node serves one route or ten thousand.
;;
;; The three .kotoba files in examples/ are not cores and are not compiled by
;; this seam -- they are guest PAYLOADS that a mesh node compiles at startup and
;; serves. See the note in `kotoba.mesh.kotoba-oracle`.

(ns kotoba.mesh.route
  (:export [request-kind mesh-route-name answer? outcome status-for]))

(defn mesh-prefix
  []
  :string
  "/mesh/http/")

(defn request-kind
  "Which endpoint (method, path) names: :health, :mesh-dispatch, or :unknown.

  :unknown covers both `GET /nope` and `POST /health` -- a method/path pair
  this node does not serve is one thing, not two."
  [method :string path :string]
  :keyword
  (if (string=? method "GET")
    (if (string=? path "/health") :health :unknown)
    (if (string=? method "POST")
      ;; The length guard is not defensive noise: `string-substring` past the
      ;; end throws, so a short path like "/me" has to be answered before the
      ;; prefix comparison, not by it.
      (if (< (string-length path) (string-length (mesh-prefix)))
        :unknown
        (if (string=? (string-substring path 0 (string-length (mesh-prefix)))
                      (mesh-prefix))
          :mesh-dispatch
          :unknown))
      :unknown)))

(defn mesh-route-name
  "The <route> segment of /mesh/http/<route>.

  Here rather than in the host so the prefix is written once. A host that did
  its own `(subs path (count \"/mesh/http/\"))` would be a second copy of the
  URL shape, and the copy is what drifts. Only meaningful when `request-kind`
  said :mesh-dispatch; the caller has already asked."
  [path :string]
  :string
  (string-substring path (string-length (mesh-prefix)) (string-length path)))

(defn answer?
  "Whether a guest that ran has anything to answer with.

  `dispatch` gets back the number of bytes the guest wrote into its
  `kgraph_query` buffer; an assert-only guest never queried and wrote none.
  That `0 means no answer` is the rule the 204 rests on, so it belongs with the
  204 rather than next to the `aget` that produced the count."
  [written :i64]
  :bool
  (if (> written 0) true false))

(defn outcome
  "What happened, from the request kind and the two facts only the host can
  learn: whether the named route was bound, and whether the guest it ran had
  anything to answer with.

  :route-not-bound and :not-found are both 404s and are deliberately distinct
  -- an unbound route on a served URL shape is a different fact from a URL
  shape this node does not serve, and `node-test` has pinned that difference
  since before any of this moved."
  [kind :keyword bound? :bool answered? :bool]
  :keyword
  (if (= kind :health)
    :health-ok
    (if (= kind :mesh-dispatch)
      (if bound?
        (if answered? :answer :no-answer)
        :route-not-bound)
      :not-found)))

(defn status-for
  "The HTTP status an outcome gets.

  :no-answer is 204 rather than 200 because a guest that ran and never queried
  succeeded -- it just has no body. That is the distinction
  `mesh_no_answer.kotoba` exists to exercise."
  [outcome :keyword]
  :i64
  (if (= outcome :no-answer)
    204
    (if (= outcome :route-not-bound)
      404
      (if (= outcome :not-found)
        404
        200))))
