// sample.dot — a small labelled digraph used by dot_test.cljc
strict digraph pipeline {
  rankdir=LR;

  // nodes
  source [shape=box, label="Source"];
  transform [shape=ellipse, label="Transform"];
  sink [shape=box, label="Sink"];
  audit [shape=diamond];

  // edges
  source -> transform [label="raw"];
  transform -> sink [label="clean"];
  transform -> audit [label="log"];
}
