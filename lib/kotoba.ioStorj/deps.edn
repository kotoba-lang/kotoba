;; AWS SigV4 lives in kotoba-lang/sigv4 — this workspace had six copies of it
;; before that library existed, and they had already diverged (see its README,
;; which also records why the count was first reported as eight).
;; No other runtime dependency: SHA-256 and HMAC are on every target runtime
;; already, so an AWS SDK would trade a portable library for a JVM-or-Node-only
;; one. See README "Why no AWS SDK".
{:paths ["src"]
 :deps {
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}
        io.github.kotoba-lang/sigv4 {:local/root "../kotoba.sigv4"}
        io.github.kotoba-lang/bytes {:local/root "../kotoba.bytes"}}
 :aliases
 {:test {:extra-paths ["test"]}}}
