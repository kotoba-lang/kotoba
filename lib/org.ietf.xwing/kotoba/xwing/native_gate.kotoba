(defn group-a [] :i64
  (+ (if (same? (xw/public-key (g-0-seed)) (g-0-pk)) 1 0)
     (if (same? (xw/encapsulate (g-0-pk) (g-0-eseed)) (cat (g-0-ss) (g-0-ct))) 2 0)
     (if (same? (xw/decapsulate (g-0-seed) (g-0-ct)) (g-0-ss)) 4 0)))

(defn group-b [] :i64
  (+ (if (same? (xw/public-key (g-1-seed)) (g-1-pk)) 1 0)
     (if (same? (xw/encapsulate (g-1-pk) (g-1-eseed)) (cat (g-1-ss) (g-1-ct))) 2 0)
     (if (same? (xw/decapsulate (g-1-seed) (g-1-ct)) (g-1-ss)) 4 0)))

(defn group-c [] :i64
  (+ (if (same? (xw/public-key (g-2-seed)) (g-2-pk)) 1 0)
     (if (same? (xw/encapsulate (g-2-pk) (g-2-eseed)) (cat (g-2-ss) (g-2-ct))) 2 0)
     (if (same? (xw/decapsulate (g-2-seed) (g-2-ct)) (g-2-ss)) 4 0)
     (if (g-other? (xw/decapsulate (g-2-seed) (g-flip (g-2-ct) 100)) (g-2-ss)) 8 0)
     (if (g-other? (xw/decapsulate (g-2-seed) (g-flip (g-2-ct) 1100)) (g-2-ss)) 16 0)
     (if (and (g-empty? (xw/public-key (g-slice (g-2-seed) 0 31)))
              (g-empty? (xw/encapsulate (g-slice (g-2-pk) 0 1215) (g-2-eseed)))
              (g-empty? (xw/encapsulate (g-2-pk) (g-slice (g-2-eseed) 0 63)))
              (g-empty? (xw/encapsulate (g-2-pk) (g-set (g-2-eseed) 0 256)))
              (g-empty? (xw/decapsulate (g-2-seed) (g-slice (g-2-ct) 0 1119)))
              (g-empty? (xw/decapsulate (g-set (g-2-seed) 3 -1) (g-2-ct)))) 32 0)))
