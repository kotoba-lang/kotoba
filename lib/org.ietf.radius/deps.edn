;; RADIUS (RFC 2865/2866) is a flat Type-Length-Value wire format, not
;; ASN.1 — there is no BER/DER layer to reuse from org-ietf-asn1 here, only
;; a header, attribute TLVs, and MD5. No workspace-search hit for a shared
;; MD5 library at the time this was written (`kbb --backend sci scripts/repo-search.cljk
;; md5 hash digest`), so MD5 lives in this repo as `radius.md5`, self-
;; contained and RFC-1321-test-vector-verified; see the README for why it
;; may be worth extracting later.
{:paths ["src"]
 :deps {
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}}
 :aliases
 {:test {:extra-paths ["test"]}
  :cljs {:extra-paths ["test"]}}}
