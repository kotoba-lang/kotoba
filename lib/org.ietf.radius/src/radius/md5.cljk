(ns radius.md5
  "[RFC 1321](https://www.rfc-editor.org/rfc/rfc1321) MD5, self-contained.

  RADIUS needs MD5 for two things (`radius.auth`): the Response/Accounting-
  Request Authenticator, and hiding the User-Password attribute. Neither
  RADIUS RFC re-specifies MD5 — both just say \"MD5\" and point at RFC 1321
  — so this namespace implements RFC 1321 directly rather than half-writing
  it inline in `radius.auth`. No shared MD5 library existed in this
  workspace at the time this was written
  (`kbb --backend sci scripts/repo-search.cljk md5 hash digest`, `org-nist-sha2` is
  SHA-2, not MD5); this is arguably worth extracting into its own
  `org-ietf-md5` (or similar) repo later, but RADIUS is the only known
  consumer today so it stays here per the instructions of the task that
  created it.

  MD5 is cryptographically broken as a general-purpose hash (collisions are
  practical) — it is implemented here ONLY because RFC 2865/2866 mandate it
  for wire compatibility with 25+ years of deployed RADIUS. Do not reuse
  this for anything that needs collision resistance.

  ## The algorithm, in the order RFC 1321 §3 presents it

  1. **Pad** the message: append a single `1` bit (`0x80` byte, since MD5
     only ever operates byte-aligned), then `0` bytes until the length in
     bytes is ≡ 56 (mod 64), then the ORIGINAL bit-length as a 64-bit
     **little-endian** integer (§3.1/§3.2). MD5 is little-endian
     throughout — both here and in how each 64-byte block becomes sixteen
     32-bit words (§3.3) — which is the opposite of SHA-2/SHA-1's
     big-endian and the single easiest thing to get backwards when porting
     between them.
  2. **Four auxiliary functions** (§3.4): `F(X,Y,Z)=(X∧Y)∨(¬X∧Z)`,
     `G(X,Y,Z)=(X∧Z)∨(Y∧¬Z)`, `H(X,Y,Z)=X⊕Y⊕Z`, `I(X,Y,Z)=Y⊕(X∨¬Z)`.
  3. **T[1..64]**, `floor(2^32 × |sin(i)|)` for `i` in 1..64, radians (§3.4,
     literally — RFC 1321 defines the constant table by this formula
     rather than by listing 64 hex numbers to transcribe by hand). Computed
     here at load time with `Math/sin`/`js/Math.sin` rather than hardcoded,
     which is not a shortcut — it is the RFC's own definition — and it is
     self-checking: if double-precision `sin` disagreed between the JVM and
     JS enough to change the floor, every test vector below would fail.
  4. **Four rounds of 16 operations each** (§3.4),64 total, each round using
     one of F/G/H/I, a per-operation left-rotate amount, and one T[i].
  5. **Initial state** `(A,B,C,D) = (0x67452301, 0xefcdab89, 0x98badcfe,
     0x10325476)` (§3.3), updated by addition mod 2^32 after every block.

  The 64-step main loop below follows the widely-used single-loop form
  (message-word index `g` and shift amount `s` computed per step rather
  than unrolled into four hand-written rounds) — this is an equivalent
  restatement of RFC 1321 §3.4's four separate rounds, not a different
  algorithm; the two forms are checked against each other implicitly by
  every test vector in `test/radius/md5_test.cljk` matching RFC 1321
  Appendix A.5.")

;; ── 32-bit arithmetic ────────────────────────────────────────────────────

(defn- add32
  "Sum mod 2^32 — MD5's addition is modular throughout, and every one of
  its four rounds relies on the wraparound (that is what makes it a
  compression function instead of just getting bigger)."
  [& xs]
  (bit-and (apply + xs) 0xffffffff))

(defn- rotl32
  "32-bit left-rotate. Getting `n` and `32-n` backwards here is the classic
  way to build something that still produces *a* 128-bit value and is not
  MD5 — silently, since nothing about the shape of the output would look
  wrong."
  [x n]
  (bit-and (bit-or (bit-shift-left x n) (unsigned-bit-shift-right x (- 32 n)))
           0xffffffff))

;; ── constants (RFC 1321 §3.3/§3.4) ──────────────────────────────────────────

(def ^:private init-state [0x67452301 0xefcdab89 0x98badcfe 0x10325476])

;; Per-step left-rotate amounts, one per round (repeated 4×), §3.4 exactly.
(def ^:private shift-amounts
  (vec (mapcat #(apply concat (repeat 4 %))
               [[7 12 17 22] [5 9 14 20] [4 11 16 23] [6 10 15 21]])))

;; T[i] = floor(2^32 * |sin(i)|), i = 1..64, i in radians — RFC 1321 §3.4's
;; own definition of the table, computed rather than transcribed.
(def ^:private T
  (vec (for [i (range 1 65)]
         (bit-and
          #?(:clj (long (Math/floor (* 4294967296.0 (Math/abs (Math/sin (double i))))))
             :cljs (js/Math.floor (* 4294967296.0 (js/Math.abs (js/Math.sin i)))))
          0xffffffff))))

;; ── padding & word packing ───────────────────────────────────────────────

(defn- pad
  "The padded, byte-aligned message as a vector of ints — §3.1/§3.2. `bs` is
  a vector of 0–255 ints, following the same byte-like convention this
  workspace's other wire codecs use (e.g. `org-ietf-asn1`'s `->ints`)."
  [bs]
  (let [len-bits (* 8 (count bs))
        with-marker (conj (vec bs) 0x80)
        zero-pad (mod (- 56 (mod (count with-marker) 64)) 64)
        len-bytes (mapv (fn [i] (bit-and (unsigned-bit-shift-right len-bits (* 8 i)) 0xff))
                        (range 8))] ; little-endian, low byte first
    (into (into with-marker (repeat zero-pad 0)) len-bytes)))

(defn- block->words
  "One 64-byte block as sixteen 32-bit little-endian words — §3.3's `X[j]`,
  the opposite byte order from SHA-2's big-endian word packing."
  [block]
  (mapv (fn [w]
          (let [o (* w 4)]
            (bit-or (nth block o)
                    (bit-shift-left (nth block (+ o 1)) 8)
                    (bit-shift-left (nth block (+ o 2)) 16)
                    (bit-shift-left (nth block (+ o 3)) 24))))
        (range 16)))

;; ── the 64-step compression function ────────────────────────────────────

(defn- step
  "One of the 64 operations, §3.4. `round` is 0–3 (F/G/H/I in order);
  `msg-index` (`g` in most published pseudocode) and the per-round
  auxiliary function both depend only on `round` and the position `i`
  within it."
  [round i [a b c d] words]
  (let [f (case round
            0 (bit-or (bit-and b c) (bit-and (bit-not b) d))
            1 (bit-or (bit-and b d) (bit-and c (bit-not d)))
            2 (bit-xor b c d)
            3 (bit-xor c (bit-or b (bit-not d))))
        g (case round
            0 i
            1 (mod (+ (* 5 i) 1) 16)
            2 (mod (+ (* 3 i) 5) 16)
            3 (mod (* 7 i) 16))
        step-n (+ (* round 16) i)
        f' (add32 (bit-and f 0xffffffff) a (nth T step-n) (nth words g))]
    [d (add32 b (rotl32 f' (nth shift-amounts step-n))) b c]))

(defn- process-block [state block]
  (let [words (block->words block)
        [a' b' c' d'] (reduce (fn [abcd n] (step (quot n 16) (mod n 16) abcd words))
                              state (range 64))]
    (mapv add32 state [a' b' c' d'])))

;; ── public API ───────────────────────────────────────────────────────────

(defn md5-ints
  "MD5 of `bs` (a vector of 0–255 ints) as sixteen 0–255 ints — the raw
  digest bytes, in the order they go on the wire (each 32-bit state word
  little-endian, per §3.5's \"low-order byte of A\" first)."
  [bs]
  (let [padded (pad (vec bs))
        blocks (partition 64 padded)
        state (reduce process-block init-state blocks)]
    (vec (mapcat (fn [w] [(bit-and w 0xff)
                          (bit-and (unsigned-bit-shift-right w 8) 0xff)
                          (bit-and (unsigned-bit-shift-right w 16) 0xff)
                          (bit-and (unsigned-bit-shift-right w 24) 0xff)])
                 state))))

(defn- hex-byte [b]
  (let [s #?(:clj (Integer/toHexString (bit-and b 0xff))
             :cljs (.toString (bit-and b 0xff) 16))]
    (if (= 1 (count s)) (str "0" s) s)))

(defn md5-hex
  "MD5 of `bs` as 32 lowercase hex characters — RFC 1321 Appendix A.5's
  presentation form."
  [bs]
  (apply str (map hex-byte (md5-ints bs))))

(defn ascii-ints
  "An ASCII string as a vector of ints, for feeding `md5-ints`/`md5-hex` the
  RFC 1321 Appendix A.5 test strings without a platform-specific encoder."
  [s]
  (mapv int s))
