(ns radius.attribute-test
  (:require [kotoba.test :refer [deftest is testing]]
            [radius.attribute :as attr]))

(deftest attribute-round-trip
  (let [a {:radius/type 1 :radius/value [104 105]}] ; "hi"
    (is (= [:ok a 4] (attr/decode-attribute-at (attr/encode-attribute a) 0)))))

(deftest attribute-list-round-trip
  (let [as [{:radius/type 1 :radius/value [1 2 3]}
            {:radius/type 4 :radius/value [192 168 1 1]}]]
    (is (= [:ok as] (attr/decode-attributes (attr/encode-attributes as))))))

(deftest zero-length-value-round-trip
  ;; Length=2 (Type+Length only) is the minimum — an attribute with no
  ;; value at all is still well-formed per RFC 2865 §5 ("The Value field is
  ;; zero or more octets").
  (let [a {:radius/type 9 :radius/value []}]
    (is (= [:ok a 2] (attr/decode-attribute-at (attr/encode-attribute a) 0)))))

;; ── Vendor-Specific (RFC 2865 §5.26) ────────────────────────────────────

(deftest vendor-specific-round-trip
  (let [subs [{:radius/vendor-type 1 :radius/value [104 105]}]]
    (let [wire (attr/encode-vendor-specific 9 subs)]
      (is (= [:ok {:radius/type 26 :radius/value (subvec wire 2)} (count wire)]
             (attr/decode-attribute-at wire 0)))
      (let [[status a] (attr/decode-attribute-at wire 0)]
        (is (= [:ok {:radius/vendor-id 9 :radius/sub-attributes subs}]
               (attr/decode-vendor-specific a)))))))

;; ── negative paths ──────────────────────────────────────────────────────

(deftest negative-attribute-shapes
  (testing "Length octet claims less than the 2-byte header itself"
    (is (= [:error :radius/bad-attribute-length]
           (attr/decode-attribute-at [1 1] 0))))
  (testing "Length claims more bytes than are present"
    (is (= [:error :radius/truncated-attribute]
           (attr/decode-attribute-at [1 10 1 2 3] 0))))
  (testing "not even a Type/Length pair present"
    (is (= [:error :radius/truncated-attribute] (attr/decode-attribute-at [1] 0)))))

(deftest negative-encode-too-long
  (is (thrown? #?(:clj Exception :cljs js/Error)
               (attr/encode-attribute {:radius/type 1 :radius/value (vec (repeat 254 0))}))))

(deftest negative-vendor-specific-shapes
  (testing "not type 26"
    (is (= [:error :radius/not-vendor-specific]
           (attr/decode-vendor-specific {:radius/type 1 :radius/value [1 2 3 4 5]}))))
  (testing "too short for even a Vendor-Id"
    (is (= [:error :radius/truncated-vendor-attribute]
           (attr/decode-vendor-specific {:radius/type 26 :radius/value [1 2 3]}))))
  (testing "sub-attribute Length runs past the end"
    (is (= [:error :radius/truncated-vendor-attribute]
           (attr/decode-vendor-specific
            {:radius/type 26 :radius/value [0 0 0 9 1 10 1]})))))
