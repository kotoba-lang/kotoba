(ns radius.md5-test
  "RFC 1321 Appendix A.5's full test suite — fetched and quoted directly
  from the RFC text before being used here (not recalled from training),
  and the same 32-hex-char digests as the task's own two seed vectors
  (`\"\"` and `\"abc\"`). Published spec vectors, not constructed ones."
  (:require [kotoba.test :refer [deftest is]]
            [radius.md5 :as md5]))

(deftest rfc1321-appendix-a5-test-suite
  (is (= "d41d8cd98f00b204e9800998ecf8427e" (md5/md5-hex [])))
  (is (= "0cc175b9c0f1b6a831c399e269772661" (md5/md5-hex (md5/ascii-ints "a"))))
  (is (= "900150983cd24fb0d6963f7d28e17f72" (md5/md5-hex (md5/ascii-ints "abc"))))
  (is (= "f96b697d7cb7938d525a2f31aaf161d0"
         (md5/md5-hex (md5/ascii-ints "message digest"))))
  (is (= "c3fcd3d76192e4007dfb496cca67e13b"
         (md5/md5-hex (md5/ascii-ints "abcdefghijklmnopqrstuvwxyz"))))
  (is (= "d174ab98d277d9f5a5611c2c9f419d9f"
         (md5/md5-hex (md5/ascii-ints "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789"))))
  (is (= "57edf4a22be3c955ac49da2e2107b67a"
         (md5/md5-hex
          (md5/ascii-ints
           "12345678901234567890123456789012345678901234567890123456789012345678901234567890")))))

(deftest md5-ints-and-md5-hex-agree
  (is (= "900150983cd24fb0d6963f7d28e17f72"
         (apply str (map #(let [s #?(:clj (Integer/toHexString %) :cljs (.toString % 16))]
                             (if (= 1 (count s)) (str "0" s) s))
                          (md5/md5-ints (md5/ascii-ints "abc")))))))

;; ── negative path: this namespace has none of its own (MD5 has no
;; malformed-input concept — every byte vector is a valid message) — the
;; wire-format negative tests live in radius.packet-test / radius.attribute-
;; test / radius.auth-test.
