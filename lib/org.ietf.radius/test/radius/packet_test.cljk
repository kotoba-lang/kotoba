(ns radius.packet-test
  (:require [kotoba.test :refer [deftest is testing]]
            [radius.bytes :as b]
            [radius.packet :as packet]))

(def ^:private ra (vec (range 1 17))) ; 16 distinct octets, easy to eyeball in a diff

(def ^:private a-packet
  {:radius/code :access-request
   :radius/identifier 7
   :radius/authenticator ra
   :radius/attributes [{:radius/type 1 :radius/value (mapv int "bob")}]})

;; ── a full wire vector, computed by an independent from-scratch Python
;;    encoder (RFC 2865 has no worked byte example anywhere in the RFC
;;    text — checked directly against it before writing this test) ───────
;;
;;   01                          Code = Access-Request
;;   07                          Identifier = 7
;;   00 19                       Length = 25 (20 header + 5 attribute)
;;   01 02 03 04 05 06 07 08     Authenticator (16 octets, 1..16)
;;   09 0a 0b 0c 0d 0e 0f 10
;;   01 05 62 6f 62              Attribute: Type=1, Length=5, "bob"
(def ^:private a-packet-hex
  "010700190102030405060708090a0b0c0d0e0f100105626f62")

(deftest encode-matches-hand-derived-bytes
  (is (= (b/unhex a-packet-hex) (packet/encode-packet a-packet))))

(deftest packet-round-trip
  (is (= [:ok a-packet] (packet/decode-packet (packet/encode-packet a-packet)))))

(deftest round-trip-every-code
  (doseq [[code kw] packet/code-name]
    (testing (str code " " kw)
      (let [p {:radius/code kw :radius/identifier 1 :radius/authenticator ra
               :radius/attributes []}]
        (is (= [:ok p] (packet/decode-packet (packet/encode-packet p))))))))

(deftest trailing-bytes-are-padding-not-an-error
  ;; RFC 2865 §3: bytes beyond Length are padding and MUST be ignored, not
  ;; rejected — this is the one place this codec is deliberately more
  ;; lenient than org-ietf-asn1's DER strictness (see README).
  (let [wire (packet/encode-packet a-packet)
        padded (into (vec wire) [0 0 0 0])]
    (is (= [:ok a-packet] (packet/decode-packet padded)))))

;; ── negative paths ──────────────────────────────────────────────────────

(deftest negative-truncated-header
  (is (= [:error :radius/truncated-header] (packet/decode-packet []))))

(deftest negative-bad-length
  ;; Length field says 10, below the 20-octet minimum a header alone takes.
  (let [wire (vec (packet/encode-packet a-packet))
        bad (assoc wire 2 0 3 10)]
    (is (= [:error :radius/bad-length] (packet/decode-packet bad)))))

(deftest negative-truncated-packet
  (testing "Length claims more than the datagram actually holds"
    (let [wire (vec (packet/encode-packet a-packet))
          bad (assoc wire 2 0 3 255)] ; length byte 255, far past what's present
      (is (= [:error :radius/truncated-packet] (packet/decode-packet bad))))))

(deftest negative-encode-shapes
  (testing "unknown :radius/code"
    (is (thrown? #?(:clj Exception :cljs js/Error)
                 (packet/encode-packet (assoc a-packet :radius/code :not-a-real-code)))))
  (testing "authenticator not 16 octets"
    (is (thrown? #?(:clj Exception :cljs js/Error)
                 (packet/encode-packet (assoc a-packet :radius/authenticator [1 2 3]))))))
