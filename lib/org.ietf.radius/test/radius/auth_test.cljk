(ns radius.auth-test
  "RFC 2865/2866 have no worked numeric example of either Authenticator
  formula or of User-Password hiding anywhere in the RFC text (checked
  directly against both RFCs before writing this file). So every expected
  value below is `;; constructed, not a published spec vector` — but each
  one was cross-checked against an independent from-scratch Python
  implementation using the stdlib `hashlib.md5` (not this library, not
  even this language) before being pasted in here."
  (:require [kotoba.test :refer [deftest is]]
            [radius.auth :as auth]
            [radius.bytes :as b]))

(def ^:private ra (vec (range 1 17)))
(def ^:private secret "sharedsecret")

;; ── Response Authenticator (RFC 2865 §3) ───────────────────────────────

(def ^:private response-packet
  {:radius/code :access-accept
   :radius/identifier 1
   :radius/attributes [{:radius/type 1 :radius/value (mapv int "bob")}]})

(deftest response-authenticator-matches-independent-md5
  (is (= "e27ba467f84f7f0a7577923b3f9e28e6"
         (b/hex (auth/response-authenticator response-packet ra secret)))))

(deftest verify-response-authenticator-round-trip
  (let [digest (auth/response-authenticator response-packet ra secret)
        received (assoc response-packet :radius/authenticator digest)]
    (is (true? (auth/verify-response-authenticator received ra secret)))
    (is (false? (auth/verify-response-authenticator
                 (assoc received :radius/authenticator (vec (repeat 16 0))) ra secret)))
    (is (false? (auth/verify-response-authenticator received ra "wrong-secret")))))

;; ── Accounting-Request Authenticator (RFC 2866 §3) ─────────────────────

(def ^:private acct-packet
  {:radius/code :accounting-request
   :radius/identifier 1
   :radius/attributes [{:radius/type 1 :radius/value (mapv int "bob")}
                       {:radius/type 4 :radius/value [192 168 1 1]}]})

(deftest accounting-request-authenticator-matches-independent-md5
  (is (= "9453d2a809d5190ffd44f49d1b9ee14f"
         (b/hex (auth/accounting-request-authenticator acct-packet secret)))))

;; ── User-Password hiding (RFC 2865 §5.2) ────────────────────────────────

(deftest hide-password-matches-independent-md5
  (is (= "0255eed027395eaca64fc469049a33d3"
         (b/hex (auth/hide-password "hello" ra secret)))))

(deftest password-hide-unhide-round-trip
  (doseq [pw ["hello" "" "a" (apply str (repeat 17 "x")) "16charspassword!" "unicode-café"]]
    (let [hidden (auth/hide-password pw ra secret)]
      (is (zero? (mod (count hidden) 16)))
      (is (= [:ok pw] (auth/unhide-password hidden ra secret))))))

;; ── negative paths ──────────────────────────────────────────────────────

(deftest negative-password-too-long
  (is (thrown? #?(:clj Exception :cljs js/Error)
               (auth/hide-password (apply str (repeat 129 "x")) ra secret))))

(deftest negative-unhide-bad-length
  (is (= [:error :radius/bad-password-length] (auth/unhide-password [1 2 3] ra secret)))
  (is (= [:error :radius/bad-password-length] (auth/unhide-password [] ra secret))))
