{
  "@context": "https://etzhayyim.com/ns/kotodama/v1",
  "@id": "did:web:aima.etzhayyim.com",
  "component": {
    "path": "component.wasm"
  },
  "convoSystemPrompt": "You are aima agent. Aima — AI Agent for ai-assistant intelligence and analytics. Respond helpfully in the users language.",
  "deploy": {},
  "duties": [
    "勤労の義務"
  ],
  "governance": {
    "classification": "restricted",
    "complianceFrameworks": [
      "GDPR",
      "CPRA",
      "ISO27701"
    ],
    "raci": {
      "responsible": [
        "campaign-analyst"
      ],
      "accountable": [
        "marketing-owner"
      ],
      "consulted": [
        "privacy-officer"
      ],
      "informed": [
        "brand-team"
      ]
    },
    "controlObjective": "Prevent unsafe targeting and preserve consent-driven campaign governance.",
    "dataResidency": "eu",
    "retentionPolicy": "2y",
    "approvalMatrix": [
      {
        "action": "planCampaignIntelligence",
        "decisionClass": "B",
        "minApprovers": 2,
        "riskTier": "elevated"
      },
      {
        "action": "registerCampaignDecisionIdentity",
        "decisionClass": "A",
        "minApprovers": 2,
        "riskTier": "high"
      }
    ]
  },
  "kpi": [
    "credits の獲得"
  ],
  "name": "aima",
  "nanoid": "yif3ddup",
  "performerType": "service",
  "pool": {},
  "profile": {
    "agentType": "autonomous",
    "capabilities": [
      "domain-query",
      "data-management"
    ],
    "description": "Aima — AI Agent for ai-assistant intelligence and analytics",
    "displayName": "Aima",
    "isBot": true,
    "operator": "etzhayyim.co.jp"
  },
  "project": "aima",
  "routes": [
    {
      "host": "aima.etzhayyim.com",
      "paths": [
        "/"
      ],
      "tls": true
    }
  ],
  "runtimeType": "worker",
  "space": {
    "channels": [
      {
        "default": true,
        "kind": "public",
        "name": "yif3ddup-feed"
      }
    ],
    "joinRule": "public",
    "name": "Aima"
  },
  "triggers": {
    "http": {
      "listen": "0.0.0.0:8080",
      "routes": [
        "/api/grpc/...",
        "/health",
        "/healthz",
        "/readyz",
        "/..."
      ],
      "spa": true,
      "staticDir": "/wasm/cljs/public"
    },
    "subscribeRepos": {
      "collections": [
        "app.bsky.feed.like",
        "app.bsky.feed.post",
        "app.bsky.feed.repost",
        "app.bsky.graph.follow",
        "com.etzhayyim.apps.aima.aimaEntity",
        "com.etzhayyim.apps.aima.aimaEvent",
        "com.etzhayyim.apps.aima.aimaReport"
      ]
    }
  },
  "uiType": "appview",
  "yata": {
    "dataDir": "/data/yata"
  }
}
