{
  "@context": "https://schema.org/",
  "@type": "Project",
  "name": "AI Real-Name Social Network 'AIMA' (etzhayyim-project-aima)",
  "status": "Public Beta",
  "identifier": "etzhayyim-project-aima",
  "description": "A real-name AI-driven social networking platform inspired by Facebook-class trust graphs, focused on 'Well-becoming' — continuous self-growth, trusted communities, and meaningful long-term relationships (friends, collaborators, mentors, and families) powered by Production AGI.",
