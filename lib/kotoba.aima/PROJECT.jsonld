      "@type": "WebApplication",
      "name": "AIMA UI",
      "url": "https://aima.etzhayyim.com"
    }
  ],
  "tasks": [
    {
      "status": "completed",
      "id": "task-1",
      "task": "Design AIMA real-name SNS business model and strategic roadmap."
    },
    {
      "status": "completed",
      "id": "task-2",
      "task": "Define core capabilities for trust graph, communities, and AI-assisted social interactions (DoDAF v2)."
    },
    {
      "status": "completed",
      "id": "task-3",
      "task": "Design AI social graph and recommendation actor architecture."
    },
    {
      "status": "completed",
      "id": "task-4",
      "task": "Initial UI/UX design for mobile-first real-name social networking experience."
    },
    {
      "status": "completed",
      "id": "task-5",
      "task": "Initialize AIMA actor repository and proto definitions."
    },
    {
      "status": "completed",
      "id": "task-6",
      "task": "Develop AIMA user application skeleton."
    },
    {
      "status": "completed",
      "id": "task-7",
      "task": "Implement social recommendation logic and vector search."
    },
    {
      "status": "completed",
      "id": "task-8",
      "task": "Integrate Hume AI for concierge emotional analysis and safer communication."
    },
    {
      "status": "completed",
      "id": "task-9",
      "task": "Configure Kubernetes manifests and GitOps for aima.etzhayyim.com."
    },
    {
      "status": "completed",
      "id": "task-10",
      "task": "Design and implement Stripe-integrated billing and subscription model for communities and premium tools."
    },
    {
      "status": "completed",
      "id": "task-11",
      "task": "Build, push and deploy AIMA UI to production."
    },
    {
      "status": "completed",
      "id": "task-12",
      "task": "aima.etzhayyim.com を公開し、実名SNSとして提供開始。"
    },
    {
      "status": "completed",
      "id": "task-13",
      "task": "Threads参考のsocial機能（投稿・返信・いいね・リポスト・コミュニティ参加）をAIMA UIに実装。"
    }
  ],
  "performers": [
    {
      "@type": "Service",
      "name": "AIMA Social Graph Actor",
      "identifier": "etzhayyim-performer-sys-etzhayyim-actors-pba7d22f-svc-aima-matching",
      "description": "Production AGI actor specialized in trusted-connection recommendations and community relevance ranking."
    },
    {
      "@type": "Service",
      "name": "AIMA Community Concierge Actor",
      "identifier": "etzhayyim-performer-sys-etzhayyim-actors-pba7d22f-svc-aima-concierge",
      "description": "AI concierge for communication guidance, introductions, and community event coordination."
    }
  ],
  "rdfUnifiedDocuments": {
    "@type": "Dataset",
    "name": "Unified top-level RDF/JSON-LD documents",
    "description": "Consolidated from project top-level *.jsonld files except PROJECT.jsonld.",
    "documents": [
      {
        "fileName": "ARCHITECTURE.jsonld",
        "content": {
          "@context": {
            "dodaf": "http://dodcio.defense.gov/Library/DoDAF.aspx#",
            "dct": "http://purl.org/dc/terms/",
            "etzhayyim": "https://etzhayyim.com/schemas/"
          },
          "id": "https://etzhayyim.com/projects/etzhayyim-project-aima/architecture",
          "type": "dodaf:SystemView",
          "dct:title": "AIMA Well-becoming Real-Name SNS System Architecture (SV-1)",
          "etzhayyim:components": [
            {
              "name": "AIMA Social Graph Actor",
              "technology": "Go / ConnectRPC / Temporal / LLM / Vector DB (Qdrant)",
              "description": "Orchestrates identity graph modeling, trust scoring, and friend/group/event recommendations."
            },
            {
              "name": "AIMA Community Concierge Actor",
              "technology": "Go / ConnectRPC / Temporal / Hume AI / Vision LLM",
              "description": "Provides communication coaching, moderation support, and community engagement guidance."
            },
            {
              "name": "Reputation & Safety Engine",
              "technology": "Temporal / PostgreSQL",
              "description": "Manages reputation trends, safety risk workflows, and healthy participation loops."
            }
          ],
          "etzhayyim:data_model": [
            {
              "entity": "VerifiedUserProfile",
              "properties": [
                "id",
                "real_name",
                "verification_level",
                "trust_score",
                "interest_vector",
                "communication_traits"
              ]
            },
            {
              "entity": "SocialEdge",
              "properties": [
                "id",
                "source_user_id",
                "target_user_id",
                "edge_type",
                "strength",
                "created_at"
              ]
            },
            {
              "entity": "CommunitySignal",
              "properties": [
                "id",
                "community_id",
                "user_id",
                "signal_type",
                "quality_score",
                "safety_flag"
              ]
            }
          ]
        }
      },
      {
        "fileName": "ENGINEER.jsonld",
        "content": {
          "@context": {
            "dodaf": "http://dodcio.defense.gov/Library/DoDAF.aspx#",
            "etzhayyim": "https://etzhayyim.com/schemas/"
          },
          "id": "https://etzhayyim.com/projects/etzhayyim-project-aima/engineer",
          "type": "dodaf:EngineeringView",
          "name": "AIMA Well-becoming Real-Name SNS Engineering Specification",
          "description": "Technical implementation for trusted social graph operations, community intelligence, and AI-assisted communication.",
          "etzhayyim:implementations": [
            {
              "component": "AIMA Social Graph Actor",
              "framework": "Go / ConnectRPC / Temporal",
              "details": {
                "logic": "Asynchronous social recommendation using trust-aware graph ranking and growth trajectory prediction. Uses Qdrant for vector similarity and custom scoring for relevance and safety.",
                "storage": "Qdrant (interest/communication vectors), PostgreSQL (trust scores, verification states, moderation outcomes)."
              }
            },
            {
              "component": "AIMA Community Concierge Actor",
              "framework": "Go / ConnectRPC / Temporal / Hume AI / GPT-4o-Vision",
              "details": {
                "communicationLogic": "Integrates Hume AI EVI for emotional signal detection and empathy coaching during conversations.",
                "mediaLogic": "Uses GPT-4o-Vision for profile/media context checks and impersonation risk cues.",
                "moderationLogic": "Temporal-managed workflows for report triage, intervention guidance, and follow-up education."
              }
            },
            {
              "component": "AIMA Core App",
              "framework": "SvelteKit (Svelte 5) / ConnectRPC-Web",
              "details": {
                "uiLibrary": "Tailwind CSS / Shadcn/ui (Svelte port)",
                "billing": "Stripe Checkout & Customer Portal integration.",
                "features": [
                  "PWA support for mobile-first social experience.",
                  "Real-time feed and community updates via ConnectRPC SSE or WebSockets."
                ]
              }
            },
            {
              "component": "AIMA Billing Actor",
              "framework": "Go / ConnectRPC / Stripe SDK",
              "details": {
                "logic": "Coordinates with global Payment Gateway Actor to manage Stripe sessions.",
                "features": [
                  "Subscription tier management (Basic/Standard/Premium).",
                  "One-time professional concierge checkout (community launch support).",
                  "Stripe Webhook processing for automated premium access granting."
                ]
              }
            }
          ],
          "etzhayyim:deployment": {
            "platform": "Linode LKE / Gateway API",
            "ciCd": "GitOps with SHA256 digest pinning for all AGI and UI components."
          }
        }
      },
      {
        "fileName": "STRATEGY.jsonld",
        "content": {
          "@context": {
            "dodaf": "http://dodcio.defense.gov/Library/DoDAF.aspx#",
            "dct": "http://purl.org/dc/terms/"
          },
          "id": "https://etzhayyim.com/projects/etzhayyim-project-aima/strategy",
          "type": "dodaf:StrategicView",
          "dct:title": "AIMA Well-becoming Real-Name SNS Strategy",
          "dct:description": "To redefine trusted digital communities through the lens of 'Well-becoming', where Production AGI supports authentic identity, healthy discourse, and long-term human connections beyond dating.",
          "goals": [
            "Develop an AI social graph engine that prioritizes trust, relevance, and complementary growth trajectories.",
            "Implement 'Well-becoming Coaching' for communication quality, civic behavior, and creator development.",
            "Establish habit-forming loops that improve personal reputation and community contribution over time.",
            "Integrate emotional AI (Hume AI) to guide empathetic conversations and reduce toxic interactions.",
            "Position AIMA as a real-name social infrastructure comparable to Facebook-style identity networks, adapted for safety and AI-native experiences."
          ]
        }
      },
      {
        "fileName": "activities.jsonld",
        "content": {
          "@context": {
            "dodaf": "http://dodcio.defense.gov/Library/DoDAF.aspx#",
            "dct": "http://purl.org/dc/terms/",
            "etzhayyim": "https://etzhayyim.com/schemas/"
          },
          "id": "https://etzhayyim.com/projects/etzhayyim-project-aima/activities",
          "type": "dodaf:OperationalActivity",
          "dct:title": "AIMA Well-becoming Real-Name SNS Operational Process (OV-5b)",
          "dct:description": "AGI-driven real-name social networking workflow focusing on trusted identity, healthy communities, and collective flourishing.",
          "etzhayyim:processes": [
            {
              "name": "AIMA Trust & Community Cycle",
              "steps": [
                {
                  "activity": "Identity & Baseline Assessment",
                  "performer": "etzhayyim-performer-sys-etzhayyim-actors-pba7d22f-svc-aima-matching",
                  "action": "Verify user identity and analyze communication style for baseline trust and well-becoming score.",
                  "input": "ID/KYC Data / User Media / Chat / Personality Interview",
                  "output": "Verified Real-Name Profile & Trust Baseline"
                },
                {
                  "activity": "Continuous Coaching & Habit Formation",
                  "performer": "etzhayyim-performer-sys-etzhayyim-actors-pba7d22f-svc-aima-concierge",
                  "action": "Provide daily feedback on posting quality, communication, and community participation.",
                  "input": "User Activity / Coaching Plan / Community Signals",
                  "output": "Improved Reputation, Readiness, and Social Habits"
                },
                {
                  "activity": "Social Graph Recommendation",
                  "performer": "etzhayyim-performer-sys-etzhayyim-actors-pba7d22f-svc-aima-matching",
                  "action": "Recommend friends, groups, creators, and events based on trust, relevance, and shared growth context.",
                  "input": "Verified Profiles / Interaction Graph",
                  "output": "High-Quality Connections & Community Discovery"
                },
                {
                  "activity": "Community Safety & Co-flourishing Support",
                  "performer": "etzhayyim-performer-sys-etzhayyim-actors-pba7d22f-svc-aima-concierge",
                  "action": "Facilitate constructive conversations, event coordination, and moderation escalation when risk is detected.",
                  "input": "Feed Data / Group Activity / Safety Signals",
                  "output": "Safer, Meaningful, and Sustainable Social Network"
                }
              ]
            }
          ]
        }
      },
      {
        "fileName": "billing.jsonld",
        "content": {
          "@context": "https://schema.org/",
          "@type": "PriceSpecification",
          "name": "AIMA Billing & Subscription Model",
          "description": "Value-based monetization for real-name social networking, trusted communities, and AI concierge services.",
          "etzhayyim:tiers": [
            {
              "name": "AIMA Basic (Free)",
              "price": 0,
              "currency": "JPY",
              "features": [
                "Real-name onboarding and basic verification",
                "Limited AI feed personalization",
                "Group participation (up to 3 groups)",
                "Basic safety and moderation support"
              ]
            },
            {
              "name": "AIMA Standard",
              "price": 4980,
              "billingIncrement": "Monthly",
              "currency": "JPY",
              "stripePriceId": "price_aima_standard_monthly",
              "features": [
                "Advanced trust and reputation analytics",
                "Unlimited group and event participation",
                "AI communication coaching and post optimization",
                "Priority social graph recommendations",
                "Creator tools and community management kit"
              ]
            },
            {
              "name": "AIMA Premium (Flourish)",
              "price": 9800,
              "billingIncrement": "Monthly",
              "currency": "JPY",
              "stripePriceId": "price_aima_premium_monthly",
              "features": [
                "All Standard features",
                "24/7 Personalized AGI Community Concierge",
                "Advanced safety shield and impersonation monitoring",
                "Exclusive verified community events",
                "Cross-community growth insights and introductions"
              ]
            }
          ],
          "etzhayyim:oneTimeServices": [
            {
              "name": "Enterprise Community Launch Concierge",
              "price": 50000,
              "description": "Specialized onboarding and moderation design for high-profile organizations and creators."
            },
            {
              "name": "Trust & Reputation Deep-Dive Report",
              "price": 2000,
              "description": "Comprehensive AGI-generated analysis of network trust position and improvement opportunities."
            }
          ],
          "etzhayyim:stripeIntegration": {
            "provider": "Stripe",
            "mode": "Subscription & Checkout",
            "webhooks": [
              "customer.subscription.updated",
              "checkout.session.completed",
              "invoice.payment_succeeded"
            ],
            "portalEnabled": true
          }
        }
      },
      {
        "fileName": "capabilities.jsonld",
        "content": {
          "@context": {
            "dodaf": "http://dodcio.defense.gov/Library/DoDAF.aspx#",
            "dct": "http://purl.org/dc/terms/"
          },
          "id": "https://etzhayyim.com/projects/etzhayyim-project-aima/capabilities",
          "type": "dodaf:Capability",
          "dct:title": "AIMA Real-Name SNS Capability Catalog (Threads Reference)",
          "capabilities": [
            {
              "name": "Real-name Identity & Trust (C1)",
              "description": "Real-name verification, trust badge surface, and profile-level safety signals for all participants."
            },
            {
              "name": "Threaded Conversation Engine (C2)",
              "description": "Short post creation, reply chains, and conversational continuity inspired by Threads-style social UX."
            },
            {
              "name": "Engagement Actions (C3)",
              "description": "Like, repost, and lightweight interaction primitives optimized for community velocity and discoverability."
            },
            {
              "name": "Community Graph Management (C4)",
              "description": "Join/leave community controls, membership visibility, and graph-aware relevance ranking."
            },
            {
              "name": "Safety & Moderation Intelligence (C5)",
              "description": "AI-assisted conversation quality nudges, abuse signal detection, and moderation escalation workflows."
            }
          ]
        }
      },
      {
        "fileName": "measures.jsonld",
        "content": {
          "@context": {
            "dodaf": "http://dodcio.defense.gov/Library/DoDAF.aspx#",
            "etzhayyim": "https://etzhayyim.com/schemas/"
          },
          "@type": "dodaf:Measure",
          "name": "AIMA Real-Name SNS Performance Measures",
          "description": "Metrics and KPIs to evaluate trust, community health, and growth of the AI-supported real-name social network.",
          "etzhayyim:measures": [
            {
              "id": "M-001",
              "name": "Verified User Ratio",
              "metric": "Percentage of monthly active users with completed real-name verification",
              "target": "85%",
              "category": "Trust"
            },
            {
              "id": "M-002",
              "name": "Community Health Score",
              "metric": "Weighted score combining meaningful interactions, report resolution quality, and retention",
              "target": ">= 80/100",
              "category": "Quality"
            },
            {
              "id": "M-003",
              "name": "Safety Incident Rate",
              "metric": "High-risk incidents per 10,000 interactions",
              "target": "< 1.0",
              "category": "Safety"
            },
            {
              "id": "M-004",
              "name": "Premium Conversion",
              "metric": "Percentage of active users converting to paid plans",
              "target": "15%",
              "category": "Financial"
            }
          ]
        }
      },
      {
        "fileName": "rules.jsonld",
        "content": {
          "@context": {
            "dodaf": "http://dodcio.defense.gov/Library/DoDAF.aspx#",
            "etzhayyim": "https://etzhayyim.com/schemas/"
          },
          "@type": "dodaf:Rule",
          "name": "AIMA Real-Name SNS Operational Rules",
          "description": "Rules governing trusted identity, platform integrity, and safe community operations.",
          "etzhayyim:rules": [
            {
              "id": "RULE-001",
              "name": "Strict Real-Name Identity Verification",
              "description": "All users must complete AI-driven ID verification (KYC) before initiating direct interactions or creating public communities.",
              "category": "Security"
            },
            {
              "id": "RULE-002",
              "name": "Privacy of Personal and Behavioral Data",
              "description": "Raw psychometric and behavioral data must never be publicly exposed; only consented summaries and platform-safe indicators are visible.",
              "category": "Privacy"
            },
            {
              "id": "RULE-003",
              "name": "Safety Monitoring and Moderation Escalation",
              "description": "AGI actors continuously monitor interactions for harassment, impersonation, fraud, and coordinated abuse, with automatic risk-based restriction and escalation.",
              "category": "Safety"
            },
            {
              "id": "RULE-004",
              "name": "Fairness and Feed Transparency",
              "description": "Recommendation and feed algorithms must avoid discrimination across protected classes and provide user-visible explanation controls.",
              "category": "Ethical"
            }
          ]
        }
      },
      {
        "fileName": "scheduler.jsonld",
        "content": {
          "@context": [
            "https://schema.org/",
            {
              "etzhayyim": "https://etzhayyim.com/schemas/",
              "capabilities": "etzhayyim:capabilities",
              "survivalIndicators": "etzhayyim:survivalIndicators",
              "scheduler": "etzhayyim:scheduler",
              "milestones": "etzhayyim:milestones",
              "blockers": "etzhayyim:blockers",
              "dependsOn": {
                "@id": "etzhayyim:dependsOn",
