              },
              "ingestKey": "etzhayyim:ingestKey",
              "window": "etzhayyim:window",
              "valueUpdatedAt": "etzhayyim:valueUpdatedAt"
            }
          ],
          "@type": "CreativeWork",
          "name": "AI Real-Name Social Network 'AIMA' (etzhayyim-project-aima) Scheduler",
          "identifier": "etzhayyim-project-aima/scheduler",
          "description": "Project schedule (milestones) and blockers.",
          "dateCreated": "2026-02-15T04:25:26+00:00",
          "milestones": [],
          "blockers": []
        }
      },
      {
        "fileName": "uiux.jsonld",
        "content": {
          "@context": "https://schema.org/",
          "@type": "CreativeWork",
          "name": "AIMA Well-becoming Real-Name SNS UI/UX Design",
          "description": "An interface that guides users through trusted identity, meaningful community participation, and long-term human connection.",
          "etzhayyim:designPrinciples": [
            "Apple Human Interface Guidelines (iPad-first)",
            "Trust-first visual patterns (real-name badge, relationship context, provenance)",
            "Non-judgmental, encouraging AI feedback",
            "Transparency in feed ranking, recommendation logic, and safety interventions"
          ],
          "etzhayyim:uiComponents": [
            {
              "name": "Trust & Identity Dashboard",
              "type": "InteractiveDashboard",
              "features": [
                "Verification Status",
                "Reputation Trend",
                "Community Contribution Insights"
              ]
            },
            {
              "name": "Community Feed",
              "type": "SocialStream",
              "features": [
                "Contextual Feed Ranking",
                "AI Conversation Nudges",
                "Group/Event Discovery"
              ]
            },
            {
              "name": "Connection Graph Explorer",
              "type": "NarrativeExplorer",
              "features": [
                "Friend/Group Recommendations",
                "Shared Context Paths",
                "Mutual Trust Indicators"
              ]
            }
          ],
          "etzhayyim:uxFlows": [
            {
              "name": "Real-Name Onboarding Journey",
              "steps": [
                "Secure Onboarding",
                "Identity Verification",
                "Baseline Communication Assessment",
                "Interest & Community Setup"
              ]
            },
            {
              "name": "Healthy Community Interaction Loop",
              "steps": [
                "Create or React to Post",
                "AI Empathy Check",
                "Group/Event Engagement",
                "Reputation & Reflection Feedback"
              ]
            }
          ]
        }
      }
    ]
  }
}
