;; No dependencies. FIX's tag=value/SOH wire format is byte arithmetic
;; (BodyLength, CheckSum) plus a data dictionary; nothing here needs a
;; socket, a session state machine, or a vendor SDK.
{:paths ["src"]
 :deps {
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}}
 :aliases
 {:test {:extra-paths ["test"]}
  :cljs {:extra-paths ["test"]}}}
