{:paths ["src"]
 ;; tar is an archiver, not a codec: zero dependencies. org-ietf-deflate appears
 ;; in :test only, to check the documented .tar.gz composition against `tar -xzf`.
 :deps {
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}}
 :aliases
 {:test {:extra-paths ["test"]}
  :local {:override-deps {io.github.kotoba-lang/org-ietf-deflate {:local/root "../org-ietf-deflate"}}}}}
