(ns theme-toggle (:export [control]) (:require [button :as button]))
;; Pure Hiccup counterpart of jp-go-dds.theme-toggle/control. The script and
;; CSS are separate artifacts and this fragment does not qualify them.
(defn control [] [:option :document]
 (let [mark (document-edn-read "[:span {:class \"kot-yy\"} [:svg {:viewBox \"0 0 24 24\" :width 26 :height 26 :aria-hidden \"true\" :focusable \"false\"} [:g {:class \"kot-yy-fig\"} [:circle {:class \"kot-yy-ring\" :cx 12 :cy 12 :r \"10.6\"}] [:path {:class \"kot-yy-yin\" :d \"M12 1.4A10.6 10.6 0 0 1 12 22.6A5.3 5.3 0 0 1 12 12A5.3 5.3 0 0 0 12 1.4Z\"}] [:g {:transform \"translate(12.05 17.3) rotate(0) scale(0.78)\"} [:path {:class \"kot-lam kot-lam-cut\" :d \"M-2.2 -4 L2.4 4\"}] [:path {:class \"kot-lam kot-lam-cut\" :d \"M-0.6 -1.2 L-2.8 4\"}]] [:g {:transform \"translate(11.95 6.7) rotate(180) scale(0.78)\"} [:path {:class \"kot-lam kot-lam-ink\" :d \"M-2.2 -4 L2.4 4\"}] [:path {:class \"kot-lam kot-lam-ink\" :d \"M-0.6 -1.2 L-2.8 4\"}]]]]]")
       opts (record-new [:ref :btn/opts] "text" "sm" "" "" "" false false (document-vector))
       extra (document-map :id (document-string "kot-theme") :role (document-string "switch")
               :aria-checked (document-string "false") :aria-label (document-string "Dark mode") :hidden (document-bool true))]
  (button/node opts mark extra)))
