(ns bridge-document
  ;; The entry points are exported, so a host can call them.
  ;;
  ;; They were not, and the comment here named this harness as the reason. The
  ;; harness is not the reason and neither is the value boundary -- a
  ;; `:document` crosses the KIR entry boundary in both directions, host-built,
  ;; with a wrong tag refused rather than coerced (measured 2026-08-12,
  ;; `dark_mirror`). What refused a list was `main` below, which a declared
  ;; list must contain, plus `ir/execute` running exported functions only,
  ;; which the harness answers by widening the list with its own case names.
  (:export [main custom-property custom-property-of-keyword hig-var entry table-doc bridged? render-body-except render-body join-decls wrap render bridge-digest bridge-print bridge-read])
  (:schemas {:bridge/entry [:record :bridge/entry
                            [[:name :string] [:value :string]]]
             :bridge/table [:record :bridge/table
                            [[:selector :string] [:entries :document]]]
             :bridge/render-from [:record :bridge/render-from
                                  [[:entries :document]
                                   [:excluded :document]
                                   [:index :i64]
                                   [:n :i64]
                                   [:acc :string]]]
             :bridge/member-from [:record :bridge/member-from
                                  [[:entries :document]
                                   [:needle :string]
                                   [:index :i64]
                                   [:n :i64]]]}))

;; The `--hig-*` → DADS bridge, as a logical `:document` value.
;;
;; W6 next-cohort slice for `jp-go-digital-design-system` (ADR-2607279200 /
;; migration plan W6 / com-junkawasaki root AGENTS.md "UI/UX 標準"). The design
;; system cohort reached Delivery-6 5/5 for css → html → shitsuke →
;; liquid-glass-ui → kotoba-ui; DADS became this workspace's BASE design system
;; on 2026-08-05 and carries the same `--hig-*` token contract on top of DADS
;; primitives, but had no `.kotoba` authority for the bridge at all.
;;
;; What this module owns is the *decision*, not the plumbing:
;;
;;   1. token normalization — `:color-tint` / "color-tint" / "--hig-color-tint"
;;      all name one custom property. Getting this wrong is not cosmetic: the
;;      .cljc original records a measured failure where a bare `str` over a
;;      keyword produced `--hig-:color-tint`, i.e. a `var()` reference that can
;;      never resolve.
;;   2. the breakout guard — the same four sequences css.core rejects, since a
;;      bridge value is spliced into `name: VALUE;` with no other escaping.
;;   3. exclusion — a product keeps its brand accent by withholding a token
;;      from the bridge rather than by overriding it afterwards. A withheld
;;      token is *absent*, so `shitsuke.hig`'s own value still answers; it does
;;      not become an undefined reference.
;;   4. identity — `bridge-digest` is a content identity for the token contract
;;      itself. The contract's whole reason to exist is that exactly one place
;;      derives it; a digest is the machine-checkable form of that claim.
;;
;; Rendering to CSS text is deliberately byte-identical to `css.core`, which
;; remains the consumer API. This module is capability-free (kotoba/pure).
;;
;; Entry ORDER is the document's, not this module's: the .cljc original sorts
;; by key before handing declarations to css.core, and the harness feeds the
;; same key-sorted order here. That follows tokens_document / css_document —
;; ordering authority stays with the value, so a caller that needs a different
;; order gets it without a second renderer.
;;
;; ## The bridge does not fit in one document value (measured 2026-08-10)
;;
;; `document-container-item-limit` is 32 and `document-node-limit` is 256
;; (kotoba-kir `value.cljc`; depth limit 8). The bridge is 71 entries, and each
;; entry is a 3-node map, so the whole table is roughly 215 nodes of entries
;; alone — over both bounds. A single `(document-vector …)` of the bridge is
;; rejected at elaboration with `document sequence exceeds item limit`.
;;
;; So the unit here is a CHUNK of at most 32 entries, and a sheet is assembled
;; from several: `render-body` emits one chunk's declarations, `join-decls`
;; concatenates two bodies, `wrap` puts the selector and braces on once. This
;; is the same shape `tokens_document.kotoba` already has for shitsuke, where
;; the chunks happen to be semantic groups (colors / spacing / breakpoints).
;;
;; Chunking is mechanism, not policy: which entries share a chunk changes
;; nothing about the output, because `join-decls` reassembles them in order.
;; The caller picks chunk boundaries; the parity gate feeds key-sorted runs of
;; 32 and requires the joined result to equal `jp-go-dds.tokens/bridge-css`
;; byte for byte.

;; --- breakout guard -------------------------------------------------------
;; Same four sequences as css.core's regex.

(defn safe? [s :string] :bool
  (not (or (string-contains? s "{")
           (string-contains? s "}")
           (string-contains? s ";")
           (string-contains? s "/*"))))

;; --- token normalization --------------------------------------------------
;; A token already spelled `--…` is a complete custom-property name and is
;; taken as written; anything else names a member of the `--hig-` family.

(defn double-dash-prefixed? [t :string] :bool
  ;; `<` still needs the `if` wrap: HIR types it `:bool`, but KIR execute
  ;; yields a 0/1 word, and that fails a `:bool` return.
  (if (< (string-byte-length t) 2)
    false
    (string=? (string-substring t 0 2) "--")))

(defn custom-property [t :string] :string
  (if (double-dash-prefixed? t)
    t
    (string-concat "--hig-" t)))

(defn custom-property-of-keyword [k :keyword] :string
  ;; `keyword-name` is what keeps the leading colon out of the property name.
  ;; Spelling this as its own entry point rather than letting callers stringify
  ;; is the fix for the measured `--hig-:color-tint` failure: there is no
  ;; spelling of this call that carries the colon through.
  (custom-property (keyword-name k)))

(defn hig-var [t :string] :string
  (string-concat "var(" (string-concat (custom-property t) ")")))

;; --- document constructors ------------------------------------------------

(defn entry [x [:ref :bridge/entry]] :document
  (let [name (record-get x :name)
        value (record-get x :value)]
    (document-map :name (document-string (custom-property name))
                  :value (document-string value))))

(defn table-doc [x [:ref :bridge/table]] :document
  (let [selector (record-get x :selector)
        entries (record-get x :entries)]
    (document-map :selector (document-string selector)
                  :entries entries)))

;; --- projections ----------------------------------------------------------

(defn name-of [d :document] :string
  (option-or
    (document-string-value
      (option-or (document-get d :name) (document-null)))
    ""))

(defn value-of [d :document] :string
  (option-or
    (document-string-value
      (option-or (document-get d :value) (document-null)))
    ""))

(defn selector-of [d :document] :string
  (option-or
    (document-string-value
      (option-or (document-get d :selector) (document-null)))
    ":root"))

(defn entries-of [d :document] :document
  (option-or (document-get d :entries) (document-vector)))

;; --- membership -----------------------------------------------------------
;; Linear over the entry vector. The bridge is 71 entries and the exclusion set
;; is a handful of brand tokens, so an index is not worth the second
;; representation it would have to stay in step with.

(defn member-from [x [:ref :bridge/member-from]] :bool
  (let [entries (record-get x :entries)
        needle (record-get x :needle)
        i (record-get x :index)
        n (record-get x :n)]
    (if (>= i n)
      false
      (if (string=? (name-of (option-or (document-vector-at entries i)
                                        (document-null)))
                    needle)
        true
        (member-from (record-new [:ref :bridge/member-from]
                                 entries needle (+ i 1) n))))))

(defn member? [entries :document needle :string] :bool
  (member-from (record-new [:ref :bridge/member-from]
                           entries needle 0 (document-count entries))))

(defn bridged? [table :document token :string] :bool
  ;; Mirrors the .cljc `bridged?`: normalize first, then ask the table. A view
  ;; that uses an unbridged token renders correctly only under the kotoba-ui
  ;; skin, so consumers assert on this.
  (member? (entries-of table) (custom-property token)))

;; --- render logical bridge document → CSS stream --------------------------

(defn declaration [d :document] [:result :string :string]
  (if (safe? (value-of d))
    (result-ok-of [:result :string :string]
                  (string-concat (name-of d)
                                 (string-concat ": "
                                                (string-concat (value-of d) ";"))))
    (result-err-of [:result :string :string]
                   (string-concat "unsafe value for " (name-of d)))))

(defn render-from [x [:ref :bridge/render-from]] [:result :string :string]
  (let [entries (record-get x :entries)
        excluded (record-get x :excluded)
        i (record-get x :index)
        n (record-get x :n)
        acc (record-get x :acc)]
    (if (>= i n)
      (result-ok-of [:result :string :string] acc)
      (let [d (option-or (document-vector-at entries i) (document-null))]
        (if (member? excluded (name-of d))
          (render-from (record-new [:ref :bridge/render-from]
                                   entries excluded (+ i 1) n acc))
          (match-result
           (declaration d)
           [:result :string :string]
           (ok text
               (render-from
                (record-new [:ref :bridge/render-from]
                            entries excluded (+ i 1) n
                            (if (string=? acc "")
                              text
                              (string-concat acc (string-concat " " text))))))
           (err message (result-err-of [:result :string :string] message))))))))

(defn render-body-except [chunk :document excluded :document]
  [:result :string :string]
  ;; One chunk's declarations, with no selector and no braces, so several
  ;; chunks can be joined before the sheet is closed.
  (render-from (record-new [:ref :bridge/render-from]
                           (entries-of chunk)
                           excluded
                           0
                           (document-count (entries-of chunk))
                           "")))

(defn render-body [chunk :document] [:result :string :string]
  (render-body-except chunk (document-vector)))

(defn join-decls [a :string b :string] :string
  ;; The same single-space join `render-from` uses within a chunk, so a chunk
  ;; boundary leaves no trace in the output.
  (if (string=? a "")
    b
    (if (string=? b "")
      a
      (string-concat a (string-concat " " b)))))

(defn wrap [selector :string body :string] [:result :string :string]
  (if (safe? selector)
    (result-ok-of [:result :string :string]
                  (string-concat selector
                                 (string-concat " { " (string-concat body " }"))))
    (result-err-of [:result :string :string] "unsafe selector")))

(defn render-except [table :document excluded :document] [:result :string :string]
  ;; Whole-sheet convenience for a table that does fit in one document value.
  (match-result
   (render-body-except table excluded)
   [:result :string :string]
   (ok body (wrap (selector-of table) body))
   (err message (result-err-of [:result :string :string] message))))

(defn render [table :document] [:result :string :string]
  (render-except table (document-vector)))

;; --- identity (W4 print/sha256 surface) -----------------------------------

(defn bridge-digest [d :document] :string
  (document-sha256 d))

(defn bridge-print [d :document] :string
  (document-print d))

(defn bridge-read [s :string] :document
  (document-read s))

(defn main []
  (string-byte-length
   (result-value-of [:result :string :string]
                    (render
                     (table-doc
                      (record-new [:ref :bridge/table]
                                  ":root"
                                  (document-vector
                                   (entry (record-new [:ref :bridge/entry]
                                                      "color-label"
                                                      "var(--color-neutral-solid-gray-800)"))
                                   (entry (record-new [:ref :bridge/entry]
                                                      "color-tint"
                                                      "var(--color-key-900)"))))))
                    "")))
