(ns select-banner
  ;; The entry points are exported, so a host can call them.
  ;;
  ;; They were not, and the comment here named this harness as the reason. The
  ;; harness is not the reason and neither is the value boundary -- a
  ;; `:document` crosses the KIR entry boundary in both directions, host-built,
  ;; with a wrong tag refused rather than coerced (measured 2026-08-12,
  ;; `dark_mirror`). What refused a list was `main` below, which a declared
  ;; list must contain, plus `ir/execute` running exported functions only,
  ;; which the harness answers by widening the list with its own case names.
  ;;
  ;; `placeholder?` and `selected?` were added to the list on 2026-08-12
  ;; because `jp-go-dds.core/select` now asks them rather than restating them.
  ;; They are the two rules whose restatement has already cost something (see
  ;; "The one that has already cost something" below), and they take ONE
  ;; option's worth of data, which is what keeps them delegable at all --
  ;; `options-attrs` and `selected-count` take the whole list and are refused
  ;; above 32 of them.
  (:export [main option-attrs options-attrs selected-count select-attrs known-type? icon-type icon-label banner-attrs heading-tag placeholder? selected?])
  (:schemas {:sb/option [:record :sb/option
                         [[:value :string]
                          [:label :string]
                          [:current :string]
                          [:has-current :bool]]]
             :sb/options-from [:record :sb/options-from
                               [[:options :document]
                                [:current :string]
                                [:has-current :bool]
                                [:index :i64]
                                [:n :i64]
                                [:acc :string]]]
             :sb/passthrough [:record :sb/passthrough
                              [[:extra :document]
                               [:index :i64]
                               [:n :i64]
                               [:acc :string]]]
             ;; `select`'s element attributes are seven values, and the ABI
             ;; caps a function at five parameters
             ;; (`surface-status.edn`: `:abi-bound {:max-arity 5
             ;; :disposition :intentional-security-constraint}`). That is a
             ;; permanent bound, not a gap waiting to be lifted, so the fold
             ;; into a guest record is the idiom rather than a workaround —
             ;; the same T5.2 shape every other module here uses.
             :sb/select [:record :sb/select
                         [[:size :string]
                          [:id :string]
                          [:name :string]
                          [:required :bool]
                          [:disabled :bool]
                          [:describedby :string]
                          [:extra :document]]]}))

;; `select`'s option state and `notification-banner`'s icon table.
;;
;; W6 slice 6 for jp-go-dds — the two components the last slice set aside,
;; because their decisions are over a list and a table rather than over a flat
;; attribute map.
;;
;; ## The one that has already cost something
;;
;; Which option carries `selected` is not cosmetic. Three rules:
;;
;;   - an option whose value is empty is a placeholder: disabled AND selected,
;;     the upstream "選択してください";
;;   - an option matching the current value is selected — compared AS TEXT,
;;     because an options list holds numbers and keywords as readily as
;;     strings and `18` must match `"18"`;
;;   - with no current value, NOTHING is selected, and the browser then shows
;;     the first option.
;;
;; The third is the one that bites. The page looks correct, the form posts the
;; first option, and nobody notices: measured 2026-07-30, cloud-itonami/inkan
;; rendered a 12.0mm seal where 18.0mm was intended. A caller who means a
;; default must pass one; this module cannot invent it, but it can make the
;; rule explicit enough to test.
;;
;; Text comparison is the decision here; turning a number into text happens at
;; the host boundary, because Kotoba has no runtime `str` over arbitrary
;; values. The gate feeds both `18` and `"18"` from the `.cljc` side to show
;; the boundary holds.
;;
;; ## select and button disagree about passthrough, and this preserves that
;;
;; `button` merges `:attrs` FIRST and its own class/data-* after, so the
;; component's identity wins. `select` merges its own first and `:attrs` after,
;; so a caller CAN overwrite `class` and `data-size` — measured 2026-08-10,
;; `(select {:attrs {:class "MINE"}} …)` emits `class="MINE"` and loses the
;; DADS styling entirely. That is the opposite of what button's docstring says
;; the rule is for.
;;
;; This module reproduces the shipped behaviour rather than quietly correcting
;; it: a parity gate that encodes what the library ought to do proves nothing
;; about what it does. The divergence is asserted explicitly in the gate so it
;; cannot be lost, and choosing which of the two is right is a change to a
;; shipped API, not a migration.
;;
;; Capability-free (kotoba/pure).

;; --- shared attribute text -------------------------------------------------

(defn attr [name :string value :string] :string
  (string-concat name (string-concat "=\"" (string-concat value "\""))))

(defn join-attr [acc :string one :string] :string
  (if (string=? acc "") one (string-concat acc (string-concat " " one))))

(defn maybe-attr [acc :string name :string value :string] :string
  (if (string=? value "") acc (join-attr acc (attr name value))))

(defn flag-attr [acc :string name :string on :bool] :string
  (if on (join-attr acc (attr name "true")) acc))

(defn entry-name [d :document] :string
  (option-or
    (document-string-value (option-or (document-get d :name) (document-null)))
    ""))

(defn entry-value [d :document] :string
  (option-or
    (document-string-value (option-or (document-get d :value) (document-null)))
    ""))

(defn passthrough-from [x [:ref :sb/passthrough]] :string
  (let [extra (record-get x :extra)
        i (record-get x :index)
        n (record-get x :n)
        acc (record-get x :acc)]
    (if (>= i n)
      acc
      (let [d (option-or (document-vector-at extra i) (document-null))]
        (passthrough-from
         (record-new [:ref :sb/passthrough] extra (+ i 1) n
                     (join-attr acc (attr (entry-name d) (entry-value d)))))))))

(defn passthrough [extra :document] :string
  (passthrough-from (record-new [:ref :sb/passthrough]
                                extra 0 (document-count extra) "")))

;; --- select: option state --------------------------------------------------

(defn placeholder? [v :string] :bool
  ;; nil and "" are the same thing by the time they reach here; the host
  ;; boundary already collapsed them, because both mean "no value".
  (string=? v ""))

(defn selected? [x [:ref :sb/option]] :bool
  (if (placeholder? (record-get x :value))
    true
    (if (record-get x :has-current)
      (string=? (record-get x :value) (record-get x :current))
      false)))

(defn option-attrs [x [:ref :sb/option]] :string
  ;; `selected` comes from `selected?` on BOTH branches. Writing it directly in
  ;; the placeholder branch reads fine and is a trap: the two can then disagree,
  ;; and a mutation test showed exactly that — flipping `selected?` for a
  ;; placeholder left this function still emitting `selected="true"`, so only
  ;; the counting assertion noticed. One rule, one place to read it.
  (if (placeholder? (record-get x :value))
    ;; The placeholder is disabled as well — it is a prompt, not a choice, and
    ;; must not survive a submit.
    (flag-attr (join-attr (attr "value" "") (attr "disabled" "true"))
               "selected" (selected? x))
    (flag-attr (attr "value" (record-get x :value)) "selected" (selected? x))))

(defn options-from [x [:ref :sb/options-from]] :string
  (let [options (record-get x :options)
        current (record-get x :current)
        has-current (record-get x :has-current)
        i (record-get x :index)
        n (record-get x :n)
        acc (record-get x :acc)]
    (if (>= i n)
      acc
      (let [d (option-or (document-vector-at options i) (document-null))
            one (option-attrs (record-new [:ref :sb/option]
                                          (entry-value d) (entry-name d)
                                          current has-current))
            next (if (string=? acc "") one (string-concat acc (string-concat " | " one)))]
        (options-from (record-new [:ref :sb/options-from]
                                  options current has-current (+ i 1) n next))))))

(defn options-attrs [options :document current :string has-current :bool] :string
  (options-from (record-new [:ref :sb/options-from]
                            options current has-current 0 (document-count options) "")))

(defn selected-count-from [x [:ref :sb/options-from]] :i64
  ;; How many options carry `selected`. Zero is the case the incident came
  ;; from: valid HTML, and the browser picks the first.
  (let [options (record-get x :options)
        current (record-get x :current)
        has-current (record-get x :has-current)
        i (record-get x :index)
        n (record-get x :n)]
    (if (>= i n)
      0
      (let [d (option-or (document-vector-at options i) (document-null))
            hit (if (selected? (record-new [:ref :sb/option]
                                           (entry-value d) (entry-name d)
                                           current has-current))
                  1
                  0)]
        (+ hit (selected-count-from
                (record-new [:ref :sb/options-from]
                            options current has-current (+ i 1) n "")))))))

(defn selected-count [options :document current :string has-current :bool] :i64
  (selected-count-from (record-new [:ref :sb/options-from]
                                   options current has-current 0
                                   (document-count options) "")))

;; --- select: the element's own attributes ----------------------------------
;; Passthrough comes AFTER the component's own, reproducing the shipped merge
;; order. See the header.

(defn select-attrs [x [:ref :sb/select]] :string
  (let [own (join-attr (attr "class" "dads-select__select")
                       (attr "data-size" (if (string=? (record-get x :size) "")
                                           "md"
                                           (record-get x :size))))
        p (passthrough (record-get x :extra))
        merged (if (string=? p "") own (join-attr own p))
        ided (maybe-attr merged "id" (record-get x :id))
        named (maybe-attr ided "name" (record-get x :name))
        req (flag-attr named "required" (record-get x :required))
        dis (flag-attr req "disabled" (record-get x :disabled))]
    (maybe-attr dis "aria-describedby" (record-get x :describedby))))

;; --- notification-banner: the icon table -----------------------------------
;; A closed table with a fallback, not a lookup that can fail. An unknown type
;; renders as info rather than as nothing: a banner with no icon still carries
;; its message, and a banner that throws carries none.

(defn known-type? [t :string] :bool
  (or (string=? t "success")
      (string=? t "error")
      (string=? t "warning")
      (string=? t "info-1")
      (string=? t "info-2")))

(defn icon-type [t :string] :string
  (if (known-type? t) t "info-1"))

(defn icon-label [t :string] :string
  (let [k (icon-type t)]
    (if (string=? k "success") "成功"
        (if (string=? k "error") "エラー"
            (if (string=? k "warning") "警告" "インフォメーション")))))

(defn banner-attrs [t :string style :string id :string extra :document] :string
  (let [own (join-attr (join-attr (attr "class" "dads-notification-banner")
                                  (attr "data-style" (if (string=? style "") "standard" style)))
                       (attr "data-type" t))
        p (passthrough extra)
        merged (if (string=? p "") own (join-attr own p))]
    (maybe-attr merged "id" id)))

(defn heading-tag [level :i64] :string
  (string-concat "h" (string-from-i64 level)))

(defn main []
  (string-byte-length
   (options-attrs (document-vector
                   (document-map :value (document-string "") :name (document-string "選択"))
                   (document-map :value (document-string "18") :name (document-string "18mm")))
                  "18" true)))
