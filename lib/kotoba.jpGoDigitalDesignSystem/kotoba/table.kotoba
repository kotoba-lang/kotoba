(ns table
  ;; The entry points are exported, so a host can call them.
  ;;
  ;; There was no list here at all, and the comment gave the parity harness as
  ;; the reason -- it appends zero-arg case defns and executes those. That was
  ;; never what stopped a list; it is the last module in this repo to get one,
  ;; and `jp-go-dds.core/table` now calls `row-header-cell?` through
  ;; `jp-go-dds.kotoba-oracle`, which runs exported functions only.
  (:export [main header-tag header-attrs row-header-cell? body-cell-tag
            body-cell-attrs])
  (:schemas {:tbl/cell [:record :tbl/cell
                        [[:row-header :bool] [:index :i64]]]}))

;; W6 slice 7 for jp-go-dds: the semantic cell decisions in `core/table`.
;;
;; The surrounding hiccup is a fixed table/the(a)d/tbody/tr nest.  The decision
;; is which cells are headers, and therefore which tag, class, and `scope`
;; attribute they carry:
;;
;;   - every item in `:headers` is a `th.dads-table__col-header[scope=col]`;
;;   - when `:row-header?` is true, only cell zero in every body row is a
;;     `th.dads-table__row-header[scope=row]`;
;;   - every other body cell is a plain `td` with no borrowed header attrs.
;;
;; `scope` is accessibility semantics, not styling.  Keeping tag and attrs in
;; one rule prevents a future refactor from producing a visually plausible
;; `td scope=row` or a `th` whose relationship is absent.
;;
;; Capability-free (kotoba/pure).

(defn header-tag [] :string "th")

(defn header-attrs [] :string
  "class=\"dads-table__col-header\" scope=\"col\"")

(defn row-header-cell? [cell [:ref :tbl/cell]] :bool
  (if (record-get cell :row-header) (= (record-get cell :index) 0) false))

(defn body-cell-tag [cell [:ref :tbl/cell]] :string
  (if (row-header-cell? cell) "th" "td"))

(defn body-cell-attrs [cell [:ref :tbl/cell]] :string
  (if (row-header-cell? cell)
    "class=\"dads-table__row-header\" scope=\"row\""
    ""))

(defn main []
  (string-byte-length
   (body-cell-attrs (record-new [:ref :tbl/cell] true 0))))
