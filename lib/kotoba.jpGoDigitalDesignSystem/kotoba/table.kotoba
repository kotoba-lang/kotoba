(ns table
  ;; The entry points are exported, so a host can call them.
  ;;
  ;; There was no list here at all, and the comment gave the parity harness as
  ;; the reason -- it appends zero-arg case defns and executes those. That was
  ;; never what stopped a list; it is the last module in this repo to get one,
  ;; and `jp-go-dds.core/table` now calls `row-header-cell?` through
  ;; `jp-go-dds.kotoba-oracle`, which runs exported functions only.
  (:export [main header-tag header-attrs row-header-cell? body-cell-tag
            body-cell-attrs header-cell-node body-cell-node])
  (:schemas {:tbl/cell [:record :tbl/cell
                        [[:row-header :bool] [:index :i64]]]}))

;; W6 slice 7 for jp-go-dds: the semantic cell decisions in `core/table`.
;;
;; The surrounding hiccup is a fixed table/the(a)d/tbody/tr nest.  The decision
;; is which cells are headers, and therefore which tag, class, and `scope`
;; attribute they carry:
;;
;;   - every item in `:headers` is a `th.dads-table__col-header[scope=col]`;
;;   - when `:row-header?` is true, only cell zero in every body row is a
;;     `th.dads-table__row-header[scope=row]`;
;;   - every other body cell is a plain `td` with no borrowed header attrs.
;;
;; `scope` is accessibility semantics, not styling.  Keeping tag and attrs in
;; one rule prevents a future refactor from producing a visually plausible
;; `td scope=row` or a `th` whose relationship is absent.
;;
;; Capability-free (kotoba/pure).

(defn header-tag [] :string "th")

(defn header-attrs [] :string
  "class=\"dads-table__col-header\" scope=\"col\"")

(defn row-header-cell? [cell [:ref :tbl/cell]] :bool
  (if (get cell :row-header) (= (get cell :index) 0) false))

(defn body-cell-tag [cell [:ref :tbl/cell]] :string
  (if (row-header-cell? cell) "th" "td"))

(defn body-cell-attrs [cell [:ref :tbl/cell]] :string
  (if (row-header-cell? cell)
    "class=\"dads-table__row-header\" scope=\"row\""
    ""))

(defn header-cell-node [text :document sortable :bool] :document
  ;; Hiccup counterpart of core/table's column header.
  (let [base (document-map :class (document-string "dads-table__col-header") :scope (document-string "col"))
        attrs (if sortable (document-assoc base :aria-sort (document-string "none")) base)
        content (if sortable (document-vector (document-keyword :button) (document-map :type (document-string "button")) text) text)]
    (document-vector (document-keyword :th) attrs content)))

(defn body-cell-node [cell [:ref :tbl/cell] content :document] [:option :document]
  ;; A map with :text is a rich cell; simple scalar/tree cells pass through.
  ;; The string form of collection sort keys is not yet qualified: refuse it.
  (let [is-rich (and (= (document-kind content) :map) (document-contains content :text))
        text (if is-rich (option-value-of [:option :document] (document-get content :text) (document-null)) content)
        sort (if is-rich (option-value-of [:option :document] (document-get content :sort-value) (document-null)) (document-null))
        kind (document-kind sort)
        supported (or (= kind :null) (= kind :string) (= kind :i64) (= kind :bool) (= kind :keyword) (= kind :symbol))
        sort-text (if (= kind :string) (option-value-of [:option :string] (document-string-value sort) "") (document-edn-print sort))
        row? (row-header-cell? cell)
        base (if row? (document-map :class (document-string "dads-table__row-header") :scope (document-string "row")) (document-map))
        attrs (if (= kind :null) base (document-assoc base :data-sort-value (document-string sort-text)))
        tag (if row? (document-keyword :th) (document-keyword :td))]
    (if supported (option-some-of [:option :document] (document-vector tag attrs text))
                  (option-none-of [:option :document]))))

(defn main []
  (string-byte-length
   (body-cell-attrs (record-new [:ref :tbl/cell] true 0))))
