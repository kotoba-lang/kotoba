(ns components
  ;; The entry points are exported, so a host can call them.
  ;;
  ;; They were not, and the comment here named this harness as the reason. The
  ;; harness is not the reason and neither is the value boundary -- a
  ;; `:document` crosses the KIR entry boundary in both directions, host-built,
  ;; with a wrong tag refused rather than coerced (measured 2026-08-12,
  ;; `dark_mirror`). What refused a list was `main` below, which a declared
  ;; list must contain, plus `ir/execute` running exported functions only,
  ;; which the harness answers by widening the list with its own case names.
  (:export [main heading-tag heading-attrs chip-attrs input-attrs textarea-attrs toggle-outer-attrs toggle-input-attrs requirement-attrs status-attrs marker-class-for])
  (:schemas {:c/passthrough [:record :c/passthrough
                             [[:extra :document]
                              [:owned :document]
                              [:index :i64]
                              [:n :i64]
                              [:acc :string]]]
             :c/input [:record :c/input
                       [[:size :string] [:type :string] [:extra :document]]]
             :c/textarea [:record :c/textarea
                          [[:rows :string] [:extra :document]]]
             :c/toggle [:record :c/toggle
                        [[:kind :string]
                         [:size :string]
                         [:name :string]
                         [:value :string]
                         [:id :string]
                         [:checked :bool]
                         [:disabled :bool]]]
             :c/marker [:record :c/marker
                        [[:requirement :string]
                         [:required :bool]
                         [:status :string]]]}))

;; The rest of the DADS components' attribute decisions.
;;
;; W6 slice 5 for jp-go-dds, continuing from `button.kotoba`. Same finding as
;; that slice: a component's markup is a fixed nest of elements, and everything
;; it actually decides is in the attributes. Seven decisions live here.
;;
;;   heading      level → tag, and level → the upstream data-size, with a
;;                fallback for a level outside 1..6
;;   chip-label   two defaults
;;   input-text   default size; `type` defaults to "text"; `:size` is consumed
;;                into data-size rather than passed through as an attribute
;;   textarea     default rows
;;   checkbox     default size; which attributes appear at all
;;   radio        the same shape, with name/value
;;   form-field   `__requirement` vs `__status` — see below
;;
;; ## The one that is not a default
;;
;; A required/optional marker is `__requirement` with `data-required`, and
;; `__status` is a grey filled badge meaning something else entirely ("入力済み"
;; and the like). Using `__status` as a required marker is not a style choice,
;; it is wrong, and the `.cljc` docstring records that this repo did exactly
;; that once. A decision that has already been made incorrectly in practice is
;; the kind worth holding somewhere a test can reach.
;;
;; ## Conventions carried over from button.kotoba
;;
;; - "" means absent, so the records stay inside the native word-typed gate;
;; - attributes come out in a fixed documented order, not sorted;
;; - the component's own attributes are emitted by the component and removed
;;   from passthrough, so one list answers for both.
;;
;; Capability-free (kotoba/pure).

;; --- shared attribute text -------------------------------------------------

(defn attr [name :string value :string] :string
  (string-concat name (string-concat "=\"" (string-concat value "\""))))

(defn join-attr [acc :string one :string] :string
  (if (string=? acc "") one (string-concat acc (string-concat " " one))))

(defn maybe-attr [acc :string name :string value :string] :string
  (if (string=? value "") acc (join-attr acc (attr name value))))

(defn flag-attr [acc :string name :string on :bool] :string
  (if on (join-attr acc (attr name "true")) acc))

(defn entry-name [d :document] :string
  (option-or
    (document-string-value (option-or (document-get d :name) (document-null)))
    ""))

(defn entry-value [d :document] :string
  (option-or
    (document-string-value (option-or (document-get d :value) (document-null)))
    ""))

;; --- passthrough, minus whatever the component owns -------------------------

(defn owned-from [owned :document needle :string i :i64 n :i64] :bool
  (if (>= i n)
    false
    (or (string=? (entry-name (option-or (document-vector-at owned i) (document-null)))
                  needle)
        (owned-from owned needle (+ i 1) n))))

(defn owned? [owned :document needle :string] :bool
  (owned-from owned needle 0 (document-count owned)))

(defn passthrough-from [x [:ref :c/passthrough]] :string
  (let [extra (record-get x :extra)
        owned (record-get x :owned)
        i (record-get x :index)
        n (record-get x :n)
        acc (record-get x :acc)]
    (if (>= i n)
      acc
      (let [d (option-or (document-vector-at extra i) (document-null))
            next (if (owned? owned (entry-name d))
                   acc
                   (join-attr acc (attr (entry-name d) (entry-value d))))]
        (passthrough-from (record-new [:ref :c/passthrough] extra owned (+ i 1) n next))))))

(defn passthrough [extra :document owned :document] :string
  (passthrough-from (record-new [:ref :c/passthrough]
                                extra owned 0 (document-count extra) "")))

(defn append [acc :string more :string] :string
  (if (string=? more "") acc (join-attr acc more)))

;; --- heading ---------------------------------------------------------------
;; The upstream sizes are a table, not a formula, so it is written as one. A
;; level outside 1..6 keeps "20" rather than failing: `heading` is called with
;; a literal level at every site, and a page that asks for h7 has a bug in its
;; document outline, not in its type size.

(defn heading-tag [level :i64] :string
  (string-concat "h" (string-from-i64 level)))

(defn heading-size [level :i64] :string
  (if (= level 1) "45"
      (if (= level 2) "32"
          (if (= level 3) "24"
              (if (= level 4) "20"
                  (if (= level 5) "18"
                      (if (= level 6) "16" "20")))))))

(defn heading-attrs [level :i64 size :string id :string] :string
  (maybe-attr (join-attr (attr "class" "dads-heading")
                         (attr "data-size" (if (string=? size "") (heading-size level) size)))
              "id" id))

;; --- chip-label ------------------------------------------------------------

(defn chip-attrs [color :string style :string] :string
  (join-attr (join-attr (attr "class" "dads-chip-label")
                        (attr "data-style" (if (string=? style "") "text" style)))
             (attr "data-color" (if (string=? color "") "blue" color))))

;; --- input-text ------------------------------------------------------------
;; `:size` is not an input attribute here — it is consumed into `data-size`.
;; Passing it through as well would emit `size="md"`, which HTML reads as a
;; character-width hint and DADS does not mean.

(defn input-owned [] :document
  (document-vector
   (document-map :name (document-string "size") :value (document-string ""))
   (document-map :name (document-string "class") :value (document-string ""))
   (document-map :name (document-string "data-size") :value (document-string ""))
   (document-map :name (document-string "type") :value (document-string ""))))

(defn input-attrs [x [:ref :c/input]] :string
  (let [size (record-get x :size)
        t (record-get x :type)
        base (join-attr (join-attr (attr "class" "dads-input-text__input")
                                   (attr "data-size" (if (string=? size "") "md" size)))
                        (attr "type" (if (string=? t "") "text" t)))]
    (append base (passthrough (record-get x :extra) (input-owned)))))

;; --- textarea --------------------------------------------------------------

(defn textarea-owned [] :document
  (document-vector
   (document-map :name (document-string "class") :value (document-string ""))
   (document-map :name (document-string "rows") :value (document-string ""))))

(defn textarea-attrs [x [:ref :c/textarea]] :string
  (let [rows (record-get x :rows)
        base (join-attr (attr "class" "dads-textarea__textarea")
                        (attr "rows" (if (string=? rows "") "4" rows)))]
    (append base (passthrough (record-get x :extra) (textarea-owned)))))

;; --- checkbox / radio ------------------------------------------------------
;; One shape, two kinds. The outer label carries the size; the input carries
;; identity and state. `name` and `value` only exist on radio, so they are
;; emitted only when supplied rather than by asking which kind this is.

(defn toggle-outer-attrs [x [:ref :c/toggle]] :string
  (let [kind (record-get x :kind)
        size (record-get x :size)]
    (join-attr (attr "class" (string-concat "dads-" kind))
               (attr "data-size" (if (string=? size "") "md" size)))))

(defn toggle-input-attrs [x [:ref :c/toggle]] :string
  (let [kind (record-get x :kind)
        base (join-attr (attr "class" (string-concat "dads-"
                                                     (string-concat kind "__input")))
                        (attr "type" kind))
        named (maybe-attr base "name" (record-get x :name))
        valued (maybe-attr named "value" (record-get x :value))
        ided (maybe-attr valued "id" (record-get x :id))
        checked (flag-attr ided "checked" (record-get x :checked))]
    (flag-attr checked "disabled" (record-get x :disabled))))

;; --- form-field markers ----------------------------------------------------

(defn requirement-attrs [x [:ref :c/marker]] :string
  (join-attr (attr "class" "dads-form-control-label__requirement")
             (attr "data-required" (if (record-get x :required) "true" "false"))))

(defn status-attrs [x [:ref :c/marker]] :string
  (attr "class" "dads-form-control-label__status"))

(defn marker-class-for [x [:ref :c/marker]] :string
  ;; Which class a required/optional marker gets. A marker is a requirement,
  ;; never a status, regardless of how it reads.
  (if (string=? (record-get x :requirement) "")
    ""
    "dads-form-control-label__requirement"))

(defn main []
  (string-byte-length (heading-attrs 3 "" "")))
