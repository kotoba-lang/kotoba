(ns button
  ;; The entry points are exported, so a host can call them.
  ;;
  ;; They were not, and the comment here named this harness as the reason. The
  ;; harness is not the reason and neither is the value boundary -- a
  ;; `:document` crosses the KIR entry boundary in both directions, host-built,
  ;; with a wrong tag refused rather than coerced (measured 2026-08-12,
  ;; `dark_mirror`). What refused a list was `main` below, which a declared
  ;; list must contain, plus `ir/execute` running exported functions only,
  ;; which the harness answers by widening the list with its own case names.
  (:export [main tag attrs open-tag])
  (:schemas {:btn/opts [:record :btn/opts
                        [[:type :string]
                         [:size :string]
                         [:href :string]
                         [:id :string]
                         [:aria-label :string]
                         [:submit :bool]
                         [:disabled :bool]
                         [:extra :document]]]
             :btn/extra-from [:record :btn/extra-from
                              [[:extra :document]
                               [:index :i64]
                               [:n :i64]
                               [:acc :string]]]}))

;; The DADS button's attribute decision.
;;
;; W6 slice 4 for jp-go-dds: the first component. What a component decides is
;; not its markup — one element with a text child — but its attributes:
;;
;;   1. defaults. `:type` is `:solid-fill` and `:size` is "md" unless asked
;;      otherwise, so a caller writes `(button "OK")` and still gets a real
;;      DADS button rather than an unstyled one.
;;   2. element choice. A `:href` makes it an `<a>`; without one it is a
;;      `<button>` that carries `type="button"` or `type="submit"` and may be
;;      disabled. `disabled` on an `<a>` is not a thing, so the two branches
;;      genuinely differ rather than sharing a superset.
;;   3. precedence. `:attrs` passes arbitrary attributes through — data-*,
;;      aria-*, hx-* — but `class`, `data-type` and `data-size` are applied
;;      AFTER it and cannot be overridden. That is the component's identity;
;;      if a caller could overwrite it, the way to get a selectable hook would
;;      be to copy the DADS button's CSS into the app, which is the thing this
;;      library exists to stop.
;;
;; ## Absent is the empty string here
;;
;; Every optional field is a `:string` where "" means absent, rather than
;; `[:option :string]`. Both are expressible; this one keeps the record inside
;; the native word-typed admission gate, and the caller boundary is the host
;; adapter, which already knows the difference between nil and "".
;;
;; ## Order is part of the contract
;;
;; Attributes are emitted in a fixed order — class, data-type, data-size, then
;; id, aria-label, then the element-specific ones, then passthrough in the
;; order given — rather than sorted. Sorting would need a comparator over
;; document entries for no benefit: the caller supplies passthrough already
;; ordered, and a fixed order is what makes the output comparable at all.
;;
;; Capability-free (kotoba/pure).

;; --- defaults -------------------------------------------------------------

(defn or-default [v :string fallback :string] :string
  (if (string=? v "") fallback v))

(defn button-type [x [:ref :btn/opts]] :string
  (or-default (record-get x :type) "solid-fill"))

(defn button-size [x [:ref :btn/opts]] :string
  (or-default (record-get x :size) "md"))

;; --- element choice -------------------------------------------------------

(defn anchor? [x [:ref :btn/opts]] :bool
  (not (string=? (record-get x :href) "")))

(defn tag [x [:ref :btn/opts]] :string
  (if (anchor? x) "a" "button"))

(defn native-type [x [:ref :btn/opts]] :string
  ;; Only meaningful on <button>; an <a> never carries it.
  (if (record-get x :submit) "submit" "button"))

;; --- attribute text -------------------------------------------------------

(defn attr [name :string value :string] :string
  (string-concat name (string-concat "=\"" (string-concat value "\""))))

(defn join-attr [acc :string one :string] :string
  (if (string=? acc "") one (string-concat acc (string-concat " " one))))

(defn maybe-attr [acc :string name :string value :string] :string
  (if (string=? value "") acc (join-attr acc (attr name value))))

;; --- passthrough ----------------------------------------------------------
;; An `:attrs` entry is a `{:name :value}` document map, the same shape the
;; bridge uses for its entries. The host adapter has already dropped any entry
;; whose name the component owns, because "the library wins" is a decision
;; about which entries exist, not about how they are spelled.

(defn extra-name [d :document] :string
  (option-or
    (document-string-value (option-or (document-get d :name) (document-null)))
    ""))

(defn extra-value [d :document] :string
  (option-or
    (document-string-value (option-or (document-get d :value) (document-null)))
    ""))

(defn owned? [name :string] :bool
  ;; The three the component will not yield. Kept here rather than in the host
  ;; so that both the filtering and the emitting answer to one list.
  (or (string=? name "class")
      (string=? name "data-type")
      (string=? name "data-size")))

(defn extras-from [x [:ref :btn/extra-from]] :string
  (let [extra (record-get x :extra)
        i (record-get x :index)
        n (record-get x :n)
        acc (record-get x :acc)]
    (if (>= i n)
      acc
      (let [d (option-or (document-vector-at extra i) (document-null))
            next (if (owned? (extra-name d))
                   acc
                   (join-attr acc (attr (extra-name d) (extra-value d))))]
        (extras-from (record-new [:ref :btn/extra-from] extra (+ i 1) n next))))))

(defn extras [x [:ref :btn/opts]] :string
  (let [e (record-get x :extra)]
    (extras-from (record-new [:ref :btn/extra-from] e 0 (document-count e) ""))))

;; --- the whole attribute list ---------------------------------------------

(defn identity-attrs [x [:ref :btn/opts]] :string
  (join-attr (join-attr (attr "class" "dads-button")
                        (attr "data-type" (button-type x)))
             (attr "data-size" (button-size x))))

(defn common-attrs [x [:ref :btn/opts]] :string
  (maybe-attr (maybe-attr (identity-attrs x) "id" (record-get x :id))
              "aria-label" (record-get x :aria-label)))

(defn element-attrs [x [:ref :btn/opts]] :string
  (if (anchor? x)
    (join-attr (common-attrs x) (attr "href" (record-get x :href)))
    (let [with-type (join-attr (common-attrs x) (attr "type" (native-type x)))]
      (if (record-get x :disabled)
        (join-attr with-type (attr "disabled" "true"))
        with-type))))

(defn attrs [x [:ref :btn/opts]] :string
  (let [e (extras x)]
    (if (string=? e "")
      (element-attrs x)
      (join-attr (element-attrs x) e))))

(defn open-tag [x [:ref :btn/opts]] :string
  (string-concat "<" (string-concat (tag x)
                                    (string-concat " " (string-concat (attrs x) ">")))))

(defn main []
  (string-byte-length
   (attrs (record-new [:ref :btn/opts] "" "" "" "" "" false false (document-vector)))))
