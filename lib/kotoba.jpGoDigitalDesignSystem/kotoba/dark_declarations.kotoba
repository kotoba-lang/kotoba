(ns dark-declarations
  ;; The entry points are exported, so a host can call them.
  ;;
  ;; They were not, and the comment here named this harness as the reason. The
  ;; harness is not the reason and neither is the value boundary -- a
  ;; `:document` crosses the KIR entry boundary in both directions, host-built,
  ;; with a wrong tag refused rather than coerced (measured 2026-08-12,
  ;; `dark_mirror`). What refused a list was `main` below, which a declared
  ;; list must contain, plus `ir/execute` running exported functions only,
  ;; which the harness answers by widening the list with its own case names.
  (:export [main rgba-black? invert-scrim dark-ramp light-ramp snapshot-ramp])
  (:schemas {:dd/entry [:record :dd/entry
                        [[:base :string]
                         [:steps :document]
                         [:index :i64]
                         [:value :string]]]
             :dd/ramp-from [:record :dd/ramp-from
                            [[:base :string]
                             [:steps :document]
                             [:values :document]
                             [:index :i64]
                             [:n :i64]
                             [:acc :string]]]}))

;; The dark / light / snapshot declarations, over declared palette data.
;;
;; `dark_mirror.kotoba` took the ramp rule. This takes what the rule is FOR: the
;; three declaration sets `jp-go-dds.dark` emits.
;;
;;   snapshot  --dds-light-X: <the light literal>      save light before shadowing
;;   dark      --color-X:     var(--dds-light-<mirror of X>)   walk the ramp back
;;   light     --color-X:     var(--dds-light-X)               put it back
;;
;; The saving step is not bookkeeping. Reversal is an involution, so writing
;; `--color-red-800: var(--color-red-400)` and its partner into the same element
;; is a CSS custom-property cycle and both go invalid. Every value on both sides
;; therefore points at the `--dds-light-*` copy, never at a live `--color-*`.
;;
;; ## What this module can own that the previous slice could not
;;
;; It reads `resources/jp_go_dds/palette.edn`, which `scripts/palette.cljk`
;; writes at vendor time from the same scan `jp-go-dds.dark` performs. That is
;; the design change the last slice named as its blocker: recovering structure
;; from CSS text with a regex cannot move to Kotoba, but once the recovery has
;; already happened and the result is declared data, everything downstream of it
;; is a pure function over values — which is exactly what Kotoba wants.
;;
;; The generator does the parsing; this module does the deciding. Nothing
;; derives the palette twice: `palette.cljs` calls the library's own functions,
;; and the gate fails if the committed EDN drifts from what they return today.
;;
;; Capability-free (kotoba/pure).

;; --- the ramp rule (same as dark_mirror) ----------------------------------

(defn mirror-index [n :i64 i :i64] :i64
  (- (- n 1) i))

(defn step-at [steps :document i :i64] :i64
  (option-or
    (document-i64-value (option-or (document-vector-at steps i) (document-null)))
    0))

(defn value-at [values :document i :i64] :string
  (option-or
    (document-string-value (option-or (document-vector-at values i) (document-null)))
    ""))

;; --- names ----------------------------------------------------------------

(defn step-name [base :string step :i64] :string
  (string-concat base (string-concat "-" (string-from-i64 step))))

(defn light-name [k :string] :string
  ;; `--color-X` → `--dds-light-X`. The `--dds-` namespace is how a reader tells
  ;; what upstream publishes from what this workspace added.
  (string-concat "--dds-light-" (string-substring k 8 (string-byte-length k))))

(defn light-ref [k :string] :string
  (string-concat "var(" (string-concat (light-name k) ")")))

;; --- the one exception to the uniform rule --------------------------------
;; White and black are not mirrored. Mirroring them would swap the page's paper
;; for its ink and back, which is not "the same ramp read backwards" — they are
;; the ends the ramp is measured against, not steps in it.

(defn page-surface [] :string
  "--dds-light-neutral-solid-gray-900")

(defn white-dark-value [] :string
  (string-concat "var(" (string-concat (page-surface) ")")))

(defn black-dark-value [] :string
  "var(--dds-light-neutral-white)")

;; --- opacity scrims -------------------------------------------------------
;; `rgba(0, 0, 0, 0.05)` → `rgba(255, 255, 255, 0.05)`. Only the base flips; the
;; alpha is taken from upstream's own declaration rather than computed from the
;; step name, so a ramp whose alpha stops tracking its name cannot drift here.
;; Every one of the 12 scrims in the vendored sheet is spelled exactly
;; `rgba(0, 0, 0, …)`; the gate asserts that, so a re-vendor that respaces them
;; fails loudly instead of leaving black scrims on a dark ground.

(defn rgba-black? [v :string] :bool
  (string-contains? v "rgba(0, 0, 0,"))

(defn invert-scrim [v :string] :string
  (string-replace-all v "rgba(0, 0, 0," "rgba(255, 255, 255,"))

;; --- the three declaration values -----------------------------------------

(defn dark-value [x [:ref :dd/entry]] :string
  (let [base (record-get x :base)
        steps (record-get x :steps)
        i (record-get x :index)
        value (record-get x :value)]
    (if (rgba-black? value)
      (invert-scrim value)
      (light-ref (step-name base (step-at steps (mirror-index (document-count steps) i)))))))

(defn light-value [x [:ref :dd/entry]] :string
  (light-ref (step-name (record-get x :base)
                        (step-at (record-get x :steps) (record-get x :index)))))

(defn snapshot-value [x [:ref :dd/entry]] :string
  (record-get x :value))

;; --- rendering a whole ramp ------------------------------------------------
;; One string per ramp, so a parity gate compares 12 values instead of 156.

(defn pair-text [name :string value :string] :string
  (string-concat name (string-concat "=" value)))

(defn dark-ramp-from [x [:ref :dd/ramp-from]] :string
  (let [base (record-get x :base)
        steps (record-get x :steps)
        values (record-get x :values)
        i (record-get x :index)
        n (record-get x :n)
        acc (record-get x :acc)]
    (if (>= i n)
      acc
      (let [entry (record-new [:ref :dd/entry] base steps i (value-at values i))
            line (pair-text (step-name base (step-at steps i)) (dark-value entry))
            next (if (string=? acc "") line (string-concat acc (string-concat " " line)))]
        (dark-ramp-from
         (record-new [:ref :dd/ramp-from] base steps values (+ i 1) n next))))))

(defn light-ramp-from [x [:ref :dd/ramp-from]] :string
  (let [base (record-get x :base)
        steps (record-get x :steps)
        values (record-get x :values)
        i (record-get x :index)
        n (record-get x :n)
        acc (record-get x :acc)]
    (if (>= i n)
      acc
      (let [entry (record-new [:ref :dd/entry] base steps i (value-at values i))
            line (pair-text (step-name base (step-at steps i)) (light-value entry))
            next (if (string=? acc "") line (string-concat acc (string-concat " " line)))]
        (light-ramp-from
         (record-new [:ref :dd/ramp-from] base steps values (+ i 1) n next))))))

(defn snapshot-ramp-from [x [:ref :dd/ramp-from]] :string
  (let [base (record-get x :base)
        steps (record-get x :steps)
        values (record-get x :values)
        i (record-get x :index)
        n (record-get x :n)
        acc (record-get x :acc)]
    (if (>= i n)
      acc
      (let [entry (record-new [:ref :dd/entry] base steps i (value-at values i))
            line (pair-text (light-name (step-name base (step-at steps i)))
                            (snapshot-value entry))
            next (if (string=? acc "") line (string-concat acc (string-concat " " line)))]
        (snapshot-ramp-from
         (record-new [:ref :dd/ramp-from] base steps values (+ i 1) n next))))))

(defn dark-ramp [base :string steps :document values :document] :string
  (dark-ramp-from (record-new [:ref :dd/ramp-from]
                              base steps values 0 (document-count steps) "")))

(defn light-ramp [base :string steps :document values :document] :string
  (light-ramp-from (record-new [:ref :dd/ramp-from]
                               base steps values 0 (document-count steps) "")))

(defn snapshot-ramp [base :string steps :document values :document] :string
  (snapshot-ramp-from (record-new [:ref :dd/ramp-from]
                                  base steps values 0 (document-count steps) "")))

(defn main []
  (string-byte-length
   (dark-ramp "--color-primitive-red"
              (document-vector (document-i64 400) (document-i64 800))
              (document-vector (document-string "#f00") (document-string "#800")))))
