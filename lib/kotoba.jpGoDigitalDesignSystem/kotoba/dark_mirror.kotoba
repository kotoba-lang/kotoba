(ns dark-mirror
  ;; The rule is exported, so a host can call it.
  ;;
  ;; It was not, and the comment here gave the harness as the reason -- it
  ;; appends zero-arg case defns and runs those. That is still how the harness
  ;; works, but it was never what stopped an export list, and neither was the
  ;; value boundary: measured 2026-08-12, a `:document` crosses the KIR entry
  ;; boundary in both directions as `["vector" [["i64" 50] ...]]`, the host can
  ;; build one, and a wrong tag is refused rather than coerced. What actually
  ;; refused a list was `main` below -- a declared export list must contain the
  ;; entry point, and this one did not. `main` is a smoke case, so it is listed
  ;; here rather than deleted.
  (:export [main mirror-index step-at mirror-step pair-text mirror-pairs])
  (:schemas {:dark/pairs-from [:record :dark/pairs-from
                               [[:steps :document]
                                [:index :i64]
                                [:n :i64]
                                [:acc :string]]]}))

;; The dark ramp mirror, as a rule rather than a table.
;;
;; `jp-go-dds.dark` states one rule in its docstring and everything else in
;; that namespace is machinery for applying it:
;;
;;     ramp の i 番目 → 同じ ramp の (n-1-i) 番目
;;
;; DADS publishes no dark palette. This workspace derives one by walking each
;; upstream ramp backwards, which invents no colour. The docstring is explicit
;; that uniformity is the point — mirroring by INDEX rather than by computing
;; `1000 - N` is what removes the per-ramp exception table, at the price of a
;; mid-grey landing a few units off. That trade is the decision, and it is what
;; this module owns.
;;
;; What stays in `.cljc`, deliberately:
;;
;; - `light-literals` / `ramps` / `opacity-inverted` scan the vendored CSS with
;;   regexes to recover structure from text. Porting a text scan is a migration
;;   of the wrong thing; the workspace rule is to replace the scan with declared
;;   data first, which is a separate change with its own evidence.
;; - the vendored `dds.css` is 72,114 bytes and `string-value-byte-limit` is
;;   65,536, so the whole sheet cannot be a Kotoba string value. Its `:root`
;;   block is 8,617 bytes and would fit — size is not what keeps the scan on
;;   the host, the scan itself is. Measured 2026-08-10; 156 literals in 12
;;   ramps of 12–13 steps, so every ramp fits one document value with room to
;;   spare against the 32-item container limit.
;;
;; Capability-free (kotoba/pure).

;; --- the rule -------------------------------------------------------------

(defn mirror-index [n :i64 i :i64] :i64
  (- (- n 1) i))

(defn step-at [steps :document i :i64] :i64
  (option-or
    (document-i64-value (option-or (document-vector-at steps i) (document-null)))
    0))

(defn mirror-step [steps :document i :i64] :i64
  ;; An odd-length ramp maps its middle step to itself. That is not a special
  ;; case in the code and should not become one: the midpoint of a monotone
  ;; ramp is still the midpoint when the ramp is reversed.
  (step-at steps (mirror-index (document-count steps) i)))

;; --- rendering the mirror as a comparable value ---------------------------

(defn pair-text [steps :document i :i64] :string
  (string-concat (string-from-i64 (step-at steps i))
                 (string-concat "->" (string-from-i64 (mirror-step steps i)))))

(defn pairs-from [x [:ref :dark/pairs-from]] :string
  (let [steps (record-get x :steps)
        i (record-get x :index)
        n (record-get x :n)
        acc (record-get x :acc)]
    (if (>= i n)
      acc
      (let [text (pair-text steps i)
            next (if (string=? acc "")
                   text
                   (string-concat acc (string-concat " " text)))]
        (pairs-from (record-new [:ref :dark/pairs-from] steps (+ i 1) n next))))))

(defn mirror-pairs [steps :document] :string
  ;; The whole ramp's mapping in one value, so a parity gate compares one
  ;; string per ramp rather than one call per step.
  (pairs-from (record-new [:ref :dark/pairs-from]
                          steps 0 (document-count steps) "")))

;; --- the escape hatch's name ----------------------------------------------
;; `--color-primitive-red-800` → `--dds-light-primitive-red-800`. The `--dds-`
;; prefix separates what upstream publishes from what this workspace adds, the
;; same reason `dds-ext-*` exists.

(defn light-name [k :string] :string
  (string-concat "--dds-light-" (string-substring k 8 (string-byte-length k))))

(defn light-name-checked [k :string] [:result :string :string]
  ;; The `.cljc` original slices unconditionally because it is only ever handed
  ;; names the regex already matched. Stating the precondition is free here and
  ;; `[:result T E]` is how Kotoba says it — `throw` is an intentional security
  ;; constraint, not a missing feature.
  (if (< (string-byte-length k) 8)
    (result-err-of [:result :string :string] "not a --color- name")
    (if (string=? (string-substring k 0 8) "--color-")
      (result-ok-of [:result :string :string] (light-name k))
      (result-err-of [:result :string :string] "not a --color- name"))))

(defn main []
  (string-byte-length
   (mirror-pairs (document-vector (document-i64 50)
                                  (document-i64 600)
                                  (document-i64 1200)))))
