(ns language-selector (:export [item opener search empty]))
;; Pure Hiccup language selector; event delegation and CSS are separate.
(defn- val [x [:option :document]] :document (option-value-of [:option :document] x (document-null)))
(defn- text [d :document k :keyword] :string (option-value-of [:option :string] (document-string-value (val (document-get d k))) ""))
(defn- some [d :document] [:option :document] (option-some-of [:option :document] d))
(defn- none [] [:option :document] (option-none-of [:option :document]))
(defn- svg [kind :i64] :document
 (cond (= kind 0) (document-edn-read "[:svg {:class \"dads-menu-list-box__opener-icon\" :width 24 :height 24 :viewBox \"0 0 24 24\" :fill \"currentcolor\" :aria-hidden \"true\"} [:path {:d \"M12 21.5A9.5 9.5 0 0 1 2.5 12c0-5.2 4.3-9.5 9.5-9.5s9.6 4.3 9.5 9.5c0 5.2-4.3 9.5-9.5 9.5Zm0-1.5c1-1.3 1.7-2.8 2.1-4.3H10c.4 1.5 1 3 2.1 4.3Zm-2-.3c-.8-1.2-1.4-2.6-1.7-4H5c1 2 3 3.5 5.2 4Zm4 0c2.2-.5 4-2 5-4h-3.3c-.4 1.4-1 2.8-1.8 4Zm-9.7-5.5H8a13 13 0 0 1 0-4.4H4.3a8 8 0 0 0 0 4.4Zm5.2 0h5c.2-1.5.2-3 0-4.4h-5c-.2 1.5-.2 3 0 4.4Zm6.5 0h3.7a8 8 0 0 0 0-4.4H16c.2 1.5.2 3 0 4.4Zm-.3-5.9H19c-1-2-3-3.5-5.2-4 .8 1.2 1.4 2.6 1.8 4Zm-5.8 0H14A12 12 0 0 0 12 4a12 12 0 0 0-2.1 4.3Zm-5 0h3.4c.4-1.4 1-2.8 1.8-4-2.3.5-4.1 2-5.2 4Z\"}]]")
       (= kind 1) (document-edn-read "[:svg {:class \"dads-menu-list-box__opener-arrow\" :width 16 :height 16 :viewBox \"0 0 24 24\" :fill \"currentcolor\" :aria-hidden \"true\"} [:path {:d \"m20.5 6.6-8 8-8-8L3.1 8l9.4 9.4L21.9 8l-1.4-1.4Z\"}]]")
       :else (document-edn-read "[:svg {:class \"dads-menu-list__front-icon dads-language-selector__check\" :width 24 :height 24 :viewBox \"0 0 24 24\" :fill \"currentcolor\" :aria-hidden \"true\"} [:path {:d \"m9.5 18-5.7-5.7 1.5-1.4 4.2 4.3L18.7 6l1.4 1.4L9.5 18Z\"}]]")))
(defn- item-with-icon [d :document current :string icon :document] [:option :document]
 (let [code (text d :code) label (text d :label) href (text d :href) aliases (text d :aliases)]
  (if (or (not (= (document-kind d) :map)) (string=? code "") (string=? label "") (string=? href "")) (none)
   (let [base (document-map :class (document-string "dads-menu-list__item") :data-language-selector-item (document-bool true)
        :data-language-selector-keywords (document-string (string-concat code (string-concat " " (string-concat label (string-concat " " aliases)))))
        :href (document-string href) :lang (document-string code) :hreflang (document-string code)
        :data-type (document-string "box") :data-size (document-string "regular"))
        attrs (if (string=? code current) (document-assoc (document-assoc base :data-current (document-bool true)) :aria-current (document-string "true")) base)]
    (some (document-vector (document-keyword :li) (document-vector (document-keyword :a) attrs icon
     (document-vector (document-keyword :bdi) (document-map :class (document-string "dads-menu-list__label")) (document-string label)))))))))
(defn item [d :document current :string] [:option :document]
 (if (= (document-kind d) :map) (item-with-icon d current (svg 2)) (none)))
(defn opener [prefix :string label :string] :document
 (let [prefix (if (string=? prefix "") "language-selector" prefix)
       attrs (document-map :id (document-string (string-concat prefix "-opener")) :class (document-string "dads-menu-list-box__opener") :type (document-string "button")
         :data-language-selector-opener (document-bool true) :aria-label (document-string (string-concat "Language: " label))
         :aria-controls (document-string (string-concat prefix "-popup")) :aria-expanded (document-string "false")
         :data-size (document-string "sm") :data-style (document-string "text") :data-text-weight (document-string "normal"))]
  (document-vector (document-keyword :button) attrs (svg 0)
   (document-vector (document-keyword :span) (document-map :data-language-selector-current (document-bool true)) (document-string label)) (svg 1))))
(defn search [] :document
 (document-vector (document-keyword :input) (document-map :type (document-string "search") :class (document-string "dads-input-text dads-language-selector__search")
  :data-language-selector-search (document-bool true) :aria-label (document-string "Search languages") :placeholder (document-string "Search languages")
  :autocomplete (document-string "off") :spellcheck (document-string "false"))))
(defn empty [] :document
 (document-vector (document-keyword :p)
  (document-map :data-language-selector-empty (document-bool true) :role (document-string "status") :hidden (document-bool true)) (document-string "No matching languages")))
