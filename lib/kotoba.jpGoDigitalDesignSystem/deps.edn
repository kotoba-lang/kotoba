{:paths ["src" "resources"]
 ;; jp-go-digital-design-system — デジタル庁デザインシステム(DADS)の HTML
 ;; コンポーネント例を cljc hiccup 化。ADR-2607141915 (com-junkawasaki/root)。
 ;; CSS は上流(MIT)を vendor(resources/jp_go_dds/dds.css、scripts/vendor.sh)。
 :deps {
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}
        io.github.kotoba-lang/html {:local/root "../kotoba.html"}
        io.github.kotoba-lang/css {:local/root "../kotoba.css"}
        io.github.kotoba-lang/osaho
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "b94158fd48ec541b70d3c455912a06f407537ddc"
         :deps/root "lib/kotoba.osaho"}}
 :aliases
 ;; kotoba-lang/amu is TEST-ONLY, for the parity gate that compiles
 ;; kotoba/bridge_document.kotoba and requires byte-identical CSS emission to
 ;; jp-go-dds.tokens/bridge-css (ADR-2607270100 §10, migration plan W6). The
 ;; library itself has no runtime dependency on it — consumers keep requiring
 ;; jp-go-dds.tokens, which is unchanged.
 {:test {:extra-paths ["test"]
         :extra-deps  {
                       io.github.kotoba-lang/amu
                       {:git/url "https://github.com/kotoba-lang/amu.git"
                        ;; string=? / string-contains? are :bool (1e21a1f).
                        ;; 875e3882 still typed them :i64.
                        :git/sha "203a957efa36c6eadd6b9f523266dd6f4e46f513"}}}}}
