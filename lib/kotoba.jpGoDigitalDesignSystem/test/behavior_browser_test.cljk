#!/usr/bin/env kbb
;; The behavior layer measured in a real browser (owner direction 2026-09-16:
;; a Radix-shaped headless layer for DADS). The string tests pin the markers;
;; this pins what a person gets: a dialog that traps and returns focus, a menu
;; that opens on the keyboard and closes on Escape / outside, tabs on arrows
;; with one panel visible, a combobox that filters and chooses, a toast that
;; leaves by itself, a radiogroup whose arrows choose — and (2026-09-16) a
;; popover that toggles and closes outside, a tooltip that waits and shows on
;; hover / focus, a select whose arrows choose into a hidden input, a slider
;; whose arrows and pointer move the value, and a menu at the bottom of the
;; viewport that flips up. Two bands (390 / 1280).
;;
;;   kbb --backend sci --classpath "src:test:../html/src:../css/src:../text/src" test/behavior_browser_test.cljk
;;
;; Same shape as app-kotoba-cloud/test/account-browser.cljk: the document is
;; rendered here from the wrappers, served by a child node process, driven by
;; playwright from the same child. exit 0 pass / 1 an assertion failed /
;; 2 REFUSED (playwright or a browser is not there — never a pass).
(ns behavior-browser-test
  (:require ["node:child_process" :as cp]
            ["node:fs" :as fs]
            ["node:os" :as os]
            ["node:path" :as node-path]
            ["node:process" :as proc]
            [html.core :as html]
            [jp-go-dds.core :as dds]
            [jp-go-dds.behavior :as behavior]
            [jp-go-dds.tokens :as tokens]))

(def port 8867)

(def document
  (str "<!doctype html><html lang=\"ja\"><head><meta charset=\"utf-8\">"
       "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">"
       "<link rel=\"stylesheet\" href=\"/dds.css\"><style>" tokens/bridge-css behavior/css
       "main{padding:1rem}section{margin-block:1rem}</style>"
       "<script src=\"/behavior.js\" defer></script></head><body><main id=\"main\">"
       (html/->html
        [:div
         [:section {:id "s-dialog"}
          (dds/button "開く" {:id "open-dialog" :attrs (behavior/dialog-open-attrs "dlg")})
          (dds/modal-dialog {:id "dlg" :heading "確認" :actions [(dds/button "OK" {:id "dlg-ok" :attrs (behavior/dialog-close-attrs "dlg")})]}
                            [:p "本文"] (dds/input-text {:id "dlg-input"}))]
         [:section {:id "s-menu"}
          (dds/menu-list-box {:id "menu" :label "メニュー"} [{:label "一つ目" :href "#one"} {:label "二つ目" :attrs {:id "item-two"}} {:label "三つ目" :href "#three"}])
          [:p {:id "after-menu"} "after"]]
         [:section {:id "s-tabs"}
          (dds/tab {:id "tabs"} [{:id "a" :label "A" :panel [:p {:id "panel-a-text"} "a"]} {:id "b" :label "B" :panel [:p {:id "panel-b-text"} "b"]} {:id "c" :label "C" :panel [:p "c"]}])]
         [:section {:id "s-combo"}
          (dds/combobox {:id "pref" :name "pref" :label "都道府県"} [{:value "13" :label "東京都" :keywords "tokyo とうきょう"} {:value "27" :label "大阪府" :keywords "osaka おおさか"} {:value "01" :label "北海道" :keywords "hokkaido"}])]
         [:section {:id "s-radio"}
          [:div {:role "radiogroup" :aria-label "表示" :data-behavior "radiogroup"}
           [:button {:type "button" :role "radio" :aria-checked "true" :id "r-light" :class "dads-button" :data-type "outline" :data-size "sm"} "light"]
           [:button {:type "button" :role "radio" :aria-checked "false" :id "r-dark" :class "dads-button" :data-type "outline" :data-size "sm"} "dark"]
           [:button {:type "button" :role "radio" :aria-checked "false" :id "r-system" :class "dads-button" :data-type "outline" :data-size "sm"} "system"]]]
         [:section {:id "s-disclosure"}
          [:button {:type "button" :id "more" :data-behavior "disclosure" :aria-expanded "false" :aria-controls "more-panel" :class "dads-button" :data-type "text" :data-size "sm"} "もっと見る"]
          [:div {:id "more-panel" :hidden true} [:p "hidden until asked"]]]
         [:section {:id "s-popover"}
          (dds/popover {:id "po" :label "詳細" :focus? true} [:p "補足"] (dds/button "了解" {:id "po-ok" :size "sm"}))
          [:p {:id "after-popover"} "after"]]
         [:section {:id "s-tooltip"}
          (dds/tooltip {:id "tt" :text "ヒント本文" :delay 100} (dds/button "?" {:id "tt-trigger" :size "sm" :type "outline"}))]
         [:section {:id "s-select"}
          (dds/select-listbox {:id "sz" :name "sz" :label "サイズ"} [{:value "s" :label "小"} {:value "m" :label "中"} {:value "l" :label "大"}])]
         [:section {:id "s-slider"}
          (dds/slider {:id "vol" :name "vol" :label "音量" :value 30 :step 5 :output? true})]
         [:section {:id "s-table"}
          (dds/table {:id "tbl" :sortable? true :filter {:id "tbl-filter" :label "絞る"}
                      :headers ["名前" "数量"]
                      :rows [["バナナ" {:text "10" :sort-value 10}] ["りんご" {:text "9" :sort-value 9}] ["みかん" {:text "100" :sort-value 100}]]})]
         [:div {:style "block-size:900px"}]
         [:section {:id "s-bottom"}
          (dds/menu-list-box {:id "bottom-menu" :label "下端"} [{:label "一" :attrs {:id "bm-one"}} {:label "二"} {:label "三"} {:label "四"} {:label "五"} {:label "六"}])]
         (dds/toast-region {})])
       "<script>document.addEventListener('click',e=>{const r=e.target.closest('[role=radio]');if(r){r.closest('[role=radiogroup]').querySelectorAll('[role=radio]').forEach(x=>x.setAttribute('aria-checked',x===r?'true':'false'));}});</script>"
       "</main></body></html>"))

(def script
  (str "
const http=require('node:http');const fs=require('node:fs');
const {chromium}=require(process.env.PLAYWRIGHT_MODULE||'/Users/junkawasaki/github/com-junkawasaki/node_modules/playwright');
const dir=process.env.BEHAVIOR_DIR;
const server=http.createServer((req,res)=>{const p=new URL(req.url,'http://x').pathname;const f={'/':'index.html','/index.html':'index.html','/dds.css':'dds.css','/behavior.js':'behavior.js'}[p];if(!f){res.writeHead(404).end();return;}res.setHeader('content-type',f.endsWith('.js')?'text/javascript':f.endsWith('.css')?'text/css':'text/html');res.end(fs.readFileSync(dir+'/'+f));});
(async()=>{
 await new Promise(r=>server.listen(" port ",'127.0.0.1',r));
 const browser=await chromium.launch({headless:true,channel:process.env.BROWSER_CHANNEL||'chrome'});
 const errors=[];let n=0;
 const ok=(c,m)=>{if(!c)throw new Error('ASSERT '+m);n++;};
 const active=p=>p.evaluate(()=>document.activeElement&&(document.activeElement.id||document.activeElement.className||document.activeElement.tagName));
 for(const width of [390,1280]){
  const page=await browser.newPage({viewport:{width,height:800}});page.on('pageerror',e=>errors.push(e.message));
  await page.goto('http://127.0.0.1:" port "/');
  await page.waitForFunction(()=>globalThis.jpGoDds&&globalThis.jpGoDds.behavior);
  ok(await page.evaluate(()=>document.documentElement.scrollWidth<=innerWidth),width+' no horizontal overflow');
  // --- dialog: opens modal, focus lands inside, Escape closes, focus returns to the opener
  await page.click('#open-dialog');
  ok(await page.evaluate(()=>document.getElementById('dlg').open),'dialog open');
  ok(await page.evaluate(()=>document.getElementById('dlg').matches(':modal')),'dialog is modal (showModal)');
  ok(await page.evaluate(()=>document.getElementById('dlg').contains(document.activeElement)),'focus inside the dialog, got '+await active(page));
  await page.keyboard.press('Tab');await page.keyboard.press('Tab');await page.keyboard.press('Tab');await page.keyboard.press('Tab');await page.keyboard.press('Tab');
  ok(await page.evaluate(()=>document.getElementById('dlg').contains(document.activeElement)),'Tab stays inside the modal (trap), got '+await active(page));
  await page.keyboard.press('Escape');
  ok(!(await page.evaluate(()=>document.getElementById('dlg').open)),'Escape closed');
  ok((await active(page))==='open-dialog','focus returned to the opener, got '+await active(page));
  await page.click('#open-dialog');await page.click('#dlg-ok');
  ok(!(await page.evaluate(()=>document.getElementById('dlg').open)),'command=close closes (invoker pair, native or polyfilled)');
  ok((await active(page))==='open-dialog','focus returned after OK');
  // --- menu: click opens with focus on the first item, arrows move, Escape closes to the opener, outside click closes
  await page.click('#menu-opener');
  ok(await page.evaluate(()=>!document.querySelector('#menu [data-menu-popup]').hidden),'menu open');
  ok(await page.evaluate(()=>document.getElementById('menu-opener').getAttribute('aria-expanded')==='true'),'aria-expanded true');
  ok(await page.evaluate(()=>document.activeElement.getAttribute('role')==='menuitem'),'first item focused, got '+await active(page));
  const layer=await page.evaluate(()=>{const m=document.querySelector('#menu [data-menu-popup]');const cs=getComputedStyle(m);return {pos:cs.position,z:cs.zIndex};});
  ok(layer.pos==='absolute'&&Number(layer.z)>=40,'popup floats: '+JSON.stringify(layer));
  await page.keyboard.press('ArrowDown');ok((await active(page))==='item-two','ArrowDown to the second item, got '+await active(page));
  await page.keyboard.press('End');ok(await page.evaluate(()=>document.activeElement.textContent.trim()==='三つ目'),'End to the last');
  await page.keyboard.press('Escape');
  ok(await page.evaluate(()=>document.querySelector('#menu [data-menu-popup]').hidden),'Escape closed the menu');
  ok((await active(page))==='menu-opener','focus back on the opener, got '+await active(page));
  await page.focus('#menu-opener');await page.keyboard.press('ArrowDown');
  ok(await page.evaluate(()=>!document.querySelector('#menu [data-menu-popup]').hidden),'ArrowDown on the opener opens');
  await page.mouse.click(5,5);
  ok(await page.evaluate(()=>document.querySelector('#menu [data-menu-popup]').hidden),'outside click closed');
  // --- tabs: one panel visible, ArrowRight selects the next and moves focus, End to the last, click on the anchor does not navigate
  ok(await page.evaluate(()=>document.getElementById('tabs-panel-a').hidden===false&&document.getElementById('tabs-panel-b').hidden===true),'one panel visible at load');
  await page.focus('#tabs-tab-a');await page.keyboard.press('ArrowRight');
  ok(await page.evaluate(()=>document.getElementById('tabs-tab-b').getAttribute('aria-selected')==='true'&&document.activeElement.id==='tabs-tab-b'),'ArrowRight selected + focused B');
  ok(await page.evaluate(()=>document.getElementById('tabs-panel-b').hidden===false&&document.getElementById('tabs-panel-a').hidden===true),'panel B shown, A hidden');
  await page.keyboard.press('End');ok(await page.evaluate(()=>document.activeElement.id==='tabs-tab-c'),'End to the last tab');
  await page.click('#tabs-tab-a');
  ok(await page.evaluate(()=>location.hash===''&&document.getElementById('tabs-tab-a').getAttribute('aria-selected')==='true'),'click selects without navigating (hash stays empty)');
  // --- combobox: typing filters, ArrowDown activates, Enter chooses into the hidden input, Escape closes
  await page.fill('#pref','おお');
  ok(await page.evaluate(()=>!document.getElementById('pref-listbox').hidden),'listbox opened on input');
  ok(await page.evaluate(()=>[...document.querySelectorAll('#pref-listbox [role=option]')].filter(o=>!o.parentElement.hidden).map(o=>o.textContent.trim()).join(','))==='大阪府','filtered to 大阪府');
  await page.keyboard.press('ArrowDown');
  ok(await page.evaluate(()=>document.getElementById('pref').getAttribute('aria-activedescendant')==='pref-listbox-1'),'ArrowDown activates the visible option');
  await page.keyboard.press('Enter');
  ok(await page.evaluate(()=>document.querySelector('[data-combobox-value]').value==='27'&&document.getElementById('pref').value==='大阪府'&&document.getElementById('pref-listbox').hidden),'Enter chose: hidden input 27, input shows the label, list closed');
  await page.fill('#pref','zzz');
  ok(await page.evaluate(()=>!document.querySelector('[data-combobox-empty]').hidden),'no match shows the empty message');
  ok(await page.evaluate(()=>document.querySelector('[data-combobox-value]').value===''),'typing again clears the chosen value');
  await page.keyboard.press('Escape');ok(await page.evaluate(()=>document.getElementById('pref-listbox').hidden),'Escape closed the list');
  // --- radiogroup: ArrowRight moves and chooses (the host's click handler ran)
  await page.focus('#r-light');await page.keyboard.press('ArrowRight');
  ok(await page.evaluate(()=>document.activeElement.id==='r-dark'&&document.getElementById('r-dark').getAttribute('aria-checked')==='true'&&document.getElementById('r-light').getAttribute('aria-checked')==='false'),'ArrowRight chose dark');
  ok(await page.evaluate(()=>document.getElementById('r-dark').tabIndex===0&&document.getElementById('r-light').tabIndex===-1),'roving tabindex followed');
  // --- disclosure
  await page.click('#more');
  ok(await page.evaluate(()=>!document.getElementById('more-panel').hidden&&document.getElementById('more').getAttribute('aria-expanded')==='true'),'disclosure opened');
  await page.click('#more');ok(await page.evaluate(()=>document.getElementById('more-panel').hidden),'disclosure closed');
  // --- toast: appears in the live region, leaves by itself; a sticky one stays; the close button dismisses
  await page.evaluate(()=>jpGoDds.behavior.toast({text:'保存しました',timeout:400}));
  ok(await page.evaluate(()=>document.querySelectorAll('[data-behavior=toast] .dds-ext-toast').length===1),'toast appended');
  const tl=await page.evaluate(()=>{const r=document.querySelector('[data-behavior=toast]');const cs=getComputedStyle(r);return {pos:cs.position,z:cs.zIndex};});
  ok(tl.pos==='fixed'&&Number(tl.z)>=80,'toast region is a fixed layer: '+JSON.stringify(tl));
  await page.waitForFunction(()=>document.querySelectorAll('[data-behavior=toast] .dds-ext-toast').length===0,null,{timeout:3000});n++;
  await page.evaluate(()=>jpGoDds.behavior.toast({text:'残る',timeout:0}));
  await page.waitForTimeout(700);
  ok(await page.evaluate(()=>document.querySelectorAll('[data-behavior=toast] .dds-ext-toast').length===1),'timeout 0 stays');
  await page.click('[data-toast-close]');
  await page.waitForFunction(()=>document.querySelectorAll('[data-behavior=toast] .dds-ext-toast').length===0,null,{timeout:3000});n++;
  // --- popover: click opens with focus inside, Escape closes to the opener, outside click closes; the panel floats
  await page.click('#po-opener');
  ok(await page.evaluate(()=>!document.getElementById('po-panel').hidden&&document.getElementById('po-opener').getAttribute('aria-expanded')==='true'),'popover open');
  ok((await active(page))==='po-ok','data-popover-focus moved focus in, got '+await active(page));
  const pl=await page.evaluate(()=>{const cs=getComputedStyle(document.getElementById('po-panel'));return {pos:cs.position,z:cs.zIndex};});
  ok(pl.pos==='absolute'&&Number(pl.z)>=40,'popover panel floats: '+JSON.stringify(pl));
  await page.keyboard.press('Escape');
  ok(await page.evaluate(()=>document.getElementById('po-panel').hidden),'Escape closed the popover');
  ok((await active(page))==='po-opener','focus back on the popover opener, got '+await active(page));
  await page.click('#po-opener');await page.mouse.click(5,5);
  ok(await page.evaluate(()=>document.getElementById('po-panel').hidden),'outside click closed the popover');
  // --- tooltip: hidden at rest, shows after the delay on hover, hides on leave; shows on focus, Escape hides
  ok(await page.evaluate(()=>document.getElementById('tt-tooltip').hidden),'tooltip hidden at rest');
  await page.hover('#tt-trigger');
  await page.waitForFunction(()=>!document.getElementById('tt-tooltip').hidden,null,{timeout:2000});n++;
  ok(await page.evaluate(()=>document.getElementById('tt-trigger').getAttribute('aria-describedby')==='tt-tooltip'),'trigger is described by the tooltip');
  await page.mouse.move(5,5);
  await page.waitForFunction(()=>document.getElementById('tt-tooltip').hidden,null,{timeout:2000});n++;
  await page.focus('#tt-trigger');
  await page.waitForFunction(()=>!document.getElementById('tt-tooltip').hidden,null,{timeout:2000});n++;
  await page.keyboard.press('Escape');
  ok(await page.evaluate(()=>document.getElementById('tt-tooltip').hidden),'Escape hid the tooltip');
  // --- select: ArrowDown opens on the first option, ArrowDown moves, Enter chooses into the hidden input and the button label; typeahead when closed chooses
  await page.focus('#sz');await page.keyboard.press('ArrowDown');
  ok(await page.evaluate(()=>!document.getElementById('sz-listbox').hidden&&document.getElementById('sz').getAttribute('aria-expanded')==='true'),'select opened on ArrowDown');
  ok(await page.evaluate(()=>document.getElementById('sz').getAttribute('aria-activedescendant')==='sz-listbox-0'),'first option active');
  await page.keyboard.press('ArrowDown');
  ok(await page.evaluate(()=>document.getElementById('sz').getAttribute('aria-activedescendant')==='sz-listbox-1'),'ArrowDown to the second option');
  await page.keyboard.press('Enter');
  ok(await page.evaluate(()=>document.querySelector('[data-select-value]').value==='m'&&document.querySelector('#sz [data-select-label]').textContent==='中'&&document.getElementById('sz-listbox').hidden),'Enter chose 中: hidden input m, label 中, list closed');
  ok((await active(page))==='sz','focus stays on the select button, got '+await active(page));
  await page.keyboard.press('Escape');await page.click('#sz');
  ok(await page.evaluate(()=>!document.getElementById('sz-listbox').hidden),'click opened the select');
  await page.click('#sz-listbox-2');
  ok(await page.evaluate(()=>document.querySelector('[data-select-value]').value==='l'),'click chose 大');
  // --- slider: arrows step, End goes to max, a click on the track lands near its fraction; the track fill follows
  await page.focus('#vol-thumb');
  ok(await page.evaluate(()=>document.getElementById('vol-thumb').getAttribute('aria-valuenow')==='30'),'slider starts at 30');
  await page.keyboard.press('ArrowRight');
  ok(await page.evaluate(()=>document.getElementById('vol-thumb').getAttribute('aria-valuenow')==='35'&&document.querySelector('[data-slider-value]').value==='35'&&document.querySelector('[data-slider-output]').textContent==='35'),'ArrowRight stepped by 5 into the hidden input and the output');
  await page.keyboard.press('End');
  ok(await page.evaluate(()=>document.getElementById('vol-thumb').getAttribute('aria-valuenow')==='100'&&document.getElementById('vol').style.getPropertyValue('--slider-value')==='100%'),'End to max, fill 100%');
  const tr=await page.evaluate(()=>{const r=document.querySelector('#vol [data-slider-track]').getBoundingClientRect();return {x:r.left+r.width*0.5,y:r.top+r.height/2};});
  await page.mouse.click(tr.x,tr.y);
  const mid=await page.evaluate(()=>Number(document.getElementById('vol-thumb').getAttribute('aria-valuenow')));
  ok(mid>=40&&mid<=60,'click at the middle of the track lands near 50, got '+mid);
  // --- table: a header button sorts ascending then descending (numeric on data-sort-value), aria-sort follows; the filter hides rows and counts
  const col=(i)=>page.evaluate((i)=>[...document.querySelectorAll('#tbl tbody tr')].filter(r=>!r.hidden).map(r=>r.children[i].textContent.trim()),i);
  ok((await col(1)).join(',')==='10,9,100','table starts in document order');
  ok(await page.evaluate(()=>document.querySelector('#tbl [data-table-count]').textContent==='3 / 3'),'count shows 3 / 3 at init');
  await page.click('#tbl thead th:nth-child(2) button');
  ok((await col(1)).join(',')==='9,10,100','ascending by number, not by text (100 after 10)');
  ok(await page.evaluate(()=>document.querySelector('#tbl thead th:nth-child(2)').getAttribute('aria-sort')==='ascending'&&document.querySelector('#tbl thead th:nth-child(1)').getAttribute('aria-sort')==='none'),'aria-sort on the active column only');
  await page.click('#tbl thead th:nth-child(2) button');
  ok((await col(1)).join(',')==='100,10,9','second click descends');
  await page.click('#tbl thead th:nth-child(1) button');
  ok((await col(0)).join(',')==='バナナ,みかん,りんご','text column sorts ascending by locale compare (kana order)');
  await page.fill('#tbl-filter','りん');
  ok((await col(0)).join(',')==='りんご','filter hides the rows that do not contain the text');
  ok(await page.evaluate(()=>document.querySelector('#tbl [data-table-count]').textContent==='1 / 3'),'count shows 1 / 3');
  await page.fill('#tbl-filter','');
  ok((await col(0)).length===3,'clearing the filter shows every row again');
  // --- placement: a menu at the bottom of the viewport flips up (data-placement=up) and stays inside the viewport
  await page.evaluate(()=>document.getElementById('s-bottom').scrollIntoView({block:'end'}));
  await page.evaluate(()=>window.scrollBy(0,-20));
  await page.click('#bottom-menu-opener');
  const bm=await page.evaluate(()=>{const p=document.querySelector('#bottom-menu [data-menu-popup]');const r=p.getBoundingClientRect();return {placement:p.getAttribute('data-placement'),bottom:r.bottom,top:r.top,vh:innerHeight,hidden:p.hidden};});
  ok(!bm.hidden&&bm.placement==='up'&&bm.bottom<=bm.vh&&bm.top>=0,'bottom menu flipped up and fits: '+JSON.stringify(bm));
  await page.keyboard.press('Escape');
  await page.close();
  console.log('PASS',width);
 }
 await browser.close();server.close();
 if(errors.length){console.log('PAGE ERRORS',JSON.stringify(errors));process.exit(1);}
 console.log('ASSERTIONS\\t'+n);
})().catch(e=>{console.error(String(e&&e.stack||e));server.close();process.exit(/Executable doesn't exist|Cannot find module|browserType.launch/.test(String(e))?2:1);});
"))

(defn -main []
  (let [dir (fs/mkdtempSync (node-path/join (.tmpdir os) "jp-go-dds-behavior-"))]
    (fs/writeFileSync (node-path/join dir "index.html") document)
    (fs/writeFileSync (node-path/join dir "dds.css") (fs/readFileSync "lib/kotoba.jpGoDigitalDesignSystem/resources/jp_go_dds/dds.css"))
    (fs/writeFileSync (node-path/join dir "behavior.js") behavior/script)
    (let [r (cp/spawnSync "node" #js ["-e" script] #js {:stdio "inherit" :cwd (.cwd proc)
                                                       :env (js/Object.assign #js {} (.-env proc) #js {:BEHAVIOR_DIR dir})})]
      (.exit proc (or (.-status r) 2)))))

(-main)
