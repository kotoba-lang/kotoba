(ns jp-go-dds.behavior-test
  (:require [kotoba.lang.text :as str]
            [clojure.test :refer [deftest is testing]]
            [jp-go-dds.behavior :as behavior]))

(deftest language-selector-behavior-contract
  (testing "the shared script binds only to the public component hooks"
    (doseq [hook ["data-language-selector]"
                  "data-language-selector-opener]"
                  "data-language-selector-popup]"
                  "data-language-selector-item]"]]
      (is (str/includes? behavior/language-selector-script hook))))
  (testing "keyboard and dismissal behaviour remain part of the component"
    (doseq [key ["Escape" "ArrowDown" "ArrowUp" "Home" "End"]]
      (is (str/includes? behavior/language-selector-script key)))
    (is (str/includes? behavior/language-selector-script "aria-expanded"))
    (is (str/includes? behavior/language-selector-script "popup.hidden"))))

(deftest the-behavior-runtime-answers-every-marker-it-declares
  (testing "one idempotent runtime, delegated on document, keyed by markers"
    (is (str/starts-with? behavior/script "(()=>{'use strict';"))
    (is (str/includes? behavior/script "if(globalThis.jpGoDds&&globalThis.jpGoDds.behavior)return;"))
    (doseq [[m {:keys [root]}] behavior/markers]
      (is (str/includes? behavior/script (str "data-behavior=\"" m "\"")) (str "the runtime never selects " m))
      (is (string? root))))
  (testing "the platform pieces each behaviour is built on are named in the script"
    (doseq [needle ["showModal()" "commandfor" "aria-expanded" "aria-activedescendant" "aria-selected" "tabindex"
                    "Escape" "ArrowDown" "ArrowUp" "ArrowLeft" "ArrowRight" "Home" "End" "Tab"
                    "prefers-reduced-motion" "data-timeout" "role=\"menuitem\"" "jp-go-dds:menu-open"
                    ;; opening a menu moves focus into it without scrolling
                    ;; its scroll container: measured 2026-09-16 on the shell
                    ;; rail band (overflow-x:auto), the first item's focus
                    ;; scrolled the rail 48px and the chip left its place
                    "focus({preventScroll:true})"
                    ;; 2026-09-16: the four new behaviours and collision-aware placement
                    "data-popover-opener" "role=\"tooltip\"" "aria-haspopup" "role=\"slider\"" "aria-valuenow"
                    "data-placement" "translateX(" "PageUp" "pointerdown"
                    "th[aria-sort] button" "data-table-filter" "localeCompare"]]
      (is (str/includes? behavior/script needle) needle)))
  (testing "the layer rules the audit measures are in css, on the token contract"
    (is (re-find #"\[data-menu-popup\]\[data-chrome=float\]\{position:absolute;[^}]*z-index:var\(--hig-z-float,40\)" behavior/css))
    (is (re-find #"\[data-behavior=toast\]\{position:fixed;[^}]*z-index:var\(--hig-z-toast,80\)" behavior/css))
    (is (str/includes? behavior/css "[data-behavior] [hidden]{display:none!important}"))
    (is (str/includes? behavior/css "@media(prefers-reduced-motion:reduce)"))
    (is (re-find #"\[data-chrome=float\]\[data-placement=up\]\{top:auto" behavior/css) "the flip the runtime sets has a rule")
    (is (re-find #"\[data-popover-panel\]\[data-chrome=float\]\{position:absolute;[^}]*z-index:var\(--hig-z-float,40\)" behavior/css))
    (is (re-find #"\[data-behavior=tooltip\] \[role=tooltip\]\{position:absolute;[^}]*z-index:var\(--hig-z-toast,80\)" behavior/css))
    (is (not (re-find #"#[0-9a-fA-F]{3,8}\b" behavior/css)) "no colour literal: --hig-* with a DADS primitive as the fallback")))
