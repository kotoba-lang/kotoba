(ns dds-components-test (:export [main]) (:require [components :as c] [table :as t]))
(defn main [] :i64
 (let [row (record-new [:ref :tbl/cell] true 0)
       data (record-new [:ref :tbl/cell] true 1)
       off (record-new [:ref :tbl/cell] false 0)]
  (if (and (string=? (c/heading-tag 2) "h2")
           (string=? (c/heading-attrs 2 "" "") "class=\"dads-heading\" data-size=\"32\"")
           (string=? (c/heading-attrs 3 "48" "top") "class=\"dads-heading\" data-size=\"48\" id=\"top\"")
           (document-equal? (option-value-of [:option :document]
             (c/container-node (document-vector (document-string "a") (document-string "b"))) (document-null))
             (document-vector (document-keyword :div) (document-map :class (document-string "dds-ext-container")) (document-string "a") (document-string "b")))
           (document-equal? (option-value-of [:option :document]
             (c/container-node (document-edn-read "[]")) (document-null))
             (document-vector (document-keyword :div) (document-map :class (document-string "dds-ext-container"))))
           (not (option-some?-of [:option :document] (c/container-node (document-string "not children"))))
           (string=? (t/header-tag) "th")
           (string=? (t/header-attrs) "class=\"dads-table__col-header\" scope=\"col\"")
           (t/row-header-cell? row) (not (t/row-header-cell? data)) (not (t/row-header-cell? off))
           (string=? (t/body-cell-tag row) "th") (string=? (t/body-cell-tag data) "td")
           (string=? (t/body-cell-attrs row) "class=\"dads-table__row-header\" scope=\"row\"")
           (string=? (t/body-cell-attrs data) "")
           (document-equal? (c/heading-node 2 (document-string "Title") "" "")
                            (document-vector (document-keyword :h2) (document-map :class (document-string "dads-heading") :data-size (document-string "32")) (document-string "Title")))
           (document-equal? (c/heading-node 3 (document-string "Title") "48" "top")
                            (document-vector (document-keyword :h3) (document-map :class (document-string "dads-heading") :data-size (document-string "48") :id (document-string "top")) (document-string "Title")))
           (document-equal? (t/header-cell-node (document-string "Name") true)
                            (document-vector (document-keyword :th) (document-map :class (document-string "dads-table__col-header") :scope (document-string "col") :aria-sort (document-string "none")) (document-vector (document-keyword :button) (document-map :type (document-string "button")) (document-string "Name"))))
           (document-equal? (option-value-of [:option :document] (t/body-cell-node row (document-string "A")) (document-null))
                            (document-vector (document-keyword :th) (document-map :class (document-string "dads-table__row-header") :scope (document-string "row")) (document-string "A")))
           (document-equal? (option-value-of [:option :document] (t/body-cell-node data (document-map :text (document-string "A") :sort-value (document-i64 12))) (document-null))
                            (document-vector (document-keyword :td) (document-map :data-sort-value (document-string "12")) (document-string "A")))
           (not (option-some?-of [:option :document] (t/body-cell-node data (document-map :text (document-string "A") :sort-value (document-vector (document-string "x"))))))) 42 7)))
