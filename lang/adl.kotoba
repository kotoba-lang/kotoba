;; Kotoba ADL -- the authority for the notation, written in the notation.
;;
;; This file is data. Nothing about it decides whether it runs; a schema and an
;; evaluator decide that. It is read by test/kotoba/adl_test.cljs, which
;; executes every conformance vector below -- a spec nothing reads is a spec
;; that drifts silently.

(map
  (:kotoba.adl/version 1)

  ;; ---- the four planes. A name belongs to exactly one of them. --------------
  (:kotoba.adl/planes
    (vector
      (map (:plane :notation)  (:name "Kotoba ADL")
           (:is "the pure S-expression surface humans and agents write"))
      (map (:plane :object)    (:name "Kotoba Form")
           (:is "the universal in-memory value: a tag and its children"))
      (map (:plane :schema)    (:name "Kotoba Schema")
           (:is "types, constraints and representation over Forms"))
      (map (:plane :canonical) (:name "DAG-Kotoba")
           (:is "the same value projected onto the IPLD Data Model, which is what gets a CID"))))

  ;; DAG-Kotoba is a data model profile, not a codec. The codec is DAG-CBOR and
  ;; io-ipld owns it. Nothing here re-implements it.
  (:kotoba.adl/codec (map (:canonical-bytes "DAG-CBOR") (:owner "kotoba-lang/io-ipld")))

  ;; ---- grammar. This is the whole of it. -----------------------------------
  (:kotoba.adl/grammar
    (map
      (:value  "scalar | form")
      (:scalar "nil | true | false | integer | float | string | keyword | symbol")
      (:form   "( value* )")))

  ;; ---- the nine IPLD kinds a canonical value may take ----------------------
  (:kotoba.adl/ipld-kinds
    (vector :null :bool :integer :float :string :bytes :list :map :link))

  ;; ---- surface spellings ---------------------------------------------------
  ;; Map entries are written (k v). Inside (map ...) a two-element form is
  ;; always an entry, so `entry` is not spelled out: this workspace has
  ;; 1,018,492 map keys and the word would cost six bytes on every one.
  (:kotoba.adl/well-known-tags
    (vector "vector" "list" "map" "set" "uuid" "timestamp" "bytes" "link" "tag" "with-meta"))

  ;; Why keywords survive into the surface rather than becoming strings at the
  ;; door: the corpus has 1,018,492 keyword keys AND 4,557 string keys, and 32
  ;; maps that use both. Stringifying keywords would collide with real string
  ;; keys and silently merge entries. Canonicalisation handles the collision
  ;; explicitly instead -- see :kotoba.adl/canonical-rule.
  (:kotoba.adl/canonical-rule
    (map
      (:string-keyed-map "stays an IPLD Map")
      (:otherwise "becomes (\"map\" [k v] ...) with entries in canonical key order")
      (:keyword "becomes (\"kw\" \"ns/name\")")
      (:symbol "becomes (\"sym\" \"name\")")))

  ;; ---- names this notation must never rename -------------------------------
  ;; An external tool owns these filenames. The clojure CLI requires deps.edn;
  ;; nbb requires nbb.edn. Renaming them breaks the toolchain and we cannot fix
  ;; it from here, so the converter refuses rather than skipping quietly.
  (:kotoba.adl/tool-owned-filenames
    (vector "deps.edn" "nbb.edn" "bb.edn" "shadow-cljs.edn" "figwheel-main.edn"))

  ;; A git-annex pointer file's whole content is a path into the annex. It is
  ;; not EDN. Converting one destroys the link to the bytes while every check
  ;; still reports success.
  (:kotoba.adl/never-convert (vector :git-annex-pointer :tool-owned-filename))

  ;; ---- conformance vectors. The test executes each one both ways. ----------
  (:kotoba.adl/vectors
    (vector
      (map (:edn "{:a 1}")                  (:adl "(map (:a 1))"))
      (map (:edn "[1 2]")                   (:adl "(vector 1 2)"))
      (map (:edn "(1 2)")                   (:adl "(list 1 2)"))
      (map (:edn "#{:x}")                   (:adl "(set :x)"))
      (map (:edn "{}")                      (:adl "(map)"))
      (map (:edn "[]")                      (:adl "(vector)"))
      (map (:edn "{\"s\" 2}")               (:adl "(map (\"s\" 2))"))
      (map (:edn "{:a {:b #{1}}}")          (:adl "(map (:a (map (:b (set 1)))))"))
      (map (:edn "#:n{:y 1}")               (:adl "(map (:n/y 1))"))
      (map (:edn "#:n{:c/d 2}")             (:adl "(map (:c/d 2))"))
      (map (:edn "#:n{:_/e 3}")             (:adl "(map (:e 3))"))
      (map (:edn "nil")                     (:adl "nil"))
      (map (:edn "0xFA")                    (:adl "0xFA"))))

  ;; ---- the source surface --------------------------------------------------
  ;; One extension covers programs too, so the reader has two surfaces. :data is
  ;; EDN's rules, and everything outside them is refused, because a document
  ;; needing a reader extension is telling you something. :source is the full
  ;; Clojure reader, because a program legitimately uses all of it.
  ;;
  ;; A program is CONVERTED BY RENAME, never by the data rewrite. The rewrite is
  ;; meaning-preserving for data and not for code: {:a 1} in source would become
  ;; (map (:a 1)), an application of `map`. Kotoba source is already
  ;; Clojure-shaped, which is exactly why the rename IS the conversion.
  (:kotoba.adl/surfaces
    (map
      (:data (map (:rules "EDN") (:conversion :rewrite-and-rename)))
      (:source (map (:rules "full Clojure reader") (:conversion :rename-only)))))

  ;; Legal in :source, refused in :data.
  (:kotoba.adl/source-only
    (vector "'x" "`x" "~x" "~@x" "@x" "#'x" "#(inc %)" "#\"re\"" "#?(:clj 1)" "#js []" "::kw"))

  ;; Shapes that used to be read wrong, kept so they stay read right.
  (:kotoba.adl/source-vectors
    (vector
      ;; ' is a symbol character except in first position; 52 files here have it
      (map (:src "state'") (:kind :symbol))
      ;; a leading zero is octal: #js {:mode 0600} is 384
      (map (:src "0600") (:value 384))
      (map (:src "##-Inf") (:kind :float))))

  ;; Renaming a program does not move its consumers, and the runtimes are not
  ;; interchangeable: amu resolves .kotoba, nbb does not. Measured 2026-09-10 --
  ;; kotoba-lang/datalog was renamed while three nbb scripts still required
  ;; datalog.core, and the datom query face has been dead since. A rename does
  ;; not fail, so nothing reported it.
  (:kotoba.adl/source-refusals
    (vector :still-required-by-clojure-runtime :unparseable-source :target-exists
            :uncommitted-changes))

  ;; Shapes the reader must REFUSE, each with the reason it must name. A reader
  ;; that refuses for the wrong reason has not discriminated anything.
  (:kotoba.adl/refusals
    (vector
      (map (:input "1/2")   (:reason "ratio"))
      (map (:input "1N")    (:reason "bigint"))
      (map (:input ":")     (:reason "empty keyword"))
      (map (:input "(1 2")  (:reason "unterminated collection"))
      (map (:input "[1 2)") (:reason "mismatched closing delimiter"))
      (map (:input ")")     (:reason "unbalanced"))
      (map (:input "#")     (:reason "dangling #"))
      (map (:input "/annex/objects/MD5E-s1--abc.edn") (:reason "not a valid EDN token")))))
