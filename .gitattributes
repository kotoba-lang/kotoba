# .kotoba files are not yet a recognized GitHub Linguist language.
# Alias them to Clojure (kotoba's syntactic superset today) so they are
# counted in the language bar and get source highlighting until a
# dedicated Kotoba grammar lands upstream in github-linguist/linguist.
*.kotoba linguist-language=Clojure

# Generated organization metadata joined to preserved source-review evidence.
docs/library-repository-inventory.json linguist-generated=true
