         :deps/root "lib/kotoba.ioMultiformats"}
        ;; Same migration, four more coordinates whose separate repositories
        ;; no longer exist (measured 2026-11-24: `gh api
        ;; /repos/kotoba-lang/{abi,osaho,kototama-component,org-ietf-tls}`
        ;; all 404; each lives in this monorepo). The pinned 889239dc9 copies of
        ;; lib/kotoba.artifact, lib/kotoba.grant,
        ;; lib/kotoba.kotobaSelfhostContracts, lib/kotoba.kototama and others
        ;; still request them by their dead git URLs, so without these floors
        ;; tools.deps tries to clone repositories that are gone and bootstrap
        ;; fails at the first one (abi). Each pin below is the coordinate the
        ;; working-tree lib/*/deps.edn already use for the same library.
        ;; :local/root (not a monorepo git pin): lib/kotoba.abi here carries
        ;; the JVM-loadable wit_data.cljc twin of wit_data.kotoba, which no
        ;; remote sha has; kotoba.abi.component requires kotoba.abi.wit-data
        ;; on every host and the JVM launcher cannot load .kotoba.
        io.github.kotoba-lang/abi {:local/root "lib/kotoba.abi"}
        io.github.kotoba-lang/osaho
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "889239dc972a868ee9e824517aad07c343972e7d"
         :deps/root "lib/kotoba.osaho"}
        io.github.kotoba-lang/kototama-component
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "889239dc972a868ee9e824517aad07c343972e7d"
         :deps/root "lib/kotoba.kototamaComponent"}
        io.github.kotoba-lang/org-ietf-tls
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "889239dc972a868ee9e824517aad07c343972e7d"
         :deps/root "lib/org.ietf.tls"}
        ;; wit is reached only transitively (from kotoba-lang's tree); without
        ;; this floor its nested coordinate (kotoba.git at the old sha) wins
        ;; and its children are expanded from the stale tree.
        io.github.kotoba-lang/wit
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "889239dc972a868ee9e824517aad07c343972e7d"
         :deps/root "lib/kotoba.wit"}
        ;; Top-level floors for libraries reached only transitively through
        ;; :local/root children of the monorepo pins above (authority,
        ;; dev-protobuf, org-ietf-jcs, org-w3-nquads, org-nist-sha2) and
        ;; through the external amu / kotoba-lang trees (grant, identity,
        ;; xyz-ucan, org-w3-vc-*, arrangement, kotobase-storage, and the
        ;; amu-only leaves kotoba-hir, kotoba-object, kotoba-wasm,
        ;; kotoba-native, kotoba-component, kotoba-verifier, kotoba-codegen,
        ;; kotoba-mir, kotoba-gmir). Without a top pin each of these is
        ;; expanded from several different gitlibs checkouts of the same
        ;; monorepo commit as unrelated :local/root paths and version
        ;; comparison fails ("No known ancestor relationship between local
        ;; versions"); a top pin makes every transitive coordinate a
        ;; :use-top omission. :local/root keeps these floors free of the
        ;; clone that would otherwise re-derive the same tree.
        io.github.kotoba-lang/authority {:local/root "lib/kotoba.authority"}
        io.github.kotoba-lang/dev-protobuf {:local/root "lib/kotoba.devProtobuf"}
        io.github.kotoba-lang/org-ietf-jcs {:local/root "lib/org.ietf.jcs"}
        io.github.kotoba-lang/org-w3-nquads {:local/root "lib/org.w3.nquads"}
        io.github.kotoba-lang/org-nist-sha2 {:local/root "lib/gov.nist.sha2"}
        io.github.kotoba-lang/grant {:local/root "lib/kotoba.grant"}
        io.github.kotoba-lang/identity {:local/root "lib/kotoba.identity"}
        io.github.kotoba-lang/xyz-ucan {:local/root "lib/kotoba.xyzUcan"}
        io.github.kotoba-lang/org-w3-vc-data-integrity {:local/root "lib/org.w3.vcDataIntegrity"}
        io.github.kotoba-lang/org-w3-vc-bitstring-status-list {:local/root "lib/org.w3.vcBitstringStatusList"}
        io.github.kotoba-lang/arrangement {:local/root "lib/kotoba.arrangement"}
        io.github.kotoba-lang/kotobase-storage {:local/root "lib/kotoba.kotobaseStorage"}
        io.github.kotoba-lang/kotoba-hir {:local/root "lib/kotoba.kotobaHir"}
        io.github.kotoba-lang/kotoba-object {:local/root "lib/kotoba.kotobaObject"}
        io.github.kotoba-lang/kotoba-wasm {:local/root "lib/kotoba.kotobaWasm"}
        io.github.kotoba-lang/kotoba-native {:local/root "lib/kotoba.kotobaNative"}
        io.github.kotoba-lang/kotoba-component {:local/root "lib/kotoba.kotobaComponent"}
        io.github.kotoba-lang/kotoba-verifier {:local/root "lib/kotoba.kotobaVerifier"}
        io.github.kotoba-lang/kotoba-codegen {:local/root "lib/kotoba.kotobaCodegen"}
        io.github.kotoba-lang/kotoba-mir {:local/root "lib/kotoba.kotobaMir"}
        io.github.kotoba-lang/kotoba-gmir {:local/root "lib/kotoba.kotobaGmir"}
        io.github.kotoba-lang/org-ietf-x25519 {:local/root "lib/org.ietf.x25519"}
        io.github.kotoba-lang/org-ietf-asn1 {:local/root "lib/org.ietf.asn1"}
        ;; kotoba-lang/inga is alive but its pinned deps.edn names arrangement
        ;; and kotobase-storage (both deleted repos). Excluding them here --
        ;; direct children of this pin -- prunes that fetch; the two libs
        ;; stay on the classpath from the :local/root floors above.
        io.github.kotoba-lang/inga
        {:git/url "https://github.com/kotoba-lang/inga.git"
         :git/sha "64bb3efabca3095f0e98c81e90db55e38e5b9506"
         :exclusions [io.github.kotoba-lang/arrangement
                      io.github.kotoba-lang/kotobase-storage]}
        ;; Cloud-provider-independent signed desired-state publication.
        ;; Kotoba emits the same Kekkai envelope that Murakumo nodes pull;
        ;; deploy never shells a sibling Clojure checkout.
        io.github.kotoba-lang/kekkai
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "889239dc972a868ee9e824517aad07c343972e7d"
         :deps/root "lib/kotoba.kekkai"}
        ;; kotoba.value.v1 (ADR-kotoba-canonical-value-codec). VC5 lowers a
        ;; constant collection literal in host-argument position to the
        ;; canonical bytes of that value; the host decodes the same codec.
        ;; Already present transitively through codebase -- declared directly
        ;; because this repo now uses it in its own emit path.
        ;; did:webvh v1.0 -- `kotoba id take-custody` / `rotate` / `recover` /
        ;; `verify` (kotoba.principal-custody) build, sign and verify the
        ;; account DID's log with the method's own library rather than a
        ;; second implementation of it. Its ed25519 / multiformats / org-w3-did
        ;; requests resolve to the top-level pins above (:use-top); JCS and
        ;; the eddsa-jcs-2022 suite enter the closure here.
        io.github.kotoba-lang/foundation-identity-didwebvh
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "889239dc972a868ee9e824517aad07c343972e7d"
         :deps/root "lib/kotoba.foundationIdentityDidwebvh"}
        io.github.kotoba-lang/io-ipld
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "889239dc972a868ee9e824517aad07c343972e7d"
         :deps/root "lib/kotoba.ioIpld"}}
 ;; The dead coordinates above cannot be fixed by a :deps floor alone:
 ;; tools.deps procures (clones) every distinct :git/url appearing in the
 ;; expanded tree before it compares versions, so even a shadowed dead
 ;; coordinate kills the bootstrap (measured 2026-11-24: with the abi
 ;; top-level pin in place, resolution still tried to clone abi.git and
 ;; died). Top-level :override-deps is not consulted by the Clojure CLI's
 ;; create-basis (measured: resolution is identical with and without it),
 ;; so the only pre-procurement hooks available to `clojure -M` are
 ;; :exclusions on the consuming pin. That is used below on the two
 ;; external pins that drag the retired repositories in:
 ;;   - kotoba-lang/amu at 06fad55: its root deps.edn names 30 deleted
 ;;     kotoba-lang/*.git repositories. Amu has no migrated deps.edn at
 ;;     any sha (deleted 2026-10-23), so pruning is the only route that
 ;;     keeps its code (kotoba.compiler.*) on the classpath.
 ;;   - kotoba-lang/kotoba-lang at current main: its root deps.edn names
 ;;     kotoba-lang/inga (alive), whose own deps name arrangement and
 ;;     kotobase-storage (both deleted).
 ;; Every pruned lib keeps a top-level pin below, so the namespaces stay
 ;; on the classpath from this repository's own tree.
 :aliases
 {:library-test {:extra-paths ["lib/kotoba.lsp/test" "lib/kotoba.lsp.rpc/test" "lib/kotoba.lint/test" "lib/kotoba.lint.kotoba/test" "test" "lib/kotoba.async/test" "lib/kotoba.bytes/test" "lib/kotoba.coll/test" "lib/kotoba.edn/test" "lib/kotoba.error/test" "lib/kotoba.fmt/test" "lib/kotoba.fs/test" "lib/kotoba.io/test" "lib/kotoba.json/test" "lib/kotoba.log/test" "lib/kotoba.pprint/test" "lib/kotoba.process/test" "lib/kotoba.scheduler/test" "lib/kotoba.spec/test" "lib/kotoba.store/test" "lib/kotoba.string/test" "lib/kotoba.test/test" "lib/kotoba.text/test" "lib/kotoba.time/test"]
                  :main-opts ["-i" "tools/cljk_loader.cljk" "scripts/run-library-jvm-tests.cljk"]}
  :build {:deps {io.github.clojure/tools.build {:mvn/version "0.10.6"}}
          :ns-default build}
  :dev {:override-deps {io.github.kotoba-lang/amu {:local/root "../../kotoba-lang/amu"}
                         io.github.kotoba-lang/security {:local/root "../security"}
                        io.github.kotoba-lang/codebase {:local/root "../codebase"}
                        io.github.kotoba-lang/kotoba-core-contracts
        {:local/root "../../kotoba-lang/kotoba/lib/kotoba.kotobaCoreContracts"}
                        io.github.kotoba-lang/kotoba-selfhost-contracts
        {:local/root "../../kotoba-lang/kotoba/lib/kotoba.kotobaSelfhostContracts"}
                        io.github.kotoba-lang/kotoba-lang {:local/root "../../kotoba-lang/kotoba-lang"}
                        io.github.kotoba-lang/org-chainagnostic-cacao
        {:local/root "../../kotoba-lang/kotoba/lib/org.chainagnostic.cacao"}
                        io.github.kotoba-lang/datom
        {:local/root "../../kotoba-lang/kotoba/lib/kotoba.datom"}
                        io.github.kotoba-lang/org-w3-did
        {:local/root "../../kotoba-lang/kotoba/lib/org.w3.did"}}}
  :test {:extra-paths ["test"]
         :main-opts ["-i" "tools/cljk_loader.cljk" "-m" "kotoba.test-runner"]}
  :release-tag
  {:extra-deps {io.github.kotoba-lang/release
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "889239dc972a868ee9e824517aad07c343972e7d"
         :deps/root "lib/kotoba.release"}}
   :main-opts ["-m" "kotoba.release.cli"]}
  :qualification {:extra-paths ["test"]
                  ;; Keep executable dependencies at the immutable repository
                  ;; pins above. Sibling checkouts are evidence inputs, not a
                  ;; reproducible runtime classpath for this report.
                  :main-opts ["-i" "tools/cljk_loader.cljk" "-m" "kotoba.backend-qualification-test"]}
  ;; Cross-machine reproducibility of `wasm emit`: verify the checked-in
  ;; digests, or `regenerate` after an intended emitter change.
  :reproducible-emit {:main-opts ["-m" "kotoba.reproducible-emit"]}
  :raw-memory-audit {:extra-paths ["tools"]
