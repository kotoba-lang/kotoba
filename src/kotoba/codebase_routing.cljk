(ns kotoba.codebase-routing
  "Global content discovery for semantic definition blocks.

  Explicit-peer transfer answers `fetch this from that machine`. It does not
  answer `who has this at all`, which is the question a content-addressed
  codebase actually raises: a CID is a global name, and the point of a global
  name is that you can hold one without knowing where it lives.

  This is a client for the two IPFS interfaces that answer it over plain HTTP:

  - **Delegated Routing HTTP API v1** -- `GET /routing/v1/providers/{cid}` asks
    a router (which is backed by the DHT and by indexer networks) who provides
    a CID. Filtering to `transport-ipfs-gateway-http` keeps the answers to
    providers this client can actually talk to.
  - **Trustless Gateway** -- `GET /ipfs/{cid}?format=raw` fetches one block's
    exact bytes, with no path resolution, no directory listing, and nothing the
    server chose.

  `trustless` is the load-bearing word. Every byte returned here is verified
  against the CID that was requested before it is persisted, so a router that
  lies about who has a block, and a gateway that serves the wrong bytes, are
  both merely unhelpful. That is what makes it safe to ask strangers.

  What this does NOT do: publish. Announcing a CID to the DHT requires a libp2p
  node, so a block only becomes globally discoverable once something that has
  one provides it. Discovery being possible is not the same as content being
  there, and this namespace deliberately reports an empty provider set rather
  than implying otherwise."
  (:require [json.data-json :as json]
            [kotoba.lang.text :as str]
            [kotoba.codebase.fetch :as fetch]
            [kotoba.codebase.store :as store]
            [kotoba.endpoint-config :as endpoint-config])
  (:import [java.io ByteArrayOutputStream InputStream]
           [java.util.concurrent Callable ExecutionException Executors ThreadFactory
            TimeUnit TimeoutException]
           [java.net URI]
           [java.net.http HttpClient HttpRequest HttpResponse$BodyHandlers]
           [java.time Duration]))

(def default-routers
  "Public delegated routers, tried in order (`/routing/v1` base URLs).

  An ordered list rather than one host so discovery does not have a single
  mandatory operator. A router only names *where* to ask; every block it leads
  to is still checked against its CID, so adding a router grants it nothing.
  Override with `KOTOBA_ROUTERS` (comma-separated) or repeated `--router`."
  ["https://delegated-ipfs.dev" "https://cid.contact"])

(def default-router
  "The first default router. Kept for callers that record a single router
  (availability proofs name the router that counted the providers)."
  (first default-routers))

(def default-gateways
  "Trustless gateways tried when routing returns no HTTP-reachable provider.

  A fixed list is a convenience, not an authority: these are asked for bytes
  that are checked against the CID, so including one grants it nothing for
  integrity. It does grant it something else: every gateway asked sees the
  CID being fetched and the client's IP. So the default is the one gateway the
  CLI effectively used before (`ipfs.io` 301-redirects `?format=raw` to it, and
  redirects are refused, so `ipfs.io` was a dead entry) and further operators
  are opt-in -- see `opt-in-gateways` and docs/ADR-configurable-endpoints.md.
  Override with `KOTOBA_GATEWAYS` or `--gateway`."
  ["https://trustless-gateway.link"])

(def opt-in-gateways
  "Further public trustless gateways, run by other (commercial) operators,
  observed serving `?format=raw` with a 200 and no redirect (2026-10-10).
  Not used unless the operator lists them, e.g.
  `KOTOBA_GATEWAYS=https://trustless-gateway.link,https://ipfs.filebase.io,https://gateway.pinata.cloud`.
  `ipfs.4everland.io` was dropped: 53 s observed for a 117 KB block."
  ["https://ipfs.filebase.io" "https://gateway.pinata.cloud"])

(def routers-env "KOTOBA_ROUTERS")
(def gateways-env "KOTOBA_GATEWAYS")

(defn configured-routers
  "Routers in effect: CLI values > `KOTOBA_ROUTERS` > `default-routers`."
  ([] (configured-routers nil))
  ([cli-values] (endpoint-config/resolve-endpoints cli-values routers-env default-routers)))

(defn configured-gateways
  "Gateways in effect: CLI values > `KOTOBA_GATEWAYS` > `default-gateways`."
  ([] (configured-gateways nil))
  ([cli-values] (endpoint-config/resolve-endpoints cli-values gateways-env default-gateways)))

(defn configured-router
  "The single router a one-router caller should use: the first configured."
  ([] (configured-router nil))
  ([cli-values] (first (configured-routers cli-values))))

(defn- routers-of
  "The ordered router list an opts map asks for. An explicit `:router` keeps
  its historical meaning (exactly that router); `:routers` is an ordered list;
  neither means the configured list."
  [{:keys [router routers]}]
  (cond
    (string? router) [router]
    (seq routers) (vec routers)
    :else (configured-routers)))

(def max-block-bytes (* 4 1024 1024))
(def max-providers 20)
(def default-timeout-ms 15000)

(defn- fail! [problem data]
  (throw (ex-info (name problem) (assoc data :problem problem))))

(defn- client ^HttpClient [timeout-ms]
  (-> (HttpClient/newBuilder)
      (.connectTimeout (Duration/ofMillis timeout-ms))
      ;; Redirects are not followed: a redirect is the server choosing what to
      ;; send, and the only thing that should choose here is the CID.
      (.followRedirects java.net.http.HttpClient$Redirect/NEVER)
      (.build)))

(defn- request ^HttpRequest [url accept timeout-ms]
  (-> (HttpRequest/newBuilder (URI/create url))
      (.timeout (Duration/ofMillis timeout-ms))
      (.header "Accept" accept)
      (.GET)
      (.build)))

(defn- base-url
  "BASE without trailing `/`, so `base + \"/ipfs/...\"` never doubles the slash."
  [base]
  (str/replace (str base) #"/+$" ""))

(def ^:private reader-pool
  "Daemon threads for deadline-bounded body reads: an abandoned read must not
  keep the CLI's JVM alive."
  (delay (Executors/newCachedThreadPool
          (reify ThreadFactory
            (newThread [_ runnable]
              (doto (Thread. ^Runnable runnable "kotoba-routing-read")
                (.setDaemon true)))))))

(defn- read-loop [^InputStream in max-bytes deadline-ms]
  (let [out (ByteArrayOutputStream.)
        buffer (byte-array 65536)]
    (loop []
      (when (and deadline-ms (> (System/currentTimeMillis) deadline-ms))
        (fail! :routing/body-deadline-exceeded {}))
      (let [n (.read in buffer)]
        (cond
          (neg? n) (.toByteArray out)
          (> (+ (.size out) n) max-bytes)
          (fail! :routing/block-too-large {:limit max-bytes})
          :else (do (.write out buffer 0 n) (recur)))))))

(defn read-bounded
  "Read at most `:max-bytes` (default `max-block-bytes`), so a gateway cannot
  stream forever, and -- with `:deadline-ms` (epoch millis) -- finish by then,
  so it cannot trickle forever either. The deadline is enforced even while a
  single `read` is blocked: the read runs on a daemon thread and is abandoned
  (stream closed, thread interrupted) when the deadline passes."
  ([in] (read-bounded in {}))
  ([^InputStream in {:keys [max-bytes deadline-ms] :or {max-bytes max-block-bytes}}]
   (if-not deadline-ms
     (read-loop in max-bytes nil)
     (let [work (.submit ^java.util.concurrent.ExecutorService @reader-pool
                         ^Callable (fn [] (read-loop in max-bytes deadline-ms)))]
       (try
         (.get work (max 0 (- deadline-ms (System/currentTimeMillis))) TimeUnit/MILLISECONDS)
         (catch TimeoutException _
           (.cancel work true)
           (try (.close in) (catch Exception _ nil))
           (fail! :routing/body-deadline-exceeded {}))
         (catch ExecutionException e
           (throw (or (.getCause e) e))))))))

(defn multiaddr->base-url
  "Convert an HTTP-capable multiaddr to a base URL, or nil.

  Only the shapes a gateway is actually announced under are recognised --
  `/dns*/host/tcp/port/https`, `/ip4|/ip6/.../tcp/port/http` and their
  `/tls/http` spelling. Anything else (a raw libp2p transport, a relay circuit,
  QUIC) is not something this client can speak, and returning nil for it is the
  honest answer rather than guessing a URL."
  [multiaddr]
  (let [parts (remove str/blank? (str/split (str multiaddr) #"/"))
        indexed (vec parts)
        host-index (first (keep-indexed (fn [i p]
                                          (when (#{"dns" "dns4" "dns6" "ip4" "ip6"} p) i))
                                        indexed))
        host (when host-index (get indexed (inc host-index)))
        port (second (drop-while #(not= "tcp" %) indexed))
        tls? (some #{"https" "tls"} indexed)
        http? (some #{"http" "https"} indexed)]
    (when (and host http?)
      (let [scheme (if tls? "https" "http")
            default-port (if tls? "443" "80")
            port (or port default-port)]
        (if (= port default-port)
          (str scheme "://" host)
          (str scheme "://" host ":" port))))))

(defn providers
  "Ask a delegated router who provides CID.

  Returns the HTTP base URLs the answer resolves to, in the order the router
  gave them. An empty result means nobody announced it to that router -- not
  that the CID is invalid."
  ([cid] (providers cid {}))
  ([cid {:keys [router timeout-ms] :or {timeout-ms default-timeout-ms}}]
   (let [router (or router (configured-router))
         url (str (base-url router) "/routing/v1/providers/" cid
                  "?filter-protocols=transport-ipfs-gateway-http")
         response (.send (client timeout-ms)
                         (request url "application/json" timeout-ms)
                         (HttpResponse$BodyHandlers/ofString))]
     (if-not (= 200 (.statusCode response))
       {:cid cid :router router :providers [] :status (.statusCode response)}
       (let [body (json/read-str (.body response) {:key-fn keyword})
             records (take max-providers (:Providers body))]
         {:cid cid
          :router router
          :status 200
          :providers (vec (distinct (keep (fn [record]
                                            (some multiaddr->base-url (:Addrs record)))
                                          records)))})))))

(defn provider-records->identities
  "Collapse delegated-routing records by peer ID, preserving all addresses."
  [records]
  (->> records
       (keep (fn [record]
               (when-let [peer-id (:ID record)]
                 {:peer-id peer-id
                  :addrs (vec (distinct (:Addrs record)))})))
       (reduce (fn [by-peer {:keys [peer-id addrs]}]
                 (update by-peer peer-id
                         (fn [old]
                           {:peer-id peer-id
                            :addrs (vec (distinct (concat (:addrs old) addrs)))})))
               (sorted-map))
       vals
       vec))

(defn provider-identities
  "Ask a delegated router for distinct libp2p provider identities.

  Unlike `providers`, this does not filter to HTTP gateway transports.  It is
  used as network-level evidence: multiple gateway URLs can belong to one
  peer, while one peer can announce many addresses.  The peer ID is therefore
  the unit counted for distributed availability qualification."
  ([cid] (provider-identities cid {}))
  ([cid {:keys [router timeout-ms] :or {timeout-ms default-timeout-ms}}]
   (let [router (or router (configured-router))
         url (str (base-url router) "/routing/v1/providers/" cid)
         response (.send (client timeout-ms)
                         (request url "application/json" timeout-ms)
                         (HttpResponse$BodyHandlers/ofString))]
     (if-not (= 200 (.statusCode response))
       {:cid cid :router router :providers [] :status (.statusCode response)}
       (let [body (json/read-str (.body response) {:key-fn keyword})
             records (take max-providers (:Providers body))]
         {:cid cid
          :router router
          :status 200
          :providers (provider-records->identities records)})))))

(defn fetch-block-from
  "Fetch one block's raw bytes from BASE-URL, or nil.

  nil rather than an exception for a miss: a provider that does not have the
  block is the normal case when several are being tried, and only a block whose
  bytes fail verification is an actual fault. A malformed BASE (no scheme,
  `file:`, unparsable) is a miss too, not an abort of the whole operation.

  `:timeout-ms` bounds the whole fetch, body included; `:max-bytes` (default
  `max-block-bytes`) stops the read as soon as it is exceeded, so a caller with
  a smaller cap (the 1 MiB catalog) never reads more than that."
  ([base cid] (fetch-block-from base cid {}))
  ([base cid {:keys [timeout-ms max-bytes]
              :or {timeout-ms default-timeout-ms max-bytes max-block-bytes}}]
   (let [deadline-ms (+ (System/currentTimeMillis) timeout-ms)]
     (try
       (let [url (str (base-url base) "/ipfs/" cid "?format=raw")
             response (.send (client timeout-ms)
                             (request url "application/vnd.ipld.raw" timeout-ms)
                             (HttpResponse$BodyHandlers/ofInputStream))]
         (with-open [in ^InputStream (.body response)]
           (when (= 200 (.statusCode response))
             (read-bounded in {:max-bytes max-bytes :deadline-ms deadline-ms}))))
       (catch clojure.lang.ExceptionInfo e
         (if (= :routing/body-deadline-exceeded (:problem (ex-data e)))
           nil
           (throw e)))
       (catch IllegalArgumentException _ nil)
       (catch java.io.IOException _ nil)))))

(defn routed-providers
  "Ask ROUTERS in order and return the first non-empty HTTP provider list.

  A router that errors or names nobody is skipped, so one unreachable or
  censoring router does not end discovery. Stopping at the first answer keeps
  the common case at one round trip. Answers are only hints: the bytes each
  provider returns are still verified against the CID by the caller."
  [cid routers {:keys [timeout-ms] :or {timeout-ms default-timeout-ms}}]
  (loop [[router & more] routers]
    (if-not router
      []
      (let [found (try (:providers (providers cid {:router router :timeout-ms timeout-ms}))
                       (catch Exception _ []))]
        (if (seq found) found (recur more))))))

(defn block-source
  "A `fetch/hydrate!` source that discovers providers and falls back.

  Provider lists are resolved per CID and cached for the life of the source, so
  hydrating a closure of fifty blocks does not mean fifty routing round trips
  when they all live in the same place. Caching WHERE to ask never caches what
  was said.

  Bytes are verified against the CID here, per candidate (raw or dag-cbor by
  the CID's codec, with `kotoba.codebase.fetch`'s own checks): a candidate that
  serves the wrong bytes, an oversized body, or nothing is skipped and the next
  is tried, so one junk gateway early in the list cannot end a pull. If no
  candidate served the right bytes and at least one served wrong ones, that is
  still reported as `:codebase/fetched-cid-mismatch`. `hydrate!` verifies
  again (defense in depth).

  Routers: `:router` (exactly one, historical), `:routers` (ordered list), or
  the configured list. Gateways: `:gateways` when given (even empty -- an
  explicit provider set is not widened behind the caller's back), otherwise
  the configured list."
  ([] (block-source {}))
  ([{:keys [timeout-ms verbose?]
     :or {timeout-ms default-timeout-ms}
     :as opts}]
   (let [routers (routers-of opts)
         gateways (if (contains? opts :gateways)
                    (:gateways opts)
                    (configured-gateways))
         discovered (atom [])
         attempts (atom [])]
     (with-meta
       (fn [cid]
         (let [routed (routed-providers cid routers {:timeout-ms timeout-ms})
               ;; Providers already known to have answered come first: the
               ;; closure of one definition is usually held by one host.
               candidates (distinct (concat @discovered routed gateways))]
           (loop [remaining candidates
                  rejected []]
             (if-let [base (first remaining)]
               (let [outcome (try
                               (when-let [bytes (fetch-block-from base cid {:timeout-ms timeout-ms})]
                                 (if (store/raw-cid? cid)
                                   (fetch/verify-raw-bytes cid bytes)
                                   (fetch/verify-bytes cid bytes))
                                 {:bytes bytes})
                               (catch clojure.lang.ExceptionInfo e
                                 {:problem (or (:problem (ex-data e)) :routing/fetch-failed)}))]
                 (if-let [bytes (:bytes outcome)]
                   (do (swap! discovered #(vec (distinct (cons base %))))
                       (when verbose? (swap! attempts conj {:cid cid :from base :ok? true}))
                       bytes)
                   (do (when verbose? (swap! attempts conj (cond-> {:cid cid :from base :ok? false}
                                                             (:problem outcome)
                                                             (assoc :problem (:problem outcome)))))
                       (recur (next remaining)
                              (cond-> rejected
                                (#{:codebase/fetched-cid-mismatch
                                   :codebase/fetched-block-not-canonical} (:problem outcome))
                                (conj base))))))
               (when (seq rejected)
                 (fail! :codebase/fetched-cid-mismatch {:cid cid :from rejected}))))))
       {:discovered discovered :attempts attempts
        :routers routers :gateways gateways}))))

;; ---------------------------------------------------------------------------
;; Announcement
;;
;; Announcing a CID to the DHT requires a libp2p node. What plain HTTP can do
;; is ask something that HAS one -- the IPFS Pinning Service API is exactly
;; that interface, and a pinning service both stores a block and advertises
;; itself as a provider of it.
;;
;; This is a smaller claim than "we announce", and the difference matters: the
;; announcement is made by a third party, on their schedule, and can be
;; withdrawn by them. What it is not is a promise dressed up as an
;; implementation -- `announced?` re-asks the router rather than trusting the
;; service's own reply.

(def pin-statuses #{"queued" "pinning" "pinned" "failed"})

(defn- json-request ^HttpRequest [url method body token timeout-ms]
  (let [builder (-> (HttpRequest/newBuilder (URI/create url))
                    (.timeout (Duration/ofMillis timeout-ms))
                    (.header "Accept" "application/json"))
        builder (if token (.header builder "Authorization" (str "Bearer " token)) builder)]
    (-> (case method
          :post (-> builder
                    (.header "Content-Type" "application/json")
                    (.POST (java.net.http.HttpRequest$BodyPublishers/ofString body)))
          :get (.GET builder))
        (.build))))

(defn request-pin!
  "Ask a pinning service to store and provide CID.

  The service's own status is reported, not believed: `queued` and `pinning`
  are not `pinned`, and even `pinned` is a claim about their store, which is
  why `announced?` exists as a separate check against a router."
  [cid {:keys [endpoint token name timeout-ms]
        :or {timeout-ms default-timeout-ms}}]
  (when-not (string? endpoint) (fail! :routing/pin-endpoint-required {}))
  (let [body (json/write-str (cond-> {"cid" cid} name (assoc "name" name)))
        response (.send (client timeout-ms)
                        (json-request (str endpoint "/pins") :post body token timeout-ms)
                        (HttpResponse$BodyHandlers/ofString))
        status (.statusCode response)]
    (if-not (#{200 202} status)
      {:cid cid :endpoint endpoint :accepted? false :status status :body (.body response)}
      (let [parsed (json/read-str (.body response) {:key-fn keyword})]
        {:cid cid :endpoint endpoint :accepted? true :status status
         :request-id (:requestid parsed)
         :pin-status (:status parsed)
         :pinned? (= "pinned" (:status parsed))}))))

(defn announced?
  "Whether a router can now name a provider for CID.

  Asked of the routing layer, not of whoever was asked to pin: the question is
  whether the network can find it, and only the network answers that. With
  several routers (`:routers`, or the configured list when no `:router` is
  given) the first that names a provider answers.

  A router that errors or answers non-200 is an outage, not a `no`: it is kept
  under `:errors`, and when EVERY router failed this throws
  `:codebase/announce-failed` instead of reporting `:announced? false`."
  ([cid] (announced? cid {}))
  ([cid opts]
   (let [routers (routers-of opts)]
     (loop [[router & more] routers
            last-answer nil
            errors []]
       (if-not router
         (if (and (seq errors) (= (count errors) (count routers)))
           (fail! :codebase/announce-failed {:cid cid :errors errors})
           (let [{:keys [providers status router]} last-answer]
             (cond-> {:cid cid :status status :router router :providers (or providers [])
                      :announced? false}
               (seq errors) (assoc :errors errors))))
         (let [answer (try (providers cid (assoc (dissoc opts :routers) :router router))
                           (catch Exception e {:router router :providers [] :status nil
                                               :error (or (ex-message e) (str (class e)))}))]
           (cond
             (seq (:providers answer))
             (cond-> {:cid cid :status (:status answer) :router router
                      :providers (:providers answer) :announced? true}
               (seq errors) (assoc :errors errors))

             (or (:error answer) (not= 200 (:status answer)))
             (recur more last-answer
                    (conj errors (cond-> {:router router :status (:status answer)}
                                   (:error answer) (assoc :error (:error answer)))))

             :else (recur more answer errors))))))))

(defn announce!
  "Request a pin, then verify by asking a router who provides the CID.

  Verification is deliberately not retried here. How long a service takes to
  pin and advertise is its business, and a loop that waited would turn a
  reported fact into an implied guarantee."
  [cid opts]
  (let [requested (request-pin! cid opts)]
    (assoc requested
           :verification
           (try (announced? cid opts)
                (catch clojure.lang.ExceptionInfo e
                  ;; Every router was down: keep what the pinning service said.
                  (throw (ex-info (ex-message e) (assoc (ex-data e) :pin requested) e)))))))

(defn pull!
  "Discover and hydrate the closure rooted at ROOTS into the local store.

  This is the whole point of the namespace in one call: given only hashes, end
  with a local, verified, runnable definition graph."
  ([store roots] (pull! store roots {}))
  ([store roots opts]
   (let [source (block-source opts)
         result (fetch/hydrate! store roots (assoc opts :fetch-block source))]
     (assoc result
            :providers-used (vec @(:discovered (meta source)))
            :router (first (:routers (meta source)))
            :routers (:routers (meta source))))))
