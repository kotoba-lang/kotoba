(ns kotoba.runtime.wasm-hash
  (:export [fnv1a-i32 tagged-hash])
  (:require [kotoba.bytes :as bytes]))

;; Keep the host and Kotoba paths on the same byte-level hash. Returning the
;; low 32 bits as a nonnegative i64 avoids host signed-int overflow while
;; preserving every tagged identity that masks this result downstream.
(defn fnv1a-i32 [text :string] :i64
  "Return the low 32 bits of FNV-1a over a string's UTF-8 bytes."
  (let [encoded (bytes/utf8-encode text)]
    (loop [index 0 hash 2166136261]
      (if (>= index (vector-count encoded))
        hash
        (let [mixed (bit-xor hash (vector-at encoded index))
              product (* mixed 16777619)]
          (recur (+ index 1) (bit-and product 4294967295)))))))

(defn tagged-hash [tag :i64 text :string bits :i64] :i64
  "Mix the FNV-1a low bits into a stable tagged scalar identity."
  (bit-or tag
          (bit-and (fnv1a-i32 text)
                   (- (i64-shift-left 1 bits) 1))))
