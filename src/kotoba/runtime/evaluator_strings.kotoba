;; String builtins for the Native Kotoba evaluator. Kept separate from the
;; control-flow machine so byte-offset string rules stay independently typed.
(ns kotoba.runtime.evaluator-strings
  (:export [call-string-builtin])
  (:require [kotoba.form :as form])
  (:schemas {:form/r [:record :form/r [[:tag :i64] [:s :string] [:n :i64] [:k :keyword]
                                      [:kids [:list [:ref :form/r]]] [:span :i64] [:data :bytes]]]
             :runtime/eval-out [:record :runtime/eval-out
                                [[:ok :bool] [:value [:ref :form/r]]
                                 [:error :string] [:fuel :i64]]]}))

(defn- success [value [:ref :form/r] fuel :i64] [:ref :runtime/eval-out]
  (record-new [:ref :runtime/eval-out] true value "" fuel))

(defn- failure [message :string fuel :i64] [:ref :runtime/eval-out]
  (record-new [:ref :runtime/eval-out] false (form/nil-form) message fuel))

(defn- item-at [node [:ref :form/r] index :i64] [:ref :form/r]
  (typed-list-nth [:list [:ref :form/r]] (form/kids-of node) index))

(defn- code-point-width [point :i64] :i64
  (if (< point 128) 1
      (if (< point 2048) 2
          (if (< point 65536) 3 4))))

(defn- string-index-boundary? [text :string length :i64 target :i64] :bool
  (if (or (< target 0) (> target length))
    false
    (loop [index 0]
      (if (= index target)
        true
        (if (> index target)
          false
          (let [point (string-code-point-at text index)]
            (if (< point 0)
              false
              (recur (+ index (code-point-width point)))))))))
)


(defn- string-split-count-run [text :string separator :string
                               separator-bytes :i64 offset :i64 count :i64]
  :i64
  (let [length (string-byte-length text)]
    (if (>= offset length)
      count
      (let [found (string-index-of-from text separator offset)]
        (if (< found 0)
          count
          (string-split-count-run text separator separator-bytes
                                  (+ found separator-bytes) (+ count 1)))))))

(defn call-string-builtin [name :string args [:ref :form/r] fuel :i64]
  [:ref :runtime/eval-out]
  (let [count (form/count-of args)
        first-value (item-at args 0)]
    (cond
      (string=? name "string-length")
      (if (and (= count 1) (form/is-string? first-value))
        (success (form/int-form (string-length (form/string-value first-value))) fuel)
        (failure "string-length expects one string" fuel))

      (string=? name "string-byte-length")
      (if (and (= count 1) (form/is-string? first-value))
        (success (form/int-form (string-byte-length (form/string-value first-value))) fuel)
        (failure "string-byte-length expects one string" fuel))

      (or (string=? name "string=?") (string=? name "string="))
      (if (and (= count 2) (form/is-string? first-value)
               (form/is-string? (item-at args 1)))
        (success (form/bool-form
                  (string=? (form/string-value first-value)
                            (form/string-value (item-at args 1)))) fuel)
        (failure "string=? expects two strings" fuel))

      (string=? name "string-concat")
      (if (and (= count 2) (form/is-string? first-value)
               (form/is-string? (item-at args 1)))
        (success (form/string-form
                  (string-concat (form/string-value first-value)
                                 (form/string-value (item-at args 1)))) fuel)
        (failure "string-concat expects two strings" fuel))

      (string=? name "string-substring")
      (if (and (= count 3) (form/is-string? first-value)
               (form/is-int? (item-at args 1)) (form/is-int? (item-at args 2)))
        (let [text (form/string-value first-value)
              length (string-byte-length text)
              start (form/int-value (item-at args 1))
              end (form/int-value (item-at args 2))]
          (if (and (<= 0 start) (<= start end) (<= end length)
                   (string-index-boundary? text length start)
                   (string-index-boundary? text length end))
            (success (form/string-form (string-substring text start end)) fuel)
            (failure "string-substring indexes are out of range or split UTF-8" fuel)))
        (failure "string-substring expects a string and two integer offsets" fuel))

      (string=? name "string-index-of")
      (if (and (= count 2) (form/is-string? first-value)
               (form/is-string? (item-at args 1)))
        (let [needle (form/string-value (item-at args 1))]
          (if (= (string-byte-length needle) 0)
            (failure "string-index-of needle must not be empty" fuel)
            (success (form/int-form
                      (string-index-of (form/string-value first-value) needle)) fuel)))
        (failure "string-index-of expects two strings" fuel))

      (string=? name "string-index-of-from")
      (if (and (= count 3) (form/is-string? first-value)
               (form/is-string? (item-at args 1)) (form/is-int? (item-at args 2)))
        (let [text (form/string-value first-value)
              needle (form/string-value (item-at args 1))
              start (form/int-value (item-at args 2))
              length (string-byte-length text)]
          (if (= (string-byte-length needle) 0)
            (failure "string-index-of-from needle must not be empty" fuel)
            (if (and (<= 0 start) (<= start length)
                     (string-index-boundary? text length start))
              (success (form/int-form (string-index-of-from text needle start)) fuel)
              (failure "string-index-of-from offset is out of range or splits UTF-8" fuel))))
        (failure "string-index-of-from expects two strings and an integer offset" fuel))

      (string=? name "string-contains?")
      (if (and (= count 2) (form/is-string? first-value)
               (form/is-string? (item-at args 1)))
        (let [needle (form/string-value (item-at args 1))]
          (if (= (string-byte-length needle) 0)
            (failure "string-contains? needle must not be empty" fuel)
            (success (form/bool-form
                      (>= (string-index-of (form/string-value first-value) needle) 0)) fuel)))
        (failure "string-contains? expects two strings" fuel))

      (string=? name "string-split-count")
      (if (and (= count 2) (form/is-string? first-value)
               (form/is-string? (item-at args 1)))
        (let [text (form/string-value first-value)
              separator (form/string-value (item-at args 1))
              separator-bytes (string-byte-length separator)]
          (if (= separator-bytes 0)
            (failure "string-split-count separator must not be empty" fuel)
            (success (form/int-form
                      (string-split-count-run text separator separator-bytes 0 1)) fuel)))
        (failure "string-split-count expects two strings" fuel))

      :else (failure "unsupported string builtin" fuel))))

