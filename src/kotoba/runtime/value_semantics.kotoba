;; Shared value-level rules for the Kotoba-native runtime.
(ns kotoba.runtime.value-semantics
  (:export [truthy?])
  (:require [kotoba.form :as form])
  (:schemas {:form/r [:record :form/r [[:tag :i64] [:s :string] [:n :i64] [:k :keyword]
                                      [:kids [:list [:ref :form/r]]] [:span :i64]
                                      [:data :bytes]]]}))

(defn truthy? [value [:ref :form/r]] :bool
  "Kotoba KIR truthiness: nil, false, and integer zero are false."
  (and (not (form/is-nil? value))
       (not (and (form/is-bool? value) (not (form/bool-value value))))
       (not (and (form/is-int? value) (zero? (form/int-value value)))))
)
