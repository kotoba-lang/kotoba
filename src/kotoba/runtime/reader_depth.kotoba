(ns kotoba.runtime.reader-depth
  "Bound source delimiter nesting before a recursive reader sees the input."
  {:kotoba/export [reader-depth-limit max-delimiter-depth]})

(defn reader-depth-limit [] :i64
  512)

(defn- code-point-width [point :i64] :i64
  (if (< point 128)
    1
    (if (< point 2048)
      2
      (if (< point 65536) 3 4))))

(defn max-delimiter-depth [source :string limit :i64] :i64
  "Maximum open delimiter depth, or the first value over LIMIT.

  Strings, comments, and character literals do not contribute delimiters.
  Kotoba uses UTF-8 byte offsets, so every cursor step advances by one full
  code point and remains valid for string-code-point-at."
  (let [length (string-byte-length source)]
    (loop [index 0 depth 0 maximum 0 in-string? false escaped? false in-comment? false]
      (if (>= index length)
        maximum
        (let [point (string-code-point-at source index)
              next-index (+ index (code-point-width point))]
          (cond
            in-comment?
            (recur next-index depth maximum false false
                   (not (or (= point 10) (= point 13))))

            in-string?
            (cond
              escaped? (recur next-index depth maximum true false false)
              (= point 92) (recur next-index depth maximum true true false)
              (= point 34) (recur next-index depth maximum false false false)
              :else (recur next-index depth maximum true false false))

            (= point 59)
            (recur next-index depth maximum false false true)

            (= point 34)
            (recur next-index depth maximum true false false)

            ;; Skip one complete code point after a character-literal slash.
            ;; Named literals contain no reader delimiters.
            (= point 92)
            (let [after-literal (if (< next-index length)
                                  (+ next-index
                                     (code-point-width
                                      (string-code-point-at source next-index)))
                                  length)]
              (recur after-literal depth maximum false false false))

            (or (= point 40) (= point 91) (= point 123))
            (let [next-depth (+ depth 1)
                  next-maximum (if (> next-depth maximum) next-depth maximum)]
              (if (> next-depth limit)
                next-depth
                (recur next-index next-depth next-maximum false false false)))

            (or (= point 41) (= point 93) (= point 125))
            (recur next-index (if (> depth 0) (- depth 1) 0)
                   maximum false false false)

            :else
            (recur next-index depth maximum false false false)))))))
