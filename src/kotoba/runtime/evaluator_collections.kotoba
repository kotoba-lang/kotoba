;; Collection builtin semantics for the Kotoba-native evaluator.
(ns kotoba.runtime.evaluator-collections
  (:export [call-collection-builtin])
  (:require [kotoba.form :as form])
  (:schemas {:form/r [:record :form/r [[:tag :i64] [:s :string] [:n :i64] [:k :keyword]
                                      [:kids [:list [:ref :form/r]]] [:span :i64]
                                      [:data :bytes]]]
             :runtime/eval-out [:record :runtime/eval-out
                                [[:ok :bool] [:value [:ref :form/r]]
                                 [:error :string] [:fuel :i64]]]}))

(defn- outcome [ok :bool value [:ref :form/r] error :string fuel :i64]
  [:ref :runtime/eval-out]
  (record-new [:ref :runtime/eval-out] ok value error fuel))

(defn- success [value [:ref :form/r] fuel :i64] [:ref :runtime/eval-out]
  (outcome true value "" fuel))

(defn- failure [message :string fuel :i64] [:ref :runtime/eval-out]
  (outcome false (form/nil-form) message fuel))

(defn- ok? [result [:ref :runtime/eval-out]] :bool
  (record-get [:ref :runtime/eval-out] result :ok))

(defn- value-of [result [:ref :runtime/eval-out]] [:ref :form/r]
  (record-get [:ref :runtime/eval-out] result :value))

(defn- fuel-of [result [:ref :runtime/eval-out]] :i64
  (record-get [:ref :runtime/eval-out] result :fuel))

(defn- item-at [node [:ref :form/r] index :i64] [:ref :form/r]
  (typed-list-nth [:list [:ref :form/r]] (form/kids-of node) index))

(defn- collection-contains? [collection [:ref :form/r] value [:ref :form/r]
                             index :i64] :bool
  (if (>= index (form/count-of collection))
    false
    (if (form/eq (item-at collection index) value)
      true
      (collection-contains? collection value (+ index 1)))))

(defn- assoc-items [collection [:ref :form/r] args [:ref :form/r]
                    index :i64 fuel :i64]
  [:ref :runtime/eval-out]
  (if (>= index (form/count-of args))
    (success collection fuel)
    (if (>= (+ index 1) (form/count-of args))
      (failure "assoc expects key/value pairs" fuel)
      (if (not (form/is-map? collection))
        (failure "assoc expects a map" fuel)
        (assoc-items (form/assoc-form collection (item-at args index)
                                      (item-at args (+ index 1)))
                     args (+ index 2) fuel)))))

(defn- dissoc-items [collection [:ref :form/r] args [:ref :form/r]
                     index :i64 fuel :i64]
  [:ref :runtime/eval-out]
  (if (>= index (form/count-of args))
    (success collection fuel)
    (if (not (form/is-map? collection))
      (failure "dissoc expects a map" fuel)
      (dissoc-items (form/dissoc-form collection (item-at args index))
                    args (+ index 1) fuel))))

(defn- conj-one [collection [:ref :form/r] value [:ref :form/r]
                 fuel :i64]
  [:ref :runtime/eval-out]
  (cond
    (form/is-vec? collection)
    (success (form/form-vec (form/append-form (form/kids-of collection) value)) fuel)

    (form/is-seq? collection)
    (success (form/form-seq (form/cons-onto value (form/kids-of collection))) fuel)

    (form/is-set? collection)
    (success (if (collection-contains? collection value 0)
               collection
               (form/form-set (form/append-form (form/kids-of collection) value))) fuel)

    (and (form/is-map? collection) (form/is-vec? value)
         (= 2 (form/count-of value)))
    (success (form/assoc-form collection (item-at value 0) (item-at value 1)) fuel)

    :else (failure "conj expects a vector, list, set, or map" fuel)))

(defn- conj-items [collection [:ref :form/r] args [:ref :form/r]
                   index :i64 fuel :i64]
  [:ref :runtime/eval-out]
  (if (>= index (form/count-of args))
    (success collection fuel)
    (let [added (conj-one collection (item-at args index) fuel)]
      (if (not (ok? added))
        added
        (conj-items (value-of added) args (+ index 1) (fuel-of added))))))

(defn call-collection-builtin [name :string args [:ref :form/r]
                                fuel :i64]
  [:ref :runtime/eval-out]
  (let [count (form/count-of args)
        collection (item-at args 0)]
    (cond
      (string=? name "second")
      (if (= count 1)
        (if (or (form/is-seq? collection) (form/is-vec? collection))
          (success (item-at collection 1) fuel)
          (failure "second expects a sequence or vector" fuel))
        (failure "second expects one operand" fuel))

      (string=? name "rest")
      (if (= count 1)
        (if (or (form/is-seq? collection) (form/is-vec? collection))
          (success (form/form-seq (form/rest-list collection)) fuel)
          (failure "rest expects a sequence or vector" fuel))
        (failure "rest expects one operand" fuel))

      (string=? name "cons")
      (if (= count 2)
        (let [tail (item-at args 1)]
          (if (or (form/is-seq? tail) (form/is-vec? tail))
            (success (form/form-seq
                      (form/cons-onto (item-at args 0) (form/kids-of tail))) fuel)
            (failure "cons expects a sequence or vector as its second operand" fuel)))
        (failure "cons expects two operands" fuel))

      (string=? name "empty?")
      (if (= count 1)
        (if (or (form/is-map? collection) (form/is-set? collection)
                (form/is-seq? collection) (form/is-vec? collection))
          (success (form/bool-form (= (form/count-of collection) 0)) fuel)
          (failure "empty? expects a collection" fuel))
        (failure "empty? expects one operand" fuel))

      (string=? name "contains?")
      (if (= count 2)
        (let [key (item-at args 1)]
          (cond
            (form/is-map? collection)
            (success (form/bool-form (form/form-has? collection key)) fuel)

            (form/is-set? collection)
            (success (form/bool-form (collection-contains? collection key 0)) fuel)

            (or (form/is-seq? collection) (form/is-vec? collection))
            (success (form/bool-form
                      (and (form/is-int? key) (>= (form/int-value key) 0)
                           (< (form/int-value key) (form/count-of collection)))) fuel)

            :else (failure "contains? expects a map, set, sequence, or vector" fuel)))
        (failure "contains? expects two operands" fuel))

      (string=? name "conj")
      (if (>= count 1)
        (conj-items collection args 1 fuel)
        (failure "conj expects a collection" fuel))

      (string=? name "assoc")
      (if (and (>= count 3) (= (bit-and (- count 1) 1) 0))
        (assoc-items collection args 1 fuel)
        (failure "assoc expects a map and key/value pairs" fuel))

      (string=? name "dissoc")
      (if (>= count 1)
        (dissoc-items collection args 1 fuel)
        (failure "dissoc expects a map" fuel))

      (string=? name "keys")
      (if (and (= count 1) (form/is-map? collection))
        (success (form/keys-of collection) fuel)
        (failure "keys expects one map" fuel))

      :else (failure "unsupported collection builtin" fuel))))
