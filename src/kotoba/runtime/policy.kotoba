;; Native Kotoba parser for runtime policy text. Policy decisions are applied
;; by runtime.kotoba after this module has validated the bounded EDN shape.
(ns kotoba.runtime.policy
  (:export [parse-policy-text])
  (:require [kotoba.compiler.kotoba-reader :as reader]
            [kotoba.form :as form])
  (:schemas {:form/r [:record :form/r [[:tag :i64] [:s :string] [:n :i64] [:k :keyword]
                                      [:kids [:list [:ref :form/r]]] [:span :i64] [:data :bytes]]]
             :kotoba.reader/out [:record :kotoba.reader/out
                                 [[:forms [:list [:ref :form/r]]]
                                  [:err :string]
                                  [:at :i64]]]
             :runtime/policy-result [:record :runtime/policy-result
                                     [[:ok :bool] [:value [:ref :form/r]]
                                      [:error :string]]]}))

(defn- invalid-policy [message :string]
  [:ref :runtime/policy-result]
  (record-new [:ref :runtime/policy-result] false (form/nil-form) message))

(defn parse-policy-text [policy-text :string] [:ref :runtime/policy-result]
  "Parse one bounded EDN policy map, returning its offset-aware refusal."
  (let [parsed (reader/read-forms-bounded policy-text 64 65536)
        error (record-get [:ref :kotoba.reader/out] parsed :err)
        forms (record-get [:ref :kotoba.reader/out] parsed :forms)
        offset (record-get [:ref :kotoba.reader/out] parsed :at)
        count (vector-count forms)]
    (cond
      (not (string=? error ""))
      (invalid-policy (string-concat "kotoba.error/policy-reader: " error))

      (not (= count 1))
      (invalid-policy (string-concat "kotoba.error/policy-arity at byte "
                                     (string-from-i64 offset)))

      :else
      (let [value (typed-list-nth [:list [:ref :form/r]] forms 0)]
        (if (form/is-map? value)
          (record-new [:ref :runtime/policy-result] true value "")
          (invalid-policy "kotoba.error/policy-shape: policy must be one EDN map"))))))
