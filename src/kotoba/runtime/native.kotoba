;; Native-safe runtime boundary for source ingestion. The recursive typed AST
;; stays inside the Kotoba call graph; only this scalar record crosses the
;; native artifact boundary.
(ns kotoba.runtime.native
  (:export [read-source-summary])
  (:require [kotoba.compiler.kotoba-reader :as reader])
  (:schemas {:form/r [:record :form/r [[:tag :i64] [:s :string] [:n :i64] [:k :keyword]
                                      [:kids [:list [:ref :form/r]]] [:span :i64] [:data :bytes]]]
             :kotoba.reader/out [:record :kotoba.reader/out
                                 [[:forms [:list [:ref :form/r]]]
                                  [:err :string]
                                  [:at :i64]]]
             :kotoba.runtime/read-summary [:record :kotoba.runtime/read-summary
                                           [[:ok :i64]
                                            [:form-count :i64]
                                            [:error-offset :i64]]]}))

(defn read-source-summary [source :string] [:ref :kotoba.runtime/read-summary]
  "Parse source into typed forms and return a native-boundary-safe summary.
  Form nodes stay in the internal reader graph. `ok` is 1 on success and 0
  on failure; `error-offset` is the reader's byte offset, or 0 on success."
  (let [result (reader/read-forms source)
        error (record-get [:ref :kotoba.reader/out] result :err)
        forms (record-get [:ref :kotoba.reader/out] result :forms)
        offset (record-get [:ref :kotoba.reader/out] result :at)
        ok (= "" error)]
    (record-new [:ref :kotoba.runtime/read-summary]
                (if ok 1 0)
                (if ok (vector-count forms) 0)
                (if ok 0 offset))))
