;; Scalar native boundary for the typed-Form interpreter slice. Recursive
;; forms never cross the executable ABI.
(ns kotoba.runtime.native-interpreter
  (:export [eval-integer-source eval-integer-source-bounded
            eval-integer-source-with-policy eval-integer-source-with-policy-bounded
            eval-integer-cljk-source
            eval-integer-cljk-source-bounded
            eval-integer-cljk-source-with-policy
            eval-integer-cljk-source-with-policy-bounded])
  (:require [kotoba.runtime :as runtime])
  (:schemas {:runtime/eval-summary [:record :runtime/eval-summary
                                    [[:ok :i64] [:value :i64] [:error :string]
                                     [:steps :i64] [:fuel :i64]]]}))

(defn eval-integer-source [source :string] [:ref :runtime/eval-summary]
  "Read and evaluate source with a zero-argument main or top-level forms,
  returning an integer result and bounded fuel summary. Richer values remain
  internal Form records."
  (runtime/eval-source source 100000))

(defn eval-integer-source-bounded
  [source :string fuel :i64 max-depth :i64 max-token-bytes :i64]
  [:ref :runtime/eval-summary]
  "Read and evaluate core source with caller-selected fuel, delimiter-depth,
  and token-byte bounds. A zero reader limit leaves that dimension unbounded."
  (runtime/eval-source-bounded source fuel max-depth max-token-bytes))

(defn eval-integer-source-with-policy [source :string policy-text :string]
  [:ref :runtime/eval-summary]
  "Evaluate source with an EDN policy map at the native scalar boundary.
  Policy parsing and recursive Form inspection stay inside the Kotoba runtime."
  (runtime/eval-source-with-policy source 100000 policy-text))

(defn eval-integer-source-with-policy-bounded
  [source :string fuel :i64 policy-text :string max-depth :i64
   max-token-bytes :i64]
  [:ref :runtime/eval-summary]
  "Evaluate policy-checked core source under explicit reader limits."
  (runtime/eval-source-with-policy-bounded
   source fuel policy-text max-depth max-token-bytes))

(defn eval-integer-cljk-source [source :string] [:ref :runtime/eval-summary]
  "Lower admitted `.cljk` surface syntax and evaluate its integer result at
  the native scalar boundary."
  (runtime/eval-cljk-source source 100000))

(defn eval-integer-cljk-source-bounded
  [source :string fuel :i64 max-depth :i64 max-token-bytes :i64]
  [:ref :runtime/eval-summary]
  "Lower and evaluate surface source with caller-selected fuel,
  delimiter-depth, and token-byte bounds. Raw-memory policy is checked before
  lowering, using the original surface forms."
  (runtime/eval-cljk-source-bounded
   source fuel max-depth max-token-bytes))

(defn eval-integer-cljk-source-with-policy [source :string policy-text :string]
  [:ref :runtime/eval-summary]
  "Inspect original `.cljk` forms under an EDN policy, lower the admitted
  surface syntax, then evaluate its integer result at the native boundary."
  (runtime/eval-cljk-source-with-policy source 100000 policy-text))

(defn eval-integer-cljk-source-with-policy-bounded
  [source :string fuel :i64 policy-text :string max-depth :i64
   max-token-bytes :i64]
  [:ref :runtime/eval-summary]
  "Evaluate policy-checked `.cljk` source under explicit reader limits."
  (runtime/eval-cljk-source-with-policy-bounded
   source fuel policy-text max-depth max-token-bytes))
