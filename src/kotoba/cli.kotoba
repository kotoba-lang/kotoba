(ns kotoba.cli
 "Canonical CLI request parser. The immutable command contract supplies all
 twelve commands and their complete flag/alias vocabulary. Parsing produces
 a request, never an execution or provider-approval receipt."
 (:export [parse-argv])
 (:require [kotoba.form :as f]))

(defn- get [m [:ref :form/r] key :keyword] [:ref :form/r] (f/form-get m (f/keyword-form key)))
(defn- assoc [m [:ref :form/r] key :keyword value [:ref :form/r]] [:ref :form/r]
 (f/assoc-form m (f/keyword-form key) value))
(defn- empty-map [] [:ref :form/r] (f/form-map (f/no-forms)))
(defn- text [node [:ref :form/r]] :string
 (cond (f/is-keyword? node) (keyword-name (f/keyword-value node))
       (f/is-string? node) (f/string-value node) :else ""))
(defn- has-text? [values [:ref :form/r] value :string] :bool
 (loop [i 0]
  (cond (= i (f/count-of values)) false (string=? (text (f/nth-of values i)) value) true :else (recur (+ i 1)))))
(defn- find-command [contract [:ref :form/r] name :string] [:ref :form/r]
 (let [commands (get contract :kotoba.cli.contract/commands)]
  (if (or (not (f/is-vec? commands)) (not= (f/count-of commands) 12)) (throw :cli/contract)
   (loop [i 0]
    (cond (= i (f/count-of commands)) (f/nil-form)
          (string=? (text (get (f/nth-of commands i) :id)) name) (f/nth-of commands i)
          :else (recur (+ i 1)))))))
(defn- find-option [spec [:ref :form/r] flag :string] [:ref :form/r]
 (let [options (get spec :options)]
  (loop [i 0]
   (cond (= i (f/count-of options)) (f/nil-form)
         (has-text? (get (f/nth-of options i) :flags) flag) (f/nth-of options i)
         :else (recur (+ i 1))))))
(defn- integer [value :string] :i64
 (let [n (string-length value)]
  (if (= n 0) (throw :cli/int)
   (let [first (string-code-point-at value 0) negative (= first 45)
         start (if (or negative (= first 43)) 1 0)]
    (if (= start n) (throw :cli/int)
     (let [parsed (loop [i start acc 0 bad false]
                    (if (or bad (= i n)) (if bad (pair acc 1) (pair acc 0))
                     (let [cp (string-code-point-at value i) digit (- cp 48)
                           invalid (or (< cp 48) (> cp 57) (< acc -922337203685477580)
                                       (and (= acc -922337203685477580) (> digit (if negative 8 7))))]
                      (if invalid (recur n acc true) (recur (+ i 1) (- (* acc 10) digit) false)))))]
      (if (= (pair-second parsed) 1) (throw :cli/int)
       (if negative (pair-first parsed) (- 0 (pair-first parsed))))))))))
(defn- value [option [:ref :form/r] input :string] [:ref :form/r]
 (let [kind (get option :type)]
  (cond (f/eq kind (f/keyword-form :boolean))
          (cond (string=? input "true") (f/bool-form true) (string=? input "false") (f/bool-form false)
                :else (throw :cli/boolean))
        (f/eq kind (f/keyword-form :int)) (f/int-form (integer input))
        (f/eq kind (f/keyword-form :enum))
          (if (has-text? (get option :values) input) (f/keyword-form (keyword-from-string input)) (throw :cli/enum))
        (or (f/eq kind (f/keyword-form :string)) (f/eq kind (f/keyword-form :path)) (f/eq kind (f/keyword-form :edn)))
          (f/string-form input)
        :else (throw :cli/contract))))
(defn- add-option [options [:ref :form/r] option [:ref :form/r] input [:ref :form/r]] [:ref :form/r]
 (let [id (get option :id) previous (f/form-get options id)]
  (if (f/is-true? (get option :repeatable?))
   (f/assoc-form options id (f/form-vec (f/append-form (if (f/is-nil? previous) (f/no-forms) (f/kids-of previous)) input)))
   (if (f/form-has? options id) (throw :cli/duplicate-option) (f/assoc-form options id input)))))
(defn- option? [word :string] :bool (and (> (string-length word) 1) (= (string-code-point-at word 0) 45)))
(defn- equals-at [word :string] :i64
 (loop [i 0]
  (if (= i (string-length word)) -1
   (let [cp (string-code-point-at word i)]
    (if (= cp 61) i (recur (+ i (cond (< cp 128) 1 (< cp 2048) 2 (< cp 65536) 3 :else 4))))))))
(defn- with-defaults [spec [:ref :form/r] i :i64 options [:ref :form/r]] [:ref :form/r]
 (let [declared (get spec :options)]
  (if (= i (f/count-of declared)) options
   (let [option (f/nth-of declared i) id (get option :id)]
    (with-defaults spec (+ i 1)
     (if (and (not (f/form-has? options id)) (f/form-has? option (f/keyword-form :default)))
      (f/assoc-form options id (get option :default)) options))))))
(defn- required-options [spec [:ref :form/r] options [:ref :form/r] operation :string i :i64] :i64
 (let [declared (get spec :options)]
  (if (= i (f/count-of declared)) 0
   (let [option (f/nth-of declared i) required (or (f/is-true? (get option :required?)) (has-text? (get option :required-for) operation))]
    (if (and required (not (f/form-has? options (get option :id)))) (throw :cli/required-option)
     (required-options spec options operation (+ i 1)))))))
(defn- required-positionals [declared [:ref :form/r] count :i64 i :i64] :i64
 (if (= i (f/count-of declared)) 0
  (if (and (>= i count) (f/is-true? (get (f/nth-of declared i) :required?))) (throw :cli/required-positional)
   (required-positionals declared count (+ i 1)))))
(defn- finish [spec [:ref :form/r] positionals [:list [:ref :form/r]] options [:ref :form/r]] [:ref :form/r]
 (let [provided (f/form-vec positionals) subcommands (get spec :subcommands)
       subcommand (if (and (> (f/count-of provided) 0) (has-text? subcommands (text (f/nth-of provided 0))))
                    (text (f/nth-of provided 0)) "")
       operation (text (get options :operation))
       conflict (if (and (not (string=? subcommand "")) (not (string=? operation "")) (not (string=? subcommand operation)))
                  (throw :cli/subcommand-conflict) 0)
       effective (if (string=? subcommand "") operation subcommand)
       actual (if (string=? subcommand "") provided (f/form-vec (f/rest-list provided)))
       defaults (with-defaults spec 0 options)
       required (required-options spec defaults effective 0)
       positional (required-positionals (get spec :positionals) (f/count-of actual) 0)]
  (assoc (assoc (assoc (assoc (empty-map) :command (get spec :id)) :positionals actual) :options defaults)
    :subcommand (if (string=? effective "") (f/nil-form) (f/keyword-form (keyword-from-string effective))))))
(defn- parse-tail [spec [:ref :form/r] argv [:list :string] i :i64
                  positionals [:list [:ref :form/r]] options [:ref :form/r] literal :bool] [:ref :form/r]
 (if (= i (vector-count argv)) (finish spec positionals options)
  (let [word (typed-list-nth [:list :string] argv i)]
   (cond (and (not literal) (string=? word "--")) (parse-tail spec argv (+ i 1) positionals options true)
         (and (not literal) (option? word))
           (let [equals (equals-at word) flag (if (< equals 0) word (string-substring word 0 equals))
                 option (find-option spec flag)]
            (if (f/is-nil? option) (throw :cli/unknown-option)
             (if (>= equals 0)
              (parse-tail spec argv (+ i 1) positionals (add-option options option (value option (string-substring word (+ equals 1) (string-length word)))) false)
              (let [boolean (f/eq (get option :type) (f/keyword-form :boolean)) next (+ i 1)
                    following (if (< next (vector-count argv)) (typed-list-nth [:list :string] argv next) "")
                    explicit (and boolean (< next (vector-count argv)) (or (string=? following "true") (string=? following "false")))]
               (if (and boolean (not explicit))
                (parse-tail spec argv next positionals (add-option options option (f/bool-form true)) false)
                (if (or (>= next (vector-count argv)) (and (option? following) (not (f/eq (get option :type) (f/keyword-form :int)))))
                 (throw :cli/missing-value)
                 (parse-tail spec argv (+ i 2) positionals (add-option options option (value option following)) false)))))))
         :else (parse-tail spec argv (+ i 1) (f/append-form positionals (f/string-form word)) options literal)))))
(defn- parse [contract [:ref :form/r] argv [:list :string]] [:ref :form/r]
 (if (or (= (vector-count argv) 0) (> (vector-count argv) 256)) (throw :cli/argv-budget)
  (let [spec (find-command contract (typed-list-nth [:list :string] argv 0))]
   (if (f/is-nil? spec) (throw :cli/unknown-command)
    (parse-tail spec argv 1 (f/no-forms) (empty-map) false)))))
(defn parse-argv [contract [:ref :form/r] argv [:list :string]] [:result [:ref :form/r] :keyword]
 (try (result-ok-of [:result [:ref :form/r] :keyword] (parse contract argv))
  (catch :keyword reason (result-err-of [:result [:ref :form/r] :keyword] reason))))
