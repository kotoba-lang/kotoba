(ns kotoba.library-catalog
  "Compatibility facade for the language-owned public source import contract.
  The bundled catalog remains in lib/catalog.edn; aliases never grant authority."
  (:require [kotoba.lang.library-import :as import]))

(def catalog-version import/catalog-version)
(def library-id? import/library-id?)
(def validate import/validate)
(def resolve-library import/resolve-library)
(def source-paths import/source-paths)
