(ns kotoba.principal-identity
  "Public Stable Principal enrollment for `kotoba id`.

  The browser owns the Passkey ceremony.  The CLI receives only a one-time
  public projection after the signed-in user approves the displayed device
  code; no Passkey private key, session cookie, wallet seed, or bearer token
  is written here."
  (:require [kotoba.bytes :as kbytes] [json.data-json :as json]
            [clojure.edn :as edn]
            [clojure.java.io :as io]
            [kotoba.lang.text :as str]
            [kotoba.endpoint-config :as endpoint-config]
            [kotoba.security.information-flow :as information-flow])
  (:import [java.awt Desktop Desktop$Action]
           [java.net URI]
           [java.net.http HttpClient HttpRequest HttpRequest$BodyPublishers HttpResponse$BodyHandlers]
           [java.nio.file Files OpenOption StandardOpenOption]
           [java.nio.file.attribute FileAttribute PosixFilePermissions]
           [java.time Duration Instant]))

(def canonical-rp-id
  "The Passkey RP `kotoba id new` uses unless `--rp-id` names another. Always
  allowed, always the implicit default; the environment can add RPs to the
  allow-list but can never replace or reorder this one."
  "auth.kotoba.cloud")
(def canonical-origin (str "https://" canonical-rp-id))

(def rp-ids-env
  "Comma-separated ADDITIONAL Passkey RPs. The variable only EXTENDS the
  allow-list (`canonical-rp-id` is always first and always the implicit
  default): a non-canonical RP is used only when named explicitly with
  `--rp-id`, and its enrollment is flagged (`:non-canonical-rp?`), warned about
  on stderr, and recorded in principal.edn. Every entry must be a bare
  lowercase DNS hostname (no scheme, port or path), and the device flow is
  spoken to `https://<rp-id>` -- the RP and the origin can never be
  configured apart. Rationale: whatever sets the environment of a shell (a
  dotfile, a CI variable, a wrapper script) must not be able to silently
  redirect identity enrollment to another host."
  "KOTOBA_PASSKEY_RP_IDS")

(def ^:private non-public-suffixes
  "Special-use / private namespaces that are never a public Passkey RP."
  [".localhost" ".local" ".internal" ".home.arpa"])

(defn- ip-shaped?
  "Whether HOST embeds an IPv4 address: four consecutive all-numeric labels
  (`169.254.169.254.nip.io`) or a dashed quad label (`169-254-169-254.sslip.io`)
  -- wildcard-DNS services resolve those to the embedded address."
  [host]
  (let [labels (str/split host #"\.")
        octet? #(re-matches #"\d{1,3}" %)]
    (boolean
     (or (some #(re-matches #"\d{1,3}(?:-\d{1,3}){3}" %) labels)
         (some #(every? octet? %) (partition 4 1 labels))))))

(defn valid-rp-id?
  "A bare lowercase public DNS hostname with at least two labels: not under a
  special-use suffix (.localhost, .local, .internal, .home.arpa) and not an
  IP address dressed as a hostname."
  [rp-id]
  (boolean
   (and (string? rp-id)
        (<= (count rp-id) 253)
        (re-matches #"(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z][a-z0-9-]{0,61}[a-z0-9]"
                    rp-id)
        (not-any? #(or (str/ends-with? rp-id %) (= rp-id (subs % 1))) non-public-suffixes)
        (not (ip-shaped? rp-id)))))

(defn allowed-rp-ids
  "The ordered Passkey RP allow-list: `canonical-rp-id` first, then any valid
  hostnames from `KOTOBA_PASSKEY_RP_IDS`. Invalid entries are never allowed
  and are reported on stderr."
  []
  (let [configured (endpoint-config/env-list rp-ids-env)]
    (doseq [entry (remove valid-rp-id? configured)]
      (binding [*out* *err*]
        (println (str "kotoba: ignoring invalid Passkey RP " (pr-str entry) " from "
                      rp-ids-env " (expected a bare lowercase hostname)"))))
    (vec (distinct (cons canonical-rp-id (filter valid-rp-id? configured))))))

(defn default-rp-id
  "The RP `kotoba id new` asks for when none is given: always the canonical
  RP, whatever the environment says."
  []
  canonical-rp-id)

(defn canonical-rp?
  [rp-id]
  (= canonical-rp-id rp-id))

(defn allowed-rp-id?
  [rp-id]
  (boolean (some #{rp-id} (allowed-rp-ids))))

(defn rp-origin
  "The only origin a given RP's device flow is spoken to."
  [rp-id]
  (str "https://" rp-id))

(defn verification-uri-ok?
  "Whether URI (the RP's `verificationUriComplete`) may be opened in a browser:
  an absolute `https` URL on exactly RP-ID's origin (`https://<rp-id>`, port
  absent or 443, no userinfo). With a configurable RP this value comes from a
  possibly third-party server and is handed to the OS URL opener, so it must
  not be able to name another site, a `file:` URL, or an option."
  [rp-id uri]
  (boolean
   (when (and (string? uri) (string? rp-id))
     (try
       (let [parsed (URI. uri)]
         (and (= "https" (.getScheme parsed))
              (not (.isOpaque parsed))
              (nil? (.getRawUserInfo parsed))
              (= rp-id (some-> (.getHost parsed) str/lower))
              (#{-1 443} (.getPort parsed))))
       (catch Exception _ false)))))

(defn open-command
  "The macOS `open` invocation for URL. `--` ends option parsing, so even a
  value starting with `-` can never be read as an option."
  [url]
  ["open" "--" url])
(def principal-relpath "kotoba/principal.edn")

(def ^:dynamic *principal-path* nil)
(def ^:dynamic *browser-open!* nil)
(def ^:dynamic *device-authorize!* nil)

(declare public-identity?)

(defn principal-path*
  [xdg-data-home home]
  (.getPath (io/file (if (and (string? xdg-data-home)
                              (not (str/blank? xdg-data-home)))
                       xdg-data-home
                       (str home "/.local/share"))
                     principal-relpath)))

(defn principal-path
  []
  (or *principal-path*
      (principal-path* (System/getenv "XDG_DATA_HOME")
                       (or (System/getenv "HOME")
                           (System/getProperty "user.home")))))

(defn- set-posix-mode!
  [path mode]
  (try
    (Files/setPosixFilePermissions path (PosixFilePermissions/fromString mode))
    (catch UnsupportedOperationException _)))

(defn write-principal!
  "Persist only the verified public projection, mode 0600."
  ([path identity] (write-principal! path identity canonical-rp-id))
  ([path identity rp-id]
   (write-principal! path identity rp-id (not (canonical-rp? rp-id))))
  ([path identity rp-id non-canonical-rp?]
   (when-not (public-identity? identity)
     (throw (ex-info "principal projection is not verified public identity"
                     {:problem :id/invalid-principal-projection})))
   (let [flow-decision
         (information-flow/evaluate-egress
          {:subject (:principalId identity)
           :purpose :kotoba.principal/store-public-projection
           :now (str (Instant/now))
           :input-classifications [:public]
           :output-classification :public})]
     (when-not (:information-flow/allowed? flow-decision)
       (throw (ex-info "principal projection rejected by information-flow policy"
                       {:problem :id/information-flow-denied
                        :decision flow-decision}))))
   (let [nio (.toPath (io/file path))
         parent (.getParent nio)
         record (cond-> {:kotoba.principal/version 1
                 :kotoba.principal/id (:principalId identity)
                 :kotoba.principal/username (:handle identity)
                 :kotoba.principal/account-did (:accountDid identity)
                 :kotoba.principal/controller (:activeDid identity)
                 :kotoba.principal/rp-id rp-id
                 :kotoba.principal/verified-at (str (Instant/now))}
                  non-canonical-rp? (assoc :kotoba.principal/non-canonical-rp? true))]
     (when parent
       (Files/createDirectories parent (make-array FileAttribute 0))
       (set-posix-mode! parent "rwx------"))
     (Files/write nio
                  (kbytes/utf8-bytes (str (pr-str record) "\n"))
                  (into-array OpenOption [StandardOpenOption/CREATE
                                          StandardOpenOption/TRUNCATE_EXISTING
                                          StandardOpenOption/WRITE]))
     (set-posix-mode! nio "rw-------")
     record)))

(defn read-principal
  ([] (read-principal (principal-path)))
  ([path]
   (let [file (io/file path)]
     (when (.isFile file)
       (try
         (let [record (edn/read-string {:readers {} :default (fn [_ _] nil)} (slurp file))]
           (when (= 1 (:kotoba.principal/version record)) record))
         (catch Exception _ nil))))))

(defn public-identity?
  [identity]
  (and (true? (:valid identity))
       (string? (:principalId identity))
       (or (str/starts-with? (:principalId identity) "did:")
           (str/starts-with? (:principalId identity) "urn:kotoba:principal:"))
       (string? (:accountDid identity))
       (str/starts-with? (:accountDid identity) "did:")
       (string? (:activeDid identity))
       (str/starts-with? (:activeDid identity) "did:")
       (string? (:handle identity))
       (not (str/blank? (:handle identity)))
       (every? #(not (str/includes? % "\n"))
               ((juxt :principalId :accountDid :activeDid :handle) identity))))

(defn- post-json
  [origin path body]
  (let [client (.build (-> (HttpClient/newBuilder)
                           (.connectTimeout (Duration/ofSeconds 5))))
        request (-> (HttpRequest/newBuilder (URI/create (str origin path)))
                    (.timeout (Duration/ofSeconds 10))
                    (.header "accept" "application/json")
                    (.header "content-type" "application/json")
                    (.POST (HttpRequest$BodyPublishers/ofString (json/write-str body)))
                    (.build))
        response (.send client request (HttpResponse$BodyHandlers/ofString))
        retry-after-value (.firstValue (.headers response) "retry-after")
        retry-after (when (.isPresent retry-after-value)
                      (try
                        (Long/parseLong (.get retry-after-value))
                        (catch NumberFormatException _ nil)))]
    {:status (.statusCode response)
     :retry-after retry-after
     :body (try
             (json/read-str (.body response) {:key-fn keyword})
             (catch Exception _ {}))}))

(defn device-retry-delay-seconds
  "Return the bounded delay for a retryable device-token response.  428 keeps
  the advertised interval; 429 honors Retry-After and otherwise applies the
  OAuth device-flow slow-down rule."
  [status interval retry-after]
  (when (#{428 429} status)
    (long (max 1
               (min 300
                    (if (= 429 status)
                      (max interval (or retry-after (+ interval 5)))
                      interval))))))

(defn open-browser!
  [url]
  (try
    (cond
      (and (Desktop/isDesktopSupported)
           (.isSupported (Desktop/getDesktop) Desktop$Action/BROWSE))
      (do (.browse (Desktop/getDesktop) (URI/create url)) true)

      (= "Mac OS X" (System/getProperty "os.name"))
      (do (.start (ProcessBuilder. ^java.util.List (open-command url))) true)

      :else false)
    (catch Exception _ false)))

(defn device-authorize!
  ([] (device-authorize! (default-rp-id)))
  ([rp-id]
   (when-not (allowed-rp-id? rp-id)
     (throw (ex-info "Passkey RP is not in the allow-list"
                     {:error :noncanonical-rp :rp-id rp-id})))
   (let [origin (rp-origin rp-id)
         {:keys [status body]} (post-json origin "/v1/device/start" {})]
     (when-not (= 200 status)
       (throw (ex-info "Kotoba identity service refused device authorization"
                       {:status status :error (:error body)})))
     (let [code (:deviceCode body)
           verification (:verificationUriComplete body)
           _ (when-not (verification-uri-ok? rp-id verification)
               ;; Refused before anything is opened or printed as a link.
               (throw (ex-info "Passkey RP returned a verification URI outside its own origin"
                               {:error :verification-uri-mismatch
                                :rp-id rp-id
                                :expected-origin origin})))
           interval (long (max 1 (or (:interval body) 2)))
           deadline (+ (System/currentTimeMillis)
                       (* 1000 (long (or (:expiresIn body) 600))))
           opened? ((or *browser-open!* open-browser!) verification)]
       (binding [*out* *err*]
         (println "PasskeyでKotoba CLIを接続してください:")
         (println verification)
         (println "確認コード:" (:userCode body))
         (when-not opened? (println "ブラウザを自動で開けなかったため、上のURLを開いてください。")))
       (loop []
         (when (>= (System/currentTimeMillis) deadline)
           (throw (ex-info "Kotoba Passkey approval timed out" {:error :expired-token})))
         (let [{poll-status :status poll-body :body poll-retry-after :retry-after}
               (post-json origin "/v1/device/token" {:deviceCode code})]
           (cond
             (= 200 poll-status) (:identity poll-body)
             (#{428 429} poll-status)
             (do (Thread/sleep (* 1000 (device-retry-delay-seconds
                                        poll-status interval poll-retry-after)))
                 (recur))
             :else (throw (ex-info "Kotoba Passkey approval failed"
                                   {:status poll-status :error (:error poll-body)})))))))))

(defn- canonical-principal-exists?
  "Whether principal.edn already holds an enrollment with the canonical RP."
  []
  (when-let [record (read-principal)]
    (canonical-rp? (or (:kotoba.principal/rp-id record) canonical-rp-id))))

(defn enroll-result
  "Enroll through the device flow of the requested (allow-listed) RP.

  Replacing an existing CANONICAL principal with one from a non-canonical RP
  is refused (`:id/canonical-principal-exists`) unless `:force?`: it swaps the
  identity every later command acts as, and should never happen as a side
  effect of a configured allow-list."
  ([authority-result] (enroll-result authority-result {}))
  ([authority-result {:keys [force?]}]
  (let [requested-rp (get-in authority-result [:kotoba.cli/data :controller :rp-id])
        allowed (allowed-rp-ids)]
    ;; Refused before any browser opens, exactly as before; the allow-list is
    ;; `[canonical-rp-id]` unless the operator configured one.
    (cond
      (not (some #{requested-rp} allowed))
      {:kotoba.cli/ok? false
       :kotoba.cli/code :id/noncanonical-rp
       :kotoba.cli/message (str "kotoba id new uses an allow-listed Passkey RP "
                                (str/join ", " allowed))
       :kotoba.cli/data {:requested-rp-id requested-rp :rp-id (first allowed)
                         :allowed-rp-ids allowed}}

      (and (not (canonical-rp? requested-rp))
           (not force?)
           (canonical-principal-exists?))
      {:kotoba.cli/ok? false
       :kotoba.cli/code :id/canonical-principal-exists
       :kotoba.cli/message (str "a principal enrolled with " canonical-rp-id
                                " exists; pass --force to replace it with one from "
                                requested-rp)
       :kotoba.cli/data {:requested-rp-id requested-rp
                         :path (principal-path)
                         :hint "kotoba id new --rp-id <rp> --force"}}

      :else
      (try
        (let [rp-id requested-rp
              non-canonical? (not (canonical-rp? rp-id))
              _ (when non-canonical?
                  ;; The projection a non-canonical RP returns is only
                  ;; shape-checked here; say so where a human will see it.
                  (binding [*out* *err*]
                    (println (str "kotoba: WARNING enrolling with non-canonical Passkey RP "
                                  rp-id " (canonical: " canonical-rp-id "). Its identity "
                                  "projection is shape-checked only, not vouched for by "
                                  canonical-rp-id "."))))
              identity (if *device-authorize!*
                         (*device-authorize!* rp-id)
                         (device-authorize! rp-id))]
          (if-not (public-identity? identity)
            {:kotoba.cli/ok? false :kotoba.cli/code :id/invalid-principal-projection
             :kotoba.cli/data {:rp-id rp-id}}
            (let [path (principal-path)
                  stored (write-principal! path identity rp-id non-canonical?)]
              {:kotoba.cli/ok? true
               :kotoba.cli/code :id/enrolled
               :kotoba.cli/data
               (cond-> {:principal (:kotoba.principal/id stored)
                        :username (:kotoba.principal/username stored)
                        :account-did (:kotoba.principal/account-did stored)
                        :controller (cond-> {:kind :passkey
                                             :rp-id rp-id
                                             :did (:kotoba.principal/controller stored)}
                                      non-canonical? (assoc :non-canonical-rp? true))
                        :method :passkey-smart-account
                        :proof :webauthn-passkey
                        :custody :passkey-provider
                        :authority :verified-device-flow
                        :path path
                        :chain-default nil}
                 non-canonical? (assoc :non-canonical-rp? true)
                 (seq (get-in authority-result [:kotoba.cli/data :accounts]))
                 (assoc :accounts (get-in authority-result [:kotoba.cli/data :accounts])))})))
        (catch Exception error
          {:kotoba.cli/ok? false
           :kotoba.cli/code :id/enrollment-failed
           :kotoba.cli/message (ex-message error)
           :kotoba.cli/data (merge {:rp-id requested-rp}
                                   (select-keys (ex-data error) [:status :error]))}))))))

(defn show-result
  []
  (if-let [record (read-principal)]
    {:kotoba.cli/ok? true :kotoba.cli/code :id/shown
     :kotoba.cli/data {:principal (:kotoba.principal/id record)
                       :username (:kotoba.principal/username record)
                       :account-did (:kotoba.principal/account-did record)
                       :controller (cond-> {:kind :passkey
                                            :rp-id (:kotoba.principal/rp-id record)
                                            :did (:kotoba.principal/controller record)}
                                     (:kotoba.principal/non-canonical-rp? record)
                                     (assoc :non-canonical-rp? true))
                       :path (principal-path)}}
    {:kotoba.cli/ok? false :kotoba.cli/code :id/not-enrolled
     :kotoba.cli/data {:path (principal-path)
                       :hint "run `kotoba id new`"}}))
