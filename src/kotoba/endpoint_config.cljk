(ns kotoba.endpoint-config
  "Operator-selected endpoint lists (docs/ADR-configurable-endpoints.md).

  Every network endpoint the CLI reaches by default is a *default*, not an
  authority: routers, gateways, catalog mirrors, the hosted storage origin and
  the Passkey RP allow-list can all be replaced by the operator. The mechanism
  is the one the launcher already used for `KOTOBA_IPNS_ROUTERS` and
  `KOTOBA_CONTROL_PLANE_PROFILES` -- a comma-separated environment variable,
  overridden in turn by repeatable CLI flags -- so there is one rule to learn:

    CLI flag(s)  >  environment variable  >  built-in ordered defaults

  Order is preserved and duplicates are dropped; blank entries are ignored. A
  set-but-blank variable is treated as unset, so `KOTOBA_ROUTERS=` cannot
  silently produce an empty list that disables discovery.

  Nothing here adds trust. Whatever a configured host returns is still checked
  by the caller exactly as before (CID, size cap, no redirects, signatures)."
  (:require [kotoba.lang.text :as str]))

(def ^:dynamic *getenv*
  "Narrow environment seam so tests never mutate the process environment."
  #?(:clj #(System/getenv ^String %)
     :cljs #(aget (.-env js/process) %)))

(defn parse-list
  "Comma-separated RAW as an ordered, distinct vector of trimmed entries, or
  nil when RAW is nil/blank or names nothing."
  [raw]
  (when (and (string? raw) (not (str/blank? raw)))
    (let [entries (->> (str/split raw #",")
                       (map str/trim)
                       (remove str/blank?)
                       distinct
                       vec)]
      (when (seq entries) entries))))

(defn env-list
  "The list named by environment variable NAME, or nil when unset/blank."
  [name]
  (parse-list (*getenv* name)))

(defn resolve-list
  "CLI values (a seq, possibly empty) > env var NAME > DEFAULTS."
  [cli-values name defaults]
  (or (some->> cli-values (remove str/blank?) distinct seq vec)
      (env-list name)
      (vec defaults)))
