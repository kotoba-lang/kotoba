(ns kotoba.endpoint-config
  "Operator-selected endpoint lists (docs/ADR-configurable-endpoints.md).

  Every network endpoint the CLI reaches by default is a *default*, not an
  authority: routers, gateways, catalog mirrors, the hosted storage origin and
  the Passkey RP allow-list can all be replaced by the operator. The mechanism
  is the one the launcher already used for `KOTOBA_IPNS_ROUTERS` and
  `KOTOBA_CONTROL_PLANE_PROFILES` -- a comma-separated environment variable,
  overridden in turn by repeatable CLI flags -- so there is one rule to learn:

    CLI flag(s)  >  environment variable  >  built-in ordered defaults

  Order is preserved and duplicates are dropped; blank entries are ignored. A
  set-but-blank variable is treated as unset, so `KOTOBA_ROUTERS=` cannot
  silently produce an empty list that disables discovery.

  Entries that are not absolute http(s) URLs (or carry userinfo, a query or a
  fragment) are dropped with a stderr warning; a list left empty by that is an
  error (`resolve-endpoints`). Trailing `/` is stripped.

  Nothing here adds trust. Whatever a configured host returns is still checked
  by the caller exactly as before (CID, size cap, no redirects, signatures)."
  (:require [kotoba.lang.text :as str]))

(def ^:dynamic *getenv*
  "Narrow environment seam so tests never mutate the process environment."
  #?(:clj #(System/getenv ^String %)
     :cljs #(aget (.-env js/process) %)))

(defn parse-list
  "Comma-separated RAW as an ordered, distinct vector of trimmed entries, or
  nil when RAW is nil/blank or names nothing."
  [raw]
  (when (and (string? raw) (not (str/blank? raw)))
    (let [entries (->> (str/split raw #",")
                       (map str/trim)
                       (remove str/blank?)
                       distinct
                       vec)]
      (when (seq entries) entries))))

(defn env-list
  "The list named by environment variable NAME, or nil when unset/blank."
  [name]
  (parse-list (*getenv* name)))

(defn resolve-list
  "CLI values (a seq, possibly empty) > env var NAME > DEFAULTS."
  [cli-values name defaults]
  (or (some->> cli-values (remove str/blank?) distinct seq vec)
      (env-list name)
      (vec defaults)))

;; ---------------------------------------------------------------------------
;; Endpoint validation (review of PR #632, finding 3).
;;
;; A malformed entry used to reach `URI/create` / the HTTP client and throw
;; IllegalArgumentException out of the whole operation, and a trailing `/`
;; produced `//ipfs/...`. Entries are now checked once, where they enter.

(defn- plausible-endpoint-text?
  "Platform-independent pre-checks, so the JVM and JS parsers (which disagree
  on edge forms such as an empty query or an empty authority) reject the same
  inputs: an explicit `http(s)://` followed directly by an authority, and no
  `?` / `#` anywhere (an empty query or fragment is still one)."
  [entry]
  (and (re-matches #"(?i)https?://[^/?#\s].*" entry)
       (not (re-find #"[?#\s]" entry))))

(defn normalize-endpoint
  "ENTRY as a normalized base URL, or nil when it is not one.

  Accepted: absolute `http`/`https` URLs with a host, no userinfo, no query,
  no fragment, port (if any) 1-65535. Scheme and host are lowercased (so
  entries differing only in case are one entry) and trailing `/` characters
  are stripped so callers can append `/ipfs/...` or `/routing/v1/...` safely.
  A path is kept (IPNS routers are configured as `.../routing/v1`)."
  [entry]
  (when (string? entry)
    (let [entry (str/trim entry)]
      (when (plausible-endpoint-text? entry)
        #?(:clj
           (try
             (let [uri (java.net.URI. entry)
                   scheme (some-> (.getScheme uri) str/lower)
                   host (.getHost uri)
                   port (.getPort uri)]
               (when (and (#{"http" "https"} scheme)
                          (not (str/blank? host))
                          (nil? (.getRawUserInfo uri))
                          (nil? (.getRawQuery uri))
                          (nil? (.getRawFragment uri))
                          (not (.isOpaque uri))
                          (or (= -1 port) (<= 1 port 65535)))
                 (let [path (str/replace (or (.getRawPath uri) "") #"/+$" "")]
                   (str scheme "://" (str/lower host)
                        (when-not (= -1 port) (str ":" port))
                        path))))
             (catch java.net.URISyntaxException _ nil))
           :cljs
           (try
             (let [url (js/URL. entry)
                   scheme (subs (.-protocol url) 0 (dec (count (.-protocol url))))]
               (when (and (#{"http" "https"} scheme)
                          (not (str/blank? (.-hostname url)))
                          (str/blank? (.-username url))
                          (str/blank? (.-password url))
                          (str/blank? (.-search url))
                          (str/blank? (.-hash url)))
                 ;; js/URL already lowercases the host and validates the port.
                 (str scheme "://" (.-host url)
                      (str/replace (.-pathname url) #"/+$" ""))))
             (catch :default _ nil)))))))

(defn- warn! [message]
  #?(:clj (binding [*out* *err*] (println message))
     :cljs (.error js/console message)))

(defn validate-endpoints
  "Normalize ENTRIES (from SOURCE, a label such as an env var name or `--gateway`).
  Invalid entries are dropped with a warning on stderr; if entries were given
  but none is valid, fail with `:endpoint/no-valid-endpoints` rather than
  silently falling back to a default the operator did not choose."
  [entries source]
  (let [checked (map (fn [entry] [entry (normalize-endpoint entry)]) entries)
        invalid (keep (fn [[entry ok]] (when-not ok entry)) checked)
        valid (vec (distinct (keep second checked)))]
    (doseq [entry invalid]
      (warn! (str "kotoba: ignoring invalid endpoint " (pr-str entry) " from " source
                  " (expected an absolute http(s) URL without userinfo, query or fragment)")))
    (when (and (seq entries) (empty? valid))
      (throw (ex-info "no valid endpoint configured"
                      {:problem :endpoint/no-valid-endpoints
                       :source source
                       :invalid (vec invalid)})))
    valid))

(defn resolve-endpoints
  "`resolve-list`, then `validate-endpoints` on whichever layer won. Defaults
  are trusted constants and are validated too, cheaply."
  [cli-values name defaults]
  (let [cli (some->> cli-values (remove str/blank?) distinct seq vec)
        env (when-not cli (env-list name))]
    (cond
      cli (validate-endpoints cli "command-line flag")
      env (validate-endpoints env name)
      :else (validate-endpoints (vec defaults) "built-in defaults"))))
