(ns kotoba.principal-custody
  "`kotoba id take-custody | rotate | recover | verify` -- hold the account
  `did:webvh` update keys on this machine (cloud-kotoba/kotobase-control-plane
  ADR-2610101200).

  The account DID `did:webvh:<scid>:auth.kotoba.cloud:tenant:<user>` started
  life with server-custodied update keys: the service could rewrite it. This
  namespace generates keys HERE, asks the account's passkey to approve one
  handover entry naming them, and from then on builds, signs and appends every
  update itself. The did:webvh method is the library's
  (`foundation-identity-didwebvh`), not a second implementation of it.

  ## The keys

    active    revealed: the entry's `updateKeys` and the document's only
              verification method
    next      committed by hash only; signs the next `rotate`
    recovery  committed by hash only; signs `recover` when `next` is lost.
              Written to its OWN file -- move it off this machine.

  ## What is checked, and why (security review of PR #635)

  - B1: the handover the host publishes must be EXACTLY the entry this
    machine expects -- the previous document reduced to an allowlist with only
    the active key swapped in, parameters exactly the two lists -- and the
    parameters in force after it must carry no witness, watchers or
    deactivation inherited from the host's era. Every rotation builds its
    document from the same allowlist, so nothing the host ever put there is
    carried forward.
  - M1: one state file per DID; nothing is written until the log has been
    checked, and a DID this machine does not hold is never overwritten.
  - M2: `recover --recovery FILE` works on a machine with no state: it pins
    the log as served (trust on first use, said so in the result), checks the
    head commits to the recovery key, and recovers.
  - M3: a rotation keeps the SIGNED ENTRY in the state before sending it; a
    retry resubmits exactly that entry (or adopts it if the host had accepted
    it); a lock file serialises commands on one DID.
  - The log must be the one its URL names (`:id/did-url-mismatch`), every
    fetch must extend the pinned version (`:id/log-fork-detected`), and the
    holder's signed handover attestation lets anyone else detect a fork at
    the handover.

  ## Files (under `${XDG_DATA_HOME:-~/.local/share}/kotoba/webvh-custody/`)

    <rp-id>--<user>.edn               state, mode 0600
    <rp-id>--<user>.lock              the command lock
    <rp-id>--<user>-handover.json     the holder-signed handover attestation
                                      (public: publish it)
    recovery key                      its own file (`--recovery-out`)"
  (:require [clojure.edn :as edn]
            [clojure.java.io :as io]
            [json.data-json :as json]
            [kotoba.bytes :as kbytes]
            [kotoba.lang.text :as str]
            [kotoba.principal-identity :as principal]
            [didwebvh.did :as did]
            [didwebvh.entry :as entry]
            [didwebvh.hash :as h]
            [didwebvh.log :as log]
            [didwebvh.params :as params]
            [didwebvh.proof :as proof]
            [didwebvh.signer :as signer])
  (:import [java.net URI]
           [java.net.http HttpClient HttpRequest HttpRequest$BodyPublishers HttpResponse$BodyHandlers]
           [java.nio.channels FileChannel OverlappingFileLockException]
           [java.nio.file CopyOption Files LinkOption OpenOption StandardCopyOption StandardOpenOption]
           [java.nio.file.attribute FileAttribute PosixFilePermissions]
           [java.security SecureRandom]
           [java.time Duration Instant]))

(def state-reldir "kotoba/webvh-custody")

(def ^:dynamic *state-dir* nil)
(def ^:dynamic *http!*
  "(fn [method url body-string-or-nil] -> {:status n :body string}). nil = the
  JDK client. Bound by tests to an in-process host."
  nil)
(def ^:dynamic *sleep-ms!* nil)
(def ^:dynamic *now-ms* nil)
(def ^:dynamic *browser-open!* nil)

(def poll-interval-ms 3000)
(def handover-timeout-ms (* 11 60 1000))

;; ── small pure helpers ──────────────────────────────────────────────────────

(defn- now-ms [] (if *now-ms* (*now-ms*) (System/currentTimeMillis)))

(defn hex [bs] (apply str (map #(format "%02x" (bit-and (int %) 0xff)) bs)))

(defn unhex [s]
  (when (and (string? s) (re-matches #"[0-9a-f]{64}" s))
    (byte-array (map #(unchecked-byte (Integer/parseInt (apply str %) 16)) (partition 2 s)))))

(defn- random-bytes [n] (let [b (byte-array n)] (.nextBytes (SecureRandom.) b) b))
(defn new-seed [] (random-bytes 32))

(defn key-of
  "`{:seed hex :multikey z6Mk…}` for raw seed bytes."
  [seed]
  {:seed (hex seed) :multikey (:multikey (signer/from-seed seed))})

(defn signer-of [{:keys [seed]}] (signer/from-seed (unhex seed)))

(defn user-id-of
  "The tenant user id an account DID names (`…:tenant:<user>`), or nil."
  [account-did]
  (when (string? account-did)
    (second (re-find #":tenant:(u_[a-z0-9]{12,48})$" account-did))))

(defn log-url [rp-id user-id] (str "https://" rp-id "/tenant/" user-id "/did.jsonl"))

(defn parse-jsonl [text]
  (->> (str/split-lines (or text ""))
       (remove str/blank?)
       (mapv json/read-str)))

(defn client-custody?
  "Same rule as the host's: some entry committed to next keys."
  [entries]
  (boolean (some #(seq (get-in % ["parameters" "nextKeyHashes"])) entries)))

(defn find-handover
  "[index entry] of the first entry that commits to next keys, or nil."
  [entries]
  (first (keep-indexed (fn [i e] (when (seq (get-in e ["parameters" "nextKeyHashes"])) [i e])) entries)))

(defn proposal [active next-key recovery-hash]
  {"updateKeys" [(:multikey active)]
   "nextKeyHashes" [(h/key-hash (:multikey next-key)) recovery-hash]})

(defn proposal-code
  "The confirmation code the holder types on the approval page -- the same
  digest the host computes (`authn.webvh-custody/proposal-code`): bound to the
  account, 12 base58 characters."
  [user-id p]
  (let [d (h/hash-json {"userId" user-id
                        "updateKeys" (vec (get p "updateKeys"))
                        "nextKeyHashes" (vec (get p "nextKeyHashes"))})
        s (subs d 2 14)]
    (str (subs s 0 4) "-" (subs s 4 8) "-" (subs s 8 12))))

(def expected-context
  "The `@context` every holder document carries -- pinned, never inherited."
  ["https://www.w3.org/ns/did/v1" "https://w3id.org/security/multikey/v1"])

(def max-ttl-seconds 86400)

(defn allowed-alias?
  "An inherited `alsoKnownAs` entry that may carry over: the account's own
  did:web form, or a did:pkh wallet identity -- the same rule as the host
  (`authn.webvh-custody/allowed-alias?`)."
  [user-id s]
  (boolean
   (and (string? s)
        (or (and (str/ends-with? s (str ":tenant:" user-id))
                 (re-matches #"did:web:[a-z0-9.-]+:tenant:u_[a-z0-9]{12,48}" s))
            (re-matches #"did:pkh:eip155:[0-9]{1,12}:0x[0-9a-fA-F]{40}" s)))))

(defn valid-alias?
  "An `alsoKnownAs` entry the HOLDER may choose in a rotation: any DID."
  [s]
  (boolean (and (string? s) (<= (count s) 256) (re-matches #"did:[a-z0-9]+:[A-Za-z0-9._:%-]+" s))))

(defn extends-pin?
  "Does `entries` contain the pinned version at its pinned position? A log that
  was truncated below the pin, or that carries a different entry there (a
  fork), does not."
  [entries {:keys [version-id index]}]
  (or (nil? version-id)
      (and (integer? index) (<= 1 index (count entries))
           (= version-id (get (nth entries (dec index)) "versionId")))))

(defn- iso-seconds [ms]
  (str (.truncatedTo (Instant/ofEpochMilli ms) java.time.temporal.ChronoUnit/SECONDS)))

(defn version-time
  "ISO-8601 seconds, strictly after `previous`."
  [previous]
  (let [now (quot (now-ms) 1000)
        prev (some-> previous Instant/parse .getEpochSecond)
        sec (if (and prev (>= prev now)) (inc prev) now)]
    (iso-seconds (* 1000 sec))))

(defn document-with-key
  "The document for a version whose update key is `mk`, built from an
  ALLOWLIST: the pinned `expected-context`, the previous `id`, the aliases
  (`aliases` when the holder chose them, else the previous ones that pass
  `allowed-alias?`), and `mk` as the only verification method. Nothing else
  a host put into a document -- a `service`, extra keys, a context, a planted
  alias -- survives into the holder's versions. The host's handover uses the
  same allowlist (`authn.webvh-custody/handover-state`)."
  ([state mk user-id] (document-with-key state mk user-id nil))
  ([state mk user-id aliases]
   (let [id (get state "id")
         aliases (vec (or aliases (filter #(allowed-alias? user-id %) (get state "alsoKnownAs"))))
         vm {"id" (str id "#" mk) "type" "Multikey" "controller" id "publicKeyMultibase" mk}]
     (cond-> {"@context" expected-context
              "id" id
              "verificationMethod" [vm]
              "authentication" [(get vm "id")]
              "assertionMethod" [(get vm "id")]}
       (seq aliases) (assoc "alsoKnownAs" aliases)))))

(defn active-parameters
  "The method's own fold of the parameters of `entries` (no cryptography)."
  [entries]
  (reduce (fn [active e] (params/advance active (get e "parameters")))
          (params/initial (get (first entries) "parameters"))
          (rest entries)))

(defn inherited-problem
  "Why the parameters in force would put the holder under someone else's
  rules, or nil: a configured witness (its approvals would be required),
  watchers, or deactivation."
  [active]
  (cond
    (:deactivated? active) :deactivated
    (seq (:watchers active)) :watchers
    (seq (get-in active [:witness "witnesses"])) :witness
    (and (number? (:ttl active)) (< max-ttl-seconds (:ttl active))) :ttl
    :else nil))

(defn expected-handover
  "The parameters and state the handover at position `idx` must have, built
  here from the entry before it and the proposal."
  [entries idx p user-id]
  {"parameters" {"updateKeys" (vec (get p "updateKeys"))
                 "nextKeyHashes" (vec (get p "nextKeyHashes"))}
   "state" (document-with-key (get (nth entries (dec idx)) "state") (first (get p "updateKeys")) user-id)})

(defn handover-matches?
  "B1: the published handover is exactly the expected entry (only its
  versionId, versionTime and proof may differ -- those the method checks), and
  nothing inherited would bind the holder."
  [entries idx p user-id]
  (let [e (nth entries idx)]
    (and (pos? idx)
         (= #{"versionId" "versionTime" "parameters" "state" "proof"} (set (keys e)))
         (= (expected-handover entries idx p user-id) (select-keys e ["parameters" "state"]))
         (nil? (inherited-problem (active-parameters (subvec (vec entries) 0 (inc idx))))))))

(defn rotation-entry
  "The next entry (unsigned): reveal `reveal-mk`, commit to `commit-hashes`."
  [entries reveal-mk commit-hashes user-id & [aliases]]
  (let [prev (peek (vec entries))]
    (entry/next-entry prev {:version-time (version-time (get prev "versionTime"))
                            :parameters {"updateKeys" [reveal-mk]
                                         "nextKeyHashes" (vec commit-hashes)}
                            :state (document-with-key (get prev "state") reveal-mk user-id aliases)})))

(defn committed? [entries mk]
  (boolean (some #{(h/key-hash mk)} (get-in (peek (vec entries)) ["parameters" "nextKeyHashes"]))))

(defn verify-entries
  [entries witness-file]
  (log/verify (vec entries) {:witness-file witness-file :now (quot (now-ms) 1000)}))

;; ── files ───────────────────────────────────────────────────────────────────

(defn state-dir []
  (or *state-dir*
      (let [xdg (System/getenv "XDG_DATA_HOME")
            home (or (System/getenv "HOME") (System/getProperty "user.home"))]
        (.getPath (io/file (if (and (string? xdg) (not (str/blank? xdg))) xdg (str home "/.local/share"))
                           state-reldir)))))

(defn- slug [rp-id user-id] (str rp-id "--" user-id))
(defn state-path [rp-id user-id] (.getPath (io/file (state-dir) (str (slug rp-id user-id) ".edn"))))
(defn lock-path [rp-id user-id] (.getPath (io/file (state-dir) (str (slug rp-id user-id) ".lock"))))
(defn attestation-path [rp-id user-id] (.getPath (io/file (state-dir) (str (slug rp-id user-id) "-handover.json"))))

(def ^:private owner-only-dir (PosixFilePermissions/asFileAttribute (PosixFilePermissions/fromString "rwx------")))
(def ^:private owner-only-file (PosixFilePermissions/asFileAttribute (PosixFilePermissions/fromString "rw-------")))

(defn- ensure-parent!
  "Create the parent directory 0700 if it does not exist. An EXISTING
  directory is never chmodded: it may be one the user chose (a removable
  drive for `--recovery-out`)."
  [nio]
  (let [parent (.getParent (.toAbsolutePath nio))]
    (when-not (Files/exists parent (make-array LinkOption 0))
      (try (Files/createDirectories parent (into-array FileAttribute [owner-only-dir]))
           (catch UnsupportedOperationException _
             (Files/createDirectories parent (make-array FileAttribute 0)))))
    parent))

(defn- fsync-dir! [dir]
  (try (with-open [ch (FileChannel/open dir (into-array OpenOption [StandardOpenOption/READ]))]
         (.force ch true))
       (catch Exception _ nil)))

(defn- write-file!
  [path ^bytes bytes secret?]
  (let [target (.toPath (io/file path))
        parent (ensure-parent! target)
        tmp (.resolve parent (str "." (.getFileName target) "." (hex (random-bytes 8)) ".tmp"))
        opts (java.util.HashSet. [StandardOpenOption/CREATE_NEW StandardOpenOption/WRITE
                                  LinkOption/NOFOLLOW_LINKS])]
    (try
      (with-open [ch (try (FileChannel/open tmp opts (into-array FileAttribute (if secret? [owner-only-file] [])))
                          (catch UnsupportedOperationException _
                            (FileChannel/open tmp opts (make-array FileAttribute 0))))]
        (.write ch (java.nio.ByteBuffer/wrap bytes))
        (.force ch true))
      (Files/move tmp target (into-array CopyOption [StandardCopyOption/REPLACE_EXISTING
                                                     StandardCopyOption/ATOMIC_MOVE]))
      (fsync-dir! parent)
      (finally (Files/deleteIfExists tmp)))))

(defn write-secret-edn!
  "Write `record` to `path`: a fresh temp file created EXCLUSIVELY with mode
  0600 from the start (never a moment readable by others, no symlink
  followed), fsynced, renamed over the target, and the directory fsynced."
  [path record]
  (write-file! path (kbytes/utf8-bytes (str (pr-str record) "\n")) true)
  record)

(defn read-edn [path]
  (let [f (io/file path)]
    (when (.isFile f)
      (try (edn/read-string {:readers {} :default (fn [_ _] nil)} (slurp f))
           (catch Exception _ nil)))))

(defn read-state [rp-id user-id] (read-edn (state-path rp-id user-id)))

(defn- all-states []
  (->> (.listFiles (io/file (state-dir)))
       (filter #(and (.isFile ^java.io.File %) (str/ends-with? (.getName ^java.io.File %) ".edn")))
       (keep #(read-edn (.getPath ^java.io.File %)))
       (filter :kotoba.webvh-custody/user-id)
       vec))

(defn- write-recovery!
  "Write the recovery key file. `handover` -- `{:version-id :index
  :update-key}` of the handover this key belongs to -- is recorded once known,
  so a recovery on a machine with no state can refuse a log that forked at
  the handover (review round 2, PoC-B)."
  [path did k & [handover]]
  (when (.exists (io/file path))
    (let [existing (read-edn path)]
      (when-not (= (:multikey k) (:kotoba.webvh-recovery/multikey existing))
        (throw (ex-info (str "refusing to overwrite an existing recovery key file: " path
                             " -- pass another --recovery-out")
                        {:code :id/recovery-file-exists :path path})))))
  (write-secret-edn! path (cond-> {:kotoba.webvh-recovery/version 2
                                   :kotoba.webvh-recovery/did did
                                   :kotoba.webvh-recovery/seed (:seed k)
                                   :kotoba.webvh-recovery/multikey (:multikey k)}
                            handover (assoc :kotoba.webvh-recovery/handover handover))))

;; ── HTTP ────────────────────────────────────────────────────────────────────

(defn- jdk-http! [method url body]
  (let [client (.build (-> (HttpClient/newBuilder) (.connectTimeout (Duration/ofSeconds 5))))
        b (-> (HttpRequest/newBuilder (URI/create url))
              (.timeout (Duration/ofSeconds 20))
              (.header "accept" "application/json"))
        request (if (= "POST" method)
                  (-> b (.header "content-type" "application/json")
                      (.POST (HttpRequest$BodyPublishers/ofString body)) (.build))
                  (-> b (.GET) (.build)))
        response (.send client request (HttpResponse$BodyHandlers/ofString))]
    {:status (.statusCode response) :body (.body response)}))

(defn- http! [method url & [body]]
  ((or *http!* jdk-http!) method url (when body (json/write-str body))))

(defn- body-json [{:keys [body]}]
  (try (json/read-str body) (catch Exception _ {})))

(defn fetch-log
  "`{:entries [..] :witness-file [..]}` from the host, or `{:error kw :status n}`."
  [url]
  (let [bust (str "?t=" (now-ms))
        r (http! "GET" (str url bust))]
    (if-not (= 200 (:status r))
      {:error :id/log-unavailable :status (:status r)}
      (let [entries (try (parse-jsonl (:body r)) (catch Exception _ nil))
            wurl (str/replace url #"did\.jsonl$" "did-witness.json")
            w (http! "GET" (str wurl bust))
            wf (if (= 200 (:status w)) (let [v (body-json w)] (if (sequential? v) (vec v) [])) [])]
        (if (seq entries)
          {:entries entries :witness-file wf}
          {:error :id/log-unreadable})))))

(defn- origin-of [url]
  (let [u (URI. url)] (str (.getScheme u) "://" (.getHost u))))

;; ── results ─────────────────────────────────────────────────────────────────

(defn- fail [code & [data message]]
  (cond-> {:kotoba.cli/ok? false :kotoba.cli/code code :kotoba.cli/data (or data {})}
    message (assoc :kotoba.cli/message message)))

(defn- ok [code data] {:kotoba.cli/ok? true :kotoba.cli/code code :kotoba.cli/data data})

(defn- option [argv opt]
  (some (fn [[a b]] (when (= a opt) b)) (partition-all 2 1 argv)))

(defn- say [& xs] (binding [*out* *err*] (apply println xs)))

(defn- failure? [x] (contains? x :kotoba.cli/code))

(defn- verified-log
  "Fetch and verify; the log must be the one `url` names; enforce the pin when
  given. `{:entries :witness-file :v}` or a failure result."
  [url pin]
  (let [{:keys [entries witness-file error status]} (fetch-log url)]
    (cond
      error (fail error {:url url :status status})
      (not (extends-pin? entries pin))
      (fail :id/log-fork-detected
            {:url url :pin pin :served-head (get (peek entries) "versionId") :served-length (count entries)}
            "the served log does not extend the version this machine pinned -- rolled back or forked; nothing was signed")
      :else
      (let [v (verify-entries entries witness-file)
            named (when (:ok? v) (try (did/log-url (:did v)) (catch Exception _ nil)))]
        (cond
          (not (:ok? v))
          (fail :id/log-invalid {:url url :error (:error v) :index (:index v) :message (:message v)})
          (not= url named)
          (fail :id/did-url-mismatch {:url url :did (:did v) :did-log-url named}
                "the log served at this URL is for another DID")
          :else {:entries entries :witness-file witness-file :v v})))))

(defn- with-lock
  "Run `f` holding the lock file of this DID; `:id/busy` if another command
  holds it."
  [rp-id user-id f]
  (let [nio (.toPath (io/file (lock-path rp-id user-id)))]
    (ensure-parent! nio)
    (with-open [ch (FileChannel/open nio (into-array OpenOption [StandardOpenOption/CREATE StandardOpenOption/WRITE]))]
      (if-let [l (try (.tryLock ch) (catch OverlappingFileLockException _ nil))]
        (try (f) (finally (.release l)))
        (fail :id/busy {:lock (str nio)} "another kotoba id command is working on this DID")))))

;; ── selecting the DID ───────────────────────────────────────────────────────

(defn- enrolled-context [argv]
  (let [record (principal/read-principal)
        rp-id (or (option argv "--rp-id") (:kotoba.principal/rp-id record) principal/canonical-rp-id)
        user-id (or (option argv "--user") (user-id-of (:kotoba.principal/account-did record)))]
    (cond
      (not (principal/allowed-rp-id? rp-id)) {:error (fail :id/noncanonical-rp {:rp-id rp-id})}
      (not (and (string? user-id) (user-id-of (str ":tenant:" user-id))))
      {:error (fail :id/not-enrolled {:hint "run `kotoba id new`, or pass --user u_…"})}
      :else {:rp-id rp-id :user-id user-id :url (log-url rp-id user-id)})))

(defn- did-context [did-string]
  (let [parsed (try (did/parse did-string) (catch Exception _ nil))
        user-id (user-id-of did-string)]
    (when (and parsed user-id (nil? (:port parsed)))
      {:rp-id (:domain parsed) :user-id user-id :url (did/log-url did-string)})))

(defn- selected-context
  "Which DID a rotate/recover/verify acts on: `--did`, `--user` [+ `--rp-id`],
  `fallback-did` (a recovery file's), or the one DID this machine holds."
  [argv & [fallback-did]]
  (cond
    (option argv "--did") (or (did-context (option argv "--did")) {:error (fail :id/bad-did {:did (option argv "--did")})})
    (option argv "--user") (let [rp (or (option argv "--rp-id") principal/canonical-rp-id)
                                 u (option argv "--user")]
                             (cond
                               (not (user-id-of (str ":tenant:" u))) {:error (fail :id/bad-user {:user u})}
                               (not (principal/allowed-rp-id? rp)) {:error (fail :id/noncanonical-rp {:rp-id rp})}
                               :else {:rp-id rp :user-id u :url (log-url rp u)}))
    fallback-did (or (did-context fallback-did) {:error (fail :id/bad-did {:did fallback-did})})
    :else (let [held (filter #(#{:custodied :pending} (:kotoba.webvh-custody/status %)) (all-states))]
            (case (count held)
              0 {:error (fail :id/not-custodied {:hint "run `kotoba id take-custody` first" :state-dir (state-dir)})}
              1 (let [s (first held)]
                  {:rp-id (:kotoba.webvh-custody/rp-id s) :user-id (:kotoba.webvh-custody/user-id s)
                   :url (:kotoba.webvh-custody/log-url s)})
              {:error (fail :id/ambiguous-did {:dids (mapv :kotoba.webvh-custody/did held)}
                            "this machine holds several DIDs; pass --did or --user")}))))

;; ── the handover attestation (ADR §M6: publishing the handover) ─────────────

(defn- attestation-doc [did vid index]
  {"type" "DidWebvhHandoverAttestation" "did" did "versionId" vid "index" index})

(defn- write-attestation! [rp-id user-id did vid index active]
  (let [doc (attestation-doc did vid index)
        s (signer-of active)
        att (assoc doc "proof" [(proof/create doc {:multikey (:multikey active) :sign-fn (:sign-fn s)})])
        path (attestation-path rp-id user-id)]
    (write-file! path (kbytes/utf8-bytes (json/write-str att)) false)
    path))

(defn attestation-check
  "nil when the attestation at `path` is a valid holder signature over a
  handover that IS in `entries` at its position, else the reason."
  [path entries did]
  (let [att (try (json/read-str (slurp path)) (catch Exception _ nil))
        index (get att "index")
        e (when (and (integer? index) (<= 1 index (count entries))) (nth entries (dec index)))
        mk (first (get-in e ["parameters" "updateKeys"]))
        [hidx _] (find-handover entries)]
    (cond
      (nil? att) :unreadable
      (not= "DidWebvhHandoverAttestation" (get att "type")) :bad-type
      (not= did (get att "did")) :other-did
      (nil? e) :log-shorter-than-handover
      (not= index (some-> hidx inc)) :not-the-handover
      (not= (get att "versionId") (get e "versionId")) :different-entry-at-handover
      (not (:ok? (proof/verify (dissoc att "proof") (first (get att "proof")) {:allowed #{mk}}))) :bad-signature
      :else nil)))

;; ── take-custody ────────────────────────────────────────────────────────────

(defn- finalize-handover [state entries idx]
  (let [e (nth entries idx)
        did (get-in (peek entries) ["state" "id"])
        rp (:kotoba.webvh-custody/rp-id state)
        uid (:kotoba.webvh-custody/user-id state)
        handover {:version-id (get e "versionId") :index (inc idx)
                  :update-key (get-in state [:kotoba.webvh-custody/active :multikey])}
        att (write-attestation! rp uid did (get e "versionId") (inc idx) (:kotoba.webvh-custody/active state))
        rpath (:kotoba.webvh-custody/recovery-path state)
        seed (:kotoba.webvh-custody/recovery-seed state)
        _ (cond
            ;; the recovery file now records which handover it belongs to
            seed (write-secret-edn! rpath {:kotoba.webvh-recovery/version 2
                                           :kotoba.webvh-recovery/did did
                                           :kotoba.webvh-recovery/seed seed
                                           :kotoba.webvh-recovery/multikey (:multikey (key-of (unhex seed)))
                                           :kotoba.webvh-recovery/handover handover})
            (read-edn rpath) (write-secret-edn! rpath (assoc (read-edn rpath) :kotoba.webvh-recovery/handover handover))
            :else nil)
        state* (-> state
                   (assoc :kotoba.webvh-custody/status :custodied
                          :kotoba.webvh-custody/did did
                          :kotoba.webvh-custody/pin {:version-id (get (peek entries) "versionId")
                                                     :index (count entries)}
                          :kotoba.webvh-custody/handover handover)
                   ;; the recovery seed leaves this machine's state once custody is taken
                   (dissoc :kotoba.webvh-custody/proposal :kotoba.webvh-custody/recovery-seed))]
    (write-secret-edn! (state-path rp uid) state*)
    (ok :id/custody-taken
        {:did did
         :also-known-as (get-in e ["state" "alsoKnownAs"])
         :handover-version-id (get e "versionId")
         :update-key (get-in state* [:kotoba.webvh-custody/active :multikey])
         :recovery-path (:kotoba.webvh-custody/recovery-path state*)
         :state-path (state-path rp uid)
         :attestation-path att
         :warning (str "move the recovery key file off this machine; losing both it and this machine's next "
                       "key freezes the DID forever. Publish the attestation file wherever relying parties "
                       "will find it: it is what lets them detect a host that forks the log at the handover.")})))

(defn- take-custody*
  [argv {:keys [rp-id user-id url]}]
  (let [existing (read-state rp-id user-id)]
    (if (= :custodied (:kotoba.webvh-custody/status existing))
      (fail :id/already-custodied {:did (:kotoba.webvh-custody/did existing) :state-path (state-path rp-id user-id)})
      (let [fetched (verified-log url nil)]
        (if (failure? fetched)
          fetched
          (let [{:keys [entries]} fetched
                did (get-in (peek entries) ["state" "id"])
                pending (when (= :pending (:kotoba.webvh-custody/status existing)) existing)
                pending-p (when pending (proposal (:kotoba.webvh-custody/active pending)
                                                  (:kotoba.webvh-custody/next pending)
                                                  (:kotoba.webvh-custody/recovery-hash pending)))]
            (if-let [[idx _] (find-handover entries)]
              ;; Already handed over: ours (a previous run that died before
              ;; recording it) or someone else's -- nothing is written.
              (if (and pending-p (handover-matches? entries idx pending-p user-id))
                (finalize-handover pending entries idx)
                (fail :id/already-client-custody {:did did :handover-version-id (get (nth entries idx) "versionId")}
                      "this DID is already held by keys this machine does not have"))
              (if-let [problem (inherited-problem (active-parameters entries))]
                (fail :id/inherited-parameters {:did did :problem problem}
                      "the log carries a witness, watchers or deactivation that would bind the holder; not taking it")
                (let [state (or pending
                                (let [a (key-of (new-seed)) b (key-of (new-seed)) r (key-of (new-seed))
                                      rpath (or (option argv "--recovery-out")
                                                (.getPath (io/file (state-dir) (str (slug rp-id user-id) "-recovery.edn"))))]
                                  ;; The state FIRST, carrying the recovery seed until custody is
                                  ;; taken: a crash before the recovery file lands is resumable.
                                  (write-secret-edn! (state-path rp-id user-id)
                                                     {:kotoba.webvh-custody/version 2
                                                      :kotoba.webvh-custody/status :pending
                                                      :kotoba.webvh-custody/user-id user-id
                                                      :kotoba.webvh-custody/rp-id rp-id
                                                      :kotoba.webvh-custody/log-url url
                                                      :kotoba.webvh-custody/did did
                                                      :kotoba.webvh-custody/active a
                                                      :kotoba.webvh-custody/next b
                                                      :kotoba.webvh-custody/recovery-hash (h/key-hash (:multikey r))
                                                      :kotoba.webvh-custody/recovery-seed (:seed r)
                                                      :kotoba.webvh-custody/recovery-path rpath})))
                      _ (when-let [seed (:kotoba.webvh-custody/recovery-seed state)]
                          (write-recovery! (:kotoba.webvh-custody/recovery-path state) did (key-of (unhex seed))))
                      p (proposal (:kotoba.webvh-custody/active state) (:kotoba.webvh-custody/next state)
                                  (:kotoba.webvh-custody/recovery-hash state))
                      code (proposal-code user-id p)
                      aliases (vec (filter #(allowed-alias? user-id %) (get-in (peek entries) ["state" "alsoKnownAs"])))
                      r (http! "POST" (str (origin-of url) "/v1/webvh/custody/request") (assoc p "userId" user-id))
                      body (body-json r)
                      uri (get body "verificationUri")
                      delay-ms (* 1000 (long (or (get body "delaySeconds") 0)))]
                  (cond
                    (not= 200 (:status r))
                    (fail :id/custody-request-refused {:status (:status r) :error (get body "error")})

                    (not= code (get body "code"))
                    (fail :id/code-mismatch {:local code :host (get body "code")}
                          "the host computed a different confirmation code for this proposal; not continuing")

                    (not (and (principal/verification-uri-ok? rp-id uri)
                              (= "/webvh/custody" (.getPath (URI. uri)))
                              (nil? (.getRawQuery (URI. uri)))))
                    (fail :id/bad-verification-uri {:uri uri})

                    :else
                    (do
                      (say "Open" uri "signed in with your Passkey, and TYPE this code:")
                      (say "   " code)
                      (say "The DID will keep these aliases (alsoKnownAs):" (if (seq aliases) (str/join ", " aliases) "(none)"))
                      (say "Never type a code you did not get from this command.")
                      (say "Recovery key written to" (:kotoba.webvh-custody/recovery-path state) "-- move it off this machine.")
                      (when (pos? delay-ms)
                        (say "After approval the handover waits" (quot delay-ms 1000) "s (cancellable on that page) before it takes effect."))
                      (when-not ((or *browser-open!* principal/open-browser!) uri)
                        (say "Could not open a browser; open the URL above."))
                      (let [deadline (+ (now-ms) handover-timeout-ms delay-ms)]
                        (loop []
                          (if (> (now-ms) deadline)
                            (fail :id/handover-timeout {:did did :state-path (state-path rp-id user-id)}
                                  "not approved (or not yet effective); run `kotoba id take-custody` again -- same keys, same code")
                            (do
                              (http! "POST" (str (origin-of url) "/v1/webvh/custody/finalize") {"userId" user-id})
                              (let [polled (verified-log url nil)]
                                (if (failure? polled)
                                  polled
                                  (let [es (:entries polled)]
                                    (if-let [[idx e] (find-handover es)]
                                      (if (handover-matches? es idx p user-id)
                                        (finalize-handover state es idx)
                                        (fail :id/handover-mismatch {:did did :handover-version-id (get e "versionId")}
                                              "the published handover is not exactly the proposed one (other keys, extra document content or parameters); refusing it"))
                                      (do ((or *sleep-ms!* #(Thread/sleep (long %))) poll-interval-ms)
                                          (recur)))))))))))))))))))))

(defn take-custody-result
  "Generate keys here; have the account's passkey approve one handover entry
  naming them; check the published entry is exactly that; pin it."
  [argv]
  (let [{:keys [error rp-id user-id] :as ctx} (enrolled-context argv)]
    (if error
      error
      (try (with-lock rp-id user-id #(take-custody* argv ctx))
           (catch clojure.lang.ExceptionInfo e
             (fail (or (:code (ex-data e)) :id/take-custody-failed) (dissoc (ex-data e) :code) (ex-message e)))))))

;; ── rotate / recover ────────────────────────────────────────────────────────

(defn- complete-pending
  "A rotation from a previous run whose entry IS in the log is adopted (its
  keys become current, the pin moves). Otherwise the pending entry is kept,
  to be resubmitted exactly."
  [state entries]
  (if-let [{:keys [version-id] :as pending} (:kotoba.webvh-custody/pending state)]
    (if-let [idx (some (fn [[i e]] (when (= version-id (get e "versionId")) i)) (map-indexed vector entries))]
      (-> state
          (assoc :kotoba.webvh-custody/active (:active pending)
                 :kotoba.webvh-custody/next (:next pending)
                 :kotoba.webvh-custody/recovery-hash (:recovery-hash pending)
                 :kotoba.webvh-custody/pin {:version-id version-id :index (inc idx)})
          (cond-> (:recovery-path pending) (assoc :kotoba.webvh-custody/recovery-path (:recovery-path pending)))
          (dissoc :kotoba.webvh-custody/pending))
      state)
    state))

(defn- submit!
  "Send the pending entry of `state` and confirm it is visible."
  [state url mode]
  (let [{:keys [version-id] :as pending} (:kotoba.webvh-custody/pending state)
        e (json/read-str (:entry pending))
        r (http! "POST" (str (origin-of url) "/v1/webvh/append")
                 {"userId" (:kotoba.webvh-custody/user-id state) "entry" e})
        body (body-json r)
        path (state-path (:kotoba.webvh-custody/rp-id state) (:kotoba.webvh-custody/user-id state))]
    (cond
      ;; A permanent refusal (the host says the entry is invalid): drop it, so
      ;; the next run builds a new one instead of resubmitting forever.
      (and (<= 400 (:status r) 499) (not (#{408 409 425 429} (:status r))))
      (do (write-secret-edn! path (dissoc state :kotoba.webvh-custody/pending))
          (fail :id/append-rejected {:status (:status r) :error (get body "error") :detail (get body "detail")
                                     :version-id version-id}
                "the host rejected the signed entry; it was dropped -- run `kotoba id verify` before trying again"))

      (not= 200 (:status r))
      (fail :id/append-refused {:status (:status r) :error (get body "error") :detail (get body "detail")
                                :version-id version-id
                                :hint "run the same command again: the signed entry is kept and is resubmitted (or adopted if it landed)"})

      :else
      (let [after (verified-log url (:kotoba.webvh-custody/pin state))]
        (if (failure? after)
          after
          (let [state* (complete-pending state (:entries after))]
            (write-secret-edn! path state*)
            (if-not (= version-id (get-in state* [:kotoba.webvh-custody/pin :version-id]))
              (fail :id/append-not-visible {:version-id version-id})
              (ok (if (= :recover (or (:mode pending) mode)) :id/recovered :id/rotated)
                  (cond-> {:did (get-in (peek (:entries after)) ["state" "id"])
                           :version-id version-id
                           :update-key (get-in pending [:active :multikey])
                           :state-path path}
                    (:recovery-path pending)
                    (assoc :recovery-path (:recovery-path pending)
                           :warning "a NEW recovery key was written; move it off this machine and destroy the old one")
                    (:tofu state*)
                    (update :warning #(str % (when % " ") (:tofu state*))))))))))))

(def ^:private tofu-warning
  (str "This machine had no record of this DID, so it pinned the log as the host served it now "
       "(trust on first use): a host that forked or rolled the log back before this moment would not "
       "be detected here. Check the result with `kotoba id verify --attestation <your handover attestation>`."))

(defn- rotate*
  [argv mode {:keys [rp-id user-id url]} recovery-file]
  (let [path (state-path rp-id user-id)
        stored (read-state rp-id user-id)
        fetched (verified-log url nil)]
    (cond
      (failure? fetched) fetched

      (and (not= :custodied (:kotoba.webvh-custody/status stored)) (not= mode :recover))
      (fail :id/not-custodied {:hint "run `kotoba id take-custody` first" :state-path path})

      :else
      (let [{:keys [entries]} fetched
            tofu? (not= :custodied (:kotoba.webvh-custody/status stored))
            did* (get-in (peek entries) ["state" "id"])
            hv (:kotoba.webvh-recovery/handover recovery-file)
            att (option argv "--attestation")
            ;; Round 2, PoC-B: with no state, the served log must contain the
            ;; handover the recovery key belongs to -- as recorded in the
            ;; recovery file, or as the holder's attestation says. H(R) is
            ;; public; a fork at the handover can copy it.
            tofu-problem (when tofu?
                           (cond
                             hv (let [e (when (and (integer? (:index hv)) (<= 1 (:index hv) (count entries)))
                                          (nth entries (dec (:index hv))))]
                                  (when-not (and e (= (:version-id hv) (get e "versionId"))
                                                 (= [(:update-key hv)] (get-in e ["parameters" "updateKeys"])))
                                    :fork))
                             att (when (attestation-check att entries did*) :fork)
                             :else :unconfirmed))
            aliases-arg (option argv "--also-known-as")
            aliases (when aliases-arg (vec (remove str/blank? (map str/trim (str/split aliases-arg #",")))))
            state0 (if tofu?
                     {:kotoba.webvh-custody/version 2
                      :kotoba.webvh-custody/status :custodied
                      :kotoba.webvh-custody/user-id user-id
                      :kotoba.webvh-custody/rp-id rp-id
                      :kotoba.webvh-custody/log-url url
                      :kotoba.webvh-custody/did (get-in (peek entries) ["state" "id"])
                      :kotoba.webvh-custody/pin {:version-id (get (peek entries) "versionId") :index (count entries)}
                      :kotoba.webvh-custody/recovery-path (option argv "--recovery")
                      :kotoba.webvh-custody/handover hv
                      :tofu tofu-warning}
                     stored)
            state (complete-pending state0 entries)
            pin (:kotoba.webvh-custody/pin state)]
        (cond
          (= :fork tofu-problem)
          (fail :id/log-fork-detected {:url url :handover hv}
                "the served log does not contain the handover this recovery key belongs to -- forked; nothing was signed")

          (= :unconfirmed tofu-problem)
          (fail :id/handover-unconfirmed {:url url}
                "this recovery file does not record its handover; pass --attestation <your handover attestation>")

          (and aliases (or (empty? aliases) (< 8 (count aliases)) (not (every? valid-alias? aliases))))
          (fail :id/bad-also-known-as {:also-known-as aliases-arg} "--also-known-as takes up to 8 comma-separated DIDs")

          (not (client-custody? entries))
          (fail :id/not-custodied {:hint "this DID is still in service custody; run `kotoba id take-custody`"})

          (not (extends-pin? entries pin))
          (fail :id/log-fork-detected {:url url :pin pin :served-head (get (peek entries) "versionId")}
                "the served log does not extend the version this machine pinned; nothing was signed")

          (not= (:index pin) (count entries))
          (fail :id/unexpected-entries {:url url :pin pin :served-length (count entries)}
                "the log has versions this machine did not write -- a holder key may be compromised; run `kotoba id verify`")

          ;; M3: a signed entry from an interrupted run, not in the log, the
          ;; log still at the pin: send exactly that entry again.
          (:kotoba.webvh-custody/pending state)
          (do (write-secret-edn! path state) (submit! state url mode))

          :else
          (let [signing-key (case mode
                              :rotate (:kotoba.webvh-custody/next state)
                              :recover (when recovery-file
                                         {:seed (:kotoba.webvh-recovery/seed recovery-file)
                                          :multikey (:kotoba.webvh-recovery/multikey recovery-file)}))]
            (cond
              (nil? (:seed signing-key))
              (fail :id/recovery-key-missing {:hint "pass --recovery PATH to the recovery key file"})

              (not= (:multikey signing-key) (:multikey (key-of (unhex (:seed signing-key)))))
              (fail :id/key-file-corrupt {})

              (not (committed? entries (:multikey signing-key)))
              (fail :id/key-not-committed {:multikey (:multikey signing-key)}
                    "the log's head did not commit to this key")

              :else
              (let [did (get-in (peek entries) ["state" "id"])
                    new-next (key-of (new-seed))
                    new-recovery (when (= mode :recover) (key-of (new-seed)))
                    new-recovery-path (when new-recovery
                                        (or (option argv "--recovery-out")
                                            (str (or (:kotoba.webvh-custody/recovery-path state)
                                                     (.getPath (io/file (state-dir) (str (slug rp-id user-id) "-recovery.edn"))))
                                                 "." (count entries))))
                    recovery-hash (if new-recovery
                                    (h/key-hash (:multikey new-recovery))
                                    (:kotoba.webvh-custody/recovery-hash state))
                    e (entry/sign (rotation-entry entries (:multikey signing-key)
                                                  [(h/key-hash (:multikey new-next)) recovery-hash]
                                                  user-id aliases)
                                  (signer-of signing-key))]
                (when new-recovery (write-recovery! new-recovery-path did new-recovery
                                                    (:kotoba.webvh-custody/handover state)))
                (let [state* (assoc state :kotoba.webvh-custody/pending
                                    (cond-> {:version-id (get e "versionId")
                                             :entry (json/write-str e)
                                             :mode mode
                                             :active signing-key
                                             :next new-next
                                             :recovery-hash recovery-hash}
                                      new-recovery-path (assoc :recovery-path new-recovery-path)))]
                  (write-secret-edn! path state*)
                  (submit! state* url mode))))))))))

(defn- rotate! [argv mode]
  (let [recovery-file (when (= mode :recover)
                        (some-> (option argv "--recovery") read-edn))
        ctx (selected-context argv (when (and (= mode :recover) (nil? (option argv "--did")) (nil? (option argv "--user")))
                                     (let [held (filter #(= :custodied (:kotoba.webvh-custody/status %)) (all-states))]
                                       (when (empty? held) (:kotoba.webvh-recovery/did recovery-file)))))]
    (cond
      (:error ctx) (:error ctx)
      (and (= mode :recover) (nil? recovery-file)
           (nil? (read-edn (or (:kotoba.webvh-custody/recovery-path (read-state (:rp-id ctx) (:user-id ctx))) ""))))
      (fail :id/recovery-key-missing {:hint "pass --recovery PATH to the recovery key file"})
      :else
      (let [recovery-file (or recovery-file
                              (when (= mode :recover)
                                (read-edn (:kotoba.webvh-custody/recovery-path (read-state (:rp-id ctx) (:user-id ctx))))))]
        (try (with-lock (:rp-id ctx) (:user-id ctx) #(rotate* argv mode ctx recovery-file))
             (catch clojure.lang.ExceptionInfo e
               (fail (or (:code (ex-data e)) :id/rotate-failed) (dissoc (ex-data e) :code) (ex-message e))))))))

(defn rotate-result [argv] (rotate! argv :rotate))
(defn recover-result [argv] (rotate! argv :recover))

;; ── verify (anyone) ─────────────────────────────────────────────────────────

(defn verify-result
  "Resolve and verify an account DID's log as a third party would. `--did`
  (did:webvh), or `--user` [+ `--rp-id`], or this machine's DID.
  `--pin <versionId>` requires that version in the log; `--attestation FILE`
  checks the holder's signed handover attestation against the log.

  `:custody` is `:service`, `:holder-pinned` (the handover is confirmed by a
  pin or attestation obtained independently of this host) or
  `:holder-unpinned` (the log says the holder controls it, but a host that
  forked at the handover would show the same thing to a first-time viewer)."
  [argv]
  (let [ctx (selected-context argv)
        local (when (and (not (:error ctx)) (nil? (option argv "--did")) (nil? (option argv "--user")))
                (read-state (:rp-id ctx) (:user-id ctx)))
        local-pin (:kotoba.webvh-custody/pin local)
        pin-arg (option argv "--pin")
        att (option argv "--attestation")]
    (if (:error ctx)
      (:error ctx)
      (let [fetched (verified-log (:url ctx) local-pin)]
        (if (failure? fetched)
          fetched
          (let [{:keys [entries v]} fetched
                did (:did v)
                handover (find-handover entries)
                pin-found? (or (nil? pin-arg) (boolean (some #(= pin-arg (get % "versionId")) entries)))
                att-problem (when att (attestation-check att entries did))]
            (cond
              (and (option argv "--did") (not= (option argv "--did") did))
              (fail :id/did-mismatch {:expected (option argv "--did") :resolved did})

              (not pin-found?)
              (fail :id/log-fork-detected {:pin pin-arg :served-head (get (peek entries) "versionId")}
                    "the pinned version is not in the served log")

              att-problem
              (fail :id/log-fork-detected {:attestation att :problem att-problem}
                    "the holder's handover attestation does not match the served log")

              :else
              (let [[hidx _] handover
                    pinned? (and handover
                                 (or (and att (nil? att-problem))
                                     (and pin-arg (some (fn [[i e]] (and (>= i hidx) (= pin-arg (get e "versionId"))))
                                                        (map-indexed vector entries)))
                                     (and local-pin (>= (:index local-pin) (inc hidx)))))
                    custody (cond (nil? handover) :service pinned? :holder-pinned :else :holder-unpinned)]
                (ok :id/verified
                    (cond-> {:did did
                             :versions (count entries)
                             :head (get (peek entries) "versionId")
                             :custody custody
                             :update-keys (get-in v [:parameters :update-keys])
                             :pre-rotation? (get-in v [:parameters :pre-rotation?])
                             :witness-threshold (get-in v [:parameters :witness "threshold"])
                             :signed-by (mapv (fn [x] {:version-id (:version-id x) :signed-by (:signed-by x)})
                                              (:versions v))
                             :log-url (:url ctx)}
                      handover (assoc :handover-version-id (get (second handover) "versionId"))
                      (= custody :holder-unpinned)
                      (assoc :warning (str "the log names holder-held keys, but nothing independent of this host "
                                           "confirms the handover: a host can serve a fork at the handover to a "
                                           "first-time viewer. Pass --pin <versionId> or --attestation <file> "
                                           "obtained from the holder."))))))))))))
