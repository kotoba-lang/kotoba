(ns kotoba.cli-exec
 "Native execution of closed CLI-contract and CID-pinned module-lock checks.
  Other public operations stay unavailable until their native effect and
  admission paths exist."
 (:export [execute-request])
 (:require [kotoba.form :as f] [kotoba.compiler.module-lock :as lock]))

(defn- get [m [:ref :form/r] key :keyword] [:ref :form/r]
 (f/form-get m (f/keyword-form key)))
(defn- text [node [:ref :form/r]] :string
 (cond (f/is-keyword? node) (keyword-name (f/keyword-value node))
       (f/is-string? node) (f/string-value node) :else ""))
(defn- same? [a [:ref :form/r] b [:ref :form/r]] :bool
 (and (not (string=? (text a) "")) (string=? (text a) (text b))))
(defn- command-present? [commands [:ref :form/r] name :string i :i64] :bool
 (if (= i (f/count-of commands)) false
  (if (string=? (text (get (f/nth-of commands i) :id)) name) true
   (command-present? commands name (+ i 1)))))
(defn- required-commands? [commands [:ref :form/r]] :bool
 (and (command-present? commands "id" 0) (command-present? commands "run" 0)
      (command-present? commands "compile" 0) (command-present? commands "check" 0)
      (command-present? commands "graph" 0) (command-present? commands "git" 0)
      (command-present? commands "rad" 0) (command-present? commands "build" 0)
      (command-present? commands "test" 0) (command-present? commands "deploy" 0)
      (command-present? commands "library" 0) (command-present? commands "hinshitsu" 0)))
(defn- unique-commands [commands [:ref :form/r] i :i64 j :i64] :i64
 (if (= i (f/count-of commands)) 0
  (if (= j (f/count-of commands)) (unique-commands commands (+ i 1) (+ i 2))
   (if (same? (get (f/nth-of commands i) :id) (get (f/nth-of commands j) :id))
    (throw :cli/duplicate-command)
    (unique-commands commands i (+ j 1))))))
(defn- unique-flags [options [:ref :form/r] i :i64 flag-i :i64
                     j :i64 flag-j :i64] :i64
 (if (= i (f/count-of options)) 0
  (let [flags (get (f/nth-of options i) :flags)]
   (if (= flag-i (f/count-of flags))
    (unique-flags options (+ i 1) 0 (+ i 1) 1)
    (if (= j (f/count-of options))
     (unique-flags options i (+ flag-i 1) i (+ flag-i 2))
     (let [other (get (f/nth-of options j) :flags)]
      (if (= flag-j (f/count-of other))
       (unique-flags options i flag-i (+ j 1) 0)
       (if (same? (f/nth-of flags flag-i) (f/nth-of other flag-j))
        (throw :cli/duplicate-flag)
        (unique-flags options i flag-i j (+ flag-j 1))))))))))
(defn- unique-options [options [:ref :form/r] i :i64 j :i64] :i64
 (if (= i (f/count-of options)) 0
  (if (= j (f/count-of options)) (unique-options options (+ i 1) (+ i 2))
   (if (same? (get (f/nth-of options i) :id) (get (f/nth-of options j) :id))
    (throw :cli/duplicate-option-id)
    (unique-options options i (+ j 1))))))
(defn- flags-valid [flags [:ref :form/r] i :i64] :bool
 (if (= i (f/count-of flags)) true
  (let [flag (f/nth-of flags i) value (text flag)]
   (and (f/is-string? flag) (> (string-length value) 1)
        (= (string-code-point-at value 0) 45)
        (flags-valid flags (+ i 1))))))
(defn- options-valid [options [:ref :form/r] i :i64] :i64
 (if (= i (f/count-of options)) 0
  (let [option (f/nth-of options i) flags (get option :flags)
        kind (text (get option :type))]
   (if (or (string=? (text (get option :id)) "")
           (not (f/is-vec? flags)) (= (f/count-of flags) 0)
           (not (or (string=? kind "boolean") (string=? kind "string")
                    (string=? kind "path") (string=? kind "edn")
                    (string=? kind "enum") (string=? kind "int")))
           (not (flags-valid flags 0)))
    (throw :cli/contract-option)
    (options-valid options (+ i 1))))))
(defn- commands-valid [commands [:ref :form/r] i :i64] :i64
 (if (= i (f/count-of commands)) 0
  (let [spec (f/nth-of commands i) options (get spec :options)]
   (if (or (string=? (text (get spec :id)) "") (not (f/is-vec? options)))
    (throw :cli/contract-command)
    (let [valid (options-valid options 0)
          ids (unique-options options 0 1)
          flags (unique-flags options 0 0 0 1)]
     (commands-valid commands (+ i 1)))))))
(defn- validate [contract [:ref :form/r]] :bool
 (let [version (get contract :kotoba.cli.contract/version)
       commands (get contract :kotoba.cli.contract/commands)]
  (if (or (not (f/is-int? version)) (not= (f/int-value version) 1)
          (not (f/is-vec? commands)) (not= (f/count-of commands) 12))
   (throw :cli/contract)
   (let [unique (unique-commands commands 0 1)]
    (if (not (required-commands? commands)) (throw :cli/contract-commands)
     (let [specs (commands-valid commands 0)] true))))))
(defn execute-request [contract [:ref :form/r] request [:ref :form/r]] [:result :string :keyword]
 (try
  (let [checked (validate contract)
        command (get request :command) options (get request :options)
        kind (get options :kind) positionals (get request :positionals)]
   (if (not (f/eq command (f/keyword-form :check)))
    (throw :cli/native-execution-unavailable)
    (if (f/eq kind (f/keyword-form :cli-contract))
     (result-ok-of [:result :string :keyword] (if checked "cli-contract/v1" ""))
     (if (f/eq kind (f/keyword-form :lock))
      (if (or (not (f/is-vec? positionals)) (not= (f/count-of positionals) 1)
              (not (f/is-string? (f/nth-of positionals 0))))
       (throw :cli/lock-path-required)
       (let [validated (lock/read-lock (f/string-value (f/nth-of positionals 0)))
             identity (lock/lock-cid validated)]
        (result-ok-of [:result :string :keyword] identity)))
      (throw :cli/native-execution-unavailable)))))
  (catch :keyword reason
   (result-err-of [:result :string :keyword] reason))))
