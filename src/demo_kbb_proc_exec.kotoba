;; demo_kbb_proc_exec.kotoba — kbb proc-exec slice 2 (ADR-2607181900 readiness
;; gate): runs ONE allowlisted invocation by grant INDEX. The guest supplies
;; zero command bytes: argv, cwd, and timeout are policy-side literals
;; (:kotoba.policy/proc-exec-invocations). A grant index out of range, or a
;; command outside the policy's :proc/exec resource scope, fails closed
;; with :resource-not-permitted before any process starts.
(ns demo-kbb-proc-exec)

(defn main []
  ;; The guarded invocation throws on denial/timeout. Execute it and return
  ;; the demo's success value without treating a native i64 as a boolean.
  (do (proc-exec "0") 0))
