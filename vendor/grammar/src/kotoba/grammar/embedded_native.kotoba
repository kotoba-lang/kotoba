(defn forbidden-head? [head :string] :bool
  (>= (string-index-of forbidden-heads
                       (string-concat "|" (string-concat head "|"))) 0))
(defn admitted-head? [head :string] :bool
  (>= (string-index-of admitted-heads
                       (string-concat "|" (string-concat head "|"))) 0))
(defn string-host-op? [head :string] :bool
  (>= (string-index-of string-host-ops
                       (string-concat "|" (string-concat head "|"))) 0))
(defn data-host-op? [head :string] :bool
  (>= (string-index-of data-host-ops
                       (string-concat "|" (string-concat head "|"))) 0))
(defn raw-memory-op? [head :string] :bool
  (>= (string-index-of raw-memory-ops
                       (string-concat "|" (string-concat head "|"))) 0))
(defn diagnostic-hint [head :string] :string
  (if (string=? head ".") "forbidden: no interop method calls" (if (string=? head "..") "forbidden: no interop threading" (if (string=? head "agent") "forbidden: no agents in WASM guest" (if (string=? head "atom") "forbidden: guest is pure; put mutable state on the host" (if (string=? head "binding") "forbidden: no dynamic var mutation" (if (string=? head "catch") "admitted only as the clause of a try" (if (string=? head "count") "compiler supports fuel-bounded pair-chain count" (if (string=? head "defmacro") "forbidden: no macros in safe guest surface" (if (string=? head "doseq") "use doseq-entities host bulk op or recursion" (if (string=? head "eval") "typed eval only: request must name checked KIR by DefCID and requires :code/eval authority" (if (string=? head "filter") "portable eager and lazy filter with named, inline, or stored closure predicates" (if (string=? head "for") "forbidden-style sequence comp; use recursion / host" (if (string=? head "future") "forbidden: no threads in WASM guest" (if (string=? head "import") "forbidden: no Java/JS interop in guests" (if (string=? head "keys") "compiler returns an eager persistent pair-chain of map keys" (if (string=? head "loop") "use recursion or compiler loop sugar with fuel; unbounded loops are fuel-trapped" (if (string=? head "map") "portable eager one-to-five-source map and lazy one-to-four-source map; named, inline, and stored closure callbacks" (if (string=? head "new") "forbidden: no interop constructors" (if (string=? head "nth") "compiler supports pair-chain nth with optional default" (if (string=? head "print") "no stdout; use log-write host import under policy" (if (string=? head "println") "no stdout; use log-write host import under policy" (if (string=? head "recur") "pair with loop/recursion only inside admitted control forms" (if (string=? head "reduce") "compiler supports with-init reduce and Clojure-style no-init reduce via inline fn with []/[acc value] arities" (if (string=? head "require") "forbidden: guests cannot require; use host imports + package-lock (CID packages on L3)" (if (string=? head "reset!") "forbidden: guest is pure; host owns atoms" (if (string=? head "set") "the set constructor fn is not portable; use a bounded set literal #{...} on the compiler backend" (if (string=? head "set!") "forbidden: no ambient mutation; host owns state" (if (string=? head "str") "for host string args prefer bare string literals (auto str-ptr/str-len) or (str-ptr s)/(str-len s)" (if (string=? head "swap!") "forbidden: guest is pure; host owns atoms" (if (string=? head "throw") "admitted (abort slice 1): one error value, tail position or let binding value; the function acquires :abort and returns [:result T E]" (if (string=? head "try") "admitted (abort slice 1): one body, one (catch [error-type] binder handler) clause; lowers to result-match-of over [:result T E]" (if (string=? head "use") "forbidden: same as require — no ambient namespaces in guests" (if (string=? head "vals") "compiler returns an eager persistent pair-chain of map values" (if (string=? head "var") "forbidden: no var objects in guest" "")))))))))))))))))))))))))))))))))))

(defn strict-default? [] :bool true)
