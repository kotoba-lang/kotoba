(ns kotoba-lpy-host.math
  "What `java.lang.Math` answers, under the names Kotoba's `.cljk` sources call on the JVM."
  (:import math))

(def PI math/pi)
(def E math/e)

(defn abs [x] (python/abs x))
(defn pow [x y] (python/float (python/pow (python/float x) (python/float y))))
(defn sqrt [x] (math/sqrt x))
(defn cbrt [x] (if (neg? x) (- (python/pow (- x) (/ 1.0 3.0))) (python/pow x (/ 1.0 3.0))))
(defn floor [x] (python/float (math/floor x)))
(defn ceil [x] (python/float (math/ceil x)))
(defn round [x] (math/floor (+ x 0.5)))
(defn rint [x] (python/float (python/round x)))
(defn exp [x] (math/exp x))
(defn log [x] (math/log x))
(defn log10 [x] (math/log10 x))
(defn sin [x] (math/sin x))
(defn cos [x] (math/cos x))
(defn tan [x] (math/tan x))
(defn asin [x] (math/asin x))
(defn acos [x] (math/acos x))
(defn atan [x] (math/atan x))
(defn atan2 [y x] (math/atan2 y x))
(defn hypot [x y] (math/hypot x y))
(defn min [x y] (python/min x y))
(defn max [x y] (python/max x y))
(defn signum [x] (cond (pos? x) 1.0 (neg? x) -1.0 :else 0.0))
(defn toRadians [x] (math/radians x))
(defn toDegrees [x] (math/degrees x))
(defn floorDiv [x y] (python/int (math/floor (/ x y))))
(defn floorMod [x y] (mod x y))
