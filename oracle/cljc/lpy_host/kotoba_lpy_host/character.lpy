(ns kotoba-lpy-host.character
  "What `java.lang.Character` answers, under the same names. A char is a one-character string.")

(defn- text [c] (if (string? c) c (python/chr c)))
(defn isDigit [c] (.isdigit (text c)))
(defn isLetter [c] (.isalpha (text c)))
(defn isLetterOrDigit [c] (.isalnum (text c)))
(defn isWhitespace [c] (.isspace (text c)))
(defn isUpperCase [c] (.isupper (text c)))
(defn isLowerCase [c] (.islower (text c)))
(defn toUpperCase [c] (.upper (text c)))
(defn toLowerCase [c] (.lower (text c)))
(defn toChars [cp] [(python/chr cp)])
(defn getNumericValue [c] (python/int (text c) 36))
