(ns kotoba-lpy-host.double
  "What `java.lang.Double` answers, under the same names."
  (:import math sys))

(def MAX_VALUE (.- sys/float-info max))
(def MIN_VALUE 4.9e-324)
(def POSITIVE_INFINITY (python/float "inf"))
(def NEGATIVE_INFINITY (python/float "-inf"))
(def NaN (python/float "nan"))

(defn parseDouble [s] (python/float s))
(defn valueOf [x] (python/float x))
(defn isNaN [x] (math/isnan x))
(defn isInfinite [x] (math/isinf x))
(defn isFinite [x] (math/isfinite x))
(defn toString [x] (python/str x))
