(ns kotoba-lpy-host.core
  "Clojure core vars that Basilisp 0.5.1 lacks. `sorted-map` and `sorted-set` refuse at the call:
  a plain map would lose their order without saying so.")

(def ^:private word 0xFFFFFFFFFFFFFFFF)

(defn unsigned-bit-shift-right
  "As on the JVM: the operand is a 64-bit word and the shift distance is taken modulo 64."
  [x n]
  (let [shifted (bit-shift-right (bit-and x word) (mod n 64))]
    (if (> shifted 0x7FFFFFFFFFFFFFFF) (- shifted 0x10000000000000000) shifted)))

(defn byte-array
  ([size-or-seq]
   (if (number? size-or-seq)
     (python/bytearray size-or-seq)
     (python/bytearray (python/list (map #(bit-and % 0xFF) size-or-seq)))))
  ([size init]
   (let [out (python/bytearray size)]
     (doseq [[i v] (map-indexed vector (take size init))]
       (.__setitem__ out i (bit-and v 0xFF)))
     out)))

(defn aset-byte [array index value]
  (.__setitem__ array index (bit-and value 0xFF))
  value)

(defn char-array [size-or-seq]
  (if (number? size-or-seq)
    (python/list (repeat size-or-seq "\u0000"))
    (python/list size-or-seq)))

(defn num [x] (if (number? x) x (throw (python/TypeError (str "not a number: " x)))))

(defn array-map [& kvs] (apply hash-map kvs))

(defn bound? [& vars] (every? #(not (nil? (.-root %))) vars))

(defn sorted-map [& _]
  (throw (python/NotImplementedError "sorted-map is not implemented on Basilisp")))

(defn sorted-set [& _]
  (throw (python/NotImplementedError "sorted-set is not implemented on Basilisp")))
