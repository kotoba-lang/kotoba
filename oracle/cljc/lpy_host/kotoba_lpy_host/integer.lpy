(ns kotoba-lpy-host.integer
  "What `java.lang.Integer` answers, under the same names.")

(def MAX_VALUE 2147483647)
(def MIN_VALUE -2147483648)

(defn parseInt
  ([s] (python/int s))
  ([s radix] (python/int s radix)))
(defn valueOf [x] (python/int x))
(defn toString
  ([x] (python/str x))
  ([x radix] (case radix
               2 (python/format x "b")
               8 (python/format x "o")
               16 (python/format x "x")
               (python/str x))))
(defn toHexString [x] (python/format (bit-and x 0xFFFFFFFF) "x"))
(defn toBinaryString [x] (python/format (bit-and x 0xFFFFFFFF) "b"))
