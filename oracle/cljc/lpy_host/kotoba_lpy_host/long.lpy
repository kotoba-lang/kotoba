(ns kotoba-lpy-host.long
  "What `java.lang.Long` and `java.lang.Integer` answer, under the same names."
  (:import builtins))

(def MAX_VALUE 9223372036854775807)
(def MIN_VALUE -9223372036854775808)

(defn parseLong
  ([s] (python/int s))
  ([s radix] (python/int s radix)))
(defn valueOf [x] (python/int x))
(defn toString
  ([x] (python/str x))
  ([x radix] (case radix
               2 (python/format x "b")
               8 (python/format x "o")
               16 (python/format x "x")
               (python/str x))))
(defn toHexString [x] (python/format (bit-and x 0xFFFFFFFFFFFFFFFF) "x"))
(defn toOctalString [x] (python/format (bit-and x 0xFFFFFFFFFFFFFFFF) "o"))
(defn toBinaryString [x] (python/format (bit-and x 0xFFFFFFFFFFFFFFFF) "b"))
(defn hashCode [x] (python/hash x))
