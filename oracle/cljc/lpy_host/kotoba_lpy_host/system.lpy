(ns kotoba-lpy-host.system
  "What `java.lang.System` answers, under the same names."
  (:import os time))

(defn currentTimeMillis [] (python/int (* 1000 (time/time))))
(defn nanoTime [] (time/monotonic-ns))
(defn getenv
  ([] (python/dict os/environ))
  ([k] (.get os/environ k)))
(defn lineSeparator [] "\n")
