(ns kotoba.package-install-test
  (:refer-clojure :exclude [run!])
  (:require #?(:cljs [kotoba.lang.error :as kerror]) [kotoba.bytes :as kbytes] [kotoba.io :as kio] [clojure.edn :as edn]
            [kotoba.test :refer [deftest is testing]]
            [kotoba.codebase-publish :as publish]
            [kotoba.codebase.publication :as publication]
            [kotoba.codebase.store :as store]
            [kotoba.codebase-typed :as typed]
            [kotoba.codebase-routing :as routing]
            [kotoba.endpoint-config :as endpoint-config]
            [kotoba.lang.text :as str]
            [kotoba.library-release :as release]
            [kotoba.package-install :as packages]
            [kotoba.package-pqc :as package-pqc]
            [multiformats.core :as mf]))

(def source
  "(ns reference.math (:export [answer]))
   (defn answer [] :i64 42)")

(defn- temp-dir [prefix]
  (kio/temp-dir
            prefix))

(defn- delete-tree [root]
  (doseq [f (reverse (file-seq root))] (.delete ^java.io.File f)))

(defn- seed [n]
  (byte-array (map unchecked-byte (repeat 32 n))))

(defn- registry [release-cid publication-record-cid publisher pq-attestation endpoints]
  {:kotoba.registry/version 1
   :records
   [{:registry/name "kotoba-lang/reference-math"
     :registry/version "0.1.0"
     :registry/kind :library
     :registry/repo-rid release-cid
     :registry/commit "0123456789abcdef0123456789abcdef01234567"
     :registry/tree-cid release-cid
     :registry/manifest-cid release-cid
     :registry/signers [publisher]
     :registry/capabilities []
     :registry/release-cid release-cid
     :registry/publication-record-cid publication-record-cid
     :registry/pqc-attestation-cid (package-pqc/record-cid pq-attestation)
     :registry/pqc-suite package-pqc/suite
     :registry/pqc-key-id (get pq-attestation "ml-dsa-key-id")
     :registry/default-entry "answer"
     :registry/providers
     (mapv (fn [[id endpoint]]
             {:provider/id id :provider/endpoint endpoint})
           [["kotoba-lang.org" (first endpoints)]
            ["kotoba.cloud" (second endpoints)]])
     :registry/availability-status :replicated-unqualified}]})

(deftest add-locks-two-origin-release-and-run-executes-local-cid
  (let [author (temp-dir "kotoba-package-author-")
        east (temp-dir "kotoba-package-east-")
        west (temp-dir "kotoba-package-west-")
        install-root (temp-dir "kotoba-package-install-")
        lock-file (java.io.File. install-root "kotoba.lock.edn")
        token "test-only-package-token"]
    (try
      (doseq [root [author east west install-root]] (store/initialize! root))
      (typed/update-namespace! author "reference.math" source)
      (let [{:keys [release-cid]} (release/build! author "reference.math")
            record (publication/publish! author "reference.math" (seed 7)
                                         {:release-cid release-cid})
            pq-attestation (package-pqc/sign
                            {:ed25519-seed (seed 7)
                             :ml-dsa-seed (seed 8)
                             :release-cid release-cid
                             :publication-record-cid (:record-cid record)})
            pq-attestation-cid (package-pqc/record-cid pq-attestation)
            _ (store/put-block! author pq-attestation-cid pq-attestation)
            _ (doseq [provider-root [east west]]
                (store/put-block! provider-root pq-attestation-cid pq-attestation))
            east-server (publish/serve! east {:write-token token})
            west-server (publish/serve! west {:write-token token})]
        (try
          (let [endpoints [(:url east-server) (:url west-server)]
                _ (publish/push-blocks-multi!
                   author record
                   (mapv (fn [endpoint]
                           {:endpoint endpoint :write-token token})
                         endpoints))
                catalog-bytes (kbytes/utf8-bytes
                               (pr-str (registry release-cid (:record-cid record)
                                                 (:publisher record) pq-attestation endpoints)))
                catalog-cid (mf/cidv1-raw catalog-bytes)
                installed
                (with-redefs [packages/http-get-bytes (fn [_ _] catalog-bytes)]
                  (packages/install!
                   {:coordinate "kotoba-lang/reference-math@0.1.0"
                    :catalog-cid catalog-cid
                    :lock-path (.getPath lock-file)
                    :root (.getPath install-root)}))
                executed (packages/run!
                          {:package "kotoba-lang/reference-math"
                           :lock-path (.getPath lock-file)
                           :root (.getPath install-root)})]
            (is (:installed? installed))
            (is (= release-cid (:release-cid installed)))
            (is (= catalog-cid (:catalog-cid installed)))
            (is (= :replicated-unqualified (:availability-status installed)))
            (is (true? (get-in installed [:pqc :verified?])))
            (is (= package-pqc/suite (get-in installed [:pqc :suite])))
            (is (= 2 (count (get-in installed [:replication :storage-providers]))))
            (is (= 42 (get-in executed [:execution :value])))
            (testing "a classical-only or stripped lock cannot be executed"
              (let [lock (edn/read-string (slurp lock-file))
                    stripped (update lock :deps
                                     (fn [deps]
                                       (mapv #(dissoc % :dep/pqc-attestation-cid
                                                        :dep/pqc-key-id :dep/pqc-suite)
                                             deps)))]
                (spit lock-file (pr-str stripped))
                (is (= :package/pqc-lock-required
                       (:problem
                        (ex-data
                         (try
                           (packages/verify-lock-pqc-path!
                            (.getPath install-root) (.getPath lock-file))
                           (catch #?(:clj clojure.lang.ExceptionInfo :cljs kerror/ExceptionInfo) e e))))))
                (is (= :package/pqc-lock-required
                       (:problem
                        (ex-data
                         (try
                           (packages/run! {:package "kotoba-lang/reference-math"
                                           :lock-path (.getPath lock-file)
                                           :root (.getPath install-root)})
                           (catch #?(:clj clojure.lang.ExceptionInfo :cljs kerror/ExceptionInfo) e e)))))))))
          (finally ((:stop east-server)) ((:stop west-server)))))
      (finally
        (doseq [root [author east west install-root]] (delete-tree root))))))

(deftest catalog-cid-and-provider-count-fail-closed
  (let [release-cid (mf/cidv1-raw (kbytes/utf8-bytes "release"))
        dummy-attestation (package-pqc/sign
                           {:ed25519-seed (seed 1) :ml-dsa-seed (seed 2)
                            :release-cid release-cid
                            :publication-record-cid release-cid})
        one-provider (update-in (registry release-cid release-cid
                                          "did:key:zReferencePackageSigner" dummy-attestation
                                          ["https://one.example"
                                           "https://two.example"])
                                [:records 0 :registry/providers]
                                pop)
        bytes (kbytes/utf8-bytes (pr-str one-provider))]
    (testing "the catalog itself may be pinned"
      (is (= :package/catalog-cid-mismatch
             (:problem
              (ex-data
               (try
                 (with-redefs [packages/http-get-bytes (fn [_ _] bytes)]
                   (packages/catalog {:expected-cid release-cid}))
                 (catch #?(:clj clojure.lang.ExceptionInfo :cljs kerror/ExceptionInfo) e e)))))))
    (testing "one storage origin cannot satisfy package installation"
      (is (= :package/release-contract-incomplete
             (:problem
              (ex-data
               (try
                 (with-redefs [packages/http-get-bytes (fn [_ _] bytes)]
                   (packages/install!
                    {:coordinate "kotoba-lang/reference-math@0.1.0"
                     :catalog-cid (mf/cidv1-raw bytes)}))
                 (catch #?(:clj clojure.lang.ExceptionInfo :cljs kerror/ExceptionInfo) e e)))))))))

(deftest unpinned-catalog-is-never-an-install-authority
  (is (= :package/catalog-cid-required
         (:problem
          (ex-data
           (try (packages/install! {:coordinate "kotoba-lang/reference-math@0.1.0"})
                (catch #?(:clj clojure.lang.ExceptionInfo :cljs kerror/ExceptionInfo) e e)))))))

(deftest pqc-attestation-rejects-downgrade-and-tampering
  (let [release-cid (mf/cidv1-raw (kbytes/utf8-bytes "release"))
        publication-cid (mf/cidv1-raw (kbytes/utf8-bytes "publication"))
        attestation (package-pqc/sign
                     {:ed25519-seed (seed 3) :ml-dsa-seed (seed 4)
                      :release-cid release-cid
                      :publication-record-cid publication-cid})]
    (is (= package-pqc/suite (:suite (package-pqc/verify attestation))))
    (testing "removing the PQ half is a hard failure"
      (is (= :package/pqc-attestation-incomplete
             (:problem (ex-data
                        (try (package-pqc/verify (dissoc attestation "ml-dsa-signature"))
                             (catch #?(:clj clojure.lang.ExceptionInfo :cljs kerror/ExceptionInfo) e e)))))))
    (testing "a signature from a different ML-DSA key cannot be substituted"
      (let [other (package-pqc/sign
                   {:ed25519-seed (seed 3) :ml-dsa-seed (seed 5)
                    :release-cid release-cid
                    :publication-record-cid publication-cid})]
        (is (= :package/pqc-ml-dsa-signature-invalid
               (:problem
                (ex-data
                 (try
                   (package-pqc/verify
                    (assoc attestation "ml-dsa-signature"
                           (get other "ml-dsa-signature")))
                   (catch #?(:clj clojure.lang.ExceptionInfo :cljs kerror/ExceptionInfo) e e))))))))))

(deftest duplicate-provider-cannot-pretend-to-be-two-origins
  (let [release-cid (mf/cidv1-raw (kbytes/utf8-bytes "release"))
        attestation (package-pqc/sign
                     {:ed25519-seed (seed 1) :ml-dsa-seed (seed 2)
                      :release-cid release-cid
                      :publication-record-cid release-cid})
        catalog (registry release-cid release-cid
                          "did:key:zDuplicate" attestation
                          ["https://same.example" "https://same.example/"])
        bytes (kbytes/utf8-bytes (pr-str catalog))]
    (is (= :package/providers-not-distinct
           (:problem
            (ex-data
             (try
               (with-redefs [packages/http-get-bytes (fn [_ _] bytes)]
                 (packages/install!
                  {:coordinate "kotoba-lang/reference-math@0.1.0"
                   :catalog-cid (mf/cidv1-raw bytes)}))
               (catch #?(:clj clojure.lang.ExceptionInfo :cljs kerror/ExceptionInfo) e e))))))))


;; ---------------------------------------------------------------------------
;; Catalog mirrors (docs/ADR-configurable-endpoints.md): any source serving the
;; pinned bytes is acceptable, and no source serving other bytes ever is.

(defn- problem-of [f]
  (try (f) nil
       (catch #?(:clj clojure.lang.ExceptionInfo :cljs kerror/ExceptionInfo) e (ex-data e))))

(defn- minimal-catalog []
  (let [release-cid (mf/cidv1-raw (kbytes/utf8-bytes "release"))
        attestation (package-pqc/sign
                     {:ed25519-seed (seed 1) :ml-dsa-seed (seed 2)
                      :release-cid release-cid
                      :publication-record-cid release-cid})]
    (kbytes/utf8-bytes
     (pr-str (registry release-cid release-cid "did:key:zMirror" attestation
                       ["https://one.example" "https://two.example"])))))

(deftest catalog-urls-are-an-ordered-configurable-list
  (binding [endpoint-config/*getenv* (fn [_] nil)]
    (is (= [packages/default-catalog-url] (packages/configured-catalog-urls)))
    (is (= [] (packages/configured-catalog-gateways))
        "review 5: gateway fallback for the catalog is opt-in"))
  (binding [endpoint-config/*getenv*
            {"KOTOBA_CATALOG_URLS" "https://mirror-a.example/c.edn,https://mirror-b.example/c.edn"
             "KOTOBA_CATALOG_GATEWAYS" "https://gw.example"}]
    (is (= ["https://mirror-a.example/c.edn" "https://mirror-b.example/c.edn"]
           (packages/configured-catalog-urls)))
    (is (= ["https://cli.example/c.edn"]
           (packages/configured-catalog-urls ["https://cli.example/c.edn"])))
    (is (= ["https://gw.example"] (packages/configured-catalog-gateways)))))

(deftest a-pinned-catalog-may-come-from-any-mirror-serving-its-bytes
  (let [good (minimal-catalog)
        good-cid (mf/cidv1-raw good)
        evil (kbytes/utf8-bytes (pr-str {:kotoba.registry/version 1 :records []}))
        served {"https://evil.example/c.edn" evil
                "https://good.example/c.edn" good}
        fetched (atom [])]
    (with-redefs [packages/http-get-bytes
                  (fn [url _]
                    (swap! fetched conj url)
                    (or (get served url)
                        (throw (ex-info "catalog-http-status"
                                        {:problem :package/catalog-http-status :status 503}))))]
      (testing "a mirror with other bytes is skipped, the next matching one is used"
        (let [result (packages/catalog {:urls ["https://down.example/c.edn"
                                               "https://evil.example/c.edn"
                                               "https://good.example/c.edn"]
                                        :expected-cid good-cid})]
          (is (= good-cid (:cid result)))
          (is (= "https://good.example/c.edn" (:url result)))
          (is (= ["https://down.example/c.edn" "https://evil.example/c.edn"
                  "https://good.example/c.edn"]
                 @fetched))))
      (testing "when no mirror matches the pin, the mismatch is reported"
        (let [data (problem-of #(packages/catalog {:urls ["https://down.example/c.edn"
                                                          "https://evil.example/c.edn"]
                                                   :expected-cid good-cid}))]
          (is (= :package/catalog-cid-mismatch (:problem data)))
          (is (= good-cid (:expected data)))
          (is (= 2 (count (:attempts data))))))
      (testing "several unreachable mirrors are reported together"
        (is (= :package/catalog-unavailable
               (:problem (problem-of #(packages/catalog
                                       {:urls ["https://down.example/a" "https://down.example/b"]
                                        :expected-cid good-cid}))))))
      (testing "one unreachable source keeps its own historical error"
        (is (= :package/catalog-http-status
               (:problem (problem-of #(packages/catalog
                                       {:url "https://down.example/a"
                                        :expected-cid good-cid})))))))))

(deftest a-pinned-catalog-falls-back-to-trustless-gateways-by-cid
  (let [good (minimal-catalog)
        good-cid (mf/cidv1-raw good)
        asked (atom [])]
    (with-redefs [packages/http-get-bytes
                  (fn [_ _] (throw (ex-info "down" {:problem :package/catalog-http-status})))
                  routing/fetch-block-from
                  (fn [gateway cid & _]
                    (swap! asked conj [gateway cid])
                    (case gateway
                      "https://wrong-gw.example" (kbytes/utf8-bytes "not the catalog")
                      "https://good-gw.example" good
                      nil))]
      (testing "gateways are asked for the pinned CID after every URL failed"
        (let [result (packages/catalog {:urls ["https://down.example/c.edn"]
                                        :gateways ["https://empty-gw.example"
                                                   "https://wrong-gw.example"
                                                   "https://good-gw.example"]
                                        :expected-cid good-cid})]
          (is (= good-cid (:cid result)))
          (is (= "https://good-gw.example" (:gateway result)))
          (is (= [["https://empty-gw.example" good-cid]
                  ["https://wrong-gw.example" good-cid]
                  ["https://good-gw.example" good-cid]]
                 @asked))))
      (testing "without a pin there is no name to ask a gateway for"
        (reset! asked [])
        (is (= :package/catalog-http-status
               (:problem (problem-of #(packages/catalog
                                       {:urls ["https://down.example/c.edn"]
                                        :gateways ["https://good-gw.example"]})))))
        (is (empty? @asked))))
    (testing "the catalog size cap also binds the gateway path"
      (let [huge (byte-array (inc packages/max-catalog-bytes))]
        (with-redefs [packages/http-get-bytes
                      (fn [_ _] (throw (ex-info "down" {:problem :package/catalog-http-status})))
                      routing/fetch-block-from (fn [& _] huge)]
          (is (= :package/catalog-unavailable
                 (:problem (problem-of #(packages/catalog
                                         {:urls ["https://down.example/c.edn"]
                                          :gateways ["https://huge-gw.example"]
                                          :expected-cid (mf/cidv1-raw huge)}))))))))))

(deftest install-accepts-an-ordered-catalog-mirror-list
  ;; One provider only, so install stops right after the catalog is accepted
  ;; (`:release-contract-incomplete`) and never reaches network hydration.
  (let [release-cid (mf/cidv1-raw (kbytes/utf8-bytes "release"))
        attestation (package-pqc/sign
                     {:ed25519-seed (seed 1) :ml-dsa-seed (seed 2)
                      :release-cid release-cid
                      :publication-record-cid release-cid})
        bytes (kbytes/utf8-bytes
               (pr-str (update-in (registry release-cid release-cid "did:key:zMirror"
                                            attestation
                                            ["https://one.example" "https://two.example"])
                                  [:records 0 :registry/providers] pop)))
        seen (atom [])]
    (is (= :package/release-contract-incomplete
           (:problem
            (problem-of
             #(with-redefs [packages/http-get-bytes
                            (fn [url _]
                              (swap! seen conj url)
                              (if (= url "https://second.example/c.edn")
                                bytes
                                (throw (ex-info "down" {:problem :package/catalog-http-status}))))]
                (packages/install!
                 {:coordinate "kotoba-lang/reference-math@0.1.0"
                  :catalog-urls ["https://first.example/c.edn" "https://second.example/c.edn"]
                  :catalog-cid (mf/cidv1-raw bytes)}))))))
    (is (= ["https://first.example/c.edn" "https://second.example/c.edn"] @seen))))


;; Review findings 5 and 10 (PR #632).

(deftest review-5-catalog-gateway-fallback-is-opt-in
  (binding [endpoint-config/*getenv* (fn [_] nil)]
    (is (= [] (packages/configured-catalog-gateways)))
    (is (= ["https://gw.example"] (packages/configured-catalog-gateways ["https://gw.example"]))))
  (binding [endpoint-config/*getenv* {"KOTOBA_GATEWAYS" "https://g.example"}]
    (is (= [] (packages/configured-catalog-gateways))
        "KOTOBA_GATEWAYS does not leak the pinned catalog CID to gateways"))
  (testing "with defaults, one unreachable catalog URL still rethrows its own error"
    (binding [endpoint-config/*getenv* (fn [_] nil)]
      (with-redefs [packages/http-get-bytes
                    (fn [_ _] (throw (ex-info "status" {:problem :package/catalog-http-status
                                                       :status 503})))
                    routing/fetch-block-from (fn [& _] (throw (ex-info "must not be asked" {})))]
        (let [data (problem-of #(packages/catalog
                                 {:urls (packages/configured-catalog-urls)
                                  :gateways (packages/configured-catalog-gateways)
                                  :expected-cid "bafkreiexample"}))]
          (is (= :package/catalog-http-status (:problem data)))
          (is (= 503 (:status data))))))))

(deftest review-5-aggregated-catalog-errors-keep-each-attempts-detail
  (with-redefs [packages/http-get-bytes
                (fn [url _]
                  (throw (ex-info (str "status for " url)
                                  {:problem :package/catalog-http-status
                                   :status (if (str/includes? url "/a") 503 404)})))]
    (let [data (problem-of #(packages/catalog {:urls ["https://down.example/a"
                                                      "https://down.example/b"]}))]
      (is (= :package/catalog-unavailable (:problem data)))
      (is (= [503 404] (mapv :status (:attempts data))))
      (is (every? string? (map :message (:attempts data))))
      (is (every? #(= :package/catalog-http-status (:problem %)) (:attempts data))))))

(deftest review-10-the-gateway-catalog-read-stops-at-1-mib
  (let [big (byte-array (* 2 1024 1024))
        asked (atom nil)]
    (with-redefs [packages/http-get-bytes
                  (fn [_ _] (throw (ex-info "down" {:problem :package/catalog-http-status})))
                  routing/fetch-block-from
                  (fn [_ _ opts] (reset! asked opts) big)]
      (problem-of #(packages/catalog {:urls ["https://down.example/c.edn"]
                                      :gateways ["https://gw.example"]
                                      :expected-cid (mf/cidv1-raw big)}))
      (is (= packages/max-catalog-bytes (:max-bytes @asked))
          "the 1 MiB cap is passed into the gateway read, not checked after 4 MiB"))))
