(ns kotoba.principal-identity-test
  (:require [kotoba.io :as kio] [clojure.edn :as edn]
            [kotoba.test :refer [deftest is testing]]
            [kotoba.endpoint-config :as endpoint-config]
            [kotoba.principal-identity :as principal]))

(def verified
  {:valid true
   :principalId "urn:kotoba:principal:test"
   :accountDid "did:web:kotoba.cloud:tenant:u_test"
   :activeDid "did:key:z6Mktest"
   :handle "kotoba-test000000"})

(deftest optional-runtime-hooks-default-to-the-production-path
  ;; A declaration without an init value leaves a Clojure Var unbound.  The
  ;; public CLI dereferences these hooks before falling back to the production
  ;; implementation, so their defaults must be the ordinary nil value.
  (is (nil? principal/*principal-path*))
  (is (nil? principal/*browser-open!*))
  (is (nil? principal/*device-authorize!*)))

(deftest device-polling-honors-server-backoff-with-a-bounded-fallback
  (is (= 2 (principal/device-retry-delay-seconds 428 2 nil)))
  (is (= 7 (principal/device-retry-delay-seconds 429 2 nil)))
  (is (= 45 (principal/device-retry-delay-seconds 429 2 45)))
  (is (= 300 (principal/device-retry-delay-seconds 429 2 3600)))
  (is (nil? (principal/device-retry-delay-seconds 410 2 nil))))

(deftest principal-path-follows-xdg-then-home
  (is (= "/xdg/kotoba/principal.edn" (principal/principal-path* "/xdg" "/home/jun")))
  (is (= "/home/jun/.local/share/kotoba/principal.edn"
         (principal/principal-path* nil "/home/jun"))))

(deftest verified-public-projection-is-the-only-persisted-shape
  (let [directory (kio/temp-dir
                   "kotoba-principal")
        path (.toString (kio/file directory "principal.edn"))]
    (principal/write-principal! path (assoc verified :cookie "must-not-land" :privateKey "no"))
    (let [record (edn/read-string (slurp path))]
      (is (= (:principalId verified) (:kotoba.principal/id record)))
      (is (= "kotoba-test000000" (:kotoba.principal/username record)))
      (is (= principal/canonical-rp-id (:kotoba.principal/rp-id record)))
      (is (nil? (:cookie record)))
      (is (nil? (:privateKey record))))))

(deftest malformed-or-partial-projections-fail-closed
  (is (principal/public-identity? verified))
  (is (not (principal/public-identity? (dissoc verified :activeDid))))
  (is (not (principal/public-identity? (assoc verified :principalId "wallet:0x123"))))
  (is (not (principal/public-identity? (assoc verified :handle "bad\nname")))))

(deftest id-show-reads-the-enrolled-stable-principal
  (let [directory (kio/temp-dir
                   "kotoba-principal-show")
        path (.toString (kio/file directory "principal.edn"))]
    (binding [principal/*principal-path* path]
      (is (= :id/not-enrolled (:kotoba.cli/code (principal/show-result))))
      (principal/write-principal! path verified)
      (let [shown (principal/show-result)]
        (is (= :id/shown (:kotoba.cli/code shown)))
        (is (= (:principalId verified) (get-in shown [:kotoba.cli/data :principal])))
        (is (= "kotoba-test000000" (get-in shown [:kotoba.cli/data :username])))))))


;; docs/ADR-configurable-endpoints.md: the RP is an allow-list whose default is
;; exactly the historical canonical RP.

(defn- authority-result [rp-id]
  {:kotoba.cli/ok? true
   :kotoba.cli/data {:host-action :secure-random-principal-id
                     :controller {:kind :passkey :rp-id rp-id}}})

(deftest the-rp-allow-list-defaults-to-the-canonical-rp
  (binding [endpoint-config/*getenv* (fn [_] nil)]
    (is (= ["auth.kotoba.cloud"] (principal/allowed-rp-ids)))
    (is (= "auth.kotoba.cloud" (principal/default-rp-id)))
    (is (principal/allowed-rp-id? "auth.kotoba.cloud"))
    (is (not (principal/allowed-rp-id? "itonami.cloud")))))

(deftest rp-ids-must-be-bare-hostnames
  (is (principal/valid-rp-id? "auth.example.org"))
  (doseq [bad ["https://auth.example.org" "auth.example.org:443" "auth.example.org/x"
               "Auth.Example.org" "localhost" "" nil "auth..example.org" "-a.example.org"]]
    (is (not (principal/valid-rp-id? bad)) (pr-str bad)))
  (testing "invalid configured entries are never allowed; none valid => canonical"
    (binding [endpoint-config/*getenv* {"KOTOBA_PASSKEY_RP_IDS" "https://evil.example,evil.example:8443"}]
      (is (= ["auth.kotoba.cloud"] (principal/allowed-rp-ids))))
    (binding [endpoint-config/*getenv* {"KOTOBA_PASSKEY_RP_IDS" "https://evil.example, id.self.example"}]
      (is (= ["id.self.example"] (principal/allowed-rp-ids))))))

(deftest an-unlisted-rp-is-refused-before-any-browser-opens
  (doseq [env [(fn [_] nil) {"KOTOBA_PASSKEY_RP_IDS" "id.self.example"}]]
    (binding [endpoint-config/*getenv* env
              principal/*device-authorize!* (fn [] (throw (ex-info "must not run" {})))]
      (let [result (principal/enroll-result (authority-result "itonami.cloud"))]
        (is (= :id/noncanonical-rp (:kotoba.cli/code result)))
        (is (= "itonami.cloud" (get-in result [:kotoba.cli/data :requested-rp-id])))))))

(deftest a-configured-rp-enrolls-and-is-recorded
  (let [directory (kio/temp-dir "kotoba-principal-rp")
        path (.toString (kio/file directory "principal.edn"))]
    (binding [endpoint-config/*getenv* {"KOTOBA_PASSKEY_RP_IDS" "id.self.example,auth.kotoba.cloud"}
              principal/*principal-path* path
              principal/*device-authorize!* (fn [] verified)]
      (is (= "id.self.example" (principal/default-rp-id)))
      (let [result (principal/enroll-result (authority-result "id.self.example"))]
        (is (= :id/enrolled (:kotoba.cli/code result)))
        (is (= "id.self.example" (get-in result [:kotoba.cli/data :controller :rp-id])))
        (is (= "id.self.example" (:kotoba.principal/rp-id (edn/read-string (slurp path))))))
      (testing "the canonical RP stays usable when it is still listed"
        (is (= :id/enrolled
               (:kotoba.cli/code (principal/enroll-result (authority-result "auth.kotoba.cloud")))))))))

(deftest the-device-flow-refuses-an-unlisted-rp-without-network
  (binding [endpoint-config/*getenv* (fn [_] nil)]
    (is (= :noncanonical-rp
           (:error (ex-data (try (principal/device-authorize! "evil.example")
                                 (catch Exception e e))))))))
