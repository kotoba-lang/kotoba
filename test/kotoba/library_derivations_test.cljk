(ns kotoba.library-derivations-test
  (:require [kotoba.test :refer [deftest is]]
            [kotoba.lang.json :as json]
            [clojure.walk :as walk]
            #?(:cljs [edamame.core :as edamame])
            #?(:cljs ["node:fs" :as fs])))

(defn- text [file]
  #?(:clj (slurp file) :cljs (fs/readFileSync file "utf8")))

(defn- forms [source]
  #?(:cljs (edamame/parse-string-all source {:all true :read-cond :allow :features #{:cljs}})
     :clj (binding [*read-eval* false]
            (let [reader (java.io.PushbackReader. (java.io.StringReader. source))
                  eof (Object.)]
              (loop [out []]
                (let [form (read {:eof eof :read-cond :allow :features #{:clj}} reader)]
                  (if (identical? form eof) out (recur (conj out form)))))))))

(defn- normalize [[op name & body]]
  (let [body (if (string? (first body)) (rest body) body)]
    ;; JVM's reader expands #() with fresh binding names on each read. Compare
    ;; lexical bindings modulo alpha-renaming, while retaining their uses.
    (walk/postwalk
      (fn [form]
        (if (and (seq? form) (= 'fn* (first form))
                 (vector? (second form)) (every? symbol? (second form)))
          (let [bindings (zipmap (second form)
                                (map #(symbol (str "derived-arg-" %)) (range (count (second form)))))]
            (list* 'fn* (mapv bindings (second form))
                   (map #(walk/postwalk-replace bindings %) (drop 2 form))))
          form))
      (list* (if (= op 'defn-) 'defn op) name body))))

(deftest compatibility-definitions-retain-the-licensed-owner-implementation
  (let [root "lib/kotoba.lsp/"
        data (walk/keywordize-keys (json/decode (text (str root "derivations.json")) ))
        definitions (into {} (keep (fn [f] (when (and (seq? f) (#{'def 'defn 'defn-} (first f)))
                                             [(second f) f])))
                          (forms (text (str root "src/kotoba/lang/lsp.cljk"))))
        bindings {"text-document" '(:require [kotoba.lang.text :as str])
                  "diagnostic" '(:require [kotoba.lsp.severities :refer [severities]])
                  "diagnostics-by-severity" '(:require [kotoba.lsp.severity-rank :refer [severity-rank]])
                  "within-range?" '(:require [kotoba.lsp.pos-gte :refer [pos>=]]
                                             [kotoba.lsp.pos-lt :refer [pos<]])}]
    (is (= 12 (count (:derivations data))))
    (doseq [row (:derivations data)]
      (let [[ns-form definition :as output] (forms (text (str root (:path row))))
            original (get definitions (symbol (:definition row)))]
        (is (= 2 (count output)) "no unreviewed top-level executable forms")
        (is (= 'ns (first ns-form)))
        (is (= (symbol (:namespace row)) (second ns-form)))
        (is (= (drop 3 ns-form) (if-let [clause (get bindings (:definition row))] [clause] [])))
        (is (some? original))
        (is (= (normalize original) (normalize definition)) (:path row))
        (is (false? (get-in row [:reviewed-compatibility :source-imported])))))))
