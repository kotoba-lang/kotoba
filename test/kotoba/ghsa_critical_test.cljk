(ns kotoba.ghsa-critical-test
  "Regression tests for GHSA Critical batch (KOTOBA-941).
  Portable slice: pure plan/parse + safe EDN via injected ports."
  (:require #?(:clj [kotoba.test :refer [deftest is testing]]
               :cljs [cljs.test :refer [deftest is testing] :include-macros true])
            [kotoba.git-adapter :as git-adapter]
            [kotoba.graph-adapter :as graph-adapter]
            [clojure.edn :as edn]))

(deftest edn-safe-blocks-tagged-literals
  (testing "VULN-003: #inst/#uuid/custom tags do not construct objects"
    (is (nil? (edn/read-string {:readers {'inst (fn [_] nil) 'uuid (fn [_] nil)}
                                :default (fn [_ _] nil)}
                               "#inst \"2026-01-01T00:00:00.000-00:00\"")))
    (is (nil? (edn/read-string {:readers {'inst (fn [_] nil) 'uuid (fn [_] nil)}
                                :default (fn [_ _] nil)}
                               "#uuid \"123e4567-e89b-12d3-a456-426614174000\"")))
    (is (nil? (edn/read-string {:readers {'inst (fn [_] nil) 'uuid (fn [_] nil)}
                                :default (fn [_ _] nil)}
                               "#evil {:a 1}")))
    (is (= {:a 1} (edn/read-string {:readers {'inst (fn [_] nil) 'uuid (fn [_] nil)}
                                    :default (fn [_ _] nil)}
                                   "{:a 1}")))))

(deftest graph-adapter-safe-edn-via-plan
  (testing "VULN-003: graph-adapter parse-edn-value uses safe readers"
    ;; parse-edn-value is private via safe-read; exercise through plan params path indirectly:
    ;; a tagged payload must not produce a java.util.Date.
    (let [v (graph-adapter/parse-edn-value "#inst \"2026-01-01T00:00:00.000-00:00\"")]
      (is (nil? v)))))

(deftest git-adapter-rejects-unsafe-repo
  (testing "VULN-004/005: --repo starting with dash (flag injection) is rejected"
    (is (= :git/unsafe-repo (:error (git-adapter/plan {:positionals ["status"]
                                                       :options {:repo "--upload-pack=touch /tmp/pwn"}}))))
    (is (= :git/unsafe-repo (:error (git-adapter/plan {:positionals ["init"]
                                                       :options {:repo "-oProxyCommand=evil"}}))))))

(deftest git-adapter-rejects-unsafe-ref
  (testing "VULN-004: --ref starting with dash is rejected"
    (is (= :git/unsafe-ref (:error (git-adapter/plan {:positionals ["sync"]
                                                      :options {:ref "--upload-pack=touch"}}))))
    (is (= :git/unsafe-ref (:error (git-adapter/plan {:positionals ["sync"]
                                                      :options {:ref "a b"}}))))))

(deftest git-adapter-allows-normal
  (testing "normal repo/ref still plan"
    (is (:steps (git-adapter/plan {:positionals ["status"] :options {:repo "/tmp/r"}})))
    (is (:steps (git-adapter/plan {:positionals ["sync"] :options {:ref "origin/main"}})))))

(deftest git-adapter-rejects-dotdot-repo
  (testing "VULN-005: --repo with .. segment is rejected"
    (is (= :git/unsafe-repo (:error (git-adapter/plan {:positionals ["status"]
                                                       :options {:repo "../escape"}}))))
    (is (= :git/unsafe-repo (:error (git-adapter/plan {:positionals ["status"]
                                                       :options {:repo "/tmp/../etc"}}))))
    (is (:steps (git-adapter/plan {:positionals ["status"] :options {:repo "src/foo"}})))))

(deftest graph-adapter-rejects-unsafe-path
  (testing "VULN-006: --graph file path with .. / flag-like is rejected"
    (is (= :graph/unsafe-path (:error (graph-adapter/parse-handle "file:../escape.edn"))))
    (is (= :graph/unsafe-path (:error (graph-adapter/parse-handle "../escape.edn"))))
    (is (= :graph/unsafe-path (:error (graph-adapter/parse-handle "--upload-pack=x"))))
    (is (= :file (:scheme (graph-adapter/parse-handle "file:store.edn"))))
    (is (= :file (:scheme (graph-adapter/parse-handle "store.edn"))))))
