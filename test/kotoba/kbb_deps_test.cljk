(ns kotoba.kbb-deps-test
  "bin/kbb_deps.cljk — the tools.deps-shaped door of kbb (ADR-2609112000).
  kbb-cutover: keep (the fixture deps.edn names cognitect.test-runner on purpose).

  Runs `bin/kbb` as a subprocess against a throwaway deps.edn project, so
  every assertion is about an EXIT CODE the caller of `kbb -M:test` would
  see. Both directions are pinned: a green suite exits 0, the same suite
  with one failing deftest exits 1, an undeclared alias exits 64 naming the
  alias, `-Stree` exits 64 naming the flag, no deps.edn exits 66. The
  boundary case is the classpath-only alias (`:extra-paths`, no
  `:main-opts`): it is neither a run nor an unknown alias, and exits 64
  saying so rather than starting an empty engine.

  Needs the engine (kotoba-lang/org-babashka-nbb) next to this checkout or
  KBB_ENGINE set; otherwise every case is reported as SKIPPED, not passed."
  (:require [cljs.test :refer [deftest is testing]]
            [kotoba.lang.text :as str]))

(def fs (js/require "fs"))
(def path (js/require "path"))
(def os (js/require "os"))
(def cp (js/require "child_process"))

(def kbb (.resolve path "bin/kbb"))

(defn- engine-present? []
  (or (some? (.-KBB_ENGINE (.-env js/process)))
      (.existsSync fs (.resolve path "../org-babashka-nbb/cli.js"))))

(defn- run-kbb-env
  "run-kbb with `extra` merged over the inherited environment."
  [extra cwd & args]
  (let [env (js/Object.assign #js {} (.-env js/process) (clj->js extra))
        r (.spawnSync cp kbb (clj->js args) #js {:cwd cwd :encoding "utf8" :env env})]
    {:exit (.-status r) :out (or (.-stdout r) "") :err (or (.-stderr r) "")}))

(defn- run-kbb [cwd & args] (apply run-kbb-env {} cwd args))

(defn- write! [dir rel content]
  (let [f (.join path dir rel)]
    (.mkdirSync fs (.dirname path f) #js {:recursive true})
    (.writeFileSync fs f content)))

(defn- fixture! []
  (let [dir (.mkdtempSync fs (.join path (.tmpdir os) "kbb-deps-"))]
    (write! dir "deps.edn"
            (str "{:paths [\"src\"]\n"
                 " :deps {sib/sib {:local/root \"sib\"}}\n"
                 " :aliases {:test {:extra-paths [\"test\"] :main-opts [\"-m\" \"cognitect.test-runner\"]}\n"
                 "           :run {:main-opts [\"-m\" \"fx.main\"]}\n"
                 "           :cp-only {:extra-paths [\"extra\"]}}}\n"))
    (write! dir "sib/src/sib/core.cljk" "(ns sib.core)\n(defn twice [x] (* 2 x))\n")
    (write! dir "src/fx/main.cljk" "(ns fx.main (:require [sib.core :as s]))\n(defn -main [& args] (println \"main\" (s/twice 21) (vec args)))\n")
    (write! dir "test/fx/core_test.cljk" "(ns fx.core-test (:require [cljs.test :refer [deftest is]] [sib.core :as s]))\n(deftest ok (is (= 42 (s/twice 21))))\n")
    dir))

(deftest kbb-deps-door
  (if-not (engine-present?)
    (println "SKIPPED kotoba.kbb-deps-test: engine not present (set KBB_ENGINE)")
    (let [dir (fixture!)]
      ;; KBB_NO_STDLIB: this case pins the project's own contribution exactly;
      ;; the implicit stdlib (appended last) has its own deftest below.
      (testing "-Spath: root :paths plus :local/root paths, no JVM"
        (let [r (run-kbb-env {"KBB_NO_STDLIB" "1"} dir "-Spath")]
          (is (zero? (:exit r)) (:err r))
          (is (= "src:sib/src" (str/trim (:out r))))))
      (testing "-M:run with trailing args reaches -main through the local/root dep"
        (let [r (run-kbb dir "-M:run" "a" "b")]
          (is (zero? (:exit r)) (:err r))
          (is (str/includes? (:out r) "main 42 [a b]"))))
      (testing "-M:test green -> 0, and the substitution is named on stderr"
        (let [r (run-kbb dir "-M:test")]
          (is (zero? (:exit r)) (str (:out r) (:err r)))
          (is (str/includes? (:err r) "test runner substitution"))))
      (testing "-M:test with one failing deftest -> 1"
        (write! dir "test/fx/bad_test.cljk" "(ns fx.bad-test (:require [cljs.test :refer [deftest is]]))\n(deftest bad (is (= 1 2)))\n")
        (let [r (run-kbb dir "-M:test")]
          (is (= 1 (:exit r)) (str (:out r) (:err r)))
          (is (str/includes? (:out r) "1 fail")))
        (.unlinkSync fs (.join path dir "test/fx/bad_test.cljk")))
      (testing "undeclared alias -> 64, naming it and the declared set"
        (let [r (run-kbb dir "-M:dev:test")]
          (is (= 64 (:exit r)))
          (is (str/includes? (:err r) "[:dev]"))
          (is (str/includes? (:err r) ":cp-only"))))
      (testing "boundary: classpath-only alias is refused as such, not run, not unknown"
        (let [r (run-kbb dir "-M:cp-only")]
          (is (= 64 (:exit r)))
          (is (str/includes? (:err r) "no :main-opts"))))
      (testing "-Stree -> 64 by name (no Maven resolution here)"
        (let [r (run-kbb dir "-Stree")]
          (is (= 64 (:exit r)))
          (is (str/includes? (:err r) "-Stree"))))
      (testing "no deps.edn -> 66"
        (let [empty (.join path dir "empty")]
          (.mkdirSync fs empty)
          (let [r (run-kbb empty "-M:test")]
            (is (= 66 (:exit r)))
            (is (str/includes? (:err r) "no deps.edn")))))
      (testing "-Sdeps aliases merge over the file"
        (let [r (run-kbb dir "-Sdeps" "{:aliases {:zz {:main-opts [\"-e\" \"(println :sdeps-ok)\"]}}}" "-M:zz")]
          (is (zero? (:exit r)) (:err r))
          (is (str/includes? (:out r) ":sdeps-ok"))))
      ;; `#!/usr/bin/env kbb` hands bin/kbb the launcher's path with no
      ;; extension to route on. Until 2026-09-15 that fell through to the
      ;; .kotoba guest shim and answered :kbb/policy-required (measured on
      ;; cloud-itonami-cli bin/itonami and cloud-itonami/misogi bin/misogi).
      ;; The launcher is run from a cwd OUTSIDE its project, so the assertion
      ;; is also that its classpath comes from the deps.edn above the script
      ;; (sib.core is a :local/root of the fixture, not of the cwd).
      (testing "extension-less shebang launcher, run from another cwd -> deps door, script's own project"
        (write! dir "bin/tool" "#!/usr/bin/env kbb\n(ns tool (:require [fx.main :as m]))\n(apply m/-main *command-line-args*)\n")
        (let [elsewhere (.mkdtempSync fs (.join path (.tmpdir os) "kbb-elsewhere-"))
              r (run-kbb elsewhere (.join path dir "bin/tool") "x")]
          (is (zero? (:exit r)) (str (:out r) (:err r)))
          (is (str/includes? (:out r) "main 42 [x]"))
          (is (not (str/includes? (:out r) ":kbb/policy-required")))
          (.rmSync fs elsewhere #js {:recursive true :force true})))
      (testing "org.clojure/clojure in :deps is the engine, not a missing coordinate: no warning"
        (write! dir "deps.edn"
                (str "{:paths [\"src\"]\n"
                     " :deps {sib/sib {:local/root \"sib\"} org.clojure/clojure {:mvn/version \"1.12.0\"} some/lib {:mvn/version \"1\"}}\n"
                     " :aliases {:run {:main-opts [\"-m\" \"fx.main\"]}}}\n"))
        (let [r (run-kbb dir "-M:run")]
          (is (zero? (:exit r)) (:err r))
          (is (not (str/includes? (:err r) "org.clojure/clojure")) (:err r))
          (is (str/includes? (:err r) "some/lib") (:err r))))
      (testing "boundary: a .kotoba file with the same shebang still reaches the guest shim"
        (write! dir "bin/guest.kotoba" "#!/usr/bin/env kbb\n(ns guest)\n")
        (let [r (run-kbb dir (.join path dir "bin/guest.kotoba"))]
          (is (str/includes? (:out r) ":kbb/policy-required") (str (:out r) (:err r)))))
      (testing "boundary: an extension-less file WITHOUT a shebang reaches the guest shim"
        (write! dir "bin/plain" "(ns plain)\n")
        (let [r (run-kbb dir (.join path dir "bin/plain"))]
          (is (str/includes? (:out r) ":kbb/policy-required") (str (:out r) (:err r)))))
      (.rmSync fs dir #js {:recursive true :force true}))))

(defn- sh! [cwd & args]
  (let [r (.spawnSync cp (first args) (clj->js (rest args)) #js {:cwd cwd :encoding "utf8"})]
    (str/trim (or (.-stdout r) ""))))

;; :git/sha coordinates (2026-09-23). Until then this door resolved
;; :local/root only; kotoba-lang/shinkansen's suite was green and went red
;; with `Could not find namespace: kotoba.lang.text` the moment its deps.edn
;; declared the kotoba-lang/text coordinate. The fixture is a local file://
;; repository and GITLIBS points into the temp dir, so nothing here touches
;; the network or the caller's ~/.gitlibs.
(deftest kbb-deps-git-coordinates
  (if-not (engine-present?)
    (println "SKIPPED kotoba.kbb-deps-test/git: engine not present (set KBB_ENGINE)")
    (let [dir (.mkdtempSync fs (.join path (.tmpdir os) "kbb-git-"))
          lib (.join path dir "gitlib")
          gitlibs (.join path dir "gitlibs")
          env {"GITLIBS" gitlibs "KBB_NO_STDLIB" "1"}
          proj (.join path dir "proj")]
      (write! lib "deps.edn" "{:paths [\"src\"]}\n")
      (write! lib "src/gl/core.cljk" "(ns gl.core)\n(defn hello [] :from-git)\n")
      (sh! lib "git" "init" "-q")
      (sh! lib "git" "add" "-A")
      (sh! lib "git" "-c" "user.name=t" "-c" "user.email=t@t" "commit" "-q" "-m" "gl")
      (let [sha (sh! lib "git" "rev-parse" "HEAD")
            deps (fn [s] (str "{:paths [\"src\"] :deps {gl/gl {:git/url \"file://" lib "\" :git/sha \"" s "\"}}"
                              " :aliases {:run {:main-opts [\"-m\" \"fx.main\"]}}}\n"))]
        (write! proj "deps.edn" (deps sha))
        (write! proj "src/fx/main.cljk" "(ns fx.main (:require [gl.core :as g]))\n(defn -main [& _] (println \"got\" (g/hello)))\n")
        (testing "a :git/sha dep is cloned into GITLIBS and its :paths reach the engine"
          (let [r (run-kbb-env env proj "-M:run")]
            (is (zero? (:exit r)) (str (:out r) (:err r)))
            (is (str/includes? (:out r) "got :from-git"))
            (is (.existsSync fs (.join path gitlibs "libs" "gl" "gl" sha "src")))))
        (testing "warm cache: the source repository is gone and the dep still resolves (no git, no network)"
          (.rmSync fs lib #js {:recursive true :force true})
          (.rmSync fs (.join path gitlibs "_repos") #js {:recursive true :force true})
          (let [r (run-kbb-env env proj "-M:run")]
            (is (zero? (:exit r)) (str (:out r) (:err r)))
            (is (str/includes? (:out r) "got :from-git"))))
        (testing "an unresolvable sha is named on stderr with its reason, not silently dropped"
          (write! proj "deps.edn" (deps "0000000000000000000000000000000000000000"))
          (let [r (run-kbb-env env proj "-M:run")]
            (is (= 1 (:exit r)))
            (is (str/includes? (:err r) "gl/gl is NOT on the classpath") (:err r)))))
      (.rmSync fs dir #js {:recursive true :force true}))))

;; The implicit kotoba stdlib (2026-09-23): kotoba.lang.text resolves with no
;; project file at all -- the case of every bare `kbb run_tests.cljk` repo --
;; and KBB_NO_STDLIB=1 turns exactly that off.
(deftest kbb-deps-implicit-stdlib
  (let [stdlib-root (or (.-KBB_STDLIB_ROOT (.-env js/process)) (.resolve path ".."))]
    (if-not (and (engine-present?) (.existsSync fs (.join path stdlib-root "text" "src")))
      (println "SKIPPED kotoba.kbb-deps-test/stdlib: engine or the kotoba-lang/text sibling checkout not present")
      (let [dir (.mkdtempSync fs (.join path (.tmpdir os) "kbb-stdlib-"))]
        (write! dir "probe.cljk" "(ns probe (:require [kotoba.lang.text :as t]))\n(println \"upper\" (t/upper \"a\"))\n")
        (testing "no deps.edn, no nbb.edn: kotoba.lang.text is on the classpath"
          (let [r (run-kbb dir "probe.cljk")]
            (is (zero? (:exit r)) (str (:out r) (:err r)))
            (is (str/includes? (:out r) "upper A"))))
        (testing "KBB_NO_STDLIB=1: the same script cannot find it"
          (let [r (run-kbb-env {"KBB_NO_STDLIB" "1"} dir "probe.cljk")]
            (is (= 1 (:exit r)))
            (is (str/includes? (str (:out r) (:err r)) "Could not find namespace: kotoba.lang.text"))))
        (testing "the stdlib comes AFTER the project's own paths"
          (let [cpv (str/split (str/trim (:out (run-kbb dir "-Spath"))) #":")]
            (is (= "src" (first cpv)))
            (is (some #(str/ends-with? % "text/src") cpv))))
        ;; kotoba-lang/pprint joined the implicit stdlib on 2026-09-24.
        (when (.existsSync fs (.join path stdlib-root "pprint" "src"))
          (testing "kotoba.pprint resolves with no project file"
            (write! dir "pp.cljk" "(ns pp (:require [kotoba.pprint :as p]))\n(print (p/pprint-str {:a 1}))\n")
            (let [r (run-kbb dir "pp.cljk")]
              (is (zero? (:exit r)) (str (:out r) (:err r)))
              (is (str/includes? (:out r) "{:a 1}")))))
        (.rmSync fs dir #js {:recursive true :force true})))))

(deftest kbb-deps-local-root-west-sibling
  ;; A fresh clone outside the workspace: `:local/root "../../acme/lib1"` does
  ;; not exist from where the project sits. kbb answers it from the west
  ;; sibling orgs/acme/lib1 (KBB_STDLIB_ROOT's parent is orgs/), names that on
  ;; stderr, and names a :local/root with no sibling as NOT on the classpath.
  (if-not (engine-present?)
    (println "SKIPPED kotoba.kbb-deps-test/local-root: engine not present (set KBB_ENGINE)")
    (let [tmp (.mkdtempSync fs (.join path (.tmpdir os) "kbb-localroot-"))
          orgs (.join path tmp "ws" "orgs")
          proj (.join path tmp "elsewhere" "proj")
          env {"KBB_STDLIB_ROOT" (.join path orgs "kotoba-lang")}]
      (write! orgs "acme/lib1/src/lib1/core.cljk" "(ns lib1.core)\n(defn hi [] \"hi from sibling\")\n")
      (write! proj "deps.edn" (str "{:deps {io.github.acme/lib1 {:local/root \"../../acme/lib1\"}\n"
                                   "        io.github.old-org/renamed-clj {:local/root \"../../acme/lib2\"}\n"
                                   "        io.github.acme/nolib {:local/root \"../../acme/nolib\"}}}\n"))
      (write! orgs "acme/lib2/src/lib2/core.cljk" "(ns lib2.core)\n(def v 2)\n")
      (write! proj "ok.cljk" "(ns ok (:require [lib1.core :as l]))\n(println (l/hi))\n")
      (write! proj "renamed.cljk" "(ns renamed (:require [lib2.core :as l]))\n(println \"lib2\" l/v)\n")
      (testing "a renamed lib (name implies no sibling) -> the declared ../../<org>/<repo> re-anchored under orgs/"
        (let [r (run-kbb-env env proj "renamed.cljk")]
          (is (zero? (:exit r)) (str (:out r) (:err r)))
          (is (str/includes? (:out r) "lib2 2"))))
      (write! proj "missing.cljk" "(ns missing (:require [nolib.core]))\n")
      (testing "missing :local/root with a west sibling -> resolved from the sibling, named on stderr"
        (let [r (run-kbb-env env proj "ok.cljk")]
          (is (zero? (:exit r)) (str (:out r) (:err r)))
          (is (str/includes? (:out r) "hi from sibling"))
          (is (str/includes? (:err r) "using the west sibling checkout"))))
      (testing "missing :local/root without a sibling -> named as NOT on the classpath, run fails"
        (let [r (run-kbb-env env proj "missing.cljk")]
          (is (= 1 (:exit r)))
          (is (str/includes? (:err r) "io.github.acme/nolib is NOT on the classpath: :local/root \"../../acme/nolib\" does not exist"))
          (is (str/includes? (str (:out r) (:err r)) "Could not find namespace: nolib.core"))))
      (.rmSync fs tmp #js {:recursive true :force true}))))

;; Test namespaces are required by the name their (ns …) form DECLARES
;; (2026-09-24). Until then the runner derived the name from the path, and a
;; file at test/ntp_time/main_test.cljk declaring `ntp_time.main-test` (several
;; com-* repositories) was required as ntp-time.main-test: the engine found the
;; same file by munging, loaded it, and the run died with
;; "No namespace: ntp-time.main-test found".
(deftest kbb-deps-test-ns-from-ns-form
  (if-not (engine-present?)
    (println "SKIPPED kotoba.kbb-deps-test/ns-form: engine not present (set KBB_ENGINE)")
    (let [dir (.mkdtempSync fs (.join path (.tmpdir os) "kbb-nsform-"))
          env {"KBB_NO_STDLIB" "1"}]
      (write! dir "deps.edn" "{:aliases {:test {:extra-paths [\"test\"] :main-opts [\"-m\" \"cognitect.test-runner\"]}}}\n")
      (write! dir "test/ntp_time/main_test.cljk"
              "(ns ntp_time.main-test (:require [cljs.test :refer [deftest is]]))\n(deftest ok (is (= 2 (+ 1 1))))\n")
      (testing "the declared ntp_time.main-test is what is required and run"
        (let [r (run-kbb-env env dir "-M:test")]
          (is (zero? (:exit r)) (str (:out r) (:err r)))
          (is (str/includes? (:out r) "kbb test: 1 test(s), 1 pass, 0 fail, 0 error") (:out r))
          (is (not (str/includes? (str (:out r) (:err r)) "No namespace")))))
      (testing "boundary: a declared name that matches the path runs as before, and a failing one still exits 1"
        (write! dir "test/plain/core_test.cljk"
                "(ns plain.core-test (:require [cljs.test :refer [deftest is]]))\n(deftest bad (is (= 1 2)))\n")
        (let [r (run-kbb-env env dir "-M:test")]
          (is (= 1 (:exit r)) (str (:out r) (:err r)))
          (is (str/includes? (:out r) "2 test(s), 1 pass, 1 fail") (:out r))))
      (testing "a test file with no (ns …) form falls back to the path, and says so"
        (.unlinkSync fs (.join path dir "test/plain/core_test.cljk"))
        (write! dir "test/legacy/old_style_test.cljk" "(println :no-ns-form)\n")
        (let [r (run-kbb-env env dir "-M:test")]
          (is (str/includes? (:err r) "has no readable (ns …) form; requiring it as legacy.old-style-test (derived from its path)") (:err r))))
      (.rmSync fs dir #js {:recursive true :force true}))))

;; The implicit stdlib on the two doors that do not read deps.edn (2026-09-24):
;; `kbb --backend sci [--classpath cp] script` (bin/kbb execs the engine; the
;; stdlib is cached in XDG_CACHE_HOME/kbb/stdlib-classpath) and
;; `kbb --classpath cp script`. Both hand it to the engine as
;; KBB_CLASSPATH_TAIL, after everything the caller names.
(deftest kbb-sci-and-cp-doors-implicit-stdlib
  (let [stdlib-root (or (.-KBB_STDLIB_ROOT (.-env js/process)) (.resolve path ".."))]
    (if-not (and (engine-present?) (.existsSync fs (.join path stdlib-root "text" "src")))
      (println "SKIPPED kotoba.kbb-deps-test/sci-stdlib: engine or the kotoba-lang/text sibling checkout not present")
      (let [dir (.mkdtempSync fs (.join path (.tmpdir os) "kbb-scistd-"))
            cache-home (.join path dir "cache")
            cache (.join path cache-home "kbb" "stdlib-classpath")
            env {"XDG_CACHE_HOME" cache-home "KBB_STDLIB_ROOT" stdlib-root}]
        (write! dir "probe.cljk" "(ns probe (:require [kotoba.lang.text :as t]))\n(println \"upper\" (t/upper \"a\"))\n")
        (write! dir "shadow/kotoba/lang/text.cljk" "(ns kotoba.lang.text)\n(defn upper [_] :shadowed-by-caller)\n")
        (testing "--backend sci: kotoba.lang.text resolves with no classpath named, and the answer is cached"
          (let [r (run-kbb-env env dir "--backend" "sci" "probe.cljk")]
            (is (zero? (:exit r)) (str (:out r) (:err r)))
            (is (str/includes? (:out r) "upper A"))
            (is (.existsSync fs cache))
            (is (= stdlib-root (first (str/split (.readFileSync fs cache "utf8") #"\n"))))))
        (testing "--backend sci, warm: served from the cache (a planted marker entry is what the engine sees)"
          (let [lines (vec (str/split (.readFileSync fs cache "utf8") #"\n"))
                marker (.join path dir "marker")]
            (write! dir "marker/kbb_marker.cljk" "(ns kbb-marker)\n(def v :from-cache)\n")
            (.writeFileSync fs cache (str (str/join "\n" (assoc lines 1 (str (nth lines 1) ":" marker))) "\n\n\n"))
            (let [r (run-kbb-env env dir "--backend" "sci" "-e" "(require 'kbb-marker) (println kbb-marker/v)")]
              (is (zero? (:exit r)) (str (:out r) (:err r)))
              (is (str/includes? (:out r) ":from-cache")))))
        (testing "KBB_NO_STDLIB=1 on the sci door: the same script cannot find it"
          (let [r (run-kbb-env (assoc env "KBB_NO_STDLIB" "1") dir "--backend" "sci" "probe.cljk")]
            (is (= 1 (:exit r)))
            (is (str/includes? (str (:out r) (:err r)) "Could not find namespace: kotoba.lang.text"))))
        (testing "--backend sci --classpath: the caller's entry wins over the stdlib"
          (let [r (run-kbb-env env dir "--backend" "sci" "--classpath" "shadow" "probe.cljk")]
            (is (zero? (:exit r)) (str (:out r) (:err r)))
            (is (str/includes? (:out r) ":shadowed-by-caller"))))
        (testing "--classpath door: the stdlib is appended after the caller's classpath"
          (let [r (run-kbb-env env dir "--classpath" "." "probe.cljk")
                r2 (run-kbb-env env dir "--classpath" "shadow" "probe.cljk")]
            (is (zero? (:exit r)) (str (:out r) (:err r)))
            (is (str/includes? (:out r) "upper A"))
            (is (str/includes? (:out r2) ":shadowed-by-caller"))))
        (testing "a partial stdlib root: the missing siblings are named on EVERY run, cached or not"
          (let [partial (.join path dir "partial")
                penv (assoc env "KBB_STDLIB_ROOT" partial)]
            (.mkdirSync fs partial)
            (.symlinkSync fs (.join path stdlib-root "text") (.join path partial "text") "dir")
            (let [r1 (run-kbb-env penv dir "--backend" "sci" "probe.cljk")
                  r2 (run-kbb-env penv dir "--backend" "sci" "probe.cljk")]
              (is (str/includes? (:out r1) "upper A") (str (:out r1) (:err r1)))
              (is (str/includes? (:err r1) "stdlib sibling not checked out"))
              (is (str/includes? (:err r2) "stdlib sibling not checked out"))
              (is (= partial (first (str/split (.readFileSync fs cache "utf8") #"\n")))))))
        (.rmSync fs dir #js {:recursive true :force true})))))
