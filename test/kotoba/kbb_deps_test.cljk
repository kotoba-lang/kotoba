(ns kotoba.kbb-deps-test
  "bin/kbb_deps.cljk — the tools.deps-shaped door of kbb (ADR-2609112000).

  Runs `bin/kbb` as a subprocess against a throwaway deps.edn project, so
  every assertion is about an EXIT CODE the caller of `kbb -M:test` would
  see. Both directions are pinned: a green suite exits 0, the same suite
  with one failing deftest exits 1, an undeclared alias exits 64 naming the
  alias, `-Stree` exits 64 naming the flag, no deps.edn exits 66. The
  boundary case is the classpath-only alias (`:extra-paths`, no
  `:main-opts`): it is neither a run nor an unknown alias, and exits 64
  saying so rather than starting an empty engine.

  Needs the engine (kotoba-lang/org-babashka-nbb) next to this checkout or
  KBB_ENGINE set; otherwise every case is reported as SKIPPED, not passed."
  (:require [cljs.test :refer [deftest is testing]]
            [kotoba.lang.text :as str]))

(def fs (js/require "fs"))
(def path (js/require "path"))
(def os (js/require "os"))
(def cp (js/require "child_process"))

(def kbb (.resolve path "bin/kbb"))

(defn- engine-present? []
  (or (some? (.-KBB_ENGINE (.-env js/process)))
      (.existsSync fs (.resolve path "../org-babashka-nbb/cli.js"))))

(defn- run-kbb [cwd & args]
  (let [r (.spawnSync cp kbb (clj->js args) #js {:cwd cwd :encoding "utf8"})]
    {:exit (.-status r) :out (or (.-stdout r) "") :err (or (.-stderr r) "")}))

(defn- write! [dir rel content]
  (let [f (.join path dir rel)]
    (.mkdirSync fs (.dirname path f) #js {:recursive true})
    (.writeFileSync fs f content)))

(defn- fixture! []
  (let [dir (.mkdtempSync fs (.join path (.tmpdir os) "kbb-deps-"))]
    (write! dir "deps.edn"
            (str "{:paths [\"src\"]\n"
                 " :deps {sib/sib {:local/root \"sib\"}}\n"
                 " :aliases {:test {:extra-paths [\"test\"] :main-opts [\"-m\" \"cognitect.test-runner\"]}\n"
                 "           :run {:main-opts [\"-m\" \"fx.main\"]}\n"
                 "           :cp-only {:extra-paths [\"extra\"]}}}\n"))
    (write! dir "sib/src/sib/core.cljk" "(ns sib.core)\n(defn twice [x] (* 2 x))\n")
    (write! dir "src/fx/main.cljk" "(ns fx.main (:require [sib.core :as s]))\n(defn -main [& args] (println \"main\" (s/twice 21) (vec args)))\n")
    (write! dir "test/fx/core_test.cljk" "(ns fx.core-test (:require [cljs.test :refer [deftest is]] [sib.core :as s]))\n(deftest ok (is (= 42 (s/twice 21))))\n")
    dir))

(deftest kbb-deps-door
  (if-not (engine-present?)
    (println "SKIPPED kotoba.kbb-deps-test: engine not present (set KBB_ENGINE)")
    (let [dir (fixture!)]
      (testing "-Spath: root :paths plus :local/root paths, no JVM"
        (let [r (run-kbb dir "-Spath")]
          (is (zero? (:exit r)) (:err r))
          (is (= "src:sib/src" (str/trim (:out r))))))
      (testing "-M:run with trailing args reaches -main through the local/root dep"
        (let [r (run-kbb dir "-M:run" "a" "b")]
          (is (zero? (:exit r)) (:err r))
          (is (str/includes? (:out r) "main 42 [a b]"))))
      (testing "-M:test green -> 0, and the substitution is named on stderr"
        (let [r (run-kbb dir "-M:test")]
          (is (zero? (:exit r)) (str (:out r) (:err r)))
          (is (str/includes? (:err r) "test runner substitution"))))
      (testing "-M:test with one failing deftest -> 1"
        (write! dir "test/fx/bad_test.cljk" "(ns fx.bad-test (:require [cljs.test :refer [deftest is]]))\n(deftest bad (is (= 1 2)))\n")
        (let [r (run-kbb dir "-M:test")]
          (is (= 1 (:exit r)) (str (:out r) (:err r)))
          (is (str/includes? (:out r) "1 fail")))
        (.unlinkSync fs (.join path dir "test/fx/bad_test.cljk")))
      (testing "undeclared alias -> 64, naming it and the declared set"
        (let [r (run-kbb dir "-M:dev:test")]
          (is (= 64 (:exit r)))
          (is (str/includes? (:err r) "[:dev]"))
          (is (str/includes? (:err r) ":cp-only"))))
      (testing "boundary: classpath-only alias is refused as such, not run, not unknown"
        (let [r (run-kbb dir "-M:cp-only")]
          (is (= 64 (:exit r)))
          (is (str/includes? (:err r) "no :main-opts"))))
      (testing "-Stree -> 64 by name (no Maven resolution here)"
        (let [r (run-kbb dir "-Stree")]
          (is (= 64 (:exit r)))
          (is (str/includes? (:err r) "-Stree"))))
      (testing "no deps.edn -> 66"
        (let [empty (.join path dir "empty")]
          (.mkdirSync fs empty)
          (let [r (run-kbb empty "-M:test")]
            (is (= 66 (:exit r)))
            (is (str/includes? (:err r) "no deps.edn")))))
      (testing "-Sdeps aliases merge over the file"
        (let [r (run-kbb dir "-Sdeps" "{:aliases {:zz {:main-opts [\"-e\" \"(println :sdeps-ok)\"]}}}" "-M:zz")]
          (is (zero? (:exit r)) (:err r))
          (is (str/includes? (:out r) ":sdeps-ok"))))
      (.rmSync fs dir #js {:recursive true :force true}))))
