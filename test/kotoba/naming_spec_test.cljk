(ns kotoba.naming-spec-test
  "The actual ADL reader decodes the language-owned naming spec. No copy of the
  grammar or a data parser is maintained by the CLI host."
  (:require [kotoba.test :refer [deftest is]]
            [kotoba.adl :as adl]
            [kotoba.io :as io]
            [kotoba.lang.naming :as naming]
            [clojure.edn :as edn]
            #?(:cljs ["fs" :as fs])))

(defn read-text [file]
  #?(:clj (slurp file) :cljs (fs/readFileSync file "utf8")))

(defn spec-text [] (read-text (io/resource "kotoba/spec/naming.kotoba")))

(deftest normative-spec-is-data-decoded-by-its-real-owner
  (let [text (spec-text)
        spec (adl/read-string text)]
    (is (map? spec))
    (is (= "kotoba-lang/kotoba-lang" (:authority spec)))
    (is (= naming/profiles (:profiles spec)))
    (is (:ok? (naming/validate-spec spec)))
    (is (:ok? (naming/validate-source-whitespace text)))
    (is (vector? (:conformance spec)))
    (doseq [[kind predicate] naming/conformance-predicates]
      (let [cases (filter #(= kind (:kind %)) (:conformance spec))]
        (is (= #{true false} (set (map :valid? cases))) (str kind " needs positive and negative vectors"))
        (doseq [{:keys [value valid?]} cases]
          (is (= valid? (boolean (predicate value))) (str kind " " (pr-str value))))))))

(deftest drift-and-unknown-conformance-kinds-fail-closed
  (let [spec (adl/read-string (spec-text))]
    (doseq [bad [(assoc spec :profiles {})
                 (assoc spec :kotoba.spec/naming-version 2)
                 (assoc spec :conformance [])
                 (update spec :conformance conj {:kind :unknown :value "x" :valid? true})
                 (update spec :conformance conj {:kind :project-id :value "kotoba.bad-id" :valid? true})]]
      (is (false? (:ok? (naming/validate-spec bad)))))))

(deftest checked-in-event-design-validates-the-right-contexts
  (let [design (edn/read-string (read-text "spec/lexicon-events.edn"))
        example (:example design)]
    (is (= "kotoba/spec/naming.kotoba" (:naming-spec design)))
    (is (= :kotoba.field-path/v1 (get-in design [:subjects :field-path-profile])))
    (is (:ok? (naming/validate-event-names example)))
    (is (naming/subject-matches? (get-in example [:subscribe :pattern]) (:subject example)))
    (is (= ["body" "display.name"] (:segments (naming/parse-field-path (:field-path example)))))
    (doseq [[path value] [[[:subject] "kotoba.docs.*"] [[:field-path] "body.*"]
                          [[:subscribe :pattern] "kotoba.docs.>.changed"]]]
      (is (false? (:ok? (naming/validate-event-names (assoc-in example path value))))))))

(deftest wildcard-boundaries-never-come-from-source-operator-meaning
  (is (naming/lisp-name? "*"))
  (is (naming/lisp-name? "*context*"))
  (is (false? (naming/event-subject? "kotoba.docs.*")))
  (is (false? (naming/subject-matches? "kotoba.docs.>" "kotoba.docs")))
  (is (naming/subject-matches? "kotoba.docs.*" "kotoba.docs.changed"))
  (is (false? (naming/subject-matches? "kotoba.docs.*" "kotoba.docs.document.changed")))
  (is (= ["*"] (:segments (naming/parse-field-path ["*"])))))
