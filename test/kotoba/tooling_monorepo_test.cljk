(ns kotoba.tooling-monorepo-test
  (:require [kotoba.test :refer [deftest is testing]]
            [kotoba.lsp :as lsp]
            [kotoba.lang.lsp :as old-lsp]
            [kotoba.lsp.severities :as severities]
            [kotoba.lsp.diagnostic :as diagnostic]
            [kotoba.lsp-rpc :as rpc]
            [kotoba.lang.lsp-rpc :as old-rpc]
            [kotoba.lint :as lint]
            [kotoba.lang.lint :as old-lint]
            [kotoba.lint-kotoba :as analysis]
            [kotoba.lang.lint-kotoba :as old-analysis]
            [kotoba.bytes :as bytes]))

(deftest canonical-and-retained-tooling-apis-share-behavior
  (doseq [source ["" "abc" "日本語\n🌸\ntail" "line\n"]]
    (let [doc (lsp/text-document source)]
      (is (= (old-lsp/text-document source) doc))
      (doseq [offset (range (inc (count source)))]
        (is (= (old-lsp/offset->position doc offset) (lsp/offset->position doc offset))))))
  (doseq [source ["" "{:a 1}" "{:broken" "[1 2]"]]
    (is (= (old-lint/lint-source source) (lint/lint-source source))))
  (doseq [source ["(do (def ghost 1) (+ 1 2))" "{:grants [\"read\" \"write\"]}" "{:broken"]]
    (is (= (old-analysis/analyze source) (analysis/analyze source)))))

(deftest derived-value-dependencies-retain-var-identity
  (with-redefs [severities/severities #{:custom}]
    (is (= :custom (:severity (diagnostic/diagnostic {} :custom "test" "yes"))))
    (is (thrown? #?(:clj clojure.lang.ExceptionInfo :cljs js/Error)
                 (diagnostic/diagnostic {} :error "test" "no")))))

(deftest rpc-framing-counts-utf8-bytes-and-preserves-next-message
  (doseq [api [{:frame rpc/frame :unframe rpc/unframe :request rpc/request}
              {:frame old-rpc/frame :unframe old-rpc/unframe :request old-rpc/request}]
          value ["ascii" "日本語" "🌸" "é"]]
    (let [message ((:request api) 1 "echo" {:text value})
          framed ((:frame api) message)
          next-frame ((:frame api) ((:request api) 2 "next" {}))
          boundary (.indexOf framed "\r\n\r\n")
          header (subs framed 0 boundary)
          body (subs framed (+ boundary 4))]
      (is (= (str "Content-Length: " (count (bytes/utf8-bytes body))) header))
      (is (= [message ""] ((:unframe api) framed)))
      (is (= [message next-frame] ((:unframe api) (str framed next-frame))))
      (is (nil? ((:unframe api) (subs framed 0 (dec (count framed)))))))))

(deftest rpc-handler-exceptions-become-an-error-response-on-each-host
  (doseq [api [{:frame rpc/frame :unframe rpc/unframe :request rpc/request
               :make-server rpc/make-server :handle-message rpc/handle-message}
              {:frame old-rpc/frame :unframe old-rpc/unframe :request old-rpc/request
               :make-server old-rpc/make-server :handle-message old-rpc/handle-message}]]
    (let [sent (atom [])
          server ((:make-server api) (fn [_ _] (throw (ex-info "handler failed" {}))) #(swap! sent conj %))
          response ((:handle-message api) server ((:frame api) ((:request api) 3 "fail" {})))]
      (is (= -32603 (get-in response [:error :code])))
      (is (= "handler failed" (get-in response [:error :message])))
      (is (= [response ""] ((:unframe api) (first @sent)))))))

(deftest rpc-refuses-invalid-lengths-and-split-utf8-boundaries
  (doseq [unframe [rpc/unframe old-rpc/unframe]]
    (is (nil? (unframe "prefix Content-Length: 2\r\n\r\n{}")))
    (is (nil? (unframe "Content-Length: 9999999999999999999999999\r\n\r\n{}")))
    (is (nil? (unframe "Content-Length: -1\r\n\r\n{}")))
    (is (thrown? #?(:clj clojure.lang.ExceptionInfo :cljs js/Error)
                 (unframe "Content-Length: 1\r\n\r\n日")))))
