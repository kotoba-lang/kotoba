(ns kotoba.library-native-branch-test
  (:require [clojure.test :refer [deftest is testing]]
            [kotoba.compiler.core :as compiler]))

(deftest reviewed-bytes-modules-pass-the-current-closed-graph-admission
  (doseq [algorithm ["sha1" "sha256"]]
    (testing algorithm
      (let [root (symbol (str "kotoba.bytes." algorithm))
            sources {'kotoba.bytes (slurp "lib/kotoba.bytes/src/kotoba/bytes.cljk")
                     root (slurp (str "lib/kotoba.bytes/src/kotoba/bytes/" algorithm ".cljk"))}
            result (compiler/check-project sources root)]
        (is (true? (get-in result [:admission :admitted?])) (pr-str (:admission result)))
        (is (= root (:root result)))
        (is (= ['kotoba.bytes root] (:module-order result)))))))
