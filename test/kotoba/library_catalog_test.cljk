(ns kotoba.library-catalog-test
  (:require [kotoba.test :refer [deftest is testing]]
            [clojure.edn :as edn]
            #?(:cljs [clojure.string :as str])
            [kotoba.library-catalog :as catalog]
            [kotoba.coll :as coll]
            [kotoba.coll.map-vals :as coll-definition]
            [kotoba.spec :as spec]
            [kotoba.spec.valid :as spec-definition]
            [kotoba.json :as json]
            [kotoba.json.encode :as json-definition]
            #?(:cljs ["fs" :as fs])))

(def fixture
  {:kotoba.library-catalog/version 1
   :packages [{:id "kotoba.json" :kind :library :path "lib/kotoba.json"
               :source-paths ["src"]
               :aliases ["kotoba-lang/json" "io.github.kotoba-lang/json"]}
              {:id "kotoba.coll" :kind :library :path "lib/kotoba.coll"
               :source-paths ["src"] :aliases ["kotoba-lang/coll"]}]})

(deftest checked-in-catalog-and-classpath-use-the-bundled-implementations
  (let [data (edn/read-string #?(:clj (slurp "lib/catalog.edn")
                                 :cljs (fs/readFileSync "lib/catalog.edn" "utf8")))]
    (is (:ok? (catalog/validate data)))
    (is (= ["kotoba.coll" "kotoba.spec" "kotoba.json"
            "kotoba.set" "kotoba.walk" "kotoba.string" "kotoba.time"
            "kotoba.bytes" "kotoba.pprint" "kotoba.error"
            "kotoba.text" "kotoba.test" "kotoba.edn" "kotoba.io" "kotoba.process" "kotoba.async" "kotoba.scheduler" "kotoba.store" "kotoba.fmt" "kotoba.log" "kotoba.fs"
            "kotoba.lsp" "kotoba.lsp.rpc" "kotoba.lint" "kotoba.lint.kotoba"
            "gov.nist.sha3" "gov.nist.sha2" "gov.nist.mlKem" "org.ietf.x25519" "org.ietf.ed25519" "org.ietf.chacha20Poly1305" "org.ietf.jcs" "org.ietf.cbor" "org.ietf.deflate" "org.ietf.blake2" "org.ietf.zstd" "org.ietf.mime" "org.ietf.brotli" "org.ietf.ical" "org.ietf.sip" "org.ietf.opus" "org.ietf.sdp" "org.ietf.rtp" "org.ietf.diameter" "org.ietf.coap" "org.ietf.xdr" "org.ietf.websocket" "org.ietf.asn1" "org.ietf.rtsp" "org.ietf.ospf" "org.ietf.csv" "org.ieee.systemverilog" "org.ieee.tar" "org.ieee.upf" "org.ieee.vhdl" "org.iso.aac" "org.iso.jpeg" "org.iso.opentype" "org.iso.pdf" "org.omg.bpmn" "org.omg.cmmn" "org.omg.dmn" "org.w3.aria" "org.w3.did" "org.w3.nquads" "org.w3.jsonLdApi" "org.w3.svg" "org.w3.webaudio" "org.w3.webrtcSignaling" "org.w3.woff" "org.ietf.ssh" "kotoba.xml" "org.ietf.netconf" "kotoba.dslCore" "kotoba.datomSource" "kotoba.columnar" "com.google.snappy" "kotoba.ioMultiformats" "org.w3.rdf" "org.w3.rdfCanon" "org.w3.vcBitstringStatusList" "org.w3.vcDataIntegrity" "org.omg.sysmlv2" "org.omg.uml" "kotoba.datalog" "kotoba.sparql" "org.apache.parquet" "org.apache.avro" "org.apache.iceberg" "org.w3.owl2" "kotoba.devProtobuf" "kotoba.ioIpld" "kotoba.activity" "kotoba.adnet"]
           (mapv :id (:packages data))))
    (doseq [package (:packages data) alias (:aliases package)]
      (is (= package (:package (catalog/resolve-library data alias)))))
    (is (identical? coll/map-vals coll-definition/map-vals))
    (is (identical? spec/valid? spec-definition/valid?))
    (is (identical? json/encode json-definition/encode))
    #?(:cljs
       (doseq [[id variable] [["kotoba.coll" #'coll-definition/map-vals]
                              ["kotoba.spec" #'spec-definition/valid?]
                              ["kotoba.json" #'json-definition/encode]]]
         (is (str/includes? (:file (meta variable)) (str "/lib/" id "/src/"))
             (str id " resolved outside the bundled source tree: " (:file (meta variable))))))))

(deftest canonical-and-legacy-names-select-the-same-source
  (let [canonical (catalog/resolve-library fixture "kotoba.json")]
    (is (:ok? canonical))
    (is (false? (:alias? canonical)))
    (doseq [name ["kotoba-lang/json" "io.github.kotoba-lang/json"]]
      (let [legacy (catalog/resolve-library fixture name)]
        (is (:alias? legacy))
        (is (= (:package canonical) (:package legacy)))))))

(deftest names-have-no-implicit-normalization-or-domain-authority
  (doseq [name ["app.kotoba.json" "kotoba-json" "Kotoba.json" "kotoba.JSON" "json" nil]]
    (is (false? (:ok? (catalog/resolve-library fixture name)))))
  (doseq [name ["kotoba.json" "kotoba.docs.document"]]
    (is (catalog/library-id? name)))
  (doseq [name ["kotoba" "kotoba.*" "kotoba..json" "kotoba.json/encode" "com.cloudflare.api"]]
    (is (not (catalog/library-id? name)))))

(deftest collision-or-alias-chain-cannot-select-an-implementation
  (doseq [bad [(update fixture :packages conj (first (:packages fixture)))
               (assoc-in fixture [:packages 1 :aliases] ["kotoba.json"])
               (assoc-in fixture [:packages 1 :aliases] ["kotoba-lang/json"])
               (assoc-in fixture [:packages 0 :id] "kotoba-lang/json")]]
    (is (false? (:ok? (catalog/resolve-library bad "kotoba.json")))))
  (testing "aliases are names, never target references"
    (let [bad (assoc-in fixture [:packages 0 :aliases] [{:name "old" :target "other"}])]
      (is (false? (:ok? (catalog/resolve-library bad "old")))))))

(deftest source-resolution-is-atomic-and-confined-to-package-paths
  (is (= {:ok? true :ids ["kotoba.json" "kotoba.coll"]
          :paths ["lib/kotoba.json/src" "lib/kotoba.coll/src"]}
         (catalog/source-paths fixture ["kotoba-lang/json" "kotoba.json" "kotoba.coll"])))
  (let [missing (catalog/source-paths fixture ["kotoba.json" "missing"])]
    (is (false? (:ok? missing)))
    (is (not (contains? missing :paths))))
  (doseq [path ["/tmp/code" "../code" "src/../../code" "src//other" "C:\\code" "src\nother"]]
    (is (false? (:ok? (catalog/validate (assoc-in fixture [:packages 0 :source-paths] [path]))))))
  (is (false? (:ok? (catalog/source-paths {} [])))))
