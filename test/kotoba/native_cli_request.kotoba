(ns kotoba.native-cli-request (:export [main])
 (:require [kotoba.cli :as cli] [kotoba.cli-exec :as execution]
           [kotoba.form :as f] [kotoba.compiler.kotoba-reader :as reader]))
(defn- get [m [:ref :form/r] key :keyword] [:ref :form/r] (f/form-get m (f/keyword-form key)))
(defn- text [node [:ref :form/r]] :string
 (if (f/is-keyword? node) (keyword-name (f/keyword-value node)) (f/string-value node)))
(defn- append [xs [:list :string] x :string] [:list :string] (typed-list-conj [:list :string] xs x))
(defn- sample [option [:ref :form/r]] :string
 (let [kind (get option :type)]
  (cond (f/eq kind (f/keyword-form :enum)) (text (f/nth-of (get option :values) 0))
        (f/eq kind (f/keyword-form :boolean)) "false"
        (f/eq kind (f/keyword-form :int)) "1"
        (f/eq kind (f/keyword-form :edn)) "{:value 1}" :else "input-例")))
(defn- base [spec [:ref :form/r] skip [:ref :form/r]] [:list :string]
 (let [initial (append (typed-list-new [:list :string]) (text (get spec :id)))
       declarations (get spec :positionals)
       positionals (loop [i 0 out initial]
                    (if (= i (f/count-of declarations)) out
                     (recur (+ i 1) (if (f/is-true? (get (f/nth-of declarations i) :required?)) (append out "source.kotoba") out))))
       options (get spec :options)]
  (loop [i 0 out positionals]
   (if (= i (f/count-of options)) out
    (let [option (f/nth-of options i)]
     (recur (+ i 1)
      (if (and (f/is-true? (get option :required?)) (not (f/eq (get option :id) skip)))
       (append (append out (f/string-value (f/nth-of (get option :flags) 0))) (sample option)) out)))))))
(defn- success? [contract [:ref :form/r] argv [:list :string]] :bool
 (let [r (cli/parse-argv contract argv) ok (result-ok?-of [:result [:ref :form/r] :keyword] r)
       report (if ok "" (string-concat "FAILED positive " (string-concat (typed-list-nth [:list :string] argv 0)
                (string-concat " " (string-concat (if (> (vector-count argv) 1) (typed-list-nth [:list :string] argv 1) "")
                 (string-concat " " (keyword-name (result-error-of [:result [:ref :form/r] :keyword] r :none))))))))
       out (if ok "" (typed-cap-call :io/write :string :string (string-concat report "\n")))] ok))
(defn- error? [contract [:ref :form/r] argv [:list :string] expected :keyword] :bool
 (let [r (cli/parse-argv contract argv)
       ok (and (not (result-ok?-of [:result [:ref :form/r] :keyword] r))
              (= (result-error-of [:result [:ref :form/r] :keyword] r :none) expected))
       report (if ok "" (typed-cap-call :io/write :string :string
                (string-concat "FAILED refusal " (string-concat (keyword-name expected)
                  (string-concat " actual " (string-concat (keyword-name (result-error-of [:result [:ref :form/r] :keyword] r :none)) "\n"))))))] ok))
(defn- flags [contract [:ref :form/r] spec [:ref :form/r]] :bool
 (let [options (get spec :options)]
  (loop [i 0 valid true]
   (if (= i (f/count-of options)) valid
    (let [option (f/nth-of options i) aliases (get option :flags)
          valid-one (loop [j 0 valid-one true]
                     (if (= j (f/count-of aliases)) valid-one
                      (let [argv (append (append (base spec (get option :id)) (f/string-value (f/nth-of aliases j))) (sample option))]
                       (recur (+ j 1) (and valid-one (success? contract argv))))))]
     (recur (+ i 1) (and valid valid-one)))))))
(defn- contract [index :string] [:ref :form/r]
 (let [text (typed-cap-call :cli/args :string :string index)
       r (reader/read-forms-bounded text 512 200000)
       forms (record-get [:ref :kotoba.reader/out] r :forms)]
  (if (and (= (vector-count forms) 1) (string=? (record-get [:ref :kotoba.reader/out] r :err) ""))
   (typed-list-nth [:list [:ref :form/r]] forms 0) (throw :test/reader))))
(defn- arg [index :string] :string (typed-cap-call :cli/args :string :string index))
(defn- executed-lock-check? [c [:ref :form/r]] :bool
 (let [path (arg "1") damaged (arg "2")
       positive-request (result-value-of [:result [:ref :form/r] :keyword]
                         (cli/parse-argv c (typed-list-new [:list :string] "check" path "--kind" "lock")) (f/nil-form))
       damaged-request (result-value-of [:result [:ref :form/r] :keyword]
                        (cli/parse-argv c (typed-list-new [:list :string] "check" damaged "--kind" "lock")) (f/nil-form))
       absent-request (result-value-of [:result [:ref :form/r] :keyword]
                       (cli/parse-argv c (typed-list-new [:list :string] "check" "--kind" "lock")) (f/nil-form))
       extra-request (result-value-of [:result [:ref :form/r] :keyword]
                      (cli/parse-argv c (typed-list-new [:list :string] "check" path damaged "--kind" "lock")) (f/nil-form))
       unresolved-request (result-value-of [:result [:ref :form/r] :keyword]
                           (cli/parse-argv c (typed-list-new [:list :string] "check" path "--kind" "lock" "-S" "src")) (f/nil-form))
       unsafe-request (result-value-of [:result [:ref :form/r] :keyword]
                       (cli/parse-argv c (typed-list-new [:list :string] "check" path "--kind" "lock" "--safe=false")) (f/nil-form))
       valid (execution/execute-request c positive-request)
       diagnostic (if (result-ok?-of [:result :string :keyword] valid) ""
                    (typed-cap-call :io/write :string :string
                     (string-concat (document-edn-print
                      (document-keyword (result-error-of [:result :string :keyword] valid :none))) "\n")))
       invalid (execution/execute-request c damaged-request)
       changed-contract (execution/execute-request
                         (f/assoc-form c (f/keyword-form :kotoba.cli.contract/version) (f/int-form 2)) positive-request)
       absent (execution/execute-request c absent-request)
       extra (execution/execute-request c extra-request)
       unresolved (execution/execute-request c unresolved-request)
       unsafe (execution/execute-request c unsafe-request)]
  (and (result-ok?-of [:result :string :keyword] valid)
       (string=? (result-value-of [:result :string :keyword] valid "") "bafkreibhyfwgozu7dmqhxz2fq7h2xkhmcnmwie4duqf56hx6v2bjy7szvy")
       (not (result-ok?-of [:result :string :keyword] invalid))
       (= (result-error-of [:result :string :keyword] invalid :none) :module-lock/cid)
       (not (result-ok?-of [:result :string :keyword] changed-contract))
       (= (result-error-of [:result :string :keyword] changed-contract :none) :cli/contract)
       (not (result-ok?-of [:result :string :keyword] absent))
       (= (result-error-of [:result :string :keyword] absent :none) :cli/lock-path-required)
       (not (result-ok?-of [:result :string :keyword] extra))
       (= (result-error-of [:result :string :keyword] extra :none) :cli/lock-path-required)
       (not (result-ok?-of [:result :string :keyword] unresolved))
       (= (result-error-of [:result :string :keyword] unresolved :none) :cli/check-option-unavailable)
       (not (result-ok?-of [:result :string :keyword] unsafe))
       (= (result-error-of [:result :string :keyword] unsafe :none) :cli/check-option-unavailable))))
(defn- replace-index [xs [:ref :form/r] index :i64 value [:ref :form/r]] [:ref :form/r]
 (let [items (loop [i 0 out (f/no-forms)]
              (if (= i (f/count-of xs)) out
               (recur (+ i 1) (f/append-form out (if (= i index) value (f/nth-of xs i))))))]
  (f/form-vec items)))
(defn- executed-contract-check? [c [:ref :form/r]] :bool
 (let [commands (get c :kotoba.cli.contract/commands)
       first (f/nth-of commands 0) second (f/nth-of commands 1)
       duplicated (f/assoc-form second (f/keyword-form :id) (get first :id))
       duplicate-commands (f/assoc-form c (f/keyword-form :kotoba.cli.contract/commands)
                           (replace-index commands 1 duplicated))
       options (get first :options) option (f/nth-of options 0)
       flag (f/nth-of (get option :flags) 0)
       duplicate-option (f/assoc-form option (f/keyword-form :flags) (f/form-vec (f/two-forms flag flag)))
       duplicate-spec (f/assoc-form first (f/keyword-form :options) (replace-index options 0 duplicate-option))
       duplicate-flags (f/assoc-form c (f/keyword-form :kotoba.cli.contract/commands)
                        (replace-index commands 0 duplicate-spec))
       argv (typed-list-new [:list :string] "check" "--kind" "cli-contract")
       parsed (cli/parse-argv c argv)
       request (result-value-of [:result [:ref :form/r] :keyword] parsed (f/nil-form))
       positive (execution/execute-request c request)
       bad-version (execution/execute-request
                    (f/assoc-form c (f/keyword-form :kotoba.cli.contract/version) (f/int-form 2)) request)
       empty-commands (execution/execute-request
                       (f/assoc-form c (f/keyword-form :kotoba.cli.contract/commands)
                         (f/form-vec (f/no-forms))) request)
       bad-ids (execution/execute-request duplicate-commands request)
       bad-flags (execution/execute-request duplicate-flags request)
       input-request (result-value-of [:result [:ref :form/r] :keyword]
                      (cli/parse-argv c (typed-list-new [:list :string] "check" "contract.edn" "--kind" "cli-contract")) (f/nil-form))
       json-request (result-value-of [:result [:ref :form/r] :keyword]
                     (cli/parse-argv c (typed-list-new [:list :string] "check" "--kind" "cli-contract" "--json")) (f/nil-form))
       input-unavailable (execution/execute-request c input-request)
       json-unavailable (execution/execute-request c json-request)
       run-request (result-value-of [:result [:ref :form/r] :keyword]
                    (cli/parse-argv c (typed-list-new [:list :string] "run" "--expr" "(+ 1 2)")) (f/nil-form))
       unavailable (execution/execute-request c run-request)]
  (and (result-ok?-of [:result :string :keyword] positive)
       (string=? (result-value-of [:result :string :keyword] positive "") "cli-contract/v1")
       (not (result-ok?-of [:result :string :keyword] bad-version))
       (= (result-error-of [:result :string :keyword] bad-version :none) :cli/contract)
       (not (result-ok?-of [:result :string :keyword] empty-commands))
       (= (result-error-of [:result :string :keyword] empty-commands :none) :cli/contract)
       (not (result-ok?-of [:result :string :keyword] bad-ids))
       (= (result-error-of [:result :string :keyword] bad-ids :none) :cli/duplicate-command)
       (not (result-ok?-of [:result :string :keyword] bad-flags))
       (= (result-error-of [:result :string :keyword] bad-flags :none) :cli/duplicate-flag)
       (not (result-ok?-of [:result :string :keyword] input-unavailable))
       (= (result-error-of [:result :string :keyword] input-unavailable :none) :cli/contract-input-unavailable)
       (not (result-ok?-of [:result :string :keyword] json-unavailable))
       (= (result-error-of [:result :string :keyword] json-unavailable :none) :cli/check-option-unavailable)
       (not (result-ok?-of [:result :string :keyword] unavailable))
       (= (result-error-of [:result :string :keyword] unavailable :none) :cli/native-execution-unavailable))))
(defn- run [] :i64
 (let [c (contract "0") commands (get c :kotoba.cli.contract/commands)
       complete (loop [i 0 valid true]
                  (if (= i (f/count-of commands)) valid
                   (let [spec (f/nth-of commands i)]
                    (recur (+ i 1) (and valid (success? c (base spec (f/nil-form))) (flags c spec))))))
       min (typed-list-new [:list :string] "id" "--chain-id" "-9223372036854775808")
       max (typed-list-new [:list :string] "id" "--chain-id=9223372036854775807")
       repeated (typed-list-new [:list :string] "check" "-S" "one" "--source-path" "two")
       parsed (cli/parse-argv c repeated)
       request (result-value-of [:result [:ref :form/r] :keyword] parsed (f/nil-form))]
  (if (and (= (f/count-of commands) 12) complete (executed-contract-check? c) (executed-lock-check? c)
           (success? c min) (success? c max)
           (success? c (typed-list-new [:list :string] "compile" "source.kotoba" "--target=web"))
           (success? c (typed-list-new [:list :string] "run" "--runtime" "kotoba" "--expr" "(+ 1 2)"))
           (= (f/count-of (get (get request :options) :source-path)) 2)
           (f/is-true? (get (get request :options) :safe))
           (error? c (typed-list-new [:list :string] "compile") :cli/required-positional)
           (error? c (typed-list-new [:list :string] "graph") :cli/required-option)
           (error? c (typed-list-new [:list :string] "deploy") :cli/required-option)
           (error? c (typed-list-new [:list :string] "run" "--runtime" "nbb") :cli/enum)
           (error? c (typed-list-new [:list :string] "compile" "source.kotoba" "--target" "aarch64-linux") :cli/enum)
           (error? c (typed-list-new [:list :string] "check" "--json=false" "--json") :cli/duplicate-option)
           (error? c (typed-list-new [:list :string] "check" "--safe=maybe") :cli/boolean)
           (error? c (typed-list-new [:list :string] "check" "--source-path") :cli/missing-value)
           (error? c (typed-list-new [:list :string] "id" "--chain-id" "9223372036854775808") :cli/int)
           (error? c (typed-list-new [:list :string] "id" "--chain-id" "1例") :cli/int)
           (error? c (typed-list-new [:list :string] "check" "--unknown") :cli/unknown-option)
           (error? c (typed-list-new [:list :string] "nbb") :cli/unknown-command)
           (error? c (typed-list-new [:list :string] "git" "status" "--op" "commit") :cli/subcommand-conflict))
   (let [p (typed-cap-call :io/write :string :string "PASS_NATIVE_ALL12_CLI_REQUEST_AND_CONTRACT_AND_LOCK_CHECK_EXECUTION\n")] 0)
   (throw :test/cli-request))))
(defn- missing-file-control [] :i64
 (let [c (contract "1") path (arg "2")
       request (result-value-of [:result [:ref :form/r] :keyword]
                 (cli/parse-argv c (typed-list-new [:list :string] "check" path "--kind" "lock")) (f/nil-form))
       result (execution/execute-request c request)]
  (if (result-ok?-of [:result :string :keyword] result) 0 91)))
(defn main [] :i64
 (try (if (string=? (arg "0") "FS_MISSING") (missing-file-control) (run)) (catch :keyword reason
  (let [p (typed-cap-call :io/write :string :string (document-edn-print (document-keyword reason)))] 91))))
