;; main combines seven verdicts in one execution context. Only scalar verdicts
;; leave the artifact; recursive values stay in the linked runtime.
(ns native-runtime-values
  (:export [main typed-string typed-collection scalar-compatibility fuel-refusal
            reader-refusal policy-refusal policy-shape-refusal])
  (:require [kotoba.runtime :as runtime] [kotoba.form :as form])
  (:schemas {:form/r [:record :form/r [[:tag :i64] [:s :string] [:n :i64] [:k :keyword]
                                      [:kids [:list [:ref :form/r]]] [:span :i64] [:data :bytes]]]
             :runtime/eval-out [:record :runtime/eval-out
                                [[:ok :bool] [:value [:ref :form/r]]
                                 [:error :string] [:fuel :i64]]]
             :runtime/eval-summary [:record :runtime/eval-summary
                                    [[:ok :i64] [:value :i64] [:error :string]
                                     [:steps :i64] [:fuel :i64]]]}))

(defn typed-string [] :i64
  (let [r (runtime/eval-source-value "\"hello\"" 200)]
    (if (and (record-get [:ref :runtime/eval-out] r :ok)
             (string=? "hello" (form/string-value
                                (record-get [:ref :runtime/eval-out] r :value)))) 1 0)))

(defn typed-collection [] :i64
  (let [r (runtime/eval-source-value "[\"hello\" {:answer (+ 20 22) :other 7}]" 500)
        v (record-get [:ref :runtime/eval-out] r :value)
        answer (form/form-get (form/nth-of v 1) (form/keyword-form :answer))]
    (if (and (record-get [:ref :runtime/eval-out] r :ok)
             (form/is-vec? v) (= 42 (form/int-value answer))
             (= 7 (form/int-value (form/form-get (form/nth-of v 1)
                                                (form/keyword-form :other))))) 1 0)))

(defn scalar-compatibility [] :i64
  (let [r (runtime/eval-source "(+ 20 22)" 500)
        s (runtime/eval-source "\"hello\"" 200)]
    (if (and (= 1 (record-get [:ref :runtime/eval-summary] r :ok))
             (= 42 (record-get [:ref :runtime/eval-summary] r :value))
             (= 500 (+ (record-get [:ref :runtime/eval-summary] r :steps)
                       (record-get [:ref :runtime/eval-summary] r :fuel)))
             (= 0 (record-get [:ref :runtime/eval-summary] s :ok))
             (string=? "evaluation result is not an integer"
                       (record-get [:ref :runtime/eval-summary] s :error))) 1 0)))

(defn fuel-refusal [] :i64
  (let [r (runtime/eval-source-value "(defn main [] (main))" 8)]
    (if (and (not (record-get [:ref :runtime/eval-out] r :ok))
             (= 0 (record-get [:ref :runtime/eval-out] r :fuel))) 1 0)))

(defn reader-refusal [] :i64
  (let [r (runtime/eval-source-value-with-policy-bounded
           "[[[[1]]]]" 200 (form/form-map (form/no-forms)) false 2 1024)]
    (if (and (not (record-get [:ref :runtime/eval-out] r :ok))
             (= 200 (record-get [:ref :runtime/eval-out] r :fuel))
             (string=? "EDN nesting exceeds limit"
                       (record-get [:ref :runtime/eval-out] r :error))) 1 0)))

(defn policy-refusal [] :i64
  (let [r (runtime/eval-source-value-with-policy-bounded
           "(mem-byte-at 0 0)" 200 (form/form-map (form/no-forms)) false 64 1024)]
    (if (and (not (record-get [:ref :runtime/eval-out] r :ok))
             (= 200 (record-get [:ref :runtime/eval-out] r :fuel))
             (string=? "raw linear-memory access denied: mem-byte-at"
                       (record-get [:ref :runtime/eval-out] r :error))) 1 0)))

(defn policy-shape-refusal [] :i64
  (let [r (runtime/eval-source-value-with-policy-bounded
           "42" 200 (form/int-form 1) false 64 1024)]
    (if (and (not (record-get [:ref :runtime/eval-out] r :ok))
             (string=? "kotoba.error/policy-shape: policy must be one EDN map"
                       (record-get [:ref :runtime/eval-out] r :error))) 1 0)))

(defn main [] :i64
  (+ (typed-string) (* 2 (typed-collection)) (* 4 (scalar-compatibility))
     (* 8 (fuel-refusal)) (* 16 (reader-refusal)) (* 32 (policy-refusal))
     (* 64 (policy-shape-refusal))))
