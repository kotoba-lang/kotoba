(ns kotoba.library-native-codecs
  (:export [main invalid-capacity invalid-scope])
  (:require [kotoba.json :as json]
            [json.data-json :as data-json]
            [json.lines :as lines]
            [kotoba.edn :as edn]
            [kotoba.text :as text]
            [kotoba.process :as process]
            [kotoba.async :as channel]))
(defn- bad-json? [source :string] :bool
  (not (result-ok?-of [:result :document :document] (json/decode source))))
(defn- json-check [] :bool
  (let [decoded (json/decode "{\"a\":[1,true,null,\"日本😀\"]}")
        value (result-value-of [:result :document :document] decoded (document-null))
        invalid (json/decode "{\"a\":1} trailing")]
    (and (result-ok?-of [:result :document :document] decoded)
         (string=? (json/encode value) "{\"a\":[1,true,null,\"日本😀\"]}")
         (not (result-ok?-of [:result :document :document] invalid))
         (bad-json? "[1,]") (bad-json? "{\"a\":1,}") (bad-json? "{\"a\":}")
         (bad-json? "{a\":1}") (bad-json? "\"raw\nline\"")
         (bad-json? "01") (bad-json? "1.") (bad-json? "1e+")
         (bad-json? "\"\\q\"") (bad-json? "\"\\uD800\"")
         (result-ok?-of [:result :document :document] (data-json/read-str "null"))
         (= 2 (vector-count (lines/split-records "null\n　\n\"日本😀\"\n"))))))
(defn- edn-check [] :bool
  (let [read (edn/read-document "{:a [1 true nil]}")
        invalid (edn/read-document "{} {}")
        all (edn/read-all "{:a 1} [2]")]
    (and (result-ok?-of [:result :document :document] read)
         (not (result-ok?-of [:result :document :document] invalid))
         (not (result-ok?-of [:result :document :document] (edn/read-document "[1}")))
         (not (result-ok?-of [:result :document :document] (edn/read-document "#inst \"x\"")))
         (= 0 (document-count
               (result-value-of [:result :document :document] (edn/read-all "; empty") (document-null))))
         (result-ok?-of [:result :string :document]
           (edn/write-string (result-value-of [:result :document :document] read (document-null))))
         (= 2 (document-count (result-value-of [:result :document :document] all (document-null)))))))
(defn- process-check [] :bool
  (let [ok (process/validate-spawn (typed-list-conj [:list :string] (typed-list-conj [:list :string] (typed-list-new [:list :string]) "echo") "hello") 1024 100)
        bad (process/validate-spawn (typed-list-conj [:list :string] (typed-list-new [:list :string]) "　") 1024 100)]
    (and (not (option-some?-of [:option :keyword] ok))
         (= :process/bad-arg (option-or bad :unexpected)))))
(defn- channel-check [] :bool
  (let [put (channel/put (channel/fixed-chan 2) (document-i64 9))
        state (option-or (document-vector-at put 0) (document-null))
        taken (channel/channel-take state)
        value (option-or (document-vector-at taken 1) (document-null))
        scope (channel/scope)
        spawned (channel/scope-spawn scope (document-string "task"))
        running (option-or (document-vector-at spawned 0) (document-null))
        joined (channel/scope-close (channel/scope-complete running 0 (document-null)))]
    (and (= 9 (option-or (document-i64-value value) 0))
         (channel/scope-join-ready? joined))))
(defn main [] :i64
  (+ (if (json-check) 1 0)
     (if (edn-check) 2 0)
     (if (process-check) 4 0)
     (if (channel-check) 8 0)
     (if (and (text/blank? "　\t")
              (not (text/blank? " "))
              (string=? (text/ascii-lower "AZİ日本") "azİ日本")) 16 0)))
(defn invalid-capacity [] :i64
  (document-count (channel/fixed-chan 0)))
(defn invalid-scope [] :i64
  (document-count (channel/scope-spawn (channel/scope-close (channel/scope)) (document-null))))
