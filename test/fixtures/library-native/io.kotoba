(ns kotoba.library-native-io
  (:export [main])
  (:require [kotoba.io :as io]
            [kotoba.io.reader :as reader]))
(defn- all-octets [] :bytes
  (loop [i 0 out (vector-i64)]
    (if (= i 256) (bytes-from-vector-i64 out) (recur (+ i 1) (vector-conj out i)))))
(defn- octets-match? [value :bytes] :bool
  (and (= 256 (bytes-count value))
       (loop [i 0]
         (if (= i 256) true
             (if (= i (bytes-at value i)) (recur (+ i 1)) false)))))
(defn main [] :i64
  (let [bytes (io/put (io/byte-buffer) (bytes-from-vector-i64 (vector-i64 0 127 128 255)))
        source (io/reader-buffer bytes)
        sink (io/copy source (io/buffer-writer (bytes-empty)))
        copied (io/written sink)
        chunks (io/reader-seq source)]
    (+ (if (and (= 4 (io/len bytes))
                (octets-match? (io/written (io/copy (io/reader-buffer (all-octets))
                                                    (io/buffer-writer (bytes-empty)))))) 1 0)
       (if (= 255 (bytes-at copied 3)) 2 0)
       (if (= 1 (vector-count chunks)) 4 0)
       (if (= 0 (reader/eof? source)) 8 0)
       (if (= 1 (reader/eof? (reader/advance source))) 16 0)
       (if (= 0 (bytes-count (io/read! (io/reader-buffer (bytes-empty))))) 32 0))))
