(ns library-import.retirement
  (:require [kotoba.text :as text]
            [kotoba.string :as string]
            [kotoba.io.put :as put]))

(defn main []
  (let [buffer (atom [])
        bytes (js/Int8Array. (clj->js (range -128 128)))
        result (put/put buffer bytes)
        empty-result (put/put buffer (js/Uint8Array. 0))]
    {:rounding [(text/format "%.0f" 0.49999999999999994)
                (text/format "%.0f" 0.5)
                (text/format "%.0f" -0.49999999999999994)
                (text/format "%.0f" 9007199254740991.0)]
     :folding (= "abcÉ" (string/ascii-lower "ABCÉ"))
     :octets (= (mapv (fn [n] (bit-and n 255)) (range -128 128)) @buffer)
     :same-buffer (and (identical? buffer result) (identical? buffer empty-result))
     :origins [(:file (meta #'text/format)) (:file (meta #'put/put))]}))
