(ns library-import.string-text-compat
  (:require [kotoba.string :as string]
            [kotoba.text :as text]))

(defn main []
  (let [values ["a+b[0]" "(x)?^$.*\\end" "日本語" ""]]
    {:same? (every? #(= (text/re-quote %) (string/re-quote %)) values)
     :roundtrip? (every? #(= % (re-find (re-pattern (string/re-quote %)) %)) values)
     :origin (:file (meta #'string/re-quote))}))
