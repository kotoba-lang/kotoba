(ns library-import.canonical
  (:require [kotoba.coll :as coll]
            [kotoba.spec :as spec]
            [kotoba.json :as json]
            [kotoba.coll.map-vals :as coll-definition]
            [kotoba.spec.valid :as spec-definition]
            [kotoba.json.encode :as json-definition]))

(defn main [n]
  {:collection (coll/map-vals inc {:a n})
   :valid (spec/valid? {:type :int} n)
   :json (json/encode {:ok true})
   :origins {:coll (:file (meta #'coll-definition/map-vals))
             :spec (:file (meta #'spec-definition/valid?))
             :json (:file (meta #'json-definition/encode))}})

(defn echo [value]
  (println "echo")
  value)
