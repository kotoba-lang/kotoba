(ns library-import.lisp-names
  (:refer-clojure :exclude [+ - = * /])
  (:require [kotoba.coll :as coll]))

(defn + [n] (get (coll/map-vals inc {:a n}) :a))
(defn - [n] (dec n))
(defn = [n] (clojure.core/= n 42))
(defn * [n] (clojure.core/* n 2))
(defn / [n] (clojure.core// n 2))
(defn valid? [n] (clojure.core/= n 42))
(defn touch! [n] n)
(defn _unused [n] n)
(defn value' [n] n)
(defn *context* [n] n)
(defn %parse [n] n)
(defn 読む [n] n)
