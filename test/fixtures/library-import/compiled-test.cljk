(ns kotoba.fixture.compiled-test
  (:require [cljs.test :as host]
            [kotoba.test.cljs :as t])
  (:require-macros [kotoba.test.cljs :refer [deftest is are testing async run-tests use-fixtures]]))

(def planted? (= "1" (.. js/process -env -KOTOBA_TEST_PLANTED_FAILURE)))
(def fixtures (atom []))

(use-fixtures :once
  {:before #(swap! fixtures conj :before)
   :after #(swap! fixtures conj :after)})

(deftest synchronous-macros
  (testing "real host macros and shared report identity"
    (is (identical? t/report host/report))
    (are [value] (pos? value) 1 2 3)
    (is (= [:before] @fixtures))))

(deftest asynchronous-failure-reaches-process
  (async done
    (js/setTimeout
      (fn []
        (is (not planted?) "planted async failure must reach the host summary")
        (done))
      0)))

(deftest exception-reaches-summary
  (if planted?
    (throw (js/Error. "planted compiled test exception"))
    (is true)))

(defmethod t/report [:cljs.test/default :end-run-tests] [summary]
  (let [expected (if planted? [3 5 1 1] [3 7 0 0])
        counts (mapv summary [:test :pass :fail :error])]
    (println "compiled-bridge-summary" (pr-str counts))
    (when-not (and (= expected counts) (= [:before :after] @fixtures))
      (throw (js/Error. (str "unexpected compiled discovery/fixture summary " counts))))
    (set! (.-exitCode js/process) (if (t/successful? summary) 0 1))))

(defn -main []
  (run-tests 'kotoba.fixture.compiled-test))

#?(:cljs (set! *main-cli-fn* -main))
