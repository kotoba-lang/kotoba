(ns library-import.stdlib
  (:require [kotoba.set :as sets]
            [kotoba.walk :as walk]
            [kotoba.string :as text]
            [kotoba.lang.time :as time]
            [kotoba.bytes :as bytes]
            [kotoba.pprint :as pp]
            [kotoba.lang.error :as error]))

(defn main []
  {:set (vec (sort (sets/union #{1 2} #{2 3})))
   :walk (walk/postwalk #(if (number? %) (inc %) %) [1 {:a 2}])
   :string (text/join "-" [(text/upper "kotoba") "lib"])
   :time (time/instant-millis (time/add (time/instant 1000) (time/seconds 2)))
   :bytes (bytes/hex (bytes/utf8-encode "kotoba"))
   :pprint (with-out-str (pp/pprint {:ok true}))
   :error (error/ex-info? (ex-info "example" {:ok true}))
   :origins (into {} (map (fn [[id variable]] [id (:file (meta variable))])
                         [["kotoba.set" #'sets/union]
                          ["kotoba.walk" #'walk/postwalk]
                          ["kotoba.string" #'text/join]
                          ["kotoba.time" #'time/instant]
                          ["kotoba.bytes" #'bytes/hex]
                          ["kotoba.pprint" #'pp/pprint]
                          ["kotoba.error" #'error/ex-info?]]))})
