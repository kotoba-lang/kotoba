(ns tooling-public (:require [kotoba.lang.lsp] [kotoba.lsp.diagnostic] [kotoba.lsp.diagnostics-by-severity] [kotoba.lsp.offset-to-position] [kotoba.lsp.pos-gte] [kotoba.lsp.pos-lt] [kotoba.lsp.position] [kotoba.lsp.position-to-offset] [kotoba.lsp.range] [kotoba.lsp.severities] [kotoba.lsp.severity-rank] [kotoba.lsp.text-document] [kotoba.lsp.within-range] [kotoba.lsp] [kotoba.lang.lsp-rpc] [kotoba.lsp-rpc.error-response] [kotoba.lsp-rpc.errors] [kotoba.lsp-rpc.frame] [kotoba.lsp-rpc.framing] [kotoba.lsp-rpc.handle-message] [kotoba.lsp-rpc.keywordize] [kotoba.lsp-rpc.make-server] [kotoba.lsp-rpc.notification] [kotoba.lsp-rpc.read-content-length] [kotoba.lsp-rpc.request] [kotoba.lsp-rpc.response] [kotoba.lsp-rpc.unframe] [kotoba.lsp-rpc] [kotoba.lang.lint] [kotoba.lint.lint-file] [kotoba.lint.lint-source] [kotoba.lint.lint-source-star] [kotoba.lint.ok] [kotoba.lint.parse-diagnostic] [kotoba.lint.summary] [kotoba.lint] [kotoba.lang.lint-kotoba] [kotoba.lint-kotoba.analyze] [kotoba.lint-kotoba.collect-refs] [kotoba.lint-kotoba.def-name] [kotoba.lint-kotoba.default-known-globals] [kotoba.lint-kotoba.diagnostic-pairs] [kotoba.lint-kotoba.grants-from-form] [kotoba.lint-kotoba.over-granted-capabilities] [kotoba.lint-kotoba.undeclared-refs] [kotoba.lint-kotoba.unused-decls] [kotoba.lint-kotoba.walk-defs-and-refs] [kotoba.lint-kotoba]))
(defn main []
 (let [message (kotoba.lsp-rpc/request 1 "echo" {:text "日本語🌸"})
       framed (kotoba.lsp-rpc/frame message)
       analysis (kotoba.lint-kotoba/analyze "{:grants [\"read\" \"write\"]}" {:used #{"read"}})]
  (assert (= [message ""] (kotoba.lsp-rpc/unframe framed)))
  (assert (= #{"write"} (:over-grant analysis)))
  {:namespaces 48
   :origins (vec (for [n '(kotoba.lang.lsp kotoba.lsp.diagnostic kotoba.lsp.diagnostics-by-severity kotoba.lsp.offset-to-position kotoba.lsp.pos-gte kotoba.lsp.pos-lt kotoba.lsp.position kotoba.lsp.position-to-offset kotoba.lsp.range kotoba.lsp.severities kotoba.lsp.severity-rank kotoba.lsp.text-document kotoba.lsp.within-range kotoba.lsp kotoba.lang.lsp-rpc kotoba.lsp-rpc.error-response kotoba.lsp-rpc.errors kotoba.lsp-rpc.frame kotoba.lsp-rpc.framing kotoba.lsp-rpc.handle-message kotoba.lsp-rpc.keywordize kotoba.lsp-rpc.make-server kotoba.lsp-rpc.notification kotoba.lsp-rpc.read-content-length kotoba.lsp-rpc.request kotoba.lsp-rpc.response kotoba.lsp-rpc.unframe kotoba.lsp-rpc kotoba.lang.lint kotoba.lint.lint-file kotoba.lint.lint-source kotoba.lint.lint-source-star kotoba.lint.ok kotoba.lint.parse-diagnostic kotoba.lint.summary kotoba.lint kotoba.lang.lint-kotoba kotoba.lint-kotoba.analyze kotoba.lint-kotoba.collect-refs kotoba.lint-kotoba.def-name kotoba.lint-kotoba.default-known-globals kotoba.lint-kotoba.diagnostic-pairs kotoba.lint-kotoba.grants-from-form kotoba.lint-kotoba.over-granted-capabilities kotoba.lint-kotoba.undeclared-refs kotoba.lint-kotoba.unused-decls kotoba.lint-kotoba.walk-defs-and-refs kotoba.lint-kotoba) [name variable] (ns-publics n)]
                   {:namespace (str n) :var (str name) :file (:file (meta variable))}))
   :rpc-roundtrip true :over-grant (vec (:over-grant analysis))}))
