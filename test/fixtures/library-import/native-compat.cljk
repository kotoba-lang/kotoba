(ns library-import.native-compat
  (:require [kotoba.text :as text]
            [kotoba.string :as string]
            [kotoba.json :as json]
            [kotoba.edn :as edn]
            [kotoba.process :as process]
            [kotoba.async :as async]
            [kotoba.io :as io]))
(defn- refused? [source]
  (try (json/decode source) false (catch :default _ true)))
(defn main []
  (let [buffer (io/byte-buffer)
        _ (io/put buffer (js/Uint8Array. #js [0 127 128 255]))
        channel (first (async/put (async/fixed-chan 2) :value))]
    {:text? (and (= ["a" "b.c"] (text/split "a.b.c" "." 2))
                 (= ["a" "b.c"] (string/split "a.b.c" "." 2))
                 (= "azİ日本" (text/ascii-lower "AZİ日本") (string/ascii-lower "AZİ日本")))
     :json? (and (= {"a" [1 true nil]} (json/decode "{\"a\":[1,true,null]}"))
                 (every? refused? ["[1,]" "{\"a\":1,}" "{a\":1}" "\"raw\nline\""]))
     :edn? (= [{:a 1} [2]] (edn/read-all "{:a 1} [2]"))
     :process? (nil? (process/validate-spawn ["echo" "hello"] 1024 100))
     :state? (= :value (second (async/take channel)))
     :bytes? (= [0 127 128 255] (vec (io/to-bytes buffer)))
     :origins [(:file (meta #'text/ascii-lower)) (:file (meta #'json/decode))
               (:file (meta #'io/byte-buffer))]}))
