(ns library-import.definitions
  (:require [kotoba.process.error-types :as errors]
            [kotoba.process.iprocess :as legacy]
            [kotoba.process.process :as canonical]
            [kotoba.string.byte-index-to-codepoint-index :as index]
            [kotoba.test.are :as split-are]
            [kotoba.test.deftest :as split-deftest]
            [kotoba.test.eq-form :as eq-form]
            [kotoba.test.is :as split-is]
            [kotoba.test.is-build :as is-build]
            [kotoba.test.testing :as split-testing]
            [kotoba.test.thrown-form :as thrown-form]
            [kotoba.test.run-tests-report :as report]))

(split-deftest/deftest imported-macros
  (split-testing/testing "bundled definitions"
    (split-are/are [a b] (= a b) 1 1 2 2)
    (split-is/is (= 3 (+ 1 2)))
    (split-is/is (thrown? js/Error (throw (ex-info "expected" {}))))))

(defn main []
  (let [process (reify legacy/IProcess
                  (spawn! [_ request] {:tag :ok :request request}))
        result (atom nil)]
    (with-out-str
      (reset! result (report/run-tests-report 'library-import.definitions)))
    {:report (dissoc @result :details)
     :protocol (legacy/spawn! process {:argv ["injected"]})
     :distinct-protocol (not (satisfies? canonical/Process process))
     :errors (contains? errors/error-types :process/timeout)
     :byte-boundaries (mapv #(index/byte-index->codepoint-index [0x41 0xe9 0x1f600] %)
                            (range 9))
     :shapes [(eq-form/eq-form? '(= expected actual))
              (thrown-form/thrown-form? '(thrown? Error body))]
     :origins (mapv #(:file (meta %))
                    [#'errors/error-types #'legacy/spawn!
                     #'index/byte-index->codepoint-index #'split-are/are
                     #'split-deftest/deftest #'eq-form/eq-form? #'split-is/is
                     #'is-build/is-build #'split-testing/testing
                     #'thrown-form/thrown-form?])}))
