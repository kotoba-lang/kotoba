(ns library-import.wave2
  (:require [kotoba.text :as text]
            [kotoba.lang.test :as property]
            [kotoba.edn :as edn]
            [kotoba.io :as io]
            [kotoba.fs :as fs]
            [kotoba.process :as process]
            [kotoba.async :as async]
            [kotoba.scheduler :as scheduler]
            [kotoba.store :as store]
            [kotoba.fmt :as fmt]
            [kotoba.log :as log]
            [kotoba.process.process :as process-protocol]
            [kotoba.lang.wit :as wit]
            [kotoba.lang.time :as time]))

(defn main []
  (let [buffer (io/byte-buffer)
        backend (fs/mem-filesystem)
        state (store/store backend (-> (wit/policy) (wit/grant "store:read")
                                      (wit/grant "store:write")))
        records (atom [])
        logger (log/make-logger #(swap! records conj %))
        [queue accepted] (async/put (async/fixed-chan 1) :message)
        [_ value] (async/take queue)
        scheduled (scheduler/at (scheduler/scheduler (constantly 100))
                                :job (time/instant 100) (constantly :fired))]
    (io/put buffer (js/Uint8Array. #js [0 127 128 255]))
    (store/put state "binary" (io/to-bytes buffer))
    (log/info logger "ready")
    {:text (text/format "%s-%d" "kotoba" 2)
     :test (:pass? (property/quickcheck (fn [n] (= n n))
                                      #(property/gen-int % 0 10) :seed 42 :runs 5))
     :edn (edn/read-string "{:ok true}")
     :io (io/len buffer)
     :fs (fs/exists? backend "store/binary")
     :process (:stdout (process-protocol/spawn!
                         (process/echo-process #{"echo"}) {:argv ["echo" "kotoba"]}))
     :async [accepted value]
     :scheduler (second (scheduler/tick scheduled 100))
     :store (vec (store/get state "binary"))
     :fmt (fmt/format-str {:a 1})
     :log (mapv :message @records)
     :origins {"kotoba.text" (:file (meta #'text/format))
               "kotoba.test" (:file (meta #'property/quickcheck))
               "kotoba.edn" (:file (meta #'edn/read-string))
               "kotoba.io" (:file (meta #'io/byte-buffer))
               "kotoba.fs" (:file (meta #'fs/mem-filesystem))
               "kotoba.process" (:file (meta #'process/echo-process))
               "kotoba.async" (:file (meta #'async/put))
               "kotoba.scheduler" (:file (meta #'scheduler/tick))
               "kotoba.store" (:file (meta #'store/get))
               "kotoba.fmt" (:file (meta #'fmt/format-str))
               "kotoba.log" (:file (meta #'log/info))}}))
