(ns imap.protocol
  "Pure IMAP RFC 3501 protocol functions - Kotoba guest.
   Mirrors imap.protocol.cljc with Kotoba-admitted operations only.
   
   Note: This is a minimal pure-s-expression version using only kotoba-admitted forms."
  (:export [status-positive? parse-status]))

;; Positive status check (OK / BAD / BAD)
(defn status-positive?
  [status]
  (or (= status "OK") (= status "PREAUTH")))

;; Parse status line
(defn parse-status
  [line]
  (let [len (count line)]
    (if (> len 0)
      (= (nth line 0) 79) ;; 'O' character for OK
      false)))
