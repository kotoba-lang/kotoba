(ns pop3.protocol
  "Pure POP3 RFC 1939 protocol functions - Kotoba guest.
   Mirrors pop3.protocol.cljc with Kotoba-admitted operations only.
   
   Note: This is a minimal pure-s-expression version using only kotoba-admitted forms."
  (:export [status-positive? parse-status]))

;; Positive status check (+ / -)
(defn status-positive?
  [status]
  (= status "+"))

;; Parse status line
(defn parse-status
  [line]
  (let [len (count line)]
    (if (> len 0)
      (= (nth line 0) 43) ;; '+' character
      false)))
