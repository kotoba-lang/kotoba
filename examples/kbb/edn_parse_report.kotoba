;; examples/kbb/edn_parse_report.kotoba — scripts/docs-edn-parse-report.cljs
;; (superproject) ported to kbb. The original walks 90-docs for `*.edn`,
;; parses each with clojure.edn, and reports the files that FAIL with their
;; reader error. Here the parse-health question is answered the
;; edn_depth_scan way: the end depth of the bracket scan. A well-formed
;; document answers 0; a document with an unclosed opener (or an extra
;; closer) answers nonzero drift -- which is exactly the class the
;; original's reader-error report catches for bracket balance, without a
;; host EDN reader.
;;
;; Same scope note as store_adoption_scan: this scans ONE directory
;; (`:fs/browse` answers entry names and cannot say "directory"), so the
;; fixture is flat and the nbb original would be run against the same flat
;; directory for comparison.
;;
;; Result packing: failures*10 + total -- each count below 10 for this
;; fixture, so the packing is lossless.
;;
;; Capabilities: :fs/browse (34) + :fs/app-data (35) -> the js backend.
(ns examples.kbb.edn-parse-report
  (:require [kbb.fs :as fs] [kbb.browse :as browse])
  (:export [main]))

(defn char-at [s :string i :i64] :string
  (string-substring s i (+ i 1)))

(defn opener? [c :string] :bool
  (if (string=? c "[") true (if (string=? c "{") true (if (string=? c "(") true false))))

(defn closer? [c :string] :bool
  (if (string=? c "]") true (if (string=? c "}") true (if (string=? c ")") true false))))

(defn skip-comment [s :string i :i64 n :i64] :i64
  (if (>= i n)
    n
    (if (string=? (char-at s i) "\n")
      (+ i 1)
      (skip-comment s (+ i 1) n))))

(defn scan [s :string i :i64 n :i64 d :i64 instr :i64] :i64
  (if (>= i n)
    d
    (let [c (char-at s i)]
      (if (= instr 1)
        (if (string=? c "\\")
          (scan s (+ i 2) n d 1)
          (if (string=? c "\"")
            (scan s (+ i 1) n d 0)
            (scan s (+ i 1) n d 1)))
        (if (string=? c "\"")
          (scan s (+ i 1) n d 1)
          (if (string=? c "\\")
            (scan s (+ i 2) n d 0)
            (if (string=? c ";")
              (scan s (skip-comment s i n) n d 0)
              (if (opener? c)
                (scan s (+ i 1) n (+ d 1) 0)
                (if (closer? c)
                  (scan s (+ i 1) n (- d 1) 0)
                  (scan s (+ i 1) n d 0))))))))))

(defn end-depth [path :string] :i64
  (let [content (fs/read-file path)]
    (scan content 0 (string-byte-length content) 0 0)))

(defn edn-file? [name :string] :bool
  (let [n (string-byte-length name)]
    (if (> n 4)
      (string=? (string-substring name (- n 4) n) ".edn")
      false)))

;; Count failures over one entry (1 if it is an .edn file with drift != 0,
;; else 0). failure*10 + 1 = packed contribution of a broken file.
(def scan-dir "test/fixtures/kbb_ports/edn_dir")

(defn entry-fail [name :string] :i64
  (if (edn-file? name)
    (if (= (end-depth (string-concat scan-dir (string-concat "/" name))) 0)
      0
      1)
    0))

(defn entry-count [name :string] :i64
  (if (edn-file? name) 1 0))

(defn loop-walk [rest :string fails :i64 total :i64] :i64
  (let [n (string-byte-length rest)]
    (if (= n 0)
      (+ (* fails 10) total)
      (let [sep (string-index-of rest "\n")
            name (if (>= sep 0) (string-substring rest 0 sep) rest)
            tail (if (>= sep 0) (string-substring rest (+ sep 1) n) "")
            fails2 (+ fails (entry-fail name))
            total2 (+ total (entry-count name))]
        (loop-walk tail fails2 total2)))))

(defn main [] :i64
  (loop-walk (browse/entries scan-dir) 0 0))
