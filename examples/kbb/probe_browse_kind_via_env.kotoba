;; examples/kbb/probe_browse_kind_via_env.kotoba — provider boundary probe
;; (:fs/browse is-directory). Wire 34 answers "NAME<TAB>D" per line (D=1
;; directory, 0 file); kbb.browse exposes the flag as entry-dir?/entry-name
;; and subdirs (the directory names alone, the recursion primitive a tree walk
;; needs). The script answers 1 when: the entry-count is 3 (two files + one
;; subdirectory), subdirs is exactly the one subdirectory "sub" (3 bytes), and
;; the per-line accessors answer a directory line true and a file line false.
;; 0 otherwise. The old names-only wire could never answer a subdirs pass here
;; (no entry carried its kind), so a regression to the old host answers 0.
(ns examples.kbb.probe-browse-kind-via-env
  (:require [kbb.env :as env] [kbb.browse :as browse])
  (:export [main]))

(defn kind-ok [] :i64
  (let [d (if (browse/entry-dir? "sub\t1") 1 0)
        f (if (browse/entry-dir? "a.txt\t0") 0 1)
        n (if (string=? (browse/entry-name "sub\t1") "sub") 1 0)]
    (if (and (= d 1) (= f 1) (= n 1)) 1 0)))

(defn main [] :i64
  (let [dir (env/read "KBB_PROBE_DIR")
        count-ok (if (= (browse/entry-count dir) 3) 1 0)
        sub-ok (if (= (string-byte-length (browse/subdirs dir)) 3) 1 0)
        k (kind-ok)]
    (if (and (= count-ok 1) (= sub-ok 1) (= k 1)) 1 0)))