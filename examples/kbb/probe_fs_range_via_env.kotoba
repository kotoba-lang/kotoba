;; examples/kbb/probe_fs_range_via_env.kotoba — provider boundary probe for the
;; RANGE form of :fs/app-data (wire 35). The file, the "<offset>:<length>" spec
;; and the output path arrive through three granted env names (a guest has no
;; argv, and no text->number builtin -- hence read-range-spec); main writes
;; the window it read to KBB_PROBE_OUT and answers the byte count written, so
;; the test can compare the bytes on disk with the slice it expects. A refused
;; window leaves the LAST receipt :denied and the run fails by name.
(ns examples.kbb.probe-fs-range-via-env
  (:require [kbb.env :as env] [kbb.fs :as fs])
  (:export [main]))

(defn main [] :i64
  (fs/write-bytes-count (env/read "KBB_PROBE_OUT")
                        (fs/read-range-spec (env/read "KBB_PROBE_FILE")
                                            (env/read "KBB_PROBE_SPEC"))))
