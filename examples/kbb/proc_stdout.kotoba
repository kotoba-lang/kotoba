;; examples/kbb/proc_stdout.kotoba — jvm-retire: kbb.proc reads stdout.
;; The :proc/exec (wire 20) capability used to answer only an exit STATUS;
;; the stdout a process wrote was captured by the host and discarded. This
;; script exercises the fixed shape: the host answers "<exit>\n<stdout>"
;; (the same wire shape :git/run already used), kbb.proc/run returns that
;; string and kbb.proc/stdout the program's output. main answers 1 when the
;; output round-trips byte-exact, 0 otherwise — so a regression that
;; discards stdout again turns this red.
;;
;; The expected value is the 16 byte / `echo hello-from-proc` output,
;; measured 2026-09-07 (15 chars + trailing newline).
;;
;; Capabilities: :proc/exec (20) -> js backend.
(ns kbb.proc-stdout
  (:require [kbb.proc :as proc])
  (:export [main]))

(defn main [] :i64
  (let [r (proc/run "0")]
    (if (string=? (proc/stdout r) "hello-from-proc\n") 1 0)))