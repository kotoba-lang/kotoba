;; examples/kbb/edn_datomize_scan.kotoba — scripts/edn-datomize.cljk ported
;; to kbb. The original wraps a plain EDN map into DataScript tx-data
;; ([{:db/id -1 ...}]) and merges the schema it implies into schema.edn.
;; A kbb guest cannot do that literally: the schema merge is read-modify-
;; write of a structured EDN file, which kbb.edn (structural reading only)
;; cannot round-trip, so a literal port would be a behavior change, not a
;; port. What IS expressible -- and is what this port answers -- is the
;; DATOMIZE QUESTION the script poses about one document before wrapping:
;;
;;   is it a plain top-level map (wrap-able)?  is it well-formed?  does it
;;   carry the :adr/id key the wrapped entity would name?  how many
;;   attributes would the tx-data map carry?
;;
;; The answer packs three readings into one i64:
;;
;;   entry-count  7 (attrs in the top-level map)      -> *1000
;;   well-formed? yes -> 200                          -> *1
;;   :adr/id present yes -> 2                         -> *1
;;   wrap-able (first value is a map) yes -> 5000     -> *1
;;
;;   entry.edn (a plain, well-formed 7-attr map with :adr/id)
;;             = 7*1000 + 5000 + 200 + 2 = 12202
;;
;; Capabilities: :fs/app-data (35) only -> the js backend. ASCII-only
;; fixture (string-byte-length is a byte count).
(ns examples.kbb.edn-datomize-scan
  (:require [kbb.fs :as fs]
            [kbb.edn :as edn])
  (:export [main]))

(defn main [] :i64
  (let [doc (fs/read-file "test/fixtures/kbb_ports/datomize_dir/entry.edn")]
    (+ (* 1000 (edn/entry-count doc))
       (+ 5000
          (+ (if (edn/well-formed? doc) 200 0)
             (if (edn/has-key? doc ":adr/id") 2 0))))))
