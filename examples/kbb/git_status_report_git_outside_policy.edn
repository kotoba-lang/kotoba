;; Granted, and the invocation table is unchanged -- but the :git/run scope
;; names a SUBDIRECTORY, and every row's cwd is the repository root, which
;; is outside it. A policy table must not be able to reach a repository the
;; grant did not name, so the host refuses on the cwd.
{:kotoba.policy/capabilities #{:git/run :fs/transact :fs/app-data}
 :kotoba.policy/forbid-wildcard true
 :kotoba.policy/capability-resources
 {:git/run     #{"test/fixtures/kbb_ports/out"}
  :fs/transact #{"test/fixtures/kbb_ports/out"}
  :fs/app-data #{"test/fixtures/kbb_ports/out"}}
 :kotoba.policy/git-invocations
 [{:argv ["git" "ls-files" "test/fixtures/kbb_ports/edn_dir"] :cwd "."}
  {:argv ["git" "cat-file" "-e" "does-not-exist"] :cwd "."}]}
