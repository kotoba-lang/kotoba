;; examples/kbb/probe_fs_write_via_env.kotoba — provider boundary probe for
;; the WRITE form of :fs/app-data. A guest has no argv, so the path and the
;; content under test arrive through two granted env names (KBB_PROBE_PATH,
;; KBB_PROBE_CONTENT) that the test sets at run time; main answers the byte
;; length the host wrote back -- or the host refuses (outside the scope, a
;; second WRITE_SEP in the content, over 65536 bytes, a directory, a missing
;; parent, a symlink) and the LAST receipt says :denied.
(ns examples.kbb.probe-fs-write-via-env
  (:require [kbb.env :as env] [kbb.fs :as fs])
  (:export [main]))

(defn main [] :i64
  (fs/write-bytes-count (env/read "KBB_PROBE_PATH") (env/read "KBB_PROBE_CONTENT")))
