;; Deny-by-default, three grants, each scoped:
;;
;;   :git/run     the guest may name ROW 0 or ROW 1 and nothing else. Every
;;                git byte is here, in the table, where it can be reviewed.
;;                The cwd each row names must itself resolve inside the
;;                :git/run scope, so a table cannot reach a repository the
;;                grant did not name.
;;   :fs/transact one directory, and it is not the one the script reads
;;                fixtures from: write authority is narrower than read.
;;   :fs/app-data the same one directory, to read the file back through a
;;                DIFFERENT provider and prove it reached the disk.
{:kotoba.policy/capabilities #{:git/run :fs/transact :fs/app-data}
 :kotoba.policy/forbid-wildcard true
 :kotoba.policy/capability-resources
 {:git/run     #{"."}
  :fs/transact #{"test/fixtures/kbb_ports/out"}
  :fs/app-data #{"test/fixtures/kbb_ports/out"}}
 :kotoba.policy/git-invocations
 [{:argv ["git" "ls-files" "test/fixtures/kbb_ports/edn_dir"] :cwd "."}
  {:argv ["git" "cat-file" "-e" "does-not-exist"] :cwd "."}]}
