;; Granted, but the :fs/app-data scope is a directory the script does NOT
;; write to. The wire-35 write form resolves the target's PARENT and
;; refuses -- a grant is not a key to the filesystem, and a write scope is
;; the boundary even when the caller got :git/run.
{:kotoba.policy/capabilities #{:git/run :fs/app-data}
 :kotoba.policy/forbid-wildcard true
 :kotoba.policy/capability-resources
 {:git/run     #{"."}
  :fs/app-data #{"test/fixtures/kbb_ports/edn_dir"}}
 :kotoba.policy/git-invocations
 [{:argv ["git" "ls-files" "test/fixtures/kbb_ports/edn_dir"] :cwd "."}
  {:argv ["git" "cat-file" "-e" "does-not-exist"] :cwd "."}]}