;; examples/kbb/proc_stdout_policy.edn — grants exactly :proc/exec
;; (:process/spawn, wire 20) for ONE program, /bin/echo; the script supplies
;; `hello-from-proc` in the wire-20 request (kotoba-lang
;; lang/capability-catalog.edn :process/spawn).
{:kotoba.policy/capabilities #{:proc/exec}
 :kotoba.policy/forbid-wildcard true
 :kotoba.policy/spawn {:programs ["/bin/echo"]}}