;; examples/kbb/proc_stdout_policy.edn — grants exactly :proc/exec, one
;; invocation: `echo hello-from-proc` (matches what the script expects on
;; stdout). Scope restricts the command name to echo.
{:kotoba.policy/capabilities #{:proc/exec}
 :kotoba.policy/forbid-wildcard true
 :kotoba.policy/capability-resources {:proc/exec #{"echo"}}
 :kotoba.policy/proc-exec-invocations
 [{:command "echo" :argv ["echo" "hello-from-proc"] :timeout-seconds 10}]}