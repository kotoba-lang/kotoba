;; Scalar fuel probe: the capability-free countdown answers 100 under the
;; default budget. The declared fuel also bounds the compiler's scalar
;; constant oracle, so --fuel 8 refuses before emission. The separate
;; probe_fuel_runtime.kotoba measures fuel exhaustion in the emitted guest.
(ns examples.kbb.probe-fuel (:export [main]))

(defn count-down [n :i64 acc :i64] :i64
  (if (= n 0)
    acc
    (count-down (- n 1) (+ acc 1))))

(defn main [] :i64
  (count-down 100 0))
