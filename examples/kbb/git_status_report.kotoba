;; examples/kbb/git_status_report.kotoba — the second thing a workspace
;; script does after reading EDN: ask git something, and write the answer
;; somewhere.
;;
;; The capability that did not exist on any JVM-free backend before this:
;;
;;   :git/run     (wire 22) run ONE allowlisted invocation by grant INDEX.
;;                The guest supplies zero git bytes -- argv and cwd are
;;                policy literals -- because git can rewrite history and
;;                push, so the reviewable artifact must be the policy table,
;;                not the script. The host answers "<exit>\n<stdout>";
;;                kbb.git reads that encoding so no script spells it.
;;
;; The write half rides the SHIPPED wire-35 write form (kbb.fs/write-file,
;; "<path>WRITE_SEP<content>", merged 2026-09-07 on both JVM-free hosts) --
;; deliberately NOT a second wire-19 write path: the capability-catalog
;; keeps :fs/transact (19) for it, but one separator must win, and the two
;; hosts already agree on WRITE_SEP under :fs/app-data.
;;
;; The answer packs five readings into one i64:
;;
;;   ls-files lines      1   -> 100000  (the edn_dir fixture, one file)
;;   ls-files exit       0   ->      0  (added, so a wrong exit moves this)
;;   cat-file exit     128   ->  12800  (a non-zero git exit is INFORMATION
;;                                       and must survive the wire)
;;   bytes written      15   ->     15  (through the wire-35 WRITE_SEP form)
;;   bytes read back    15   ->     15  (through the same wire-35 provider --
;;                                       the write REALLY reached the disk)
;;   round-trip equal        ->      7
;;
;;   100000 + 0 + 12800 + 15 + 15 + 7 = 112837
(ns examples.kbb.git-status-report
  (:require [kbb.git :as git]
            [kbb.fs :as fs])
  (:export [main]))

(defn report-path [] :string
  "test/fixtures/kbb_ports/out/report.txt")

(defn body [] :string
  "kbb wrote this\n")

(defn main [] :i64
  (let [listed (git/run "0")
        missing (git/run "1")
        wrote (string-byte-length (fs/write-file (report-path) (body)))
        back (fs/read-file (report-path))]
    (+ (* 100000 (git/stdout-line-count listed))
       (+ (* 1000 (git/exit-code listed))
          (+ (* 100 (git/exit-code missing))
             (+ wrote
                (+ (string-byte-length back)
                   (if (string=? back (body)) 7 0))))))))