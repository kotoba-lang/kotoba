;; examples/kbb/edn_balance_scan.kotoba — the delimiter-balance pass of the
;; superproject's scripts/docs-edn-locate-break.cljs, as a kbb guest. Reads the
;; document named by KBB_EDN_FILE and answers where its delimiters first stop
;; making sense.
;;
;;   0            the delimiters are consistent
;;   line*10 + 1  a closer at `line` closes nothing
;;   line*10 + 2  a closer at `line` does not match the opener it meets
;;   line*10 + 3  a string is still open at end of file, which is `line`
;;   4            an opener is never closed
;;
;; The last one is narrower than the nbb original, which names the LINE the
;; unclosed opener sits on. Carrying that would mean a per-opener line stack,
;; and the guest has no number->string builtin to pack one into the delimiter
;; string. Removal condition: a second stack, or an i64 vector that the native
;; backend admits across a call boundary.
;;
;; Two resource facts decided the shape, both measured 2026-09-08:
;;   - the scan advances by CODE POINT, not by byte: string-substring refuses to
;;     cut inside one, and string-code-point-at does not answer a width, so the
;;     width is derived from the code point's own value.
;;   - the top of the delimiter stack is read as a CODE POINT, never as a
;;     substring. Reading it as a substring allocates one string per character
;;     of the document, which exhausts the native string pool: 15,532 bytes of
;;     ADR trapped SIGILL. Allocation now happens only on push and pop.
(ns examples.kbb.edn-balance-scan
  (:require [kbb.fs :as fs] [kbb.env :as env])
  (:export [main]))

(defn cp-width [cp :i64] :i64
  (if (< cp 128) 1 (if (< cp 2048) 2 (if (< cp 65536) 3 4))))

;; 0 when the stack is empty. The stack holds only ASCII delimiters this
;; scanner pushed, so indexing it by byte is always on a code-point boundary.
(defn top-cp [stack :string] :i64
  (if (= (string-byte-length stack) 0)
    0
    (string-code-point-at stack (- (string-byte-length stack) 1))))

(defn stack-pop [stack :string] :string
  (if (= (string-byte-length stack) 0)
    ""
    (string-substring stack 0 (- (string-byte-length stack) 1))))

(defn opener-str [cp :i64] :string
  (if (= cp 40) "(" (if (= cp 91) "[" "{")))

(defn opens-what [closer :i64] :i64
  (if (= closer 41) 40 (if (= closer 93) 91 123)))

(defn opener? [cp :i64] :bool
  (if (= cp 40) true (if (= cp 91) true (if (= cp 123) true false))))

(defn closer? [cp :i64] :bool
  (if (= cp 41) true (if (= cp 93) true (if (= cp 125) true false))))

;; i points AT the backslash. Answer the offset just past the escaped code
;; point, which may itself be multi-byte.
(defn past-escaped [text :string i :i64] :i64
  (if (>= (+ i 1) (string-byte-length text))
    (+ i 1)
    (+ (+ i 1) (cp-width (string-code-point-at text (+ i 1))))))

;; A trailing line comment leaves ";" on the stack at end of file; it closes
;; nothing, so drop it before asking whether anything is unclosed.
(defn eof-verdict [line :i64 stack :string] :i64
  (if (= (top-cp stack) 34)
    (+ (* line 10) 3)
    (let [s (if (= (top-cp stack) 59) (stack-pop stack) stack)]
      (if (= (string-byte-length s) 0) 0 4))))

(defn scan [text :string i :i64 line :i64 stack :string] :i64
  (if (>= i (string-byte-length text))
    (eof-verdict line stack)
    (let [cp (string-code-point-at text i)
          next-i (+ i (cp-width cp))
          line2 (if (= cp 10) (+ line 1) line)
          top (top-cp stack)]
      (if (= top 34)
        (if (= cp 92)
          (scan text (past-escaped text i) line2 stack)
          (if (= cp 34)
            (scan text next-i line2 (stack-pop stack))
            (scan text next-i line2 stack)))
        (if (= top 59)
          (if (= cp 10)
            (scan text next-i line2 (stack-pop stack))
            (scan text next-i line2 stack))
          (if (= cp 34)
            (scan text next-i line2 (string-concat stack "\""))
            (if (= cp 92)
              (scan text (past-escaped text i) line2 stack)
              (if (= cp 59)
                (scan text next-i line2 (string-concat stack ";"))
                (if (opener? cp)
                  (scan text next-i line2 (string-concat stack (opener-str cp)))
                  (if (closer? cp)
                    (if (= (string-byte-length stack) 0)
                      (+ (* line2 10) 1)
                      (if (= top (opens-what cp))
                        (scan text next-i line2 (stack-pop stack))
                        (+ (* line2 10) 2)))
                    (scan text next-i line2 stack)))))))))))

(defn main [] :i64
  (scan (fs/read-file (env/read "KBB_EDN_FILE")) 0 1 ""))
