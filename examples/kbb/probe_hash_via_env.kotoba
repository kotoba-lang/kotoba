(ns probe-hash
  "Wire-3 provider probe: hash a value carried in via a granted env name,
  print the digest's LENGTH only (the digest itself would make the test
  fixture carry a value, and the length is what discriminates a real
  SHA-256 from any other answer)."
  (:export [main]))

(defn main [] :i64
  (let [s (typed-cap-call :env/read :string :string "KBB_PROBE_HASH_INPUT")
        hex (typed-cap-call :hash/sha256 :string :string s)]
    (string-byte-length hex)))
