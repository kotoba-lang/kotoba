(ns probe-clock
  "Wire-7 provider probe: read the wall clock and print its LENGTH only
  (24 chars for ISO-8601 UTC) plus the position of the T separator."
  (:export [main]))

(defn main [] :i64
  (let [now (typed-cap-call :clock/now :string :string "")]
    (+ (* 100 (string-byte-length now))
       (if (string=? "T" (string-substring now 10 11)) 0 1))))
