;; examples/kbb/probe_proc_via_env.kotoba — provider boundary probe (:proc/exec).
;; The wire-20 request ("<program>[ARG_SEP<arg>]...") arrives through
;; KBB_PROBE_REQUEST; the :kotoba.policy/spawn grant is the policy the test
;; writes. main answers the exit status, or the host refuses by name
;; (:spawn/program-not-granted, :spawn/argv-budget, :spawn/timeout, ...).
(ns examples.kbb.probe-proc-via-env
  (:require [kbb.env :as env] [kbb.proc :as proc])
  (:export [main]))

(defn main [] :i64
  (proc/exec (env/read "KBB_PROBE_REQUEST")))
