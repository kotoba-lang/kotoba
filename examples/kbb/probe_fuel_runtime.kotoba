;; Runtime fuel probe: the typed string result has no scalar constant oracle.
;; The same capability-free countdown therefore reaches the emitted guest,
;; where a budget of 8 must trap and the default budget must complete.
(ns examples.kbb.probe-fuel-runtime (:export [main]))

(defn count-down [n :i64 acc :i64] :i64
  (if (= n 0) acc (count-down (- n 1) (+ acc 1))))

(defn main [] :string
  (if (= (count-down 100 0) 100) "completed" "wrong-count"))
