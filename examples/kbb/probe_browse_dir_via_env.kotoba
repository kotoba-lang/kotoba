;; examples/kbb/probe_browse_dir_via_env.kotoba — provider boundary probe
;; (:fs/browse-dir, wire 261). The directory under test arrives through
;; KBB_PROBE_DIR (policy written by the test); main answers the count of
;; entries whose line names a SUBDIRECTORY (is-dir flag "1"), by reading the
;; LAST byte of each "<name>\t<0|1>" line (the tab position varies with the
;; name, so only the trailing flag byte is a safe fixed point). The host
;; refuses a file, or a directory outside the granted scope, and the LAST
;; receipt says :denied.
(ns examples.kbb.probe-browse-dir-via-env
  (:require [kbb.env :as env] [kbb.browse :as browse])
  (:export [main]))

(defn is-dir-line? [line :string] :i64
  (let [n (string-byte-length line)]
    (if (> n 0)
      (if (string=? (string-substring line (- n 1) n) "1") 1 0)
      0)))

(defn scan-lines [listing :string acc :i64] :i64
  (let [n (string-byte-length listing)]
    (if (= n 0)
      acc
      (let [i (string-index-of listing "\n")]
        (if (< i 0)
          (+ acc (is-dir-line? listing))
          (scan-lines (string-substring listing (+ i 1) n)
                      (+ acc (is-dir-line? (string-substring listing 0 i)))))))))

(defn main [] :i64
  (let [d (env/read "KBB_PROBE_DIR")]
    (if (string=? d "")
      0
      (scan-lines (browse/entries-dir d) 0))))