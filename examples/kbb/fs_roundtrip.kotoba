;; examples/kbb/fs_roundtrip.kotoba — write one policy-scoped file through
;; kbb.fs/write-ok?, read it back through kbb.fs/read-bytes-count, answer the
;; byte length read back (20 for the 20-byte report below), or -1 when the
;; host did not hand back exactly what was written. The scope is the
;; directory test/fixtures/kbb_js_write/out (kept in git by a .gitkeep; the
;; written report.txt is .gitignore'd). Compiles on the js backend through
;; `--source-path lib`; the native loader implements the same wire-35 write
;; form (amu 6cca3852).
(ns examples.kbb.fs-roundtrip (:require [kbb.fs :as fs]) (:export [main]))

(defn main [] :i64
  (if (fs/write-ok? "test/fixtures/kbb_js_write/out/report.txt" "kbb write roundtrip\n")
    (fs/read-bytes-count "test/fixtures/kbb_js_write/out/report.txt")
    -1))
