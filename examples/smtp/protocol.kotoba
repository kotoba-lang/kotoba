(ns smtp.protocol
  "Pure SMTP RFC 5321 protocol functions - Kotoba guest.
   Mirrors smtp.protocol.cljc with Kotoba-admitted operations only.
   
   Note: This is a minimal pure-s-expression version using only kotoba-admitted forms.
   String operations, maps, and many standard library functions are not yet admitted."
  (:export [pos? positive? creds-code auth-pick auth-pick-from
            auth-none auth-xoauth2 auth-plain auth-login auth-unsupported]))

;; SASL pick codes
(def auth-none 0)
(def auth-xoauth2 1)
(def auth-plain 2)
(def auth-login 3)
(def auth-unsupported 4)

;; Positive check helper
(defn pos? [n]
  (> n 0))

;; Positive response code check (2xx/3xx)
(defn positive?
  [code]
  (and code (< code 400)))

;; Credential code packing
(defn creds-code
  [has-token? has-password?]
  (if has-token?
    (if has-password? 3 1)
    (if has-password? 2 0)))

;; Auth mechanism selection
(defn auth-pick
  [n-advertised has-xoauth2? has-plain? has-login? creds]
  (let [has-token? (or (= creds 1) (= creds 3))
        has-password? (or (= creds 2) (= creds 3))]
    (cond
      (and has-xoauth2? has-token?) auth-xoauth2
      (and has-plain? has-password?) auth-plain
      (and has-login? has-password?) auth-login
      (pos? n-advertised) auth-unsupported
      :else auth-none)))

(defn auth-pick-from
  [mechanisms has-token? has-password?]
  (auth-pick (count mechanisms)
             has-token?
             has-password?
             has-password?
             (creds-code has-token? has-password?)))
