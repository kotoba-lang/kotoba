(ns smtp.client
  "SMTP RFC 5321 session driver - Kotoba guest.
   Mirrors smtp.client.cljc with Kotoba-admitted operations only.
   
   Note: This is a minimal pure-s-expression version using only kotoba-admitted forms."
  (:export [send-line? parse-response? status-positive?]))

;; Parse SMTP response line
(defn parse-response?
  [line]
  (let [len (count line)]
    (if (< len 3)
      nil
      (let [c0 (nth line 0)
            c1 (nth line 1)
            c2 (nth line 2)]
        (if (and (>= c0 48) (<= c0 57)
                 (>= c1 48) (<= c1 57)
                 (>= c2 48) (<= c2 57))
          (+ (- c0 48) (* 10 (- c1 48)) (* 100 (- c2 48)))
          nil)))))

;; Positive status check (2xx/3xx)
(defn status-positive?
  [code]
  (and code (< code 400)))

;; Send line and read response
(defn send-line?
  [transport cmd]
  cmd)
