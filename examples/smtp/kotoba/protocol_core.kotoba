(ns smtp.kotoba.protocol-core
  "Pure SMTP RFC 5321 protocol functions"
  (:export [auth-xoauth2 auth-plain auth-login auth-unsupported
            positive? auth-pick auth-pick-from creds-code]))

(defn pos? [n]
  (> n 0))

(defn positive?
  [code]
  (and code (< code 400)))

(defn creds-code
  [has-token? has-password?]
  (if has-token?
    (if has-password? 3 1)
    (if has-password? 2 0)))

(defn auth-pick
  [n-advertised has-xoauth2? has-plain? has-login? creds]
  (let [has-token? (or (= creds 1) (= creds 3))
        has-password? (or (= creds 2) (= creds 3))]
    (cond
      (and has-xoauth2? has-token?) 1
      (and has-plain? has-password?) 2
      (and has-login? has-password?) 3
      (pos? n-advertised) 4
      :else 0)))

(defn auth-pick-from
  [mechanisms has-token? has-password?]
  (auth-pick (count mechanisms)
             has-token?
             has-password?
             has-password?
             (creds-code has-token? has-password?)))
